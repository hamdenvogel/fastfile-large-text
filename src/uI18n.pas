procedure AddCommonTranslations;
var
  Lang: TAppLanguage;
begin
  { Lazy-load: only English + startup language are filled here.
    Other languages load on first SetCurrentLanguage / EnsureLanguageLoaded. }
  Lang := PeekStartupLanguage;
  EnsureLanguageLoaded(Lang);
  GCurrentLanguage := Lang;
end;


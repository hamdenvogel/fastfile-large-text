function PeekStartupLanguage: TAppLanguage;
var
  Ini: TIniFile;
  Code: string;
  WinLangID, Primary, Sub: Word;
begin
  Result := alEnglish;
  Code := '';
  try
    Ini := TIniFile.Create(ExtractFilePath(ParamStr(0)) + 'ASkin.ini');
    try
      Code := Trim(Ini.ReadString('FastFile', 'Language', ''));
    finally
      Ini.Free;
    end;
  except
    Code := '';
  end;
  if Code <> '' then
  begin
    Result := AppLanguageFromCode(Code);
    Exit;
  end;
  WinLangID := GetUserDefaultLangID;
  Primary := WinLangID and $03FF;
  Sub := WinLangID shr 10;
  case Primary of
    $0016: { LANG_PORTUGUESE }
      if Sub = 1 then { SUBLANG_PORTUGUESE_BRAZILIAN }
        Result := alPortuguese
      else
        Result := alPortuguesePT;
    $000A: Result := alSpanish;
    $000C: Result := alFrench;
    $0007: Result := alGerman;
    $0010: Result := alItalian;
    $0015: Result := alPolish;
    $0018: Result := alRomanian;
    $000E: Result := alHungarian;
    $0005: Result := alCzech;
    $0011: Result := alJapanese;
    $0004: { LANG_CHINESE }
      if (Sub = $0002) or (Sub = $0004) then
        Result := alChineseSimplified
      else
        Result := alChineseTraditional;
  else
    Result := alEnglish;
  end;
end;

procedure EnsureLanguageLoaded(Lang: TAppLanguage);
var
  Wanted: TAppLanguageSet;
  L: TAppLanguage;
begin
  CreateTranslationTables;
  Wanted := [];
  if not GLangReady[alEnglish] then
    Include(Wanted, alEnglish);
  if not GLangReady[Lang] then
    Include(Wanted, Lang);
  if Wanted = [] then Exit;
  if GFillLock then Exit;
  GFillLock := True;
  try
    ApplyPopulateMask(Wanted);
    FillTranslationDataBody;
    CollapseLanguageTables(Wanted);
    SortLanguageTables(Wanted);
    for L := Low(TAppLanguage) to High(TAppLanguage) do
      if L in Wanted then
        GLangReady[L] := True;
    ApplyPopulateMask([]);
  finally
    GFillLock := False;
  end;
end;

function TextTableForLanguage(const Lang: TAppLanguage): TStringList;
begin
  case Lang of
    alPortuguese:   Result := GTextPortuguese;
    alSpanish:      Result := GTextSpanish;
    alFrench:       Result := GTextFrench;
    alGerman:       Result := GTextGerman;
    alItalian:      Result := GTextItalian;
    alPolish:       Result := GTextPolish;
    alPortuguesePT: Result := GTextPortuguesePT;
    alRomanian:     Result := GTextRomanian;
    alHungarian:    Result := GTextHungarian;
    alCzech:        Result := GTextCzech;
    alJapanese:     Result := GTextJapanese;
    alChineseSimplified: Result := GTextChineseSimplified;
    alChineseTraditional: Result := GTextChineseTraditional;

function PutNVAllowed(Table: TStringList): Boolean;
var
  I: Integer;
begin
  Result := False;
  if Table = nil then Exit;
  for I := 0 to GPutNVAllowCount - 1 do
    if GPutNVAllow[I] = Table then
    begin
      Result := True;
      Exit;
    end;
end;

{ Append Name=Value in O(1). Bulk build uses PutNV; duplicates are collapsed
  (last wins) before SortTablesForFastLookup. Avoid TStringList.Values during
  population — IndexOfName is O(n) and makes startup O(n^2).
  Allow-list gate: startup only fills English + active language (lazy-load). }
{ Keys may contain '=' (e.g. 'YES = build line index now.'), which is also the
  Name=Value separator. Such characters are stored as a private-use char. }
const
  cKeyEqEsc = #$E000;

function EscKey(const S: string): string;
begin
  if Pos('=', S) > 0 then
    Result := StringReplace(S, '=', cKeyEqEsc, [rfReplaceAll])
  else
    Result := S;
end;

function UnescKey(const S: string): string;
begin
  if Pos(cKeyEqEsc, S) > 0 then
    Result := StringReplace(S, cKeyEqEsc, '=', [rfReplaceAll])
  else
    Result := S;
end;

procedure PutNV(Table: TStringList; const Name, Value: string);
begin
  if not PutNVAllowed(Table) then Exit;
  Table.Add(EscKey(Name) + Table.NameValueSeparator + Value);
end;

procedure AllowPutNVTable(Table: TStringList);
begin
  if Table = nil then Exit;
  if GPutNVAllowCount > High(GPutNVAllow) then Exit;
  GPutNVAllow[GPutNVAllowCount] := Table;
  Inc(GPutNVAllowCount);
end;


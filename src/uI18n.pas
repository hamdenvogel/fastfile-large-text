type
  { Original (DFM / English) text of a localized property and the value we wrote.
    If the property still holds Produced, Orig is the reliable source for any
    later language: no reverse lookup of the translated text needed. }
  TOrigCaption = class
    Orig: string;
    Produced: string;
  end;

var
  GOrigMap: TStringList = nil;

function OrigMapKey(AInstance: TObject; const APropertyName: string): string;
begin
  Result := IntToHex(NativeInt(AInstance), SizeOf(Pointer) * 2) + '|' + APropertyName;
end;

function FindOrigCaption(AInstance: TObject; const APropertyName: string): TOrigCaption;
var
  Idx: Integer;
begin
  Result := nil;
  if GOrigMap = nil then Exit;
  Idx := GOrigMap.IndexOf(OrigMapKey(AInstance, APropertyName));
  if Idx >= 0 then
    Result := TOrigCaption(GOrigMap.Objects[Idx]);
end;

procedure RememberOrigCaption(AInstance: TObject; const APropertyName, AOrig, AProduced: string);
var
  E: TOrigCaption;
begin
  if GOrigMap = nil then
  begin
    GOrigMap := TStringList.Create;
    GOrigMap.Sorted := True;
    GOrigMap.Duplicates := dupIgnore;
    GOrigMap.OwnsObjects := True;
  end
  else if GOrigMap.Count > 200000 then
    GOrigMap.Clear;
  E := FindOrigCaption(AInstance, APropertyName);
  if E = nil then
  begin
    E := TOrigCaption.Create;
    GOrigMap.AddObject(OrigMapKey(AInstance, APropertyName), E);
  end;
  E.Orig := AOrig;
  E.Produced := AProduced;
end;

procedure LocalizeStringProperty(AInstance: TObject; const APropertyName: string;

  const ATranslationKeyPrefix: string);

var
  PropInfo: PPropInfo;
  CurrentValue: string;
  NewValue, Src: string;
  E: TOrigCaption;
begin
  if AInstance = nil then Exit;
  PropInfo := GetPropInfo(AInstance.ClassInfo, APropertyName);
  if PropInfo = nil then Exit;
  { Delphi Unicode forms use tkUString for Caption/Hint — must include it. }
  if not (PropInfo^.PropType^.Kind in [tkString, tkLString, tkWString, tkUString]) then
    Exit;
  CurrentValue := GetStrProp(AInstance, PropInfo);
  if Trim(CurrentValue) = '' then Exit;
  E := FindOrigCaption(AInstance, APropertyName);
  if Assigned(E) and (E.Produced = CurrentValue) then
    Src := E.Orig
  else
    Src := CurrentValue;
  NewValue := Tr(ATranslationKeyPrefix + '.' + LowerCase(APropertyName), TrText(Src));
  RememberOrigCaption(AInstance, APropertyName, Src, NewValue);
  if NewValue <> CurrentValue then
    SetStrProp(AInstance, PropInfo, NewValue);
end;

procedure ApplyTranslationsToForm(AForm: TCustomForm);

var
  i: Integer;
  C: TComponent;
  Prefix: string;
begin
  if AForm = nil then Exit;
  Prefix := 'ui.' + AForm.Name;
  LocalizeStringProperty(AForm, 'Caption', Prefix);
  LocalizeStringProperty(AForm, 'Hint', Prefix);
  for i := 0 to AForm.ComponentCount - 1 do
  begin
    C := AForm.Components[i];
    if C = nil then Continue;
    Prefix := 'ui.' + AForm.Name + '.' + C.Name;
    LocalizeStringProperty(C, 'Caption', Prefix);
    LocalizeStringProperty(C, 'Hint', Prefix);
  end;

end;

var
  GRevLang: TAppLanguage;
  GRevMap: TStringList = nil;

function LooksLikeIdKey(const K: string): Boolean;
begin
  Result := (Pos(' ', K) = 0) and (Pos('.', K) > 0);
end;

{ Sorted map: translated text (OldLang) -> English source key.
  Plain-text keys win over dotted id keys for the same translated text. }
procedure BuildReverseMap(OldLang: TAppLanguage);
var
  T: TStringList;
  i, Pass: Integer;
  K, V: string;
begin
  if Assigned(GRevMap) and (GRevLang = OldLang) then Exit;
  FreeAndNil(GRevMap);
  GRevMap := TStringList.Create;
  GRevMap.CaseSensitive := True;
  GRevMap.Sorted := True;
  GRevMap.Duplicates := dupIgnore;
  GRevLang := OldLang;
  EnsureLanguageLoaded(OldLang);
  T := TextTableForLanguage(OldLang);
  if T = nil then Exit;
  GRevMap.BeginUpdate;
  try
    for Pass := 0 to 1 do
      for i := 0 to T.Count - 1 do
      begin
        K := UnescKey(T.Names[i]);
        if K = '' then Continue;
        if LooksLikeIdKey(K) <> (Pass = 1) then Continue;
        V := T.ValueFromIndex[i];
        if (V = '') or (V = K) then Continue;
        GRevMap.AddObject(V, TObject(i));
      end;
  finally
    GRevMap.EndUpdate;
  end;
end;

function RetranslateText(const Current: string; OldLang: TAppLanguage): string;
var
  Idx: Integer;
  T: TStringList;
begin
  Result := Current;
  if Trim(Current) = '' then Exit;
  BuildReverseMap(OldLang);
  Idx := GRevMap.IndexOf(Current);
  if Idx >= 0 then
  begin
    T := TextTableForLanguage(OldLang);
    Result := TrText(UnescKey(T.Names[Integer(GRevMap.Objects[Idx])]));
  end
  else
    Result := TrText(Current);
end;

var
  GTplList: TStringList = nil;
  GTplLang: TAppLanguage = alEnglish;

{ Splits a Format template into literals (Count = specs + 1) and specs.
  Specs.Objects = logical argument index. False if not a usable template. }
function SplitFmtTemplate(const T: string; Lits, Specs: TStrings): Boolean;
var
  i, n, j, Idx, NextIdx: Integer;
  Cur: string;
begin
  Result := False;
  Lits.Clear;
  Specs.Clear;
  Cur := '';
  NextIdx := 0;
  n := Length(T);
  i := 1;
  while i <= n do
  begin
    if T[i] <> '%' then
    begin
      Cur := Cur + T[i];
      Inc(i);
      Continue;
    end;
    if (i < n) and (T[i + 1] = '%') then
    begin
      Cur := Cur + '%';
      Inc(i, 2);
      Continue;
    end;
    j := i + 1;
    Idx := -1;
    while (j <= n) and CharInSet(T[j], ['0'..'9']) do Inc(j);
    if (j <= n) and (T[j] = ':') and (j > i + 1) then
    begin
      Idx := StrToIntDef(Copy(T, i + 1, j - i - 1), -1);
      Inc(j);
    end
    else
      j := i + 1;
    if (j <= n) and (T[j] = '-') then Inc(j);
    while (j <= n) and CharInSet(T[j], ['0'..'9']) do Inc(j);
    if (j <= n) and (T[j] = '.') then
    begin
      Inc(j);
      while (j <= n) and CharInSet(T[j], ['0'..'9']) do Inc(j);
    end;
    if (j > n) or not CharInSet(T[j], ['d', 'D', 's', 'S', 'u', 'U', 'f', 'F',
      'n', 'N', 'x', 'X', 'e', 'E', 'g', 'G', 'm', 'M']) then
      Exit;
    if Idx < 0 then
      Idx := NextIdx;
    NextIdx := Idx + 1;
    Lits.Add(Cur);
    Cur := '';
    Specs.AddObject(Copy(T, i, j - i + 1), TObject(Idx));
    i := j + 1;
  end;
  Lits.Add(Cur);
  Result := Specs.Count > 0;
end;

type
  TFmtTplInfo = class
    Lits: TStringList;
    Specs: TStringList;
    TableIdx: Integer;
    LitLen: Integer;
    constructor Create;
    destructor Destroy; override;
  end;

constructor TFmtTplInfo.Create;
begin
  inherited Create;
  Lits := TStringList.Create;
  Specs := TStringList.Create;
end;

destructor TFmtTplInfo.Destroy;
begin
  Specs.Free;
  Lits.Free;
  inherited Destroy;
end;

procedure FreeTemplateList;
var
  i: Integer;
begin
  if not Assigned(GTplList) then Exit;
  for i := 0 to GTplList.Count - 1 do
    GTplList.Objects[i].Free;
  FreeAndNil(GTplList);
end;

procedure BuildTemplateList(OldLang: TAppLanguage);
var
  T: TStringList;
  i, k, LitLen: Integer;
  V: string;
  Info: TFmtTplInfo;
begin
  if Assigned(GTplList) and (GTplLang = OldLang) then Exit;
  FreeTemplateList;
  GTplList := TStringList.Create;
  GTplLang := OldLang;
  EnsureLanguageLoaded(OldLang);
  T := TextTableForLanguage(OldLang);
  if T = nil then Exit;
  for i := 0 to T.Count - 1 do
  begin
    V := T.ValueFromIndex[i];
    if Pos('%', V) = 0 then Continue;
    Info := TFmtTplInfo.Create;
    if not SplitFmtTemplate(V, Info.Lits, Info.Specs) then
    begin
      Info.Free;
      Continue;
    end;
    LitLen := 0;
    for k := 0 to Info.Lits.Count - 1 do
      Inc(LitLen, Length(Trim(Info.Lits[k])));
    { Too little literal text: would match almost anything. }
    if LitLen < 4 then
    begin
      Info.Free;
      Continue;
    end;
    Info.TableIdx := i;
    Info.LitLen := LitLen;
    GTplList.AddObject(V, Info);
  end;
end;

function LooksNumericArg(const S: string): Boolean;
var
  i: Integer;
begin
  Result := Trim(S) <> '';
  for i := 1 to Length(S) do
    if not CharInSet(S[i], ['0'..'9', '.', ',', '-', '+', ' ', #$A0]) and (S[i] <> #$202F) then
      Exit(False);
end;

{ Case-sensitive "Sub occurs in S at position P" without allocating. }
function SameTextAt(const S, Sub: string; P: Integer): Boolean;
begin
  if Sub = '' then
    Exit(True);
  Result := (P >= 1) and (P + Length(Sub) - 1 <= Length(S)) and
    CompareMem(@S[P], @Sub[1], Length(Sub) * SizeOf(Char));
end;

{ Matches Current against one template; fills Args (by logical index). }
function MatchTemplate(const Current: string; Info: TFmtTplInfo; Args: TStrings): Boolean;
var
  k, p, q, n, MaxIdx, Idx: Integer;
  Lits, Specs: TStringList;
  Captured: TStringList;
begin
  Result := False;
  Lits := Info.Lits;
  Specs := Info.Specs;
  n := Specs.Count;
  for k := 1 to n - 1 do
    if Lits[k] = '' then Exit;
  if Length(Current) < Length(Lits[0]) + Length(Lits[n]) then Exit;
  if not SameTextAt(Current, Lits[0], 1) then Exit;
  if not SameTextAt(Current, Lits[n], Length(Current) - Length(Lits[n]) + 1) then Exit;
  Captured := TStringList.Create;
  try
    p := Length(Lits[0]) + 1;
    for k := 1 to n - 1 do
    begin
      q := Pos(Lits[k], Current, p);
      if q = 0 then Exit;
      Captured.Add(Copy(Current, p, q - p));
      p := q + Length(Lits[k]);
    end;
    q := Length(Current) - Length(Lits[n]) + 1;
    if q < p then Exit;
    Captured.Add(Copy(Current, p, q - p));
    MaxIdx := 0;
    for k := 0 to n - 1 do
    begin
      Idx := Integer(Specs.Objects[k]);
      if CharInSet(Specs[k][Length(Specs[k])], ['d', 'D', 'u', 'U']) and
         not LooksNumericArg(Captured[k]) then Exit;
      if Idx > MaxIdx then MaxIdx := Idx;
    end;
    Args.Clear;
    for k := 0 to MaxIdx do
      Args.Add('');
    for k := 0 to n - 1 do
      Args[Integer(Specs.Objects[k])] := Captured[k];
    Result := True;
  finally
    Captured.Free;
  end;
end;

function RetranslateComposedDepth(const Current: string; OldLang: TAppLanguage;
  Depth: Integer; out Changed: Boolean): string; forward;

function TryRetranslateTemplated(const Current: string; OldLang: TAppLanguage;
  Depth: Integer; out NewText: string): Boolean;
var
  i, k, BestLit, Idx: Integer;
  T: TStringList;
  Info: TFmtTplInfo;
  Args, BestArgs, NLits, NSpecs: TStringList;
  BestTpl, NewTpl, Arg, Sub: string;
  SubChanged: Boolean;
begin
  Result := False;
  NewText := Current;
  BuildTemplateList(OldLang);
  T := TextTableForLanguage(OldLang);
  if (T = nil) or (GTplList = nil) then Exit;
  Args := TStringList.Create;
  BestArgs := TStringList.Create;
  NLits := TStringList.Create;
  NSpecs := TStringList.Create;
  try
    BestLit := -1;
    BestTpl := '';
    for i := 0 to GTplList.Count - 1 do
    begin
      Info := TFmtTplInfo(GTplList.Objects[i]);
      if Info.LitLen <= BestLit then Continue;
      if not MatchTemplate(Current, Info, Args) then Continue;
      NewTpl := TrText(UnescKey(T.Names[Info.TableIdx]));
      if not SplitFmtTemplate(NewTpl, NLits, NSpecs) then Continue;
      if NSpecs.Count <> Info.Specs.Count then Continue;
      BestLit := Info.LitLen;
      BestTpl := NewTpl;
      BestArgs.Assign(Args);
    end;
    if BestLit < 0 then Exit;
    SplitFmtTemplate(BestTpl, NLits, NSpecs);
    NewText := NLits[0];
    for k := 0 to NSpecs.Count - 1 do
    begin
      Idx := Integer(NSpecs.Objects[k]);
      if (Idx >= 0) and (Idx < BestArgs.Count) then
        Arg := BestArgs[Idx]
      else
        Arg := '';
      if CharInSet(NSpecs[k][Length(NSpecs[k])], ['s', 'S']) and (Depth < 3) then
      begin
        Sub := RetranslateComposedDepth(Arg, OldLang, Depth + 1, SubChanged);
        if SubChanged then
          Arg := Sub;
      end;
      NewText := NewText + Arg + NLits[k + 1];
    end;
    Result := True;
  finally
    NSpecs.Free;
    NLits.Free;
    BestArgs.Free;
    Args.Free;
  end;
end;

function TryRetranslatePiece(const Piece: string; OldLang: TAppLanguage;
  Depth: Integer; out NewText: string): Boolean;
var
  Core, Lead, Trail: string;
  Idx, a, b: Integer;
  T: TStringList;
begin
  Result := False;
  NewText := Piece;
  a := 1;
  b := Length(Piece);
  while (a <= b) and (Piece[a] <= ' ') do Inc(a);
  while (b >= a) and (Piece[b] <= ' ') do Dec(b);
  if a > b then Exit;
  Lead := Copy(Piece, 1, a - 1);
  Trail := Copy(Piece, b + 1, MaxInt);
  Core := Copy(Piece, a, b - a + 1);
  BuildReverseMap(OldLang);
  Idx := GRevMap.IndexOf(Core);
  if Idx >= 0 then
  begin
    T := TextTableForLanguage(OldLang);
    NewText := Lead + TrText(UnescKey(T.Names[Integer(GRevMap.Objects[Idx])])) + Trail;
    Result := True;
    Exit;
  end;
  if TryRetranslateTemplated(Core, OldLang, Depth, NewText) then
  begin
    NewText := Lead + NewText + Trail;
    Result := True;
  end
  else
    NewText := Piece;
end;

function RetranslateComposedDepth(const Current: string; OldLang: TAppLanguage;
  Depth: Integer; out Changed: Boolean): string;
var
  Cuts: array of Integer;
  i, n, p, e, c: Integer;
  Piece, NewPiece: string;
  Found: Boolean;
begin
  Result := Current;
  Changed := False;
  if Trim(Current) = '' then Exit;
  BuildReverseMap(OldLang);
  if (GRevMap.IndexOf(Trim(Current)) >= 0) and
     TryRetranslatePiece(Current, OldLang, Depth, NewPiece) then
  begin
    Changed := True;
    Exit(NewPiece);
  end;

  { Cut after sentence punctuation and take, from each position, the shortest
    translatable run: appended sentences must not end up inside a template's
    last argument. Latin punctuation counts only before whitespace (paths,
    decimals and "a.." stay intact). }
  n := Length(Current);
  SetLength(Cuts, 0);
  for i := 1 to n - 1 do
    if (CharInSet(Current[i], ['.', '!', '?', ':', ';']) and
        CharInSet(Current[i + 1], [' ', #9, #13, #10])) or
       (Current[i] = #$3002) or (Current[i] = #$FF01) or (Current[i] = #$FF1F) or
       (Current[i] = #$FF1A) then
    begin
      SetLength(Cuts, Length(Cuts) + 1);
      Cuts[High(Cuts)] := i;
    end;
  SetLength(Cuts, Length(Cuts) + 1);
  Cuts[High(Cuts)] := n;

  Result := '';
  p := 1;
  while p <= n do
  begin
    Found := False;
    for c := 0 to High(Cuts) do
    begin
      e := Cuts[c];
      if e < p then Continue;
      Piece := Copy(Current, p, e - p + 1);
      if TryRetranslatePiece(Piece, OldLang, Depth, NewPiece) then
      begin
        Result := Result + NewPiece;
        p := e + 1;
        Found := True;
        Changed := True;
        Break;
      end;
    end;
    if not Found then
    begin
      e := n;
      for c := 0 to High(Cuts) do
        if Cuts[c] >= p then
        begin
          e := Cuts[c];
          Break;
        end;
      Result := Result + Copy(Current, p, e - p + 1);
      p := e + 1;
    end;
  end;
  if not Changed then
    Result := Current;
end;

var
  { Same caption/hint repeats across many controls; the template scan is the
    expensive part of a language switch. Valid for one (Old, Current) pair. }
  GComposedCache: TDictionary<string, string> = nil;
  GComposedCacheOld: TAppLanguage = alEnglish;
  GComposedCacheNew: TAppLanguage = alEnglish;

procedure FreeComposedCache;
begin
  FreeAndNil(GComposedCache);
end;

function RetranslateComposedText(const Current: string; OldLang: TAppLanguage): string;
var
  Changed: Boolean;
begin
  if OldLang = GCurrentLanguage then
    Exit(Current);
  if Assigned(GComposedCache) and
     ((GComposedCacheOld <> OldLang) or (GComposedCacheNew <> GCurrentLanguage)) then
    FreeComposedCache;
  if not Assigned(GComposedCache) then
  begin
    GComposedCache := TDictionary<string, string>.Create;
    GComposedCacheOld := OldLang;
    GComposedCacheNew := GCurrentLanguage;
  end;
  if GComposedCache.TryGetValue(Current, Result) then
    Exit;
  Result := RetranslateComposedDepth(Current, OldLang, 0, Changed);
  GComposedCache.AddOrSetValue(Current, Result);
end;

procedure RetranslateStrProp(AInstance: TObject; const APropertyName, AKey: string;
  OldLang: TAppLanguage);
var
  PropInfo: PPropInfo;
  Cur, OldKeyed, NewValue: string;
  E: TOrigCaption;
begin
  if AInstance = nil then Exit;
  PropInfo := GetPropInfo(AInstance.ClassInfo, APropertyName);
  if PropInfo = nil then Exit;
  if not (PropInfo^.PropType^.Kind in [tkString, tkLString, tkWString, tkUString]) then
    Exit;
  Cur := GetStrProp(AInstance, PropInfo);
  if Trim(Cur) = '' then Exit;
  NewValue := '';
  E := FindOrigCaption(AInstance, APropertyName);
  if Assigned(E) and (E.Produced = Cur) then
  begin
    if AKey <> '' then
      NewValue := Tr(AKey, TrText(E.Orig))
    else
      NewValue := TrText(E.Orig);
    E.Produced := NewValue;
  end;
  if (NewValue = '') and (AKey <> '') and
     TryGetValue(TableForLanguage(OldLang), AKey, OldKeyed) and (OldKeyed = Cur) then
    NewValue := Tr(AKey, Cur);
  if NewValue = '' then
    NewValue := RetranslateText(Cur, OldLang);
  { Runtime-composed captions ("Label: <path>", Format results). }
  if (NewValue = Cur) and (Length(Cur) <= 300) then
    NewValue := RetranslateComposedText(Cur, OldLang);
  if NewValue <> Cur then
    SetStrProp(AInstance, PropInfo, NewValue);
end;

{ Short read-only memos hold status text ("No events for line 1.") — never
  user documents, which are editable or long. }
procedure RetranslateReadOnlyMemo(C: TComponent; OldLang: TAppLanguage);
var
  PropInfo: PPropInfo;
  Obj: TObject;
  S: TStrings;
  i: Integer;
  V: string;
begin
  PropInfo := GetPropInfo(C.ClassInfo, 'ReadOnly');
  if (PropInfo = nil) or (PropInfo^.PropType^.Kind <> tkEnumeration) then Exit;
  if GetOrdProp(C, PropInfo) = 0 then Exit;
  PropInfo := GetPropInfo(C.ClassInfo, 'Lines');
  if (PropInfo = nil) or (PropInfo^.PropType^.Kind <> tkClass) then Exit;
  Obj := GetObjectProp(C, PropInfo);
  if not (Obj is TStrings) then Exit;
  S := TStrings(Obj);
  if (S.Count = 0) or (S.Count > 20) or (Length(S.Text) > 1500) then Exit;
  S.BeginUpdate;
  try
    for i := 0 to S.Count - 1 do
    begin
      if Trim(S[i]) = '' then Continue;
      V := RetranslateComposedText(S[i], OldLang);
      if V <> S[i] then
        S[i] := V;
    end;
  finally
    S.EndUpdate;
  end;
end;

procedure RetranslateStrings(S: TStrings; OldLang: TAppLanguage);
var
  i: Integer;
  V: string;
begin
  { Long lists hold data (logs, histories), not UI captions. }
  if (S = nil) or (S.Count > 100) then Exit;
  S.BeginUpdate;
  try
    for i := 0 to S.Count - 1 do
    begin
      V := RetranslateText(S[i], OldLang);
      if (V = S[i]) and (Length(V) <= 300) then
        V := RetranslateComposedText(S[i], OldLang);
      if V <> S[i] then
        S[i] := V;
    end;
  finally
    S.EndUpdate;
  end;
end;

procedure RetranslateComponent(C: TComponent; const FormName: string;
  OldLang: TAppLanguage; Done: TList);
var
  i, SaveIdx: Integer;
  Key: string;
  Obj: TObject;
  PropInfo: PPropInfo;
begin
  if (C = nil) or (Done.IndexOf(C) >= 0) then Exit;
  Done.Add(C);
  if Assigned(RetranslateTickProc) and ((Done.Count and 15) = 0) then
    RetranslateTickProc;
  if C.Name <> '' then
    Key := 'ui.' + FormName + '.' + C.Name
  else
    Key := '';
  { One misbehaving component must not stop the rest of the form. }
  try
    if Key <> '' then
    begin
      RetranslateStrProp(C, 'Caption', Key + '.caption', OldLang);
      RetranslateStrProp(C, 'Hint', Key + '.hint', OldLang);
    end
    else
    begin
      RetranslateStrProp(C, 'Caption', '', OldLang);
      RetranslateStrProp(C, 'Hint', '', OldLang);
    end;
    RetranslateStrProp(C, 'TextHint', '', OldLang);
  except
  end;

  { TListView columns, TRadioGroup/TComboBox/TListBox items. }
  try
    PropInfo := GetPropInfo(C.ClassInfo, 'Columns');
    if (PropInfo <> nil) and (PropInfo^.PropType^.Kind = tkClass) then
    begin
      Obj := GetObjectProp(C, PropInfo);
      if Obj is TCollection then
        for i := 0 to TCollection(Obj).Count - 1 do
          RetranslateStrProp(TCollection(Obj).Items[i], 'Caption', '', OldLang);
    end;
  except
  end;
  try
    PropInfo := GetPropInfo(C.ClassInfo, 'Items');
    if (PropInfo <> nil) and (PropInfo^.PropType^.Kind = tkClass) then
    begin
      Obj := GetObjectProp(C, PropInfo);
      if Obj is TStrings then
      begin
        SaveIdx := -1;
        if GetPropInfo(C.ClassInfo, 'ItemIndex') <> nil then
          SaveIdx := GetOrdProp(C, 'ItemIndex');
        RetranslateStrings(TStrings(Obj), OldLang);
        if SaveIdx >= 0 then
          SetOrdProp(C, 'ItemIndex', SaveIdx);
      end;
    end;
  except
  end;
  try
    RetranslateReadOnlyMemo(C, OldLang);
  except
  end;

  for i := 0 to C.ComponentCount - 1 do
    RetranslateComponent(C.Components[i], FormName, OldLang, Done);
  if C is TWinControl then
    for i := 0 to TWinControl(C).ControlCount - 1 do
      RetranslateComponent(TWinControl(C).Controls[i], FormName, OldLang, Done);
end;

procedure RetranslateForm(AForm: TCustomForm; OldLang: TAppLanguage);
var
  Done: TList;
begin
  if AForm = nil then Exit;
  if OldLang = GCurrentLanguage then Exit;
  Done := TList.Create;
  try
    RetranslateStrProp(AForm, 'Caption', 'ui.' + AForm.Name + '.caption', OldLang);
    Done.Add(AForm);
    RetranslateComponent(AForm, AForm.Name, OldLang, Done);
  finally
    Done.Free;
  end;
end;

procedure RetranslateAllForms(OldLang: TAppLanguage; ASkip: TCustomForm);
var
  i: Integer;
  F: TCustomForm;
begin
  if OldLang = GCurrentLanguage then Exit;
  for i := 0 to Screen.CustomFormCount - 1 do
  begin
    F := Screen.CustomForms[i];
    if (F = nil) or (F = ASkip) then Continue;
    try
      RetranslateForm(F, OldLang);
    except
      { A single broken form must not abort the language switch. }
    end;
    if Assigned(RetranslateTickProc) then
      RetranslateTickProc;
  end;
  for i := 0 to Screen.CustomFormCount - 1 do
  begin
    F := Screen.CustomForms[i];
    if (F = nil) or not F.HandleAllocated then Continue;
    try
      F.Perform(WM_FF_LANGUAGE_CHANGED, Ord(OldLang), 0);
    except
    end;
  end;
  FreeAndNil(GRevMap);
end;


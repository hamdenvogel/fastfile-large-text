    FFilteredCount, FFilterUseHitsFile, HitsCopy, FFilterBits, FFilterBitsSize,
    FFilterJumpTable, FFilterTotalLines, CanStreamExportFilteredLines,
    FFilterText, ACaseSensitive, Mode, True);

constructor TFindInFileThread.Create(AOwner: TfrmMain; const AFileName, AIndexFileName: string;
  const ANeedle: string; ACaseSensitive: Boolean; const AStartPos: Int64;
  const ADirection: Integer; const ASearchId: Integer;
  AUseSparseLineMap: Boolean; const ACkptFileName: string; const ATotalLinesSparse: Int64;
  AByteOnlyMode: Boolean; const AAvgBytesPerLine: Int64; const AEstimatedTotalLines: Int64;
  AUseZeroScanFastIO: Boolean; const ABlockIndexPath: string);
begin
  inherited Create(True);
  FreeOnTerminate := True;
  Priority := tpLower;
  FOwner := AOwner;
  FFileName := AFileName;
  FIndexFileName := AIndexFileName;
  FUseSparseLineMap := AUseSparseLineMap;
  FCkptFileName := ACkptFileName;
  FTotalLinesSparse := ATotalLinesSparse;
  FByteOnlyMode := AByteOnlyMode;
  FUseZeroScanFastIO := AUseZeroScanFastIO;
  FBlockIndexPath := ABlockIndexPath;
  FLineTermByte := LineTermByteForFile(AFileName);
  FAvgBytesPerLine := AAvgBytesPerLine;
  if FAvgBytesPerLine < 1 then FAvgBytesPerLine := 1;
  FEstimatedTotalLines := AEstimatedTotalLines;
  if FEstimatedTotalLines < 1 then FEstimatedTotalLines := 1;
  FNeedleUnicode := ANeedle;
  if Assigned(AOwner) then
    FEncoding := AOwner.EffectiveDisplayEncoding
  else
    FEncoding := '';
  FEncoding := ResolveTextEncoding(AFileName, FEncoding);
  FNeedle := UnicodeTextToFileBytes(ANeedle, FEncoding);
  FCaseSensitive := ACaseSensitive;
  FStartPos := AStartPos;
  FDirection := ADirection;
  FSearchId := ASearchId;
  FErrorMsg := '';
  if not FCaseSensitive then
    FNeedleUpper := UnicodeTextToFileBytes(UnicodeUpperCaseW(ANeedle), FEncoding)
  else
    FNeedleUpper := FNeedle;
  FFound := False;
  FFoundLine := -1;
  FFoundPos := -1;
  FLastFindProgressPos := -1;
  Resume;
end;

procedure TFindInFileThread.NotifyOwner;
begin
  FOwner.FindThreadDone(FFound, FFoundLine, FFoundPos, FSearchId, FErrorMsg);
end;

procedure TFindInFileThread.SyncFindBytesProgress;
begin
  if Assigned(FOwner) then
    FOwner.UpdateFindSearchProgress(FProgBytes, FProgTotal);
end;

function TFindInFileThread.OffsetToLineIndex(AIndexStream: TFileStream; const APos1Based: Int64): Integer;
var
  Lo, Hi, Mid: Integer;
  TotalLines: Integer;
  OffsetStr: AnsiString;
  MidOffset: Int64;
begin
  Result := -1;
  if not Assigned(AIndexStream) then Exit;
  TotalLines := AIndexStream.Size div INDEX_RECORD_SIZE;
  if TotalLines <= 0 then Exit;
  SetLength(OffsetStr, 18);
  Lo := 0;
  Hi := TotalLines - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    AIndexStream.Seek(Int64(Mid) * INDEX_RECORD_SIZE, Word(soFromBeginning));
    AIndexStream.Read(Pointer(OffsetStr)^, 18);
    MidOffset := StrToInt64Def(Trim(string(OffsetStr)), -1);
    if MidOffset = APos1Based then
    begin
      Result := Mid;
      Exit;
    end
    else if MidOffset < APos1Based then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
  // Retorna a linha mais proxima (Hi e o maior indice cujo offset <= APos1Based)
  if Hi >= 0 then
    Result := Hi
  else
    Result := 0;
end;

function TFindInFileThread.LineStartByteSparse(Ckpt, Src: TFileStream; const L0: Int64): Int64;
var
  CkptIdx: Int64;
  SkipCount: Integer;
  OffsetBuf: array[0..19] of AnsiChar;
  BytesRead: Integer;
  S: AnsiString;
  ScanBuf: array[0..65535] of Byte;
  ScanRead, ScanI: Integer;
  ScanRemaining: Integer;
  ScanPos: Int64;
begin
  Result := -1;
  if (L0 < 0) or (Ckpt = nil) or (Src = nil) then Exit;
  CkptIdx := L0 div CKPT_INTERVAL;
  SkipCount := Integer(L0 mod CKPT_INTERVAL);
  try
    Ckpt.Seek(CkptIdx * INDEX_RECORD_SIZE, Word(soFromBeginning));
    BytesRead := Ckpt.Read(OffsetBuf, 18);
    if BytesRead < 18 then Exit;
    SetString(S, PAnsiChar(@OffsetBuf[0]), 18);
    Result := StrToInt64Def(Trim(string(S)), -1);
    if Result <= 0 then begin Result := -1; Exit; end;
    Result := Abs(Result);
    if SkipCount > 0 then
    begin
      ScanRemaining := SkipCount;
      ScanPos := Result - 1;
      Src.Seek(ScanPos, Word(soFromBeginning));
      while ScanRemaining > 0 do
      begin
        ScanRead := Src.Read(ScanBuf, SizeOf(ScanBuf));
        if ScanRead = 0 then Break;
        for ScanI := 0 to ScanRead - 1 do
        begin
          Inc(ScanPos);
          if ScanBuf[ScanI] = FLineTermByte then
          begin
            Dec(ScanRemaining);
            if ScanRemaining = 0 then Break;
          end;
        end;
      end;
      Result := ScanPos + 1;
    end;
  except
    Result := -1;
  end;
end;

function TFindInFileThread.SparseOffsetToLineIndex(Ckpt, Src: TFileStream; const APos1Based: Int64): Integer;
var
  Lo, Hi, Mid: Int64;
  StartMid: Int64;
begin
  Result := -1;
  if FTotalLinesSparse <= 0 then Exit;
  Lo := 0;
  Hi := FTotalLinesSparse - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    StartMid := LineStartByteSparse(Ckpt, Src, Mid);
    if StartMid < 0 then Exit;
    if StartMid <= APos1Based then
    begin
      Result := Integer(Mid);
      Lo := Mid + 1;
    end
    else
      Hi := Mid - 1;
  end;
  if Result < 0 then Result := 0;
end;

procedure TFindInFileThread.ExecuteUnicodeCI;
var
  Src: TFileStream;
  Buf: array[0..65535] of AnsiChar;
  Line: AnsiString;
  Got, I, P: Integer;
  FilePos, LineStart: Int64;
  LineTxt, NeedleU: string;
  PrefixBytes: AnsiString;
  LastMatchPos: Int64;
  LastMatchLine: Integer;
  LineNo: Integer;
begin
  FFound := False;
  FFoundLine := -1;
  FFoundPos := -1;
  LastMatchPos := -1;
  LastMatchLine := -1;
  LineNo := 0;
  Src := nil;
  try
    if FNeedleUnicode = '' then
    begin
      if not Terminated then Synchronize(NotifyOwner);
      Exit;
    end;
    NeedleU := UnicodeUpperCaseW(FNeedleUnicode);
    Src := TFileStream.Create(FFileName, fmOpenRead or fmShareDenyNone);
    FilePos := 0;
    LineStart := 1;
    Line := '';
    while (not Terminated) do
    begin
      Got := Src.Read(Buf, SizeOf(Buf));
      if Got <= 0 then Break;
      I := 0;
      while I < Got do
      begin
        if Buf[I] = AnsiChar(FLineTermByte) then
        begin
          LineTxt := FileBytesToUnicodeText(Line, FEncoding);
          P := Pos(NeedleU, UnicodeUpperCaseW(LineTxt));
          if P > 0 then
          begin
            PrefixBytes := UnicodeTextToFileBytes(Copy(LineTxt, 1, P - 1), FEncoding);
            FFoundPos := LineStart + Length(PrefixBytes);
            FFoundLine := LineNo;
            FFound := True;
            LastMatchPos := FFoundPos;
            LastMatchLine := LineNo;
            if FDirection >= 0 then
            begin
              if FFoundPos >= FStartPos then
              begin
                if Assigned(Src) then Src.Free;
                if not Terminated then Synchronize(NotifyOwner);
                Exit;
              end;
            end;
          end;
          Line := '';
          LineStart := FilePos + I + 2;
          Inc(LineNo);
        end
        else if Buf[I] <> #13 then
          Line := Line + Buf[I];
        Inc(I);
      end;
      Inc(FilePos, Got);
    end;
    if (not Terminated) and (Line <> '') then
    begin
      LineTxt := FileBytesToUnicodeText(Line, FEncoding);
      P := Pos(NeedleU, UnicodeUpperCaseW(LineTxt));
      if P > 0 then
      begin
        PrefixBytes := UnicodeTextToFileBytes(Copy(LineTxt, 1, P - 1), FEncoding);
        FFoundPos := LineStart + Length(PrefixBytes);
        FFoundLine := LineNo;
        FFound := True;
        LastMatchPos := FFoundPos;
        LastMatchLine := LineNo;
      end;
    end;
    if FDirection < 0 then
    begin
      FFound := LastMatchPos > 0;
      FFoundPos := LastMatchPos;
      FFoundLine := LastMatchLine;
    end;
  except
    on E: Exception do
      FErrorMsg := E.Message;
  end;
  if Assigned(Src) then Src.Free;
  if not Terminated then
    Synchronize(NotifyOwner);
end;

procedure TFindInFileThread.ExecuteZeroScanFast;
type
  TShiftTable = array[0..255] of Integer;
var
  MMF: TMMFReader;
  Idx: TFileStream;
  SrcFs: TFileStream;
  FileSize: Int64;
  Contiguous: Cardinal;
  P: PByte;
  NeedLen: Integer;
  CurPos: Int64;
  HintPos: Int64;
  BytesRead: Integer;
  BufRaw, WorkBuf, Tail: array of Byte;
  TailLen: Integer;
  Shift: TShiftTable;
  Up: array[0..255] of Byte;
  Pat, PatU: array of Byte;
  FoundBaseAbs, CandidateAbs: Int64;
  StartIndex: Integer;
  FoundIdx, I, J: Integer;
  B, TB: Byte;

  procedure BuildUpTable;
  var K: Integer;
    Ch: AnsiChar;
    UpCh: AnsiString;
  begin
    for K := 0 to 255 do
    begin
      Ch := AnsiChar(K);
      UpCh := AnsiUpperCase(string(Ch));
      if Length(UpCh) >= 1 then
        Up[K] := Byte(AnsiChar(UpCh[1]))
      else
        Up[K] := K;
    end;
  end;

  procedure BuildPatternBytes;
  var K: Integer;
  begin
    SetLength(Pat, NeedLen);
    SetLength(PatU, NeedLen);
    for K := 0 to NeedLen - 1 do
    begin
      B := Byte(AnsiChar(FNeedle[K + 1]));
      Pat[K] := B;
      PatU[K] := Up[B];
    end;
  end;

  procedure BuildShiftTable;
  var K, B2, ShiftVal: Integer;
  begin
    for K := 0 to 255 do Shift[K] := NeedLen;
    for K := 0 to NeedLen - 2 do
    begin
      ShiftVal := (NeedLen - 1) - K;
      if FCaseSensitive then
      begin
        if ShiftVal < Shift[Pat[K]] then
          Shift[Pat[K]] := ShiftVal;
      end
      else
        for B2 := 0 to 255 do
          if Up[B2] = PatU[K] then
            if ShiftVal < Shift[B2] then
              Shift[B2] := ShiftVal;
    end;
  end;

  function BMH_FindFirst(const Buf: PByte; const BufLen: Integer; const AStartIndex: Integer): Integer;
  var II, JJ, BaseI: Integer;
  begin
    Result := -1;
    if (NeedLen <= 0) or (BufLen < NeedLen) then Exit;
    II := AStartIndex + (NeedLen - 1);
    while II < BufLen do
    begin
      JJ := NeedLen - 1;
      if FCaseSensitive then
      begin
        while (JJ >= 0) do
        begin
          BaseI := II - ((NeedLen - 1) - JJ);
          if PFFByteArray(Buf)^[BaseI] <> PFFByteArray(Pat)^[JJ] then Break;
          Dec(JJ);
        end;
      end
      else
      begin
        while (JJ >= 0) do
        begin
          BaseI := II - ((NeedLen - 1) - JJ);
          if Up[PFFByteArray(Buf)^[BaseI]] <> PFFByteArray(PatU)^[JJ] then Break;
          Dec(JJ);
        end;
      end;
      if JJ < 0 then begin Result := II - (NeedLen - 1); Exit; end;
      if FCaseSensitive then TB := PFFByteArray(Buf)^[II]
      else TB := Up[PFFByteArray(Buf)^[II]];
      Inc(II, Shift[TB]);
    end;
  end;

begin
  if (not FCaseSensitive) and EncodingNeedsWideCompare(FEncoding, FNeedleUnicode) then
  begin
    ExecuteUnicodeCI;
    Exit;
  end;
  MMF := nil;
  Idx := nil;
  SrcFs := nil;
  try
    if FNeedle = '' then Exit;
    MMF := TMMFReader.Create(FFileName);
    FileSize := MMF.FileSize;
    if FByteOnlyMode then
      Idx := nil
    else if FUseSparseLineMap then
    begin
      if (FCkptFileName = '') or (not FileExists(FCkptFileName)) or (FTotalLinesSparse <= 0) then
        raise Exception.Create('Sparse checkpoint index not available');
      Idx := TFileStream.Create(FCkptFileName, fmOpenRead or fmShareDenyNone);
      SrcFs := TFileStream.Create(FFileName, fmOpenRead or fmShareDenyNone);
    end;
    NeedLen := Length(FNeedle);
    if NeedLen <= 0 then Exit;
    if FStartPos < 0 then FStartPos := 0;
    if FStartPos > FileSize then FStartPos := FileSize;
    BuildUpTable;
    BuildPatternBytes;
    BuildShiftTable;
    if FDirection >= 0 then
    begin
      CurPos := FStartPos;
      if (FBlockIndexPath <> '') and FileExists(FBlockIndexPath) then
      begin
        HintPos := ZeroScanBlockHintPos0(FBlockIndexPath, CurPos);
        if HintPos > CurPos then
          CurPos := HintPos;
      end;
      TailLen := 0;
      SetLength(Tail, 0);
      while (not Terminated) and (CurPos < FileSize) and (not FFound) do
      begin
        P := MMF.PtrAt(CurPos, BUF_SIZE, Contiguous);
        if (P = nil) or (Contiguous = 0) then Break;
        BytesRead := Integer(Contiguous);
        if TailLen > 0 then
        begin
          SetLength(WorkBuf, TailLen + BytesRead);
          Move(Tail[0], WorkBuf[0], TailLen);
          Move(P^, WorkBuf[TailLen], BytesRead);
          FoundBaseAbs := CurPos - TailLen;
        end
        else
        begin
          SetLength(WorkBuf, BytesRead);
          Move(P^, WorkBuf[0], BytesRead);
          FoundBaseAbs := CurPos;
        end;
        StartIndex := 0;
        if FoundBaseAbs < FStartPos then
          StartIndex := Integer(FStartPos - FoundBaseAbs);
        FoundIdx := BMH_FindFirst(@WorkBuf[0], Length(WorkBuf), StartIndex);
        if FoundIdx >= 0 then
        begin
          CandidateAbs := FoundBaseAbs + FoundIdx;
          FFoundPos := CandidateAbs;
          if FByteOnlyMode then
          begin
            FFoundLine := Integer(CandidateAbs div FAvgBytesPerLine);
            if FFoundLine < 0 then FFoundLine := 0;
            if FFoundLine >= FEstimatedTotalLines then
              FFoundLine := Integer(FEstimatedTotalLines - 1);
          end
          else if FUseSparseLineMap then
            FFoundLine := SparseOffsetToLineIndex(Idx, SrcFs, CandidateAbs + 1)
          else
            FFoundLine := -1;
          FFound := True;
          Break;
        end;
        if NeedLen > 1 then
        begin
          TailLen := NeedLen - 1;
          if TailLen > Length(WorkBuf) then TailLen := Length(WorkBuf);
          SetLength(Tail, TailLen);
          if TailLen > 0 then
            Move(WorkBuf[Length(WorkBuf) - TailLen], Tail[0], TailLen);
        end
        else
        begin
          TailLen := 0;
          SetLength(Tail, 0);
        end;
        Inc(CurPos, Contiguous);
        if (FileSize > 0) and ((FLastFindProgressPos < 0) or
          (CurPos - FLastFindProgressPos >= 2 * 1024 * 1024) or (CurPos >= FileSize)) then
        begin
          FProgBytes := CurPos;
          FProgTotal := FileSize;
          FLastFindProgressPos := CurPos;
          if not Terminated then
            Synchronize(SyncFindBytesProgress);
        end;
      end;
    end;
  except
    on E: Exception do
      FErrorMsg := E.Message;
  end;
  if Assigned(Idx) then Idx.Free;
  if Assigned(SrcFs) then SrcFs.Free;
  if Assigned(MMF) then MMF.Free;
  if not Terminated then
    Synchronize(NotifyOwner);
end;

procedure TFindInFileThread.Execute;
type
  TShiftTable = array[0..255] of Integer;
var
  SourceStream: TFileStream;
  Idx: TFileStream;
  FileSize: Int64;
  NeedLen: Integer;
  CurPos: Int64;
  ReadSize: Integer;
  BytesRead: Integer;
  BufRaw: array of Byte;
  WorkBuf: array of Byte;
  Tail: array of Byte;
  TailLen: Integer;
  Shift: TShiftTable;
  Up: array[0..255] of Byte;
  Pat: array of Byte;
  PatU: array of Byte;
  FoundBaseAbs: Int64;
  CandidateAbs: Int64;
  StartIndex: Integer;
  FoundIdx: Integer;
  I, J: Integer;
  C: AnsiChar;
  B, TB: Byte;
  BaseIdx: Integer;

  procedure BuildUpTable;
  var K: Integer;
    Ch: AnsiChar;
    UpCh: AnsiString;
  begin
    { Mesma regra de AnsiUpperCase usada em AlignMatchColInLineText (ignore case). }
    for K := 0 to 255 do
    begin
      Ch := AnsiChar(K);
      UpCh := AnsiUpperCase(string(Ch));
      if Length(UpCh) >= 1 then
        Up[K] := Byte(AnsiChar(UpCh[1]))
      else
        Up[K] := K;
    end;
  end;

  procedure BuildPatternBytes;
  var K: Integer;
  begin
    SetLength(Pat, NeedLen);
    SetLength(PatU, NeedLen);
    for K := 0 to NeedLen - 1 do begin
      B := Byte(AnsiChar(FNeedle[K + 1]));
      Pat[K] := B;
      PatU[K] := Up[B];
    end;
  end;

  procedure BuildShiftTable;
  var K, B, ShiftVal: Integer;
  begin
    for K := 0 to 255 do Shift[K] := NeedLen;
    for K := 0 to NeedLen - 2 do
    begin
      ShiftVal := (NeedLen - 1) - K;
      if FCaseSensitive then
      begin
        if ShiftVal < Shift[Pat[K]] then
          Shift[Pat[K]] := ShiftVal;
      end
      else
      begin
        { Horspool insensitive: menor shift para todos os bytes com o mesmo Up[]. }
        for B := 0 to 255 do
          if Up[B] = PatU[K] then
            if ShiftVal < Shift[B] then
              Shift[B] := ShiftVal;
      end;
    end;
  end;

  function BMH_FindFirst(const Buf: PByte; const BufLen: Integer; const AStartIndex: Integer): Integer;
  var II, JJ, BaseI: Integer;
  begin
    Result := -1;
    if (NeedLen <= 0) or (BufLen < NeedLen) then Exit;
    II := AStartIndex + (NeedLen - 1);
    while II < BufLen do begin
      JJ := NeedLen - 1;
      if FCaseSensitive then begin
        while (JJ >= 0) do begin
          BaseI := II - ((NeedLen - 1) - JJ);
          if PFFByteArray(Buf)^[BaseI] <> PFFByteArray(Pat)^[JJ] then Break;
          Dec(JJ);
        end;
      end else begin
        while (JJ >= 0) do begin
          BaseI := II - ((NeedLen - 1) - JJ);
          if Up[PFFByteArray(Buf)^[BaseI]] <> PFFByteArray(PatU)^[JJ] then Break;
          Dec(JJ);
        end;
      end;
      if JJ < 0 then begin Result := II - (NeedLen - 1); Exit; end;
      if FCaseSensitive then TB := PFFByteArray(Buf)^[II]
      else TB := Up[PFFByteArray(Buf)^[II]];
      Inc(II, Shift[TB]);
    end;
  end;

begin
  if (not FCaseSensitive) and EncodingNeedsWideCompare(FEncoding, FNeedleUnicode) then
  begin
    ExecuteUnicodeCI;
    Exit;
  end;
  if FUseZeroScanFastIO then
  begin
    ExecuteZeroScanFast;
    Exit;
  end;
  SourceStream := nil;
  Idx := nil;
  try
    try
      begin
      if (FNeedle = '') then Exit;
      SourceStream := TFileStream.Create(FFileName, fmOpenRead or fmShareDenyNone);
      FileSize := SourceStream.Size;
      if FByteOnlyMode then
        Idx := nil
      else if FUseSparseLineMap then
      begin
        if (FCkptFileName = '') or (not FileExists(FCkptFileName)) or (FTotalLinesSparse <= 0) then
          raise Exception.Create('Sparse checkpoint index not available');
        Idx := TFileStream.Create(FCkptFileName, fmOpenRead or fmShareDenyNone);
      end
      else
      begin
        if (FIndexFileName = '') or (not FileExists(FIndexFileName)) then
          raise Exception.Create('Dense line index not available');
        Idx := TFileStream.Create(FIndexFileName, fmOpenRead or fmShareDenyNone);
      end;
    NeedLen := Length(FNeedle);
    if NeedLen <= 0 then Exit;
    if FStartPos < 0 then FStartPos := 0;
    if FStartPos > FileSize then FStartPos := FileSize;
    BuildUpTable;
    BuildPatternBytes;
    BuildShiftTable;
    SetLength(BufRaw, BUF_SIZE);

    if FDirection >= 0 then
    begin
      CurPos := FStartPos;
      TailLen := 0;
      SetLength(Tail, 0);
      while (not Terminated) and (CurPos < FileSize) and (not FFound) do
      begin
        ReadSize := BUF_SIZE;
        if CurPos + ReadSize > FileSize then ReadSize := Integer(FileSize - CurPos);
        if ReadSize <= 0 then Break;
        SourceStream.Seek(CurPos, Word(soFromBeginning));
        BytesRead := SourceStream.Read(BufRaw[0], ReadSize);
        if BytesRead <= 0 then Break;
        if TailLen > 0 then begin
          SetLength(WorkBuf, TailLen + BytesRead);
          Move(Tail[0], WorkBuf[0], TailLen);
          Move(BufRaw[0], WorkBuf[TailLen], BytesRead);
          FoundBaseAbs := (CurPos - TailLen);
        end else begin
          SetLength(WorkBuf, BytesRead);
          Move(BufRaw[0], WorkBuf[0], BytesRead);
          FoundBaseAbs := CurPos;
        end;
        StartIndex := 0;
        if FoundBaseAbs < FStartPos then StartIndex := Integer(FStartPos - FoundBaseAbs);
        FoundIdx := BMH_FindFirst(@WorkBuf[0], Length(WorkBuf), StartIndex);
        if FoundIdx >= 0 then begin
          CandidateAbs := FoundBaseAbs + FoundIdx;
          FFoundPos := CandidateAbs;
          if FByteOnlyMode then
          begin
            FFoundLine := Integer(CandidateAbs div FAvgBytesPerLine);
            if FFoundLine < 0 then FFoundLine := 0;
            if FFoundLine >= FEstimatedTotalLines then
              FFoundLine := Integer(FEstimatedTotalLines - 1);
          end
          else if FUseSparseLineMap then
            FFoundLine := SparseOffsetToLineIndex(Idx, SourceStream, CandidateAbs + 1)
          else
            FFoundLine := OffsetToLineIndex(Idx, CandidateAbs + 1);
          FFound := True;
          Break;
        end;
        if NeedLen > 1 then begin
          TailLen := NeedLen - 1;
          if TailLen > Length(WorkBuf) then TailLen := Length(WorkBuf);
          SetLength(Tail, TailLen);
          if TailLen > 0 then Move(WorkBuf[Length(WorkBuf) - TailLen], Tail[0], TailLen);
        end         else begin TailLen := 0; SetLength(Tail, 0); end;
        CurPos := CurPos + BytesRead;
        if (FileSize > 0) and ((FLastFindProgressPos < 0) or (CurPos - FLastFindProgressPos >= 2 * 1024 * 1024) or (CurPos >= FileSize)) then
        begin
          FProgBytes := CurPos;
          FProgTotal := FileSize;
          FLastFindProgressPos := CurPos;
          if not Terminated then
            Synchronize(SyncFindBytesProgress);
        end;
      end;
    end
    else
    begin
      // backward: scan blocks in reverse, find last match before FStartPos
      FLastFindProgressPos := -1;
      CurPos := FStartPos;
      while (not Terminated) and (CurPos > 0) and (not FFound) do
      begin
        ReadSize := BUF_SIZE;
        if ReadSize > CurPos then ReadSize := Integer(CurPos);
        if ReadSize <= 0 then Break;
        SourceStream.Seek(CurPos - ReadSize, Word(soFromBeginning));
        BytesRead := SourceStream.Read(BufRaw[0], ReadSize);
        if BytesRead <= 0 then Break;
        SetLength(WorkBuf, BytesRead);
        Move(BufRaw[0], WorkBuf[0], BytesRead);
        // scan forward to find last match before FStartPos
        FoundIdx := 0;
        CandidateAbs := -1;
        while True do begin
          J := BMH_FindFirst(@WorkBuf[0], Length(WorkBuf), FoundIdx);
          if J < 0 then Break;
          if (CurPos - ReadSize + J) < FStartPos then
            CandidateAbs := CurPos - ReadSize + J;
          FoundIdx := J + 1;
        end;
        if CandidateAbs >= 0 then begin
          FFoundPos := CandidateAbs;
          if FByteOnlyMode then
          begin
            FFoundLine := Integer(CandidateAbs div FAvgBytesPerLine);
            if FFoundLine < 0 then FFoundLine := 0;
            if FFoundLine >= FEstimatedTotalLines then
              FFoundLine := Integer(FEstimatedTotalLines - 1);
          end
          else if FUseSparseLineMap then
            FFoundLine := SparseOffsetToLineIndex(Idx, SourceStream, CandidateAbs + 1)
          else
            FFoundLine := OffsetToLineIndex(Idx, CandidateAbs + 1);
          FFound := True;
          Break;
        end;
        CurPos := CurPos - ReadSize;
        // overlap
        if (NeedLen > 1) and (CurPos > 0) then
          CurPos := CurPos + NeedLen - 1;
        if (FileSize > 0) and ((FLastFindProgressPos < 0) or
          ((FileSize - CurPos) - FLastFindProgressPos >= 2 * 1024 * 1024) or (CurPos <= 0)) then
        begin
          FProgBytes := FileSize - CurPos;
          if FProgBytes < 0 then FProgBytes := 0;
          if FProgBytes > FileSize then FProgBytes := FileSize;
          FProgTotal := FileSize;
          FLastFindProgressPos := FileSize - CurPos;
          if not Terminated then
            Synchronize(SyncFindBytesProgress);
        end;
      end;
    end;
      end;
    except
      on E: Exception do
        FErrorMsg := E.Message;
    end;
  finally
    if Assigned(Idx) then Idx.Free;
    if Assigned(SourceStream) then SourceStream.Free;
    if not Terminated then
      Synchronize(NotifyOwner);
  end;
end;

{ ============================================================================ }
{ TFilterStreamThread — filtro sem temp.txt (varredura por bytes)              }
{ ============================================================================ }

constructor TFilterStreamThread.Create(AOwner: TfrmMain; const AFileName: string;
  const ANeedle: string; ACaseSensitive: Boolean; AMatchMode: TFilterMatchMode;
  AMaxHits: Int64; AResumeBytePos: Int64; AResumeLineNum: Int64;
  AAppendMode: Boolean);
begin
  inherited Create(True);
  FreeOnTerminate := True;
  Priority := tpLower;
  FOwner := AOwner;
  FFileName := AFileName;
  FMatchMode := AMatchMode;
  FNeedleText := ANeedle;
  if Assigned(AOwner) then
    FEncoding := AOwner.EffectiveDisplayEncoding
  else
    FEncoding := '';
  FEncoding := ResolveTextEncoding(AFileName, FEncoding);
  FNeedle := UnicodeTextToFileBytes(ANeedle, FEncoding);
  FCaseSensitive := ACaseSensitive;
  SetLength(FHits, 0);
  FHitsDisk := nil;
  FHitsDiskTempPath := '';
  FFilteredCount := 0;
  SetLength(FJumpTable, 0);
  FAbortMsg := '';
  FHitLimitSoft := False;
  FAppendMode := AAppendMode;
  FResumeBytePos := AResumeBytePos;
  FResumeLineNum := AResumeLineNum;
  FSavedResumeByte := AResumeBytePos;
  FSavedResumeLine := AResumeLineNum;
  if AMaxHits > 0 then
    FMaxHits := AMaxHits
  else
    FMaxHits := FILTER_STREAM_PAGE_HITS;
  Resume;
end;

function TFilterStreamThread.LineMatches(const LineAnsi: AnsiString): Boolean;
begin
  Result := UnicodeLineMatches(LineAnsi, FNeedleText, FEncoding, FCaseSensitive,
    FMatchMode = fmmPrefix);
end;

procedure TFilterStreamThread.SyncFilterProgress;
begin
  if Assigned(FOwner) then
    FOwner.UpdateFilterStreamProgress(FProgBytes, FProgTotal);
end;

procedure TFilterStreamThread.SyncFilterFailed;
begin
  if Assigned(FOwner) then
    FOwner.FinishFilterThreadFailed(FAbortMsg);
end;

procedure TFilterStreamThread.SyncHitLimitNote;
begin
  if not Assigned(FOwner) then Exit;
  FOwner.FFilterStreamPartial := True;
  FOwner.FFilterStreamResumeByte := FSavedResumeByte;
  FOwner.FFilterStreamResumeLine := FSavedResumeLine;
  if FOwner.FFindOccDroveFilter or FOwner.FFindOccKeepHits then
  begin
    FOwner.UpdateStatusBar(
      Format(TrText('FindOcc.Status.Partial'),
        [FOwner.FFilteredCount, FOwner.FFindText]),
      iaRight);
    FOwner.RefreshFindOccBarState;
  end
  else
    FOwner.UpdateStatusBar(
      Format(TrText('Filter: %d hits (partial) - Continue for more'),
        [FOwner.FFilteredCount]),
      iaRight);
end;

procedure TFilterStreamThread.NotifyOwner;
var
  HitCnt: Int64;
begin
  if Assigned(FHitsDisk) then
  begin
    if FAppendMode then
    begin
      FHitsDisk.Free;
      FHitsDisk := nil;
    end
    else
    begin
      FHitsDisk.Free;
      FHitsDisk := nil;
      ZeroScanFinalizeFilterHitsTemp(FHitsDiskTempPath);
      FHitsDiskTempPath := '';
    end;
    FOwner.FFilterUseHitsFile := True;
    FOwner.FFilterUseHitsList := False;
    SetLength(FOwner.FFilterHitsList, 0);
    if Assigned(FOwner.FFilterHitsFileStream) then
      FOwner.FFilterHitsFileStream.Free;
    FOwner.FFilterHitsFileStream := ZeroScanOpenFilterHitsReader(HitCnt);
    FFilteredCount := HitCnt;
  end
  else
  begin
    FOwner.FFilterUseHitsFile := False;
    FOwner.FFilterUseHitsList := True;
    FOwner.FFilterHitsList := FHits;
    if Assigned(FOwner.FFilterHitsFileStream) then
    begin
      FOwner.FFilterHitsFileStream.Free;
      FOwner.FFilterHitsFileStream := nil;
    end;
  end;
  FOwner.FFilterBits := nil;
  FOwner.FFilterBitsSize := 0;
  FOwner.FFilteredCount := FFilteredCount;
  FOwner.FFilterTotalLines := totalLines;
  FOwner.FFilterJumpTable := FJumpTable;
  if FHitLimitSoft then
  begin
    FOwner.FFilterStreamPartial := True;
    FOwner.FFilterStreamResumeByte := FSavedResumeByte;
    FOwner.FFilterStreamResumeLine := FSavedResumeLine;
  end
  else
    FOwner.FFilterStreamPartial := False;
  FOwner.FilterThreadDone;
end;

procedure TFilterStreamThread.Execute;
var
  Src: TFileStream;
  FileSize, CurPos, LineNum, LineStartPos, StartCount: Int64;
  ReadN, P, Q: Integer;
  Buf: array of Byte;
  Chunk, Pending, LineAnsi: AnsiString;
  LastTick: DWORD;
  PendLen: Integer;
  TermCh: AnsiChar;

  function TryAddHit(const ALineNum: Int64): Boolean;
  var
    HitI64: Int64;
  begin
    { False = page full; caller must NOT advance past this line. }
    Result := False;
    if FFilteredCount >= FMaxHits then
    begin
      FHitLimitSoft := True;
      Exit;
    end;
    if Assigned(FHitsDisk) then
    begin
      HitI64 := ALineNum;
      FHitsDisk.WriteBuffer(HitI64, SizeOf(Int64));
    end
    else
    begin
      SetLength(FHits, Length(FHits) + 1);
      FHits[High(FHits)] := ALineNum;
    end;
    Inc(FFilteredCount);
    Result := True;
  end;

begin
  FHitsDisk := nil;
  FHitsDiskTempPath := '';
  StartCount := 0;
  if FAppendMode then
  begin
    FHitsDisk := ZeroScanOpenFilterHitsAppender(StartCount);
    if not Assigned(FHitsDisk) then
    begin
      FAbortMsg := TrText('Filter hit file missing; restart the filter.');
      Synchronize(SyncFilterFailed);
      Exit;
    end;
    FFilteredCount := StartCount;
  end
  else
  begin
    ZeroScanDeleteFilterHits;
    FHitsDisk := ZeroScanCreateFilterHitsWriter(FHitsDiskTempPath);
    FFilteredCount := 0;
  end;
  if FMatchMode = fmmRegex then
  begin
    FAbortMsg := TrText('Regex filter requires a line index. Choose YES to index first, or use plain text.');
    Synchronize(SyncFilterFailed);
    Exit;
  end;
  Src := nil;
  try
    Src := TFileStream.Create(FFileName, fmOpenRead or fmShareDenyNone);
    FileSize := Src.Size;
    TermCh := LineTermCharForFile(FFileName);
    FProgTotal := FileSize;
    FProgBytes := 0;
    if FResumeBytePos > 0 then
      CurPos := FResumeBytePos
    else
      CurPos := 0;
    if FResumeLineNum > 0 then
      LineNum := FResumeLineNum
    else
      LineNum := 0;
    Pending := '';
    SetLength(Buf, FILTER_STREAM_BUF_SIZE);
    LastTick := GetTickCount;
    while (CurPos < FileSize) and (not Terminated) and (FAbortMsg = '') and
          (not FHitLimitSoft) do
    begin
      ReadN := FILTER_STREAM_BUF_SIZE;
      if CurPos + ReadN > FileSize then ReadN := Integer(FileSize - CurPos);
      if ReadN <= 0 then Break;
      Src.Seek(CurPos, Word(soFromBeginning));
      ReadN := Src.Read(Buf[0], ReadN);
      if ReadN <= 0 then Break;
      SetString(Chunk, PAnsiChar(@Buf[0]), ReadN);
      P := 1;
      while (P <= Length(Chunk)) and (not FHitLimitSoft) do
      begin
        Q := P;
        while (Q <= Length(Chunk)) and (Chunk[Q] <> TermCh) do Inc(Q);
        if Q > Length(Chunk) then
        begin
          Pending := Pending + Copy(Chunk, P, MaxInt);
          Break;
        end;
        PendLen := Length(Pending);
        LineStartPos := CurPos + (P - 1) - PendLen;
        if LineStartPos < 0 then
          LineStartPos := 0;
        LineAnsi := Pending + Copy(Chunk, P, Q - P);
        Pending := '';
        if LineMatches(LineAnsi) then
        begin
          if not TryAddHit(LineNum) then
          begin
            FSavedResumeByte := LineStartPos;
            FSavedResumeLine := LineNum;
            Break;
          end;
        end;
        if FAbortMsg <> '' then Break;
        Inc(LineNum);
        P := Q + 1;
      end;
      Inc(CurPos, ReadN);
      if GetTickCount - LastTick > 400 then
      begin
        FProgBytes := CurPos;
        Synchronize(SyncFilterProgress);
        LastTick := GetTickCount;
      end;
    end;
    if (FAbortMsg = '') and (not Terminated) and (not FHitLimitSoft) and (Pending <> '') then
    begin
      LineStartPos := CurPos - Length(Pending);
      if LineStartPos < 0 then
        LineStartPos := 0;
      if LineMatches(Pending) then
      begin
        if not TryAddHit(LineNum) then
        begin
          FSavedResumeByte := LineStartPos;
          FSavedResumeLine := LineNum;
        end
        else
          Inc(LineNum);
      end
      else
        Inc(LineNum);
    end;
    if (FAbortMsg = '') and (not Terminated) then
    begin
      Synchronize(NotifyOwner);
      if FHitLimitSoft then
        Synchronize(SyncHitLimitNote);
    end;
  except
    on E: Exception do
    begin
      FAbortMsg := E.Message;
      Synchronize(SyncFilterFailed);
    end;
  end;
  if Assigned(FHitsDisk) then
  begin
    FHitsDisk.Free;
    FHitsDisk := nil;
    if (not FAppendMode) and (FHitsDiskTempPath <> '') then
      SysUtils.DeleteFile(FHitsDiskTempPath);
  end;
  if Assigned(Src) then Src.Free;
end;


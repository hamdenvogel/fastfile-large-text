procedure TfrmMain.ScrollBarVerticalChange(Sender: TObject);
var
  MaxOffset, OldOffset, ScrollExtent: Int64;
begin
  if FSuppressScrollBarChange or (FListViewZoomBatchDepth > 0) then Exit;
  if FFilterActive and (not isChecked) then Exit;
  SyncVerticalScrollBarRange;
  if FFilterActive and isChecked then
  begin
    ScrollExtent := FFilteredCount;
    if ScrollExtent < 1 then ScrollExtent := 1;
  end
  else
  begin
    ScrollExtent := ListViewScrollExtent;
    if ScrollExtent < 1 then ScrollExtent := 1;
  end;
  MaxOffset := VerticalScrollMaxOffset(ScrollExtent);
  OldOffset := Offset;
  Offset := VerticalOffsetFromBarPos(ScrollBarVertical.Position, MaxOffset);
  if Offset <> OldOffset then
    InvalidateLineCache;
  if FFastVisualWordWrap and (not isChecked) and Assigned(ListView1) and ListView1.Visible then
    RecalcDynWrapRowHeight;
  if Assigned(ListView1) and ListView1.Visible and (not isChecked) then
  begin
    ListView1.Items.Count := VisibleItems;
    ListView1.Invalidate;
    ListView1.Update;
  end;
  if isChecked then
  begin
    if FVerticalScrollBatchDepth = 0 then
      QueueCheckListScrollRefresh;
  end
  else
    showChecked;
end;

function TfrmMain.VerticalScrollMaxOffset(const AScrollExtent: Int64): Int64;
begin
  Result := AScrollExtent - VisibleItems;
  if Result < 0 then Result := 0;
end;

function TfrmMain.VerticalBarPosFromOffset(const AOffset, AMaxOffset: Int64): Integer;
var
  SBMax: Integer;
begin
  SBMax := ScrollBarVertical.Max;
  if (SBMax <= 0) or (AMaxOffset <= 0) then
    Result := 0
  else if AOffset <= 0 then
    Result := 0
  else if SBMax >= AMaxOffset then
  begin
    if AOffset >= AMaxOffset then
      Result := SBMax
    else
      Result := Integer(AOffset);
  end
  else if AOffset >= AMaxOffset then
    Result := SBMax
  else
    Result := Integer((Int64(AOffset) * SBMax) div AMaxOffset);
end;

function TfrmMain.VerticalOffsetFromBarPos(const ABarPos: Integer; const AMaxOffset: Int64): Int64;
var
  SBMax: Integer;
begin
  SBMax := ScrollBarVertical.Max;
  if (SBMax <= 0) or (AMaxOffset <= 0) then
    Result := 0
  else if ABarPos <= 0 then
    Result := 0
  else if SBMax >= AMaxOffset then
  begin
    if ABarPos >= SBMax then
      Result := AMaxOffset
    else
      Result := ABarPos;
  end
  else if ABarPos >= SBMax then
    Result := AMaxOffset
  else
    Result := (Int64(ABarPos) * AMaxOffset) div SBMax;
end;

procedure TfrmMain.SyncVerticalScrollBarRange;
begin
  if FListViewZoomBatchDepth > 0 then
  begin
    FListViewZoomDeferScrollSync := True;
    Exit;
  end;
  DoSyncVerticalScrollBarRange;
end;

function TfrmMain.ReadViewportParent: TWinControl;
begin
  if Assigned(FReadViewHost) then
    Result := FReadViewHost
  else if Assigned(pnlCenter) then
    Result := pnlCenter
  else
    Result := pnlMain;
end;

procedure TfrmMain.BeginListViewZoomVisualBatch;
var
  P: TWinControl;
begin
  if FListViewZoomBatchDepth = 0 then
  begin
    P := ReadViewportParent;
    if Assigned(P) then
      P.DisableAlign;
    if Assigned(P) and P.HandleAllocated then
      LockWindowUpdate(P.Handle);
  end;
  Inc(FListViewZoomBatchDepth);
end;

procedure TfrmMain.EndListViewZoomVisualBatch;
var
  P: TWinControl;
begin
  if FListViewZoomBatchDepth <= 0 then Exit;
  Dec(FListViewZoomBatchDepth);
  if FListViewZoomBatchDepth > 0 then Exit;

  FListViewZoomDeferScrollSync := False;
  FSuppressScrollBarChange := True;
  try
    DoSyncVerticalScrollBarRange;
  finally
    FSuppressScrollBarChange := False;
  end;

  P := ReadViewportParent;
  if Assigned(P) and P.HandleAllocated then
    LockWindowUpdate(0);
  if Assigned(P) then
    P.EnableAlign;
  if Assigned(ListView1) then
    ListView1.Invalidate;
  if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
end;

procedure TfrmMain.SafeSetScrollBarPageSize(SB: TScrollBar; APage: Integer);
begin
  if not Assigned(SB) then Exit;
  if APage < 0 then APage := 0;
  { SetPageSize silently ignores Value > Max; clamp so callers get a consistent state. }
  if APage > SB.Max then
    APage := SB.Max;
  if SB.PageSize <> APage then
    SB.PageSize := APage;
end;

procedure TfrmMain.SafeSetScrollBarMax(SB: TScrollBar; AMax: Integer);
begin
  if not Assigned(SB) then Exit;
  if AMax < SB.Min then
    AMax := SB.Min;
  { Must shrink PageSize before Max, or SetParams raises SScrollBarRange. }
  if SB.PageSize > AMax then
    SB.PageSize := AMax;
  if SB.Max <> AMax then
    SB.Max := AMax;
  if SB.Position > SB.Max then
    SB.Position := SB.Max;
end;

procedure TfrmMain.SafeSetScrollBarPosition(SB: TScrollBar; APos: Integer);
begin
  if not Assigned(SB) then Exit;
  if SB.PageSize > SB.Max then
    SB.PageSize := SB.Max;
  if APos < SB.Min then APos := SB.Min;
  if APos > SB.Max then APos := SB.Max;
  if SB.Position <> APos then
    SB.Position := APos;
end;

procedure TfrmMain.DoSyncVerticalScrollBarRange;
var
  ScrollExtent, MaxOff: Int64;
  NewMax: Integer;
begin
  if not Assigned(ScrollBarVertical) then Exit;
  if FFilterActive and isChecked then
  begin
    ScrollExtent := FFilteredCount;
    if ScrollExtent < 1 then ScrollExtent := 1;
  end
  else
  begin
    ScrollExtent := ListViewScrollExtent;
    if ScrollExtent < 1 then ScrollExtent := 1;
  end;
  MaxOff := VerticalScrollMaxOffset(ScrollExtent);
  if MaxOff < 1 then
    NewMax := 1
  else if MaxOff > MaxInt - 1 then
    NewMax := MaxInt - 1
  else
    NewMax := Integer(MaxOff);
  SafeSetScrollBarMax(ScrollBarVertical, NewMax);
  UpdateExternalScrollBarsForWordWrap;
end;

procedure TfrmMain.ScrollBarVerticalScroll(Sender: TObject;
  ScrollCode: TScrollCode; var ScrollPos: Integer);
var
  MaxOffset, OldOffset: Int64;
  ScrollExtent: Int64;
begin
  if FSuppressScrollBarChange or (FListViewZoomBatchDepth > 0) then Exit;
  { Filtro + ListView: barra vertical externa nao move a lista (desativada em SyncScrollBarsForFilterMode). }
  if FFilterActive and (not isChecked) then
  begin
    SyncSelectModeListViewHeader;
    showChecked;
    Exit;
  end;
  SyncSelectModeListViewHeader;
  SyncVerticalScrollBarRange;
  { Filtro + Select (checklist): Offset e indice na lista filtrada; mesmo esquema de MaxOffset que o ficheiro completo. }
  if FFilterActive and isChecked then
  begin
    ScrollExtent := FFilteredCount;
    if ScrollExtent < 1 then ScrollExtent := 1;
    MaxOffset := VerticalScrollMaxOffset(ScrollExtent);
    if Offset > MaxOffset then Offset := MaxOffset;
  end
  else
  begin
    ScrollExtent := ListViewScrollExtent;
    MaxOffset := VerticalScrollMaxOffset(ScrollExtent);
  end;
  OldOffset := Offset;
  case ScrollCode of
    scLineUp: begin
      if Offset > 0 then
        Offset := Offset - 1;
    end;
    scLineDown: begin
      if Offset < MaxOffset then
        Offset := Offset + 1;
    end;
    scPageUp: begin
      if Offset > VisibleItems then
        Offset := Offset - VisibleItems
      else
        Offset := 0;
    end;
    scPageDown: begin
      if (MaxOffset - Offset) > VisibleItems then
        Offset := Offset + VisibleItems
      else
        Offset := MaxOffset;
    end;
    scPosition, scTrack: begin
      Offset := VerticalOffsetFromBarPos(ScrollPos, MaxOffset);
    end;
    scTop: begin
      Offset := 0;
    end;
    scBottom: begin
      Offset := MaxOffset;
    end;
    scEndScroll: begin
    end;
  end;
  if Offset <> OldOffset then InvalidateLineCache;
  if ScrollExtent < 1 then ScrollExtent := 1;
  ScrollPos := VerticalBarPosFromOffset(Offset, MaxOffset);
  if FFastVisualWordWrap and (not isChecked) and Assigned(ListView1) and ListView1.Visible then
    RecalcDynWrapRowHeight;
  if Assigned(ListView1) and ListView1.Visible and (not isChecked) then
  begin
    ListView1.Items.Count := VisibleItems;
    ListView1.Invalidate;
    ListView1.Update;
  end;
  if isChecked then
  begin
    if FVerticalScrollBatchDepth = 0 then
      QueueCheckListScrollRefresh;
  end
  else
    showChecked;
end;

procedure TfrmMain.ScrollBarHorizontalChange(Sender: TObject);
begin
  if FSuppressScrollBarChange or (FListViewZoomBatchDepth > 0) then Exit;
  if FFastVisualWordWrap and (not FCsvMode) then
  begin
    ScrollBarHorizontal.Position := 0;
    Exit;
  end;
  if Assigned(ListView1) and ListView1.Visible and (not isChecked) then
    ListView1.Refresh
  else if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
end;

procedure TfrmMain.ScrollBarHorizontalScroll(Sender: TObject;
  ScrollCode: TScrollCode; var ScrollPos: Integer);
begin
  if FSuppressScrollBarChange or (FListViewZoomBatchDepth > 0) then Exit;
  if FFastVisualWordWrap then
  begin
    ScrollPos := 0;
    ScrollBarHorizontal.Position := 0;
    Exit;
  end;
  if Assigned(ListView1) and ListView1.Visible and (not isChecked) then
    ListView1.Refresh
  else if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
end;

function TfrmMain.ReadViewportClientHeight: Integer;
var
  CH: Integer;
begin
  Result := 400;
  if isChecked and Assigned(FCheckListBox) then
  begin
    FCheckListBox.HandleNeeded;
    CH := FCheckListBox.ClientHeight;
    if CH < 20 then
      CH := FCheckListBox.Height;
    if CH >= 20 then
    begin
      Result := CH;
      Exit;
    end;
  end;
  if Assigned(ListView1) then
  begin
    if ListView1.HandleAllocated and ListView1.Visible then
      CH := ListView1.ClientHeight
    else
      CH := ListView1.Height;
    if CH >= 20 then
    begin
      Result := CH;
      Exit;
    end;
  end;
  if Assigned(FCheckListBox) and FCheckListBox.HandleAllocated then
  begin
    CH := FCheckListBox.ClientHeight;
    if CH >= 20 then
    begin
      Result := CH;
      Exit;
    end;
  end;
  if Assigned(pnlCenter) and (pnlCenter.ClientHeight >= 20) then
    Result := pnlCenter.ClientHeight
  else if Assigned(pnlMain) and (pnlMain.ClientHeight >= 20) then
    Result := pnlMain.ClientHeight;
end;

procedure TfrmMain.QueueCheckListScrollRefresh;
begin
  if not isChecked or not Assigned(FCheckListBox) then Exit;
  if FListViewZoomBatchDepth > 0 then Exit;
  if FCheckListScrollRefreshQueued then Exit;
  FCheckListScrollRefreshQueued := True;
  PostMessage(Handle, WM_USER + 206, 0, 0);
end;

procedure TfrmMain.ListView1Resize(Sender: TObject);
var
  VI, CH, RH: Integer;
  OldVisibleItems: Int64;
  Col0W, NewW: Integer;
begin
  if not Assigned(ListView1) then Exit;
  if (FListViewZoomBatchDepth > 0) and isChecked then Exit;

  { Durante drag do divisor do header: nao auto-ajustar col0 nem invalidar cache
    (isso luta com o redimensionamento do utilizador e provoca flicker). }
  if IsListViewHeaderTracking then
  begin
    if (not FCsvMode) and (not FReadContentColumnExpanded) and
       (ListView1.Columns.Count >= 2) then
    begin
      Col0W := ListView1.Columns[0].Width;
      NewW := ListView1.ClientWidth - Col0W - COL_EDGE_MARGIN;
      if NewW < 1 then NewW := 1;
      if ListView1.Columns[1].Width <> NewW then
        ListView1.Columns[1].Width := NewW;
    end;
    Exit;
  end;

  AdjustListViewColumnsWidth;
  OldVisibleItems := VisibleItems;
  { Com ListView invisivel (modo Select) VisibleRowCount = 0: estimar pela altura do
    control / painel e altura de linha (wrap ou normal) para manter VisibleItems e Items.Count coerentes. }
  if ListView1.Visible and (not isChecked) then
  begin
    VI := ListView1.VisibleRowCount;
    if VI <= 0 then VI := 1;
  end
  else
  begin
    CH := ReadViewportClientHeight;
    if CH < 20 then
      CH := 400;
    if FFastVisualWordWrap then
    begin
      if Assigned(FWordWrapRowImages) and (FWordWrapRowImages.Height > 0) then
        RH := FWordWrapRowImages.Height
      else
      begin
        CalculateFontMetrics;
        RH := Max(48, (Abs(FLineHeight) + 2) * MinWrapRows);
      end;
    end
    else
    begin
      CalculateFontMetrics;
      RH := Max(16, Abs(FLineHeight) + 2);
    end;
    if RH <= 0 then
      RH := 18;
    VI := CH div RH;
    if VI < 1 then
      VI := 1;
  end;
  VisibleItems := VI;
  if isChecked then
  begin
    if ListView1.Items.Count <> 0 then
      ListView1.Items.Count := 0;
  end
  else if FFilterActive then
  begin
    if FFilteredCount < 1 then
      ListView1.Items.Count := 0
    else if FFilteredCount > MaxInt then
      ListView1.Items.Count := MaxInt
    else
      ListView1.Items.Count := Integer(FFilteredCount);
  end
  else
    ListView1.Items.Count := VisibleItems;
  SyncVerticalScrollBarRange;
  InvalidateLineCache;
  { CheckListBox alClient: ao redimensionar, remede alturas com word wrap (largura muda). }
  if isChecked and Assigned(FCheckListBox) and (FListViewZoomBatchDepth = 0) then
  begin
    if (VisibleItems <> OldVisibleItems) or (FCheckListBox.Items.Count <> VisibleItems) then
    begin
      FCheckListDisplayOffset := -1;
      RefreshCheckListViewport(True);
    end
    else
      FCheckListBox.Invalidate;
  end;
end;

procedure TfrmMain.ListView1ColumnClick(Sender: TObject; Column: TListColumn);
begin
  if not Assigned(ListView1) then Exit;
  if not Assigned(Column) then Exit;
  if FCsvMode then Exit;
  if Column.Index <> 1 then Exit;
  if ListView1.Columns.Count < 2 then Exit;

  ListView1.Items.BeginUpdate;
  try
    if ListView1.HandleAllocated then
      SendMessage(ListView1.Handle, WM_SETREDRAW, 0, 0);
    try
      if not FReadContentColumnExpanded then
      begin
        FReadCol0SavedWidth := ListView1.Columns[0].Width;
        if FReadCol0SavedWidth <= 0 then
          FReadCol0SavedWidth := 200;
        FReadContentColumnExpanded := True;
      end
      else
      begin
        FReadContentColumnExpanded := False;
        ListView1.Columns[0].Width := Max(80, FReadCol0SavedWidth);
      end;

      AdjustListViewColumnsWidth;
    finally
      if ListView1.HandleAllocated then
      begin
        SendMessage(ListView1.Handle, WM_SETREDRAW, 1, 0);
        RedrawWindow(ListView1.Handle, nil, 0,
          RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW);
      end;
    end;
  finally
    ListView1.Items.EndUpdate;
  end;
  if isChecked and Assigned(FCheckListBox) and FFastVisualWordWrap then
    FCheckListBox.Invalidate;
end;

function TfrmMain.IsListViewHeaderTracking: Boolean;
var
  Hdr: HWND;
begin
  Result := False;
  if not Assigned(ListView1) or (not ListView1.HandleAllocated) then Exit;
  Hdr := ListView_GetHeader(ListView1.Handle);
  if Hdr = 0 then Exit;
  Result := GetCapture = Hdr;
end;


  FIdleLogoBgFloat.AllowMouseTransparency := True;
  Btn := TacFloatBtn(FIdleLogoBgFloat.Items.Add);
  Btn.Style := fbsTransparent;
  Btn.AllowClick := False;
  Btn.ShowCaption := False;
  Btn.AutoSize := False;
  Btn.AlignHorz := taLeftJustify;
  Btn.AlignVert := vaAlignTop;
  Btn.BlendValue := 255;
  Btn.OnPaint := IdleLogoBgFloatPaint;
  Btn.Visible := False;
  SyncIdleLogoBgFloatBounds;
end;

procedure IdleLogoCopyBmp32(DstBmp, SrcBmp: TBitmap);
var
  Y: Integer;
  SP, DP: PRGBQuad;
  X, W: Integer;
begin
  if not Assigned(DstBmp) or not Assigned(SrcBmp) then Exit;
  if (SrcBmp.Width < 1) or (SrcBmp.Height < 1) then Exit;
  DstBmp.PixelFormat := pf32bit;
  SrcBmp.PixelFormat := pf32bit;
  if (DstBmp.Width <> SrcBmp.Width) or (DstBmp.Height <> SrcBmp.Height) then
  begin
    DstBmp.Width := SrcBmp.Width;
    DstBmp.Height := SrcBmp.Height;
  end;
  W := SrcBmp.Width;
  for Y := 0 to SrcBmp.Height - 1 do
  begin
    SP := SrcBmp.ScanLine[Y];
    DP := DstBmp.ScanLine[Y];
    for X := 0 to W - 1 do
    begin
      DP^ := SP^;
      Inc(SP);
      Inc(DP);
    end;
  end;
end;

procedure TfrmMain.InvalidateIdleLogoPaintCache;
begin
  FIdleLogoPaintCacheW := 0;
  FIdleLogoPaintCacheH := 0;
end;

procedure TfrmMain.RefreshIdleLogoPaintCache;
var
  R: TRect;
  AreaW, AreaH: Integer;
begin
  if not IdleLogoBitmapReady then Exit;
  R := GetIdleLogoWorkspaceRect;
  AreaW := R.Right - R.Left;
  AreaH := R.Bottom - R.Top;
  if (AreaW < 1) or (AreaH < 1) then Exit;
  if not Assigned(FIdleLogoPaintCache) then
    FIdleLogoPaintCache := TBitmap.Create;
  FIdleLogoPaintCache.PixelFormat := pf32bit;
  FIdleLogoPaintCache.Width := AreaW;
  FIdleLogoPaintCache.Height := AreaH;
  IdleLogoFillBmpHorizontalGradient(FIdleLogoPaintCache,
    IDLE_WORKSPACE_GRAD_LEFT, IDLE_WORKSPACE_GRAD_RIGHT, IDLE_WORKSPACE_BG_ALPHA);
  PaintIdleLogoContent(FIdleLogoPaintCache);
  FIdleLogoPaintCacheW := AreaW;
  FIdleLogoPaintCacheH := AreaH;
end;

procedure TfrmMain.IdleLogoBgFloatPaint(Sender: TObject; PaintData: TacCustomPaintData);
begin
  if not Assigned(PaintData.DestBmp) then Exit;
  if Assigned(FIdleLogoPaintCache) and (FIdleLogoPaintCacheW > 0) and
    (FIdleLogoPaintCacheH > 0) and
    (PaintData.DestBmp.Width = FIdleLogoPaintCacheW) and
    (PaintData.DestBmp.Height = FIdleLogoPaintCacheH) then
  begin
    IdleLogoCopyBmp32(PaintData.DestBmp, FIdleLogoPaintCache);
    Exit;
  end;
  IdleLogoFillBmpHorizontalGradient(PaintData.DestBmp,
    IDLE_WORKSPACE_GRAD_LEFT, IDLE_WORKSPACE_GRAD_RIGHT, IDLE_WORKSPACE_BG_ALPHA);
  PaintIdleLogoContent(PaintData.DestBmp);
end;

procedure TfrmMain.SyncIdleLogoBgFloatBounds;
var
  R: TRect;
  AreaW, AreaH: Integer;
  Btn: TacFloatBtn;
  Pt: TPoint;
  FormR: TRect;
begin
  if not Assigned(FIdleLogoBgFloat) or (FIdleLogoBgFloat.Items.Count < 1) then Exit;
  Btn := FIdleLogoBgFloat.Items[0];
  R := GetIdleLogoWorkspaceRect;
  AreaW := R.Right - R.Left;
  AreaH := R.Bottom - R.Top;
  if (AreaW < 1) or (AreaH < 1) then Exit;
  Btn.AutoSize := False;
  Btn.Width := AreaW;
  Btn.Height := AreaH;
  Btn.AlignHorz := taLeftJustify;
  Btn.AlignVert := vaAlignTop;
  Pt := ClientToScreen(Point(R.Left, R.Top));
  GetWindowRect(Handle, FormR);
  Btn.OffsetX := Pt.X - FormR.Left;
  Btn.OffsetY := Pt.Y - FormR.Top;
end;

procedure IdleLogoFadeBmpRegion(const Bmp: TBitmap; const R: TRect; AlphaMul: Byte);
var
  X, Y, X1, Y1, X2, Y2: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (AlphaMul >= 255) then Exit;
  if AlphaMul = 0 then Exit;
  X1 := R.Left;
  Y1 := R.Top;
  X2 := R.Right;
  Y2 := R.Bottom;
  if X1 < 0 then X1 := 0;
  if Y1 < 0 then Y1 := 0;
  if X2 >= Bmp.Width then X2 := Bmp.Width - 1;
  if Y2 >= Bmp.Height then Y2 := Bmp.Height - 1;
  for Y := Y1 to Y2 do
  begin
    P := Bmp.ScanLine[Y];
    Inc(P, X1);
    for X := X1 to X2 do
    begin
      if P^.rgbReserved > 0 then
        P^.rgbReserved := Byte((P^.rgbReserved * AlphaMul) div 255);
      Inc(P);
    end;
  end;
end;

procedure IdleLogoSoftenAlphaChannel(const Bmp: TBitmap);
var
  X, Y, DX, DY, X1, Y1, X2, Y2, Sum, Cnt: Integer;
  P, Q: PRGBQuad;
  Alphas: array of Byte;
  W, H: Integer;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  Bmp.PixelFormat := pf32bit;
  W := Bmp.Width;
  H := Bmp.Height;
  SetLength(Alphas, W * H);
  for Y := 0 to H - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to W - 1 do
    begin
      Sum := 0;
      Cnt := 0;
      Y1 := Y - RADIUS;
      if Y1 < 0 then Y1 := 0;
      Y2 := Y + RADIUS;
      if Y2 >= H then Y2 := H - 1;
      X1 := X - RADIUS;
      if X1 < 0 then X1 := 0;
      X2 := X + RADIUS;
      if X2 >= W then X2 := W - 1;
      for DY := Y1 to Y2 do
      begin
        Q := Bmp.ScanLine[DY];
        Inc(Q, X1);
        for DX := X1 to X2 do
        begin
          Inc(Sum, Q^.rgbReserved);
          Inc(Cnt);
          Inc(Q);
        end;
      end;
      if Cnt > 0 then
        Alphas[Y * W + X] := Byte(Sum div Cnt)
      else
        Alphas[Y * W + X] := P^.rgbReserved;
      Inc(P);
    end;
  end;
  for Y := 0 to H - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to W - 1 do
    begin
      P^.rgbReserved := Alphas[Y * W + X];
      Inc(P);
    end;
  end;
end;

{ Alpha-over sem reamostragem (StretchBmpRect32 aplica Mitchell mesmo 1:1). }
procedure IdleLogoBlendBmpOnto(DstBmp: TBitmap; XDst, YDst: Integer;
  const SrcBmp: TBitmap; SrcBlend: Byte);
var
  X, Y, Xd, Yd, SA, b, DR, DG, DB, DA: Integer;
  SP, DP: PRGBQuad;
begin
  if not Assigned(DstBmp) or not Assigned(SrcBmp) then Exit;
  if (SrcBmp.Width < 1) or (SrcBmp.Height < 1) then Exit;
  DstBmp.PixelFormat := pf32bit;
  SrcBmp.PixelFormat := pf32bit;
  for Y := 0 to SrcBmp.Height - 1 do
  begin
    Yd := YDst + Y;
    if (Yd < 0) or (Yd >= DstBmp.Height) then Continue;
    SP := SrcBmp.ScanLine[Y];
    DP := DstBmp.ScanLine[Yd];
    Inc(DP, XDst);
    for X := 0 to SrcBmp.Width - 1 do
    begin
      Xd := XDst + X;
      if (Xd >= 0) and (Xd < DstBmp.Width) then
      begin
        SA := SP^.rgbReserved;
        if SA > 0 then
        begin
          if SrcBlend <> 255 then
            b := (SA * SrcBlend) div 255
          else
            b := SA;
          if b > 0 then
          begin
            DR := DP^.rgbRed;
            DG := DP^.rgbGreen;
            DB := DP^.rgbBlue;
            DA := DP^.rgbReserved;
            DP^.rgbRed := Byte(((SP^.rgbRed - DR) * b + DR * 256) shr 8);
            DP^.rgbGreen := Byte(((SP^.rgbGreen - DG) * b + DG * 256) shr 8);
            DP^.rgbBlue := Byte(((SP^.rgbBlue - DB) * b + DB * 256) shr 8);
            if DA > b then
              DP^.rgbReserved := Byte(DA)
            else
              DP^.rgbReserved := Byte(((b - DA) * b + DA * 256) shr 8);
          end;
        end;
      end;
      Inc(SP);
      Inc(DP);
    end;
  end;
end;

procedure IdleLogoStretchSmooth(DstBmp: TBitmap; XDst, YDst, DstW, DstH: Integer;
  const SrcBmp: TBitmap; SrcBlend: Byte);
var
  Scaled, HiRes: TBitmap;
  HiW, HiH: Integer;
  NeedsUpscale: Boolean;
begin
  if not Assigned(DstBmp) or not Assigned(SrcBmp) then Exit;
  if (DstW < 1) or (DstH < 1) then Exit;
  Scaled := CreateBmp32(DstW, DstH);
  try
    Scaled.PixelFormat := pf32bit;
    NeedsUpscale := (DstW > SrcBmp.Width) or (DstH > SrcBmp.Height);
    if not NeedsUpscale then
      Stretch(SrcBmp, Scaled, DstW, DstH, ftLanczos3)
    else
    begin
      HiW := DstW * IDLE_LOGO_STRETCH_SUPERSAMPLE;
      HiH := DstH * IDLE_LOGO_STRETCH_SUPERSAMPLE;
      if (HiW > 3200) or (HiH > 3200) then
        Stretch(SrcBmp, Scaled, DstW, DstH, ftLanczos3)
      else
      begin
        HiRes := CreateBmp32(HiW, HiH);
        try
          HiRes.PixelFormat := pf32bit;
          Stretch(SrcBmp, HiRes, HiW, HiH, ftLanczos3);
          Stretch(HiRes, Scaled, DstW, DstH, ftLanczos3);
        finally
          HiRes.Free;
        end;
      end;
    end;
    IdleLogoBlendBmpOnto(DstBmp, XDst, YDst, Scaled, SrcBlend);
  finally
    Scaled.Free;
  end;
end;

procedure TfrmMain.PaintIdleLogoContent(Bmp: TBitmap);
var
  BlockW, BlockH, LogoW, LogoH, LogoX, LogoY: Integer;
  WmW, WmH, WmX, WmY: Integer;
  TitleFontH, FullFontH, SubFontH: Integer;
  TitleH, FullH, SubH, SubTextH, TextH, Gap1, Gap2, TextTop: Integer;
  TitleName, SubName: string;
  TR, SubR: TRect;
  Flags: Cardinal;
  LogoScale, WmScale: Double;

  function PickUIFont(const APreferred, AFallback: string): string;
  var
    F: TFont;
  begin
    Result := AFallback;
    F := TFont.Create;
    try
      F.Name := APreferred;
      if SameText(F.Name, APreferred) then
        Result := APreferred;
    finally
      F.Free;
    end;
  end;

begin
  if not Assigned(Bmp) or not IdleLogoBitmapReady then Exit;
  BlockW := Bmp.Width;
  BlockH := Bmp.Height;
  if (BlockW < 1) or (BlockH < 1) then Exit;

  TitleName := IdleLogoPickTitleFontName;
  SubName := PickUIFont('Segoe UI', 'Tahoma');
  TitleFontH := Max(IDLE_LOGO_TITLE_FONT_MIN,
    Min(IDLE_LOGO_TITLE_FONT_MAX, BlockW div IDLE_LOGO_TITLE_FONT_DIV));
  FullFontH := Max(11, Min(20, BlockW div 32));
  SubFontH := Max(9, Min(15, BlockW div 40));
  Gap1 := Max(3, TitleFontH div 9);
  Gap2 := Max(6, FullFontH div 2);
  TitleH := TitleFontH + 6;
  FullH := FullFontH + 4;

  SubR := Rect(0, 0, BlockW, 2000);
  Bmp.Canvas.Font.Name := SubName;
  Bmp.Canvas.Font.Height := -SubFontH;
  Bmp.Canvas.Font.Style := [fsItalic];
  DrawText(Bmp.Canvas.Handle, PChar(APPLICATION_DEVELOPER), -1, SubR,
    DT_CENTER or DT_WORDBREAK or DT_CALCRECT);
  SubTextH := SubR.Bottom - SubR.Top;
  if SubTextH < SubFontH then SubTextH := SubFontH;
  SubH := SubTextH + 4;

  TextH := TitleH + Gap1 + FullH + Gap2 + SubH;
  LogoScale := Min(BlockW * IDLE_LOGO_SIZE_FRAC / FIdleLogoBitmap.Width,
    BlockH * IDLE_LOGO_SIZE_FRAC / FIdleLogoBitmap.Height);
  if LogoScale < 0.01 then
    LogoScale := 0.01;
  LogoW := Round(FIdleLogoBitmap.Width * LogoScale);
  LogoH := Round(FIdleLogoBitmap.Height * LogoScale);
  if LogoW < 1 then LogoW := 1;
  if LogoH < 1 then LogoH := 1;
  LogoX := (BlockW - LogoW) div 2;
  LogoY := (BlockH - LogoH) div 2;

  WmScale := Min(BlockW * IDLE_LOGO_WATERMARK_SIZE_FRAC / FIdleLogoBitmap.Width,
    BlockH * IDLE_LOGO_WATERMARK_SIZE_FRAC / FIdleLogoBitmap.Height);
  if WmScale < LogoScale * 1.65 then
    WmScale := LogoScale * 1.65;
  WmW := Round(FIdleLogoBitmap.Width * WmScale);
  WmH := Round(FIdleLogoBitmap.Height * WmScale);
  if WmW < 1 then WmW := 1;
  if WmH < 1 then WmH := 1;
  WmX := (BlockW - WmW) div 2;
  WmY := (BlockH - WmH) div 2;
  IdleLogoStretchSmooth(Bmp, WmX, WmY, WmW, WmH,
    FIdleLogoBitmap, IDLE_LOGO_WATERMARK_BLEND);

  IdleLogoStretchSmooth(Bmp, LogoX, LogoY, LogoW, LogoH,
    FIdleLogoBitmap, IDLE_LOGO_BG_ALPHA);

  { Labels centralizados sobre a logo (version2.html). }
  TextTop := LogoY + (LogoH - TextH) div 2;
  if TextTop < 0 then TextTop := 0;

  Bmp.Canvas.Font.Name := TitleName;
  Bmp.Canvas.Font.Height := -TitleFontH;
  Bmp.Canvas.Font.Style := [];
  TR := Rect(0, TextTop, BlockW, TextTop + TitleH);
  Flags := DT_CENTER or DT_VCENTER or DT_SINGLELINE;
  WriteColor(Bmp, PChar(APPLICATION_NAME), True, TR, Flags, IDLE_LOGO_TITLE_COLOR);

  Bmp.Canvas.Font.Name := SubName;
  Bmp.Canvas.Font.Height := -FullFontH;
  Bmp.Canvas.Font.Style := [fsItalic];
  TR := Rect(0, TextTop + TitleH + Gap1, BlockW, TextTop + TitleH + Gap1 + FullH);
  Flags := DT_CENTER or DT_VCENTER or DT_SINGLELINE;
  WriteColor(Bmp, PChar(APPLICATION_FULLNAME), True, TR, Flags, IDLE_LOGO_TAGLINE_COLOR);

  Bmp.Canvas.Font.Height := -SubFontH;
  Bmp.Canvas.Font.Style := [fsItalic];
  TR := Rect(0, TextTop + TitleH + Gap1 + FullH + Gap2, BlockW,
    TextTop + TitleH + Gap1 + FullH + Gap2 + SubH);
  Flags := DT_CENTER or DT_WORDBREAK;
  WriteColor(Bmp, PChar(APPLICATION_DEVELOPER), True, TR, Flags, IDLE_LOGO_TAGLINE_COLOR);
end;


function TfrmMain.DoSplitEqualPartsFromDialog(const SourceFile: String; const PartCount: Integer;
  const HeaderStr, FooterStr: String): Boolean;
var
  Fs: TFileStream;
  CurOpen: String;
begin
  Result := False;
  if SourceFile = '' then
  begin
    ShowAppMessage(TrText('Source file is required.'));
    Exit;
  end;
  if not FileExists(SourceFile) then
  begin
    ShowAppMessage(TrText('Source file not found.'));
    Exit;
  end;
  try
    Fs := TFileStream.Create(SourceFile, fmOpenRead or fmShareDenyNone);
    try
      if Fs.Size <= 0 then
      begin
        ShowAppMessage(TrText('Source file is empty.'));
        Exit;
      end;
    finally
      Fs.Free;
    end;
  except
    on E: Exception do
    begin
      ShowAppMessage(TrText('Could not open source file: ') + E.Message);
      Exit;
    end;
  end;

  if PartCount < 2 then
  begin
    ShowAppMessage(TrText('Number of parts must be between 2 and 1000.'));
    Exit;
  end;

  CurOpen := CurrentEffectiveFilePath;
  if (CurOpen <> '') and (CurOpen <> SELECTTEXT) and
     SameText(ExpandFileName(SourceFile), ExpandFileName(CurOpen)) then
  begin
    if not EnsureWritableSession then Exit;
    FSplitClosedSourcePath := ExpandFileName(CurOpen);
    FSplitRestoreTotalLines := totalLines;
    FSplitRestoreZeroScan := FZeroScanMode;
    FSplitRestoreZeroScanEstimated := FZeroScanEstimatedLines;
    FSplitRestoreZeroScanPhysical := FZeroScanPhysicalLineCount;
    FSplitRestoreBytesPerItem := FZeroScanBytesPerItem;
    CloseFileStreams;
  end;

  if not ConfirmDiskSpaceForSplitEqual(SourceFile) then
    Exit;

  { Line count runs in TSplitEqualPartsThread (keeps UI responsive on large files). }
  TSplitEqualPartsThread.Create(SourceFile, PartCount, 0, True, True, HeaderStr, FooterStr);
  Result := True;
end;

procedure TfrmMain.UpdateSplitFractionPreview;

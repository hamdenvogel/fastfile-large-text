function TfrmMain.DoSplitFileFractionFromDialog(const SourceFile: String;
  const TotalParts, PartFrom, PartTo: Integer; const HeaderStr, FooterStr: String): Boolean;
var
  Fs: TFileStream;
  CurOpen: String;
  TotalLinesArg: Int64;
  PhysLines: Int64;
begin
  Result := False;
  if SourceFile = '' then
  begin
    ShowAppMessage(TrText('Source file is required.'));
    Exit;
  end;
  if not FileExists(SourceFile) then
  begin
    ShowAppMessage(TrText('Source file not found.'));
    Exit;
  end;
  try
    Fs := TFileStream.Create(SourceFile, fmOpenRead or fmShareDenyNone);
    try
      if Fs.Size <= 0 then
      begin
        ShowAppMessage(TrText('Source file is empty.'));
        Exit;
      end;
    finally
      Fs.Free;
    end;
  except
    on E: Exception do
    begin
      ShowAppMessage(TrText('Could not open source file: ') + E.Message);
      Exit;
    end;
  end;

  if TotalParts < 2 then
  begin
    ShowAppMessage(TrText('Number of parts must be between 2 and 1000.'));
    Exit;
  end;
  if (PartFrom < 1) or (PartTo > TotalParts) or (PartFrom > PartTo) then
  begin
    ShowAppMessage(Format(TrText('SplitFileFraction.PartsRangeError'), [TotalParts]));
    Exit;
  end;

  TotalLinesArg := 0;
  CurOpen := CurrentEffectiveFilePath;
  if (CurOpen <> '') and
     SameText(ExpandFileName(SourceFile), ExpandFileName(CurOpen)) then
  begin
    if not EnsureWritableSession then Exit;
    if UsesProportionalZeroScanScroll then
    begin
      PhysLines := FZeroScanPhysicalLineCount;
      if PhysLines <= 0 then
        PhysLines := DiscoverZeroScanLastPhysicalLine1Based;
      if PhysLines > 0 then
        TotalLinesArg := PhysLines;
    end
    else if HasLineSearchIndex and (totalLines > 0) and (totalLines < 2000000000) then
      TotalLinesArg := totalLines;
    FSplitClosedSourcePath := ExpandFileName(CurOpen);
    FSplitRestoreTotalLines := totalLines;
    FSplitRestoreZeroScan := FZeroScanMode;
    FSplitRestoreZeroScanEstimated := FZeroScanEstimatedLines;
    FSplitRestoreZeroScanPhysical := FZeroScanPhysicalLineCount;
    FSplitRestoreBytesPerItem := FZeroScanBytesPerItem;
    CloseFileStreams;
  end;

  if not ConfirmDiskSpaceForSplitFraction(SourceFile, PartFrom, PartTo, TotalParts) then
    Exit;

  TSplitFileFractionThread.Create(SourceFile, TotalParts, PartFrom, PartTo, TotalLinesArg,
    True, True, HeaderStr, FooterStr);
  Result := True;
end;

procedure TfrmMain.LocalizeFileInfoRow;
var
  Bmp: TBitmap;
  W: Integer;
begin
  if Assigned(chCheckedAll) then
  begin
    chCheckedAll.Caption := TrText('All');
    Bmp := TBitmap.Create;
    try
      Bmp.Canvas.Font.Assign(chCheckedAll.Font);
      W := Bmp.Canvas.TextWidth(chCheckedAll.Caption) + 26;
    finally
      Bmp.Free;
    end;
    if W < 37 then W := 37;
    chCheckedAll.Width := W;
    if Assigned(pnlCheck) then
      pnlCheck.Width := W + 1;
  end;
  if Assigned(lblTimeDesc) then
  begin
    lblTimeDesc.Caption := TrText('Lines/Time:');
    if Assigned(pnlCheck) then
      lblTimeDesc.Left := pnlCheck.Left + pnlCheck.Width + 6;
    if Assigned(lblInfoFileTime) then
      lblInfoFileTime.Left := lblTimeDesc.Left + lblTimeDesc.Width + 5;
  end;
  if Assigned(edtGoToLine) then
    edtGoToLine.BoundLabel.Caption := TrText('Line:');
end;

procedure TfrmMain.RelocalizeHostedToolTabs;
var
  Frm: TMergeFilesDialogForm;
  SDest, SSource, SHint, SFrom, STo, SHeader, SFooter, SPattern: string;
  IMode, I1, I2, I3: Integer;
  BRange: Boolean;
  BSelfMerge: Boolean;
begin
  if Assigned(FMergeFilesHosted) then
  begin
    Frm := TMergeFilesDialogForm(FMergeFilesHosted);
    SHint := Frm.Hint;
    SDest := Frm.EdtDest.Text;
    SSource := Frm.EdtSource.Text;
    BRange := Frm.ChkLineRange.Checked;
    BSelfMerge := Frm.ChkSelfMerge.Checked;
    SFrom := Frm.EdtFromLine.Text;
    STo := Frm.EdtToLine.Text;
    IMode := Frm.RgMode.ItemIndex;
    I1 := Frm.SpnLine.Value;
    EnsureMergeFilesTab;
    Frm := TMergeFilesDialogForm(FMergeFilesHosted);
    Frm.Hint := SHint;
    Frm.EdtDest.Text := SDest;
    Frm.EdtSource.Text := SSource;
    Frm.EdtFromLine.Text := SFrom;
    Frm.EdtToLine.Text := STo;
    Frm.RgMode.ItemIndex := IMode;
    Frm.SpnLine.Value := I1;
    Frm.ChkLineRange.Checked := BRange;
    MergeFilesLineRangeToggleClick(nil);
    Frm.ChkSelfMerge.Checked := BSelfMerge;
    MergeFilesSelfMergeToggleClick(Frm.ChkSelfMerge);
  end;

  if Assigned(FSplitEqualPartsHosted) then
  begin
    Frm := TMergeFilesDialogForm(FSplitEqualPartsHosted);
    SSource := Frm.EdtSource.Text;
    I1 := Frm.SpnParts.Value;
    SHeader := Frm.MemoHeader.Text;
    SFooter := Frm.MemoFooter.Text;
    EnsureSplitEqualPartsTab;
    Frm := TMergeFilesDialogForm(FSplitEqualPartsHosted);
    Frm.EdtSource.Text := SSource;
    Frm.SpnParts.Value := I1;
    Frm.MemoHeader.Text := SHeader;
    Frm.MemoFooter.Text := SFooter;
  end;

  if Assigned(FSplitFractionHosted) then
  begin
    Frm := TMergeFilesDialogForm(FSplitFractionHosted);
    SSource := Frm.EdtSource.Text;
    I1 := Frm.SpnFracTotal.Value;
    I2 := Frm.SpnFracFrom.Value;
    I3 := Frm.SpnFracTo.Value;
    SHeader := Frm.MemoHeader.Text;
    SFooter := Frm.MemoFooter.Text;
    EnsureSplitFractionTab;
    Frm := TMergeFilesDialogForm(FSplitFractionHosted);
    Frm.EdtSource.Text := SSource;
    Frm.SpnFracTotal.Value := I1;
    Frm.SpnFracFrom.MaxValue := I1;
    Frm.SpnFracTo.MaxValue := I1;
    Frm.SpnFracFrom.Value := I2;
    Frm.SpnFracTo.Value := I3;
    Frm.MemoHeader.Text := SHeader;
    Frm.MemoFooter.Text := SFooter;
    UpdateSplitFractionPreview;
  end;

  { An AI suggestion in flight writes into the current controls; rebuilding would drop it. }
  if Assigned(FSplitByPatternHosted) and not FSplitPatternAISuggestBusy then
  begin
    Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
    SSource := Frm.EdtSource.Text;
    IMode := Frm.cmbMode.ItemIndex;
    I1 := Frm.SpnEqualParts.Value;
    SPattern := Frm.EdtPattern.Text;
    SHeader := Frm.MemoHeader2.Text;
    SFooter := Frm.MemoFooter2.Text;
    EnsureSplitByPatternTab;
    Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
    Frm.EdtSource.Text := SSource;
    Frm.cmbMode.ItemIndex := IMode;
    SplitPatternComboModeChange(nil);
    Frm.SpnEqualParts.Value := I1;
    Frm.EdtPattern.Text := SPattern;
    Frm.MemoHeader2.Text := SHeader;
    Frm.MemoFooter2.Text := SFooter;
    ApplySplitPatternHostedMetrics;
  end;
end;


var
  G_LastSplitRegexSourceFile: string = '';

procedure TfrmMain.RefreshSplitTabRegexExamples;
var
  Frm: TMergeFilesDialogForm;
  P: String;
begin
  if not Assigned(FSplitByPatternHosted) then Exit;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
  SplitPatternHideAiBanner(Frm);
  if not Assigned(Frm.MemoRegexGuide) then Exit;
  P := Trim(Frm.EdtSource.Text);
  if (P = '') or not FileExists(P) then
  begin
    Frm.MemoRegexGuide.Text := TrText('Choose a source file to generate copy-paste regex examples from the first 1000 non-empty lines.');
    FSplitPatternMemoAutoExamples := ''; // reset cache
  end
  else
  begin
    // only rebuild if the file actually changed
    if (FSplitPatternMemoAutoExamples = '') or (G_LastSplitRegexSourceFile <> P) then
    begin
      G_LastSplitRegexSourceFile := P;
      FSplitPatternMemoAutoExamples := BuildFileBasedExamples(P);
    end;
    Frm.MemoRegexGuide.Text := FSplitPatternMemoAutoExamples;
  end;
end;

procedure TfrmMain.SplitPatternSourceEdited(Sender: TObject);
begin
  RefreshSplitTabRegexExamples;
end;

procedure TfrmMain.SplitPatternComboModeChange(Sender: TObject);
var
  Frm: TMergeFilesDialogForm;
  RegexMode: Boolean;
begin
  if not Assigned(FSplitByPatternHosted) then Exit;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
  { Hosted tab: cmbMode index 1 = pattern/regex (AI + examples); 0 = equal parts only. }
  RegexMode := (not Assigned(Frm.cmbMode)) or (Frm.cmbMode.ItemIndex = 1);
  if Assigned(Frm.LblPattern) then Frm.LblPattern.Visible := RegexMode;
  if Assigned(Frm.EdtPattern) then
  begin
    Frm.EdtPattern.Visible := RegexMode;
    Frm.EdtPattern.Enabled := RegexMode;

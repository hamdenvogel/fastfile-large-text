  Ini := TIniFile.Create(IniName);
  try
    WantFloat := Ini.ReadBool('UIPrefs', 'FilterBarFloating', False);
  finally
    Ini.Free;
  end;
  if WantFloat then
    FloatFilterBar;
end;

function TfrmMain.ReadViewIsFloating: Boolean;
begin
  Result := Assigned(FReadViewHost) and ControlIsOnFloatForm(FReadViewHost);
end;

procedure TfrmMain.ApplyReadViewFloatCaptions;
var
  HintTxt: string;
begin
  if Assigned(FReadViewTitle) then
    FReadViewTitle.Caption := TrText('Read view');
  if Assigned(FReadViewFloat) then
    FReadViewFloat.Caption := TrText('Read view');
  if Assigned(FReadViewBtnFloat) then
  begin
    if ReadViewIsFloating then
    begin
      FReadViewBtnFloat.Caption := #$2199;
      FReadViewBtnFloat.Hint := TrText('Panel.DockHint');
    end
    else
    begin
      FReadViewBtnFloat.Caption := #$2197;
      FReadViewBtnFloat.Hint := TrText('Panel.RestoreFloatHint');
    end;
    FReadViewBtnFloat.ShowHint := True;
  end;
  if Assigned(FReadViewMiFloat) then
  begin
    if ReadViewIsFloating then
      FReadViewMiFloat.Caption := TrText('Panel.Dock')
    else
      FReadViewMiFloat.Caption := TrText('Panel.RestoreFloat');
  end;
  if ReadViewIsFloating then
    HintTxt := TrText('Panel.DragDockHint')
  else
    HintTxt := TrText('Panel.DragUndockHint');
  if Assigned(FReadViewHeader) then
  begin
    FReadViewHeader.ShowHint := True;
    FReadViewHeader.Hint := HintTxt;
    FReadViewHeader.Cursor := crSizeAll;
  end;
  if Assigned(FReadViewTitle) then
  begin
    FReadViewTitle.ShowHint := True;
    FReadViewTitle.Hint := HintTxt;
    FReadViewTitle.Cursor := crSizeAll;
  end;
end;

procedure TfrmMain.EnsureReadViewHost;
var
  UiFont: string;
begin
  if Assigned(FReadViewHost) then
  begin
    ApplyReadViewFloatCaptions;
    Exit;
  end;
  if not Assigned(pnlCenter) or not Assigned(ListView1) then Exit;

  if Screen.Fonts.IndexOf('Segoe UI') >= 0 then
    UiFont := 'Segoe UI'
  else
    UiFont := 'Tahoma';

  pnlCenter.DisableAlign;
  try
    FReadViewHost := TsPanel.Create(Self);
    FReadViewHost.Parent := pnlCenter;
    FReadViewHost.Align := alClient;
    FReadViewHost.BevelOuter := bvNone;
    FReadViewHost.Caption := '';
    FReadViewHost.ParentColor := True;
    FReadViewHost.DoubleBuffered := True;

    FReadViewHeader := TsPanel.Create(Self);
    FReadViewHeader.Parent := FReadViewHost;
    FReadViewHeader.Align := alTop;
    FReadViewHeader.Height := 28;
    FReadViewHeader.BevelOuter := bvNone;
    FReadViewHeader.Caption := '';
    FReadViewHeader.ParentBackground := False;
    FReadViewHeader.ParentColor := False;
    FReadViewHeader.Color := $00EFEAE7;
    FReadViewHeader.OnMouseDown := ReadViewHeaderMouseDown;
    FReadViewHeader.OnMouseMove := ReadViewHeaderMouseMove;
    FReadViewHeader.OnMouseUp := ReadViewHeaderMouseUp;
    FReadViewHeader.OnDblClick := ReadViewHeaderDblClick;
    try
      FReadViewHeader.SkinData.SkinSection := 'TOOLBAR';
    except
    end;

    FReadViewBtnFloat := TsButton.Create(Self);
    FReadViewBtnFloat.Parent := FReadViewHeader;
    FReadViewBtnFloat.Align := alRight;
    FReadViewBtnFloat.Width := 28;
    FReadViewBtnFloat.Caption := #$2197;
    FReadViewBtnFloat.TabStop := False;
    FReadViewBtnFloat.OnClick := ToggleReadViewFloat;
    FReadViewBtnFloat.ParentFont := False;
    FReadViewBtnFloat.Font.Name := UiFont;
    FReadViewBtnFloat.Font.Size := 9;
    try
      FReadViewBtnFloat.SkinData.SkinSection := 'TOOLBUTTON';
    except
    end;

    FReadViewPopup := TPopupMenu.Create(Self);
    FReadViewMiFloat := TMenuItem.Create(FReadViewPopup);
    FReadViewMiFloat.OnClick := ToggleReadViewFloat;
    FReadViewPopup.Items.Add(FReadViewMiFloat);
    FReadViewHeader.PopupMenu := FReadViewPopup;

    FReadViewTitle := TsLabel.Create(Self);
    FReadViewTitle.Parent := FReadViewHeader;
    FReadViewTitle.Align := alClient;
    FReadViewTitle.AutoSize := False;
    FReadViewTitle.Layout := tlCenter;
    FReadViewTitle.AlignWithMargins := True;
    FReadViewTitle.Margins.SetBounds(8, 0, 4, 0);
    FReadViewTitle.ParentFont := False;
    FReadViewTitle.Font.Name := UiFont;
    FReadViewTitle.Font.Size := 9;
    FReadViewTitle.Font.Style := [fsBold];
    FReadViewTitle.Transparent := True;
    FReadViewTitle.OnMouseDown := ReadViewHeaderMouseDown;
    FReadViewTitle.OnMouseMove := ReadViewHeaderMouseMove;
    FReadViewTitle.OnMouseUp := ReadViewHeaderMouseUp;
    FReadViewTitle.OnDblClick := ReadViewHeaderDblClick;

    ListView1.Parent := FReadViewHost;
    ListView1.Align := alClient;
    if Assigned(FLvTools) then
    begin
      FLvTools.Parent := FReadViewHost;
      FLvTools.Align := alBottom;
    end;
    if Assigned(FCheckListBox) then
    begin
      FCheckListBox.Parent := FReadViewHost;
      FCheckListBox.Align := alClient;
    end;
    if Assigned(FMarksLegendPanel) then
    begin
      FMarksLegendPanel.Parent := FReadViewHost;
      FMarksLegendPanel.Align := alTop;
    end;
  finally
    pnlCenter.EnableAlign;
  end;
  ApplyReadViewFloatCaptions;
end;

procedure TfrmMain.SaveReadViewFloatBounds;
var
  Ini: TIniFile;
  Frm: TCustomForm;
begin
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteBool('UIPrefs', 'ReadViewFloating', ReadViewIsFloating);
    if ReadViewIsFloating then
    begin
      Frm := HostFormOf(FReadViewHost);
      if Assigned(Frm) then
      begin
        Ini.WriteInteger('UIPrefs', 'ReadViewFloatLeft', Frm.Left);
        Ini.WriteInteger('UIPrefs', 'ReadViewFloatTop', Frm.Top);
        Ini.WriteInteger('UIPrefs', 'ReadViewFloatWidth', Frm.Width);
        Ini.WriteInteger('UIPrefs', 'ReadViewFloatHeight', Frm.Height);
      end;
    end;
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.UpdateReadViewDockZone(Sender: TObject);
var
  P1, P2: TPoint;
begin
  if not Assigned(FReadViewFloat) or not Assigned(pnlCenter) then Exit;
  P1 := pnlCenter.ClientToScreen(Point(0, 0));
  P2 := pnlCenter.ClientToScreen(Point(pnlCenter.ClientWidth, pnlCenter.ClientHeight));
  FReadViewFloat.SetDockZone(Rect(P1.X, P1.Y, P2.X, P2.Y));
  FReadViewFloat.SetMainMagnet(Rect(0, 0, 0, 0));
end;

procedure TfrmMain.RefreshReadViewAfterReparent;
{ After undock/dock, VCL ScaleForPPI can inflate ListView/header fonts.
  Force chrome + zoom back from stored base size (not from the scaled Font.Size). }
var
  UiFont: string;
  WantSize, Pct: Integer;
begin
  if Screen.Fonts.IndexOf('Segoe UI') >= 0 then
    UiFont := 'Segoe UI'
  else
    UiFont := 'Tahoma';

  if Assigned(FReadViewTitle) then
  begin
    FReadViewTitle.ParentFont := False;
    FReadViewTitle.Font.Name := UiFont;
    FReadViewTitle.Font.Size := 9;
    FReadViewTitle.Font.Style := [fsBold];
  end;
  if Assigned(FReadViewBtnFloat) then
  begin
    FReadViewBtnFloat.ParentFont := False;
    FReadViewBtnFloat.Font.Name := UiFont;
    FReadViewBtnFloat.Font.Size := 9;
  end;
  if Assigned(FReadViewHeader) then
  begin
    FReadViewHeader.ParentFont := False;
    FReadViewHeader.Font.Name := UiFont;
    FReadViewHeader.Font.Size := 9;
  end;

  if not Assigned(ListView1) then Exit;

  ListView1.ParentFont := False;
  if ListView1.Font.Name = '' then
    ListView1.Font.Name := 'Courier New';

  Pct := FListViewZoomPct;
  if Pct <= 0 then
    Pct := 100;
  if FListViewZoomBaseFontSize <= 0 then
    FListViewZoomBaseFontSize := 10;

  WantSize := Round((FListViewZoomBaseFontSize * Pct) / 100.0);
  if WantSize < ZOOM_MIN_SIZE then
    WantSize := ZOOM_MIN_SIZE;
  if WantSize > ZOOM_MAX_SIZE then
    WantSize := ZOOM_MAX_SIZE;

  BeginListViewZoomVisualBatch;
  try
    ListView1.Font.Size := WantSize;
    if Assigned(FCheckListBox) then
    begin
      FCheckListBox.ParentFont := False;
      FCheckListBox.Font.Name := ListView1.Font.Name;
      FCheckListBox.Font.Size := WantSize;
      FCheckListBox.Font.Style := ListView1.Font.Style;
    end;
    CalculateFontMetrics;
    if Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      ListView1.Invalidate;
      if not FReadContentColumnExpanded then
        UpdateListViewLineColumnAutoWidth;
    end;
    if Assigned(FCheckListBox) and FCheckListBox.HandleAllocated then
    begin
      FCheckListBox.Invalidate;
      if not FReadContentColumnExpanded then
        UpdateCheckListLinePrefixAutoWidth;
    end;
    UpdateListViewZoomStatusPanel;
  finally
    EndListViewZoomVisualBatch;
  end;
end;

procedure TfrmMain.FloatReadView(AFollowCursor: Boolean);
var
  Ini: TIniFile;
  L, T, W, H: Integer;
begin
  EnsureReadViewHost;
  if not Assigned(FReadViewHost) or ReadViewIsFloating then Exit;
  if not Assigned(FReadViewFloat) then
  begin
    FReadViewFloat := TFastFileFloatForm.CreateHost(Self, TrText('Read view'));
    FReadViewFloat.OnRequestDock := DockReadView;
    FReadViewFloat.OnUpdateDockZone := UpdateReadViewDockZone;
    FReadViewFloat.Constraints.MinHeight := FfPx(240);
    FReadViewFloat.Constraints.MinWidth := FfPx(360);
  end;
  FReadViewFloat.Caption := TrText('Read view');
  W := FReadViewHost.Width;
  H := FReadViewHost.Height + 36;
  if W < 420 then
    W := 420;
  if H < 280 then
    H := 280;
  L := 0;
  T := 0;
  if not AFollowCursor then
  begin
    Ini := TIniFile.Create(IniName);
    try
      L := Ini.ReadInteger('UIPrefs', 'ReadViewFloatLeft', 0);
      T := Ini.ReadInteger('UIPrefs', 'ReadViewFloatTop', 0);
      W := Ini.ReadInteger('UIPrefs', 'ReadViewFloatWidth', W);
      H := Ini.ReadInteger('UIPrefs', 'ReadViewFloatHeight', H);
    finally
      Ini.Free;
    end;
  end;
  ReparentAligned(FReadViewHost, FReadViewFloat, alClient);
  if AFollowCursor then
    FReadViewFloat.PlaceUnderCursor(W, H)
  else if (L <> 0) or (T <> 0) then
    FReadViewFloat.ApplySavedBounds(L, T, W, H)
  else
    FReadViewFloat.PlaceBesideMain(W, H);
  UpdateReadViewDockZone(nil);
  FReadViewFloat.Show;
  FReadViewFloat.BringToFront;
  RefreshReadViewAfterReparent;
  ApplyReadViewFloatCaptions;
  SaveReadViewFloatBounds;
  if Assigned(pnlCenter) then
    pnlCenter.Realign;
  if AFollowCursor then
  begin
    FReadViewFloat.MarkJustTornOff;
    FReadViewFloat.BeginCaptionFollow;
  end;
end;

procedure TfrmMain.DockReadView(Sender: TObject);
begin
  if not Assigned(FReadViewHost) or not ReadViewIsFloating then Exit;
  SaveReadViewFloatBounds;
  ReparentAligned(FReadViewHost, pnlCenter, alClient);
  FReadViewHost.Align := alClient;
  FReadViewHost.Visible := True;
  if Assigned(FReadViewFloat) then
    FReadViewFloat.Hide;
  RefreshReadViewAfterReparent;
  ApplyReadViewFloatCaptions;
  SaveReadViewFloatBounds;
  if Assigned(pnlCenter) then
    pnlCenter.Realign;
end;

procedure TfrmMain.ToggleReadViewFloat(Sender: TObject);
begin
  if ReadViewIsFloating then
    DockReadView
  else
    FloatReadView(False);
end;

procedure TfrmMain.ReadViewTearOff(Sender: TObject);
begin
  if ReadViewIsFloating then
  begin
    UpdateReadViewDockZone(nil);
    if Assigned(FReadViewFloat) then
      FReadViewFloat.BeginCaptionFollowNow;
  end
  else
    FloatReadView(True);
end;

procedure TfrmMain.ReadViewHeaderMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  if Button <> mbLeft then Exit;
  FReadViewHeaderDown := True;
  FReadViewHeaderPt := Point(X, Y);
  if Sender is TControl then
    SetCaptureControl(TControl(Sender));
end;

procedure TfrmMain.ReadViewHeaderMouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
begin
  if not FReadViewHeaderDown then Exit;
  if (Abs(X - FReadViewHeaderPt.X) < FASTFILE_TEAR_THRESHOLD) and
     (Abs(Y - FReadViewHeaderPt.Y) < FASTFILE_TEAR_THRESHOLD) then
    Exit;
  FReadViewHeaderDown := False;
  SetCaptureControl(nil);
  ReadViewTearOff(Sender);
end;

procedure TfrmMain.ReadViewHeaderMouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  FReadViewHeaderDown := False;
  SetCaptureControl(nil);
end;

procedure TfrmMain.ReadViewHeaderDblClick(Sender: TObject);
begin
  if ReadViewIsFloating then
    DockReadView;
end;

procedure TfrmMain.RestoreReadViewFloatIfNeeded;
var
  Ini: TIniFile;
  WantFloat: Boolean;
begin
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    WantFloat := Ini.ReadBool('UIPrefs', 'ReadViewFloating', False);
  finally
    Ini.Free;
  end;
  if WantFloat then
    FloatReadView;
end;

procedure TfrmMain.AssistantCbNotifyPanelVisible(AVisible: Boolean);
begin
  if not Assigned(FAssistantPanel) then Exit;
  if AVisible then
  begin
    if Assigned(FAssistantSplitter) then
      FAssistantSplitter.Visible := not AssistantPanelIsFloating;
    if not AssistantPanelIsFloating then
    begin
      if Assigned(FAstDock) then
        FAstDock.Visible := False;
      FAssistantPanel.BringToFront;
    end;
  end
  else
  begin
    SaveAssistantPanelWidth;
    SaveAssistantFloatBounds;
    PersistAssistantLayout;
    if Assigned(FAssistantSplitter) then
      FAssistantSplitter.Visible := False;
    if Assigned(FAstDock) and (not AssistantPanelIsFloating) then
      FAstDock.Visible := False;
  end;
  Realign;
  RefreshIdleLogoWorkspaceLayout;
end;

procedure TfrmMain.CreateFastFileAssistantPanel;
var
  IniPath: string;
  ShowOnStart: Boolean;
begin
  if Assigned(FAssistantPanel) then Exit;

  { Dock on main form (alRight), NOT inside tabReadFile/pnlCenter — visible on any tab.
    Create splitter first, then panel: last alRight control docks to the right edge. }
  DisableAlign;
  try
    FAssistantSplitter := TsSplitter.Create(Self);
    FAssistantSplitter.Parent := Self;
    FAssistantSplitter.Align := alRight;
    FAssistantSplitter.Width := 5;
    FAssistantSplitter.Cursor := crHSplit;
    FAssistantSplitter.MinSize := 200;
    FAssistantSplitter.AutoSnap := False;
    FAssistantSplitter.Visible := False;
    FAssistantSplitter.ShowHint := True;
    FAssistantSplitter.Hint := TrText('Assistant.ResizeHint');

    FAstDock := TsPanel.Create(Self);
    FAstDock.Parent := Self;
    FAstDock.Align := alNone;
    FAstDock.Width := 0;
    FAstDock.BevelOuter := bvNone;
    FAstDock.Caption := '';
    FAstDock.Visible := False;
    FAstDock.ParentColor := True;
    FAstDock.DoubleBuffered := True;

    FAstPadBot := TsPanel.Create(Self);
    FAstPadBot.Parent := FAstDock;
    FAstPadBot.Align := alBottom;
    FAstPadBot.Height := 0;
    FAstPadBot.BevelOuter := bvNone;
    FAstPadBot.Caption := '';
    FAstPadBot.Visible := False;
    FAstSplBot := TFastFileEdgeGrip.CreateGrip(Self, FAstDock, fgTop);
    FAstSplBot.Align := alBottom;
    FAstSplBot.Height := FASTFILE_GRIP_H;
    FAstSplBot.ResizeTarget := FAstPadBot;
    FAstSplBot.MinSize := 0;
    FAstSplBot.MaxSize := 520;
    FAstSplBot.Hint := TrText('Assistant.ResizeHint');
    FAstSplBot.Visible := False;

    FAstPadTop := TsPanel.Create(Self);
    FAstPadTop.Parent := FAstDock;
    FAstPadTop.Align := alTop;
    FAstPadTop.Height := 0;
    FAstPadTop.BevelOuter := bvNone;
    FAstPadTop.Caption := '';
    FAstPadTop.Visible := False;
    FAstSplTop := TFastFileEdgeGrip.CreateGrip(Self, FAstDock, fgBottom);
    FAstSplTop.Align := alTop;
    FAstSplTop.Height := FASTFILE_GRIP_H;
    FAstSplTop.ResizeTarget := FAstPadTop;
    FAstSplTop.MinSize := 0;
    FAstSplTop.MaxSize := 520;
    FAstSplTop.Hint := TrText('Assistant.ResizeHint');
    FAstSplTop.Visible := False;

    FAssistantPanel := TsPanel.Create(Self);
    FAssistantPanel.Parent := Self;
    FAssistantPanel.Align := alRight;
    FAssistantPanel.Width := LoadAssistantPanelWidth;
    FAssistantPanel.Constraints.MinWidth := FfPx(280);
    FAssistantPanel.Constraints.MaxWidth := FfPx(900);
    FAssistantPanel.BevelOuter := bvNone;
    FAssistantPanel.Caption := '';
    FAssistantPanel.Visible := False;
    FAssistantPanel.ParentColor := True;
    FAssistantPanel.DoubleBuffered := True;
    CreateFastFileAssistantUI(Self, FAssistantPanel);

    SetFastFileAssistantOnFloat(ToggleAssistantFloat);
    SetFastFileAssistantOnTearOff(AssistantTearOff);
    SetFastFileAssistantOnPython(AssistantPythonClick);
    ApplyMruFindGlyphs;
    IniPath := ExtractFilePath(Application.ExeName) + ASKIN_INI;
    ShowOnStart := ShouldShowAssistantOnStartup(IniPath);
    if ShowOnStart then
    begin
      if Assigned(FAstDock) then
        FAstDock.Visible := False;
      FAssistantPanel.Visible := True;
      if Assigned(FAssistantSplitter) then
        FAssistantSplitter.Visible := True;
      FAssistantPanel.BringToFront;
    end;
  finally
    EnableAlign;
  end;
end;


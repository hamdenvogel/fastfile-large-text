      Lbl.Height := TagH;
      if Assigned(RecentFilesTabFind('lblTitle')) and (RecentFilesTabFind('lblTitle') is TLabel) then
        Lbl.Top := (RecentFilesTabFind('lblTitle') as TLabel).Top +
          (RecentFilesTabFind('lblTitle') as TLabel).Height + GapTitleTag

function TfrmMain.ExtractConsumerAIOptionsFromPrompt(const APrompt: string): string;
var
  Tokens: TStringList;
  Parts: TStringList;
  S, GroupText: string;
  I, J, K: Integer;
  RangeStart, RangeEnd, RangeValue: Integer;

  function IsOptionNoiseWord(const T: string): Boolean;
  begin
    { Mesma ideia do SKIP_WORDS em ConsumerAI_LanceDB._extract_options_from_prompt:
      tokens que aparecem dentro de grupos (...) mas nao sao atalhos. }
    Result :=
      (T = 'or') or (T = 'to') or (T = 'and') or (T = 'exit') or (T = 'return') or
      (T = 'yes') or (T = 'no') or (T = 'menu') or (T = 'prev') or (T = 'press') or
      (T = 'enter') or (T = 'try') or (T = 'again') or (T = 'current') or (T = 'end') or
      (T = 'back');
  end;

  procedure AddToken(const ARaw: string);
  var
    T: string;
    P: Integer;
    IsValid: Boolean;
  begin
    T := LowerCase(Trim(ARaw));
    T := StringReplace(T, '"', '', [rfReplaceAll]);
    T := StringReplace(T, '''', '', [rfReplaceAll]);

    while (Length(T) > 0) and not (T[1] in ['0'..'9', 'a'..'z']) do
      Delete(T, 1, 1);
    while (Length(T) > 0) and not (T[Length(T)] in ['0'..'9', 'a'..'z']) do
      Delete(T, Length(T), 1);

    if (T = '') or (Length(T) > 5) then Exit;
    if IsOptionNoiseWord(T) then Exit;

    IsValid := True;
    for P := 1 to Length(T) do
      if not (T[P] in ['0'..'9', 'a'..'z']) then
      begin
        IsValid := False;
        Break;
      end;

    if IsValid and (Tokens.IndexOf(T) < 0) then
      Tokens.Add(T);
  end;

  procedure AddLeadingToken(const ARaw: string);
  var
    RawText: string;
    P: Integer;
    T: string;
  begin
    RawText := Trim(ARaw);
    if RawText = '' then Exit;
    if RawText[1] in ['''', '"'] then Exit;

    T := '';
    for P := 1 to Length(RawText) do
    begin
      if RawText[P] in ['0'..'9', 'a'..'z', 'A'..'Z'] then
        T := T + RawText[P]
      else
        Break;
    end;

    if T <> '' then
      AddToken(T);
  end;

begin
  Result := '';
  Tokens := TStringList.Create;
  Parts := TStringList.Create;
  try
    Tokens.Sorted := False;
    Tokens.Duplicates := dupIgnore;

    S := APrompt;
    I := 1;
    while I <= Length(S) do
    begin
      if S[I] = '(' then
      begin
        J := I + 1;
        while (J <= Length(S)) and (S[J] <> ')') do
          Inc(J);

        if (J <= Length(S)) and (J > I + 1) then
        begin
          GroupText := Copy(S, I + 1, J - I - 1);

          if (J < Length(S)) and (S[I + 1] in ['0'..'9', 'a'..'z', 'A'..'Z']) and
             (S[J + 1] in ['a'..'z', 'A'..'Z']) and (Length(GroupText) = 1) then
            AddToken(GroupText);

          if (PosBMH('/', GroupText) > 0) or (PosBMH(',', GroupText) > 0) then
          begin
            Parts.Clear;
            Parts.Delimiter := '/';
            Parts.DelimitedText := StringReplace(GroupText, ',', '/', [rfReplaceAll]);
            for K := 0 to Parts.Count - 1 do
            begin
              AddToken(Parts[K]);
              AddLeadingToken(Parts[K]);
            end;
          end
          else
          begin
            // Numeric range shortcut, e.g. (1-6) => 1,2,3,4,5,6
            Parts.Clear;
            Parts.Delimiter := '-';
            Parts.DelimitedText := GroupText;
            if Parts.Count = 2 then
            begin
              RangeStart := StrToIntDef(Trim(Parts[0]), -1);
              RangeEnd := StrToIntDef(Trim(Parts[1]), -1);
              if (RangeStart >= 0) and (RangeEnd >= RangeStart) and ((RangeEnd - RangeStart) <= 30) then
              begin
                for RangeValue := RangeStart to RangeEnd do
                  AddToken(IntToStr(RangeValue));
              end;
            end;
          end;

          K := 1;
          while K <= Length(GroupText) - 2 do
          begin
            if (GroupText[K] = '''') and (GroupText[K + 2] = '''') then
            begin
              AddToken(GroupText[K + 1]);
              Inc(K, 3);
              Continue;
            end;
            Inc(K);
          end;

          I := J;
        end;
      end;
      Inc(I);
    end;

    { Padrao (x)palavra - letra entre parenteses seguida de letra (ex.: (v)iew, (r)eplace). }
    I := 1;
    while I + 3 <= Length(S) do
    begin
      if (S[I] = '(') and (S[I + 1] in ['a'..'z', 'A'..'Z']) and (S[I + 2] = ')') and
         (S[I + 3] in ['a'..'z', 'A'..'Z']) then
      begin
        AddToken(S[I + 1]);
        Inc(I, 3);
      end
      else
        Inc(I);
    end;

    for I := 0 to Tokens.Count - 1 do
    begin
      if Result <> '' then
        Result := Result + ',';
      Result := Result + Tokens[I];
    end;
  finally
    Parts.Free;
    Tokens.Free;
  end;
end;

function TfrmMain.ShouldSuppressConsumerAIOutput(const AText: string): Boolean;
var
  L, T, Inner: string;
begin
  L := Trim(AText);
  Result := (L = '');

  { Strip accidental leading pipe from FFBRIDGE payload quirks. }
  while (not Result) and (L <> '') and (L[1] = '|') do
    Delete(L, 1, 1);
  L := Trim(L);
  if L = '' then
    Exit(True);

  T := StringReplace(L, ' ', '', [rfReplaceAll]);
  T := StringReplace(T, '|', '', [rfReplaceAll]);
  T := StringReplace(T, '+', '', [rfReplaceAll]);
  T := StringReplace(T, '-', '', [rfReplaceAll]);
  if T = '' then
    Exit(True);

  if PosBMH('FILE LOADED VIA COMMAND LINE', UpperCase(L)) > 0 then
    Exit(True);
  if (PosBMH('File:', L) = 1) or (PosBMH('Path:', L) = 1) then
    Exit(True);

  if PosBMH('HEADER CONFIGURATION', UpperCase(L)) > 0 then
  begin
    if (Pos('?', L) = 0) and (PosBMH('PLEASE', UpperCase(L)) = 0) then
      Exit(True);
  end;

  if (L <> '') and (L[1] = '|') and (L[Length(L)] = '|') then
  begin
    Inner := Trim(Copy(L, 2, Length(L) - 2));
    if Inner = '' then
      Exit(True);
    if PosBMH('FILE LOADED', UpperCase(Inner)) > 0 then
      Exit(True);
    if (PosBMH('HEADER CONFIGURATION', UpperCase(Inner)) > 0) and
       (Pos('?', Inner) = 0) and (PosBMH('PLEASE', UpperCase(Inner)) = 0) then
      Exit(True);
    if (PosBMH('File:', Inner) = 1) or (PosBMH('Path:', Inner) = 1) then
      Exit(True);
  end;

  L := LowerCase(L);
  Result :=
    (PosBMH('initializing fastfile ai', L) = 1) or
    (PosBMH('fastfile ai - version', L) = 1) or
    (L = 'fastfile ai') or
    (PosBMH('version:', L) = 1) or
    (PosBMH('copyright:', L) = 1) or
    (PosBMH('preparing temporary file', L) > 0) or
    (PosBMH('creates a working temporary file', L) > 0) or
    (PosBMH('automatic cleanup is enabled:', L) > 0) or
    (PosBMH('sql:', L) = 1) or
    (PosBMH('total rows:', L) = 1) or
    (PosBMH('total records:', L) = 1) or
    (PosBMH('translating to sql', L) > 0) or
    (PosBMH('loading modules', L) > 0) or
    (PosBMH('modules loaded', L) > 0) or
    (PosBMH('preparing session', L) > 0) or
    { ConsumerRAG / transformers / HF hub noise (not useful in the chat pane) }
    (PosBMH('unauthenticated requests to the hf hub', L) > 0) or
    (PosBMH('layers were not sharded', L) > 0) or
    (PosBMH('load report', L) > 0) or
    (PosBMH('not documented', L) > 0) or
    (PosBMH('relative_attention_', L) > 0) or
    (PosBMH('feed_forward_proj', L) > 0) or
    (PosBMH('query_pre_attn_scalar', L) > 0) or
    (PosBMH('attn_logit_softcapping', L) > 0) or
    (PosBMH('mm_tokens_per_image', L) > 0) or
    (PosBMH('boi_token_index', L) > 0) or
    (PosBMH('eoi_token_index', L) > 0) or
    (PosBMH('lance::dataset', L) > 0) or
    (PosBMH('no existing dataset at', L) > 0) or
    (PosBMH('huggingface', L) > 0) and (PosBMH('warning', L) > 0);
end;



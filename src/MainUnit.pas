function TfrmMain.UndoRedoBusy: Boolean;
begin
  Result := FPendingEditUndo or (FPendingUndoRedo <> purNone) or FFileReloadInProgress;
end;

function TfrmMain.UndoPartnerNeedsCurrentLine(const AOp: Integer): Boolean;
begin
  { Op 2/3: conteudo ja esta no registo undo; GetLineContent na UI trava GB+ (indice esparso). }
  Result := (AOp = 0) or (AOp = 1);
end;

function TfrmMain.TruncateUndoPreview(const S: String): String;
begin
  Result := Trim(StringReplace(StringReplace(S, #13#10, ' ', [rfReplaceAll]), #10, ' ', [rfReplaceAll]));
  if Length(Result) > MaxLen then
    Result := Copy(Result, 1, MaxLen) + '...';
end;

function TfrmMain.ClipboardLineCountFromUndoRecord(const P: PUndoRecord): Integer;
var
  L: TStringList;
  Cnt: Integer;
begin
  Result := 1;
  if P = nil then Exit;
  if P^.Op = 3 then
  begin
    Cnt := StrToIntDef(Trim(P^.OldContent), 0);
    if Cnt > 0 then
    begin
      Result := Cnt;
      Exit;
    end;
  end;
  L := TStringList.Create;
  try
    L.Text := P^.NewContent;
    if (P^.Op = 3) and (P^.BatchKind <> 0) then
      { autofill / dialogo: linhas vazias sao intencionais }
    else
      TrimTrailingEmptyClipboardLines(L);
    Result := L.Count;
    if Result < 1 then Result := 1;
  finally
    L.Free;
  end;
end;

function TfrmMain.RestoreBatchInsertLinesFromUndo(const P: PUndoRecord): TStringList;
var
  Cnt, I: Integer;
begin
  Result := TStringList.Create;
  if P = nil then Exit;
  Cnt := ClipboardLineCountFromUndoRecord(P);
  if Trim(P^.NewContent) <> '' then
  begin
    Result.Text := P^.NewContent;
    if P^.BatchKind = 0 then
      TrimTrailingEmptyClipboardLines(Result);
  end;
  while Result.Count < Cnt do
  begin
    if P^.BatchKind = 1 then
      Result.Add(BuildBlankInsertLineContent)
    else
      Result.Add('');
  end;
  while Result.Count > Cnt do
    Result.Delete(Result.Count - 1);
  if Result.Count = 0 then
    for I := 1 to Cnt do
    begin
      if P^.BatchKind = 1 then
        Result.Add(BuildBlankInsertLineContent)
      else
        Result.Add('');
    end;
end;

procedure TfrmMain.TrimTrailingEmptyClipboardLines(ALines: TStringList);
begin
  if not Assigned(ALines) then Exit;
  while (ALines.Count > 0) and (Trim(ALines[ALines.Count - 1]) = '') do
    ALines.Delete(ALines.Count - 1);
end;

function TfrmMain.FormatUndoConfirmMessage(P: PUndoRecord): String;
var
  Preview: String;
  LineCount: Integer;
begin
  case P^.Op of
    3: begin
         LineCount := ClipboardLineCountFromUndoRecord(P);
         if P^.BatchKind = 1 then
           Result := Format(TrText('Undo line autofill of %d blank line(s) at line %d? The added lines will be removed.'),
             [LineCount, P^.Line])
         else
           Result := Format(TrText('Undo paste of %d line(s) starting at line %d? The pasted lines will be removed.'),
             [LineCount, P^.Line]);
       end;
    0: Result := Format(TrText('Undo insert at line %d? The inserted line will be removed.'), [P^.Line]);
    1: begin
         Preview := TruncateUndoPreview(P^.OldContent);
         if Preview <> '' then
           Result := Format(TrText('Undo edit on line %d? The line will be restored to: "%s"'),
             [P^.Line, Preview])
         else
           Result := Format(TrText('Undo edit on line %d? The line will be restored to its previous content.'),
             [P^.Line]);
       end;
    2: begin
         Preview := TruncateUndoPreview(P^.OldContent);
         if Preview <> '' then
           Result := Format(TrText('Undo delete on line %d? The line will be restored: "%s"'),
             [P^.Line, Preview])
         else
           Result := Format(TrText('Undo delete on line %d? The deleted line will be restored.'), [P^.Line]);
       end;
  else
    Result := Format(TrText('Undo the last change on line %d?'), [P^.Line]);
  end;
end;

function TfrmMain.FormatRedoConfirmMessage(P: PUndoRecord): String;
var
  Preview: String;
  LineCount: Integer;
begin
  case P^.Op of
    3: begin
         LineCount := ClipboardLineCountFromUndoRecord(P);
         if P^.BatchKind = 1 then
           Result := Format(TrText('Redo line autofill of %d blank line(s) at line %d?'),
             [LineCount, P^.Line])
         else
           Result := Format(TrText('Redo paste of %d line(s) starting at line %d?'), [LineCount, P^.Line]);
       end;
    0: begin
         Preview := TruncateUndoPreview(P^.NewContent);
         if Preview <> '' then
           Result := Format(TrText('Redo insert at line %d? Insert: "%s"'), [P^.Line, Preview])
         else
           Result := Format(TrText('Redo insert at line %d? The line will be inserted again.'), [P^.Line]);
       end;
    1: begin
         Preview := TruncateUndoPreview(P^.NewContent);
         if Preview <> '' then
           Result := Format(TrText('Redo edit on line %d? Apply: "%s"'), [P^.Line, Preview])
         else
           Result := Format(TrText('Redo edit on line %d? The edited content will be applied again.'), [P^.Line]);
       end;
    2: Result := Format(TrText('Redo delete on line %d? The line will be deleted again.'), [P^.Line]);
  else
    Result := Format(TrText('Redo the last undone change on line %d?'), [P^.Line]);
  end;
end;

procedure TfrmMain.StartAsyncUndoRedo(const AAction: TPendingUndoRedoAction;
  const ADiskOp: TOperationType; const ALine: Int64; const AContent: String;
  const APartner, ARestore: PUndoRecord; const AStatusMsg: String;
  const AInsertLines: TStringList = nil; const ALineSpanCount: Integer = 1);
var
  ThreadLines: TStringList;
begin
  FPendingUndoRedo := AAction;
  FPendingUndoRedoPartner := APartner;
  FPendingUndoRedoRestore := ARestore;
  FPendingUndoRedoStatusMsg := AStatusMsg;
  CloseFileStreams;
  ThreadLines := nil;
  if Assigned(AInsertLines) then
  begin
    ThreadLines := TStringList.Create;
    ThreadLines.Assign(AInsertLines);
  end;
  TEditFileThread.Create(CurrentEffectiveFilePath, ADiskOp, ALine, AContent,
    True, True, True, False, False, ThreadLines, ALineSpanCount);
end;

function TfrmMain.ApplyBatchInsertWithUndo(const AStartLine: Int64;
  ALines: TStringList; const ABatchKind: Integer): Boolean;
{ Insercao em lote: colar (0), autofill coluna Linha # (1), dialogo multiplas (2).
  Undo/redo Ctrl+Z/Y usam Op=3 na pilha; journal merge: BINS ou BAUT. }
var
  ThreadLines: TStringList;
begin
  Result := False;
  if UndoRedoBusy then
  begin
    FastFileMessageBox(PChar(TrText('Another edit or undo is still in progress. Please wait.')),
      APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  if (ALines = nil) or (ALines.Count = 0) then Exit;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;

  ThreadLines := TStringList.Create;
  try
    ThreadLines.Assign(ALines);
    FreeAndNil(FPendingBatchInsertLines);
    FPendingBatchInsertLines := TStringList.Create;
    FPendingBatchInsertLines.Assign(ALines);
    FPendingBatchInsertStartLine := AStartLine;
    FPendingBatchInsertKind := ABatchKind;
    FPendingEditUndo := True;
    FPendingEditUndoOp := otInsert;
    FPendingEditUndoLine := AStartLine;
    FPendingEditUndoOld := '';
    FPendingEditUndoNew := '';
    CloseFileStreams;
    TEditFileThread.Create(CurrentEffectiveFilePath, otInsert, AStartLine, '',
      True, True, True, False, False, ThreadLines, 1, ABatchKind);
    ThreadLines := nil;
    Result := True;
  finally
    if Assigned(ThreadLines) then
      ThreadLines.Free;
    if not Result then
      FreeAndNil(FPendingBatchInsertLines);
  end;
end;

procedure TfrmMain.ClearUndoRedo;
var
  I: Integer;
begin
  FreeAndNil(FPendingBatchInsertLines);
  FPendingEditUndo := False;
  if FPendingUndoRedo <> purNone then
  begin
    if Assigned(FPendingUndoRedoPartner) then Dispose(FPendingUndoRedoPartner);
    if Assigned(FPendingUndoRedoRestore) then Dispose(FPendingUndoRedoRestore);
    FPendingUndoRedo := purNone;
    FPendingUndoRedoPartner := nil;
    FPendingUndoRedoRestore := nil;
  end;
  if Assigned(FUndoStack) then begin
    for I := 0 to FUndoStack.Count - 1 do Dispose(PUndoRecord(FUndoStack[I]));
    FUndoStack.Clear;
  end;
  if Assigned(FRedoStack) then begin
    for I := 0 to FRedoStack.Count - 1 do Dispose(PUndoRecord(FRedoStack[I]));
    FRedoStack.Clear;
  end;
end;

procedure TfrmMain.PushUndo(const AOp: TOperationType; const ALine: Int64;
  const AOldContent, ANewContent: String);
var
  P: PUndoRecord;
  I: Integer;
begin
  if not Assigned(FUndoStack) then FUndoStack := TList.Create;
  New(P);
  case AOp of
    otInsert: P^.Op := 0;
    otEdit:   P^.Op := 1;
    otDelete: P^.Op := 2;
  else P^.Op := 1;
  end;
  P^.Line := ALine;
  P^.OldContent := AOldContent;
  P^.NewContent := ANewContent;
  P^.BatchKind := 0;
  FUndoStack.Add(P);
  while FUndoStack.Count > 100 do begin
    Dispose(PUndoRecord(FUndoStack[0]));
    FUndoStack.Delete(0);
  end;
  if Assigned(FRedoStack) then begin
    for I := 0 to FRedoStack.Count - 1 do Dispose(PUndoRecord(FRedoStack[I]));
    FRedoStack.Clear;
  end;
end;

procedure TfrmMain.RecordForUndo(const AOp: TOperationType; const ALine: Int64;
  const AOldContent: String; const ANewContent: String);
begin
  PushUndo(AOp, ALine, AOldContent, ANewContent);
end;

function TfrmMain.WhitespaceMarkGlyph(const C: Char): string;
var
  O: Integer;
begin
  case C of
    #9: Result := #187' ';
    ' ': Result := #183;
    #13: Result := #182;
    #10: Result := #172;
    #0: Result := #164;  { NUL -> ¤ (evita ^@ confuso em ficheiros binários) }
  else
    O := Ord(C);
    if O < 32 then
      Result := '^' + Chr(O + 64)
    else
      Result := C;
  end;
end;

function TfrmMain.WhitespaceMarkColor(const C: Char; const NormalFg: TColor): TColor;
begin
  case C of
    #9: Result := FF_CL_MARK_TAB;
    ' ': Result := FF_CL_MARK_SPACE;
    #13: Result := FF_CL_MARK_CR;
    #10: Result := FF_CL_MARK_LF;
    #0: Result := FF_CL_MARK_NUL;
  else
    if Ord(C) < 32 then
      Result := FF_CL_MARK_CTRL
    else
      Result := NormalFg;
  end;
end;

function TfrmMain.FormatWhitespaceMarks(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    Result := Result + WhitespaceMarkGlyph(S[i]);
end;

function TfrmMain.BuildWhitespaceMarksLegendHint: string;
begin
  Result := TrText('Visible marks legend:') + #13#10 +
    '  ' + #187' ' + ' — ' + TrText('Mark legend: Tab') + #13#10 +
    '  ' + #183 + ' — ' + TrText('Mark legend: Space') + #13#10 +
    '  ' + #182 + ' — ' + TrText('Mark legend: CR') + #13#10 +
    '  ' + #172 + ' — ' + TrText('Mark legend: LF') + #13#10 +
    '  ' + #164 + ' — ' + TrText('Mark legend: NUL') + #13#10 +
    '  ^A..^_ — ' + TrText('Mark legend: Other controls') + #13#10 +
    TrText('Mark legend: CR/LF at line end note') + #13#10 +
    TrText('Colors match the list when marks are ON. Shortcut: Ctrl+Alt+M.');
end;

procedure TfrmMain.UpdateWhitespaceMarksLegendHint;
var
  H: string;
begin
  if FShowWhitespaceMarks then
    H := BuildWhitespaceMarksLegendHint
  else
    H := '';
  FWhitespaceMarksLegendHint := H;
  if Assigned(FMenuShowMarksItem) then
    FMenuShowMarksItem.Hint := H;
  if Assigned(FPopupLVShowMarksItem) then
    FPopupLVShowMarksItem.Hint := H;
  EnsureMarksLegendPanel;
  if Assigned(FMarksLegendPanel) then
  begin
    FMarksLegendPanel.Visible := FShowWhitespaceMarks;
    if FShowWhitespaceMarks then
    begin
      FMarksLegendPanel.Height := 22;
      FMarksLegendPanel.Invalidate;
    end
    else
      FMarksLegendPanel.Height := 0;
  end;
  if Assigned(sStatusBar1) then
  begin
    sStatusBar1.ShowHint := FShowWhitespaceMarks and (H <> '');
    sStatusBar1.Hint := H;
  end;
  if Assigned(ListView1) and ListView1.HandleAllocated then
    ListView1.Invalidate;
end;

procedure TfrmMain.DrawWhitespaceMarksOntoCanvas(Canvas: TCanvas; const R: TRect;
  const RawLine: string; Bk, NormalFg: TColor; AllowWrap: Boolean);
var
  i, j, Lim, TH, MaxX, BodyMaxX, X, Y, W, TrailW, OldBkMode: Integer;
  C: Char;
  G: string;
  Fg: TColor;
  Body, Trail: string;

  function MeasureMarkTextWidth(const Text: string): Integer;
  var
    k: Integer;
  begin
    Result := 0;
    for k := 1 to Length(Text) do
      Inc(Result, Canvas.TextWidth(WhitespaceMarkGlyph(Text[k])));
  end;

  procedure DrawMarkChars(const Text: string; var AX, AY: Integer; ForceOnLastRow: Boolean);
  var
    j, W, THL: Integer;
    C2: Char;
    G2: string;
    Fg2: TColor;
  begin
    if Text = '' then Exit;
    THL := Canvas.TextHeight('Wg');
    if THL < 1 then THL := 1;
    for j := 1 to Length(Text) do
    begin
      C2 := Text[j];
      G2 := WhitespaceMarkGlyph(C2);
      Fg2 := WhitespaceMarkColor(C2, NormalFg);
      W := Canvas.TextWidth(G2);
      if AllowWrap then
      begin
        if (AX + W > MaxX) and (AX > R.Left + 2) then
        begin
          AX := R.Left + 2;
          Inc(AY, THL);
          if (AY + THL > R.Bottom - 2) and ForceOnLastRow then
          begin
            AY := Max(R.Top + 2, R.Bottom - THL - 2);
            AX := R.Left + 2;
          end
          else if AY + THL > R.Bottom - 2 then
            Break;
        end;
      end
      else if AX + W > MaxX then
        Break;
      SetTextColor(Canvas.Handle, ColorToRGB(Fg2));
      Windows.TextOut(Canvas.Handle, AX, AY, PChar(G2), Length(G2));
      Inc(AX, W);
    end;
  end;

begin
  if (R.Right <= R.Left + 2) or (R.Bottom <= R.Top + 2) then Exit;
  if Canvas.Handle = 0 then Exit;
  Trail := ExtractTrailingLineBreaks(RawLine);
  Body := StripTrailingLineBreaks(RawLine);
  Canvas.Font.Assign(ListView1.Font);
  Canvas.Brush.Style := bsSolid;
  Canvas.Brush.Color := Bk;
  Canvas.FillRect(R);
  TH := Canvas.TextHeight('Wg');
  if TH < 1 then TH := 1;
  MaxX := R.Right - 2;
  BodyMaxX := MaxX;
  TrailW := 0;
  if (not AllowWrap) and (Trail <> '') then
  begin
    TrailW := MeasureMarkTextWidth(Trail);
    if TrailW > 0 then
    begin
      if TrailW + 12 >= (MaxX - (R.Left + 2)) then
        BodyMaxX := R.Left + 2
      else
        BodyMaxX := MaxX - TrailW - 4;
    end;
  end;
  X := R.Left + 2;
  Y := R.Top + 2;
  Lim := Length(Body);
  if Lim > MAX_MARK_DRAW_CHARS then
    Lim := MAX_MARK_DRAW_CHARS;
  OldBkMode := SetBkMode(Canvas.Handle, TRANSPARENT);
  try
    SelectObject(Canvas.Handle, Canvas.Font.Handle);
    for i := 1 to Lim do
    begin
      C := Body[i];
      G := WhitespaceMarkGlyph(C);
      Fg := WhitespaceMarkColor(C, NormalFg);
      W := Canvas.TextWidth(G);
      if AllowWrap then
      begin
        if (X + W > MaxX) and (X > R.Left + 2) then
        begin
          X := R.Left + 2;
          Inc(Y, TH);
          if Y + TH > R.Bottom - 2 then
            Break;
        end;
      end
      else if X + W > BodyMaxX then
        Break;
      SetTextColor(Canvas.Handle, ColorToRGB(Fg));
      Windows.TextOut(Canvas.Handle, X, Y, PChar(G), Length(G));
      Inc(X, W);
    end;
    { CR/LF no fim da linha logica: sempre visivel (wrap: ultima linha; sem wrap: faixa a direita). }
    if (not AllowWrap) and (Trail <> '') and (TrailW > 0) then
    begin
      X := MaxX - TrailW + 1;
      if X < R.Left + 2 then X := R.Left + 2;
      for j := 1 to Length(Trail) do
      begin
        C := Trail[j];
        G := WhitespaceMarkGlyph(C);
        Fg := WhitespaceMarkColor(C, NormalFg);
        W := Canvas.TextWidth(G);
        if X + W > MaxX + 1 then Break;
        SetTextColor(Canvas.Handle, ColorToRGB(Fg));
        Windows.TextOut(Canvas.Handle, X, Y, PChar(G), Length(G));
        Inc(X, W);
      end;
    end
    else
      DrawMarkChars(Trail, X, Y, True);
  finally
    SetBkMode(Canvas.Handle, OldBkMode);
  end;
end;

function TfrmMain.DrawWhitespaceMarksForListCell(Sender: TCustomListView;
  Item: TListItem; State: TCustomDrawState; const SubItemIndex: Integer;
  ATargetCanvas: TCanvas): Boolean;
var
  R: TRect;
  LineIdx: Integer;
  Col0W, Col1W: Integer;
  IsSel: Boolean;
  Bk, Fg: TColor;
  RawLine: string;
  Skip: Integer;
  DC: HDC;
  FreeCanvas: TCanvas;
  PaintCanvas: TCanvas;
  ReleaseDCNeeded: Boolean;
begin
  Result := False;
  if not FShowWhitespaceMarks then Exit;
  if FCsvMode then Exit;
  if Item = nil then Exit;
  if SubItemIndex <> 1 then Exit;

  LineIdx := FileLineIndexFromListRow(Item.Index);
  if LineIdx < 0 then Exit;

  if FFindMatchSelection and (FLastFoundMatchLen > 0) and (LineIdx = FLastFoundLine) then
    Exit;

  if not ListView_GetSubItemRect(Sender.Handle, Item.Index, SubItemIndex, LVIR_LABEL, @R) then
  begin
    R := Item.DisplayRect(drBounds);
    if ListView1.Columns.Count >= 2 then
    begin
      Col0W := ListView1.Columns[0].Width;
      Col1W := ListView1.Columns[1].Width;
    end
    else
    begin
      Col0W := 0;
      Col1W := R.Right - R.Left;
    end;
    R.Left := Col0W + 1;
    R.Right := R.Left + Col1W - 2;
  end;
  if R.Left < 0 then R.Left := 0;
  if R.Right > ListView1.ClientWidth - 1 then
    R.Right := ListView1.ClientWidth - 1;
  if R.Right <= R.Left + 4 then Exit;

  IsSel := ListViewItemIndexIsSelected(Sender, Item.Index);
  Bk := clWindow;
  Fg := clWindowText;
  if IsBookmarked(LineIdx) then
  begin
    Bk := FF_BOOKMARK_ROW_BG;
    Fg := FF_BOOKMARK_ROW_FG;
  end
  else if FTailActive and (FTailHighlightFromLine > 0) and (LineIdx >= FTailHighlightFromLine) then
  begin
    Bk := FF_TAIL_NEW_ROW_BG;
    Fg := clWindowText;
  end
  else if IsSel then
  begin
    Bk := clHighlight;
    Fg := clHighlightText;
  end;

  RawLine := BuildLineTextForMarksDisplay(LineIdx);
  Skip := ListViewHorizTextSkipChars;
  if Skip > 0 then
  begin
    if Skip >= Length(RawLine) then
      RawLine := ''
    else
      RawLine := Copy(RawLine, Skip + 1, MaxInt);
  end;

  ReleaseDCNeeded := False;
  FreeCanvas := nil;
  if Assigned(ATargetCanvas) and (ATargetCanvas.Handle <> 0) then
    PaintCanvas := ATargetCanvas
  else
  begin
    DC := Windows.GetDC(TWinControl(Sender).Handle);
    if DC = 0 then Exit;
    FreeCanvas := TCanvas.Create;
    try
      FreeCanvas.Handle := DC;
      FreeCanvas.Font.Assign(ListView1.Font);
      PaintCanvas := FreeCanvas;
      ReleaseDCNeeded := True;
    except
      FreeCanvas.Free;
      Windows.ReleaseDC(TWinControl(Sender).Handle, DC);
      raise;
    end;
  end;

  try
    PaintCanvas.Font.Assign(ListView1.Font);
    DrawWhitespaceMarksOntoCanvas(PaintCanvas, R, RawLine, Bk, Fg, FFastVisualWordWrap);
    Result := True;
  finally
    if ReleaseDCNeeded then
    begin
      FreeCanvas.Handle := 0;
      FreeCanvas.Free;
      Windows.ReleaseDC(TWinControl(Sender).Handle, DC);
    end;
  end;
end;

procedure TfrmMain.EnsureMarksLegendPanel;
var
  P: TWinControl;
begin
  if Assigned(FMarksLegendPanel) then Exit;
  if not Assigned(ListView1) or not Assigned(ListView1.Parent) then Exit;
  P := ListView1.Parent;
  FMarksLegendPanel := TPaintBox.Create(Self);
  FMarksLegendPanel.Parent := P;
  FMarksLegendPanel.Align := alTop;
  FMarksLegendPanel.Height := 22;
  FMarksLegendPanel.Color := clBtnFace;
  FMarksLegendPanel.OnPaint := MarksLegendPanelPaint;
  FMarksLegendPanel.Visible := False;
end;

procedure TfrmMain.MarksLegendPanelPaint(Sender: TObject);
var
  Box: TPaintBox;
  C: TCanvas;
  X, Y: Integer;

  procedure DrawSample(const Glyph: string; const CChar: Char; const Caption: string);
  var
    W: Integer;
  begin
    C.Font.Color := WhitespaceMarkColor(CChar, clWindowText);
    C.Font.Style := [fsBold];
    C.TextOut(X, Y, Glyph);
    Inc(X, C.TextWidth(Glyph) + 2);
    C.Font.Color := clWindowText;
    C.Font.Style := [];
    C.TextOut(X, Y, Caption);
    W := C.TextWidth(Caption) + 10;
    Inc(X, W);
  end;

begin
  if not (Sender is TPaintBox) then Exit;
  Box := TPaintBox(Sender);
  C := Box.Canvas;
  C.Brush.Color := Box.Color;
  C.FillRect(Box.ClientRect);
  C.Font.Assign(ListView1.Font);
  C.Font.Size := Max(7, ListView1.Font.Size - 2);
  X := 6;
  Y := 4;
  DrawSample(#187' ', #9, TrText('Mark legend: Tab'));
  DrawSample(#183, ' ', TrText('Mark legend: Space'));
  DrawSample(#182, #13, TrText('Mark legend: CR'));
  DrawSample(#172, #10, TrText('Mark legend: LF'));
  DrawSample(#164, #0, TrText('Mark legend: NUL'));
  C.Font.Color := FF_CL_MARK_CTRL;
  C.Font.Style := [fsBold];
  C.TextOut(X, Y, '^A');
  Inc(X, C.TextWidth('^A') + 2);
  C.Font.Color := clWindowText;
  C.Font.Style := [];
  C.TextOut(X, Y, TrText('Mark legend: Other controls'));
end;

function TfrmMain.IdleLogoBitmapReady: Boolean;
begin
  Result := Assigned(FIdleLogoBitmap) and (FIdleLogoBitmap.Width > 0) and
    (FIdleLogoBitmap.Height > 0);
end;

function TfrmMain.MainWorkspaceShowsIdleLogo: Boolean;
var
  I, VisCount: Integer;
begin
  if not Assigned(pgMain) then
  begin
    Result := True;
    Exit;
  end;
  if not pgMain.Visible then
  begin
    Result := True;
    Exit;
  end;
  VisCount := 0;
  for I := 0 to pgMain.PageCount - 1 do
    if pgMain.Pages[I].TabVisible then
      Inc(VisCount);
  Result := VisCount = 0;
end;

function TfrmMain.GetIdleLogoWorkspaceRect: TRect;
begin
  Result := ClientRect;
  if Assigned(sPageControl1) and sPageControl1.Visible then
    Result.Top := sPageControl1.Top + sPageControl1.Height;
  if Assigned(sPanel3) and sPanel3.Visible then
    Result.Top := sPanel3.Top + sPanel3.Height;
  if Assigned(sStatusBar1) and sStatusBar1.Visible then
    Result.Bottom := sStatusBar1.Top;
  if Assigned(sPanel5) and sPanel5.Visible then
    Result.Bottom := sPanel5.Top;
  { Nao deixar o float da logo cobrir o Assistente IA (alRight + splitter). }
  if (not AssistantPanelIsFloating) then
  begin
    if Assigned(FAssistantSplitter) and FAssistantSplitter.Visible then
      Result.Right := Min(Result.Right, FAssistantSplitter.Left)
    else if Assigned(FAstDock) and FAstDock.Visible and (FAstDock.Parent = Self) then
      Result.Right := Min(Result.Right, FAstDock.Left)
    else if Assigned(FAssistantPanel) and FAssistantPanel.Visible and
            (FAssistantPanel.Parent = Self) then
      Result.Right := Min(Result.Right, FAssistantPanel.Left);
  end;
end;

function TfrmMain.IdleLogoPickTitleFontName: string;
var
  F: TFont;
begin
  Result := 'Tahoma';
  F := TFont.Create;
  try
    F.Name := 'Candara';
    if SameText(F.Name, 'Candara') then
    begin
      Result := 'Candara';
      Exit;
    end;
    F.Name := 'Century Gothic';
    if SameText(F.Name, 'Century Gothic') then
    begin
      Result := 'Century Gothic';
      Exit;
    end;
    F.Name := 'Segoe UI Semibold';
    if SameText(F.Name, 'Segoe UI Semibold') then
      Result := 'Segoe UI Semibold';
  finally
    F.Free;
  end;
end;

procedure TfrmMain.CalcIdleLogoDrawDimensions;
var
  R: TRect;
  MaxDim, BgScale: Double;
  BgW, BgH, AreaW, AreaH, BlockW, BlockH: Integer;
  TmpBmp: TBitmap;
  TitleFontH, FullFontH, SubFontH, TitleW, FullW, SubW: Integer;
  TitleH, FullH, SubH, SubTextH, TextH, Gap1, Gap2, Pad: Integer;
  TitleName, SubName: string;
  SubR: TRect;

  function PickUIFont(const APreferred, AFallback: string): string;
  var
    F: TFont;
  begin
    Result := AFallback;
    F := TFont.Create;
    try
      F.Name := APreferred;
      if SameText(F.Name, APreferred) then
        Result := APreferred;
    finally
      F.Free;
    end;
  end;

begin
  FIdleLogoDrawW := 0;
  FIdleLogoDrawH := 0;
  if not IdleLogoBitmapReady then Exit;
  R := GetIdleLogoWorkspaceRect;
  AreaW := R.Right - R.Left;
  AreaH := R.Bottom - R.Top;
  if (AreaW < 1) or (AreaH < 1) then Exit;

  TitleName := IdleLogoPickTitleFontName;
  SubName := PickUIFont('Segoe UI', 'Tahoma');
  TitleFontH := Max(IDLE_LOGO_TITLE_FONT_MIN,
    Min(IDLE_LOGO_TITLE_FONT_MAX, AreaW div IDLE_LOGO_TITLE_FONT_DIV));
  FullFontH := Max(11, Min(20, AreaW div 32));
  SubFontH := Max(9, Min(15, AreaW div 40));
  Gap1 := Max(3, TitleFontH div 9);
  Gap2 := Max(6, FullFontH div 2);
  Pad := Max(28, TitleFontH div 2);

  TmpBmp := TBitmap.Create;
  try
    TmpBmp.Canvas.Font.Name := TitleName;
    TmpBmp.Canvas.Font.Height := -TitleFontH;
    TmpBmp.Canvas.Font.Style := [];
    TitleW := TmpBmp.Canvas.TextWidth(APPLICATION_NAME);
    TitleH := TitleFontH + 6;

    TmpBmp.Canvas.Font.Height := -FullFontH;
    TmpBmp.Canvas.Font.Style := [fsItalic];
    FullW := TmpBmp.Canvas.TextWidth(APPLICATION_FULLNAME);
    FullH := FullFontH + 4;

    TmpBmp.Canvas.Font.Height := -SubFontH;
    TmpBmp.Canvas.Font.Style := [fsItalic];
    SubR := Rect(0, 0, Max(AreaW div 2, 280), 0);
    DrawText(TmpBmp.Canvas.Handle, PChar(APPLICATION_DEVELOPER), -1, SubR,
      DT_CENTER or DT_WORDBREAK or DT_CALCRECT);
    SubW := SubR.Right - SubR.Left;
    if SubW < 1 then SubW := 1;
    SubTextH := SubR.Bottom - SubR.Top;
    if SubTextH < SubFontH then SubTextH := SubFontH;
    SubH := SubTextH + 4;
  finally
    TmpBmp.Free;
  end;

  TextH := TitleH + Gap1 + FullH + Gap2 + SubH;
  BlockW := Max(Max(TitleW, FullW), SubW) + Pad * 2;
  if BlockW < 220 then BlockW := 220;
  BlockH := TextH + Pad * 2;

  MaxDim := Min(AreaW, AreaH) * IDLE_LOGO_SIZE_FRAC * IDLE_LOGO_BG_SIZE_FRAC;
  if MaxDim > IDLE_LOGO_MAX_PX then
    MaxDim := IDLE_LOGO_MAX_PX;
  if MaxDim < BlockW then
    MaxDim := BlockW;
  if MaxDim < BlockH then
    MaxDim := BlockH;
  BgScale := MaxDim / Max(FIdleLogoBitmap.Width, FIdleLogoBitmap.Height);
  BgW := Round(FIdleLogoBitmap.Width * BgScale);
  BgH := Round(FIdleLogoBitmap.Height * BgScale);
  if BgW < BlockW then BgW := BlockW;
  if BgH < BlockH then BgH := BlockH;
  FIdleLogoDrawW := BgW;
  FIdleLogoDrawH := BgH;
end;

procedure TfrmMain.SyncIdleLogoFloatBounds;
var
  R: TRect;
  AreaW, AreaH, BgW, BgH: Integer;
  Pt: TPoint;
  FormR: TRect;
  Btn: TacFloatBtn;

begin
  if not Assigned(FIdleLogoFloat) or (FIdleLogoFloat.Items.Count < 1) then Exit;
  if not IdleLogoBitmapReady then Exit;
  CalcIdleLogoDrawDimensions;
  BgW := FIdleLogoDrawW;
  BgH := FIdleLogoDrawH;
  if (BgW < 1) or (BgH < 1) then Exit;
  Btn := FIdleLogoFloat.Items[0];
  R := GetIdleLogoWorkspaceRect;
  AreaW := R.Right - R.Left;
  AreaH := R.Bottom - R.Top;

  Btn.AutoSize := False;
  Btn.Width := BgW;
  Btn.Height := BgH;
  Btn.AlignHorz := taCenter;
  Btn.AlignVert := vaAlignTop;
  Btn.OffsetX := 0;
  Pt := ClientToScreen(Point(R.Left + (AreaW - BgW) div 2, R.Top + (AreaH - BgH) div 2));
  GetWindowRect(Handle, FormR);
  Btn.OffsetY := Pt.Y - FormR.Top;
end;

procedure IdleLogoFillBmpHorizontalGradient(Bmp: TBitmap; ColorLeft, ColorRight: TColor; Alpha: Byte);
var
  X, Y, W, Rl, Gl, Bl, Rr, Gr, Br: Integer;
  P: PRGBQuad;
  T: Double;
  R, G, B: Byte;
  BaseR, BaseG, BaseB: Integer;
  Frac: Double;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  if Alpha = 0 then Exit;
  Bmp.PixelFormat := pf32bit;
  Rl := GetRValue(ColorLeft);
  Gl := GetGValue(ColorLeft);
  Bl := GetBValue(ColorLeft);
  Rr := GetRValue(ColorRight);
  Gr := GetGValue(ColorRight);
  Br := GetBValue(ColorRight);
  W := Bmp.Width;
  if W < 2 then
    W := 2;
  if Alpha >= 255 then
    Frac := 1
  else
    Frac := Alpha / 255;
  BaseR := 255;
  BaseG := 255;
  BaseB := 255;
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      T := X / (W - 1);
      R := Byte(Round(BaseR * (1 - Frac) + (Rl * (1 - T) + Rr * T) * Frac));
      G := Byte(Round(BaseG * (1 - Frac) + (Gl * (1 - T) + Gr * T) * Frac));
      B := Byte(Round(BaseB * (1 - Frac) + (Bl * (1 - T) + Br * T) * Frac));
      P^.rgbRed := R;
      P^.rgbGreen := G;
      P^.rgbBlue := B;
      P^.rgbReserved := 255;
      Inc(P);
    end;
  end;
end;

procedure TfrmMain.EnsureIdleLogoBgFloat;
var
  Btn: TacFloatBtn;
begin
  if Assigned(FIdleLogoBgFloat) then Exit;
  FIdleLogoBgFloat := TsFloatButtons.Create(Self);

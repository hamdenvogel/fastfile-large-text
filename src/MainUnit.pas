procedure TfrmMain.CompareMergeFileHook(const APath: string; AStage: Integer);
var
  Cur: string;
begin
  Cur := Trim(CurrentEffectiveFilePath);
  if (Cur = '') or (Trim(APath) = '') then Exit;
  if not AnsiSameText(ExpandFileName(Cur), ExpandFileName(Trim(APath))) then Exit;
  { Merge do diff: so' a troca do ficheiro (ReplaceFile) exige libertar o handle;
    edicoes do mesmo tamanho mantem o indice e dispensam a reindexacao. }
  case AStage of
    cFFMergeHookRelease:
      CloseFileStreams;
    cFFMergeHookRepaint:
      ApplyMetadataOnlyPostEdit(0);
  else
    RequestPostEditRefresh;
  end;
end;

procedure TfrmMain.NotifyHistoryTouched(const ADataPath: string);
var
  MergeFrm: TfrmCompareMerge;
begin
  if Trim(ADataPath) = '' then Exit;
  if not Assigned(FCompareMergeHosted) then Exit;
  MergeFrm := TfrmCompareMerge(FCompareMergeHosted);
  MergeFrm.NotifyExternalHistoryTouch(ADataPath);
end;

procedure TfrmMain.OpenMergeFilesTab(const AHintPath: string; AMergeMode: Integer;
  AAfterLine: Integer);
var
  Cur, DestFileName, SrcPrefill, HintPath, Part1: String;
  Dir, Stem, Ext: string;
  PartNum: Integer;
  Frm: TMergeFilesDialogForm;
begin
  EnsureReadTabVisible;

  HintPath := Trim(AHintPath);
  Cur := Trim(edtFileName.Text);
  if (Cur = SELECTTEXT) or (not FileExists(Cur)) then
    Cur := '';

  DestFileName := '';
  SrcPrefill := '';

  if HintPath <> '' then
  begin
    if TryParseEqualSplitPartPath(HintPath, Dir, Stem, Ext, PartNum) then
    begin
      SrcPrefill := ExpandFileName(HintPath);
      DestFileName := SuggestJoinPartsDestPath(Dir, Stem, Ext);
    end
    else
    begin
      Dir := IncludeTrailingPathDelimiter(ExtractFilePath(ExpandFileName(HintPath)));
      if Dir = '\' then
        Dir := IncludeTrailingPathDelimiter(ExtractFilePath(HintPath));
      Stem := ChangeFileExt(ExtractFileName(HintPath), '');
      Ext := ExtractFileExt(HintPath);
      Part1 := Dir + Stem + Format('.part%.3d', [1]) + Ext;
      if FileExists(Part1) then
      begin
        SrcPrefill := Part1;
        DestFileName := SuggestJoinPartsDestPath(Dir, Stem, Ext);
      end
      else
        DestFileName := ExpandFileName(HintPath);
    end;
  end
  else if Cur <> '' then
  begin
    if TryParseEqualSplitPartPath(Cur, Dir, Stem, Ext, PartNum) then
    begin
      SrcPrefill := Cur;
      DestFileName := SuggestJoinPartsDestPath(Dir, Stem, Ext);
    end
    else
    begin
      Dir := IncludeTrailingPathDelimiter(ExtractFilePath(Cur));
      Stem := ChangeFileExt(ExtractFileName(Cur), '');
      Ext := ExtractFileExt(Cur);
      Part1 := Dir + Stem + Format('.part%.3d', [1]) + Ext;
      if FileExists(Part1) then
      begin
        SrcPrefill := Part1;
        DestFileName := SuggestJoinPartsDestPath(Dir, Stem, Ext);
      end
      else
        DestFileName := Cur;
    end;
  end;

  ShowTab(tabMergeFiles);
  EnsureMergeFilesTab;
  if not Assigned(FMergeFilesHosted) then Exit;
  Frm := TMergeFilesDialogForm(FMergeFilesHosted);
  Frm.Hint := DestFileName;
  if Assigned(Frm.EdtDest) then
    Frm.EdtDest.Text := DestFileName;
  if Assigned(Frm.ChkSelfMerge) then
  begin
    Frm.ChkSelfMerge.Checked := SrcPrefill = '';
    MergeFilesSelfMergeToggleClick(Frm.ChkSelfMerge);
  end;
  if (SrcPrefill <> '') and Assigned(Frm.EdtSource) then
    Frm.EdtSource.Text := SrcPrefill;
  if (AMergeMode >= 0) and (AMergeMode <= 2) and Assigned(Frm.RgMode) then
    Frm.RgMode.ItemIndex := AMergeMode;
  if Assigned(Frm.SpnLine) then
  begin
    if AAfterLine < 1 then
      AAfterLine := 1;
    if AAfterLine > Frm.SpnLine.MaxValue then
      Frm.SpnLine.MaxValue := AAfterLine;
    Frm.SpnLine.Value := AAfterLine;
  end;
end;


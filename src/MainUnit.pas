  begin
    FTailMacroEnabledCB.Checked := True;
    TailMacroEnabledCBClick(FTailMacroEnabledCB);
  end;
  SaveTailMacroSettings;
  if Assigned(FTailMacroEditorMemo) and FTailMacroEditorMemo.Visible and
     FTailMacroEditorMemo.Enabled and FTailMacroEditorMemo.CanFocus then
    FTailMacroEditorMemo.SetFocus;
end;

procedure TfrmMain.TailMacroSuggestionsLoadContent;
begin
  if not Assigned(FTailMacroSuggestionsMemo) then Exit;
  FTailMacroSuggestionsMemo.Lines.Text :=
    TrText('Tail macro examples intro') + CRLF +
    TrText('Tail macro examples doc') + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_01') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return line.upper()' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_02') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    n = ctx[''line_number'']' + CRLF +
    '    return f"[{n:06d}] {line}"' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_03') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    if line.strip() == '''':' + CRLF +
    '        return None  # blank line -> SKIP' + CRLF +
    '    return line' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_04') + CRLF +
    'KEYWORD = ''error''' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return line if KEYWORD.lower() in line.lower() else None' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_05') + CRLF +
    'import re' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return re.sub(r'' {2,}'', '' '', line.strip())' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_06') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    parts = line.split('';'')' + CRLF +
    '    if len(parts) < 3:' + CRLF +
    '        return None  # invalid -> skip' + CRLF +
    '    name, date, value = parts[0], parts[1], parts[2]' + CRLF +
    '    return f"{name.strip()} | {date.strip()} | R$ {value.strip()}"' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_07') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    words = line.split()' + CRLF +
    '    return f"{len(words):3d} words: {line}"' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_08') + CRLF +
    'REPLACEMENTS = {''error'': ''ERROR'', ''warning'': ''WARNING'', ''info'': ''INFO''}' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    result = line' + CRLF +
    '    for old, new in REPLACEMENTS.items():' + CRLF +
    '        result = result.replace(old, new)' + CRLF +
    '    return result' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_09') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    count = ctx.get(''count'', 0) + 1' + CRLF +
    '    ctx[''count''] = count' + CRLF +
    '    return f"#{count} {line}"' + CRLF +
    CRLF + FF_TAIL_MACRO_LOAD_SEP +
    TrText('PY_MACRO_EX_10_TAIL') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return line if ''ERROR'' in line else None' + CRLF;
end;

procedure TfrmMain.RecordTailMacroResult(const AText: string);
var
  OutPath: string;
  I: Integer;
  W: TFileStream;
  LineAnsi: AnsiString;
  StoreText: string;
begin
  if FApplicationClosing then Exit;
  if Trim(AText) = '' then Exit;
  StoreText := AText;
  if Length(StoreText) > MAX_STORED_LINE_LEN then
    StoreText := Copy(StoreText, 1, MAX_STORED_LINE_LEN) + '...';
  if Assigned(FTailMacroResultLines) then
  begin
    if FTailMacroResultLines.Count >= MAX_STORED then
      for I := 1 to 1000 do
        if FTailMacroResultLines.Count > 0 then
          FTailMacroResultLines.Delete(0);
    FTailMacroResultLines.Add(StoreText);
  end;
  if FTailMacroSaveResultsToFile and (not FTailMacroSilentOutMode) then
  begin
    OutPath := Trim(FTailMacroResultsPath);
    if OutPath = '' then
      OutPath := FTailMacroDirectOutPath;
    if OutPath = '' then
    begin
      OutPath := SuggestTailMacroResultsPath;
      FTailMacroResultsPath := OutPath;
      if Assigned(FTailMacroResultsPathEdt) then
        FTailMacroResultsPathEdt.Text := OutPath;
    end;
    try
      LineAnsi := DisplayStringToFileBytes(StoreText, FTailMacroFileEncoding);
      if LineAnsi <> '' then
        LineAnsi := LineAnsi + AnsiString(sLineBreak);
      if Length(LineAnsi) > 0 then
      begin
        if Assigned(FTailMacroResultsStream) then
          FTailMacroResultsStream.WriteBuffer(Pointer(LineAnsi)^, Length(LineAnsi))
        else
        begin
          if FileExists(OutPath) then
            W := TFileStream.Create(OutPath, fmOpenWrite or fmShareDenyNone)
          else
            W := TFileStream.Create(OutPath, fmCreate or fmShareDenyNone);
          try
            W.Seek(0, soFromEnd);
            W.WriteBuffer(Pointer(LineAnsi)^, Length(LineAnsi));
          finally
            W.Free;
          end;
        end;
      end;
    except
    end;
  end;
  if not FTailMacroShowInPanel then Exit;
  if not Assigned(FTailMacroOutputMemo) then Exit;
  FTailMacroOutputMemo.Lines.BeginUpdate;
  try
    if FTailMacroOutputMemo.Lines.Count >= MAX_UI then
      while FTailMacroOutputMemo.Lines.Count > (MAX_UI - UI_TRIM) do
        FTailMacroOutputMemo.Lines.Delete(0);
    FTailMacroOutputMemo.Lines.Add(StoreText);
  finally
    FTailMacroOutputMemo.Lines.EndUpdate;
  end;
  if (FTailMacroOutputMemo.Handle <> 0) and IsWindow(FTailMacroOutputMemo.Handle) then
    SendMessage(FTailMacroOutputMemo.Handle, WM_VSCROLL, SB_BOTTOM, 0);
end;

procedure TfrmMain.AppendTailMacroOutput(const AText: string);
begin
  RecordTailMacroResult(AText);
end;

procedure TfrmMain.AppendTailMacroResultsToExportFile(const AExportPath: string);
var
  SL: TStringList;
  I, StartIdx: Integer;
  W: TFileStream;
  Chunk: AnsiString;
  LineAnsi: AnsiString;
  Sep: AnsiString;
begin
  TailMacroSyncEnabledFromUI;
  if not (FTailMacroEnabled and FTailMacroIncludeInExport) then Exit;
  if not Assigned(FTailMacroResultLines) then Exit;
  if FTailMacroResultLines.Count <= 0 then Exit;
  if not FileExists(AExportPath) then Exit;
  Sep := AnsiString(sLineBreak + '--- ' + TrText('Macro results') + ' ---' + sLineBreak);
  try
    W := TFileStream.Create(AExportPath, fmOpenReadWrite or fmShareDenyNone);
    try
      W.Seek(0, soFromEnd);
      if Length(Sep) > 0 then
        W.WriteBuffer(Pointer(Sep)^, Length(Sep));
      if FTailMacroResultLines.Count > MAX_UI then
        StartIdx := FTailMacroResultLines.Count - MAX_UI
      else
        StartIdx := 0;
      for I := StartIdx to FTailMacroResultLines.Count - 1 do
      begin
        LineAnsi := DisplayStringToFileBytes(FTailMacroResultLines[I], FTailMacroFileEncoding);
        if LineAnsi <> '' then
          LineAnsi := LineAnsi + AnsiString(sLineBreak);
        if Length(LineAnsi) > 0 then
          W.WriteBuffer(Pointer(LineAnsi)^, Length(LineAnsi));
      end;
    finally
      W.Free;
    end;
  except
    SL := TStringList.Create;
    try
      if FileExists(AExportPath) then
        SL.LoadFromFile(AExportPath);
      SL.Add('');
      SL.Add('--- ' + TrText('Macro results') + ' ---');
      if FTailMacroResultLines.Count > MAX_UI then
        StartIdx := FTailMacroResultLines.Count - MAX_UI
      else
        StartIdx := 0;
      for I := StartIdx to FTailMacroResultLines.Count - 1 do
        SL.Add(FTailMacroResultLines[I]);
      SL.SaveToFile(AExportPath);
    finally
      SL.Free;
    end;
  end;
end;

procedure TfrmMain.UpdateTailMacroStatus(const AText: string);
begin
  if FApplicationClosing then Exit;
  if not Assigned(FTailMacroStatusLabel) then Exit;
  if not AppUiUpdatesAllowed then Exit;
  FTailMacroStatusLabel.Caption := AText;
end;

procedure TfrmMain.HandleTailMacroProtocolLine(const ALine: string);
var
  Colon1, Colon2: Integer;
  Text: string;
  Pct: Integer;
begin
  if ALine = 'COMPILED_OK' then
  begin
    FTailMacroAwaitingCompile := False;
    TailMacroLog(TrText('Tail macro: compiled OK'));
    Exit;
  end;
  if Copy(ALine, 1, 14) = 'COMPILE_ERROR:' then
  begin
    FTailMacroAwaitingCompile := False;
    FTailMacroAwaitingDone := False;
    AppendTailMacroUiMessage('[COMPILE ERROR] ' + Copy(ALine, 15, MaxInt));
    UpdateTailMacroStatus(TrText('Tail macro: compile error'));
    EndTailMacroBatch(TrText('Tail macro: compile error'));
    Exit;
  end;
  if Copy(ALine, 1, 11) = 'DONE_STATS:' then
  begin
    Text := Copy(ALine, 12, MaxInt);
    Colon1 := PosBMH(':', Text);
    Colon2 := 0;
    if Colon1 > 0 then
      Colon2 := PosEx(':', Text, Colon1 + 1);
    if (Colon1 > 0) and (Colon2 > Colon1) then
    begin
      FTailMacroOkLines := StrToInt64Def(Copy(Text, 1, Colon1 - 1), 0);
      FTailMacroSkipLines := StrToInt64Def(Copy(Text, Colon1 + 1, Colon2 - Colon1 - 1), 0);
      FTailMacroErrLines := StrToInt64Def(Copy(Text, Colon2 + 1, MaxInt), 0);
    end;
    Exit;
  end;
  if Copy(ALine, 1, 9) = 'PROGRESS:' then
  begin
    Text := Copy(ALine, 10, MaxInt);
    Colon1 := PosBMH(':', Text);
    if Colon1 > 0 then
    begin
      Pct := StrToIntDef(Copy(Text, 1, Colon1 - 1), 0);
      UpdateTailMacroStatus(Copy(Text, Colon1 + 1, MaxInt) + ' (' + IntToStr(Pct) + '%)');
    end
    else
      UpdateTailMacroStatus(Text);
    Exit;
  end;
  if ALine = 'DONE_ACK' then
  begin
    FTailMacroAwaitingDone := False;
    EndTailMacroBatch('');
    Exit;
  end;
  if Copy(ALine, 1, 4) = 'OUT:' then
  begin
    Colon1 := PosBMH(':', ALine);
    Colon2 := PosEx(':', ALine, Colon1 + 1);
    if Colon2 > 0 then Text := Copy(ALine, Colon2 + 1, MaxInt)
    else Text := Copy(ALine, Colon1 + 1, MaxInt);
    Inc(FTailMacroOkLines);
    AppendTailMacroOutput(Text);
    Exit;
  end;
  if Copy(ALine, 1, 5) = 'SKIP:' then
  begin
    Inc(FTailMacroSkipLines);
    Exit;
  end;
  if Copy(ALine, 1, 11) = 'LINE_ERROR:' then
  begin
    Colon1 := PosBMH(':', ALine);
    Colon2 := PosEx(':', ALine, Colon1 + 1);
    if Colon2 > 0 then
      Text := Copy(ALine, Colon2 + 1, MaxInt)
    else
      Text := Copy(ALine, Colon1 + 1, MaxInt);
    Inc(FTailMacroErrLines);
    AppendTailMacroUiMessage('[LINE ERROR] ' + Text);
    Exit;
  end;
  if Copy(ALine, 1, 7) = 'STATUS:' then
    UpdateTailMacroStatus(Copy(ALine, 8, MaxInt));
end;

procedure TfrmMain.BeginTailMacroBatch(AThread: TThread);
begin
  if FApplicationClosing then Exit;
  FTailMacroFileEncoding := EffectiveDisplayEncoding;
  FTailMacroRunThread := AThread;
  FTailMacroProcessing := True;
  FTailMacroOkLines := 0;
  FTailMacroSkipLines := 0;
  FTailMacroErrLines := 0;
  TfrmSmoothLoading.ResetCancel;
  if not FTailMacroSessionActive then
  begin
    FTailMacroSessionOkLines := 0;
    FTailMacroSessionSkipLines := 0;
    FTailMacroSessionErrLines := 0;
    FTailMacroSessionActive := True;
  end;
  BeginTailMacroResultsStream;
  UpdateTailMacroStatus(TrText('Tail macro: processing new lines...'));
end;

procedure TfrmMain.EndTailMacroSendPhase(const AError: string);
begin
  FTailMacroRunThread := nil;
  if AError <> '' then
    EndTailMacroBatch(AError);
end;

procedure TfrmMain.EndTailMacroBatch(const AError: string);
var
  Summary: string;
  SavedTail: string;
begin
  FTailMacroAwaitingDone := False;
  FTailMacroProcessing := False;
  FTailMacroRunThread := nil;
  if FApplicationClosing then
  begin
    EndTailMacroResultsStream;
    FTailMacroPendingActive := False;
    FTailMacroSessionActive := False;
    FTailMacroSilentOutMode := False;
    Exit;
  end;
  TfrmSmoothLoading.HideLoading;
  EndTailMacroResultsStream;
  if AError <> '' then
  begin
    FTailMacroPendingActive := False;
    FTailMacroSessionActive := False;
    FTailMacroSilentOutMode := False;
    AppendTailMacroUiMessage('[ERROR] ' + AError);
    UpdateTailMacroStatus(AError);
    FlushTailMacroOutputPanel;
    Application.ProcessMessages;
    Exit;
  end;

  Inc(FTailMacroSessionOkLines, FTailMacroOkLines);
  Inc(FTailMacroSessionSkipLines, FTailMacroSkipLines);
  Inc(FTailMacroSessionErrLines, FTailMacroErrLines);
  ImportTailMacroSilentOutPreview;

  if FTailMacroPendingActive then
  begin
    UpdateTailMacroStatus(Format(TrText('Tail macro: chunk done, %d OK - next chunk...'),
      [FTailMacroOkLines]));
    Application.ProcessMessages;
    ProcessTailMacroPendingQueue;
    Exit;
  end;

  FTailMacroSessionActive := False;
  FTailMacroSilentOutMode := False;
  Summary := Format(TrText('Tail macro done: %d OK, %d skipped, %d errors.'),
    [FTailMacroSessionOkLines, FTailMacroSessionSkipLines, FTailMacroSessionErrLines]);
  AppendTailMacroUiMessage('--- ' + Summary + ' ---');
  UpdateTailMacroStatus(Summary);
  FlushTailMacroOutputPanel;
  SavedTail := Trim(FTailMacroDirectOutPath);
  if SavedTail = '' then
    SavedTail := Trim(FTailMacroResultsPath);
  if (SavedTail <> '') and FileExists(SavedTail) then
    NotifyChatFileSaved(FTailMacroPanel, SavedTail);
  Application.ProcessMessages;
end;

procedure TfrmMain.FlushTailMacroOutputPanel;
var
  I, StartIdx: Integer;
begin
  if FApplicationClosing then Exit;
  TailMacroSyncEnabledFromUI;
  if not FTailMacroShowInPanel then Exit;
  if not Assigned(FTailMacroOutputMemo) then Exit;
  if not Assigned(FTailMacroResultLines) then Exit;
  FTailMacroOutputMemo.Lines.BeginUpdate;
  try
    FTailMacroOutputMemo.Lines.Clear;
    if FTailMacroResultLines.Count > MAX_UI then
      StartIdx := FTailMacroResultLines.Count - MAX_UI
    else
      StartIdx := 0;
    for I := StartIdx to FTailMacroResultLines.Count - 1 do
      FTailMacroOutputMemo.Lines.Add(FTailMacroResultLines[I]);
    while FTailMacroOutputMemo.Lines.Count > MAX_UI do
      FTailMacroOutputMemo.Lines.Delete(0);
  finally
    FTailMacroOutputMemo.Lines.EndUpdate;
  end;
  if (FTailMacroOutputMemo.Handle <> 0) and IsWindow(FTailMacroOutputMemo.Handle) then
    SendMessage(FTailMacroOutputMemo.Handle, WM_VSCROLL, SB_BOTTOM, 0);
end;

procedure TfrmMain.LoadTailMacroSettings;
var
  Ini: TIniFile;
  S: string;
begin
  Ini := TIniFile.Create(IniName);
  try
    FTailMacroEnabled := Ini.ReadBool('TailMacro', 'Enabled', False);
    FTailMacroShowInPanel := Ini.ReadBool('TailMacro', 'ShowInPanel', True);
    FTailMacroIncludeInExport := Ini.ReadBool('TailMacro', 'IncludeInExport', False);
    FTailMacroSaveResultsToFile := Ini.ReadBool('TailMacro', 'SaveToFile', False);
    FTailMacroResultsPath := Ini.ReadString('TailMacro', 'ResultsPath', '');
    S := Ini.ReadString('TailMacro', 'Script', '');
    if (S <> '') and Assigned(FTailMacroEditorMemo) then
      FTailMacroEditorMemo.Lines.Text := S;
  finally
    Ini.Free;
  end;
  if FTailMacroResultsPath = '' then
    FTailMacroResultsPath := SuggestTailMacroResultsPath;
  if Assigned(FTailMacroEnabledCB) then
    FTailMacroEnabledCB.Checked := FTailMacroEnabled;
  if Assigned(FTailMacroShowInPanelCB) then
    FTailMacroShowInPanelCB.Checked := FTailMacroShowInPanel;
  if Assigned(FTailMacroIncludeInExportCB) then
    FTailMacroIncludeInExportCB.Checked := FTailMacroIncludeInExport;
  if Assigned(FTailMacroSaveResultsCB) then
    FTailMacroSaveResultsCB.Checked := FTailMacroSaveResultsToFile;
  if Assigned(FTailMacroResultsPathEdt) then
    FTailMacroResultsPathEdt.Text := FTailMacroResultsPath;
end;

procedure TfrmMain.SaveTailMacroSettings;
var
  Ini: TIniFile;
begin
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteBool('TailMacro', 'Enabled', FTailMacroEnabled);
    Ini.WriteBool('TailMacro', 'ShowInPanel', FTailMacroShowInPanel);
    Ini.WriteBool('TailMacro', 'IncludeInExport', FTailMacroIncludeInExport);
    Ini.WriteBool('TailMacro', 'SaveToFile', FTailMacroSaveResultsToFile);
    Ini.WriteString('TailMacro', 'ResultsPath', FTailMacroResultsPath);
    if Assigned(FTailMacroEditorMemo) then
      Ini.WriteString('TailMacro', 'Script', FTailMacroEditorMemo.Lines.Text);
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.QueueTailMacroLines(AFirstLine1, ALastLine1: Int64);
begin
  if ALastLine1 < AFirstLine1 then Exit;
  if not FTailMacroPendingActive then
  begin
    FTailMacroPendingFrom1 := AFirstLine1;
    FTailMacroPendingTo1 := ALastLine1;
    FTailMacroPendingActive := True;
  end
  else
  begin
    if AFirstLine1 < FTailMacroPendingFrom1 then
      FTailMacroPendingFrom1 := AFirstLine1;
    if ALastLine1 > FTailMacroPendingTo1 then
      FTailMacroPendingTo1 := ALastLine1;
  end;
end;

procedure TfrmMain.ProcessTailMacroPendingQueue;
var
  From1, To1: Int64;
begin
  if not FTailMacroPendingActive then Exit;
  if not TailMacroShouldProcessNewLines then
  begin
    FTailMacroPendingActive := False;
    Exit;
  end;
  From1 := FTailMacroPendingFrom1;
  To1 := FTailMacroPendingTo1;
  FTailMacroPendingActive := False;
  RunTailMacroOnNewLines(From1, To1, True);
end;

function TfrmMain.PrepareTailMacroSilentOutPath: string;
begin
  Result := Trim(FTailMacroResultsPath);
  if Result <> '' then Exit;
  Result := SuggestTailMacroResultsPath;
  FTailMacroResultsPath := Result;
  if Assigned(FTailMacroResultsPathEdt) then
    FTailMacroResultsPathEdt.Text := Result;
end;

procedure TfrmMain.BeginTailMacroResultsStream;
var
  OutPath: string;
begin
  EndTailMacroResultsStream;
  if FTailMacroSilentOutMode then Exit;
  if not FTailMacroSaveResultsToFile then Exit;
  OutPath := PrepareTailMacroSilentOutPath;
  if OutPath = '' then Exit;
  try
    if FileExists(OutPath) then
      FTailMacroResultsStream := TFileStream.Create(OutPath,
        fmOpenWrite or fmShareDenyNone)
    else
      FTailMacroResultsStream := TFileStream.Create(OutPath,
        fmCreate or fmShareDenyNone);
    FTailMacroResultsStream.Seek(0, soFromEnd);
  except
    FreeAndNil(FTailMacroResultsStream);
  end;
end;

procedure TfrmMain.EndTailMacroResultsStream;
begin
  FreeAndNil(FTailMacroResultsStream);
end;

procedure TfrmMain.ImportTailMacroSilentOutPreview;
var
  SL: TStringList;
  F: TFileStream;
  Buf: AnsiString;
  I, ReadPos, ReadN, StartIdx: Integer;
  Path: string;
begin
  if not FTailMacroSilentOutMode then Exit;
  if not FTailMacroShowInPanel then Exit;
  if not Assigned(FTailMacroResultLines) then Exit;
  Path := Trim(FTailMacroDirectOutPath);
  if (Path = '') or (not FileExists(Path)) then Exit;
  SL := TStringList.Create;
  try
    F := TFileStream.Create(Path, fmOpenRead or fmShareDenyNone);
    try
      if F.Size > TAIL_READ_BYTES then
        ReadPos := F.Size - TAIL_READ_BYTES
      else
        ReadPos := 0;
      F.Seek(ReadPos, soFromBeginning);
      SetLength(Buf, F.Size - ReadPos);
      ReadN := F.Read(Pointer(Buf)^, Length(Buf));
      SetLength(Buf, ReadN);
    finally
      F.Free;
    end;
    SL.Text := string(Buf);
    while SL.Count > MAX_PREVIEW_LINES do
      SL.Delete(0);
    StartIdx := 0;
    if FTailMacroResultLines.Count > MAX_PREVIEW_LINES then
      StartIdx := FTailMacroResultLines.Count - MAX_PREVIEW_LINES;
    for I := StartIdx to FTailMacroResultLines.Count - 1 do
      SL.Insert(0, FTailMacroResultLines[I]);
    FTailMacroResultLines.Assign(SL);
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.RunTailMacroOnNewLines(AFirstLine1, ALastLine1: Int64;
  ARequireTailActive: Boolean);
var
  ScriptSrc, B64Script: string;
  SrcBytes: AnsiString;
  N, I2: Integer;
  B1, B2, B3: Byte;
  IndexPath, Enc, SilentOut: string;
  LineCount, ChunkTo1, FileTotal: Int64;
  SendScript, UseRunFile: Boolean;
begin
  if FApplicationClosing then Exit;
  EnsureTailMacroPanel;
  TailMacroSyncEnabledFromUI;
  if ARequireTailActive then
  begin
    if not TailMacroShouldProcessNewLines then Exit;
  end
  else if not FTailMacroEnabled then
    Exit;
  ResetTailMacroBusyStateIfStale;
  if not Assigned(FTailMacroEditorMemo) then Exit;
  if TailMacroScriptIsStubOnly then Exit;
  if ALastLine1 < AFirstLine1 then Exit;
  if CurrentEffectiveFilePath = '' then Exit;

  LineCount := ALastLine1 - AFirstLine1 + 1;
  if FTailMacroProcessing or Assigned(FTailMacroRunThread) or
     Assigned(FScriptEngineRunThread) then
  begin
    QueueTailMacroLines(AFirstLine1, ALastLine1);
    UpdateTailMacroStatus(Format(TrText('Tail macro: %d lines queued...'),
      [LineCount]));
    Exit;
  end;

  ChunkTo1 := ALastLine1;
  if LineCount > TAIL_MACRO_CHUNK_MAX_LINES then
  begin
    ChunkTo1 := AFirstLine1 + TAIL_MACRO_CHUNK_MAX_LINES - 1;
    QueueTailMacroLines(ChunkTo1 + 1, ALastLine1);
    UpdateTailMacroStatus(Format(TrText('Tail macro: processing %d of %d lines (chunked)...'),
      [TAIL_MACRO_CHUNK_MAX_LINES, LineCount]));
  end;

  LineCount := ChunkTo1 - AFirstLine1 + 1;
  UseRunFile := LineCount > uTailMacro.TAIL_MACRO_PIPE_MAX_LINES;
  FTailMacroSilentOutMode := UseRunFile or (LineCount > 1000);
  if FTailMacroSilentOutMode then
    SilentOut := PrepareTailMacroSilentOutPath
  else
  begin
    SilentOut := '';
    if FTailMacroSaveResultsToFile then
      PrepareTailMacroSilentOutPath;
  end;
  FTailMacroDirectOutPath := SilentOut;

  FileTotal := totalLines;
  if FileTotal <= 0 then
    FileTotal := IndexFileLineCount;

  ScriptSrc := EnsurePythonStdImports(
    EnsurePythonTransformIndent(FTailMacroEditorMemo.Lines.Text));
  SrcBytes := UTF8Encode(ScriptSrc);
  N := Length(SrcBytes);
  B64Script := '';
  I2 := 1;
  while I2 <= N do
  begin
    B1 := Ord(SrcBytes[I2]); Inc(I2);
    if I2 <= N then begin B2 := Ord(SrcBytes[I2]); Inc(I2); end else B2 := 0;
    if I2 <= N then begin B3 := Ord(SrcBytes[I2]); Inc(I2); end else B3 := 0;
    B64Script := B64Script +
      B64Chars[((B1 shr 2) and $3F) + 1] +
      B64Chars[(((B1 and $03) shl 4) or ((B2 shr 4) and $0F)) + 1] +
      B64Chars[(((B2 and $0F) shl 2) or ((B3 shr 6) and $03)) + 1] +
      B64Chars[(B3 and $3F) + 1];
  end;
  case N mod 3 of
    1: begin B64Script[Length(B64Script) - 1] := '='; B64Script[Length(B64Script)] := '='; end;
    2: B64Script[Length(B64Script)] := '=';
  end;

  IndexPath := TailMacroIndexFilePath;
  Enc := EffectiveDisplayEncoding;
  SendScript := (B64Script <> FTailMacroLastScriptB64);
  if SendScript then
    FTailMacroLastScriptB64 := B64Script;
  if (IndexPath = '') or (not FileExists(IndexPath)) then
  begin
    TailMacroLog(TrText('Tail macro: line index not found - read the file (F5) first.'));
    Exit;
  end;
  TailMacroLog(Format(TrText('Tail macro: running on lines %d-%d...'),
    [AFirstLine1, ChunkTo1]));
  if not EnsureTailMacroScriptEngine then
  begin
    TailMacroLog(TrText('Tail macro: Python plugin ScriptEngine.exe not found or failed to start.'));
    Exit;
  end;
  if UseRunFile then
    TTailMacroOnNewLinesThread.Create(Self, B64Script, SendScript, True,
      AFirstLine1, ChunkTo1, FileTotal, CurrentEffectiveFilePath, IndexPath, Enc,
      SilentOut)
  else
  begin
    if not ExecuteTailMacroLinePipeSync(B64Script, SendScript, AFirstLine1, ChunkTo1) then
      UpdateTailMacroStatus(TrText('Tail macro: run failed (see output).'));
    ProcessTailMacroPendingQueue;
  end;
end;

function TailMacroTryReadIndexOffset(AIndex: TFileStream; ALine1: Int64;
  out AOff: Int64): Boolean;
var
  Buf: array[0..17] of AnsiChar;
  S: AnsiString;
  N: Integer;
begin
  Result := False;
  AOff := 0;
  if not Assigned(AIndex) then Exit;
  try
    AIndex.Seek((ALine1 - 1) * 20, soFromBeginning);
    N := AIndex.Read(Buf, SizeOf(Buf));
    if N < SizeOf(Buf) then Exit;
    SetString(S, PAnsiChar(@Buf[0]), SizeOf(Buf));
    AOff := StrToInt64Def(Trim(string(S)), -1);
    if AOff = -1 then Exit;
    AOff := Abs(AOff);
    Result := True;
  except
    Result := False;
  end;
end;

function TfrmMain.TailMacroReadLineText(const AIndexPath, ASourcePath, AEnc: string;
  ALineNumber1Based: Int64): string;
var
  Src, Idx: TFileStream;
  StartOff, EndOff, FullLen: Int64;
  LineLen, NRead: Integer;
  Buf: AnsiString;
begin
  Result := '';
  if (ALineNumber1Based < 1) or (ASourcePath = '') or (AIndexPath = '') then Exit;
  Src := nil;
  Idx := nil;
  try
    Src := TFileStream.Create(ASourcePath, fmOpenRead or fmShareDenyNone);
    Idx := TFileStream.Create(AIndexPath, fmOpenRead or fmShareDenyNone);
    if not TailMacroTryReadIndexOffset(Idx, ALineNumber1Based, StartOff) then Exit;
    if not TailMacroTryReadIndexOffset(Idx, ALineNumber1Based + 1, EndOff) then
      EndOff := Src.Size + 1;
    EndOff := Abs(EndOff);
    if EndOff <= StartOff then Exit;
    FullLen := EndOff - StartOff;
    if FullLen <= 0 then Exit;
    if FullLen > TAIL_MAX_LINE then LineLen := TAIL_MAX_LINE else LineLen := FullLen;
    Src.Seek(StartOff - 1, soFromBeginning);
    SetLength(Buf, LineLen);
    NRead := Src.Read(Pointer(Buf)^, LineLen);
    while (NRead > 0) and (Buf[NRead] in [#10, #13]) do Dec(NRead);
    SetLength(Buf, NRead);
    Result := DisplayTextFromFileBytes(Buf, AEnc);
  except
    Result := '';
  end;
  if Assigned(Idx) then Idx.Free;
  if Assigned(Src) then Src.Free;
end;

function TfrmMain.WaitTailMacroEngineDone(ATimeoutMs: Cardinal): Boolean;
var
  Start: DWORD;
begin
  if not FTailMacroAwaitingDone then
  begin
    Result := True;
    Exit;
  end;
  Start := GetTickCount;
  while FTailMacroAwaitingDone do
  begin
    Application.ProcessMessages;
    if (GetTickCount - Start) >= ATimeoutMs then Break;
  end;
  Result := not FTailMacroAwaitingDone;
end;

function TfrmMain.ExecuteTailMacroLinePipeSync(const AScriptB64: string;
  ASendScript: Boolean; AFromLine1, AToLine1: Int64): Boolean;
var
  IndexPath, Enc, SrcPath, LineText: string;
  LineNum, Total: Int64;
  Batch: TMemoryStream;
  BatchCount: Integer;
begin
  Result := False;
  if AToLine1 < AFromLine1 then Exit;
  SrcPath := CurrentEffectiveFilePath;
  IndexPath := TailMacroIndexFilePath;
  if not FileExists(IndexPath) then
  begin
    TailMacroLog(TrText('Tail macro: line index not found - read the file (F5) first.'));
    Exit;
  end;
  Enc := EffectiveDisplayEncoding;
  BeginTailMacroBatch(nil);
  FTailMacroAwaitingDone := True;
  FTailMacroAwaitingCompile := False;
  try
    if not EnsureTailMacroScriptEngine then
    begin
      EndTailMacroBatch(TrText('Tail macro: Python plugin ScriptEngine.exe not found or failed to start.'));
      Exit;
    end;
    if ASendScript then
    begin
      FTailMacroAwaitingCompile := True;
      if not ScriptEngineWriteLine('SCRIPT:' + AScriptB64) then
      begin
        EndTailMacroBatch(TrText('Could not send script to engine.'));
        Exit;
      end;
      if not WaitTailMacroCompiled(60000) then
      begin
        EndTailMacroBatch(TrText('Tail macro: timeout waiting for script compile.'));
        Exit;
      end;
    end;
    Batch := TMemoryStream.Create;
    try
      BatchCount := 0;
      Total := AToLine1 - AFromLine1 + 1;
      LineNum := AFromLine1;
      while LineNum <= AToLine1 do
      begin
        if TfrmSmoothLoading.CancelRequested then
        begin
          EndTailMacroBatch(TrText('Tail macro cancelled.'));
          Exit;
        end;
        LineText := TailMacroReadLineText(IndexPath, SrcPath, Enc, LineNum);
        if not ScriptEngineQueueStdInLine('LINE:' + IntToStr(LineNum) + ':' + LineText,
          Batch, BatchCount) then
        begin
          EndTailMacroBatch(TrText('Broken pipe while sending lines.'));
          Exit;
        end;
        Inc(LineNum);
      end;
      if not ScriptEngineFlushStdInBatch(Batch, BatchCount) then
      begin
        EndTailMacroBatch(TrText('Broken pipe while sending lines.'));
        Exit;
      end;
    finally
      Batch.Free;
    end;
    if not ScriptEngineWriteLine('DONE') then
    begin
      EndTailMacroBatch(TrText('Broken pipe while sending lines.'));
      Exit;
    end;
    if not WaitTailMacroEngineDone(120000) then
    begin
      EndTailMacroBatch(TrText('Tail macro: timeout waiting for ScriptEngine.'));
      Exit;
    end;
    Result := True;
  except
    on E: Exception do
      EndTailMacroBatch(E.Message);
  end;
  if FTailMacroAwaitingDone then
    FTailMacroAwaitingDone := False;
end;

{ Collect lines from ListView, compile + send script to engine, stream lines }
procedure TfrmMain.ScriptEngineRunClick(Sender: TObject);
var
  I, I2, N: Integer;
  ScriptSrc: string;
  B64Script: string;
  SrcBytes: AnsiString;
  B1, B2, B3: Byte;
  SelectedLines: array of Int64;
  UseSelectedScope: Boolean;
  SourceFileName: string;
  IndexFileName: string;
  CkptFileName: string;
  UseSparseIndex: Boolean;
  DisplayEncoding: string;
  SelectedTotal: Int64;
  MergedSet: TInt64List;
  SelIdx: Integer;
  Line1Based: Int64;
  SourceSize: Int64;
  SafeOutFileName: string;
  TimeTag: string;
  TmpStream: TFileStream;
  DynamicLimitBytes: Int64;
  EstimatedOutputBytes: Int64;
  EstimatedUiFootprintBytes: Int64;
  AvailPhysBytes: Int64;
  AvgLineBytes: Int64;
  LinesToProcess: Int64;
  LineCountLimit: Int64;
  MemStatus: TMemoryStatus;
  ForceDirectOutput: Boolean;
  WantAllLines: Boolean;
  ConfirmMsg: string;
begin
  if not Assigned(FScriptEditorMemo) then Exit;
  if not Assigned(FScriptOutputMemo) then Exit;

  if Assigned(FScriptEngineRunThread) then
  begin
    SetScriptEngineStatus(TrText('Already running...'));
    Exit;
  end;

  ScriptSrc := EnsurePythonStdImports(
    EnsurePythonTransformIndent(FScriptEditorMemo.Lines.Text));
  if Trim(ScriptSrc) = '' then
  begin
    ShowAppMessage(TrText('Please enter a Python script in the editor.'));
    Exit;
  end;

  { Ensure ScriptEngine.exe (download from server if missing, like Consumer AI) }
  if not FScriptEngineProcessRunning then
    StartScriptEngineProcess;
  if not FScriptEngineProcessRunning then
  begin
    SetScriptEngineStatus(TrText('Executable not found'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Python plugin ScriptEngine.exe not found.'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if (FScriptEngineVersion = 0) or ((FScriptEngineVersion > 0) and (FScriptEngineVersion < 5)) then
    AppendScriptEngineOutput('[WARN] ' + TrText('SCRIPT_ENGINE_REBUILD_HINT'));

  { Recolher linhas seleccionadas (ListView / checklist) antes de decidir o ambito }
  SetLength(SelectedLines, 0);
  SelectedTotal := 0;
  MergedSet := TInt64List.Create;
  try
    if isChecked and Assigned(FCheckedLines) and (FCheckedLines.Count > 0) then
    begin
      for I := 0 to FCheckedLines.Count - 1 do
        if MergedSet.IndexOf(FCheckedLines.Items[I]) = -1 then
          MergedSet.Add(FCheckedLines.Items[I]);
    end
    else if Assigned(ListView1) and ListView1.HandleAllocated and (ListView1.SelCount > 0) then
    begin
      SelIdx := -1;
      repeat
        SelIdx := ListView_GetNextItem(ListView1.Handle, SelIdx, LVNI_SELECTED);
        if SelIdx = -1 then Break;
        if FFilterActive then
          Line1Based := FilteredIndexToReal(SelIdx) + 1
        else
          Line1Based := Offset + (SelIdx + 1) + CsvDataStartLine;
        if (Line1Based > 0) and (MergedSet.IndexOf(Line1Based) = -1) then
          MergedSet.Add(Line1Based);
      until False;
    end
    else if Assigned(FCheckedLines) and (FCheckedLines.Count > 0) then
    begin
      for I := 0 to FCheckedLines.Count - 1 do
        if MergedSet.IndexOf(FCheckedLines.Items[I]) = -1 then
          MergedSet.Add(FCheckedLines.Items[I]);
    end;
    MergedSet.SortUp;
    SetLength(SelectedLines, MergedSet.Count);
    for I := 0 to MergedSet.Count - 1 do
      SelectedLines[I] := MergedSet.Items[I];
    SelectedTotal := Length(SelectedLines);
  finally
    MergedSet.Free;
  end;

  { 1) Com selecao (ListView ou checklist): usar so as selecionadas, sem perguntar.
     Sem selecao: processar o ficheiro inteiro. }
  if SelectedTotal > 0 then
    WantAllLines := False
  else
    WantAllLines := True;

  UseSelectedScope := not WantAllLines;
  if UseSelectedScope then
  begin
    if Assigned(FScriptScopeSelRB) then
      FScriptScopeSelRB.Checked := True;
  end
  else
  begin
    if Assigned(FScriptScopeAllRB) then
      FScriptScopeAllRB.Checked := True;
    SetLength(SelectedLines, 0);
    SelectedTotal := 0;
  end;

  { 2) Confirmacao final com contagem }
  if UseSelectedScope then
    ConfirmMsg := Format(TrText('SCRIPT_ENGINE_CONFIRM_SEL'), [Length(SelectedLines)])
  else
    ConfirmMsg := Format(TrText('SCRIPT_ENGINE_CONFIRM_ALL'), [totalLines]);
  if FastFileMessageDlg(ConfirmMsg, mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
    Exit;

  if UseSelectedScope then
    SelectedTotal := Length(SelectedLines);

  FScriptOutputMemo.Clear;
  HideScriptExportNotice;
  SetScriptEngineStatus(TrText('Compiling...'));
  FScriptRunStartTick := GetTickCount;
  if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := False;
  if Assigned(FScriptEngineSaveButton) then FScriptEngineSaveButton.Enabled := False;

  if UseSelectedScope then
    AppendScriptEngineOutput('[INFO] ' +
      Format(TrText('Processing %d selected line(s) only...'), [SelectedTotal]));

  { --- Base64-encode the script (UTF-8 bytes) ----------------------------- }
  SrcBytes := UTF8Encode(ScriptSrc);
  N := Length(SrcBytes);
  B64Script := '';
  I2 := 1;
  while I2 <= N do
  begin
    B1 := Ord(SrcBytes[I2]); Inc(I2);
    if I2 <= N then begin B2 := Ord(SrcBytes[I2]); Inc(I2); end else B2 := 0;
    if I2 <= N then begin B3 := Ord(SrcBytes[I2]); Inc(I2); end else B3 := 0;
    B64Script := B64Script +
      B64Chars[((B1 shr 2) and $3F) + 1] +
      B64Chars[(((B1 and $03) shl 4) or ((B2 shr 4) and $0F)) + 1] +
      B64Chars[(((B2 and $0F) shl 2) or ((B3 shr 6) and $03)) + 1] +
      B64Chars[(B3 and $3F) + 1];
  end;
  case N mod 3 of
    1: begin B64Script[Length(B64Script) - 1] := '='; B64Script[Length(B64Script)] := '='; end;
    2: B64Script[Length(B64Script)] := '=';
  end;

  SourceFileName := CurrentEffectiveFilePath;
  DisplayEncoding := EffectiveDisplayEncoding;
  FScriptDirectOutputFileName := '';
  CloseScriptDirectOutput;

  if Trim(SourceFileName) = '' then
  begin
    SetScriptEngineStatus(TrText('File not loaded'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Please select a file first.'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if not FileExists(SourceFileName) then
  begin
    SetScriptEngineStatus(TrText('File not loaded'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('File not found.'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if not CurrentFileHasLineIndex(IndexFileName, CkptFileName, UseSparseIndex) then
  begin
    SetScriptEngineStatus(TrText('File not loaded'));
    AppendScriptEngineOutput('[ERROR] ' +
      TrText('Tail macro: index file temp.txt not found - read the file (F5) first.'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if totalLines <= 0 then
  begin
    SetScriptEngineStatus(TrText('File not loaded'));
    AppendScriptEngineOutput('[ERROR] ' +
      TrText('Tail macro: index file temp.txt not found - read the file (F5) first.'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if UseSparseIndex then
    AppendScriptEngineOutput('[INFO] ' +
      TrText('Script engine: using sparse line index for this large file (temp_ckpt.txt).'));

  if fFileName <> SourceFileName then
    fFileName := SourceFileName;

  { For very large files in full-scan mode, redirect script output to disk. }
  SourceSize := 0;
  TmpStream := nil;
  try
    TmpStream := TFileStream.Create(SourceFileName, fmOpenRead or fmShareDenyNone);
    SourceSize := TmpStream.Size;
  finally
    if Assigned(TmpStream) then
      TmpStream.Free;
  end;

  { Dynamic output strategy:
    - estimate how much text may be written to memo
    - choose direct-to-file mode when projected output is too large
    - always force direct mode for very large source files }
  if totalLines > 0 then
    AvgLineBytes := SourceSize div totalLines
  else
    AvgLineBytes := 128;
  if AvgLineBytes < 32 then AvgLineBytes := 32;
  if AvgLineBytes > 4096 then AvgLineBytes := 4096;

  if UseSelectedScope then
    LinesToProcess := SelectedTotal
  else
    LinesToProcess := totalLines;
  if LinesToProcess < 1 then
    LinesToProcess := 1;

  EstimatedOutputBytes := AvgLineBytes * LinesToProcess;

  { Memo/richedit memory pressure is usually several times raw UTF-8 output. }
  EstimatedUiFootprintBytes := EstimatedOutputBytes * 6;
  if EstimatedUiFootprintBytes < EstimatedOutputBytes then
    EstimatedUiFootprintBytes := High(Int64); { overflow guard }

  FillChar(MemStatus, SizeOf(MemStatus), 0);
  MemStatus.dwLength := SizeOf(MemStatus);
  AvailPhysBytes := 512 * ONE_MB; { safe fallback }
  GlobalMemoryStatus(MemStatus);
  if MemStatus.dwAvailPhys > 0 then
    AvailPhysBytes := MemStatus.dwAvailPhys;

  { Auto budget adapts to available RAM + source size, clamped for safety. }
  DynamicLimitBytes := AvailPhysBytes div 8;
  if DynamicLimitBytes < (64 * ONE_MB) then DynamicLimitBytes := 64 * ONE_MB;
  if DynamicLimitBytes > (768 * ONE_MB) then DynamicLimitBytes := 768 * ONE_MB;

  { Also cap by line volume to avoid giant UI append workloads. }
  if AvgLineBytes > 0 then
    LineCountLimit := (DynamicLimitBytes div AvgLineBytes) div 3
  else
    LineCountLimit := 200000;
  if LineCountLimit < 100000 then LineCountLimit := 100000;
  if LineCountLimit > 600000 then LineCountLimit := 600000;

  ForceDirectOutput := False;
  if SourceSize >= (Int64(1024) * ONE_MB) then
    ForceDirectOutput := True
  else if EstimatedUiFootprintBytes > DynamicLimitBytes then
    ForceDirectOutput := True
  else if LinesToProcess > LineCountLimit then
    ForceDirectOutput := True;

  { Full-file runs with tens of thousands of lines: never fill the output memo. }
  if (not UseSelectedScope) and (LinesToProcess >= 50000) then
    ForceDirectOutput := True;

  { Aggressive safety for huge full-scan runs: avoid heavy UI/IPC output volume. }
  if (not UseSelectedScope) and (LinesToProcess >= 300000) then
    ForceDirectOutput := True;

  if ForceDirectOutput then
  begin
    TimeTag := FormatDateTime('yyyymmdd_hhnnss', Now);
    SafeOutFileName := ChangeFileExt(SourceFileName, '') + '_script_output_' + TimeTag + '.txt';
    try
      FScriptDirectOutputStream := TFileStream.Create(SafeOutFileName, fmCreate);
      FScriptDirectOutputMode := True;
      FScriptDirectOutputFileName := SafeOutFileName;
      ShowScriptExportNotice(SafeOutFileName, True);
      AppendScriptEngineOutput('[INFO] ' + TrText('SCRIPT_ENGINE_LARGE_OUTPUT_SEE_BANNER'));
      AppendScriptEngineOutput('  ' + Format(TrText('SCRIPT_EXPORT_FILE_LINE'),
        [ExtractFileName(SafeOutFileName)]));
      AppendScriptEngineOutput('  ' + Format(TrText('SCRIPT_EXPORT_FOLDER_LINE'),
        [ExtractFileDir(SafeOutFileName)]));
      if (FScriptEngineVersion > 0) and (FScriptEngineVersion < 5) then
        AppendScriptEngineOutput('[WARN] ' + TrText('SCRIPT_ENGINE_UPDATE_FOR_OUTFILE'));
    except
      on E: Exception do
      begin
        CloseScriptDirectOutput;
        AppendScriptEngineOutput('[ERROR] ' +
          TrText('Could not open output file for large-file mode.') + ' ' + E.Message);
        if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
        if Assigned(FScriptEngineSaveButton) then FScriptEngineSaveButton.Enabled := False;
        Exit;
      end;
    end;
  end;

  if UseSelectedScope then
    FScriptExpectedLines := SelectedTotal
  else
    FScriptExpectedLines := totalLines;
  FScriptEngineWritesDirectOutput := False;
  FScriptProcessedOkLines := 0;
  FScriptSkippedLines := 0;
  FScriptErrorLines := 0;

  FScriptEngineRunThread := TScriptEngineRunThread.Create(Self, B64Script,
    SelectedLines, totalLines, UseSelectedScope, SourceFileName,
    IndexFileName, CkptFileName, UseSparseIndex, DisplayEncoding);

  SetScriptEngineStatus(TrText('Processing...'));
end;


      [Frm.SpnLine.Value]);
    2: MergePosition := TrText('AI.Context.EndOfDestination');
  else
    MergePosition := TrText('AI.Context.BeginningOfDestination');
  end;

  Prompt := Format(TrText('AI.Context.MergeFiles'),
    [DestPath, SourcePath, LineRange, MergePosition]);
  CreateFastFileAssistantPanel;
  AssistantPrefillQuestion(Prompt);
  AssistantSubmitQuestion;
end;


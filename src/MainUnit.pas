procedure TfrmMain.GotoByteOffsetDirect(const B: Int64);
var
  Line0, LineStart: Int64;
  MatchStart: Integer;
  LineTxt: string;
begin
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty or (totalLines < 1) then Exit;
  if (B < 1) or (B > SourceFileSize64) then Exit;
  Line0 := Line0BasedForFileByte1Based(B);
  if Line0 < 0 then Exit;
  if UsesProportionalZeroScanScroll then
  begin
    ScrollToFileBytePos(B - 1, Integer(Line0));
    Exit;
  end;
  FLastFoundLine := -1;
  FLastFoundMatchLen := 0;
  FLastFoundCol := 0;
  LineStart := GetLineStartOffset(Line0);
  if LineStart > 0 then
  begin
    MatchStart := Integer((B - 1) - (LineStart - 1));
    LineTxt := GetLineContent(Line0);
    if (MatchStart >= 0) and (MatchStart < Length(LineTxt)) then
    begin
      FLastFoundLine := Line0;
      FLastFoundFilePos := B - 1;
      FLastFoundMatchLen := 1;
      FLastFoundCol := AlignMatchColInLineText(LineTxt,
        Copy(LineTxt, MatchStart + 1, 1), MatchStart, True);
    end;
  end;
  gotoLineWithAnchor(Line0, 4);
  ApplyFindMatchSelection;
  CalculateFontMetrics;
  ListView1.Invalidate;
  if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
end;

procedure TfrmMain.AssistantCbExecuteAction(const AStep: TAssistantChainStep);
var
  StartPos: Int64;
begin
  try
  if AStep.ActionId = '' then Exit;
  if not CatalogIsAllowedActionId(AStep.ActionId) then Exit;

  if SameText(AStep.ActionId, 'open_and_read_file') then
  begin
    AssistantCbOpenFile(AStep.Path);
    Exit;
  end;
  if SameText(AStep.ActionId, 'open_recent_file') then
  begin
    AssistantCbOpenRecentFileByIndex(AStep.LineNo);
    Exit;
  end;
  if SameText(AStep.ActionId, 'show_tab_read') then begin AssistantCbShowTabRead; Exit; end;
  if SameText(AStep.ActionId, 'show_tab_recent') then begin AssistantCbShowTabRecent; Exit; end;
  if SameText(AStep.ActionId, 'show_help') then begin AssistantCbShowHelp; Exit; end;
  if SameText(AStep.ActionId, 'open_find') then begin AssistantCbShowFind; Exit; end;
  if SameText(AStep.ActionId, 'view_find_occurrences') then
  begin
    EnsureReadTabVisible;
    ApplyFindOccurrencesToView;
    Exit;
  end;
  if SameText(AStep.ActionId, 'clear_find') then
  begin
    ClearFindOccurrences;
    Exit;
  end;
  if SameText(AStep.ActionId, 'find_text') then
  begin
    AssistantCbFindFirst(AStep.FilterText, AStep.CaseSensitive);
    Exit;
  end;
  if SameText(AStep.ActionId, 'find_next') then
  begin
    EnsureReadTabVisible;
    if Trim(FFindText) = '' then Exit;
    if FLastFoundLine < 0 then StartPos := 0
    else StartPos := FLastFoundFilePos + 1;
    if StartPos < 0 then StartPos := 0;
    StartFindFromPos(StartPos, +1);
    Exit;
  end;
  if SameText(AStep.ActionId, 'find_previous') then
  begin
    EnsureReadTabVisible;
    if Trim(FFindText) = '' then Exit;
    StartPos := FLastFoundFilePos - 1;
    if StartPos < 0 then StartPos := 0;
    StartFindFromPos(StartPos, -1);
    Exit;
  end;
  if SameText(AStep.ActionId, 'open_replace') then begin AssistantCbOpenReplace; Exit; end;
  if SameText(AStep.ActionId, 'replace_all') then
  begin
    AssistantCbReplaceAll(AStep.FilterText, AStep.ReplaceText, AStep.CaseSensitive);
    Exit;
  end;
  if SameText(AStep.ActionId, 'goto_line') then begin AssistantCbGotoLine(AStep.LineNo); Exit; end;
  if SameText(AStep.ActionId, 'goto_byte_offset') then
  begin
    EnsureReadTabVisible;
    if AStep.ByteOffset > 0 then
      GotoByteOffsetDirect(AStep.ByteOffset)
    else
      DoGotoByteOffset;
    Exit;
  end;
  if SameText(AStep.ActionId, 'edit_line') then begin AssistantCbEditLine(AStep.LineNo); Exit; end;
  if SameText(AStep.ActionId, 'insert_line') then
  begin
    EnsureReadTabVisible;

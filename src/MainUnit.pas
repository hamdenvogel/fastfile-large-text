function TfrmMain.TryOpenWithValidLineIndexCache(const AFileName: string; AFileSize: Int64): Boolean;
var
  Wt: TFileTime;
  LineCount: Int64;
  DummySize: Int64;
begin
  Result := False;
  if FForceIndexThisOpen then Exit;
  if (AFileName = '') or (AFileSize <= 0) then Exit;
  UnUtils.GetFileSizeAndWriteTime(AFileName, DummySize, Wt);
  if not LoadLineIndexCache(AFileName, AFileSize, Wt, LineCount) then Exit;
  RememberFileReadTimer('0', LineCount);
  finishFileNameRead(
    Format(TrText('Time to read: %s millisecs. Total lines: %d.'), ['0', LineCount]),
    LineCount, AFileSize);
  Result := True;
end;

procedure TfrmMain.BeginRead;
var
  fSearch: string;
  fileSize: Int64;
  PathKeep: string;
begin
  SetOperationStatus(fssLoading, Tr('status.file_reading', 'Reading file...'));
  FFreshFileRead := True;
  FastFileWatchdogClearCancelRequest;
  FastFileWatchdogBeginHeavyOp('BeginRead');
  try
    try
      try
        SaveCurrentSession;
      except
        on E: Exception do
          LogFastFileException('BeginRead.SaveCurrentSession', E.ClassName + ': ' + E.Message);
      end;
      fFileName := CurrentEffectiveFilePath;
      PathKeep := fFileName;
      try
        fileSize := GetFileSize(fFileName);
      except
        on E: Exception do
        begin
          UpdateStatusBar(Tr('status.file_read_failed', 'File read failed'), iaRight);
          ReportFastFileException('BeginRead.GetFileSize', E, True);
          Exit;
        end;
      end;
      sStatusBar1.Panels[4].Text := TrText('Cache in disk');
      sStatusBar1.Panels[4].Text := sStatusBar1.Panels[4].Text + ' ' + FloatToStr(fileSize) + ' bytes';
      fSearch := edtSearch.Text;
      try
        ActionClear.Execute;
      except
        on E: Exception do
        begin
          UpdateStatusBar(Tr('status.file_read_failed', 'File read failed'), iaRight);
          ReportFastFileException('BeginRead.ActionClear', E, True);
          Exit;
        end;
      end;
      { ActionClear/EmptyObjects limpa edtFileName — repor ja, senao o campo fica
        vazio durante ProcessMessages / indexacao e pode perder-se com CheckOnExit. }
      if (PathKeep <> '') and not SameText(PathKeep, SELECTTEXT) then
      begin
        fFileName := PathKeep;
        if Assigned(edtFileName) then
        begin
          edtFileName.Text := PathKeep;
          ApplySessionReadOnlyFilenameDecoration;
          SyncReadFileF5Button;
        end;
      end;
      try
        CloseFileStreams;
      except
        on E: Exception do
          LogFastFileException('BeginRead.CloseFileStreams', E.ClassName + ': ' + E.Message);
      end;
      { ScriptEngine / indices: libertar handles antes de reindexar (F5). }
      try
        StopScriptEngineProcess;
      except
        on E: Exception do
          LogFastFileException('BeginRead.StopScriptEngine', E.ClassName + ': ' + E.Message);
      end;
      FastFileWatchdogPulse;
      if AppUiUpdatesAllowed then
        Application.ProcessMessages;

      if ShouldOpenWithInstantZeroScan(fileSize) then
      begin
        { > limite GB ou lista fallback: abertura instantanea sem indexar. }
        CleanupFastFileLineIndexFiles;
        RememberInstantOpenTimer(False);
        finishFileNameRead(TrText('Instant Open (Zero Scan)'), 2000000000, fileSize);
      end
      else
      begin
        if not TryOpenWithValidLineIndexCache(fFileName, fileSize) then
        try
          TReadFileThread.Create(False, fFileName);
        except
          on E: Exception do
          begin
            UpdateStatusBar(Tr('status.file_read_failed', 'File read failed'), iaRight);
            ReportFastFileException('BeginRead.TReadFileThread', E, True);
            Exit;
          end;
        end;
      end;
      FForceIndexThisOpen := False;
    except
      on E: Exception do
      begin
        UpdateStatusBar(Tr('status.file_read_failed', 'File read failed'), iaRight);
        ReportFastFileException('BeginRead', E, True);
      end;
    end;
  finally
    FastFileWatchdogEndHeavyOp;
  end;
end;

procedure TfrmMain.BeginReadSilent;
begin
  BeginPostEditReindex;
end;

procedure TfrmMain.BeginPostEditReindex;
{ Rebuilds temp_ckpt (and temp.txt when applicable) after edit/delete without
  ActionClear - avoids blank ListView and preserves path/undo session. }
var
  Path, IndexPath: string;
begin
  FFreshFileRead := False;
  SaveCurrentSession;
  Path := CurrentEffectiveFilePath;
  if (Path = '') or (not FileExists(Path)) then Exit;
  fFileName := Path;
  CloseFileStreams;
  StopScriptEngineProcess;
  FFileReloadInProgress := True;
  IndexPath := FastFileExeDirPath(TEMPFILE);
  { Zero Scan sem denso: mesma indexacao sob demanda (ckpt + blocos), sem alterar F5 normal. }
  if FZeroScanMode and (not FileExists(IndexPath)) then
    TReadFileThread.Create(False, fFileName, True, True, TrText('Updating line index...'), '', True)
  else
    TReadFileThread.Create(False, fFileName, True, True, TrText('Updating line index...'));
end;

procedure TfrmMain.CompletePostEditLineCountRefresh(const AFileName: string;
  const ANewLineCount: Int64; const AInvalidateDenseIndex: Boolean;
  const ADiscardSparseCkpt: Boolean);
var
  Sz: Int64;
  IndexPath, CkptPath: string;
  Retry: Integer;
begin
  if (AFileName = '') or (not FileExists(AFileName)) then Exit;
  if TfrmSmoothLoading.HeavyFileMutateHoldActive then
    EndHeavyFileMutate;
  Sz := GetFileSize(AFileName);
  IndexPath := FastFileExeDirPath(TEMPFILE);
  CkptPath := FastFileExeDirPath(TEMP_CKPT_FILE);
  CloseFileStreams;
  if AInvalidateDenseIndex and FileExists(IndexPath) then
    DeleteDenseIndexIfNeeded(True);
  if ADiscardSparseCkpt and FileExists(CkptPath) then
    UnUtils.TryDeleteFileWithRetry(CkptPath, 12, 80);
  if not FileExists(CkptPath) then
  begin
    BeginPostEditReindex;
    Exit;
  end;
  for Retry := 1 to 4 do
  begin
    OpenFileStreams(AFileName);
    if Assigned(FSourceFileStream) then Break;
    Application.ProcessMessages;
    Sleep(40 * Retry);
  end;
  if not Assigned(FSourceFileStream) then
  begin
    BeginPostEditReindex;
    Exit;
  end;
  FDetectedEncoding := DetectFileEncoding(AFileName);
  FDetectedEol := DetectLineEndingFromFile(AFileName);
  UpdateEolStatusPanel;
  { Igual finishFileNameRead: decidir Zero Scan com indice ja aberto (ckpt/temp.txt). }
  FZeroScanMode := FForceZeroScan or (ANewLineCount >= 2000000000);
  if (not FZeroScanMode) and (not HasLineSearchIndex) and (ANewLineCount > 500000) then
  begin
    FZeroScanMode := True;
    if ANewLineCount > 0 then
      FZeroScanBytesPerItem := Sz div ANewLineCount
    else
      FZeroScanBytesPerItem := 1;
    if FZeroScanBytesPerItem < 1 then FZeroScanBytesPerItem := 1;
  end;
  ApplyZeroScanVirtualLineCount(totalLines, Sz);
  if UsesProportionalZeroScanScroll then
    EnsureZeroScanBytesPerItemInitialized;
  InvalidateLineCache;
  InvalidateOpenFileDiskSnapshot;
  SyncListViewViewportAfterFileLoad;
  RestoreCsvModeAfterPostEdit;
  UpdateInfoPanels;
  CaptureOpenFileDiskSnapshot;
  FFileReloadInProgress := False;
  SyncReadViewUiAfterFileLoad;
  if isChecked then
  begin
    if Assigned(FCheckListBox) then
      FCheckListBox.Visible := True;
    PostMessage(Handle, WM_USER + 204, 0, 0);
    Application.ProcessMessages;
  end
  else if Assigned(ListView1) and ListView1.HandleAllocated then
  begin
    ListView1.ClearSelection;
    ListView1.Invalidate;
    ListView1.Refresh;
  end;
end;

procedure TfrmMain.ApplyPostBatchDeleteRefresh(const AFileName: string;
  const ANewLineCount: Int64; const AInvalidateDenseIndex: Boolean;
  const ADiscardSparseCkpt: Boolean);
var
  Sz: Int64;
begin
  if (AFileName = '') or (not FileExists(AFileName)) then Exit;
  fFileName := AFileName;
  edtFileName.Text := fFileName;
  ApplySessionReadOnlyFilenameDecoration;
  Sz := GetFileSize(AFileName);
  totalLines := ANewLineCount;
  if FCsvMode and FCsvHasHeader and FCsvHideHeaderRow and (not FFilterActive) then
    ItemCount := Max(0, totalLines - 1)
  else
    ItemCount := totalLines;
  totalCharacters := Sz;
  CompletePostEditLineCountRefresh(AFileName, ANewLineCount, AInvalidateDenseIndex,
    ADiscardSparseCkpt);
end;


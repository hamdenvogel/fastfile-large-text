begin
  StartupMark('Message loop reached (after FormShow)');
  UpdateIdleLogoVisibility;
  StartupMark('UpdateIdleLogoVisibility');
  StartupFlush;
end;

procedure TfrmMain.WMIdleLogoRepaint(var Msg: TMessage);
begin

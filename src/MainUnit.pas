    BtnOk.Default := True;

    BtnCancel := TButton.Create(Frm);
    BtnCancel.Parent := Frm;
    BtnCancel.Left := Frm.ClientWidth - 100;
    BtnCancel.Top := ButtonsTop;
    BtnCancel.Width := 80;
    BtnCancel.Caption := TrText('Cancel');
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Cancel := True;

    BtnPreview := TButton.Create(Frm);
    BtnPreview.Parent := Frm;
    BtnPreview.Left := Frm.ClientWidth - 280;
    BtnPreview.Top := ButtonsTop;
    BtnPreview.Width := 80;
    BtnPreview.Caption := TrText('Preview');

    AutoHelper := TSplitPatternDialogAutoHelper.Create(EdtSource, EdtPattern, ChkRegex,
      LblAutoPattern, cmbMode, SpnEqualParts, MemoHeader,
      EdtReplacement, LblReplacement,
      LblRegexExamples, MemoRegexExamples);
    EdtSource.OnExit   := AutoHelper.SourceEditExit;
    { Avoid running disk scans on every keystroke/change (can freeze with huge files). }
    EdtSource.OnChange := nil;
    EdtPattern.OnExit  := AutoHelper.PatternEditExit;
    ChkRegex.OnClick   := AutoHelper.RegexCheckClick;
    cmbMode.OnChange   := AutoHelper.ModeChanged;
    BtnPreview.OnClick := AutoHelper.PreviewClick;
    AutoHelper.AutoSuggestNow;

    if Frm.ShowModal <> mrOk then
      Exit;

    ASourceFile := Trim(EdtSource.Text);
    APattern := EdtPattern.Text;
    AIsRegex := ChkRegex.Checked;
    AUseEqualParts := (cmbMode.ItemIndex = 1);
    AEqualPartsCount := Integer(SpnEqualParts.Value);
    AHeader := MemoHeader.Text;
    AFooter := MemoFooter.Text;
    AReplacement := EdtReplacement.Text;

    case cmbMode.ItemIndex of
      0: ARegexOp := roSplit;
      1: begin ARegexOp := roSplit; AUseEqualParts := True; end;
      2: ARegexOp := roMatch;
      3: ARegexOp := roTest;
      4: ARegexOp := roReplace;
      5: ARegexOp := roFilter;
    else ARegexOp := roSplit;
    end;

    if AUseEqualParts then
    begin
      if (AEqualPartsCount < 2) or (AEqualPartsCount > 1000) then
      begin
        ShowAppMessage(TrText('Number of parts must be between 2 and 1000.'));
        Exit;
      end;
    end
    else if APattern = '' then
    begin
      ShowAppMessage(TrText('Pattern cannot be empty.'));
      Exit;
    end;

    Result := True;
  finally
    if Assigned(AutoHelper) then
      FreeAndNil(AutoHelper);
    Frm.Free;
  end;
end;


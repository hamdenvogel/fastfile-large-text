    sem dialogo de abrir ficheiro quando o campo estiver vazio. }
  EnsureReadTabVisible;
  if not Assigned(edtFileName) then Exit;
  Path := CurrentEffectiveFilePath;
  if (Path = '') or SameText(Path, SELECTTEXT) then Exit;
  DoRead;
end;


procedure TfrmMain.RecentMruShowProperties(Sender: TObject; const APath: string);
var
  Info: TShellExecuteInfo;
  P: string;
begin
  P := Trim(APath);
  if P = '' then Exit;
  if not FileExists(P) then
  begin
    NotifyRecentFileMissing(P);
    Exit;
  end;
  FillChar(Info, SizeOf(Info), 0);
  Info.cbSize := SizeOf(Info);
  Info.fMask := SEE_MASK_INVOKEIDLIST;
  if Sender is TWinControl then
    Info.Wnd := TWinControl(Sender).Handle
  else
    Info.Wnd := Handle;
  Info.lpVerb := 'properties';
  Info.lpFile := PChar(P);
  Info.nShow := SW_SHOW;
  if not ShellExecuteEx(@Info) then
  begin
    if not FileExists(P) then
      NotifyRecentFileMissing(P)
    else
      FastFileMessageBox(PChar(TrText('File not found:') + #13#10 + P),
        APPLICATION_NAME, MB_OK or MB_ICONWARNING);
  end;
end;


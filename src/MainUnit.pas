procedure TfrmMain.SetupToolbarKeyboardHints;
  { Caption em duas linhas (texto + atalho); hint acrescenta o atalho se ja houver descricao.
    TsSpeedButton tem Caption; TControl base nao. }
  procedure SetBtn(ABtn: TsSpeedButton; const ABaseCaption, AShortcut: string);
  var
    Tail, Base: string;
    Need, GlyphW: Integer;
  begin
    if not Assigned(ABtn) then Exit;
    Tail := TrText('Shortcut: ') + AShortcut;
    Base := TrText(ABaseCaption);
    ABtn.Caption := Base + #13#10 + AShortcut;
    ABtn.ShowHint := True;
    ABtn.Hint := Tail;
    { Main ribbon buttons are alLeft: grow so long translations are not cut with "...". }
    if (Pos('btnMain', ABtn.Name) = 1) and (ABtn.Align = alLeft) then
    begin
      GlyphW := 0;
      if Assigned(ABtn.Images) then
        GlyphW := ABtn.Images.Width + ABtn.Spacing;
      Need := Max(FFMeasureTextWidth(ABtn.Font, Base), FFMeasureTextWidth(ABtn.Font, AShortcut)) +
        GlyphW + 24;
      if Need > ABtn.Width then
        ABtn.Width := Need;
    end;
  end;
begin
  SetBtn(btnShowTabReadFile, 'Read', 'Ctrl+1');
  SetBtn(btnMainSplitEqualParts, 'Equal parts', 'Ctrl+Shift+P');
  SetBtn(btnMainMergeFiles, 'Merge files', 'Ctrl+Shift+J');
  SetBtn(btnMainSplitFiles, 'Split Files', 'Ctrl+Shift+K');
  SetBtn(btnMainMergeLines, 'Merge lines', 'Ctrl+Shift+M');
  SetBtn(btnMainCompareMerge, 'Compare / merge', 'Ctrl+Shift+H');
  SetBtn(btnMainSplitByPattern, 'Pattern/Regex', 'Ctrl+Alt+P');
  SetBtn(btnMainExtractParts, 'Extract parts', 'Ctrl+Shift+Q');
  SetBtn(btnRead, 'Read', 'F5');
  SetBtn(btnSplitFiles, 'Split Files', 'Ctrl+Shift+K');
  SetBtn(btnMergeMultipleLines, 'Merge lines', 'Ctrl+Shift+M');
  SetBtn(btnCheckBoxes, 'Select', 'Ctrl+Shift+S');
  SetBtn(btnClear, 'Clear', 'Ctrl+Shift+X');
  SetBtn(btnEditFile, 'Edit', 'Ctrl+Shift+E');
  { Ctrl+Shift+D abre o line editor em Delete Line; o botao continua exclusao em lote (ActionDelete). }
  SetBtn(btnDeleteLines, 'Delete lines (batch)', '');
  SetBtn(btnExport, 'Export', 'Ctrl+Shift+O');
  SetBtn(btnReturn, 'Close', 'Ctrl+Shift+W');
  SetBtn(btnConsumerAI, 'AI', '');
  if Assigned(btnConsumerAI) then
  begin
    btnConsumerAI.Visible := False;
    btnConsumerAI.Enabled := False;
  end;
  if Assigned(btnHelp) then
    SetBtn(btnHelp, 'Help', 'F1');
  RefreshTopFileQuickActionCaptions;
end;


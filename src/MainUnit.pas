var
  I: Integer;
  Btn: TsSpeedButton;

  function NewReadTbBtn(AClick: TNotifyEvent): TsSpeedButton;
  begin
    Result := TsSpeedButton.Create(Self);
    Result.Parent := pnlReadToolbarOptions;
    Result.Width := BTN_W;
    Result.Height := BTN_H;
    Result.Flat := True;
    Result.ShowCaption := False;
    Result.ShowHint := True;
    Result.ParentShowHint := False;
    Result.SkinData.SkinSection := 'TOOLBUTTON';
    Result.Blend := 20;
    Result.OnClick := AClick;
  end;

begin
  if not Assigned(pnlReadToolbarOptions) then Exit;

  if not Assigned(FReadTbZoomIn) then
  begin
    for I := 0 to 4 do
    begin
      Btn := NewReadTbBtn(nil);
      case I of
        0: begin Btn.OnClick := ReadTbZoomInClick; FReadTbZoomIn := Btn; end;
        1: begin Btn.OnClick := ReadTbZoomOutClick; FReadTbZoomOut := Btn; end;
        2: begin Btn.OnClick := ReadTbFindClick; FReadTbFind := Btn; end;
        3: begin Btn.OnClick := ReadTbFindReplaceClick; FReadTbFindReplace := Btn; end;
        4: begin Btn.OnClick := ReadTbMarksClick; FReadTbMarks := Btn; end;
      end;
    end;
  end;

  { Novos atalhos na barra do ficheiro (podem faltar apos upgrade em runtime). }
  if not Assigned(FReadTbWordWrap) then
    FReadTbWordWrap := NewReadTbBtn(ReadTbWordWrapClick);
  if not Assigned(FReadTbFilter) then
    FReadTbFilter := NewReadTbBtn(ReadTbFilterClick);
  if not Assigned(FReadTbCompareMerge) then
    FReadTbCompareMerge := NewReadTbBtn(ReadTbCompareMergeClick);

  LocalizeReadToolbarQuickButtons;
  ApplyReadToolbarQuickButtonIcons;
  LayoutReadToolbarQuickButtons;
end;


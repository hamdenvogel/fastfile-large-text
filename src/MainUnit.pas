procedure TfrmMain.PopulateRecentFilesTab;
var
  LVFiles, LVFolders: TListView;
  BtnOpenSelected: TButton;
  Item: TListItem;
  I: Integer;
  FilePath, Dir, SessionStr: string;
  Folders: TStringList;

  function SessionFileExistsFor(const AFilePath: string): Boolean;
  var
    SafeName: string;
    J: Integer;
    C: Char;
  begin
    SafeName := AFilePath;
    for J := 1 to Length(SafeName) do
    begin
      C := SafeName[J];
      if PosBMH(C, ILLEGAL_FILENAME_CHARS) > 0 then
        SafeName[J] := '_';
    end;
    Result := FileExists(FastFileSessionPath(SafeName));
  end;

  function FileSizeInt64(const APath: string): Int64;
  var
    FindData: TWin32FindData;
    H: THandle;
  begin
    Result := -1;
    H := FindFirstFile(PChar(APath), FindData);
    if H = INVALID_HANDLE_VALUE then Exit;
    Windows.FindClose(H);
    Result := Int64(FindData.nFileSizeHigh) shl 32 or Int64(FindData.nFileSizeLow);
  end;

  function FileModStamp(const APath: string): string;
  var
    FindData: TWin32FindData;
    H: THandle;
    FT: TFileTime;
    ST: TSystemTime;
  begin
    Result := '-';
    H := FindFirstFile(PChar(APath), FindData);
    if H = INVALID_HANDLE_VALUE then Exit;
    Windows.FindClose(H);
    FT := FindData.ftLastWriteTime;
    FileTimeToLocalFileTime(FT, FT);
    FileTimeToSystemTime(FT, ST);
    Result := Format('%04d-%02d-%02d  %02d:%02d',
      [ST.wYear, ST.wMonth, ST.wDay, ST.wHour, ST.wMinute]);
  end;

  function SizeToText(const ASize: Int64): string;
  const
    KB = Int64(1024);
    MB = Int64(1024) * 1024;
    GB = Int64(1024) * 1024 * 1024;
  begin
    if ASize < 0 then
      Result := '-'
    else if ASize < KB then
      Result := IntToStr(ASize) + ' B'
    else if ASize < MB then
      Result := Format('%.1f KB', [ASize / KB])
    else if ASize < GB then
      Result := Format('%.1f MB', [ASize / MB])
    else
      Result := Format('%.2f GB', [ASize / GB]);
  end;

begin
  if not (Assigned(RecentFilesTabFind('lvRecentFiles')) and (RecentFilesTabFind('lvRecentFiles') is TListView)) then Exit;
  if not (Assigned(RecentFilesTabFind('lvRecentFolders')) and (RecentFilesTabFind('lvRecentFolders') is TListView)) then Exit;

  LVFiles := RecentFilesTabFind('lvRecentFiles') as TListView;
  LVFolders := RecentFilesTabFind('lvRecentFolders') as TListView;

  LVFiles.Items.BeginUpdate;
  try
    LVFiles.Items.Clear;
    for I := 0 to FRecentFiles.Count - 1 do
    begin
      FilePath := Trim(FRecentFiles[I]);
      if FilePath = '' then Continue;

      Item := LVFiles.Items.Add;
      Item.Caption := ExtractFileName(FilePath);
      Item.ImageIndex := RecentFilesImageIndexFor(FilePath);
      Dir := ExcludeTrailingPathDelimiter(ExtractFileDir(FilePath));
      Item.SubItems.Add(Dir);
      if FileExists(FilePath) then
      begin
        Item.SubItems.Add(SizeToText(FileSizeInt64(FilePath)));
        Item.SubItems.Add(FileModStamp(FilePath));
      end
      else
      begin
        Item.SubItems.Add('-');
        Item.SubItems.Add('-');
      end;

      if Assigned(FRecentFilesLastOpened) and (I < FRecentFilesLastOpened.Count) and
         (Trim(FRecentFilesLastOpened[I]) <> '') then
        Item.SubItems.Add(FRecentFilesLastOpened[I])
      else
        Item.SubItems.Add('-');

      if SessionFileExistsFor(FilePath) then
        SessionStr := '* ' + TrText('saved')
      else
        SessionStr := '';
      Item.SubItems.Add(SessionStr);
      Item.SubItems.Add('X');  { delete column visual marker }
    end;
  finally
    LVFiles.Items.EndUpdate;
  end;

  Folders := TStringList.Create;
  try
    Folders.Sorted := True;
    Folders.Duplicates := dupIgnore;
    Folders.CaseSensitive := False;
    for I := 0 to LVFiles.Items.Count - 1 do
    begin
      if LVFiles.Items[I].SubItems.Count > 0 then
      begin
        Dir := Trim(LVFiles.Items[I].SubItems[0]);
        if Dir <> '' then
          Folders.Add(Dir);
      end;
    end;

    LVFolders.Items.BeginUpdate;
    try
      LVFolders.Items.Clear;
      for I := 0 to Folders.Count - 1 do
      begin
        Item := LVFolders.Items.Add;
        Item.Caption := Folders[I];
      end;
    finally
      LVFolders.Items.EndUpdate;
    end;
  finally
    Folders.Free;
  end;

  if (LVFiles.Items.Count > 1) and (FRecentFilesSortColumn >= 0) then
    LVFiles.AlphaSort;

  if Assigned(RecentFilesTabFind('btnOpenSelected')) and (RecentFilesTabFind('btnOpenSelected') is TButton) then
  begin
    BtnOpenSelected := RecentFilesTabFind('btnOpenSelected') as TButton;
    BtnOpenSelected.Enabled := Assigned(LVFiles.Selected);
  end;

  UpdateRecentFilesTabEmptyState;
end;

procedure TfrmMain.RemoveRecentFileByPath(const FilePath: string);
var
  Idx, I: Integer;
begin
  if Trim(FilePath) = '' then Exit;
  if not Assigned(FRecentFiles) then Exit;
  Idx := FRecentFiles.IndexOf(FilePath);
  if Idx < 0 then
    for I := 0 to FRecentFiles.Count - 1 do
      if SameText(FRecentFiles[I], FilePath) then
      begin
        Idx := I;
        Break;
      end;
  if Idx < 0 then Exit;
  FRecentFiles.Delete(Idx);
  if Assigned(FRecentFilesLastOpened) and (Idx < FRecentFilesLastOpened.Count) then
    FRecentFilesLastOpened.Delete(Idx);
  SaveRecentFiles;
  PopulateRecentFilesTab;
end;

procedure TfrmMain.NotifyRecentFileMissing(const FilePath: string);
var
  P, Extra, Msg: string;
begin
  P := Trim(FilePath);
  if P = '' then Exit;
  Extra := Trim(TrText('MRU.RemovedBecauseMissing'));
  Msg := TrText('File not found:') + #13#10 + P;
  if Extra <> '' then
    Msg := Msg + #13#10#13#10 + Extra;
  FastFileMessageBox(PChar(Msg), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
  RemoveRecentFileByPath(P);
end;

procedure TfrmMain.OpenSelectedRecentFileFromTab;
var
  LV: TListView;
  Item: TListItem;
  FilePath: string;
begin
  if not (Assigned(RecentFilesTabFind('lvRecentFiles')) and (RecentFilesTabFind('lvRecentFiles') is TListView)) then Exit;
  LV := RecentFilesTabFind('lvRecentFiles') as TListView;
  Item := LV.Selected;
  if not Assigned(Item) then Exit;
  if Item.SubItems.Count < 1 then Exit;

  FilePath := IncludeTrailingPathDelimiter(Item.SubItems[0]) + Item.Caption;
  if not FileExists(FilePath) then
  begin
    NotifyRecentFileMissing(FilePath);
    Exit;
  end;

  EnsureRecentFilesTabFirstWhenEnabled;
  EnsureReadTabVisible;
  edtFileName.Text := FilePath;
  if Assigned(btnRead) and btnRead.Enabled then
    btnReadClick(btnRead);
end;


procedure TfrmMain.ShowScriptExportNoticeOn(AHostPanel: TWinControl; const AFileName: string;
  APending: Boolean);
var
  DirPath, FileName, HintPath: string;
begin
  if not Assigned(AHostPanel) then Exit;
  EnsureScriptExportBanner;
  if not Assigned(FScriptExportBannerPanel) then Exit;
  FileName := Trim(AFileName);
  if FileName = '' then
  begin
    HideScriptExportNotice;
    Exit;
  end;

  if FScriptExportBannerPanel.Parent <> AHostPanel then
  begin
    FScriptExportBannerPanel.Parent := AHostPanel;
    FScriptExportBannerPanel.Align := alTop;
  end
  else if FScriptExportBannerPanel.Align <> alTop then
    FScriptExportBannerPanel.Align := alTop;

  FScriptExportNoticePath := FileName;
  DirPath := ExtractFileDir(FileName);
  if DirPath = '' then
    DirPath := FileName;
  HintPath := FileName;
  if Assigned(FScriptExportTitleLabel) then
  begin
    if APending then
      FScriptExportTitleLabel.Caption := TrText('SCRIPT_EXPORT_WRITING_TITLE')
    else
      FScriptExportTitleLabel.Caption := TrText('SCRIPT_EXPORT_SAVED_TITLE');
    FScriptExportTitleLabel.Hint := HintPath;
  end;
  if Assigned(FScriptExportFileLabel) then
  begin
    FScriptExportFileLabel.Caption := Format(TrText('SCRIPT_EXPORT_FILE_LINE'),
      [ExtractFileName(FileName)]);
    FScriptExportFileLabel.Hint := HintPath;
  end;
  if Assigned(FScriptExportDirLabel) then
  begin
    FScriptExportDirLabel.Caption := Format(TrText('SCRIPT_EXPORT_FOLDER_LINE'),
      [FastFileShortenPathForUi(DirPath, 48)]);
    FScriptExportDirLabel.Hint := DirPath;
  end;
  FScriptExportBannerPanel.Hint := HintPath;
  if Assigned(FScriptExportOpenFileBtn) then
    FScriptExportOpenFileBtn.Enabled := (not APending) and FileExists(FileName);
  FScriptExportBannerPanel.Height := SCRIPT_EXPORT_BANNER_HEIGHT + FASTFILE_NOTICE_BAR_H;
  FScriptExportBannerPanel.Visible := True;
  if APending then
  begin
    if Assigned(FScriptExportAutoHide) then
      FScriptExportAutoHide.Stop;
  end
  else if Assigned(FScriptExportAutoHide) then
    FScriptExportAutoHide.Start(FASTFILE_NOTICE_SECONDS);
end;


procedure TfrmMain.miInsertMultipleLinesClick(Sender: TObject);
var
  StartLine: Int64;
  Count, I: Integer;
  HasSelection: Boolean;
  SelectedLine: Int64;
  UseDifferentText: Boolean;
  LinesToInsert: TStringList;
  BatchLines: TStringList;
  InsertText: string;
begin
  EnsureReadTabVisible;
  if ListviewIsEmpty then Exit;
  if not EnsureWritableSession then Exit;
  if TryStartAutoIndexForMutation then Exit;

  HasSelection := TryGetSelectedStartLine(SelectedLine);
  LinesToInsert := nil;
  BatchLines := nil;
  try
    if not ShowInsertMultipleLinesDialog(StartLine, Count, SelectedLine, HasSelection,
      UseDifferentText, LinesToInsert) then
      Exit;

    if not EnsureOpenFileNotStaleForMutate then Exit;
    if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
      StartLine := PhysicalLine1BasedForListLine0(StartLine - 1);

    BatchLines := TStringList.Create;
    for I := 0 to Count - 1 do
    begin
      if UseDifferentText then
        InsertText := LinesToInsert[I]
      else if Assigned(LinesToInsert) and (LinesToInsert.Count > 0) then
        InsertText := LinesToInsert[0]
      else
        InsertText := '';
      BatchLines.Add(InsertText);
    end;

    if not ApplyBatchInsertWithUndo(StartLine, BatchLines, 2) then
      Exit;
    BatchLines := nil;
  finally
    if Assigned(BatchLines) then
      BatchLines.Free;
    if Assigned(LinesToInsert) then
      LinesToInsert.Free;
  end;
end;


procedure TfrmMain.CheckListBox1ClickCheck(Sender: TObject);
var
  itemChecked: Integer;
  I: Integer;
  CurLine1Based: Int64;
  A64, B64, T64: Int64;
  A, B, L: Integer;
  IsNowChecked, ShiftDown: Boolean;
begin
  if not Assigned(FCheckListBox) then Exit;
  if FUpdatingChecklistChecks then Exit;
  if FCheckListBox.ItemIndex < 0 then Exit;

  CurLine1Based := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]);
  if CurLine1Based <= 0 then Exit;
  IsNowChecked := FCheckListBox.Checked[FCheckListBox.ItemIndex];
  ShiftDown := GetKeyState(VK_SHIFT) < 0;

  FUpdatingChecklistChecks := True;
  try
    if ShiftDown and (FChecklistAnchorLine > 0) then
    begin
      A64 := FChecklistAnchorLine;
      B64 := CurLine1Based;
      if A64 > B64 then
      begin
        T64 := A64; A64 := B64; B64 := T64;
      end;
      if A64 < 1 then A64 := 1;
      if B64 > High(Integer) then B64 := High(Integer);
      A := Integer(A64);
      B := Integer(B64);
      for L := A to B do
      begin
        if IsNowChecked then
          setCheckedLines(L)
        else
          setUnCheckedLines(L);
      end;
      { Re-sincroniza checks visiveis com o estado global FCheckedLines. }
      for I := 0 to FCheckListBox.Items.Count - 1 do
      begin
        itemChecked := Integer(FCheckListBox.Items.Objects[I]);
        FCheckListBox.Checked[I] := checkedLineExists(itemChecked);
      end;
    end
    else
    begin
      if IsNowChecked then
        setCheckedLines(CurLine1Based)
      else
        setUnCheckedLines(CurLine1Based);
    end;
  finally
    FUpdatingChecklistChecks := False;
  end;

  FChecklistAnchorLine := CurLine1Based;
  UpdateScriptScopeRBFromChecks;
  UpdateListViewLineToolsEnabled;
end;

procedure TfrmMain.CheckListBox1MouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  CheckAreaRight, HitRow: Integer;
begin
  if not Assigned(FCheckListBox) then Exit;
  CheckAreaRight := GetSystemMetrics(SM_CXMENUCHECK) + 8;
  FLineAutofillDeferCtrl := False;

  { Autofill na zona checkbox + prefixo Line #: arrastar para baixo insere linhas em branco. }
  if (Button = mbLeft) and (not (ssAlt in Shift)) and IsClickInCheckListLineColumn(X, Y)
     and CanStartLineAutofill then
  begin
    HitRow := GetCheckListRowIndexAt(Y);
    if HitRow >= 0 then
    begin
      if ssCtrl in Shift then
      begin
        FLineAutofillDeferCtrl := True;
        FLineAutofillDeferRow := HitRow;
        FLineAutofillDeferX := X;
        FLineAutofillDeferY := Y;
        Exit;
      end;
      StartLineAutofillDrag(HitRow, Y);
      Exit;
    end;
  end;

  if (Button = mbLeft) and ((ssCtrl in Shift) or (ssAlt in Shift)) then
  begin
    if (ssCtrl in Shift) and IsClickInCheckListLineColumn(X, Y) then
      Exit;
    if X > CheckAreaRight then
    begin
      FFindMatchSelection := False;
      FHasSelection := True;
      FIsDragging := True;
      SetCapture(FCheckListBox.Handle);
      if FCheckListBox.CanFocus then
        FCheckListBox.SetFocus;
      FBlockStartPoint := Point(X, Y);
      FBlockEndPoint := Point(X, Y);
      FCheckListBox.Invalidate;
      Exit;
    end;
  end
  else
  begin
    CancelLineAutofillDrag;
    if FHasSelection then
    begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
      if GetCapture = FCheckListBox.Handle then
        ReleaseCapture;
      FCheckListBox.Invalidate;
    end;
  end;
end;

procedure TfrmMain.CheckListBox1MouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
var
  CX, CY, RowH, Delta: Integer;
begin
  if FLineAutofillDeferCtrl then
  begin
    if (Abs(Y - FLineAutofillDeferY) >= 5) or (Abs(X - FLineAutofillDeferX) >= 5) then
    begin
      FLineAutofillDeferCtrl := False;
      StartLineAutofillDrag(FLineAutofillDeferRow, FLineAutofillDeferY);
    end
    else
      Exit;
  end;
  if FLineAutofillDragging and FLineAutofillOnCheckList and Assigned(FCheckListBox) then
  begin
    ClearFileLineHoverHint;
    RowH := ListViewVisualRowHeight;
    if RowH < 1 then RowH := 18;
    Delta := (Y - FLineAutofillStartY) div RowH;
    if Delta < 0 then Delta := 0;
    if Delta > MAX_LINE_AUTOFILL then Delta := MAX_LINE_AUTOFILL;
    if FLineAutofillInsertCount <> Delta then
    begin
      FLineAutofillInsertCount := Delta;
      FCheckListBox.Invalidate;
    end;
    Exit;
  end;
  if FIsDragging and Assigned(FCheckListBox) then
  begin
    { Clamp do ponto de arrasto ao cliente: evita saltos de range quando o cursor sai do controle. }
    CX := X;
    CY := Y;
    if CX < 0 then CX := 0;
    if CY < 0 then CY := 0;
    if CX >= FCheckListBox.ClientWidth then CX := FCheckListBox.ClientWidth - 1;
    if CY >= FCheckListBox.ClientHeight then CY := FCheckListBox.ClientHeight - 1;
    FBlockEndPoint := Point(CX, CY);
    FCheckListBox.Invalidate;
    ClearFileLineHoverHint;
    Exit;
  end;
  UpdateFileLineHoverHint(FCheckListBox, GetCheckListRowIndexAt(Y), True, X, Y);
end;

procedure TfrmMain.CheckListBox1MouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  CX, CY: Integer;
begin
  if FLineAutofillDeferCtrl then
  begin
    FLineAutofillDeferCtrl := False;
    Exit;
  end;
  if FLineAutofillDragging and FLineAutofillOnCheckList then
  begin
    FLineAutofillDragging := False;
    if Assigned(FCheckListBox) and (GetCapture = FCheckListBox.Handle) then
      ReleaseCapture;
    if (FLineAutofillInsertCount > 0) and CanStartLineAutofill and ConfirmLineAutofill then
      CommitLineAutofill;
    FLineAutofillInsertCount := 0;
    FLineAutofillOnCheckList := False;
    if Assigned(FCheckListBox) then
      FCheckListBox.Invalidate;
    UpdateInfoPanels;
    Exit;
  end;
  if FIsDragging and Assigned(FCheckListBox) then
  begin
    FIsDragging := False;
    if GetCapture = FCheckListBox.Handle then
      ReleaseCapture;
    { Fecha a selecao usando coordenadas limitadas ao cliente. }
    CX := X;
    CY := Y;
    if CX < 0 then CX := 0;
    if CY < 0 then CY := 0;
    if CX >= FCheckListBox.ClientWidth then CX := FCheckListBox.ClientWidth - 1;
    if CY >= FCheckListBox.ClientHeight then CY := FCheckListBox.ClientHeight - 1;
    FBlockEndPoint := Point(CX, CY);
    FCheckListBox.Invalidate;
  end;
  UpdateInfoPanels;
end;

procedure TfrmMain.showChecked;
var
  i, P: Integer;
  str: string;
  pageNumber: int64;
  DispIdx: Int64;
  LinePrefix: string;
begin
  SyncSelectModeListViewHeader;
  if not isChecked then
  begin
    if Assigned(FCheckListBox) then
      FCheckListBox.Visible := False;
    InvalidateLineCache;
    if (Trim(fFileName) <> '') and FileExists(fFileName) then
      OpenFileStreams(fFileName);
    if Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      ListView1.Items.BeginUpdate;
      try
        ListView1Resize(ListView1);
      finally
        ListView1.Items.EndUpdate;
      end;
    end;
    if ListView1.Visible and Assigned(ListView1) then
    begin
      if FDeferredListViewRecreateForRowHeight and (not FFastVisualWordWrap)
        and ListView1.HandleAllocated then
      begin
        ListView1.Perform(WM_SETREDRAW, 0, 0);
        try
          ListView1.Perform(CM_RECREATEWND, 0, 0);
        finally
          ListView1.Perform(WM_SETREDRAW, 1, 0);
        end;
        FDeferredListViewRecreateForRowHeight := False;
      end;
      ListView1.Invalidate;
      ListView1.Update;
    end;
  end;
  if isChecked and Assigned(FCheckListBox) then
  begin
    FCheckListBox.Visible := True;
    UpdateCheckListLinePrefixAutoWidth;
    RefreshCheckListViewport(True);
  end;
end;

procedure TfrmMain.RefreshCheckListViewport(const AForceFull: Boolean);
var
  i: Integer;
  str: string;
  pageNumber: Int64;
  DispIdx: Int64;
  LinePrefix: string;
  UseInPlace: Boolean;
begin
  if not isChecked or not Assigned(FCheckListBox) then Exit;
  if (not AForceFull) and (FCheckListDisplayOffset = Offset) and
     (FCheckListBox.Items.Count = VisibleItems) then Exit;

  if FListViewZoomBatchDepth = 0 then
  begin
    FCheckListBox.OnDrawItem := CheckListBox1DrawItem;
    FCheckListBox.Style := lbOwnerDrawFixed;
    FCheckListBox.OnMeasureItem := nil;
    SetCheckListVisualRowHeight(ListViewVisualRowHeight);
  end;

  UseInPlace := (not AForceFull) and (FCheckListBox.Items.Count = VisibleItems);
  if not AForceFull then
    FCheckListFastScrollPaint := True;
  if (FListViewZoomBatchDepth = 0) and UseInPlace and FCheckListBox.HandleAllocated then
    SendMessage(FCheckListBox.Handle, WM_SETREDRAW, 0, 0);
  FCheckListBox.Items.BeginUpdate;
  try
    if not UseInPlace then
    begin
      if FCheckListBox.Items.Count > 0 then
        FCheckListBox.Clear;
    end;
    LinePrefix := FTrLinePrefix;
    if LinePrefix = '' then
      LinePrefix := TrText('Line:');
    if (not FFilterActive) and Assigned(FSourceFileStream) then
      EnsureLineCacheForPage;
    for i := 0 to VisibleItems - 1 do
    begin
      if not Assigned(FSourceFileStream) then Break;
      if FFilterActive then
      begin
        pageNumber := FilteredIndexToReal(Offset + Int64(i));
        if pageNumber < 0 then Continue;
        DispIdx := pageNumber + 1;
        str := LinePrefix + ' ' + FormatFloat('#,', DispIdx) + '  ' +
          getLineContentsFromLineIndex(DispIdx - 1);
      end
      else
      begin
        DispIdx := Offset + (i + 1) + CsvDataStartLine;
        str := LinePrefix + ' ' + FormatFloat('#,', DispIdx) + '  ' +
          getLineContentsFromLineIndex(DispIdx - 1);
      end;
      if UseInPlace then
      begin
        FCheckListBox.Items[i] := str;
        FCheckListBox.Items.Objects[i] := TObject(Integer(DispIdx));
      end
      else
        FCheckListBox.Items.AddObject(str, TObject(Integer(DispIdx)));
    end;
    if isAllChecked then
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
        FCheckListBox.Checked[i] := True;
    end
    else if Assigned(FCheckedLines) then
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
      begin
        pageNumber := Integer(FCheckListBox.Items.Objects[i]);
        FCheckListBox.Checked[i] := FCheckedLines.IndexOf(pageNumber) > -1;
      end;
    end
    else
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
        FCheckListBox.Checked[i] := False;
    end;
    if FListViewZoomBatchDepth = 0 then
      ShowScrollBar(FCheckListBox.Handle, SB_VERT, False);
  finally
    FCheckListBox.Items.EndUpdate;
    if (FListViewZoomBatchDepth = 0) and UseInPlace and FCheckListBox.HandleAllocated then
      SendMessage(FCheckListBox.Handle, WM_SETREDRAW, 1, 0);
    if (FListViewZoomBatchDepth = 0) and (UseInPlace or (not AForceFull)) then
      FCheckListBox.Invalidate;
  end;
  FCheckListDisplayOffset := Offset;
  if AForceFull then
    FCheckListFastScrollPaint := False
  else
    PostMessage(Handle, WM_USER + 205, 0, 0);
  if AForceFull and FCheckListBox.CanFocus and (FListViewZoomBatchDepth = 0) then
    FCheckListBox.SetFocus;
end;

procedure TfrmMain.ApplyCheckListZoomRefresh(const OldVisibleItems: Integer);
var
  i: Integer;
  str: string;
  pageNumber: Int64;
  DispIdx: Int64;
  LinePrefix: string;
begin
  if not isChecked or not Assigned(FCheckListBox) then Exit;
  SetCheckListVisualRowHeight(ListViewVisualRowHeight);
  if (OldVisibleItems = VisibleItems) and (FCheckListBox.Items.Count = VisibleItems) then
    Exit;

  FCheckListBox.Items.BeginUpdate;
  try
    while FCheckListBox.Items.Count > VisibleItems do
      FCheckListBox.Items.Delete(FCheckListBox.Items.Count - 1);
    LinePrefix := FTrLinePrefix;
    if LinePrefix = '' then
      LinePrefix := TrText('Line:');
    if (not FFilterActive) and Assigned(FSourceFileStream) then
      EnsureLineCacheForPage;
    for i := 0 to VisibleItems - 1 do
    begin
      if not Assigned(FSourceFileStream) then Break;
      if FFilterActive then
      begin
        pageNumber := FilteredIndexToReal(Offset + Int64(i));
        if pageNumber < 0 then Continue;
        DispIdx := pageNumber + 1;
        str := LinePrefix + ' ' + FormatFloat('#,', DispIdx) + '  ' +
          getLineContentsFromLineIndex(DispIdx - 1);
      end
      else
      begin
        DispIdx := Offset + (i + 1) + CsvDataStartLine;
        str := LinePrefix + ' ' + FormatFloat('#,', DispIdx) + '  ' +
          getLineContentsFromLineIndex(DispIdx - 1);
      end;
      if i < FCheckListBox.Items.Count then
      begin
        FCheckListBox.Items[i] := str;
        FCheckListBox.Items.Objects[i] := TObject(Integer(DispIdx));
      end
      else
        FCheckListBox.Items.AddObject(str, TObject(Integer(DispIdx)));
    end;
    if isAllChecked then
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
        FCheckListBox.Checked[i] := True;
    end
    else if Assigned(FCheckedLines) then
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
      begin
        pageNumber := Integer(FCheckListBox.Items.Objects[i]);
        FCheckListBox.Checked[i] := FCheckedLines.IndexOf(pageNumber) > -1;
      end;
    end
    else
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
        FCheckListBox.Checked[i] := False;
    end;
  finally
    FCheckListBox.Items.EndUpdate;
  end;
  FCheckListDisplayOffset := Offset;
end;

function TfrmMain.checkedLineExists(const icheckedLine: Int64): Boolean;
begin
  Result := Assigned(FCheckedLines);
  if Result then
    Result := (FCheckedLines.IndexOf(icheckedLine) > -1);
end;

function TfrmMain.isLineChecked(const iLine: Int64): Boolean;
var
  i: Integer;
begin
  Result := False;
  if Assigned(FCheckedLines) then
  begin
    for i := 0 to FCheckedLines.Count - 1 do
    begin
      if (FCheckedLines.Items[i] = iLine) then
      begin
        Result := True;
        Break;
      end;
    end;
  end;
end;

procedure TfrmMain.showCheckBoxes;
var
  EnablingSelect: Boolean;
begin
  if ListviewIsEmpty then Exit;
  EnablingSelect := not isChecked;
  isChecked := not isChecked;
  FCheckListDisplayOffset := -1;
  if Assigned(FCheckListBox) then
  begin
    FreeAndNil(FCheckListBox);
    FCheckListVisualRowHeight := 0;
    FCheckListLinePrefixPx := 0;
  end;
  if EnablingSelect then
  begin
    BeginListViewZoomVisualBatch;
    FSuppressScrollBarChange := True;
  end;
  try
    if isChecked then
    begin
      if Assigned(FReadViewHost) then
        FCheckListBox := TCheckListBox.Create(FReadViewHost)
      else if Assigned(pnlCenter) then
        FCheckListBox := TCheckListBox.Create(pnlCenter)
      else
        FCheckListBox := TCheckListBox.Create(pnlMain);
      if Assigned(FReadViewHost) then
        FCheckListBox.Parent := FReadViewHost
      else if Assigned(pnlCenter) then
        FCheckListBox.Parent := pnlCenter
      else
        FCheckListBox.Parent := pnlMain;
      FCheckListBox.Font.Name := ListView1.Font.Name;
      FCheckListBox.Font.Size := ListView1.Font.Size;
      FCheckListBox.Font.Style := ListView1.Font.Style;
      FCheckListBox.Align := alClient;
      FCheckListBox.OnClickCheck := CheckListBox1ClickCheck;
      FCheckListBox.OnKeyDown := CheckListBox1KeyDown;
      FCheckListBox.OnDblClick := CheckListBox1DblClick;
      FCheckListBox.OnMouseDown := CheckListBox1MouseDown;
      FCheckListBox.OnMouseMove := CheckListBox1MouseMove;
      FCheckListBox.OnMouseUp := CheckListBox1MouseUp;
      FCheckListBox.OnDrawItem := CheckListBox1DrawItem;
      FCheckListBox.PopupMenu := popupmenuListView;
      FCheckListBox.Style := lbOwnerDrawFixed;
      FCheckListBox.OnMeasureItem := nil;
      FCheckListBox.TabStop := True;
      FCheckListBox.ShowHint := True;
      FCheckListBox.ParentShowHint := False;
      FCheckListBox.Visible := True;
      FCheckListBox.HandleNeeded;
      if Assigned(FReadViewHeader) then
        FReadViewHeader.BringToFront;
      SetCheckListVisualRowHeight(ListViewVisualRowHeight);
      UpdateCheckListLinePrefixAutoWidth;
      UpdateListViewLineColumnAutoWidth;
    end
    else
    begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
    end;
    SyncVerticalScrollBarRange;
    showChecked;
    SyncScrollBarsForFilterMode;
  finally
    if EnablingSelect then
    begin
      FSuppressScrollBarChange := False;
      EndListViewZoomVisualBatch;
    end;
  end;
  UpdateScriptScopeRBFromChecks;
  if Assigned(FLvTools) then
    FLvTools.BringToFront;
  UpdateListViewLineToolsEnabled;
  if isChecked and Assigned(FCheckListBox) and FCheckListBox.CanFocus then
    FCheckListBox.SetFocus;
end;

procedure TfrmMain.exportToClipBoard;
var
  F: Tform;
  MSG: Tlabel;
  shape: TShape;
  progressBar: TProgressBar;
  nline : integer;
  totalLinesExport: integer;
  indx: integer;
  iLine: int64;
  strCurrentLine: string;
  fileSize: Int64;
  CheckVar: Boolean;
begin
  memoExportedLines.Clear;

  fileSize := UnUtils.GetFileSize(edtFileName.Text);
  if (fileSize > 400000000) and (isAllChecked) then //more than 50MB
    if MessageDlgCustom('The file contains more than 50MB. It may crash the application. Confirm?', mtConfirmation,
      [mbYes,mbNo],
      ['&Yes, Confirmed.',
      '&No, Abort this operation.'],
      CheckVar, False, nil)//nil = no custom font
      = mrNo then Exit;

  if isAllChecked then
    totalLinesExport := totalLines
  else
  begin
    if (not existsCheckedRows(FCheckedLines)) then
    begin
      if not isChecked then ActionCheckBoxesListView.Execute;
      Exit;
    end;
    totalLinesExport := FCheckedLines.Count - 1;
  end;

  if totalLinesExport > EXPORT_CLIPBOARD_MAX_LINES then
  begin
    UnUtils.MessageBox(TrText('Information'),
      Format(TrText('Too many lines to export to the clipboard (%d; max %d). Reduce the range or save to a text file.'),
        [totalLinesExport, EXPORT_CLIPBOARD_MAX_LINES]));
    Exit;
  end;

  strCurrentLine := '';
  nline := 1;

  F:= TForm.Create(Self);
  try
    try
      F.Position := poScreenCenter;
      F.Width := round(Application.MainForm.Width/5);
      F.Height := round(Application.MainForm.Height/4)-100;
      F.FormStyle   := fsNormal;
      F.BorderStyle := bsDialog;
      shape := TShape.Create(Self);
      shape.Parent := F;
      shape.Align := alClient;
      MSG:=  TLabel.Create(Self);
      MSG.Parent := F;
      MSG.Transparent := true;
      MSG.AutoSize := false;
      MSG.Width := F.Width;//100;
      MSG.Top := MSG.Top + 5;
      MSG.Alignment := Classes.taCenter;
      MSG.Font.Style := [fsBold];
      MSG.Font.Name := 'Tahoma';
      MSG.Font.Size := 10;
      Msg.Caption := TrText('Exporting');

      progressBar := TProgressBar.Create(Self);
      progressBar.Align := alBottom;
      progressBar.Top := MSG.Top + 14;
      progressBar.Height := 30;
      progressBar.parent := F;
      F.Show;
      progressBar.Position := 0;
      progressBar.Max := totalLinesExport;
      Application.ProcessMessages;
      Cursor := crSQLWait;
      if (isAllChecked) then
      begin
        try
          memoExportedLines.Lines.LoadFromFile(edtFileName.Text);
        except on E: Exception do
          UnUtils.MessageBox(TrText('Error'), E.Message);
        end;
      end
      else
      begin
        memoExportedLines.Lines.BeginUpdate;
        try
          for indx := 0 to FCheckedLines.Count - 1 do
          begin
            iLine := FCheckedLines.items[indx];
            if LineExists(iLine) then
            begin
              if (iLine > 0) then
              begin
                strCurrentLine := GetLineContent(iLine);
                memoExportedLines.Lines.Add(strCurrentLine);
                //if not AnsiEndsStr(#13#10, strCurrentLine) then
                //  strCurrentLine := strCurrentLine + #13#10;
                //strLine := strLine + strCurrentLine + #13#10;
                progressBar.Position := nline;
                Application.ProcessMessages;
                Inc(nline);
              end;
            end;
          end;
        finally
          memoExportedLines.Lines.EndUpdate;
        end;  
      end;  
    except on E: Exception do
      UnUtils.MessageBox(TrText('Error'), E.Message);
    end;
    ShowTab(tabExportedLines);
    UnUtils.MessageBox(TrText('Information'), TrText('Content exported to memo.'));
  finally
    Cursor := crDefault;
    F.Close;
    FreeAndNil(F);
  end;
end;


    Item := FToolbarOverflowPopup.Items[I];
    Btn := TsSpeedButton(Pointer(Item.Tag));
    if Assigned(Btn) then
    begin
      Item.Enabled := Btn.Enabled;
      Item.Caption := StringReplace(Btn.Caption, #13#10, '  ', [rfReplaceAll]);

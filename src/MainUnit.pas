var
  i, k: integer;
  auxStr: string;
begin
  auxStr := Trim(Str);
  i := PosBMH(Find, Str);
  Result := Trim(Copy(str, i + length(Find), length(str)));
  k := PosBMH(' ', Result);
  if k > 0 then
    Result := Trim(Copy(Result, 1, k));
end;

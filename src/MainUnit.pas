procedure TfrmMain.SaveMainTabOrderToIni;
var
  i: Integer;
  S: string;
begin
  if (IniName = '') or not Assigned(pgMain) then Exit;
  S := '';
  for i := 0 to pgMain.PageCount - 1 do
  begin
    if pgMain.Pages[i].Name = '' then Continue;
    if S <> '' then
      S := S + ';';
    S := S + pgMain.Pages[i].Name;
  end;
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_MAIN_TAB_ORDER, S, IniName);
end;

procedure TfrmMain.LoadMainTabOrderFromIni;
var
  Names: TArray<string>;
  i, k, Pos0: Integer;
  S: string;
begin
  FTabOrderCustom := False;
  if (IniName = '') or not Assigned(pgMain) then Exit;
  S := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_MAIN_TAB_ORDER, IniName));
  if S = '' then Exit;
  Names := S.Split([';']);
  Pos0 := 0;
  for k := 0 to High(Names) do
    for i := 0 to pgMain.PageCount - 1 do
      if SameText(pgMain.Pages[i].Name, Trim(Names[k])) then
      begin
        if pgMain.Pages[i].PageIndex <> Pos0 then
          pgMain.Pages[i].PageIndex := Pos0;
        Inc(Pos0);
        Break;
      end;
  FTabOrderCustom := Pos0 > 0;
end;


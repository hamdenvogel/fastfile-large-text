  Ini: TIniFile;
  H: Integer;
begin
  if (IniName = '') or not Assigned(FFilterBar) then Exit;
  if FilterBarIsFloating then Exit;
  H := FFilterBar.Height;
  if H < FILTER_BAR_HEIGHT then
    H := FILTER_BAR_HEIGHT;
  if H > FILTER_BAR_MAX_HEIGHT then
    H := FILTER_BAR_MAX_HEIGHT;
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteInteger('UIPrefs', 'FilterBarHeight', H);
  finally
    Ini.Free;
  end;
end;


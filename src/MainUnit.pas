procedure TfrmMain.ConsumerRAGInputKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then
  begin
    Key := 0;
    ConsumerRAGSendClick(Sender);
  end
  else if Key = VK_ESCAPE then
  begin
    Key := 0;
    if Assigned(FConsumerRAGInputEdit) then
      FConsumerRAGInputEdit.Text := '';
  end;
end;

procedure TfrmMain.TrimConsumerRAGTranscript;
var
  CurText: string;
  OverBy: Integer;
begin
  if not Assigned(FConsumerRAGMemo) then Exit;
  CurText := FConsumerRAGMemo.Text;
  if Length(CurText) <= MAX_CHARS then Exit;
  OverBy := Length(CurText) - MAX_CHARS;
  FConsumerRAGMemo.SelStart := 0;
  FConsumerRAGMemo.SelLength := OverBy + 200;
  FConsumerRAGMemo.SelText := '';
end;

procedure TfrmMain.AppendConsumerRAGTranscriptEx(const AKind, AText: string);
var
  Stamp: string;
  KindText: string;
  LineText: string;
  KindColor: TColor;
begin
  EnsureConsumerRAGPanel;
  if not Assigned(FConsumerRAGMemo) then Exit;

  Stamp := FormatDateTime('hh:nn:ss', Now);
  KindText := UpperCase(Trim(AKind));
  if KindText = '' then KindText := 'INFO';
  LineText := '[' + Stamp + '] [' + KindText + '] ' + AText;

  KindColor := clWindowText;
  if KindText = 'ERROR' then KindColor := clRed
  else if KindText = 'PROMPT' then KindColor := clNavy
  else if KindText = 'STATUS' then KindColor := clTeal
  else if KindText = 'YOU' then KindColor := clPurple
  else if KindText = 'PY' then KindColor := clBlack;

  FConsumerRAGMemo.Lines.BeginUpdate;
  try
    FConsumerRAGMemo.SelStart := Length(FConsumerRAGMemo.Text);
    FConsumerRAGMemo.SelLength := 0;
    FConsumerRAGMemo.SelAttributes.Color := KindColor;
    FConsumerRAGMemo.SelText := LineText + sLineBreak;
    FConsumerRAGMemo.SelAttributes.Color := clWindowText;
    TrimConsumerRAGTranscript;
    FConsumerRAGMemo.SelStart := Length(FConsumerRAGMemo.Text);
    FConsumerRAGMemo.Perform(EM_SCROLLCARET, 0, 0);
  finally
    FConsumerRAGMemo.Lines.EndUpdate;
  end;
  MirrorConsumerToAssistant(KindText, AText);
end;


function TfrmMain.AssistantCbGetRecentFilePathByListIndex(AIndex1Based: Integer): string;
var
  LV: TListView;
  Item: TListItem;
  Idx: Integer;
begin
  Result := '';
  if Assigned(FRecentFiles) and (FRecentFiles.Count = 0) then
    LoadRecentFiles;

  if Assigned(lvRecentFiles) then
    LV := lvRecentFiles
  else if Assigned(RecentFilesTabFind('lvRecentFiles')) and
    (RecentFilesTabFind('lvRecentFiles') is TListView) then
    LV := RecentFilesTabFind('lvRecentFiles') as TListView
  else
    LV := nil;
  if not Assigned(LV) then Exit;

  if LV.Items.Count = 0 then
    PopulateRecentFilesTab;
  if LV.Items.Count = 0 then Exit;

  if AIndex1Based < 0 then
    Idx := LV.Items.Count + AIndex1Based
  else
    Idx := AIndex1Based - 1;
  if (Idx < 0) or (Idx >= LV.Items.Count) then Exit;

  Item := LV.Items[Idx];
  if not Assigned(Item) or (Item.SubItems.Count < 1) then Exit;
  Result := IncludeTrailingPathDelimiter(Trim(Item.SubItems[0])) + Item.Caption;
end;

procedure TfrmMain.AssistantCbOpenRecentFileByIndex(AIndex1Based: Integer);
var
  P: string;
begin
  P := Trim(AssistantCbGetRecentFilePathByListIndex(AIndex1Based));
  if P = '' then
  begin
    FastFileMessageBox(PChar(Format(TrText('Assistant.Error.RecentListOutOfRange'),
      [AIndex1Based])), PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  AssistantCbOpenFile(P);
end;

function TfrmMain.AssistantCbGetOpenFilePath: string;
begin
  { Implied "this file" resolves from edtFileName first (CurrentEffectiveFilePath). }
  Result := Trim(CurrentEffectiveFilePath);
  if (Result = '') or (Result = SELECTTEXT) then
    Result := Trim(edtFileName.Text);
  if (Result = '') or (Result = SELECTTEXT) then
    Result := Trim(fFileName);
  if (Result = '') or (Result = SELECTTEXT) then
    Result := '';
end;

procedure TfrmMain.AssistantCbSetFileNameBox(const APath: string);
var
  P, Cur: string;
begin
  P := Trim(APath);
  if (P = '') or (P = SELECTTEXT) then Exit;
  Cur := Trim(CurrentEffectiveFilePath);
  if (Cur <> '') and SameFileName(P, Cur) then Exit;
  edtFileName.Text := P;
  ApplySessionReadOnlyFilenameDecoration;
end;

function TfrmMain.AssistantCbGetOpenFileLineCount: Int64;
var
  Box, Loaded: string;
begin
  Box := Trim(CurrentEffectiveFilePath);
  Loaded := Trim(fFileName);
  if (Box <> '') and (Loaded <> '') and (not SameFileName(Box, Loaded)) then
  begin
    Result := 0;
    Exit;
  end;
  Result := totalLines;
  if Result < 0 then
    Result := 0;
end;

function TfrmMain.AssistantCbGetOpenFileDiskInfo(out ACreated, AAccessed, AModified: TDateTime;
  out ASizeBytes: Int64): Boolean;
var
  P: string;
  SR: TSearchRec;
begin
  Result := False;
  ACreated := 0;
  AAccessed := 0;
  AModified := 0;
  ASizeBytes := 0;
  P := AssistantCbGetOpenFilePath;
  if (P = '') or (not FileExists(P)) then Exit;
  if not DSiWin32.DSiGetFileTimes(P, ACreated, AAccessed, AModified) then
    Exit;
  if FindFirst(P, faAnyFile, SR) = 0 then
  try
    ASizeBytes := SR.Size;
  finally
    FindClose(SR);
  end;
  Result := True;
end;

function TfrmMain.AssistantCbGetContext: string;
var
  P: string;
  LV: TListView;
  I, MaxN: Integer;
  Extra: string;
  CreatedAt, AccessedAt, ModifiedAt: TDateTime;
  SizeBytes: Int64;
begin
  P := AssistantCbGetOpenFilePath;
  if P = '' then
    Result := 'file='
  else
    Result := 'file=' + P;
  if totalLines > 0 then
    Result := Result + ';lines=' + IntToStr(totalLines);
  if (P <> '') and AssistantCbGetOpenFileDiskInfo(CreatedAt, AccessedAt, ModifiedAt, SizeBytes) then
  begin
    Result := Result +
      ';created=' + FormatDateTime('yyyy-mm-dd hh:nn:ss', CreatedAt) +
      ';modified=' + FormatDateTime('yyyy-mm-dd hh:nn:ss', ModifiedAt) +
      ';accessed=' + FormatDateTime('yyyy-mm-dd hh:nn:ss', AccessedAt) +
      ';size_bytes=' + IntToStr(SizeBytes);
  end;
  if FFilterActive then
  begin
    Result := Result + ';filter_active=1';
    Extra := Trim(FFilterText);
    Extra := StringReplace(Extra, ';', ',', [rfReplaceAll]);
    Extra := StringReplace(Extra, #13#10, ' ', [rfReplaceAll]);
    Extra := StringReplace(Extra, #10, ' ', [rfReplaceAll]);
    if Extra <> '' then
      Result := Result + ';filter_text=' + Extra;
    Result := Result + ';filter_hits=' + IntToStr(FFilteredCount);
    if FFilterStreamPartial then
      Result := Result + ';filter_partial=1'
    else
      Result := Result + ';filter_partial=0';
  end
  else
    Result := Result + ';filter_active=0';
  if Assigned(FFilterBar) and FFilterBar.Visible then
    Result := Result + ';filter_bar_visible=1'
  else
    Result := Result + ';filter_bar_visible=0';
  if isChecked then
    Result := Result + ';select_mode=1';
  if FTailActive then
    Result := Result + ';tail_active=1';

  Extra := '';
  if Assigned(lvRecentFiles) then
    LV := lvRecentFiles
  else if Assigned(RecentFilesTabFind('lvRecentFiles')) and
    (RecentFilesTabFind('lvRecentFiles') is TListView) then
    LV := RecentFilesTabFind('lvRecentFiles') as TListView
  else
    LV := nil;
  if Assigned(LV) then
  begin
    if LV.Items.Count = 0 then
      PopulateRecentFilesTab;
    MaxN := LV.Items.Count;
    if MaxN > 12 then MaxN := 12;
    for I := 0 to MaxN - 1 do
    begin
      P := AssistantCbGetRecentFilePathByListIndex(I + 1);
      if P <> '' then
        Extra := Extra + ';recent_' + IntToStr(I + 1) + '=' + P;
    end;
    if LV.Items.Count > 0 then
      Extra := Extra + ';recent_list_count=' + IntToStr(LV.Items.Count);
  end;
  Result := Result + Extra;
end;


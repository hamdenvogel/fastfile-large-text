procedure TfrmMain.QueueConsumerAIProtocolLine(const ALine: string);
type
  PLineCopy = ^string;
var
  Copy: PLineCopy;
begin
  if not Assigned(Self) then Exit;
  if Handle = 0 then
  begin
    HandleConsumerAIProtocolLine(ALine);
    Exit;
  end;
  New(Copy);
  Copy^ := ALine;
  if not PostMessage(Handle, WM_USER + 436, 0, LPARAM(Copy)) then
  begin
    Dispose(Copy);
    HandleConsumerAIProtocolLine(ALine);
  end;
end;

procedure TfrmMain.WMConsumerAIProtocolLine(var Msg: TMessage);
type
  PLineCopy = ^string;
var
  Copy: PLineCopy;
  Line: string;
begin
  Copy := Pointer(Msg.LParam);
  Msg.Result := 0;
  if Copy = nil then Exit;
  try
    Line := Copy^;
  finally
    Dispose(Copy);
  end;
  try
    HandleConsumerAIProtocolLine(Line);
  except
    on E: Exception do
      LogConsumerAIDebug('HANDLER_ERR | ' + E.ClassName + ': ' + E.Message);
  end;
end;


function TfrmMain.TailMacroSuggestionsExtractExampleBlock: string;
var
  SL: TStringList;
  LineIdx, StartIdx, EndIdx, I: Integer;
  L: string;
  SelStart: Integer;
begin
  Result := '';
  if not Assigned(FTailMacroSuggestionsMemo) then Exit;
  SL := TStringList.Create;
  try
    SL.Text := FTailMacroSuggestionsMemo.Lines.Text;
    if SL.Count = 0 then Exit;
    SelStart := FTailMacroSuggestionsMemo.SelStart;
    LineIdx := FTailMacroSuggestionsMemo.Perform(EM_EXLINEFROMCHAR, 0, SelStart);
    if LineIdx < 0 then LineIdx := 0;
    if LineIdx >= SL.Count then LineIdx := SL.Count - 1;

    StartIdx := LineIdx;
    while (StartIdx > 0) and (PosBMH('def transform', SL[StartIdx]) = 0) and
      (Copy(Trim(SL[StartIdx]), 1, 2) <> '# ') do
      Dec(StartIdx);
    if (StartIdx >= 0) and (Copy(Trim(SL[StartIdx]), 1, 2) = '# ') then
    begin
      { keep StartIdx on # comment }
    end
    else
    begin
      while (StartIdx > 0) and (PosBMH('def transform', SL[StartIdx]) = 0) do
        Dec(StartIdx);
    end;
    if (StartIdx < 0) or (PosBMH('def transform', SL[StartIdx]) = 0) then
    begin
      for I := 0 to SL.Count - 1 do
        if PosBMH('def transform', SL[I]) > 0 then
        begin
          StartIdx := I;
          Break;
        end;
    end;
    if StartIdx < 0 then Exit;

    EndIdx := StartIdx;
    while EndIdx < SL.Count - 1 do
    begin
      L := Trim(SL[EndIdx + 1]);
      if (L <> '') and (L = FF_TAIL_MACRO_EXAMPLE_SEP) then Break;
      Inc(EndIdx);
    end;
    for I := StartIdx to EndIdx do
    begin
      if Result <> '' then Result := Result + sLineBreak;
      Result := Result + SL[I];
    end;
  finally
    SL.Free;
  end;
end;


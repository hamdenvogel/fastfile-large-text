{ TFilterThread Implementation                                                 }
{ ============================================================================ }

constructor TFilterThread.Create(AOwner: TfrmMain;
  const AFileName, AIndexFileName, ANeedle: string;
  ACaseSensitive: Boolean; ATotalLines: Int64; AMatchMode: TFilterMatchMode);
var
  BitsNeeded: Int64;
begin
  inherited Create(True);
  FreeOnTerminate := True;
  FOwner := AOwner;
  FFileName := AFileName;
  FIndexFileName := AIndexFileName;
  FMatchMode := AMatchMode;
  FNeedleText := ANeedle;
  if Assigned(AOwner) then
    FEncoding := AOwner.EffectiveDisplayEncoding
  else
    FEncoding := '';
  FEncoding := ResolveTextEncoding(AFileName, FEncoding);
  FNeedle := UnicodeTextToFileBytes(ANeedle, FEncoding);
  FCaseSensitive := ACaseSensitive;
  FTotalLines := ATotalLines;
  FFilteredCount := 0;
  FAbortMsg := '';
  BitsNeeded := (ATotalLines + 7) div 8;
  { GetMem size is Integer: avoid silent wrap on huge line counts. }
  if (ATotalLines > 0) and (BitsNeeded > MaxInt) then
  begin
    FBitsSize := 0;
    FBits := nil;
    FAbortMsg := TrText('Filter: line count too large for filter memory (32-bit limit).');
  end
  else begin
    FBitsSize := Integer(BitsNeeded);
    if FBitsSize > 0 then begin
      GetMem(FBits, FBitsSize);
      FillChar(FBits^, FBitsSize, 0);
    end else
      FBits := nil;
  end;
  Resume;
end;

destructor TFilterThread.Destroy;
begin
  if Assigned(FBits) then FreeMem(FBits);
  inherited;
end;

procedure TFilterThread.NotifyOwner;
begin
  // Transfer ownership of bitset and jump table to owner
  FOwner.FFilterUseHitsList := False;
  SetLength(FOwner.FFilterHitsList, 0);
  FOwner.FFilterBits := FBits;
  FOwner.FFilterBitsSize := FBitsSize;
  FOwner.FFilteredCount := FFilteredCount;
  FOwner.FFilterTotalLines := FTotalLines;
  FOwner.FFilterJumpTable := FJumpTable;
  FBits := nil; // prevent destructor from freeing
  FOwner.FilterThreadDone;
end;

procedure TFilterThread.SyncFilterProgress;
begin
  if Assigned(FOwner) then
    FOwner.UpdateFilterBuildProgress(FProgLines, FProgTotalLines);
end;

procedure TFilterThread.SyncFilterFailed;
begin
  if Assigned(FOwner) then
    FOwner.FinishFilterThreadFailed(FAbortMsg);
end;

{ ============================================================================ }
{ THREAD: export filtered lines (assistant / large match sets)                 }
{ ============================================================================ }

function TExportFilteredLinesThread.LinePassesExportVerify(const ALineAnsi: AnsiString): Boolean;
begin
  if not FVerifyExport then
    Result := True
  else if Assigned(FOwner) then
    Result := FOwner.AssistantExportLineMatchesNeedle(ALineAnsi, FVerifyNeedle,
      FVerifyCaseSensitive, FVerifyMatchMode)
  else
    Result := True;
end;

constructor TExportFilteredLinesThread.Create(AOwner: TfrmMain; const ASourceFile,
  AOutputFile: string; AFilteredCount: Int64; AUseHitsFile: Boolean;
  const AHitsList: TInt64DynArray; ABits: PFFByteArray; ABitsSize: Integer;
  const AJumpTable: TInt64DynArray; AFilterTotalLines: Int64; AUseStreamExport: Boolean;
  const AVerifyNeedle: string; AVerifyCaseSensitive: Boolean;
  AVerifyMatchMode: TFilterMatchMode; AVerifyExport: Boolean);
begin
  inherited Create(True);
  FreeOnTerminate := True;
  FOwner := AOwner;
  FSourceFile := ASourceFile;
  FOutputFile := AOutputFile;
  FFilteredCount := AFilteredCount;
  FUseHitsFile := AUseHitsFile;
  FHitsList := AHitsList;
  FBits := ABits;
  FBitsSize := ABitsSize;
  FJumpTable := AJumpTable;
  FFilterTotalLines := AFilterTotalLines;
  FUseStreamExport := AUseStreamExport;
  FVerifyExport := AVerifyExport;
  FVerifyCaseSensitive := AVerifyCaseSensitive;
  FVerifyMatchMode := AVerifyMatchMode;
  FVerifyNeedle := AVerifyNeedle;
  FExportedCount := 0;
  FSuccess := False;
  FLoadingMsg := TrText('Exporting lines to file...');
  FPercent := 0;
  Resume;
end;

procedure TExportFilteredLinesThread.SyncShowLoading;
begin
  TfrmSmoothLoading.ShowLoading(FLoadingMsg, False);
end;

procedure TExportFilteredLinesThread.SyncHideLoading;
begin
  TfrmSmoothLoading.HideLoading;
end;

procedure TExportFilteredLinesThread.SyncFinish;
begin
  TfrmSmoothLoading.HideLoading;
  if FSuccess then
    FastFileMessageBox(PChar(Format(TrText('%d filtered line(s) exported to file.'),
      [FExportedCount])), PChar(TrText('Assistant.Status.ExportMatching')),
      MB_OK or MB_ICONINFORMATION)
  else
    FastFileMessageBox(PChar(TrText('Filter has no results to export.')),
      PChar(TrText('Assistant.Status.ExportMatching')), MB_OK or MB_ICONWARNING);
end;

procedure TExportFilteredLinesThread.SyncReadOneLine;
var
  RealIdx: Int64;
  S: string;
  j: Integer;
begin
  FSyncLineAnsi := '';
  if not Assigned(FOwner) then Exit;
  RealIdx := FilteredIdxToReal(FSyncFilteredIdx);
  if RealIdx < 0 then Exit;
  if RealIdx > MaxInt then Exit;
  S := FOwner.GetLineContent(Integer(RealIdx));
  j := 1;
  while j <= Length(S) do
    if S[j] = #0 then
      Delete(S, j, 1)
    else
      Inc(j);
  if Assigned(FOwner) then
    FSyncLineAnsi := UnicodeTextToFileBytes(S, FOwner.EffectiveDisplayEncoding)
  else
    FSyncLineAnsi := UnicodeTextToFileBytes(S, '');
  if not LinePassesExportVerify(FSyncLineAnsi) then
    FSyncLineAnsi := '';
end;

function TExportFilteredLinesThread.FilteredIdxToReal(FilteredIdx: Int64): Int64;
var
  JumpIdx: Integer;
  StartReal, Count, I: Int64;
  ByteIdx, BitIdx: Integer;
  HitsStream: TFileStream;
begin
  Result := -1;
  if (FilteredIdx < 0) or (FilteredIdx >= FFilteredCount) then Exit;
  if FUseHitsFile then
  begin
    HitsStream := ZeroScanOpenFilterHitsReader(I);
    try
      if Assigned(HitsStream) then
        Result := ZeroScanReadFilterHit(HitsStream, FilteredIdx);
    finally
      HitsStream.Free;
    end;
    Exit;
  end;
  if Length(FHitsList) > 0 then
  begin
    if FilteredIdx <= High(FHitsList) then
      Result := FHitsList[FilteredIdx];
    Exit;
  end;
  if not Assigned(FBits) then Exit;
  JumpIdx := FilteredIdx div 1024;
  if (JumpIdx > 0) and (JumpIdx <= High(FJumpTable)) then
  begin
    StartReal := FJumpTable[JumpIdx];
    Count := Int64(JumpIdx) * 1024;
  end
  else
  begin
    StartReal := 0;
    Count := 0;
  end;
  I := StartReal;
  while I < FFilterTotalLines do
  begin
    ByteIdx := I div 8;
    if ByteIdx >= FBitsSize then Break;
    BitIdx := I mod 8;
    if (FBits^[ByteIdx] and (1 shl BitIdx)) <> 0 then
    begin
      if Count = FilteredIdx then
      begin
        Result := I;
        Exit;
      end;
      Inc(Count);
    end;
    Inc(I);
  end;
end;

function TExportFilteredLinesThread.ReadLineByIndexMMF(const LineIdx0: Int64;
  MMF: TMMFReader; IdxStream: TFileStream): AnsiString;
var
  LineNum: Int64;
  OffsetStr: AnsiString;
  StartOffset, EndOffset, ReadPos, FSize: Int64;
  LineLength: Integer;
  Buffer: AnsiString;
  P: PByte;
  Contiguous: Cardinal;
begin
  Result := '';
  LineNum := LineIdx0 + 1;
  if (LineNum < 1) or (LineNum > FFilterTotalLines) then Exit;
  FSize := MMF.FileSize;
  SetLength(OffsetStr, 18);
  IdxStream.Seek(Int64(LineNum - 1) * INDEX_RECORD_SIZE, soFromBeginning);
  IdxStream.Read(Pointer(OffsetStr)^, 18);
  StartOffset := StrToInt64Def(Trim(string(OffsetStr)), -1);
  if StartOffset = -1 then Exit;
  StartOffset := Abs(StartOffset);
  if (Int64(LineNum) * INDEX_RECORD_SIZE) < IdxStream.Size then
  begin
    IdxStream.Seek(Int64(LineNum) * INDEX_RECORD_SIZE, soFromBeginning);
    IdxStream.Read(Pointer(OffsetStr)^, 18);
    EndOffset := StrToInt64Def(Trim(string(OffsetStr)), FSize + 1);
  end
  else
    EndOffset := FSize + 1;
  EndOffset := Abs(EndOffset);
  LineLength := EndOffset - StartOffset;
  if LineLength <= 0 then Exit;
  if LineLength > MAX_LINE_LEN then
    LineLength := MAX_LINE_LEN;
  ReadPos := StartOffset - 1;
  SetLength(Buffer, LineLength);
  P := MMF.PtrAt(ReadPos, LineLength, Contiguous);
  if Assigned(P) and (Contiguous >= Cardinal(LineLength)) then
    Move(P^, Pointer(Buffer)^, LineLength)
  else
    MMF.ReadBytes(ReadPos, Pointer(Buffer)^, LineLength);
  while (Length(Buffer) > 0) and (Buffer[Length(Buffer)] in [#10, #13]) do
    SetLength(Buffer, Length(Buffer) - 1);
  Result := Buffer;
end;

procedure TExportFilteredLinesThread.ExecuteStreamExport;
var
  Idx, RealIdx, Done: Int64;
  MMF: TMMFReader;
  IdxStream: TFileStream;
  DestWriter: TBufferedTextWriter;
  LineAnsi: AnsiString;
  IndexFileName: string;
begin
  MMF := nil;
  IdxStream := nil;
  DestWriter := nil;
  IndexFileName := ResolveWorkingLineIndexPath;
  if IndexFileName = '' then
  begin
    ExecuteOwnerLineExport;
    Exit;
  end;
  try
    MMF := TMMFReader.Create(FSourceFile);
    IdxStream := TFileStream.Create(IndexFileName, fmOpenRead or fmShareDenyNone);
    DestWriter := TBufferedTextWriter.Create(FOutputFile, 4 * 1024 * 1024);
    DestWriter.LineBreak := OutputEolForFile(FSourceFile);
    Done := 0;
    Idx := 0;
    while Idx < FFilteredCount do
    begin
      if Terminated or TfrmSmoothLoading.CancelRequested then Break;
      RealIdx := FilteredIdxToReal(Idx);
      if RealIdx >= 0 then
      begin
        LineAnsi := ReadLineByIndexMMF(RealIdx, MMF, IdxStream);
        if LinePassesExportVerify(LineAnsi) then
        begin
          if LineAnsi <> '' then
            DestWriter.WriteLine(LineAnsi)
          else
            DestWriter.WriteLine('');
          Inc(FExportedCount);
        end;
      end;
      Inc(Done);
      Inc(Idx);
      if (Done mod FF_EXPORT_STREAM_PROGRESS_EVERY) = 0 then
      begin
        if FFilteredCount > 0 then
          FPercent := Round((Done * 100) / FFilteredCount)
        else
          FPercent := 100;
        if FPercent > 100 then FPercent := 100;
        TfrmSmoothLoading.PostProgressFromWorker(FPercent);
      end;
    end;
    FSuccess := FExportedCount > 0;
    if FFilteredCount > 0 then
      TfrmSmoothLoading.PostProgressFromWorker(100);
  finally
    FreeAndNil(DestWriter);
    FreeAndNil(IdxStream);
    FreeAndNil(MMF);
  end;
end;

procedure TExportFilteredLinesThread.ExecuteOwnerLineExport;
var
  Idx, Done: Int64;
  DestWriter: TBufferedTextWriter;
begin
  DestWriter := nil;
  try
    DestWriter := TBufferedTextWriter.Create(FOutputFile, 4 * 1024 * 1024);
    DestWriter.LineBreak := OutputEolForFile(FSourceFile);
    Done := 0;
    Idx := 0;
    while Idx < FFilteredCount do
    begin
      if Terminated or TfrmSmoothLoading.CancelRequested then Break;
      FSyncFilteredIdx := Idx;
      Synchronize(SyncReadOneLine);
      if FSyncLineAnsi <> '' then
        DestWriter.WriteLine(FSyncLineAnsi)
      else
        DestWriter.WriteLine('');
      Inc(FExportedCount);
      Inc(Done);
      Inc(Idx);
      if (Done mod FF_EXPORT_OWNER_PROGRESS_EVERY) = 0 then
      begin
        if FFilteredCount > 0 then
          FPercent := Round((Done * 100) / FFilteredCount)
        else
          FPercent := 100;
        if FPercent > 100 then FPercent := 100;
        TfrmSmoothLoading.PostProgressFromWorker(FPercent);
      end;
    end;
    FSuccess := FExportedCount > 0;
    if FFilteredCount > 0 then
      TfrmSmoothLoading.PostProgressFromWorker(100);
  finally
    FreeAndNil(DestWriter);
  end;
end;

procedure TExportFilteredLinesThread.Execute;
begin
  if FFilteredCount <= 0 then
  begin
    Synchronize(SyncFinish);
    Exit;
  end;
  Synchronize(SyncShowLoading);
  try
    if FUseStreamExport then
      ExecuteStreamExport
    else
      ExecuteOwnerLineExport;
  except
    FSuccess := False;
    Synchronize(SyncHideLoading);
  end;
  Synchronize(SyncFinish);
end;

procedure TFilterThread.Execute;
var
  SourceStream: TFileStream;
  IndexStream: TFileStream;
  OffsetStr: AnsiString;
  StartOffset, EndOffset, FSize: Int64;
  LineLength: Integer;
  Buffer: AnsiString;
  LineContent: AnsiString;
  I: Int64;
  MatchCount: Int64;
  JumpIdx: Integer;
  ByteIdx, BitIdx: Integer;
  NeedleLen: Integer;
  Matched: Boolean;
  RegObj: OleVariant;
  RegexReady: Boolean;
  ComNeedUninit: Boolean;
  ComHr: HRESULT;
begin
  SourceStream := nil;
  IndexStream := nil;
  RegexReady := False;
  ComNeedUninit := False;

  { VBScript.RegExp exige COM nesta thread (CreateOleObject falha com "CoInitialize not called"). }
  if FMatchMode = fmmRegex then
  begin
    ComHr := CoInitialize(nil);
    if (ComHr <> S_OK) and (ComHr <> S_FALSE) then
    begin
      FAbortMsg := TrText('Could not initialize COM for the regex filter.');
      Synchronize(SyncFilterFailed);
      Exit;
    end;
    ComNeedUninit := True;
  end;

  try
    if FMatchMode = fmmRegex then
    begin
      try
        RegObj := CreateOleObject('VBScript.RegExp');
        RegObj.Pattern := FNeedleText;
        RegObj.Global := False;
        RegObj.IgnoreCase := not FCaseSensitive;
        RegObj.Multiline := True;
        RegexReady := True;
      except
        FAbortMsg := TrText('VBScript.RegExp is not available (invalid pattern or missing component).');
        Synchronize(SyncFilterFailed);
        Exit;
      end;
    end;

    if (FTotalLines > 0) and not Assigned(FBits) then
    begin
      if Trim(FAbortMsg) = '' then
        FAbortMsg := TrText('Filter: line count too large for filter memory (32-bit limit).');
      Synchronize(SyncFilterFailed);
      Exit;
    end;

    SourceStream := TFileStream.Create(FFileName, fmOpenRead or fmShareDenyNone);
    if (FIndexFileName = '') or (not FileExists(FIndexFileName)) then
    begin
      FAbortMsg := TrText('No line index is available for search (dense index and checkpoint file are missing). Please read the file again.');
      Synchronize(SyncFilterFailed);
      Exit;
    end;
    IndexStream := TFileStream.Create(FIndexFileName, fmOpenRead or fmShareDenyNone);
    FSize := SourceStream.Size;
    SetLength(OffsetStr, 18);
    NeedleLen := Length(FNeedle);
    MatchCount := 0;
    JumpIdx := 0;
    SetLength(FJumpTable, (FTotalLines div 1024) + 2);
    FProgTotalLines := FTotalLines;

    I := 0;
    while (I < FTotalLines) and (not Terminated) do
    begin
      if (I and $1FFF) = 0 then
      begin
        FProgLines := I;
        if not Terminated then
          Synchronize(SyncFilterProgress);
      end;

      IndexStream.Seek(I * INDEX_RECORD_SIZE, Word(soFromBeginning));
      IndexStream.Read(Pointer(OffsetStr)^, 18);
      StartOffset := StrToInt64Def(Trim(String(OffsetStr)), -1);
      if StartOffset < 1 then begin Inc(I); Continue; end;
      if ((I + 1) * INDEX_RECORD_SIZE) < IndexStream.Size then begin
        IndexStream.Seek((I + 1) * INDEX_RECORD_SIZE, Word(soFromBeginning));
        IndexStream.Read(Pointer(OffsetStr)^, 18);
        EndOffset := StrToInt64Def(Trim(String(OffsetStr)), FSize + 1);
      end else
        EndOffset := FSize + 1;
      LineLength := EndOffset - StartOffset;
      if LineLength <= 0 then begin Inc(I); Continue; end;
      if LineLength > MAX_LINE_LEN_DISPLAY then LineLength := MAX_LINE_LEN_DISPLAY;
      SetLength(Buffer, LineLength);
      SourceStream.Seek(StartOffset - 1, Word(soFromBeginning));
      SourceStream.Read(Pointer(Buffer)^, LineLength);
      while (Length(Buffer) > 0) and (Buffer[Length(Buffer)] in [#10, #13]) do
        SetLength(Buffer, Length(Buffer) - 1);
      Matched := False;
      if FMatchMode = fmmRegex then
      begin
        if RegexReady then
        begin
          try
            Matched := RegObj.Test(WideString(FileBytesToUnicodeText(Buffer, FEncoding)));
          except
            Matched := False;
          end;
        end;
      end
      else if FNeedleText <> '' then
        Matched := UnicodeLineMatches(Buffer, FNeedleText, FEncoding, FCaseSensitive,
          FMatchMode = fmmPrefix);
      if Matched then begin
        ByteIdx := I div 8;
        BitIdx := I mod 8;
        FBits^[ByteIdx] := FBits^[ByteIdx] or (1 shl BitIdx);
        if (MatchCount mod 1024) = 0 then begin
          if JumpIdx >= Length(FJumpTable) then SetLength(FJumpTable, JumpIdx + 1024);
          FJumpTable[JumpIdx] := I;
          Inc(JumpIdx);
        end;
        Inc(MatchCount);
      end;
      Inc(I);
    end;
    FFilteredCount := MatchCount;
    SetLength(FJumpTable, JumpIdx);
    if not Terminated then Synchronize(NotifyOwner);
  finally
    if Assigned(IndexStream) then FreeAndNil(IndexStream);
    if Assigned(SourceStream) then FreeAndNil(SourceStream);
    if ComNeedUninit then
    begin
      CoUninitialize;
      ComNeedUninit := False;
    end;
  end;
end;


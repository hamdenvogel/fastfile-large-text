function TfrmMain.GetLineStartOffset(LineIndex: Int64): Int64;
var
  OffsetBuf: array[0..19] of AnsiChar;
  S: AnsiString;
  BytesRead: Integer;
  // Sparse path
  CkptIdx: Int64;
  SkipCount: Integer;
  ScanBuf: array[0..65535] of Byte;
  ScanRead, ScanI: Integer;
  ScanRemaining: Integer;
  ScanPos: Int64;
begin
  Result := -1;

  if UsesProportionalZeroScanScroll then
  begin
    try
      EnsureZeroScanBytesPerItemInitialized;
      if (FZeroScanBytesPerItem > 0) and
         (Int64(LineIndex) * FZeroScanBytesPerItem >= SourceFileSize64) then
        Exit;
      CkptIdx := Int64(LineIndex) * FZeroScanBytesPerItem;
      if CkptIdx >= SourceFileSize64 then
        CkptIdx := SourceFileSize64 - 1;
      if CkptIdx < 0 then
        CkptIdx := 0;
      SkipCount := 4096;
      if CkptIdx - SkipCount < 0 then SkipCount := CkptIdx;
      Result := 1;
      if SkipCount > 0 then
      begin
        FileStreamSeek64(FSourceFileStream, CkptIdx - SkipCount, Word(soFromBeginning));
        ScanRead := FSourceFileStream.Read(ScanBuf, SkipCount);
        for ScanI := ScanRead - 1 downto 0 do
        begin
          if ScanBuf[ScanI] = FSourceLineTermByte then
          begin
            Result := (CkptIdx - SkipCount) + ScanI + 2;
            Break;
          end;
        end;
      end;
    except
      Result := -1;
    end;
    Exit;
  end;

  if Assigned(FIndexFileStream) then
  begin
    { ---- Dense path ---- }
    try
      FileStreamSeek64(FIndexFileStream,Int64(LineIndex) * INDEX_RECORD_SIZE, Word(soFromBeginning));
      BytesRead := FIndexFileStream.Read(OffsetBuf, 18);
      if BytesRead < 18 then Exit;
      SetString(S, PAnsiChar(@OffsetBuf[0]), 18);
      Result := StrToInt64Def(Trim(string(S)), -1);
    except
      Result := -1;
    end;
  end
  else if Assigned(FCkptFileStream) and Assigned(FSourceFileStream) then
  begin
    { ---- Sparse path: checkpoint + forward scan ---- }
    try
      CkptIdx   := LineIndex div CKPT_INTERVAL;
      SkipCount := LineIndex mod CKPT_INTERVAL;

      FileStreamSeek64(FCkptFileStream,CkptIdx * INDEX_RECORD_SIZE, Word(soFromBeginning));
      BytesRead := FCkptFileStream.Read(OffsetBuf, 18);
      if BytesRead < 18 then Exit;
      SetString(S, PAnsiChar(@OffsetBuf[0]), 18);
      Result := StrToInt64Def(Trim(string(S)), -1);
      if Result <= 0 then begin Result := -1; Exit; end;
      Result := Abs(Result);

      if SkipCount > 0 then
      begin
        ScanRemaining := SkipCount;
        ScanPos := Result - 1;  { 0-based }
        FileStreamSeek64(FSourceFileStream,ScanPos, Word(soFromBeginning));
        while ScanRemaining > 0 do
        begin
          ScanRead := FSourceFileStream.Read(ScanBuf, SizeOf(ScanBuf));
          if ScanRead = 0 then Break;
          for ScanI := 0 to ScanRead - 1 do
          begin
            Inc(ScanPos);
            if ScanBuf[ScanI] = FSourceLineTermByte then
            begin
              Dec(ScanRemaining);
              if ScanRemaining = 0 then Break;
            end;
          end;
        end;
        Result := ScanPos + 1;  { 1-based }
      end;
    except
      Result := -1;
    end;
  end;
end;

function TfrmMain.CountPhysicalLinesUpToByte1Based(const Byte1Based: Int64): Int64;
var
  Target0: Int64;
  Pos0: Int64;
  ReadN: Integer;
  Buf: array of Byte;
  I: Integer;
begin
  Result := 1;
  if (Byte1Based < 1) or (not Assigned(FSourceFileStream)) then Exit;
  Target0 := Byte1Based - 1;
  if Target0 <= 0 then Exit;
  Pos0 := 0;
  SetLength(Buf, COUNT_BUF_SIZE);
  try
    while Pos0 < Target0 do
    begin
      ReadN := COUNT_BUF_SIZE;
      if Pos0 + ReadN > Target0 then
        ReadN := Integer(Target0 - Pos0);
      if ReadN <= 0 then Break;
      FileStreamSeek64(FSourceFileStream, Pos0, Word(soFromBeginning));
      ReadN := FSourceFileStream.Read(Buf[0], ReadN);
      if ReadN <= 0 then Break;
      for I := 0 to ReadN - 1 do
        if Buf[I] = FSourceLineTermByte then
          Inc(Result);
      Inc(Pos0, ReadN);
    end;
  except
    Result := 1;
  end;
end;

function TfrmMain.CountPhysicalLinesInOpenFile: Int64;
var
  Sz: Int64;
  LfCount: Int64;
  Last: Byte;
begin
  { Line count = LF count; +1 only if the file does not end with LF (last partial line). }
  Result := 0;
  if not Assigned(FSourceFileStream) then Exit;
  Sz := SourceFileSize64;
  if Sz <= 0 then Exit;
  LfCount := ZeroScanCountLfInRange(FSourceFileStream, 0, Sz);
  FileStreamSeek64(FSourceFileStream, Sz - 1, Word(soFromBeginning));
  if FSourceFileStream.Read(Last, 1) <> 1 then
  begin
    Result := LfCount;
    if Result < 1 then Result := 1;
    Exit;
  end;
  if Last = FSourceLineTermByte then
    Result := LfCount
  else
    Result := LfCount + 1;
  if Result < 1 then
    Result := 1;
end;

function TfrmMain.LineStartByte1BasedOnOrBefore(const Byte1Based: Int64): Int64;
var
  ScanFrom0, ReadN, I: Integer;
  EndPos0, ScanLen: Int64;
  Buf: array[0..65535] of Byte;
begin
  Result := 1;
  if (Byte1Based < 1) or (not Assigned(FSourceFileStream)) then Exit;
  if Byte1Based = 1 then Exit;
  EndPos0 := Byte1Based - 1;
  ScanFrom0 := EndPos0 - BACK_SCAN;
  if ScanFrom0 < 0 then ScanFrom0 := 0;
  ScanLen := EndPos0 - ScanFrom0;
  if ScanLen > High(Integer) then ScanLen := High(Integer);
  if ScanLen < 1 then Exit;
  FileStreamSeek64(FSourceFileStream, ScanFrom0, Word(soFromBeginning));
  ReadN := FSourceFileStream.Read(Buf, Integer(ScanLen));
  if ReadN <= 0 then Exit;
  for I := ReadN - 1 downto 0 do
  begin
    if Buf[I] = FSourceLineTermByte then
    begin
      Result := ScanFrom0 + I + 2;
      Exit;
    end;
  end;
  Result := ScanFrom0 + 1;
end;

function TfrmMain.PhysicalByteOffset1BasedForPhysicalLine1Based(const ALine1Based: Int64): Int64;
var
  FileSize1, Hint1, CurLine, Target, Pos0: Int64;
  ReadN, I: Integer;
  Buf: array of Byte;
begin
  Result := 1;
  if (ALine1Based < 1) or (not Assigned(FSourceFileStream)) then Exit;
  if HasLineSearchIndex then
  begin
    Result := GetLineStartOffset(ALine1Based - 1);
    if Result < 1 then Result := 1;
    Exit;
  end;
  if UsesProportionalZeroScanScroll then
  begin
    FileSize1 := SourceFileSize64;
    if (FileSize1 < 1) or (totalLines < 1) then Exit;
    Result := 1 + ((ALine1Based - 1) * FileSize1) div totalLines;
    if Result < 1 then Result := 1;
    if Result > FileSize1 then Result := FileSize1;
    Result := LineStartByte1BasedOnOrBefore(Result);
    Exit;
  end;
  Target := ALine1Based;
  FileSize1 := SourceFileSize64;
  if FileSize1 < 1 then Exit;
  if Target = 1 then Exit;
  if totalLines > 0 then
    Hint1 := 1 + ((Target - 1) * FileSize1) div totalLines
  else
    Hint1 := 1;
  if Hint1 < 1 then Hint1 := 1;
  if Hint1 > FileSize1 then Hint1 := FileSize1;
  CurLine := CountPhysicalLinesUpToByte1Based(Hint1);
  if CurLine = Target then
  begin
    Result := LineStartByte1BasedOnOrBefore(Hint1);
    Exit;
  end;
  SetLength(Buf, WALK_BUF);
  if CurLine < Target then
  begin
    Pos0 := Hint1 - 1;
    while (Pos0 < FileSize1) and (CurLine < Target) do
    begin
      ReadN := WALK_BUF;
      if Pos0 + ReadN > FileSize1 then
        ReadN := Integer(FileSize1 - Pos0);
      if ReadN <= 0 then Break;
      FileStreamSeek64(FSourceFileStream, Pos0, Word(soFromBeginning));
      ReadN := FSourceFileStream.Read(Buf[0], ReadN);
      if ReadN <= 0 then Break;
      for I := 0 to ReadN - 1 do
      begin
        if Buf[I] = FSourceLineTermByte then
        begin
          Inc(CurLine);
          if CurLine = Target then
          begin
            Result := Pos0 + I + 2;
            Exit;
          end;
        end;
      end;
      Inc(Pos0, ReadN);
    end;
    Result := FileSize1;
    Exit;
  end;
  { CurLine > Target: walk backward from Hint1 }
  Pos0 := Hint1 - 1;
  while (Pos0 > 0) and (CurLine > Target) do
  begin
    ReadN := WALK_BUF;
    if Pos0 - ReadN < 0 then ReadN := Integer(Pos0);
    if ReadN <= 0 then Break;
    FileStreamSeek64(FSourceFileStream, Pos0 - ReadN, Word(soFromBeginning));
    ReadN := FSourceFileStream.Read(Buf[0], ReadN);
    if ReadN <= 0 then Break;
    for I := ReadN - 1 downto 0 do
    begin
      if Buf[I] = FSourceLineTermByte then
      begin
        Dec(CurLine);
        if CurLine = Target then
        begin
          Result := Pos0 - ReadN + I + 2;
          Exit;
        end;
      end;
    end;
    Dec(Pos0, ReadN);
  end;
  if CurLine = Target then
    Result := LineStartByte1BasedOnOrBefore(Hint1)
  else
    Result := 1;
end;

procedure TfrmMain.ApplyZeroScanScrollToViewportEnd(const AEstLine1Based: Int64);
var
  ScrollExtent, MaxOff: Int64;
  LastVisIdx: Integer;
begin
  ScrollExtent := ListViewScrollExtent;
  if ScrollExtent < 1 then ScrollExtent := 1;
  MaxOff := VerticalScrollMaxOffset(ScrollExtent);
  if MaxOff < 0 then MaxOff := 0;
  Offset := MaxOff;
  FZeroScanEndScrollOffset := MaxOff;
  if ListViewScrollExtent > 0 then
    fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff)
  else
    fScrollPos := 0;
  SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
  ScrollBarHorizontal.Position := 0;
  InvalidateLineCache;
  if Assigned(ListView1) then
  begin
    ListView1.Refresh;
    LastVisIdx := ListView1.Items.Count - 1;
    if LastVisIdx < 0 then LastVisIdx := 0;
    SelectListViewItem(LastVisIdx);
    if ListView1.CanFocus then ListView1.SetFocus;
  end;
  goToLineSelected := AEstLine1Based;
  UpdateInfoPanels;
end;

procedure TfrmMain.GotoFileEndZeroScan;
var
  FileSize1, LastStartByte, EstLine1: Int64;
begin
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then Exit;
  if not UsesProportionalZeroScanScroll then Exit;
  { Ja descoberto: so scroll ao fim da barra (cache invalido se byte 1). }
  if (FZeroScanPhysicalLineCount > 0) and (FZeroScanEndLineStartByte > 1) and
     (SourceFileSize64 > 0) and
     (FZeroScanEndLineStartByte > (SourceFileSize64 div 2)) then
  begin
    ApplyZeroScanScrollToViewportEnd(FZeroScanPhysicalLineCount);
    UpdateStatusBar(Format(TrText('ZeroScan.LastLineCached'),
      [FZeroScanPhysicalLineCount, UnUtils.FormatNumber(FZeroScanEndLineStartByte)]), iaRight);
    Exit;
  end;
  FileSize1 := SourceFileSize64;
  if FileSize1 < 1 then Exit;
  LastStartByte := LineStartByte1BasedOnOrBefore(FileSize1);
  if totalLines > 0 then
    EstLine1 := 1 + ((LastStartByte - 1) * totalLines) div FileSize1
  else
    EstLine1 := 1;
  if EstLine1 < 1 then EstLine1 := 1;
  if (totalLines > 0) and (EstLine1 > totalLines) then
    EstLine1 := totalLines;
  FZeroScanPhysicalLineCount := EstLine1;
  FZeroScanEndLineStartByte := LastStartByte;
  ApplyZeroScanScrollToViewportEnd(EstLine1);
  UpdateStatusBar(Format(TrText('ZeroScan.LastLineApprox'),
    [EstLine1, UnUtils.FormatNumber(LastStartByte)]), iaRight);
end;

procedure TfrmMain.GotoPhysicalLine1Based(const ALine1Based: Int64);
var
  Byte1, Line0: Int64;
begin
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then Exit;
  { Modo indexado normal: nunca alterar totalLines/bytes; usar gotoLine classico. }
  if not UsesProportionalZeroScanScroll then
  begin
    if ALine1Based >= 1 then
      gotoLine(ALine1Based - 1);
    Exit;
  end;
  Byte1 := PhysicalByteOffset1BasedForPhysicalLine1Based(ALine1Based);
  if Byte1 < 1 then Byte1 := 1;
  Line0 := Line0BasedForFileByte1Based(Byte1);
  if Line0 < 0 then Line0 := 0;
  if (totalLines > 0) and (Line0 >= totalLines) then
    Line0 := totalLines - 1;
  ScrollToFileBytePos(Byte1 - 1, Integer(Line0));
  goToLineSelected := ALine1Based;
  UpdateInfoPanels;
  UpdateStatusBar(Format(TrText('Go to line %d (byte %s)'),
    [ALine1Based, UnUtils.FormatNumber(Byte1)]), iaRight);
end;

function TfrmMain.PhysicalLine1BasedForListLine0(const AListLine0: Int64): Int64;
var
  Byte1, FileSize1: Int64;
begin
  if AListLine0 < 0 then
  begin
    Result := 1;
    Exit;
  end;
  if HasLineSearchIndex then
  begin
    Result := AListLine0 + 1;
    Exit;
  end;
  Byte1 := GetLineStartOffset(AListLine0);
  if UsesProportionalZeroScanScroll and Assigned(FSourceFileStream) then
  begin
    FileSize1 := SourceFileSize64;
    if (Byte1 < 1) or (FileSize1 < 1) then
      Result := AListLine0 + 1
    else if FZeroScanPhysicalLineCount > 0 then
      Result := 1 + ((Byte1 - 1) * FZeroScanPhysicalLineCount) div FileSize1
    else if totalLines > 0 then
      Result := 1 + ((Byte1 - 1) * totalLines) div FileSize1
    else
      Result := AListLine0 + 1;
    if Result < 1 then Result := 1;
    Exit;
  end;
  if Byte1 > 0 then
    Result := CountPhysicalLinesUpToByte1Based(Byte1)
  else
    Result := AListLine0 + 1;
  if Result < 1 then Result := 1;
end;

function TfrmMain.TryStartAutoIndexForMutation: Boolean;
var
  Choice: Integer;
begin
  { True = caller deve sair (indexacao iniciada ou cancelado). False = pode mutar (com linha fisica aproximada). }
  if HasLineSearchIndex or (not UsesProportionalZeroScanScroll) then
  begin
    Result := False;
    Exit;
  end;
  if CurrentEffectiveFilePath = '' then
  begin
    Result := True;
    Exit;
  end;
  if FFileReloadInProgress then
  begin
    SetOperationStatus(fssPending, TrText('Searching...'));
    Result := True;
    Exit;
  end;
  Choice := FastFileMessageBox(
    PChar(TrText('Instant open: edits need a line map for correct file positions.') + #13#10#13#10 +
      TrText('YES = build line index now (recommended).') + #13#10 +
      TrText('NO = edit using physical line count from file start (slow on huge files).') + #13#10 +
      TrText('CANCEL = abort.')),
    PChar(TrText('Edit / index')), MB_YESNOCANCEL or MB_ICONQUESTION);
  if Choice = IDYES then
  begin
    BeginOnDemandLineIndex(False);
    Result := True;
    Exit;
  end;
  if Choice = IDNO then
  begin
    Result := False;
    Exit;
  end;
  Result := True;
end;

function TfrmMain.BlendColors(const BaseColor, OverlayColor: TColor; const Alpha: Byte): TColor;
var
  Bc, Oc: Longint;
  br, bg, bb, orr, og, ob: Byte;
  r, g, b2: Integer;
begin
  Bc := ColorToRGB(BaseColor);
  Oc := ColorToRGB(OverlayColor);
  br := GetRValue(Bc); bg := GetGValue(Bc); bb := GetBValue(Bc);
  orr := GetRValue(Oc); og := GetGValue(Oc); ob := GetBValue(Oc);
  r := (Integer(br) * (255 - Alpha) + Integer(orr) * Alpha) div 255;
  g := (Integer(bg) * (255 - Alpha) + Integer(og) * Alpha) div 255;
  b2 := (Integer(bb) * (255 - Alpha) + Integer(ob) * Alpha) div 255;
  Result := RGB(Byte(r), Byte(g), Byte(b2));
end;

function TfrmMain.WrapLongTokensForDisplay(const AText: string; const MaxChars: Integer): string;
var
  I, L, StartPos, RunLen, ChunkPos: Integer;
  Ch: Char;
  Part: string;
begin
  if (MaxChars <= 1) or (AText = '') then
  begin
    Result := AText;
    Exit;
  end;

  Result := '';
  I := 1;
  L := Length(AText);
  while I <= L do
  begin
    Ch := AText[I];
    if (Ch = ' ') or (Ch = #9) then
    begin
      Result := Result + Ch;
      Inc(I);
      Continue;
    end;
    if (Ch = #13) or (Ch = #10) then
    begin
      Result := Result + Ch;
      Inc(I);
      Continue;
    end;

    StartPos := I;
    while I <= L do
    begin
      Ch := AText[I];
      if (Ch = ' ') or (Ch = #9) or (Ch = #13) or (Ch = #10) then Break;
      Inc(I);
    end;

    RunLen := I - StartPos;
    if RunLen <= MaxChars then
      Result := Result + Copy(AText, StartPos, RunLen)
    else
    begin
      Part := Copy(AText, StartPos, RunLen);
      ChunkPos := 1;
      while ChunkPos <= Length(Part) do
      begin
        Result := Result + Copy(Part, ChunkPos, MaxChars);
        Inc(ChunkPos, MaxChars);
        if ChunkPos <= Length(Part) then
          Result := Result + #13#10;
      end;
    end;
  end;
end;

function TfrmMain.WrapPlainTextToPixelWidth(const ACanvas: TCanvas; const AText: string;
  const AMaxWidth: Integer): string;
var
  CurLine: string;
  i: Integer;
  Word: string;

  procedure FlushLine;
  begin
    if CurLine = '' then Exit;
    if Result <> '' then Result := Result + #13#10;
    Result := Result + CurLine;
    CurLine := '';
  end;

  procedure AddWord(const W: string);
  var
    j, chunk: Integer;
    Test: string;
  begin
    if W = '' then Exit;
    if ACanvas.TextWidth(W) <= AMaxWidth then
    begin
      if CurLine = '' then
        CurLine := W
      else
      begin
        Test := CurLine + ' ' + W;
        if ACanvas.TextWidth(Test) <= AMaxWidth then
          CurLine := Test
        else
        begin
          FlushLine;
          CurLine := W;
        end;
      end;
      Exit;
    end;
    j := 1;
    while j <= Length(W) do
    begin
      chunk := 1;
      while (j + chunk - 1 <= Length(W)) and
        (ACanvas.TextWidth(Copy(W, j, chunk)) <= AMaxWidth) do
        Inc(chunk);
      Dec(chunk);
      if chunk < 1 then chunk := 1;
      if CurLine <> '' then FlushLine;
      CurLine := Copy(W, j, chunk);
      FlushLine;
      Inc(j, chunk);
    end;
  end;

begin
  Result := '';
  CurLine := '';
  if (AText = '') or (AMaxWidth < 4) then
  begin
    Result := AText;
    Exit;
  end;
  Word := '';
  i := 1;
  while i <= Length(AText) do
  begin
    if AText[i] in [#13, #10] then
    begin
      if Word <> '' then
      begin
        AddWord(Word);
        Word := '';
      end;
      FlushLine;
      while (i <= Length(AText)) and (AText[i] in [#13, #10]) do Inc(i);
      Continue;
    end;
    if AText[i] in [' ', #9] then
    begin
      if Word <> '' then
      begin
        AddWord(Word);
        Word := '';
      end;
      Inc(i);
      Continue;
    end;
    Word := Word + AText[i];
    Inc(i);
  end;
  if Word <> '' then AddWord(Word);
  FlushLine;
end;

function TfrmMain.ListViewItemIndexIsSelected(const ALv: TCustomListView; const AIndex: Integer): Boolean;
var
  St: UINT;
  W: TWinControl;
  ItemCount: Integer;
begin
  Result := False;
  if ALv = nil then Exit;
  if (AIndex < 0) or (not ALv.HandleAllocated) then Exit;
  ItemCount := Integer(SendMessage(ALv.Handle, LVM_GETITEMCOUNT_MSG, 0, 0));
  if (ItemCount <= 0) or (AIndex >= ItemCount) then Exit;
  St := UINT(SendMessage(ALv.Handle, LVM_GETITEMSTATE_MSG, WPARAM(AIndex), LVIS_SELECTED));
  Result := (St and LVIS_SELECTED) <> 0;
  if not Result then Exit;
  W := ALv as TWinControl;
  { HideSelection existe em TListView, nao em TWinControl/TCustomListView }
  if (ALv is TListView) and TListView(ALv).HideSelection and (not W.Focused) then
    Result := False;
end;

function TfrmMain.SourceFileSize64: Int64;
var
  Lo, Hi: DWORD;
begin
  if FSourceFileSize > 0 then
    Result := FSourceFileSize
  else if totalCharacters > 0 then
    Result := totalCharacters
  else if Assigned(FSourceFileStream) then
  begin
    Lo := Windows.GetFileSize(FSourceFileStream.Handle, @Hi);
    if Lo = INVALID_FILE_SIZE then
      Result := 0
    else
      Result := Int64(Hi) shl 32 or Int64(Lo);
    if Result > 0 then
      FSourceFileSize := Result;
  end
  else
    Result := 0;
end;

function TfrmMain.HasLineSearchIndex: Boolean;
begin
  { Busca/filtro usam temp.txt ou temp_ckpt; Zero Scan "grande" (>500k linhas) ainda indexa. }
  Result := Assigned(FIndexFileStream) or Assigned(FCkptFileStream);
end;

function TfrmMain.HasDenseLineIndexOnDisk: Boolean;
var
  IdxPath: string;
  Sz: Int64;
begin
  IdxPath := FastFileExeDirPath(TEMPFILE);
  if not FileExists(IdxPath) then
  begin
    Result := False;
    Exit;
  end;
  Sz := UnUtils.GetFileSize(IdxPath);
  Result := Sz >= Int64(INDEX_RECORD_SIZE) * 2;
end;

function TfrmMain.ZeroScanAutoOpenMinFileSize: Int64;
begin
  Result := MaxBytesFileIndexed;
end;

function TfrmMain.UsesProportionalZeroScanScroll: Boolean;
begin
  Result := FZeroScanMode and (not HasLineSearchIndex);
end;

function TfrmMain.ZeroScanCountLfInRange(AStream: TFileStream; const AStartPos, AByteCount: Int64): Int64;
var
  Pos64, Remaining, ToRead: Int64;
  I, ReadN: Integer;
  Buf: array[0..262143] of Byte;
begin
  Result := 0;
  if (AByteCount < 1) or (not Assigned(AStream)) then Exit;
  Pos64 := AStartPos;
  Remaining := AByteCount;
  while Remaining > 0 do
  begin
    ToRead := Remaining;
    if ToRead > SizeOf(Buf) then
      ToRead := SizeOf(Buf);
    FileStreamSeek64(AStream, Pos64, Word(soFromBeginning));
    ReadN := AStream.Read(Buf, Integer(ToRead));
    if ReadN <= 0 then
      Break;
      for I := 0 to ReadN - 1 do
        if Buf[I] = FSourceLineTermByte then
          Inc(Result);
    Inc(Pos64, ReadN);
    Dec(Remaining, ReadN);
  end;
end;

function TfrmMain.EstimateZeroScanLineCount(AFileSize: Int64; AStream: TFileStream): Int64;
var
  SampleBytes, HeadBytes, TailBytes, TailStart, AvgLine, NlCount: Int64;
begin
  if AFileSize <= 0 then
  begin
    Result := 1;
    Exit;
  end;
  if AFileSize <= ZERO_SCAN_DEFAULT_AVG_LINE then
  begin
    Result := 1;
    Exit;
  end;
  NlCount := 0;
  SampleBytes := 0;
  if Assigned(AStream) then
  begin
    if AFileSize <= ZERO_SCAN_SAMPLE_BYTES then
    begin
      HeadBytes := AFileSize;
      NlCount := ZeroScanCountLfInRange(AStream, 0, HeadBytes);
      SampleBytes := HeadBytes;
    end
    else
    begin
      { Inicio + fim: so uma amostra distorce (cabecalho longo ou cauda densa). }
      HeadBytes := ZERO_SCAN_SAMPLE_BYTES;
      TailBytes := ZERO_SCAN_SAMPLE_BYTES;
      TailStart := AFileSize - TailBytes;
      NlCount := ZeroScanCountLfInRange(AStream, 0, HeadBytes);
      Inc(NlCount, ZeroScanCountLfInRange(AStream, TailStart, TailBytes));
      SampleBytes := HeadBytes + TailBytes;
    end;
  end;
  if NlCount < 1 then
    AvgLine := ZERO_SCAN_DEFAULT_AVG_LINE
  else
  begin
    AvgLine := SampleBytes div NlCount;
    if AvgLine < ZERO_SCAN_MIN_AVG_LINE then
      AvgLine := ZERO_SCAN_MIN_AVG_LINE;
  end;
  Result := AFileSize div AvgLine;
  if Result < 1 then
    Result := 1;
  if Result > ZERO_SCAN_MAX_LINES then
    Result := ZERO_SCAN_MAX_LINES;
end;

procedure TfrmMain.RefineZeroScanLineCountFromFileEnd(var ALineCount: Int64; const AFileSize: Int64);
var
  TailSize, ReadN, I, TailNlCount: Integer;
  Buf: array[0..262143] of Byte;
  Pos64, AvgFromTail, CapLines: Int64;
begin
  if (not Assigned(FSourceFileStream)) or (AFileSize <= 0) then Exit;
  if AFileSize <= ZERO_SCAN_TAIL_BYTES then
    TailSize := Integer(AFileSize)
  else
    TailSize := ZERO_SCAN_TAIL_BYTES;
  Pos64 := AFileSize - TailSize;
  TailNlCount := 0;
  FileStreamSeek64(FSourceFileStream, Pos64, Word(soFromBeginning));
  while True do
  begin
    ReadN := FSourceFileStream.Read(Buf, SizeOf(Buf));
    if ReadN <= 0 then Break;
    for I := 0 to ReadN - 1 do
      if Buf[I] = FSourceLineTermByte then
        Inc(TailNlCount);
    Inc(Pos64, ReadN);
    if Pos64 >= AFileSize then Break;
  end;
  if TailNlCount < 1 then
    Exit;
  AvgFromTail := TailSize div TailNlCount;
  if AvgFromTail < ZERO_SCAN_MIN_AVG_LINE then
    AvgFromTail := ZERO_SCAN_MIN_AVG_LINE;
  CapLines := AFileSize div AvgFromTail;
  if CapLines < 1 then
    CapLines := 1;
  if ALineCount > CapLines then
    ALineCount := CapLines;
  if (AFileSize > 0) and (ALineCount > 0) then
  begin
    FZeroScanBytesPerItem := AFileSize div ALineCount;
    if FZeroScanBytesPerItem < 1 then
      FZeroScanBytesPerItem := 1;
  end;
end;

procedure TfrmMain.EnsureZeroScanBytesPerItemInitialized;
var
  Sz: Int64;
begin
  if (not FZeroScanMode) or (not Assigned(FSourceFileStream)) then Exit;
  if FZeroScanBytesPerItem >= 1 then Exit;
  Sz := SourceFileSize64;
  if Sz <= 0 then
    Sz := totalCharacters;
  if totalLines > 0 then
    FZeroScanBytesPerItem := (Sz + totalLines - 1) div totalLines
  else if Sz > 0 then
    FZeroScanBytesPerItem := Sz
  else
    FZeroScanBytesPerItem := 1;
end;

procedure TfrmMain.ApplyZeroScanVirtualLineCount(var ALineCount: Int64; const AFileSize: Int64);
begin
  FZeroScanEstimatedLines := False;
  if not FZeroScanMode then
    Exit;
  { Indice denso/esparsa legitimo: manter contagem real; instant open ja libertou streams acima. }
  if HasLineSearchIndex and (ALineCount < ZERO_SCAN_VIRTUAL_CAP) then
    Exit;
  if (ALineCount < ZERO_SCAN_VIRTUAL_CAP) and (not FForceZeroScan) then
    Exit;
  if Assigned(FSourceFileStream) then
    ALineCount := EstimateZeroScanLineCount(AFileSize, FSourceFileStream)
  else if AFileSize > 0 then
    ALineCount := AFileSize div 256
  else
    ALineCount := 1;
  if ALineCount < 1 then
    ALineCount := 1;
  if AFileSize > 0 then
  begin
    FZeroScanBytesPerItem := AFileSize div ALineCount;
    if FZeroScanBytesPerItem < 1 then
      FZeroScanBytesPerItem := 1;
  end
  else if Assigned(FSourceFileStream) and (SourceFileSize64 > 0) then
  begin
    FZeroScanBytesPerItem := SourceFileSize64 div ALineCount;
    if FZeroScanBytesPerItem < 1 then
      FZeroScanBytesPerItem := 1;
  end;
  FZeroScanEstimatedLines := True;
  FZeroScanPhysicalLineCount := 0;
  FZeroScanEndLineStartByte := 0;
  FZeroScanEndScrollOffset := 0;
end;

procedure TfrmMain.RefineZeroScanLineCountFromFileStart(var ALineCount: Int64; const AFileSize: Int64);
var
  HeadSize, ReadN, I, HeadNlCount: Integer;
  Buf: array[0..262143] of Byte;
  Pos64, AvgFromHead, CapLines: Int64;
begin
  if (not Assigned(FSourceFileStream)) or (AFileSize <= 0) then Exit;
  if AFileSize <= ZERO_SCAN_HEAD_BYTES then
    HeadSize := Integer(AFileSize)
  else
    HeadSize := ZERO_SCAN_HEAD_BYTES;
  Pos64 := 0;
  HeadNlCount := 0;
  FileStreamSeek64(FSourceFileStream, 0, Word(soFromBeginning));
  while True do
  begin
    ReadN := FSourceFileStream.Read(Buf, SizeOf(Buf));
    if ReadN <= 0 then Break;
    for I := 0 to ReadN - 1 do
      if Buf[I] = FSourceLineTermByte then
        Inc(HeadNlCount);
    Inc(Pos64, ReadN);
    if Pos64 >= HeadSize then Break;
  end;
  if HeadNlCount < 1 then
    Exit;
  AvgFromHead := HeadSize div HeadNlCount;
  if AvgFromHead < ZERO_SCAN_MIN_AVG_LINE then
    AvgFromHead := ZERO_SCAN_MIN_AVG_LINE;
  CapLines := AFileSize div AvgFromHead;
  if CapLines < 1 then
    CapLines := 1;
  if ALineCount > CapLines then
    ALineCount := CapLines;
  if (AFileSize > 0) and (ALineCount > 0) then
  begin
    FZeroScanBytesPerItem := AFileSize div ALineCount;
    if FZeroScanBytesPerItem < 1 then
      FZeroScanBytesPerItem := 1;
  end;
end;

function TfrmMain.TryReadPhysicalLineBounds0(const ALineIndex0: Int64;
  out AStartOffset, AEndOffset: Int64): Boolean;
var
  TargetLine, CurLine, Pos0, LineStart0, FileSz: Int64;
  ScanBuf: array[0..262143] of Byte;
  ScanRead, ScanI: Integer;
begin
  Result := False;
  AStartOffset := 1;
  AEndOffset := 1;
  if (not Assigned(FSourceFileStream)) or (ALineIndex0 < 0) then
    Exit;
  TargetLine := ALineIndex0;
  CurLine := 0;
  Pos0 := 0;
  LineStart0 := 0;
  FileSz := SourceFileSize64;
  FileStreamSeek64(FSourceFileStream, 0, Word(soFromBeginning));
  while True do
  begin
    ScanRead := FSourceFileStream.Read(ScanBuf, SizeOf(ScanBuf));
    if ScanRead <= 0 then
    begin
      if CurLine = TargetLine then
      begin
        AStartOffset := LineStart0 + 1;
        if FileSz > 0 then
          AEndOffset := FileSz + 1
        else
          AEndOffset := Pos0 + 1;
        Result := AEndOffset > AStartOffset;
      end;
      Break;
    end;
    for ScanI := 0 to ScanRead - 1 do
    begin
      if CurLine = TargetLine then
      begin
        if ScanBuf[ScanI] = FSourceLineTermByte then
        begin
          AStartOffset := LineStart0 + 1;
          AEndOffset := Pos0 + 2;
          Result := AEndOffset > AStartOffset;
          Exit;
        end;
      end
      else if ScanBuf[ScanI] = FSourceLineTermByte then
      begin
        Inc(CurLine);
        LineStart0 := Pos0 + 1;
      end;
      Inc(Pos0);
    end;
  end;
end;

function TfrmMain.ReadLineTextFromSourceOffsets(const AStartOffset, AEndOffset: Int64): string;
var
  FullLineLen: Int64;
  LineLength, BytesRead2: Integer;
  Buffer: AnsiString;
begin
  Result := '';
  if (not Assigned(FSourceFileStream)) or (AStartOffset <= 0) or (AEndOffset <= AStartOffset) then
    Exit;
  FullLineLen := AEndOffset - AStartOffset;
  if FullLineLen <= 0 then Exit;
  if FullLineLen > MAX_LINE_LEN_DISPLAY then
    LineLength := MAX_LINE_LEN_DISPLAY
  else
    LineLength := FullLineLen;
  FileStreamSeek64(FSourceFileStream, AStartOffset - 1, Word(soFromBeginning));
  SetLength(Buffer, LineLength);
  BytesRead2 := FSourceFileStream.Read(Pointer(Buffer)^, LineLength);
  while (BytesRead2 > 0) and (Buffer[BytesRead2] in [#10, #13]) do
    Dec(BytesRead2);
  SetLength(Buffer, BytesRead2);
  Result := DisplayTextFromFileBytes(Buffer, EffectiveDisplayEncoding);
  if FullLineLen > MAX_LINE_LEN_DISPLAY then
    Result := Result + ' ' + Format(TrText('[Line preview limited to %s bytes for performance; file line total %s bytes.]'),
      [UnUtils.FormatNumber(MAX_LINE_LEN_DISPLAY), UnUtils.FormatNumber(FullLineLen)]);
end;

function TfrmMain.TryResolveZeroScanExactLineBoundsFromStart(const ALineIndex0: Int64;
  out AStartOffset, AEndOffset: Int64): Boolean;
begin
  if (not UsesProportionalZeroScanScroll) or (ALineIndex0 < 0) or
     (ALineIndex0 >= ZERO_SCAN_START_EXACT_MAX_LINE) then
  begin
    Result := False;
    Exit;
  end;
  Result := TryReadPhysicalLineBounds0(ALineIndex0, AStartOffset, AEndOffset);
end;

function TfrmMain.DiscoverZeroScanLastPhysicalLine1Based: Int64;
var
  FileSize1, LastStartByte, FullCount: Int64;
begin
  Result := 1;
  if (not Assigned(FSourceFileStream)) or HasLineSearchIndex or
     (not UsesProportionalZeroScanScroll) then
    Exit;
  if FZeroScanPhysicalLineCount > 0 then
  begin
    Result := FZeroScanPhysicalLineCount;
    Exit;
  end;
  FileSize1 := SourceFileSize64;
  if FileSize1 < 1 then Exit;

  { Ficheiros medios: contagem exacta no ficheiro inteiro (sem linha fantasma pos-LF). }
  if FileSize1 <= ZERO_SCAN_FULL_COUNT_MAX then
  begin
    FullCount := CountPhysicalLinesInOpenFile;
    if FullCount < 1 then FullCount := 1;
    FZeroScanPhysicalLineCount := FullCount;
    Result := FullCount;
    Exit;
  end;

  { Titãs: início da última linha no fim do ficheiro + estimativa proporcional (sem varrer 20 GB). }
  LastStartByte := LineStartByte1BasedOnOrBefore(FileSize1);
  if (LastStartByte > 0) and (FileSize1 > 0) and (totalLines > 0) then
    Result := 1 + ((LastStartByte - 1) * totalLines) div FileSize1
  else
    Result := 1;
  if Result < 1 then Result := 1;
end;

procedure TfrmMain.StartZeroScanDiscoverLastLineAsync;
var
  Path: string;
begin
  if FZeroScanDiscoverLastLineBusy then Exit;
  if (not UsesProportionalZeroScanScroll) or HasLineSearchIndex then Exit;
  Path := CurrentEffectiveFilePath;
  if (Path = '') or (not FileExists(Path)) then Exit;
  FZeroScanDiscoverLastLineBusy := True;
  TZeroScanDiscoverLastLineThread.Create(Path);
end;

procedure TfrmMain.FinishZeroScanDiscoverLastLine(const APhysicalLines: Int64);
begin
  FZeroScanDiscoverLastLineBusy := False;
  if (APhysicalLines < 1) or (not UsesProportionalZeroScanScroll) then Exit;
  CommitZeroScanDiscoveredLineCount(APhysicalLines);
  ApplyZeroScanScrollToViewportEnd(APhysicalLines);
  if isChecked then
    showChecked;
end;

procedure TfrmMain.CommitZeroScanDiscoveredLineCount(const APhysicalLines: Int64);
var
  FileSize1: Int64;
begin
  if (APhysicalLines < 1) or HasLineSearchIndex or (not UsesProportionalZeroScanScroll) then Exit;
  FZeroScanPhysicalLineCount := APhysicalLines;
  if Assigned(FSourceFileStream) then
  begin
    FileSize1 := SourceFileSize64;
    if FileSize1 > 0 then
    begin
      FZeroScanEndLineStartByte := LineStartByte1BasedOnOrBefore(FileSize1);
      FZeroScanEndScrollOffset := 0;
    end;
  end;
  if APhysicalLines < totalLines then
  begin
    totalLines := APhysicalLines;
    ItemCount := totalLines;
    if Assigned(FSourceFileStream) and (totalLines > 0) then
    begin
      FZeroScanBytesPerItem := (SourceFileSize64 + totalLines - 1) div totalLines;
      if FZeroScanBytesPerItem < 1 then
        FZeroScanBytesPerItem := 1;
    end;
    FZeroScanEstimatedLines := False;
    InvalidateLineCache;
    if AppUiUpdatesAllowed and Assigned(ListView1) then
    begin
      try ListView1.Refresh; except end;
    end;
  end;
end;

function TfrmMain.ListViewScrollExtent: Int64;
var
  MaxLineIdx: Int64;
begin
  Result := ItemCount;
  if (not UsesProportionalZeroScanScroll) or (Result < 1) then
    Exit;
  if (FZeroScanBytesPerItem > 0) and Assigned(FSourceFileStream) and
     (SourceFileSize64 > 0) then
  begin
    MaxLineIdx := (SourceFileSize64 + FZeroScanBytesPerItem - 1) div FZeroScanBytesPerItem;
    if MaxLineIdx < 1 then
      MaxLineIdx := 1;
    if Result > MaxLineIdx then
      Result := MaxLineIdx;
  end;
end;

function TfrmMain.ShouldOpenWithInstantZeroScan(const AFileSize: Int64): Boolean;
var
  Path: string;
begin
  if FForceIndexThisOpen then
  begin
    Result := False;
    Exit;
  end;
  if FForceZeroScan then
  begin
    Result := True;
    Exit;
  end;
  case FOpenFilePolicy of
    fopAlwaysIndex: Result := False;
    fopAlwaysInstant: Result := True;
  else
    Path := CurrentEffectiveFilePath;
    if (Path <> '') and IsInstantFallbackFile(Path) then
      Result := True
    else
      Result := AFileSize >= MaxBytesFileIndexed;
  end;
end;

function TfrmMain.EffectiveFindCaseSensitive(const S: string): Boolean;
begin
  case FFindCasePolicy of
    fcpMatchCase: Result := True;
    fcpIgnoreCase: Result := False;
  else
    Result := InferFindCaseSensitive(S);
  end;
end;

function TfrmMain.EffectiveFilterMatchMode(const S: string): TFilterMatchMode;
begin
  case FFilterMatchPolicy of
    fmpContains: Result := fmmContains;
    fmpPrefix: Result := fmmPrefix;
    fmpRegex: Result := fmmRegex;
  else
    Result := InferFilterMatchModeEnum(S);
  end;
end;

function TfrmMain.EffectiveFilterCaseSensitive(const S: string; AMode: TFilterMatchMode): Boolean;
begin
  case FFilterCasePolicy of
    ffcpMatchCase: Result := True;
    ffcpIgnoreCase: Result := False;
  else
    Result := InferFindCaseSensitive(S);
  end;
end;

function TfrmMain.InferFindCaseSensitive(const S: string): Boolean;
var
  i: Integer;
begin
  { Estilo editor: maiusculas no padrao => busca sensivel a maiusculas. }
  Result := False;
  for i := 1 to Length(S) do
    if S[i] in ['A'..'Z'] then
    begin
      Result := True;
      Exit;
    end;
end;

function TfrmMain.InferFilterMatchModeEnum(const S: string): TFilterMatchMode;
var
  L: Integer;
begin
  L := Length(S);
  if (L > 1) and (S[L] = '*') and (Pos('(', S) = 0) and (Pos('[', S) = 0) and (Pos('|', S) = 0) then
  begin
    Result := fmmPrefix;
    Exit;
  end;
  if (L > 0) and (S[1] = '^') then begin Result := fmmRegex; Exit; end;
  if Pos('(', S) > 0 then begin Result := fmmRegex; Exit; end;
  if Pos('[', S) > 0 then begin Result := fmmRegex; Exit; end;
  if Pos('|', S) > 0 then begin Result := fmmRegex; Exit; end;
  if Pos('?', S) > 0 then begin Result := fmmRegex; Exit; end;
  if Pos('\', S) > 0 then begin Result := fmmRegex; Exit; end;
  Result := fmmContains;
end;

function TfrmMain.TryStartAutoIndexForSearch(const AContinueFindWhenDone: Boolean): Boolean;
var
  Sz: Int64;
  Choice: Integer;
begin
  { True = caller deve sair (indexacao iniciada, cancelado ou impossivel).
    False = continuar (ja tem indice, ou busca por bytes sem indexar). }
  if HasLineSearchIndex then
  begin
    Result := False;
    Exit;
  end;
  if CurrentEffectiveFilePath = '' then begin Result := True; Exit; end;
  if FFileReloadInProgress then
  begin
    UpdateStatusBar(TrText('Updating line index...'), iaRight);
    Result := True;
    Exit;
  end;
  try
    Sz := GetFileSize(CurrentEffectiveFilePath);
  except
    Result := True;
    Exit;
  end;
  if ShouldOpenWithInstantZeroScan(Sz) or FForceZeroScan then
  begin
    Choice := FastFileMessageBox(
      PChar(TrText('Instant open: no line index yet.') + #13#10#13#10 +
        TrText('YES = build line index now (full disk pass, exact line numbers).') + #13#10 +
        TrText('NO = search by bytes now (estimated line in status bar).') + #13#10 +
        TrText('CANCEL = abort.')),
      PChar(TrText('Search / index')), MB_YESNOCANCEL or MB_ICONQUESTION);
    if Choice = IDYES then
    begin
      BeginOnDemandLineIndex(AContinueFindWhenDone);
      Result := True;
      Exit;
    end;
    if Choice = IDNO then
    begin
      Result := False;
      Exit;
    end;
    Result := True;
    Exit;
  end;
  Result := True;
  BeginRead;
  if AContinueFindWhenDone then
    FDeferredFindAfterIndex := True;
  UpdateStatusBar(TrText('Updating line index...'), iaRight);
end;

procedure TfrmMain.BeginOnDemandLineIndex(const AContinueFindWhenDone: Boolean);
begin
  if CurrentEffectiveFilePath = '' then Exit;
  if FFileReloadInProgress then Exit;
  FFreshFileRead := False;
  fFileName := CurrentEffectiveFilePath;
  CloseFileStreams;
  StopScriptEngineProcess;
  FFileReloadInProgress := True;
  if AContinueFindWhenDone then
    FDeferredFindAfterIndex := True;
  try
    TReadFileThread.Create(False, fFileName, True, True, TrText('Building line index...'), '', True);
  except
    on E: EOSError do
    begin
      FFileReloadInProgress := False;
      raise Exception.Create('[BeginOnDemandLineIndex] TReadFileThread.Create: ' + E.Message);
    end;
  end;
  UpdateStatusBar(TrText('Building line index...'), iaRight);
end;

procedure TfrmMain.RunDeferredFindAfterIndexIfNeeded;
begin
  if not FDeferredFindAfterIndex then Exit;
  FDeferredFindAfterIndex := False;
  if not HasLineSearchIndex then Exit;
  if Trim(FFindText) = '' then Exit;
  FFindCaseSensitive := EffectiveFindCaseSensitive(FFindText);
  FFindByteOnlyActive := False;
  if ListView1.ItemIndex >= 0 then
    StartFindFromPos(FLastFoundFilePos, +1)
  else
    StartFindFromPos(0, +1);
end;

procedure TfrmMain.RunDeferredFilterAfterIndexIfNeeded;
var
  Needle: string;
  Mode: TFilterMatchMode;
  CS: Boolean;
begin
  if not FDeferredFilterAfterIndex then Exit;
  FDeferredFilterAfterIndex := False;
  FAssistantPendingExportFiltered := False;
  FAssistantPendingExportToFile := False;
  FAssistantPendingFilterCaseSensitive := False;
  if Trim(FFilterText) = '' then Exit;
  Needle := FFilterText;
  Mode := EffectiveFilterMatchMode(Needle);
  if (FFilterMatchPolicy = fmpAuto) and (Mode = fmmPrefix) and
     (Length(Needle) > 0) and (Needle[Length(Needle)] = '*') then
    SetLength(Needle, Length(Needle) - 1);
  CS := EffectiveFilterCaseSensitive(Needle, Mode);
  if Assigned(FIndexFileStream) then
    StartFilter(Needle, CS, Mode)
  else
    StartFilterStream(Needle, CS, Mode);
  if not FFilterBarChromeHidden then
    ShowFilterBar(False)
  else
    RefreshFilterBarState;
end;

procedure TfrmMain.ScrollToFileBytePos(const AFilePos0Based: Int64; const ALineIndexHint: Integer);
var
  Line0: Int64;
  FileSize1: Int64;
  StatusFmt: string;
begin
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then Exit;
  FileSize1 := SourceFileSize64;
  Line0 := -1;
  if Assigned(FIndexFileStream) and (totalLines > 0) then
    Line0 := Line0BasedForFileByte1Based(AFilePos0Based + 1);
  if Line0 < 0 then
  begin
    if ALineIndexHint >= 0 then
      Line0 := ALineIndexHint
    else if FZeroScanBytesPerItem > 0 then
      Line0 := AFilePos0Based div FZeroScanBytesPerItem
    else if (totalLines > 0) and (FileSize1 > 0) then
      Line0 := (AFilePos0Based * totalLines) div FileSize1;
  end;
  if Line0 < 0 then Line0 := 0;
  if (totalLines > 0) and (Line0 >= totalLines) then
    Line0 := totalLines - 1;
  FLastFoundFilePos := AFilePos0Based;
  FLastFoundLine := Integer(Line0);
  gotoLineWithAnchor(Line0, 4);
  if FFindByteOnlyActive or UsesProportionalZeroScanScroll then
    StatusFmt := Format(TrText('Found at byte %s (~line %d)'),
      [UnUtils.FormatNumber(AFilePos0Based + 1), Line0 + 1])
  else
    StatusFmt := Format(TrText('Found at line %d'), [Line0 + 1]);
  UpdateStatusBar(StatusFmt, iaRight);
end;

procedure TfrmMain.DoFindDialog;
var
  S: string;
begin
  if CurrentEffectiveFilePath = '' then begin
    ShowAppMessage(TrText('Please select a file.'));
    Exit;
  end;
  if not FileExists(CurrentEffectiveFilePath) then begin
    ShowAppMessage(TrText('File not found.'));
    Exit;
  end;
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  S := FFindText;
  if not InputQuery(TrText('Search'), TrText('Type the text to search:'), S) then Exit;
  S := Trim(S);
  if S = '' then Exit;
  FFindText := S;
  FFindOccAssistantOffered := False;
  FFindOccOfferShown := False;
  if Assigned(FFindOccBar) then
    FFindOccBar.SetSearchText(S);
  if not HasLineSearchIndex then
  begin
    if TryStartAutoIndexForSearch then Exit;
  end;
  FFindCaseSensitive := EffectiveFindCaseSensitive(S);
  if ListView1.ItemIndex >= 0 then
    StartFindFromPos(FLastFoundFilePos, +1)
  else
    StartFindFromPos(0, +1);
end;

procedure TfrmMain.DoFindReplace;
var
  Frm: TfrmFindReplace;
  Done: Boolean;
  FoundLine: Integer;
  FoundContent, NewContent: String;
  Op: TOperationType;
  EffPath: string;
begin
  if CurrentEffectiveFilePath = '' then begin ShowAppMessage(TrText('Please select a file.')); Exit; end;
  if not FileExists(CurrentEffectiveFilePath) then begin ShowAppMessage(TrText('File not found.')); Exit; end;
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  EffPath := CurrentEffectiveFilePath;

  Frm := TfrmFindReplace.Create(nil);
  try
    ApplyTranslationsToForm(Frm);
    Frm.edtFind.Text := FFindText;

    Done := False;
    while not Done do
    begin
      Frm.SetReplaceEnabled(not SessionBlocksMutation);
      if Frm.ShowModal <> mrOk then
      begin
        Done := True;
        Break;
      end;

      case Frm.Action of
        fraFindNext:
        begin
          FFindText := Frm.GetFindText;
          FFindCaseSensitive := Frm.GetCaseSensitive;
          if not HasLineSearchIndex then
          begin
            if TryStartAutoIndexForSearch(True) then Continue;
          end;

          { No modo Select (checklist), ListView1.ItemIndex e obsoleto; usar FLastFoundLine. }
          if (ListView1.ItemIndex >= 0) or
             (isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0)) then
            StartFindFromPos(FLastFoundFilePos + 1, +1)
          else
            StartFindFromPos(0, +1);
        end;

        fraReplace:
        begin
          if not EnsureWritableSession then
          begin
            Frm.SetStatus(TrText('Read-only session is enabled. Turn it off in Options to edit or save the file.'));
            Continue;
          end;
          if not HasLineSearchIndex then
          begin
            if TryStartAutoIndexForSearch(True) then Continue;
          end;
          if (FLastFoundLine >= 0) and (FLastFoundLine < totalLines) then
          begin
            if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) and (FLastFoundFilePos >= 0) then
              FoundLine := CountPhysicalLinesUpToByte1Based(FLastFoundFilePos + 1)
            else
              FoundLine := FLastFoundLine + 1;
            FoundContent := GetLineContent(FLastFoundLine);

            if Frm.GetCaseSensitive then
              NewContent := StringReplace(FoundContent, Frm.GetFindText, Frm.GetReplaceText, [])
            else
              NewContent := StringReplace(FoundContent, Frm.GetFindText, Frm.GetReplaceText, [rfIgnoreCase]);

            if NewContent <> FoundContent then
            begin
              if ApplyEditWithUndo(otEdit, FoundLine, FoundContent, NewContent) then
                Frm.SetStatus(TrText('Replaced on line ') + IntToStr(FoundLine) + '.')
              else
                Frm.SetStatus(TrText('Replace failed.'));
            end
            else
              Frm.SetStatus(TrText('No match on current line.'));
          end
          else
            Frm.SetStatus(TrText('No match selected. Use Find Next first.'));
        end;

        fraReplaceAll:
        begin
          if not EnsureWritableSession then
          begin
            Frm.SetStatus(TrText('Read-only session is enabled. Turn it off in Options to edit or save the file.'));
            Continue;
          end;
          if FastFileMessageBox(
            PChar(TrText('Replace all occurrences of "') + Frm.GetFindText + '"?' + #13#10 + #13#10 +
              TrText('Streaming replace writes a temp file, then swaps it over the original when possible. Free disk space is checked first. A safety limit on match count applies. This cannot be undone.') +
              iff(EffectiveUseSegmentedHeavyOps(GetFileSize(EffPath), totalLines, 0),
                #13#10 + #13#10 + TrText('Line-segmented mode is ON: Replace All runs on line-aligned parts; matches that span a part boundary may be missed.'),
                '') + #13#10 + #13#10 +
              TrText('Continue?')),
            PChar(TrText('Replace All')), MB_YESNO or MB_ICONQUESTION) = IDYES then
          begin
            if not EnsureOpenFileNotStaleForMutate then Continue;
            BeginHeavyFileMutate;
            TReplaceAllThread.Create(EffPath,
              Frm.GetFindText, Frm.GetReplaceText,
              Frm.GetCaseSensitive, Frm.GetWholeWord,
              True, True,
              EffectiveUseSegmentedHeavyOps(GetFileSize(EffPath), totalLines, 0) and HasDenseLineIndexOnDisk,
              FastFileExeDirPath(TEMPFILE),
              250000,
              '',
              False,
              True);
            Done := True;
          end;
        end;

        fraClosed:
          Done := True;
      end;
    end;
  finally
    Frm.Free;
    FocusPrimaryReadView;
  end;
end;

procedure TfrmMain.DoGotoLine;
var
  S: string;
  N: Integer;
begin
  S := '';
  if InputQuery(TrText('Ir para linha'), TrText('Numero da linha (1..') + IntToStr(totalLines) + '):', S) then
  begin
    N := StrToIntDef(Trim(S), -1);
    if N < 1 then Exit;
    if (totalLines > 0) and (N > totalLines) then Exit;
    if UsesProportionalZeroScanScroll then
      GotoPhysicalLine1Based(N)
    else
    begin
      gotoLine(N - 1);
      UpdateStatusBar(Format(TrText('Go to line %d'), [N]), iaRight);
    end;
  end;
end;

function TfrmMain.Line0BasedForFileByte1Based(const Byte1Based: Int64): Int64;
var
  SavePos: Int64;
  Lo, Hi, Mid: Int64;
  MidStart: Int64;
  FileSize1: Int64;
begin
  Result := -1;
  if (Byte1Based < 1) or (not Assigned(FSourceFileStream)) or (totalLines < 1) then Exit;
  if Assigned(FIndexFileStream) or Assigned(FCkptFileStream) then
  begin
    Lo := 0;
    Hi := totalLines - 1;
    while Lo <= Hi do
    begin
      Mid := (Lo + Hi) div 2;
      MidStart := GetLineStartOffset(Mid);
      if MidStart < 1 then
      begin
        Result := -1;
        Break;
      end;
      if MidStart <= Byte1Based then
      begin
        Result := Mid;
        Lo := Mid + 1;
      end
      else
        Hi := Mid - 1;
    end;
    Exit;
  end;
  FileSize1 := SourceFileSize64;
  if FileSize1 > 0 then
    Result := ((Byte1Based - 1) * totalLines) div FileSize1;
  if Result < 0 then Result := 0;
  if (totalLines > 0) and (Result >= totalLines) then
    Result := totalLines - 1;
end;

procedure TfrmMain.DoGotoByteOffset;
var
  S: string;
  B, FileSize1: Int64;
  Line0: Int64;
  LineStart: Int64;
  MatchStart: Integer;
  LineTxt: string;
begin
  S := '';
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty or (totalLines < 1) then
  begin
    FastFileMessageBox(PChar(TrText('Please read the file first.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if not InputQuery(TrText('Go to byte offset'),
    TrText('Byte position in file (1-based; $ prefix for hex):'), S) then Exit;
  S := Trim(S);
  if S = '' then
  begin
    FastFileMessageBox(PChar(TrText('Invalid byte position.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if (Length(S) > 2) and (S[1] = '0') and ((S[2] = 'x') or (S[2] = 'X')) then
    S := '$' + Copy(S, 3, MaxInt);
  try
    B := StrToInt64(S);
  except
    FastFileMessageBox(PChar(TrText('Invalid byte position.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  FileSize1 := 0;
  if Assigned(FSourceFileStream) then
    FileSize1 := SourceFileSize64;
  if FileSize1 < 1 then
  begin
    FastFileMessageBox(PChar(TrText('Please read the file first.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if (B < 1) or (B > FileSize1) then
  begin
    FastFileMessageBox(PChar(TrText('Byte position is out of range for this file.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  Line0 := Line0BasedForFileByte1Based(B);
  if Line0 < 0 then
  begin
    FastFileMessageBox(PChar(TrText('Could not resolve line for that byte position.')),
      PChar(TrText('Go to byte offset')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if UsesProportionalZeroScanScroll then
  begin
    ScrollToFileBytePos(B - 1, Integer(Line0));
    Exit;
  end;
  FLastFoundLine := -1;
  FLastFoundMatchLen := 0;
  FLastFoundCol := 0;
  LineStart := GetLineStartOffset(Line0);
  if LineStart > 0 then
  begin
    MatchStart := Integer((B - 1) - (LineStart - 1));
    LineTxt := GetLineContent(Line0);
    if (MatchStart >= 0) and (MatchStart < Length(LineTxt)) then
    begin
      FLastFoundLine := Line0;
      FLastFoundFilePos := B - 1;
      FLastFoundMatchLen := 1;
      FLastFoundCol := AlignMatchColInLineText(LineTxt,
        Copy(LineTxt, MatchStart + 1, 1), MatchStart, True);
    end;
  end;
  gotoLineWithAnchor(Line0, 4);
  ApplyFindMatchSelection;
  CalculateFontMetrics;
  ListView1.Invalidate;
  if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
end;

procedure TfrmMain.StartFindFromPos(const AStartPos: Int64; const ADirection: Integer);
var
  DensePath: string;
  CkptPath: string;
  UseSparse: Boolean;
  ByteOnly: Boolean;
  ZsFast: Boolean;
  BlockPath: string;
  AvgB: Int64;
  EstLines: Int64;
  StartPos: Int64;
begin
  FLastFindDirection := ADirection;
  FFindAutoRetry := False;
  FFilterFindSkips := 0;
  if Trim(FFindText) = '' then begin
    FastFileMessageBox(PChar(TrText('Use Ctrl+F first to define the search text.')), PChar(TrText('Search')), MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  if CurrentEffectiveFilePath = '' then begin
    FastFileMessageBox(PChar(TrText('No file selected.')), PChar(TrText('Search')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if not FileExists(CurrentEffectiveFilePath) then begin
    FastFileMessageBox(PChar(TrText('File not found.')), PChar(TrText('Search')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then begin
    FastFileMessageBox(PChar(TrText('Please read the file first.')), PChar(TrText('Search')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  ByteOnly := not HasLineSearchIndex;
  StartPos := AStartPos;
  if (ADirection >= 0) and (StartPos <= 0) and (FLastFoundFilePos > 0) then
    StartPos := FLastFoundFilePos;
  if ByteOnly and (not Assigned(FSourceFileStream)) then Exit;
  // Cancel any previous search thread (no WaitFor to avoid deadlock with Synchronize)
  if Assigned(FFindThread) then begin
    FFindThread.Terminate;
    FFindThread := nil;
  end;
  Inc(FFindSearchId);
  UpdateStatusBar(TrText('Searching...'), iaRight);
  FFindByteOnlyActive := ByteOnly;
  if ByteOnly then
  begin
    AvgB := FZeroScanBytesPerItem;
    if AvgB < 1 then
    begin
      if (totalLines > 0) and Assigned(FSourceFileStream) and (SourceFileSize64 > 0) then
        AvgB := SourceFileSize64 div totalLines
      else
        AvgB := 256;
    end;
    if AvgB < 1 then AvgB := 1;
    EstLines := totalLines;
    if EstLines < 1 then EstLines := 1;
    BlockPath := '';
    if FileExists(ZeroScanBlockIndexPath) then
      BlockPath := ZeroScanBlockIndexPath;
    FFindThread := TFindInFileThread.Create(Self, CurrentEffectiveFilePath, '', FFindText,
      FFindCaseSensitive, StartPos, ADirection, FFindSearchId, False, '', 0,
      True, AvgB, EstLines, True, BlockPath);
    Exit;
  end;
  DensePath := FastFileExeDirPath(TEMPFILE);
  CkptPath := FastFileExeDirPath(TEMP_CKPT_FILE);
  UseSparse := not FileExists(DensePath);
  ZsFast := UseSparse and FZeroScanMode;
  BlockPath := '';
  if ZsFast and FileExists(ZeroScanBlockIndexPath) then
    BlockPath := ZeroScanBlockIndexPath;
  if UseSparse then begin
    if (not FileExists(CkptPath)) or (totalLines <= 0) then begin
      FastFileMessageBox(PChar(TrText('No line index is available for search (dense index and checkpoint file are missing). Please read the file again.')),
        PChar(TrText('Search')), MB_OK or MB_ICONWARNING);
      Exit;
    end;
  end;
  if not UseSparse then
    FFindThread := TFindInFileThread.Create(Self, CurrentEffectiveFilePath, DensePath, FFindText, FFindCaseSensitive,
      StartPos, ADirection, FFindSearchId, False, '', 0, False, 256, totalLines, False, '')
  else
    FFindThread := TFindInFileThread.Create(Self, CurrentEffectiveFilePath, '', FFindText, FFindCaseSensitive,
      StartPos, ADirection, FFindSearchId, True, CkptPath, totalLines, False, 256, totalLines,
      ZsFast, BlockPath);
end;

procedure TfrmMain.FindThreadDone(const AFound: Boolean; const ALineIndex: Integer; const AFilePos: Int64; const ASearchId: Integer; const AErrorMsg: string);
var
  LineStart: Int64;
  MatchStart: Integer;
  LineTxt: string;
begin
  // Discard stale results from a previous (cancelled) search
  if ASearchId <> FFindSearchId then Exit;
  FFindThread := nil;

  if AErrorMsg <> '' then begin
    FastFileMessageBox(PChar(TrText('Search error: ') + AErrorMsg), PChar(TrText('Search')), MB_OK or MB_ICONERROR);
    UpdateStatusBar(TrText('Search error'), iaRight);
    Exit;
  end;

  if not AFound then begin
    FastFileMessageBox(PChar(TrText('Text not found.')), PChar(TrText('Search')), MB_OK or MB_ICONINFORMATION);
    FLastFoundFilePos := 0;
    if FFindMatchSelection then begin
      FFindMatchSelection := False;
      FHasSelection := False;
      if Assigned(ListView1) then ListView1.Repaint;
      if Assigned(FCheckListBox) then FCheckListBox.Invalidate;
    end;
    UpdateStatusBar(TrText('Not found'), iaRight);
    Exit;
  end;
  if (ALineIndex = FLastFoundLine) and (AFilePos = FLastFoundFilePos) and (not FFindAutoRetry) then begin
    FFindAutoRetry := True;
    if FLastFindDirection >= 0 then
      StartFindFromPos(AFilePos + 1, +1)
    else begin
      if AFilePos > 0 then StartFindFromPos(AFilePos - 1, -1)
      else StartFindFromPos(0, -1);
    end;
    Exit;
  end;
  if FFilterActive and (FilteredIndexForRealLine(ALineIndex) < 0) then begin
    Inc(FFilterFindSkips);
    if FFilterFindSkips > totalLines then begin
      FFilterFindSkips := 0;
      FastFileMessageBox(PChar(TrText('No match found among the current filter lines.')),
        PChar(TrText('Search')), MB_OK or MB_ICONINFORMATION);
      UpdateStatusBar(TrText('Not found in filter'), iaRight);
      Exit;
    end;
    if FLastFindDirection >= 0 then
      StartFindFromPos(AFilePos + 1, +1)
    else begin
      if AFilePos > 0 then StartFindFromPos(AFilePos - 1, -1)
      else StartFindFromPos(0, -1);
    end;
    Exit;
  end;
  FFilterFindSkips := 0;
  FLastFoundLine := ALineIndex;
  FLastFoundFilePos := AFilePos;
  FLastFoundMatchLen := 0;
  FLastFoundCol := 0;
  if not FFindByteOnlyActive then
  begin
    LineStart := GetLineStartOffset(ALineIndex);
    if LineStart > 0 then
    begin
      MatchStart := Integer(AFilePos - (LineStart - 1));
      LineTxt := GetLineContent(ALineIndex);
      if Length(FFindText) > 0 then
      begin
        FLastFoundMatchLen := Length(FFindText);
        FLastFoundCol := AlignMatchColInLineText(LineTxt, FFindText, MatchStart,
          FFindCaseSensitive);
        if (FLastFoundCol < 0) or (FLastFoundCol + FLastFoundMatchLen > Length(LineTxt)) then
          FLastFoundMatchLen := 0;
      end
      else
        FLastFoundCol := MatchStart;
    end;
  end;
  if FFindByteOnlyActive then
  begin
    ScrollToFileBytePos(AFilePos, ALineIndex);
    FFindByteOnlyActive := False;
  end
  else if (ALineIndex >= 0) and (ALineIndex < totalLines) then
  begin
    gotoLineWithAnchor(ALineIndex, 4);
    if isChecked and Assigned(FCheckListBox) then
    begin
      if FCheckListBox.CanFocus then
        FCheckListBox.SetFocus;
    end
    else if ListView1.CanFocus then
      ListView1.SetFocus;
    UpdateStatusBar(Format(TrText('Found at line %d'), [ALineIndex + 1]), iaRight);
  end;
  ApplyFindMatchSelection;
  CalculateFontMetrics;
  ListView1.Invalidate;
  if isChecked and Assigned(FCheckListBox) then
    FCheckListBox.Invalidate;
  OfferFindOccurrencesAfterHit;
  OfferAssistantAfterFind;
end;

function TfrmMain.WrapColAvailWidth: Integer;
begin
  Result := 200;
  if not Assigned(ListView1) then Exit;
  if ListView1.Columns.Count >= 2 then
  begin
    Result := ListView1.Columns[1].Width;
    if Result > ListView1.ClientWidth then
      Result := ListView1.ClientWidth;
  end
  else
    Result := ListView1.ClientWidth;
  Dec(Result, 8);
  if Result < 50 then Result := 50;
end;

function TfrmMain.EstimateWrapRowsForLine(const S: string; AvailWidth: Integer): Integer;
var
  CharsPerLine: Integer;
begin
  Result := 1;
  if (S = '') or (AvailWidth <= 0) or (FCharWidth <= 0) then Exit;
  CharsPerLine := Max(1, AvailWidth div FCharWidth);
  Result := (Length(S) + CharsPerLine - 1) div CharsPerLine;
  if Result < 1 then Result := 1;
end;

function TfrmMain.LineFitsSingleListWrapVisualRow(const LineIdx: Integer): Boolean;
var
  W: Integer;
  S: string;
begin
  if not FFastVisualWordWrap then
  begin
    Result := True;
    Exit;
  end;
  W := WrapColAvailWidth;
  if W < 50 then W := 50;
  S := GetLineContent(LineIdx);
  Result := EstimateWrapRowsForLine(S, W) <= 1;
end;

procedure TfrmMain.RecalcDynWrapRowHeight;
var
  W, MaxRows, Rows, I: Integer;
  StartIdx: Int64;
  S: string;
begin
  if not FFastVisualWordWrap then Exit;
  if not Assigned(ListView1) then Exit;
  if isChecked then Exit;
  if not ListView1.Visible then Exit;
  CalculateFontMetrics;
  W := WrapColAvailWidth;
  MaxRows := MinAutoWrapRows;
  StartIdx := Offset;
  for I := 0 to VisibleItems - 1 do
  begin
    if FShowWhitespaceMarks then
      S := BuildLineTextForMarksDisplay(Integer(StartIdx) + I)
    else
      S := GetLineContent(Integer(StartIdx) + I);
    Rows := EstimateWrapRowsForLine(S, W);
    if Rows > MaxRows then
      MaxRows := Rows;
    if MaxRows >= MaxAutoWrapRows then
    begin
      MaxRows := MaxAutoWrapRows;
      Break;
    end;
  end;
  if FShowWhitespaceMarks and (MaxRows < MaxAutoWrapRows) then
    Inc(MaxRows);
  if MaxRows <> FWrapAutoRowCount then
  begin
    FWrapAutoRowCount := MaxRows;
    ApplyWordWrapRowHeight;
    { VisibleItems muda com a nova altura de linha - recalcular. }
    ListView1Resize(ListView1);
  end;
end;

procedure TfrmMain.ApplyWordWrapRowHeight;
var
  H: Integer;
  B: TBitmap;
  RowCount: Integer;
begin
  if not Assigned(ListView1) then Exit;
  if FFastVisualWordWrap then
  begin
    FDeferredListViewRecreateForRowHeight := False;
    CalculateFontMetrics;
    RowCount := FWrapAutoRowCount;
    if RowCount < 2 then RowCount := 2;
    H := Max(48, (Abs(FLineHeight) + 2) * RowCount);
    if FWordWrapRowImages = nil then
      FWordWrapRowImages := TImageList.Create(Self);
    if (FWordWrapRowImages.Height <> H) or (FWordWrapRowImages.Count = 0) then
    begin
      FWordWrapRowImages.Clear;
      FWordWrapRowImages.Width := 1;
      FWordWrapRowImages.Height := H;
      B := TBitmap.Create;
      try
        B.Width := 1;
        B.Height := H;
        B.Canvas.Brush.Color := clWindow;
        B.Canvas.FillRect(Rect(0, 0, 1, H));
        FWordWrapRowImages.AddMasked(B, clWindow);
      finally
        B.Free;
      end;
    end;
    ListView1.SmallImages := FWordWrapRowImages;
  end
  else
  begin
    ListView1.SmallImages := nil;
    { Em alguns comctl32/Delphi 7 a altura nao volta so com SmallImages := nil.
      Recriar o handle forca o ListView a recalcular a altura padrao da linha.
      Evitar recriar com ListView oculta (modo checklist): pode deixar estado incoerente. }
    if ListView1.HandleAllocated and ListView1.Visible and (not isChecked) then
    begin
      ListView1.Perform(WM_SETREDRAW, 0, 0);
      try
        ListView1.Perform(CM_RECREATEWND, 0, 0);
      finally
        ListView1.Perform(WM_SETREDRAW, 1, 0);
      end;
      FDeferredListViewRecreateForRowHeight := False;
    end
    else
      FDeferredListViewRecreateForRowHeight := True;
  end;
end;

procedure TfrmMain.UpdateExternalScrollBarsForWordWrap;
var
  NewPage, NewLarge: Integer;
begin
  if FListViewZoomBatchDepth > 0 then
  begin
    FListViewZoomDeferScrollSync := True;
    Exit;
  end;
  if not Assigned(ScrollBarHorizontal) then Exit;

  if FFastVisualWordWrap then
  begin
    if ScrollBarHorizontal.Position <> 0 then
      ScrollBarHorizontal.Position := 0;
    if ScrollBarHorizontal.Enabled then
      ScrollBarHorizontal.Enabled := False;
    if ScrollBarHorizontal.Visible then
      ScrollBarHorizontal.Visible := False;
  end
  else
  begin
    if not ScrollBarHorizontal.Enabled then
      ScrollBarHorizontal.Enabled := True;
    if not ScrollBarHorizontal.Visible then
      ScrollBarHorizontal.Visible := True;
  end;

  if Assigned(ScrollBarVertical) then
  begin
    if VisibleItems < 1 then
      VisibleItems := 1;
    NewLarge := VisibleItems;
    if ScrollBarVertical.LargeChange <> NewLarge then
      ScrollBarVertical.LargeChange := NewLarge;
    if ScrollBarVertical.SmallChange <> 1 then
      ScrollBarVertical.SmallChange := 1;
    if VisibleItems < MaxInt then
      NewPage := Integer(VisibleItems)
    else
      NewPage := MaxInt - 1;
    { PageSize never above Max — otherwise later Max/Position assignments raise. }
    SafeSetScrollBarPageSize(ScrollBarVertical, NewPage);
  end;
end;

procedure TfrmMain.UpdateListViewWordWrapUi;
begin
  if not Assigned(ListView1) then Exit;
  ApplyWordWrapRowHeight;
  ListView1Resize(ListView1);
  UpdateExternalScrollBarsForWordWrap;
  { Recalcular altura dinamica para coluna redimensionada ou novo viewport. }
  if FFastVisualWordWrap and (not isChecked) and ListView1.Visible then
    RecalcDynWrapRowHeight;
  if FListViewZoomBatchDepth = 0 then
    FormResize(Self);
end;

function TfrmMain.DrawFindHighlightOntoCanvas(Canvas: TCanvas; const LV: TCustomListView;
  Item: TListItem; State: TCustomDrawState; const SubItemIndex: Integer): Boolean;
var
  R: TRect;
  FullLine, Vis: String;
  LineStart: Int64;
  Rel0, Skip, MatchStart, MatchLen: Integer;
  X, Y, X0: Integer;
  WPrefix, WMatch, WSuffix, TH: Integer;
  Prefix, MatchText, Suffix: String;
  BaseBk, HlBk: TColor;
  LineIdx: Integer;
  NormalFg: TColor;
  Col0W, Col1W: Integer;
  SavedStyle: TFontStyles;
begin
  Result := False;
  if (Item = nil) then Exit;
  if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
  LineIdx := FileLineIndexFromListRow(Item.Index);
  if LineIdx < 0 then Exit;
  if LineIdx <> FLastFoundLine then Exit;
  R := Rect(0, 0, 0, 0);
  if not ListView_GetSubItemRect(LV.Handle, Item.Index, SubItemIndex, LVIR_LABEL, @R) then
  begin
    R := Item.DisplayRect(drBounds);
    if ListView1.Columns.Count >= 2 then
    begin
      Col0W := ListView1.Columns[0].Width;
      Col1W := ListView1.Columns[1].Width;
    end
    else
    begin
      Col0W := 0;
      Col1W := R.Right - R.Left;
    end;
    R.Left := Col0W + 1;
    R.Right := R.Left + Col1W - 2;
  end;
  if R.Right <= R.Left + 2 then Exit;
  FullLine := GetLineContent(LineIdx);
  LineStart := GetLineStartOffset(LineIdx);
  if LineStart < 0 then Exit;
  if (FLastFoundCol >= 0) and (FLastFoundCol < Length(FullLine)) then
    Rel0 := FLastFoundCol
  else
  begin
    Rel0 := Integer(FLastFoundFilePos - (LineStart - 1));
    if (FFindText <> '') and (Length(FullLine) > 0) then
      Rel0 := AlignMatchColInLineText(FullLine, FFindText, Rel0, FFindCaseSensitive);
  end;
  MatchLen := FLastFoundMatchLen;
  if MatchLen <= 0 then Exit;
  if Rel0 < 0 then Rel0 := 0;
  if Rel0 >= Length(FullLine) then Exit;
  if Rel0 + MatchLen > Length(FullLine) then MatchLen := Length(FullLine) - Rel0;
  Skip := ListViewHorizTextSkipChars;
  MatchStart := Rel0 - Skip;
  Vis := getLineContentsFromLineIndex(LineIdx);
  if MatchStart < 0 then Exit;
  if MatchStart + MatchLen > Length(Vis) then
    MatchLen := Length(Vis) - MatchStart;
  if MatchLen <= 0 then Exit;

  { Coluna Linha: seleccao normal do ListView. Coluna Conteudo: realce apenas na faixa do texto
    (largura = TextWidth de cada trecho; altura = uma linha de texto, centrada na celula). }
  GetFindMatchHighlightColors(LineIdx, BaseBk, HlBk, NormalFg);
  Prefix := Copy(Vis, 1, MatchStart);
  MatchText := Copy(Vis, MatchStart + 1, MatchLen);
  Suffix := Copy(Vis, MatchStart + 1 + MatchLen, MaxInt);
  Canvas.Font.Assign(ListView1.Font);
  Canvas.Brush.Style := bsSolid;
  TH := Canvas.TextHeight('Wg');
  if TH < 1 then TH := 1;
  if TH > (R.Bottom - R.Top) then TH := Max(1, R.Bottom - R.Top - 2);
  Y := R.Top + Max(0, ((R.Bottom - R.Top) - TH) div 2);
  WPrefix := Canvas.TextWidth(Prefix);
  WMatch := Canvas.TextWidth(MatchText);
  WSuffix := Canvas.TextWidth(Suffix);
  X0 := R.Left + 2;
  { Nao usar FillRect(R.Left,Y,R.Right,Y+TH): isso pinta toda a largura da coluna Content.
    Apenas bandas estreitas + realce clInfoBk exactamente na largura do match. }
  Canvas.Brush.Color := BaseBk;
  Canvas.FillRect(Rect(R.Left, R.Top, R.Right, Y));
  Canvas.FillRect(Rect(R.Left, Y + TH, R.Right, R.Bottom));
  Canvas.FillRect(Rect(R.Left, Y, X0, Y + TH));
  if WPrefix > 0 then
    Canvas.FillRect(Rect(X0, Y, X0 + WPrefix, Y + TH));
  Canvas.Brush.Color := HlBk;
  Canvas.FillRect(Rect(X0 + WPrefix, Y, X0 + WPrefix + WMatch, Y + TH));
  Canvas.Brush.Color := BaseBk;
  if WSuffix > 0 then
    Canvas.FillRect(Rect(X0 + WPrefix + WMatch, Y, X0 + WPrefix + WMatch + WSuffix, Y + TH));
  Canvas.FillRect(Rect(X0 + WPrefix + WMatch + WSuffix, Y, R.Right, Y + TH));
  Canvas.Font.Color := NormalFg;
  X := X0;
  SavedStyle := Canvas.Font.Style;
  Canvas.TextOut(X, Y, Prefix);
  Inc(X, WPrefix);
  if FFindMatchSelection then
    Canvas.Font.Style := SavedStyle + [fsBold];
  Canvas.TextOut(X, Y, MatchText);
  Canvas.Font.Style := SavedStyle;
  Inc(X, WMatch);
  Canvas.TextOut(X, Y, Suffix);
  Result := True;
end;

function TfrmMain.DrawFindHighlightForListCell(Sender: TCustomListView;
  Item: TListItem; State: TCustomDrawState; const SubItemIndex: Integer): Boolean;
begin
  Result := DrawFindHighlightOntoCanvas(Sender.Canvas, Sender, Item, State, SubItemIndex);
end;

procedure TfrmMain.ListView1AdvancedCustomDrawSubItem(Sender: TCustomListView;
  Item: TListItem; SubItem: Integer; State: TCustomDrawState;
  Stage: TCustomDrawStage; var DefaultDraw: Boolean);
var
  R: TRect;
  S: string;
  LineIdx: Integer;
  Col0W, Col1W: Integer;
  IsSel: Boolean;
  Bk, Fg: TColor;
  DrawFlags: UINT;
  DC: HDC;
  FreeCanvas: TCanvas;
begin
  DefaultDraw := True;
  if (SubItem <> 1) then Exit;
  if (Item = nil) then Exit;

  { Pos-pintura (sem word-wrap visual): com OwnerData + linha seleccionada o comctl
    desenha o texto no PrePaint; se usarmos SKIPDEFAULT no Pre, a celula fica vazia.
    Aqui redesenhamos por cima o conteudo + realce da substring.
    Nota D7: cdPostPaint nao liga o canvas do ListView ao hdc; nao atribuir Handle ao
    TControlCanvas (EInvalidOperation). Usar TCanvas.Create + GetDC. }
  if Stage = cdPostPaint then
  begin
    if FFastVisualWordWrap then Exit;
    { Com FFindMatchSelection o realce ja foi feito no PrePaint (evita fundo azul do RowSelect). }
    if FFindMatchSelection then Exit;
    if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
    LineIdx := FileLineIndexFromListRow(Item.Index);
    if LineIdx <> FLastFoundLine then Exit;
    DC := Windows.GetDC(TWinControl(Sender).Handle);
    if DC <> 0 then
    begin
      FreeCanvas := TCanvas.Create;
      try
        FreeCanvas.Handle := DC;
        FreeCanvas.Font.Assign(ListView1.Font);
        DrawFindHighlightOntoCanvas(FreeCanvas, Sender, Item, State, 1);
      finally
        FreeCanvas.Handle := 0;
        FreeCanvas.Free;
        Windows.ReleaseDC(TWinControl(Sender).Handle, DC);
      end;
    end;
    Exit;
  end;

  if Stage <> cdPrePaint then Exit;

  if FFastVisualWordWrap then
  begin
    { Retangulo real da subcelula (como no highlight). DisplayRect+Columns[1].Width
      usa largura da coluna (ex. 1200px) e o wrap quase nao quebra - parece uma linha so. }
    if not ListView_GetSubItemRect(Sender.Handle, Item.Index, 1, LVIR_LABEL, @R) then
    begin
      R := Item.DisplayRect(drBounds);
      if ListView1.Columns.Count >= 2 then
      begin
        Col0W := ListView1.Columns[0].Width;
        Col1W := ListView1.Columns[1].Width;
      end
      else
      begin
        Col0W := 0;
        Col1W := R.Right - R.Left;
      end;
      R.Left := Col0W + 1;
      R.Right := R.Left + Col1W - 2;
    end;
    { Word wrap deve respeitar a area visivel do ListView (coluna pode ser mais larga que o cliente). }
    if R.Left < 0 then R.Left := 0;
    if R.Right > ListView1.ClientWidth - 1 then
      R.Right := ListView1.ClientWidth - 1;
    if R.Right <= R.Left + 4 then Exit;
    LineIdx := FileLineIndexFromListRow(Item.Index);
    if LineIdx < 0 then Exit;
    if (FLastFoundLine >= 0) and (FLastFoundMatchLen > 0) and (LineIdx = FLastFoundLine) then
    begin
      S := GetLineContent(LineIdx);
      if EstimateWrapRowsForLine(S, Max(50, R.Right - R.Left - 6)) <= 1 then
      begin
        if DrawFindHighlightForListCell(Sender, Item, State, 1) then
        begin
          DefaultDraw := False;
          Exit;
        end;
      end;
    end;
    DefaultDraw := False;
    if FShowWhitespaceMarks then
    begin
      { Wrap + marcas: PostPaint nao chega a pintar subitens; desenho aqui via GetDC. }
      if DrawWhitespaceMarksForListCell(Sender, Item, State, 1, Sender.Canvas) then
        Exit;
    end;
    S := getLineContentsFromLineIndex(LineIdx);
    { Se o custom draw nao obteve texto, deixar o comctl pintar SubItems do OnData. }
    if Trim(S) = '' then
    begin
      DefaultDraw := True;
      Exit;
    end;
    IsSel := ListViewItemIndexIsSelected(Sender, Item.Index);
    { RowSelect pinta a linha inteira; na busca por substring so a coluna Linha fica azul. }
    if FFindMatchSelection and (LineIdx = FLastFoundLine) then
      IsSel := False;
    Bk := clWindow;
    Fg := clWindowText;
    if IsBookmarked(LineIdx) then
    begin
      Bk := FF_BOOKMARK_ROW_BG;
      Fg := FF_BOOKMARK_ROW_FG;
    end
    else if FTailActive and (FTailHighlightFromLine > 0) and (LineIdx >= FTailHighlightFromLine) then
    begin
      Bk := FF_TAIL_NEW_ROW_BG;
      Fg := clWindowText;
    end
    else if IsSel then
    begin
      Bk := clHighlight;
      Fg := clHighlightText;
    end;
    Sender.Canvas.Font.Assign(ListView1.Font);
    Sender.Canvas.Brush.Style := bsSolid;
    Sender.Canvas.Brush.Color := Bk;
    Sender.Canvas.FillRect(R);
    InflateRect(R, -3, -2);
    Sender.Canvas.Font.Color := Fg;
    { DT_WORDBREAK no custom draw da ListView e pouco fiavel; mesma quebra por pixels que no TCheckListBox. }
    if R.Right > R.Left then
      S := WrapPlainTextToPixelWidth(Sender.Canvas, S, R.Right - R.Left)
    else
      S := '';
    DrawFlags := DT_LEFT or DT_TOP or DT_NOPREFIX or DT_EXPANDTABS;
    DrawFlags := UINT(TWinControl(Sender).DrawTextBiDiModeFlags(Longint(DrawFlags)));
    Windows.DrawText(Sender.Canvas.Handle, PChar(S), Length(S), R, DrawFlags);
    Exit;
  end;

  { Sem word-wrap: suprimir fundo azul do RowSelect na coluna Conteudo; realce so na substring. }
  if FFindMatchSelection and (FLastFoundMatchLen > 0) then
  begin
    LineIdx := FileLineIndexFromListRow(Item.Index);
    if LineIdx = FLastFoundLine then
    begin
      if DrawFindHighlightForListCell(Sender, Item, State, 1) then
      begin
        DefaultDraw := False;
        Exit;
      end;
      if not ListView_GetSubItemRect(Sender.Handle, Item.Index, 1, LVIR_LABEL, @R) then
      begin
        R := Item.DisplayRect(drBounds);
        if ListView1.Columns.Count >= 2 then
        begin
          Col0W := ListView1.Columns[0].Width;
          Col1W := ListView1.Columns[1].Width;
        end
        else
        begin
          Col0W := 0;
          Col1W := R.Right - R.Left;
        end;
        R.Left := Col0W + 1;
        R.Right := R.Left + Col1W - 2;
      end;
      if R.Right > R.Left + 2 then
      begin
        S := getLineContentsFromLineIndex(LineIdx);
        if FShowWhitespaceMarks then
          S := FormatWhitespaceMarks(BuildLineTextForMarksDisplay(LineIdx));
        Bk := clWindow;
        Fg := clWindowText;
        if IsBookmarked(LineIdx) then
        begin
          Bk := FF_BOOKMARK_ROW_BG;
          Fg := FF_BOOKMARK_ROW_FG;
        end;
        Sender.Canvas.Font.Assign(ListView1.Font);
        Sender.Canvas.Brush.Color := Bk;
        Sender.Canvas.FillRect(R);
        Sender.Canvas.Font.Color := Fg;
        InflateRect(R, -3, -2);
        DrawFlags := DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_NOPREFIX or DT_END_ELLIPSIS;
        DrawFlags := UINT(TWinControl(Sender).DrawTextBiDiModeFlags(Longint(DrawFlags)));
        Windows.DrawText(Sender.Canvas.Handle, PChar(S), Length(S), R, DrawFlags);
      end;
      DefaultDraw := False;
      Exit;
    end;
  end;

  { Sem word-wrap: cdPostPaint nao pinta subitens (OwnerData D7); marcas no PrePaint (igual wrap). }
  if FShowWhitespaceMarks and (not FCsvMode) and (not FFastVisualWordWrap) then
  begin
    LineIdx := FileLineIndexFromListRow(Item.Index);
    if (LineIdx >= 0) and DrawWhitespaceMarksForListCell(Sender, Item, State, 1, Sender.Canvas) then
    begin
      DefaultDraw := False;
      Exit;
    end;
  end;

  { Sem word-wrap visual e sem marcas: coluna conteudo = desenho por defeito (Pre); realce find na Post. }
end;

procedure TfrmMain.ListView1AdvancedCustomDrawItem(
  Sender: TCustomListView; Item: TListItem; State: TCustomDrawState;
  Stage: TCustomDrawStage; var DefaultDraw: Boolean);
var
  RealLine: Integer;
begin
  DefaultDraw := True;
  if Stage <> cdPrePaint then Exit;
  if Item = nil then Exit;

  RealLine := FileLineIndexFromListRow(Item.Index);
  if RealLine < 0 then Exit;
  { OwnerData: cdsSelected no State e instavel; usar LVM_GETITEMSTATE como no word wrap }
  if (RealLine >= 0) and IsBookmarked(RealLine) then
  begin
    Sender.Canvas.Brush.Color := FF_BOOKMARK_ROW_BG;
    Sender.Canvas.Font.Color  := FF_BOOKMARK_ROW_FG;
  end
  else if FTailActive and (FTailHighlightFromLine > 0)
    and (RealLine >= FTailHighlightFromLine) then
  begin
    { Verde do tail mesmo na linha seleccionada (gotoLine ao fim apos novas linhas). }
    Sender.Canvas.Brush.Color := FF_TAIL_NEW_ROW_BG;
    Sender.Canvas.Font.Color  := clWindowText;
  end;
end;


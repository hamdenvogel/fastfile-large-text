procedure TfrmMain.SplitPatternMemoRegexGuideWndProc(var Message: TMessage);
var
  Steps: Integer;
  DeltaLines: Integer;
  WheelDelta: SmallInt;
  Memo: TsMemo;
begin
  if Message.Msg = WM_MOUSEWHEEL then
  begin
    WheelDelta := SmallInt(HiWord(Message.WParam));
    Steps := Abs(WheelDelta) div WHEEL_DELTA;
    if Steps < 1 then
      Steps := 1;
    DeltaLines := Steps * 3;
    if WheelDelta > 0 then
      DeltaLines := -DeltaLines;
    if Assigned(FSplitByPatternHosted) then
    begin
      Memo := TMergeFilesDialogForm(FSplitByPatternHosted).MemoRegexGuide;
      if Assigned(Memo) then
        SendMessage(Memo.Handle, EM_LINESCROLL, 0, DeltaLines);
    end;
    Message.Result := 0;
    Exit;
  end;
  FSplitPatternMemoRegexGuideOldWnd(Message);
end;

procedure TfrmMain.SplitByPatternTabPreviewClick(Sender: TObject);
var
  Frm: TMergeFilesDialogForm;
  PreviewText, PreviewError: String;
begin
  if not Assigned(FSplitByPatternHosted) then Exit;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);

  if Trim(Frm.EdtSource.Text) = '' then
  begin
    ShowAppMessage(TrText('Source file is required.'));
    Exit;
  end;

  if not FileExists(Trim(Frm.EdtSource.Text)) then
  begin
    ShowAppMessage(TrText('Source file not found.'));
    Exit;
  end;

  if not Assigned(Frm.cmbMode) then Exit;

  { Hosted combo: 0 = equal parts, 1 = Regex (differs from modal multi-mode combo indices). }
  case Frm.cmbMode.ItemIndex of
    0:
      ShowAppMessage(Format(TrText('Equal-parts mode preview: file will be split into %d parts, preserving complete lines.'),
        [Integer(Frm.SpnEqualParts.Value)]));
    1:
      begin
        if Trim(Frm.EdtPattern.Text) = '' then
        begin
          ShowAppMessage(TrText('Pattern cannot be empty.'));
          Exit;
        end;
        if not PreviewPatternMatchesInFile(Trim(Frm.EdtSource.Text), Frm.EdtPattern.Text,
          True, 40, PreviewText, PreviewError) then
        begin
          if Trim(PreviewError) = '' then
            PreviewError := TrText('Unknown error.');
          ShowAppMessage(TrText('Could not build preview for pattern/regex:') + ' ' + PreviewError);
          Exit;
        end;
        ShowAppMessage(PreviewText);
      end;
  end;
end;

procedure TfrmMain.SplitByPatternTabConfirm(Sender: TObject);
var
  Frm: TMergeFilesDialogForm;
  SourceFile, Pattern: String;
  EqualPartsCount: Integer;
  HeaderStr, FooterStr: String;
begin
  if not Assigned(FSplitByPatternHosted) then Exit;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);

  SourceFile := Trim(Frm.EdtSource.Text);
  Pattern := Trim(Frm.EdtPattern.Text);
  HeaderStr := Frm.MemoHeader2.Text;
  FooterStr := Frm.MemoFooter2.Text;

  if not Assigned(Frm.cmbMode) then Exit;

  case Frm.cmbMode.ItemIndex of
    0:
      begin
        EqualPartsCount := Frm.SpnEqualParts.Value;
        if DoSplitEqualPartsFromDialog(SourceFile, EqualPartsCount, HeaderStr, FooterStr) then
          CloseActiveTabSheet;
      end;
    1:
      begin
        if Trim(Pattern) = '' then
        begin
          ShowAppMessage(TrText('Pattern cannot be empty.'));
          Exit;
        end;
        if DoSplitByPatternFromDialog(SourceFile, Pattern, True, HeaderStr, FooterStr,
          False, 0, roSplit, '') then
          CloseActiveTabSheet;
      end;
  end;
end;

function TfrmMain.DoSplitByPatternFromDialog(const SourceFile, Pattern: String; const IsRegex: Boolean;
  const HeaderStr, FooterStr: String; const UseEqualParts: Boolean; const EqualPartsCount: Integer;
  const RegexOp: TRegexOp; const Replacement: String): Boolean;
var
  CurOpen: String;
  MatchCount, TotalLineCount: Int64;
  PreviewError: String;
  NormalizedRegex: String;
  ContinueSplit: Integer;
  GlobalFlag, IgnoreCaseFlag: Boolean;
  Sz: Int64;
  LocalPattern: String;
begin
  Result := False;
  if SourceFile = '' then
  begin
    ShowAppMessage(TrText('Source file is required.'));
    Exit;
  end;
  if not FileExists(SourceFile) then
  begin
    ShowAppMessage(TrText('Source file not found.'));
    Exit;
  end;

  LocalPattern := Pattern;

  GlobalFlag := False;
  IgnoreCaseFlag := True;
  if IsRegex then
    ExtractJsRegexFlags(LocalPattern, GlobalFlag, IgnoreCaseFlag);

  if not UseEqualParts then
  begin
    if IsRegex then
    begin
      if not NormalizeRegexPatternForVBScript(LocalPattern, NormalizedRegex, PreviewError) then
      begin
        ShowAppMessage(PreviewError);
        Exit;
      end;
      LocalPattern := NormalizedRegex;
    end;

    if RegexOp = roSplit then
    begin
      Sz := -1;
      try
        Sz := UnUtils.GetFileSize(SourceFile);
      except
        Sz := -1;
      end;

      if (Sz >= 0) and (Sz > Int64(256) * 1024 * 1024) then
      begin
        ContinueSplit := AppMessageDlg(
          TrText('This file is very large. The app will skip the full pre-scan (counting matches) to keep the UI responsive.') + #13#10#13#10 +
          TrText('You can use the Preview button in the dialog to sample matches quickly.') + #13#10 +
          TrText('Continue with split now?'),
          mtConfirmation,
          [mbYes, mbNo],
          0
        );
        if ContinueSplit <> mrYes then
          Exit;
      end
      else if not CountPatternMatchesInFile(SourceFile, LocalPattern, IsRegex, MatchCount, TotalLineCount, PreviewError) then
      begin
        if Trim(PreviewError) = '' then
          PreviewError := TrText('Unknown error.');
        ShowAppMessage(TrText('Could not validate pattern/regex against the selected file:') + ' ' + PreviewError);
        Exit;
      end;

      if ((Sz < 0) or (Sz <= Int64(256) * 1024 * 1024)) and (MatchCount = 0) then
      begin
        ShowAppMessage(
          TrText('No lines matched this pattern/regex in the selected file, so only 1 output file would be generated.') + #13#10#13#10 +
          TrText('Tips: regex is applied line-by-line; ^ means start of each line.') + #13#10 +
          TrText('If your goal is just N output files (ex: 10), use "By equal parts" mode.')
        );
        Exit;
      end;

      if (Sz < 0) or (Sz <= Int64(256) * 1024 * 1024) then
      begin
        ContinueSplit := AppMessageDlg(
          Format(TrText('Preview: %d matching lines found in %d lines. Expected output files (approx.): %d. Continue?'),
            [MatchCount, TotalLineCount, MatchCount + 1]),
          mtConfirmation,
          [mbYes, mbNo],
          0
        );
        if ContinueSplit <> mrYes then
          Exit;
      end;
    end;
  end;

  CurOpen := CurrentEffectiveFilePath;
  if (CurOpen <> '') and (CurOpen <> SELECTTEXT) and
     SameText(ExpandFileName(SourceFile), ExpandFileName(CurOpen)) then
  begin
    if not EnsureWritableSession then Exit;
    FSplitClosedSourcePath := ExpandFileName(CurOpen);
    FSplitRestoreTotalLines := totalLines;
    FSplitRestoreZeroScan := FZeroScanMode;
    FSplitRestoreZeroScanEstimated := FZeroScanEstimatedLines;
    FSplitRestoreZeroScanPhysical := FZeroScanPhysicalLineCount;
    FSplitRestoreBytesPerItem := FZeroScanBytesPerItem;
    CloseFileStreams;
  end;

  if UseEqualParts then
  begin
    if not ConfirmDiskSpaceForSplitEqual(SourceFile) then
      Exit;
    TSplitEqualPartsThread.Create(SourceFile, EqualPartsCount, 0, True, True, HeaderStr, FooterStr);
  end
  else
  begin
    if not ConfirmDiskSpaceForSplitPattern(SourceFile) then
      Exit;
    TSplitByPatternThread.Create(SourceFile, LocalPattern, IsRegex, True, True, HeaderStr, FooterStr,
      RegexOp, Replacement, GlobalFlag, IgnoreCaseFlag);
  end;
  Result := True;
end;


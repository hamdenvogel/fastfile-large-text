procedure TfrmMain.LayoutFileNameBarButtons;
var
  X, H, TopY: Integer;

  procedure DockRight(ACtl: TControl);
  begin
    if not Assigned(ACtl) then Exit;
    ACtl.Align := alNone;
    ACtl.Anchors := [akTop, akRight];
    if not ACtl.Visible then Exit;
    Dec(X, ACtl.Width);
    ACtl.SetBounds(X, TopY, ACtl.Width, H);
  end;

begin
  { Explicit LTR: edtFileName | Read F5 | Refresh | MRU | Reload | Clear UI. }
  if not Assigned(pnlTop1) then Exit;
  if FFileNameBarLayingOut then Exit;
  FFileNameBarLayingOut := True;
  H := pnlTop1.ClientHeight - 2;
  if H < 16 then
    H := 16;
  TopY := 1;
  X := pnlTop1.ClientWidth;
  pnlTop1.DisableAlign;
  try
    DockRight(btnEmptyInputFile);
    DockRight(btnReloadFromDisk);
    DockRight(btnRecentMRU);
    DockRight(btnRefreshView);
    DockRight(btnReadFileF5);
    if Assigned(edtFileName) then
    begin
      edtFileName.Align := alNone;
      edtFileName.Anchors := [akLeft, akTop, akRight];
      if X < 42 then
        X := 42;
      edtFileName.SetBounds(1, TopY, X - 2, H);
    end;
  finally
    pnlTop1.EnableAlign;
    FFileNameBarLayingOut := False;
  end;
end;

procedure TfrmMain.SyncReadFileF5Button;

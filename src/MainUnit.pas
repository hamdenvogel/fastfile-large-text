procedure TfrmMain.RefreshFileReadTimerCaption;
var
  S: string;
begin
  if not Assigned(lblInfoFileTime) then Exit;
  S := FileTimerCaption(FLastFileTimerKind, FLastReadElapsedStr, FLastReadTimerLines);
  if S = '' then Exit;
  lblInfoFileTime.Caption := S;
end;

procedure TfrmMain.RetranslateOperationTimerLog;
var
  I, Sel, Count: Integer;
  S: string;
begin
  if not Assigned(mmTimer) or not mmTimer.HandleAllocated then Exit;
  Count := SendMessage(mmTimer.Handle, LB_GETCOUNT, 0, 0);
  if Count <> Length(FTimerLogEntries) then Exit;
  Sel := SendMessage(mmTimer.Handle, LB_GETCURSEL, 0, 0);
  SendMessage(mmTimer.Handle, WM_SETREDRAW, 0, 0);
  try
    for I := 0 to Count - 1 do
    begin
      if FTimerLogEntries[I].Kind <= 0 then Continue;
      S := FileTimerCaption(FTimerLogEntries[I].Kind, FTimerLogEntries[I].Elapsed,
        FTimerLogEntries[I].Lines);
      if S = '' then Continue;
      SendMessage(mmTimer.Handle, LB_DELETESTRING, I, 0);
      SendMessage(mmTimer.Handle, LB_INSERTSTRING, I, LPARAM(PChar(S)));
    end;
    if Sel >= 0 then
      SendMessage(mmTimer.Handle, LB_SETCURSEL, Sel, 0);
  finally
    SendMessage(mmTimer.Handle, WM_SETREDRAW, 1, 0);
    RedrawWindow(mmTimer.Handle, nil, 0, RDW_INVALIDATE or RDW_UPDATENOW or RDW_ERASE);
  end;
end;

procedure TfrmMain.AppendOperationTimerLog(const ALine: string);
var
  LogLine: string;
  Idx, N: Integer;
begin
  LogLine := Trim(ALine);
  if LogLine = '' then Exit;
  N := Length(FTimerLogEntries);
  SetLength(FTimerLogEntries, N + 1);
  FTimerLogEntries[N].Kind := 0;
  if (FLastFileTimerKind > 0) and SameText(LogLine,
     Trim(FileTimerCaption(FLastFileTimerKind, FLastReadElapsedStr, FLastReadTimerLines))) then
  begin
    FTimerLogEntries[N].Kind := FLastFileTimerKind;
    FTimerLogEntries[N].Elapsed := FLastReadElapsedStr;
    FTimerLogEntries[N].Lines := FLastReadTimerLines;
  end;
  ApplyOperationTimerMemoLook;
  if Assigned(mmTimer) then
  begin
    if not mmTimer.HandleAllocated then
      mmTimer.HandleNeeded;
    Idx := SendMessage(mmTimer.Handle, LB_ADDSTRING, 0, LPARAM(PChar(LogLine)));
    if Idx >= 0 then
    begin
      SendMessage(mmTimer.Handle, LB_SETCURSEL, Idx, 0);
      SendMessage(mmTimer.Handle, LB_SETTOPINDEX, Idx, 0);
    end;
    RedrawWindow(mmTimer.Handle, nil, 0, RDW_INVALIDATE or RDW_UPDATENOW or RDW_ERASE);
  end;
  if Assigned(lblInfoFileTime) then
    lblInfoFileTime.Caption := LogLine;
  EnsureTopFileQuickActions;
end;

function TfrmMain.CurrentTimerLogText: string;
var
  Idx, Len: Integer;
  Buf: array[0..2047] of Char;
begin
  Result := '';
  { AppendOperationTimerLog uses LB_ADDSTRING, so prefer native listbox text. }
  if Assigned(mmTimer) and mmTimer.HandleAllocated then
  begin
    Idx := SendMessage(mmTimer.Handle, LB_GETCURSEL, 0, 0);
    if Idx < 0 then
      Idx := SendMessage(mmTimer.Handle, LB_GETCOUNT, 0, 0) - 1;
    if Idx >= 0 then
    begin
      Len := SendMessage(mmTimer.Handle, LB_GETTEXTLEN, Idx, 0);
      if Len > 0 then
      begin
        if Len > High(Buf) then
          Len := High(Buf);
        FillChar(Buf[0], SizeOf(Buf), 0);
        if SendMessage(mmTimer.Handle, LB_GETTEXT, Idx, LPARAM(@Buf[0])) > 0 then
          Result := Trim(string(Buf));
      end;
    end;
  end;
  if (Result = '') and Assigned(mmTimer) and (mmTimer.Items.Count > 0) then
  begin
    Idx := mmTimer.ItemIndex;
    if (Idx < 0) or (Idx >= mmTimer.Items.Count) then
      Idx := mmTimer.Items.Count - 1;
    Result := Trim(mmTimer.Items[Idx]);
  end;
  if Result = '' then
  begin
    if Assigned(lblInfoFileTime) then
      Result := Trim(lblInfoFileTime.Caption);
  end;
end;

procedure TfrmMain.CopyTimerLogTextToClipboard;
var
  S, Preview, Msg: string;
begin
  S := CurrentTimerLogText;
  if S = '' then Exit;
  Preview := S;
  if Length(Preview) > 180 then
    Preview := Copy(Preview, 1, 177) + '...';
  Msg := TrText('TimerLog.CopyConfirm') + #13#10#13#10 + '"' + Preview + '"';
  if not MessageBoxTrYesNo(Msg, TrText('Confirm'), True) then Exit;
  Clipboard.AsText := S;
  UpdateStatusBar(TrText('Text copied to clipboard!'), iaRight);
end;

procedure TfrmMain.ClearOperationTimerLog;
begin
  SetLength(FTimerLogEntries, 0);
  ApplyOperationTimerMemoLook;
  if Assigned(mmTimer) then
  begin
    if not mmTimer.HandleAllocated then
      mmTimer.HandleNeeded;
    SendMessage(mmTimer.Handle, LB_RESETCONTENT, 0, 0);
    mmTimer.Items.Clear;
    RedrawWindow(mmTimer.Handle, nil, 0, RDW_INVALIDATE or RDW_UPDATENOW or RDW_ERASE);
  end;
  if Assigned(lblInfoFileTime) then
    lblInfoFileTime.Caption := '';
end;


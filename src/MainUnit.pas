function TfrmMain.CanShowUiHints: Boolean;
begin
  { chkShowLineHints ("Dicas das linhas") is the master switch for ALL hover
    hints — ListView lines and every control (assistant, filter, toolbar…). }
  Result := FShowLineHoverHints;
  if Result and Assigned(ActionHintsDisable) and ActionHintsDisable.Checked then
    Result := False;
end;

procedure TfrmMain.ApplyUiHintsEnabled;
var
  Want: Boolean;
begin
  Want := CanShowUiHints;
  Application.ShowHint := Want;
  ShowHint := Want;
  if Assigned(sAlphaHints1) then
  begin
    if not Want then
    begin
      sAlphaHints1.HideHint;
      sAlphaHints1.Active := False;
    end
    else if Assigned(ActionHintsStd) then
      sAlphaHints1.Active := not ActionHintsStd.Checked
    else
      sAlphaHints1.Active := True;
  end;
  if not Want then
  begin
    ClearFileLineHoverHint;
    Application.CancelHint;
  end;
end;

function TfrmMain.CanShowFileLineHoverHint: Boolean;
begin
  { Somente com a ListView (ou CheckList no Select) na aba Read File —
    sem painéis laterais de funcionalidade (IA Chat/RAG, script, tail macro) nem
    outros forms/modais. Assistente IA lateral e excecao (hint permitido). }
  Result := False;
  if not Application.Active then Exit;
  if IsIconic(Application.Handle) or IsIconic(Handle) then Exit;
  if not FShowLineHoverHints then Exit;
  if not Assigned(pgMain) or (not pgMain.Visible) then Exit;
  if not IsReadFileTabActive then Exit;
  if Assigned(tabReadFile) and (not tabReadFile.TabVisible) then Exit;

  if Application.ModalLevel > 0 then Exit;
  if (Screen.ActiveCustomForm <> nil) and (Screen.ActiveCustomForm <> Self) then Exit;

  if Assigned(FConsumerAIPanel) and FConsumerAIPanel.Visible then Exit;
  if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible then Exit;
  if Assigned(FScriptEnginePanel) and FScriptEnginePanel.Visible then Exit;
  if Assigned(FScriptSuggestionsPanel) and FScriptSuggestionsPanel.Visible then Exit;
  if Assigned(FTailMacroPanel) and FTailMacroPanel.Visible then Exit;
  if Assigned(FTailMacroSuggestionsPanel) and FTailMacroSuggestionsPanel.Visible then Exit;
  { Assistente IA (painel lateral "O que deseja fazer?") e excecao: hint continua. }

  if isChecked then
  begin
    if not (Assigned(FCheckListBox) and FCheckListBox.Visible) then Exit;
  end
  else if not (Assigned(ListView1) and ListView1.Visible) then
    Exit;

  Result := True;
end;

procedure TfrmMain.ApplyListViewNativeTipsDisabled;
var
  Style: DWORD;
begin

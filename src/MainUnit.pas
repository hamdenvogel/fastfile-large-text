procedure TfrmMain.ShowTab(const tabSheet: TsTabSheet(*; const showOtherTabs: Boolean = False*));
var
  I: Integer;
begin
  { Mantem abas ja abertas; apenas garante visibilidade/foco da nova aba. }
  if (tabSheet <> tabReadFile) then
    ClearFileLineHoverHint;
  if Assigned(tabSheet) and Assigned(FPendingTabBuild) then
  begin
    I := FPendingTabBuild.IndexOf(tabSheet.Name);
    if I >= 0 then
      FPendingTabBuild.Delete(I);
  end;
  if (pgMain.PageCount > 0) then
  begin
    tabSheet.TabVisible := True;
    pgMain.ActivePage := tabSheet;
  end;
  pgMain.Visible := True;
  { Nao forcar tsButtons: com TsSkinProvider + SkinSection BUTTON, a faixa de abas
    pode ser tratada como HTCAPTION; clique/duplo-clique maximiza a janela sem reversao util. }
  pgMain.ShowCloseBtns := True;
  if Assigned(sStatusBar1) then
    sStatusBar1.Visible := True;
  UpdateIdleLogoVisibility;
  if Assigned(tabSheet) then
    RememberOpenTabName(tabSheet.Name);
  if tabSheet = tabReadFile then
    RunPendingFilterBarRestore;
end;

procedure TfrmMain.HideTabs(const showOtherTabs: Boolean = False);
var
  indexTabToHide: integer;
begin
  ClearFileLineHoverHint;
  if not showOtherTabs then
    pgMain.Visible := False
  else
  begin
    indexTabToHide := pgMain.ActivePageIndex;
    pgMain.Pages[indexTabToHide].TabVisible := False;
  end;
  frmMain.PopupMenu := PopupMenu1;
  if Assigned(sStatusBar1) then
    sStatusBar1.Visible := True;
  UpdateIdleLogoVisibility;
  if showOtherTabs then
    pgMainPageChange(pgMain);
end;

procedure TfrmMain.SaveOpenTabsToIni;
var
  i: Integer;
  Ids, ActiveId, FilePath: string;
  Pg: TsTabSheet;
begin
  if IniName = '' then Exit;
  Ids := '';
  ActiveId := '';
  FilePath := '';
  if Assigned(pgMain) and pgMain.Visible then
  begin
    for i := 0 to pgMain.PageCount - 1 do
    begin
      if not (pgMain.Pages[i] is TsTabSheet) then Continue;
      Pg := TsTabSheet(pgMain.Pages[i]);
      if not Pg.TabVisible then Continue;
      if Ids <> '' then
        Ids := Ids + ';';
      Ids := Ids + Pg.Name;
    end;
    if Assigned(pgMain.ActivePage) and pgMain.ActivePage.TabVisible then
      ActiveId := pgMain.ActivePage.Name;
  end;
  FilePath := Trim(CurrentEffectiveFilePath);
  if (FilePath = '') or SameText(FilePath, SELECTTEXT) then
    FilePath := Trim(edtFileName.Text);
  if SameText(FilePath, SELECTTEXT) then
    FilePath := '';
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_OPEN_TABS_SAVED, '1', IniName);
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_OPEN_TABS, Ids, IniName);
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_OPEN_TABS_ACTIVE, ActiveId, IniName);
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_OPEN_TABS_FILE, FilePath, IniName);
  SaveOpenTabsMruToIni;
end;

procedure TfrmMain.RestoreEdtFileNameFromIni;
var
  FilePath: string;
begin
  if IniName = '' then Exit;
  if not Assigned(edtFileName) then Exit;
  if sStoreUtils.ReadIniInteger(APPLICATION_NAME, INI_OPEN_TABS_SAVED, 0, IniName) <> 1 then
    Exit;
  FilePath := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS_FILE, IniName));
  if (FilePath = '') or SameText(FilePath, SELECTTEXT) then
  begin
    edtFileName.Text := '';
    Exit;
  end;
  edtFileName.Text := FilePath;
  ApplySessionReadOnlyFilenameDecoration;
  SyncReadFileF5Button;
end;

procedure TfrmMain.LoadOpenTabsMruFromIni;
var
  S, One, Rest: string;
  P: Integer;
begin
  if not Assigned(FOpenTabsMru) then
    FOpenTabsMru := TStringList.Create;
  FOpenTabsMru.Clear;
  if IniName = '' then Exit;
  S := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS_MRU, IniName));
  Rest := S;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P = 0 then
    begin
      One := Trim(Rest);
      Rest := '';
    end
    else
    begin
      One := Trim(Copy(Rest, 1, P - 1));
      Delete(Rest, 1, P);
    end;
    if (One <> '') and (FOpenTabsMru.IndexOf(One) < 0) then
    begin
      FOpenTabsMru.Add(One);
      if FOpenTabsMru.Count >= PrefOpenTabsMruMax then
        Break;
    end;
  end;
end;

procedure TfrmMain.SaveOpenTabsMruToIni;
var
  i: Integer;
  S: string;
begin
  if IniName = '' then Exit;
  S := '';
  if Assigned(FOpenTabsMru) then
    for i := 0 to FOpenTabsMru.Count - 1 do
    begin
      if S <> '' then
        S := S + ';';
      S := S + FOpenTabsMru[i];
    end;
  sStoreUtils.WriteIniStr(APPLICATION_NAME, INI_OPEN_TABS_MRU, S, IniName);
end;

function TfrmMain.OpenTabDisplayCaption(const ATabName: string): string;
var
  Id: string;
  Comp: TComponent;
begin
  Id := Trim(ATabName);
  if SameText(Id, 'tabReadFile') then
    Result := TrText('Read File')
  else if SameText(Id, 'tabSplitFile') then
    Result := TrText('Split File')
  else if SameText(Id, 'tabExportedLines') then
    Result := TrText('Exported Lines')
  else if SameText(Id, 'tabFindFiles') then
    Result := TrText('Find Files')
  else if SameText(Id, 'tabRecentFiles') then
    Result := TrText('Recent Files & Folders')
  else if SameText(Id, 'tabMerge') then
    Result := TrText('Compare / merge + session history')
  else if SameText(Id, 'tabMergeLines') then
    Result := TrText('Merge lines')
  else if SameText(Id, 'tabMergeFiles') then
    Result := TrText('Merge files')
  else if SameText(Id, 'tabSplitByPatternTab') then
    Result := TrText('Split file by Pattern/Regex')
  else if SameText(Id, 'tabSplitEqualPartsTab') then
    Result := TrText('Split file into equal parts')
  else if SameText(Id, 'tabSplitFractionTab') then
    Result := TrText('Extract file parts from file')
  else
  begin
    Comp := FindComponent(Id);
    if Comp is TsTabSheet then
      Result := TsTabSheet(Comp).Caption
    else
      Result := Id;
  end;
end;

procedure TfrmMain.RememberOpenTabName(const ATabName: string);
var
  Id: string;
  Idx: Integer;
begin
  if FRestoringOpenTabs or FApplicationClosing then Exit;
  Id := Trim(ATabName);
  if Id = '' then Exit;
  if not Assigned(FOpenTabsMru) then
    FOpenTabsMru := TStringList.Create;
  Idx := FOpenTabsMru.IndexOf(Id);
  if Idx = 0 then Exit;
  if Idx > 0 then
    FOpenTabsMru.Delete(Idx);
  FOpenTabsMru.Insert(0, Id);
  while FOpenTabsMru.Count > PrefOpenTabsMruMax do
    FOpenTabsMru.Delete(FOpenTabsMru.Count - 1);
  SaveOpenTabsMruToIni;
  RebuildRecentTabsMenu;
end;

procedure TfrmMain.FillRecentTabsSubmenu(AParent: TMenuItem);
var
  Item: TMenuItem;
  i: Integer;
  HasSession: Boolean;
  Ids: string;
begin
  if not Assigned(AParent) then Exit;
  while AParent.Count > 0 do
    AParent.Items[AParent.Count - 1].Free;
  HasSession := (IniName <> '') and
    (sStoreUtils.ReadIniInteger(APPLICATION_NAME, INI_OPEN_TABS_SAVED, 0, IniName) = 1);
  if HasSession then
    Ids := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS, IniName))
  else
    Ids := '';

  Item := TMenuItem.Create(AParent);
  Item.Caption := TrText('Restore last session tabs');
  Item.OnClick := miRestoreLastSessionTabsClick;
  Item.Enabled := HasSession and (Ids <> '');
  Item.ImageIndex := MenuIconIndex('history.bmp', MenuIconIndex('redo.bmp', 24));
  AParent.Add(Item);

  Item := TMenuItem.Create(AParent);
  Item.Caption := '-';
  AParent.Add(Item);

  if not Assigned(FOpenTabsMru) or (FOpenTabsMru.Count = 0) then
  begin
    Item := TMenuItem.Create(AParent);
    Item.Caption := TrText('No recent tabs');
    Item.Enabled := False;
    AParent.Add(Item);
    Exit;
  end;

  for i := 0 to FOpenTabsMru.Count - 1 do
  begin
    Item := TMenuItem.Create(AParent);
    Item.Caption := OpenTabDisplayCaption(FOpenTabsMru[i]);
    Item.Hint := FOpenTabsMru[i];
    Item.OnClick := miOpenRecentTabClick;
    Item.ImageIndex := MenuIconIndex('open.bmp', 3);
    AParent.Add(Item);
  end;
end;

procedure TfrmMain.RebuildRecentTabsMenu;
begin
  if Assigned(FMenuRecentTabs) then
    FillRecentTabsSubmenu(FMenuRecentTabs);
  if Assigned(FPopupLVRecentTabs) then
    FillRecentTabsSubmenu(FPopupLVRecentTabs);
end;


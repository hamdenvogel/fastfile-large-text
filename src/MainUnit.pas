procedure TfrmMain.HandleReadIndexFailure(const AFileName, AErrorDetail: string);
var
  Path, Msg: string;
  Choice: Integer;
  FileSize1: Int64;
begin
  EndFileReloadInProgress;
  Path := Trim(AFileName);
  if Path = '' then Exit;
  if not FileExists(Path) then
    Path := ExpandFileName(Path);
  Msg := Format(TrText('Open.IndexFailed.Body'),
    [ExtractFileName(Path), AErrorDetail]) + #13#10#13#10 +
    TrText('Open.IndexFailed.RetryHint');
  Choice := FastFileMessageBox(PChar(Msg), PChar(TrText('Open.IndexFailed.Title')),
    MB_YESNO or MB_ICONWARNING);
  if Choice <> IDYES then
  begin
    UpdateStatusBar(TrText('Open.IndexFailed.Cancelled'), iaRight);
    Exit;
  end;
  AddInstantFallbackFile(Path);
  SaveFileOpenPolicyToIni(IniName);
  FFreshFileRead := True;
  fFileName := Path;
  edtFileName.Text := Path;
  try
    FileSize1 := GetFileSize(Path);
  except
    FileSize1 := 0;
  end;
  try ActionClear.Execute; except end;
  try CloseFileStreams; except end;
  StopScriptEngineProcess;
  CleanupFastFileLineIndexFiles;
  RememberInstantOpenTimer(True);
  finishFileNameRead(TrText('Open.InstantRetry.Status'), 2000000000, FileSize1);
end;

procedure TfrmMain.DoConfigureMaxGbFileIndexed;
var
  Frm: TForm;
  LblPrompt, LblHint: TLabel;
  EdGb: TEdit;
  BtnOk, BtnCancel: TButton;
  S, ErrKey: string;
  NewGb, CurGb, ConfirmChoice: Integer;
  MR: Integer;
begin
  CurGb := GetMaxGbFileIndexed;
  Frm := TForm.Create(Self);
  try
    Frm.Caption := TrText('Open.MaxGbLimit.Title');
    Frm.Position := poScreenCenter;
    Frm.BorderStyle := bsDialog;
    Frm.Width := 440;
    Frm.Height := 220;
    Frm.KeyPreview := True;

    LblPrompt := TLabel.Create(Frm);
    LblPrompt.Parent := Frm;
    LblPrompt.Left := 16;
    LblPrompt.Top := 16;
    LblPrompt.Width := Frm.ClientWidth - 32;
    LblPrompt.Caption := TrText('Open.MaxGbLimit.Prompt');
    LblPrompt.AutoSize := False;
    LblPrompt.WordWrap := True;

    EdGb := TEdit.Create(Frm);
    EdGb.Parent := Frm;
    EdGb.Left := 16;
    EdGb.Top := 56;
    EdGb.Width := 120;
    EdGb.Text := IntToStr(CurGb);

    LblHint := TLabel.Create(Frm);
    LblHint.Parent := Frm;
    LblHint.Left := 16;
    LblHint.Top := 88;
    LblHint.Width := Frm.ClientWidth - 32;
    LblHint.Caption := Format(TrText('Open.MaxGbLimit.RangeHint'),
      [MAX_GB_FILE_INDEXED_MIN, MAX_GB_FILE_INDEXED_MAX, MAX_GB_FILE_INDEXED_DEFAULT]);
    LblHint.AutoSize := False;
    LblHint.WordWrap := True;

    BtnOk := TButton.Create(Frm);
    BtnOk.Parent := Frm;
    BtnOk.Caption := TrText('OK');
    BtnOk.Width := 90;
    BtnOk.Height := 28;
    BtnOk.Left := Frm.ClientWidth - 200;
    BtnOk.Top := Frm.ClientHeight - 44;
    BtnOk.ModalResult := mrOk;
    BtnOk.Default := True;

    BtnCancel := TButton.Create(Frm);
    BtnCancel.Parent := Frm;
    BtnCancel.Caption := TrText('Cancel');
    BtnCancel.Width := 90;
    BtnCancel.Height := 28;
    BtnCancel.Left := Frm.ClientWidth - 100;
    BtnCancel.Top := Frm.ClientHeight - 44;
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Cancel := True;

    MR := Frm.ShowModal;
    if MR <> mrOk then Exit;

    S := Trim(EdGb.Text);
    if not ValidateMaxGbFileIndexedInput(S, NewGb, ErrKey) then
    begin
      FastFileMessageBox(PChar(TrText(ErrKey)), PChar(TrText('Open.MaxGbLimit.Title')),
        MB_OK or MB_ICONWARNING);
      Exit;
    end;

    ConfirmChoice := FastFileMessageBox(
      PChar(Format(TrText('Open.MaxGbLimit.Confirm'), [NewGb])),
      PChar(TrText('Confirmation')), MB_YESNO or MB_ICONQUESTION);
    if ConfirmChoice <> IDYES then Exit;

    SetMaxGbFileIndexed(NewGb);
    SaveFileOpenPolicyToIni(IniName);
    FastFileMessageBox(PChar(Format(TrText('Open.MaxGbLimit.Saved'), [GetMaxGbFileIndexed])),
      PChar(TrText('Open.MaxGbLimit.Title')), MB_OK or MB_ICONINFORMATION);
  finally
    Frm.Free;
  end;
end;

procedure TfrmMain.miConfigureMaxGbClick(Sender: TObject);
begin
  DoConfigureMaxGbFileIndexed;
end;


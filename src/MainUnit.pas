{ Bookmarks                                                                    }
{ ============================================================================ }

function TfrmMain.BookmarkIndexOf(RealLineIndex: Integer): Integer;
var
  Lo, Hi, Mid, Val: Integer;
begin
  Result := -1;
  if not Assigned(FBookmarks) then Exit;
  Lo := 0;
  Hi := FBookmarks.Count - 1;
  while Lo <= Hi do begin
    Mid := (Lo + Hi) div 2;
    Val := Integer(FBookmarks[Mid]);
    if Val = RealLineIndex then begin Result := Mid; Exit; end
    else if Val < RealLineIndex then Lo := Mid + 1
    else Hi := Mid - 1;
  end;
end;

function TfrmMain.IsBookmarked(RealLineIndex: Integer): Boolean;
begin
  Result := BookmarkIndexOf(RealLineIndex) >= 0;
end;

procedure TfrmMain.ToggleBookmark(RealLineIndex: Integer);
var
  Idx, Lo, Hi, Mid, Val: Integer;
  Byte1, CurByte: Int64;
  BLo, BHi, BMid: Integer;
begin
  if UsesProportionalZeroScanScroll then
  begin
    Byte1 := GetLineStartOffset(RealLineIndex);
    if Byte1 < 1 then Byte1 := 1;
    Lo := 0;
    Hi := High(FBookmarkBytes);
    Idx := -1;
    while Lo <= Hi do
    begin
      BMid := (Lo + Hi) div 2;
      if FBookmarkBytes[BMid] = Byte1 then
      begin
        Idx := BMid;
        Break;
      end;
      if FBookmarkBytes[BMid] < Byte1 then
        Lo := BMid + 1
      else
        Hi := BMid - 1;
    end;
    if Idx >= 0 then
    begin
      if Idx < High(FBookmarkBytes) then
        Move(FBookmarkBytes[Idx + 1], FBookmarkBytes[Idx],
          (High(FBookmarkBytes) - Idx) * SizeOf(Int64));
      SetLength(FBookmarkBytes, Length(FBookmarkBytes) - 1);
    end
    else
    begin
      if Length(FBookmarkBytes) >= 10000 then
      begin
        FastFileMessageBox(PChar(TrText('Bookmark limit reached (10,000).')), APPLICATION_NAME,
          MB_OK or MB_ICONWARNING);
        Exit;
      end;
      Lo := 0;
      Hi := High(FBookmarkBytes);
      while Lo <= Hi do
      begin
        BMid := (Lo + Hi) div 2;
        if FBookmarkBytes[BMid] < Byte1 then
          Lo := BMid + 1
        else
          Hi := BMid - 1;
      end;
      SetLength(FBookmarkBytes, Length(FBookmarkBytes) + 1);
      if Lo < Length(FBookmarkBytes) - 1 then
        Move(FBookmarkBytes[Lo], FBookmarkBytes[Lo + 1],
          (Length(FBookmarkBytes) - Lo - 1) * SizeOf(Int64));
      FBookmarkBytes[Lo] := Byte1;
    end;
    ListView1.Invalidate;
    if BookmarkCount > 0 then
      ShowBookmarkBar
    else
    begin
      RefreshBookmarkBarList;
      HideBookmarkBarChrome;
    end;
    Exit;
  end;
  if not Assigned(FBookmarks) then Exit;
  Idx := BookmarkIndexOf(RealLineIndex);
  if Idx >= 0 then
    FBookmarks.Delete(Idx)
  else begin
    if FBookmarks.Count >= 10000 then begin
      FastFileMessageBox(PChar(TrText('Bookmark limit reached (10,000).')), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;
    Lo := 0;
    Hi := FBookmarks.Count - 1;
    while Lo <= Hi do begin
      Mid := (Lo + Hi) div 2;
      Val := Integer(FBookmarks[Mid]);
      if Val < RealLineIndex then Lo := Mid + 1
      else Hi := Mid - 1;
    end;
    FBookmarks.Insert(Lo, Pointer(RealLineIndex));
  end;
  ListView1.Invalidate;
  if BookmarkCount > 0 then
    ShowBookmarkBar
  else
  begin
    RefreshBookmarkBarList;
    HideBookmarkBarChrome;
  end;
end;

procedure TfrmMain.GotoNextBookmark;
var
  CurIdx, I, RealLine, BkLine, TryBk: Integer;
  AnchorFromTop, TargetVisibleIdx: Integer;
  MaxOff, ScrollExtent: Int64;
  FIdx, CurByte: Int64;
begin
  if not Assigned(FBookmarks) or (FBookmarks.Count = 0) then begin
    FastFileMessageBox(PChar(TrText('No bookmarks set.')), APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  { No modo Select, obter posicao atual da checklist, nao da ListView oculta. }
  if isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0) then
  begin
    if FFilterActive then
      CurIdx := Integer(Offset) + FCheckListBox.ItemIndex  { indice filtrado }
    else
      CurIdx := FCheckListBox.ItemIndex;  { indice visivel (usado com Offset abaixo) }
  end
  else
    CurIdx := ListView1.ItemIndex;
  BkLine := -1;
  if FFilterActive then
  begin
    if CurIdx >= 0 then
      RealLine := Integer(FilteredIndexToReal(CurIdx))
    else
      RealLine := -1;
    for I := 0 to FBookmarks.Count - 1 do
    begin
      TryBk := Integer(FBookmarks[I]);
      if TryBk <= RealLine then Continue;
      if FilteredIndexForRealLine(TryBk) >= 0 then begin BkLine := TryBk; Break; end;
    end;
    if BkLine < 0 then
      for I := 0 to FBookmarks.Count - 1 do
      begin
        TryBk := Integer(FBookmarks[I]);
        if FilteredIndexForRealLine(TryBk) >= 0 then begin BkLine := TryBk; Break; end;
      end;
    if BkLine < 0 then
    begin
      FastFileMessageBox(PChar(TrText('No bookmarks found in current filter results.')), APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
      Exit;
    end;
    FIdx := FilteredIndexForRealLine(BkLine);
    if FIdx < 0 then Exit;
    if isChecked and Assigned(FCheckListBox) then
    begin
      if VisibleItems <= 0 then
        VisibleItems := 1;
      AnchorFromTop := Integer(VisibleItems div 2);
      Offset := FIdx - AnchorFromTop;
      MaxOff := FFilteredCount - VisibleItems;
      if MaxOff < 0 then MaxOff := 0;
      if Offset < 0 then Offset := 0;
      if Offset > MaxOff then Offset := MaxOff;
      ScrollExtent := FFilteredCount;
      if ScrollExtent < 1 then ScrollExtent := 1;
      fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff);
      SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
    end
    else
    begin
      Offset := 0;
      fScrollPos := 0;
      SafeSetScrollBarPosition(ScrollBarVertical, 0);
    end;
    SelectListViewItem(Integer(FIdx));
    if isChecked and Assigned(FCheckListBox) then
    begin
      showChecked;
      TargetVisibleIdx := Integer(FIdx - Offset);
      if (TargetVisibleIdx >= 0) and (TargetVisibleIdx < FCheckListBox.Items.Count) then
        FCheckListBox.ItemIndex := TargetVisibleIdx;
      if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
    end
    else if ListView1.CanFocus then
      ListView1.SetFocus;
    Exit;
  end;
  if Length(FBookmarkBytes) > 0 then
  begin
    CurByte := GetLineStartOffset(Offset + CurIdx);
    if CurByte < 1 then CurByte := 1;
    BkLine := -1;
    for I := 0 to High(FBookmarkBytes) do
      if FBookmarkBytes[I] > CurByte then
      begin
        ScrollToFileBytePos(FBookmarkBytes[I] - 1, -1);
        Exit;
      end;
    if High(FBookmarkBytes) >= 0 then
      ScrollToFileBytePos(FBookmarkBytes[0] - 1, -1);
    Exit;
  end;
  if CurIdx < 0 then CurIdx := -1;
  RealLine := Integer(Offset + CurIdx);
  for I := 0 to FBookmarks.Count - 1 do
    if Integer(FBookmarks[I]) > RealLine then begin BkLine := Integer(FBookmarks[I]); Break; end;
  if BkLine < 0 then BkLine := Integer(FBookmarks[0]);
  if (BkLine >= 0) and (BkLine < totalLines) then
    { F2: usar ancora central para reduzir movimento visual e facilitar contexto. }
    gotoLineWithAnchor(BkLine, Integer(VisibleItems div 2));
  if isChecked and Assigned(FCheckListBox) then
  begin
    if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
  end
  else if ListView1.CanFocus then
    ListView1.SetFocus;
end;

procedure TfrmMain.GotoPrevBookmark;
var
  CurIdx, I, RealLine, BkLine, TryBk: Integer;
  AnchorFromTop, TargetVisibleIdx: Integer;
  MaxOff, ScrollExtent: Int64;
  FIdx: Int64;
begin
  if not Assigned(FBookmarks) or (FBookmarks.Count = 0) then begin
    FastFileMessageBox(PChar(TrText('No bookmarks set.')), APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  { No modo Select, obter posicao atual da checklist, nao da ListView oculta. }
  if isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0) then
  begin
    if FFilterActive then
      CurIdx := Integer(Offset) + FCheckListBox.ItemIndex
    else
      CurIdx := FCheckListBox.ItemIndex;
  end
  else
    CurIdx := ListView1.ItemIndex;
  BkLine := -1;
  if FFilterActive then
  begin
    if CurIdx >= 0 then
      RealLine := Integer(FilteredIndexToReal(CurIdx))
    else
      RealLine := MaxInt;
    for I := FBookmarks.Count - 1 downto 0 do
    begin
      TryBk := Integer(FBookmarks[I]);
      if TryBk >= RealLine then Continue;
      if FilteredIndexForRealLine(TryBk) >= 0 then begin BkLine := TryBk; Break; end;
    end;
    if BkLine < 0 then
      for I := FBookmarks.Count - 1 downto 0 do
      begin
        TryBk := Integer(FBookmarks[I]);
        if FilteredIndexForRealLine(TryBk) >= 0 then begin BkLine := TryBk; Break; end;
      end;
    if BkLine < 0 then
    begin
      FastFileMessageBox(PChar(TrText('No bookmarks found in current filter results.')), APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
      Exit;
    end;
    FIdx := FilteredIndexForRealLine(BkLine);
    if FIdx < 0 then Exit;
    if isChecked and Assigned(FCheckListBox) then
    begin
      if VisibleItems <= 0 then
        VisibleItems := 1;
      AnchorFromTop := Integer(VisibleItems div 2);
      Offset := FIdx - AnchorFromTop;
      MaxOff := FFilteredCount - VisibleItems;
      if MaxOff < 0 then MaxOff := 0;
      if Offset < 0 then Offset := 0;
      if Offset > MaxOff then Offset := MaxOff;
      ScrollExtent := FFilteredCount;
      if ScrollExtent < 1 then ScrollExtent := 1;
      fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff);
      SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
    end
    else
    begin
      Offset := 0;
      fScrollPos := 0;
      SafeSetScrollBarPosition(ScrollBarVertical, 0);
    end;
    SelectListViewItem(Integer(FIdx));
    if isChecked and Assigned(FCheckListBox) then
    begin
      showChecked;
      TargetVisibleIdx := Integer(FIdx - Offset);
      if (TargetVisibleIdx >= 0) and (TargetVisibleIdx < FCheckListBox.Items.Count) then
        FCheckListBox.ItemIndex := TargetVisibleIdx;
      if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
    end
    else if ListView1.CanFocus then
      ListView1.SetFocus;
    Exit;
  end;
  if CurIdx < 0 then CurIdx := MaxInt;
  RealLine := Integer(Offset + CurIdx);
  for I := FBookmarks.Count - 1 downto 0 do
    if Integer(FBookmarks[I]) < RealLine then begin BkLine := Integer(FBookmarks[I]); Break; end;
  if BkLine < 0 then BkLine := Integer(FBookmarks[FBookmarks.Count - 1]);
  if (BkLine >= 0) and (BkLine < totalLines) then
    { Shift+F2: mesma ancora central do F2. }
    gotoLineWithAnchor(BkLine, Integer(VisibleItems div 2));
  if isChecked and Assigned(FCheckListBox) then
  begin
    if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
  end
  else if ListView1.CanFocus then
    ListView1.SetFocus;
end;

procedure TfrmMain.ClearAllBookmarks;
begin
  SetLength(FBookmarkBytes, 0);
  if Assigned(FBookmarks) then
    FBookmarks.Clear;
  ListView1.Invalidate;
  UpdateInfoPanels;
  { Atualizar prefixo '* Line:' nos itens da checklist (modo Select). }
  if isChecked then showChecked;
  RefreshBookmarkBarList;
  if BookmarkCount = 0 then
    HideBookmarkBarChrome;
end;

function TfrmMain.BookmarkCount: Integer;
begin
  if UsesProportionalZeroScanScroll then
    Result := Length(FBookmarkBytes)
  else if Assigned(FBookmarks) then
    Result := FBookmarks.Count
  else
    Result := 0;
end;

function TfrmMain.BookmarkBarIsFloating: Boolean;
begin
  Result := Assigned(FBookmarkBar) and ControlIsOnFloatForm(FBookmarkBar);
end;

procedure TfrmMain.UpdateBookmarkDockZone(Sender: TObject);
var
  P1, P2: TPoint;
begin
  if not Assigned(FBookmarkFloat) or not Assigned(pnlCenter) then Exit;
  P1 := pnlCenter.ClientToScreen(Point(0, 0));
  P2 := pnlCenter.ClientToScreen(Point(pnlCenter.ClientWidth, pnlCenter.ClientHeight));
  FBookmarkFloat.SetDockZone(Rect(P1.X, P1.Y, P2.X, P2.Y));
  FBookmarkFloat.SetMainMagnet(Rect(0, 0, 0, 0));
end;

procedure TfrmMain.FloatBookmarkBar(AFollowCursor: Boolean);
var
  Ini: TIniFile;
  L, T, W, H: Integer;
begin
  EnsureBookmarkBar;
  if not Assigned(FBookmarkBar) or BookmarkBarIsFloating then Exit;
  if not Assigned(FBookmarkFloat) then
  begin
    FBookmarkFloat := TFastFileFloatForm.CreateHost(Self, TrText('BookmarkBar.Title'));
    FBookmarkFloat.OnRequestDock := DockBookmarkBar;
    FBookmarkFloat.OnUpdateDockZone := UpdateBookmarkDockZone;
    FBookmarkFloat.Constraints.MinHeight := FfPx(140);
    FBookmarkFloat.Constraints.MinWidth := FfPx(360);
  end;
  FBookmarkFloat.Caption := TrText('BookmarkBar.Title');
  W := FBookmarkBar.Width;
  if W < 420 then W := 420;
  H := FBookmarkBar.Height + 36;
  L := 0;
  T := 0;
  if not AFollowCursor then
  begin
    Ini := TIniFile.Create(IniName);
    try
      L := Ini.ReadInteger('UIPrefs', 'BookmarkFloatLeft', 0);
      T := Ini.ReadInteger('UIPrefs', 'BookmarkFloatTop', 0);
      W := Ini.ReadInteger('UIPrefs', 'BookmarkFloatWidth', W);
      H := Ini.ReadInteger('UIPrefs', 'BookmarkFloatHeight', H);
    finally
      Ini.Free;
    end;
  end;
  ReparentAligned(FBookmarkBar, FBookmarkFloat, alClient);
  if AFollowCursor then
    FBookmarkFloat.PlaceUnderCursor(W, H)
  else if (L <> 0) or (T <> 0) then
    FBookmarkFloat.ApplySavedBounds(L, T, W, H)
  else
    FBookmarkFloat.PlaceBesideMain(W, H);
  UpdateBookmarkDockZone(nil);
  FBookmarkFloat.Show;
  FBookmarkFloat.BringToFront;
  FBookmarkBar.SetFloatingLook(True);
  FBookmarkBar.Visible := True;
  FBookmarkChromeHidden := False;
  if Assigned(FBookmarkPeek) then
    FBookmarkPeek.Visible := False;
  if Assigned(pnlCenter) then
    pnlCenter.Realign;
  if AFollowCursor then
  begin
    FBookmarkFloat.MarkJustTornOff;
    FBookmarkFloat.BeginCaptionFollow;
  end;
end;

procedure TfrmMain.DockBookmarkBar(Sender: TObject);
var
  Ini: TIniFile;
begin
  if not Assigned(FBookmarkBar) or not BookmarkBarIsFloating then Exit;
  if Assigned(FBookmarkFloat) then
  begin
    Ini := TIniFile.Create(IniName);
    try
      Ini.WriteInteger('UIPrefs', 'BookmarkFloatLeft', FBookmarkFloat.Left);
      Ini.WriteInteger('UIPrefs', 'BookmarkFloatTop', FBookmarkFloat.Top);
      Ini.WriteInteger('UIPrefs', 'BookmarkFloatWidth', FBookmarkFloat.Width);
      Ini.WriteInteger('UIPrefs', 'BookmarkFloatHeight', FBookmarkFloat.Height);
      Ini.WriteBool('UIPrefs', 'BookmarkFloating', False);
    finally
      Ini.Free;
    end;
  end;
  ReparentAligned(FBookmarkBar, pnlCenter, alTop);
  FBookmarkBar.Height := FBookmarkBar.PreferredHeight;
  if Assigned(FBookmarkFloat) then
    FBookmarkFloat.Hide;
  FBookmarkBar.SetFloatingLook(False);
  FBookmarkBar.RelayoutAfterDock;
  FBookmarkBar.Visible := True;
  FBookmarkChromeHidden := False;
  if Assigned(pnlCenter) then
    pnlCenter.Realign;
end;

procedure TfrmMain.BookmarkBarFloat(Sender: TObject);
begin
  if BookmarkBarIsFloating then
    DockBookmarkBar
  else
    FloatBookmarkBar(False);
end;

procedure TfrmMain.BookmarkBarTearOff(Sender: TObject);
begin
  if BookmarkBarIsFloating then
  begin
    UpdateBookmarkDockZone(nil);
    if Assigned(FBookmarkFloat) then
      FBookmarkFloat.BeginCaptionFollowNow;
  end
  else
    FloatBookmarkBar(True);
end;

procedure TfrmMain.EnsureBookmarkBar;
begin
  if not Assigned(pnlCenter) then Exit;
  if Assigned(FBookmarkBar) then Exit;

  FBookmarkPeek := TFastFileBookmarkPeek.Create(Self);
  FBookmarkPeek.Parent := pnlCenter;
  FBookmarkPeek.Visible := False;
  FBookmarkPeek.OnRestore := BookmarkBarPeekRestore;

  FBookmarkBar := TFastFileBookmarkBar.Create(Self);
  FBookmarkBar.Parent := pnlCenter;
  FBookmarkBar.EnsureBuilt;
  FBookmarkBar.Visible := False;
  FBookmarkBar.OnPrev := BookmarkBarPrev;
  FBookmarkBar.OnNext := BookmarkBarNext;
  FBookmarkBar.OnRemove := BookmarkBarRemove;
  FBookmarkBar.OnClear := BookmarkBarClear;
  FBookmarkBar.OnExport := BookmarkBarExport;
  FBookmarkBar.OnCopy := BookmarkBarCopy;
  FBookmarkBar.OnHide := BookmarkBarHide;
  FBookmarkBar.OnFloat := BookmarkBarFloat;
  FBookmarkBar.OnTearOff := BookmarkBarTearOff;
  FBookmarkBar.OnJump := BookmarkBarJump;
  FBookmarkBar.OnListPagePrev := BookmarkBarListPagePrev;
  FBookmarkBar.OnListPageNext := BookmarkBarListPageNext;
  FBookmarkBar.ApplyCaptions;
  FBookmarkBar.ApplySoftChrome;
end;

procedure TfrmMain.ShowBookmarkBar;
begin
  EnsureBookmarkBar;
  if not Assigned(FBookmarkBar) then Exit;
  FBookmarkChromeHidden := False;
  if Assigned(FBookmarkPeek) then
    FBookmarkPeek.Visible := False;
  if BookmarkBarIsFloating then
  begin
    if Assigned(FBookmarkFloat) then
    begin
      FBookmarkFloat.Show;
      FBookmarkFloat.BringToFront;
    end;
    FBookmarkBar.Visible := True;
  end
  else
  begin
    FBookmarkBar.Visible := True;
    FBookmarkBar.Height := FBookmarkBar.PreferredHeight;
    FBookmarkBar.BringToFront;
    FBookmarkBar.RelayoutAfterDock;
  end;
  RefreshBookmarkBarList;
end;

procedure TfrmMain.HideBookmarkBarChrome;
begin
  if not Assigned(FBookmarkBar) then Exit;
  if BookmarkBarIsFloating and Assigned(FBookmarkFloat) then
    FBookmarkFloat.Hide;
  FBookmarkBar.Visible := False;
  FBookmarkChromeHidden := True;
  if Assigned(FBookmarkPeek) and (not BookmarkBarIsFloating) then
    FBookmarkPeek.Visible := BookmarkCount > 0;
end;

procedure TfrmMain.RefreshBookmarkBarList;
var
  N: Integer;
begin
  if not Assigned(FBookmarkBar) then Exit;
  N := BookmarkCount;
  if N <= 0 then
  begin
    FBookmarkBar.ClearList;
    FBookmarkBar.SetStatus(TrText('No bookmarks set.'), False);
    Exit;
  end;
  if FBookmarkListPage < 0 then
    FBookmarkListPage := 0;
  FillBookmarkListPage;
  FBookmarkBar.SetStatus(Format(TrText('BookmarkBar.Status.Count'), [N]), True);
end;

procedure TfrmMain.FillBookmarkListPage;
var
  SL: TStringList;
  PageSize, PageCount, Base, I, Idx, RealLine: Integer;
  Preview, LineTxt: string;
begin
  if not Assigned(FBookmarkBar) then Exit;
  PageSize := BOOKMARK_LIST_PAGE_SIZE;
  if PageSize < 1 then PageSize := 40;
  PageCount := (BookmarkCount + PageSize - 1) div PageSize;
  if PageCount < 1 then PageCount := 1;
  if FBookmarkListPage >= PageCount then
    FBookmarkListPage := PageCount - 1;
  if FBookmarkListPage < 0 then
    FBookmarkListPage := 0;
  Base := FBookmarkListPage * PageSize;
  SL := TStringList.Create;
  try
    for I := 0 to PageSize - 1 do
    begin
      Idx := Base + I;
      if Idx >= BookmarkCount then Break;
      if UsesProportionalZeroScanScroll then
      begin
        Preview := Format(TrText('BookmarkBar.ByteFmt'), [FBookmarkBytes[Idx]]);
        SL.Add(Preview);
      end
      else
      begin
        RealLine := Integer(FBookmarks[Idx]);
        LineTxt := GetLineContent(RealLine);
        Preview := Trim(LineTxt);
        if Length(Preview) > 120 then
          Preview := Copy(Preview, 1, 117) + '...';
        SL.Add(Format(TrText('BookmarkBar.HitLineFmt'), [RealLine + 1, Preview]));
      end;
    end;
    FBookmarkBar.SetListPage(SL, Base, FBookmarkListPage + 1, PageCount,
      BookmarkCount, FBookmarkListPage > 0, FBookmarkListPage < PageCount - 1);
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.BookmarkBarPrev(Sender: TObject);
begin
  GotoPrevBookmark;
end;

procedure TfrmMain.BookmarkBarNext(Sender: TObject);
begin
  GotoNextBookmark;
end;

procedure TfrmMain.BookmarkBarJump(Sender: TObject; AIndex: Integer);
var
  RealLine: Integer;
begin
  if UsesProportionalZeroScanScroll then
  begin
    if (AIndex < 0) or (AIndex > High(FBookmarkBytes)) then Exit;
    ScrollToFileBytePos(FBookmarkBytes[AIndex] - 1, -1);
    Exit;
  end;
  if not Assigned(FBookmarks) or (AIndex < 0) or (AIndex >= FBookmarks.Count) then Exit;
  RealLine := Integer(FBookmarks[AIndex]);
  if (RealLine >= 0) and (RealLine < totalLines) then
    gotoLineWithAnchor(RealLine, Integer(VisibleItems div 2));
  if isChecked and Assigned(FCheckListBox) then
  begin
    if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
  end
  else if Assigned(ListView1) and ListView1.CanFocus then
    ListView1.SetFocus;
end;

procedure TfrmMain.BookmarkBarRemove(Sender: TObject);
var
  Idx, RealLine: Integer;
begin
  if not Assigned(FBookmarkBar) then Exit;
  Idx := FBookmarkBar.SelectedIndexAbsolute;
  if Idx < 0 then Exit;
  if UsesProportionalZeroScanScroll then
  begin
    if (Idx < 0) or (Idx > High(FBookmarkBytes)) then Exit;
    if Idx < High(FBookmarkBytes) then
      Move(FBookmarkBytes[Idx + 1], FBookmarkBytes[Idx],
        (High(FBookmarkBytes) - Idx) * SizeOf(Int64));
    SetLength(FBookmarkBytes, Length(FBookmarkBytes) - 1);
  end
  else
  begin
    if not Assigned(FBookmarks) or (Idx >= FBookmarks.Count) then Exit;
    RealLine := Integer(FBookmarks[Idx]);
    ToggleBookmark(RealLine);
    RefreshBookmarkBarList;
    if BookmarkCount = 0 then
      HideBookmarkBarChrome;
    Exit;
  end;
  ListView1.Invalidate;
  RefreshBookmarkBarList;
  if BookmarkCount = 0 then
    HideBookmarkBarChrome;
end;

procedure TfrmMain.BookmarkBarClear(Sender: TObject);
begin
  if BookmarkCount <= 0 then Exit;
  if FastFileMessageBox(PChar(TrText('BookmarkBar.ClearConfirm')),
    APPLICATION_NAME, MB_ICONQUESTION or MB_YESNO) <> IDYES then
    Exit;
  ClearAllBookmarks;
end;

procedure TfrmMain.BookmarkBarExport(Sender: TObject);
var
  SL: TStringList;
  I, RealLine: Integer;
  LineTxt, OutFile: string;
begin
  if BookmarkCount <= 0 then Exit;
  SL := TStringList.Create;
  try
    if UsesProportionalZeroScanScroll then
    begin
      for I := 0 to High(FBookmarkBytes) do
        SL.Add(Format(TrText('BookmarkBar.ByteFmt'), [FBookmarkBytes[I]]));
    end
    else if Assigned(FBookmarks) then
    begin
      for I := 0 to FBookmarks.Count - 1 do
      begin
        RealLine := Integer(FBookmarks[I]);
        LineTxt := GetLineContent(RealLine);
        SL.Add(Format('%d'#9'%s', [RealLine + 1, LineTxt]));
      end;
    end;
    if SL.Count = 0 then Exit;
    if not SaveDialog1.Execute then Exit;
    OutFile := SaveDialog1.FileName;
    SL.SaveToFile(OutFile);
    UpdateStatusBar(Format(TrText('BookmarkBar.Exported'), [SL.Count]), iaRight);
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.BookmarkBarCopy(Sender: TObject);
var
  SL: TStringList;
  I, RealLine: Integer;
  LineTxt: string;
  ClipWide: WideString;
begin
  if BookmarkCount <= 0 then Exit;
  SL := TStringList.Create;
  try
    if UsesProportionalZeroScanScroll then
    begin
      for I := 0 to High(FBookmarkBytes) do
        SL.Add(Format(TrText('BookmarkBar.ByteFmt'), [FBookmarkBytes[I]]));
    end
    else if Assigned(FBookmarks) then
    begin
      for I := 0 to FBookmarks.Count - 1 do
      begin
        RealLine := Integer(FBookmarks[I]);
        LineTxt := GetLineContent(RealLine);
        SL.Add(LineTxt);
      end;
    end;
    if SL.Count = 0 then Exit;
    ClipWide := '';
    for I := 0 to SL.Count - 1 do
    begin
      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(SL[I]);
    end;
    ClipboardSetUnicodeText(ClipWide);
    UpdateStatusBar(Format(TrText('BookmarkBar.Copied'), [SL.Count]), iaRight);
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.BookmarkBarHide(Sender: TObject);
begin
  HideBookmarkBarChrome;
end;

procedure TfrmMain.BookmarkBarPeekRestore(Sender: TObject);
begin
  ShowBookmarkBar;
end;

procedure TfrmMain.BookmarkBarListPagePrev(Sender: TObject);
begin
  if FBookmarkListPage <= 0 then Exit;
  Dec(FBookmarkListPage);
  FillBookmarkListPage;
end;

procedure TfrmMain.BookmarkBarListPageNext(Sender: TObject);
var
  PageSize, PageCount: Integer;
begin
  PageSize := BOOKMARK_LIST_PAGE_SIZE;
  if PageSize < 1 then PageSize := 40;
  PageCount := (BookmarkCount + PageSize - 1) div PageSize;
  if FBookmarkListPage >= PageCount - 1 then Exit;
  Inc(FBookmarkListPage);
  FillBookmarkListPage;
end;

procedure TfrmMain.miShowBookmarkBarClick(Sender: TObject);
begin
  EnsureReadTabVisible;
  if Assigned(FBookmarkBar) and FBookmarkBar.Visible and (not FBookmarkChromeHidden) then
    HideBookmarkBarChrome
  else
    ShowBookmarkBar;
end;



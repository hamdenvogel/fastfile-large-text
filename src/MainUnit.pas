function TfrmMain.IsMouseOnReadFileTabRect(const ScreenPos: TPoint): Boolean;
var
  R: TRect;
begin
  Result := False;
  if not IsReadFileTabActive then Exit;
  R := Rect(0, 0, tabReadFile.ClientWidth, tabReadFile.ClientHeight);
  R.TopLeft := tabReadFile.ClientToScreen(Point(0, 0));
  R.BottomRight := tabReadFile.ClientToScreen(Point(tabReadFile.ClientWidth, tabReadFile.ClientHeight));
  Result := PtInRect(R, ScreenPos);
end;

function TfrmMain.StatusBarPanelRectByWidths(const Index: Integer): TRect;
var
  I, L: Integer;
begin
  Result := Rect(0, 0, 0, 0);
  if (Index < 0) or (not Assigned(sStatusBar1)) or (Index >= sStatusBar1.Panels.Count) then
    Exit;
  L := 0;
  for I := 0 to Index - 1 do
    Inc(L, sStatusBar1.Panels[I].Width);
  Result := Rect(L, 0, L + sStatusBar1.Panels[Index].Width, sStatusBar1.ClientHeight);
end;

function TfrmMain.HitTestStatusModeSegment(X, Y: Integer): Integer;
var
  R: TRect;
  Full, Part: string;
  Parts: TStringList;
  i, LeftX, W, GapW, P: Integer;
  Pnt: TPoint;
begin
  { 0=Mode 1=Wrap 2=Tail 3=Filter 4=Marks 5=View; -1 = miss. }
  Result := -1;
  if not Assigned(sStatusBar1) or (sStatusBar1.Panels.Count <= 4) then Exit;
  if not sStatusBar1.HandleAllocated then Exit;

  sStatusBar1.Perform(SB_GETRECT, 4, Integer(@R));
  if (R.Right <= R.Left) then
    R := StatusBarPanelRectByWidths(4);
  Pnt := Point(X, Y);
  if not PtInRect(R, Pnt) then Exit;

  Full := Trim(sStatusBar1.Panels[4].Text);
  if Full = '' then
    Full := BuildStatusModeText;
  if Full = '' then Exit;

  Parts := TStringList.Create;
  try
    { BuildStatusModeText joins fields with two spaces. }
    while Full <> '' do
    begin
      P := Pos('  ', Full);
      if P = 0 then
      begin
        Parts.Add(Trim(Full));
        Break;
      end;
      Part := Trim(Copy(Full, 1, P - 1));
      if Part <> '' then
        Parts.Add(Part);
      Full := Trim(Copy(Full, P + 2, MaxInt));
    end;
    if Parts.Count = 0 then Exit;

    sStatusBar1.Canvas.Font.Assign(sStatusBar1.Font);
    GapW := sStatusBar1.Canvas.TextWidth('  ');
    LeftX := R.Left + 4;
    for i := 0 to Parts.Count - 1 do
    begin
      W := sStatusBar1.Canvas.TextWidth(Parts[i]);
      if (X >= LeftX) and (X < LeftX + W + Max(GapW div 2, 4)) then
      begin
        Result := i;
        Exit;
      end;
      Inc(LeftX, W + GapW);
    end;
  finally
    Parts.Free;
  end;
end;

procedure TfrmMain.ToggleStatusModeSegment(ASeg: Integer);
begin
  case ASeg of
    0: miToggleCsvModeClick(Self);       { Mode TEXT/CSV }
    1: miToggleWordWrapClick(Self);      { Wrap }
    2: miToggleTailClick(Self);          { Tail }
    3:                                   { Filter }
      begin
        if FFilterActive then
        begin
          if FFilterBarChromeHidden or (not Assigned(FFilterBar)) or (not FFilterBar.Visible) then
            ShowFilterBar(True)
          else
          begin
            ClearFilter;
            HideFilterBarChrome;
            UpdateStatusBar(TrText('Filter cleared.'), iaRight);
          end;
        end
        else
          DoFilterDialog;
      end;
    4: miToggleShowMarksClick(Self);     { Marks }
    5: miSelectClick(Self);              { View LIST/CHECK }
  end;
  UpdateInfoPanels;
end;


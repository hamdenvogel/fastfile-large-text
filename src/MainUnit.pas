  numberFile:= 1;
  totalFiles := totalMergeFiles(ffilename);

  directory := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName) +
                         ExtractName(ffilename) + TEMP);

  if not DirectoryExists(directory) then

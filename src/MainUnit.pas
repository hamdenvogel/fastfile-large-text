procedure TfrmMain.AssistantCbExportFilteredToClipboard;
var
  I, RealIdx, j: Integer;
  LineS: string;
  ClipWide: WideString;
begin
  if not FFilterActive then Exit;
  if FFilteredCount <= 0 then
  begin
    ShowAppMessage(TrText('Filter has no results to export.'));
    Exit;
  end;
  ClipWide := '';
  for I := 0 to Integer(FFilteredCount) - 1 do
  begin
    RealIdx := Integer(FilteredIndexToReal(I));
    if RealIdx < 0 then Continue;
    LineS := GetLineContent(RealIdx);
    j := 1;
    while j <= Length(LineS) do
      if LineS[j] = #0 then
        Delete(LineS, j, 1)
      else
        Inc(j);
    if ClipWide <> '' then
      ClipWide := ClipWide + WideString(#13#10);
    ClipWide := ClipWide + WideString(LineS);
  end;
  if ClipWide <> '' then
    ClipboardSetUnicodeText(ClipWide);
  ShowAppMessage(Format(TrText('%d filtered line(s) copied to the clipboard.'), [FFilteredCount]));
  UpdateStatusBar(TrText('Assistant.Status.ExportMatching'), iaRight);
end;


// ===========================================================================
procedure TfrmMain.CopyFindMatchSelectionToClipboard;
var
  LineS, MatchS: string;
  Rel0, MatchLen, Skip, MatchStart, j: Integer;
begin
  if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
  if ListviewIsEmpty then Exit;
  LineS := getLineContentsFromLineIndex(FLastFoundLine);
  j := 1;
  while j <= Length(LineS) do
    if LineS[j] = #0 then
      Delete(LineS, j, 1)
    else
      Inc(j);
  if LineS = '' then Exit;
  Rel0 := FLastFoundCol;
  MatchLen := FLastFoundMatchLen;
  if Rel0 < 0 then Exit;
  if Rel0 >= Length(LineS) then Exit;
  if Rel0 + MatchLen > Length(LineS) then
    MatchLen := Length(LineS) - Rel0;
  Skip := ListViewHorizTextSkipChars;
  MatchStart := Rel0 - Skip;
  if MatchStart < 0 then MatchStart := 0;
  if MatchStart + MatchLen > Length(LineS) then
    MatchLen := Length(LineS) - MatchStart;
  if MatchLen <= 0 then Exit;
  MatchS := Copy(LineS, MatchStart + 1, MatchLen);
  if MatchS = '' then Exit;
  ClipboardSetUnicodeText(WideString(MatchS));
  ShowAppMessage(Format(
    'A ocorrencia na linha %d foi copiada para a '#$E1'rea de transfer'#$EA'ncia.',
    [FLastFoundLine + 1]));
end;

procedure TfrmMain.CopyVerticalSelectionToClipboard;
var
  R: TRect;
  StartRowIdx, EndRowIdx: Integer;
  Col0Width, ScrollOffset: Integer;
  OriginX: Integer;
  SelLeft, SelRight: Integer;
  i, Tmp, TmpIdx, j: Integer;
  LineS, BlockS: string;
  ClipWide: WideString;
  Bmp: TBitmap;
  FirstIdx, LastIdx: Integer;
  HitX: Integer;
  dCharWidth: Double;
  PixelTextStart, PixelTextEnd: Integer;
  CopyLen, StartCharIdx, EndCharIdx: Integer;
  FirstLineNo, LastLineNo: Integer;

  function PrefixW(const Line: string; N: Integer): Integer;
  begin
    if N <= 0 then
      Result := 0
    else
      Result := Bmp.Canvas.TextWidth(Copy(Line, 1, N));
  end;

  { Inclusivo [SelL,SelR]: menor i com borda direita do prefixo >= SelL. }
  function FirstCharFromPixel(const Line: string; const SelL: Integer): Integer;
  var
    Lo, Hi, Mid, Lc: Integer;
  begin
    Lc := Length(Line);
    if Lc = 0 then
    begin
      Result := 1;
      Exit;
    end;
    if OriginX + PrefixW(Line, Lc) < SelL then
    begin
      Result := Lc + 1;
      Exit;
    end;
    Lo := 1;
    Hi := Lc;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi) div 2;
      if OriginX + PrefixW(Line, Mid) < SelL then
        Lo := Mid + 1
      else
        Hi := Mid;
    end;
    Result := Lo;
  end;

  { Maior i com borda esquerda do caractere i <= SelR (intervalo inclusivo na direita). }
  function LastCharToPixel(const Line: string; const SelR: Integer): Integer;
  var
    Lo, Hi, Mid, Lc: Integer;
  begin
    Lc := Length(Line);
    Result := 0;
    if Lc = 0 then
      Exit;
    if OriginX > SelR then
      Exit;
    Lo := 1;
    Hi := Lc;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi + 1) div 2;
      if OriginX + PrefixW(Line, Mid - 1) <= SelR then
        Lo := Mid
      else
        Hi := Mid - 1;
    end;
    Result := Lo;
  end;

begin
  if not FHasSelection then Exit;
  if ListviewIsEmpty then Exit;

  R.Left := Min(FBlockStartPoint.X, FBlockEndPoint.X);
  R.Right := Max(FBlockStartPoint.X, FBlockEndPoint.X);
  R.Top := Min(FBlockStartPoint.Y, FBlockEndPoint.Y);
  R.Bottom := Max(FBlockStartPoint.Y, FBlockEndPoint.Y);

  if R.Right <= R.Left then
    Inc(R.Right);

  HitX := 8;
  if ListView1.Columns.Count > 0 then
    HitX := ListView1.Columns[0].Width + 8;

  StartRowIdx := GetRowIndexAt(HitX, R.Top);
  EndRowIdx := GetRowIndexAt(HitX, R.Bottom - 1);

  if (StartRowIdx = -1) or (EndRowIdx = -1) then
  begin
    if ListView1.TopItem <> nil then
    begin
      if StartRowIdx = -1 then
        StartRowIdx := ListView1.TopItem.Index;
      if EndRowIdx = -1 then
        EndRowIdx := ListView1.Items.Count - 1;
    end;
  end;

  if StartRowIdx > EndRowIdx then
  begin
    Tmp := StartRowIdx;
    StartRowIdx := EndRowIdx;
    EndRowIdx := Tmp;
  end;

  if StartRowIdx < 0 then
    StartRowIdx := 0;
  if EndRowIdx >= ListView1.Items.Count then
    EndRowIdx := ListView1.Items.Count - 1;

  Col0Width := ListView1.Columns[0].Width;
  ScrollOffset := GetScrollPos(ListView1.Handle, SB_HORZ);
  OriginX := Col0Width + COL1_LEFT_INSET - ScrollOffset;

  SelLeft := R.Left;
  SelRight := R.Right;

  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(ListView1.Font);
    dCharWidth := Bmp.Canvas.TextWidth(StringOfChar('W', 100)) / 100.0;
    if dCharWidth < 1.0 then
      dCharWidth := 8.0;

    ClipWide := '';
    for i := StartRowIdx to EndRowIdx do
    begin
      TmpIdx := FileLineIndexFromListRow(i);
      if TmpIdx < 0 then
        LineS := ''
      else
      begin
        LineS := GetLineContent(TmpIdx);
        j := 1;
        while j <= Length(LineS) do
          if LineS[j] = #0 then
            Delete(LineS, j, 1)
          else
            Inc(j);
      end;

      if Length(LineS) > LONG_LINE_THRESH then
      begin
        PixelTextStart := (SelLeft + ScrollOffset) - Col0Width - COL1_LEFT_INSET;
        PixelTextEnd := (SelRight + ScrollOffset) - Col0Width - COL1_LEFT_INSET;
        if PixelTextStart < 0 then
          PixelTextStart := 0;
        if PixelTextEnd < 0 then
          PixelTextEnd := 0;
        StartCharIdx := Round(PixelTextStart / dCharWidth) + 1;
        EndCharIdx := Round(PixelTextEnd / dCharWidth) + 1;
        if StartCharIdx < 1 then
          StartCharIdx := 1;
        CopyLen := EndCharIdx - StartCharIdx;
        if CopyLen <= 0 then
          CopyLen := 1;
        if StartCharIdx > Length(LineS) then
          BlockS := StringOfChar(' ', CopyLen)
        else
        begin
          BlockS := Copy(LineS, StartCharIdx, CopyLen);
          if Length(BlockS) < CopyLen then
            BlockS := BlockS + StringOfChar(' ', CopyLen - Length(BlockS));
        end;
      end
      else
      begin
        FirstIdx := FirstCharFromPixel(LineS, SelLeft);
        LastIdx := LastCharToPixel(LineS, SelRight);
        if (FirstIdx > LastIdx) or (FirstIdx > Length(LineS)) or (LastIdx < 1) then
          BlockS := ''
        else
        begin
          if FirstIdx < 1 then
            FirstIdx := 1;
          if LastIdx > Length(LineS) then
            LastIdx := Length(LineS);
          BlockS := Copy(LineS, FirstIdx, LastIdx - FirstIdx + 1);
        end;
      end;

      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(BlockS);
    end;

    if ClipWide <> '' then
    begin
      ClipboardSetUnicodeText(ClipWide);
      FirstLineNo := FileLineIndexFromListRow(StartRowIdx) + 1;
      LastLineNo := FileLineIndexFromListRow(EndRowIdx) + 1;
      { Mesmo padrao de CopyListViewFocusedLineToClipboard / CopyMultiSelectionToClipboard (CP1252). }
      if StartRowIdx = EndRowIdx then
        ShowAppMessage(Format(
          'A selecao vertical (linha %d) foi copiada para a '#$E1'rea de transfer'#$EA'ncia.',
          [FirstLineNo]))
      else
        ShowAppMessage(Format(
          'Selecao vertical: linhas %d-%d copiadas para a '#$E1'rea de transfer'#$EA'ncia.',
          [FirstLineNo, LastLineNo]));
    end;
  finally
    Bmp.Free;
  end;
end;

procedure TfrmMain.GetFindMatchHighlightColors(const LineIdx: Integer;
  out BaseBk, HlBk, NormalFg: TColor);
begin
  if (LineIdx >= 0) and IsBookmarked(LineIdx) then
  begin
    BaseBk := FF_BOOKMARK_ROW_BG;
    NormalFg := FF_BOOKMARK_ROW_FG;
    if FFindMatchSelection then
      HlBk := BlendColors(FF_BOOKMARK_ROW_BG, clInfoBk, 88)
    else
      HlBk := BlendColors(FF_BOOKMARK_ROW_BG, clInfoBk, 72);
  end
  else
  begin
    BaseBk := clWindow;
    NormalFg := clWindowText;
    HlBk := clInfoBk;
  end;
end;

procedure TfrmMain.DrawFindMatchSelectionFrame(ACanvas: TCanvas; const R: TRect);
var
  OuterR, InnerR: TRect;
  SavedPenW: Integer;
begin
  OuterR := R;
  InflateRect(OuterR, 1, 1);
  ACanvas.Brush.Style := bsClear;
  ACanvas.Pen.Style := psSolid;
  ACanvas.Pen.Mode := pmCopy;
  SavedPenW := ACanvas.Pen.Width;
  ACanvas.Pen.Color := FIND_SEL_FRAME_OUTER;
  ACanvas.Pen.Width := 2;
  ACanvas.Rectangle(OuterR);
  InnerR := OuterR;
  InflateRect(InnerR, -2, -2);
  if InnerR.Right > InnerR.Left then
  begin
    ACanvas.Pen.Width := 1;
    ACanvas.Pen.Color := clHighlight;
    ACanvas.Rectangle(InnerR);
  end;
  if SavedPenW <> 1 then
    ACanvas.Pen.Width := SavedPenW;
end;

procedure TfrmMain.DrawSelectionRect;
var
  L, T, W, H: Integer;
  R: TRect;
begin
  L := Min(FBlockStartPoint.X, FBlockEndPoint.X);
  T := Min(FBlockStartPoint.Y, FBlockEndPoint.Y);
  W := Abs(FBlockEndPoint.X - FBlockStartPoint.X);
  H := Abs(FBlockEndPoint.Y - FBlockStartPoint.Y);
  
  R := Rect(L, T, L + W, T + H);

  if FFindMatchSelection then
    DrawFindMatchSelectionFrame(ListView1.Canvas, R)
  else
  begin
    ListView1.Canvas.Brush.Style := bsClear;
    ListView1.Canvas.Pen.Color   := clHighlight;
    ListView1.Canvas.Pen.Style   := psSolid;
    ListView1.Canvas.Pen.Width   := 1;
    ListView1.Canvas.Pen.Mode    := pmCopy;
    ListView1.Canvas.Rectangle(R);
  end;
end;

// Helper: Usa API do Windows para descobrir o indice exato sob o mouse
// Isso corrige o erro de deslocamento causado por cabecalhos e scroll
function TfrmMain.GetRowIndexAt(X, Y: Integer): Integer;
var
  HitInfo: TLVHitTestInfo;
  CX: Integer;
begin
  Result := -1;
  if not Assigned(ListView1) or (not ListView1.HandleAllocated) then Exit;
  CX := X;
  if CX < 0 then CX := 0;
  if CX >= ListView1.ClientWidth then CX := Max(0, ListView1.ClientWidth - 1);
  if Y < 0 then Y := 0;
  if Y >= ListView1.ClientHeight then Y := Max(0, ListView1.ClientHeight - 1);
  HitInfo.pt := Point(CX, Y);
  HitInfo.flags := 0;
  Result := SendMessage(ListView1.Handle, LVM_HITTEST, 0, Longint(@HitInfo));
  if Result < 0 then Exit;
end;

procedure TfrmMain.QueueListViewWheelZoom(const WheelDelta: Integer);
begin
  if not Assigned(ListView1) then Exit;
  if WheelDelta = 0 then Exit;
  Inc(FQueuedWheelZoomDelta, WheelDelta);
  if FQueuedWheelZoomPosted then Exit;
  FQueuedWheelZoomPosted := True;
  PostMessage(Handle, WM_USER + 207, 0, 0);
end;

procedure TfrmMain.WMListViewWheelZoom(var Msg: TMessage);
var
  Delta, Step, Pct, EffectivePct: Integer;
begin
  FQueuedWheelZoomPosted := False;
  Delta := FQueuedWheelZoomDelta;
  FQueuedWheelZoomDelta := 0;
  if (Delta = 0) or (not Assigned(ListView1)) then Exit;
  if FListViewZoomBaseFontSize <= 0 then
    FListViewZoomBaseFontSize := Max(1, ListView1.Font.Size);
  if FListViewZoomPct <= 0 then
    FListViewZoomPct := 100;
  Step := Delta div WHEEL_ONE_NOTCH;
  if Step = 0 then
    Step := Sign(Delta);
  Pct := FListViewZoomPct - (Step * 5);
  ApplyListViewZoomPercent(Pct);
  EffectivePct := FListViewZoomPct;
  RememberWheelZoomInCombo(EffectivePct, True);
  SaveListViewZoomToIni;
end;

procedure TfrmMain.ApplyListViewWheelZoom(const WheelDelta: Integer);
begin
  QueueListViewWheelZoom(WheelDelta);
end;

procedure TfrmMain.HookedListViewWndProc(var Message: TMessage);
var
  WheelDelta: Integer;
  Keys: Word;
  CtrlDown: Boolean;
  pnm: PNMHdr;
begin
  { Do not let VCL/comctl fill native INFOTIP text (LABELTIP is cleared via styles). }
  if (Message.Msg = CN_NOTIFY) and (Message.LParam <> 0) then
  begin
    pnm := PNMHdr(Message.LParam);
    if (pnm^.code = LVN_GETINFOTIPA) or (pnm^.code = LVN_GETINFOTIPW) then
    begin
      Message.Result := 0;
      Exit;
    end;
  end;

  if Message.Msg = WM_MOUSEWHEEL then
  begin
    Keys := LoWord(Message.WParam);
    WheelDelta := SmallInt(HiWord(Message.WParam));
    CtrlDown := ((Keys and MK_CONTROL) <> 0) or (GetKeyState(VK_CONTROL) < 0);
    if CtrlDown and (WheelDelta <> 0) then
    begin
      ApplyListViewWheelZoom(WheelDelta);
      Message.Result := 1;
      Exit;
    end;
    if Assigned(ListView1) and (ListView1.Items.Count > 0) then
    begin
      ApplyMainFileListWheel(WheelDelta);
      Message.Result := 1;
      Exit;
    end;
  end;

  if Assigned(FOldListViewWndProc) then
    FOldListViewWndProc(Message);

  if (Message.Msg = CM_RECREATEWND) or (Message.Msg = WM_CREATE) then
    ApplyListViewNativeTipsDisabled
  else if Message.Msg = WM_PAINT then
  begin
    ApplyListViewNativeTipsDisabled;
    if FFindMatchSelection and (FLastFoundMatchLen > 0) then
    begin
      if UpdateFindMatchSelectionRects then
        DrawSelectionRect;
    end
    else if FHasSelection then
      DrawSelectionRect
    else if FLineAutofillDragging and (not FLineAutofillOnCheckList) then
      DrawLineAutofillPreview;
  end;
end;

//vertical selection
procedure TfrmMain.ListView1MouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
var
  RowH, Delta: Integer;
begin
  if FLineAutofillDeferCtrl then
  begin
    if (Abs(Y - FLineAutofillDeferY) >= 5) or (Abs(X - FLineAutofillDeferX) >= 5) then
    begin
      FLineAutofillDeferCtrl := False;
      StartLineAutofillDrag(FLineAutofillDeferRow, FLineAutofillDeferY);
    end
    else
      Exit;
  end;
  if FLineAutofillDragging then
  begin
    ClearFileLineHoverHint;
    RowH := ListViewVisualRowHeight;
    if RowH < 1 then RowH := 18;
    Delta := (Y - FLineAutofillStartY) div RowH;
    if Delta < 0 then Delta := 0;
    if Delta > MAX_LINE_AUTOFILL then Delta := MAX_LINE_AUTOFILL;
    if FLineAutofillInsertCount <> Delta then
    begin
      FLineAutofillInsertCount := Delta;
      ListView1.Invalidate;
    end;
    Exit;
  end;
  if FIsDragging then
  begin
    FBlockEndPoint := Point(X, Y);
    ListView1.Repaint;
    ClearFileLineHoverHint;
    Exit;
  end;
  UpdateFileLineHoverHint(ListView1, GetRowIndexAt(X, Y), False, X, Y);
end;

//vertical selection
procedure TfrmMain.ListView1MouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  if FLineAutofillDeferCtrl then
  begin
    FLineAutofillDeferCtrl := False;
    Exit;
  end;
  if FLineAutofillDragging then
  begin
    FLineAutofillDragging := False;
    if GetCapture = ListView1.Handle then ReleaseCapture;
    if (FLineAutofillInsertCount > 0) and CanStartLineAutofill and ConfirmLineAutofill then
      CommitLineAutofill;
    FLineAutofillInsertCount := 0;
    FLineAutofillOnCheckList := False;
    ListView1.Invalidate;
    UpdateInfoPanels;
    Exit;
  end;
  if FIsDragging then
  begin
    FIsDragging := False;
    ReleaseCapture; 
    FBlockEndPoint := Point(X, Y);
    ListView1.Repaint;
  end;
  UpdateInfoPanels;
  UpdateListViewLineToolsEnabled;
end;

//vertical selection
procedure TfrmMain.ListView1KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_DELETE then
  begin
    ActionDelete.Execute;
    Key := 0;
    Exit;
  end;

  { Todos os atalhos nomeados (Ctrl+X, F-keys etc.) ja sao roteados por
    FormKeyDown via KeyPreview=True. Aqui so atualizamos os paineis para
    teclas de navegacao (setas etc.) nao consumidas pelo Form. }
  if Key = 0 then Exit;
  UpdateInfoPanels;
  UpdateListViewLineToolsEnabled;
end;

//vertical selection
procedure TfrmMain.ListView1MouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  HitRow: Integer;
begin
  FLineAutofillDeferCtrl := False;
  { 1) Autofill na coluna Line #: arrastar para baixo insere linhas em branco
     (sem modificador, Shift+arrastar ou Ctrl+arrastar). Ctrl+clique mantem selecao multipla. }
  if (Button = mbLeft) and (not (ssAlt in Shift)) and IsClickInFirstColumn(X)
     and CanStartLineAutofill then
  begin
    HitRow := GetRowIndexAt(X, Y);
    if HitRow >= 0 then
    begin
      if ssCtrl in Shift then
      begin
        FLineAutofillDeferCtrl := True;
        FLineAutofillDeferRow := HitRow;
        FLineAutofillDeferX := X;
        FLineAutofillDeferY := Y;
        Exit;
      end;
      StartLineAutofillDrag(HitRow, Y);
      Exit;
    end;
  end;
  { 2) Selecao vertical: Ctrl/Alt + arrastar fora da coluna Line # com Ctrl. }
  if (Button = mbLeft) and ((ssCtrl in Shift) or (ssAlt in Shift)) then
  begin
    if (ssCtrl in Shift) and IsClickInFirstColumn(X) then
      Exit;
    FFindMatchSelection := False;
    FHasSelection := True;
    FIsDragging := True;
    
    SetCapture(ListView1.Handle); 
    if ListView1.CanFocus then ListView1.SetFocus;
    
    FBlockStartPoint := Point(X, Y);
    FBlockEndPoint := Point(X, Y);
    // Para nao misturar com selecao multipla do ListView
    ListView1.Selected := nil; 
    ListView1.Repaint; 
  end
  else
  begin
    CancelLineAutofillDrag;
    if FHasSelection then
    begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
      if GetCapture = ListView1.Handle then ReleaseCapture;
      ListView1.Repaint;
    end;
  end;
end;

procedure TfrmMain.ListView1Click(Sender: TObject);
begin
  if Assigned(ListView1) and (not ListView1.RowSelect) then
    ListView1.RowSelect := True;
  UpdateListViewLineToolsEnabled;
end;

function ModifierKeyState(Shift: TShiftState): TModifierKeyState;
const
  AllModifierKeys = [low(TModifierKey)..high(TModifierKey)];
begin
  Result := AllModifierKeys*Shift;
end;

function GenericMouseWheelCheckListBox(Handle: HWND; Shift: TShiftState; WheelDirection: TMouseWheelDirection): Boolean;
var
  i, ScrollCount, Direction: Integer;
  Paging: Boolean;
  idx: Integer;
begin
  // Ctrl + roda no modo checklist deve aplicar o mesmo zoom da ListView.
  if GetKeyState(VK_CONTROL) < 0 then
  begin
    if WheelDirection = mwdUp then
      frmMain.ApplyListViewWheelZoom(120)
    else
      frmMain.ApplyListViewWheelZoom(-120);
    Result := True;
    Exit;
  end;

  // Alt pressionado (ou durante arrasto): nao propagar wheel.
  if (GetKeyState(VK_MENU) < 0)
     or (GetKeyState(VK_LBUTTON) < 0) or (GetCapture <> 0) then
  begin
    Result := True; // marca como tratado para nao propagar
    Exit;
  end;

  if not Assigned(FCheckListBox) then Exit;
  idx := FCheckListBox.ItemIndex;
  Result := ModifierKeyState(Shift)=[];//only respond to un-modified wheel actions
  if Result then begin
    Paging := DWORD(Mouse.WheelScrollLines) = WHEEL_PAGESCROLL;
    ScrollCount := Mouse.WheelScrollLines;
    case WheelDirection of
    mwdUp:
      if Paging then
      begin
        Direction := SB_PAGEUP;
        ScrollCount := 1;
        (* mainForm.ScrollBarVertical.Position := mainForm.ScrollBarVertical.Position - 1;
        mainForm.ScrollBarVerticalScroll(mainForm, scPageUp, fScrollPos);
        mainForm.showChecked; *)
      end
      else
      begin
        Direction := SB_LINEUP;
        //if mainForm.ScrollBarVertical.Position = 0 then Exit;
        FCheckListBox.Items.BeginUpdate;
        try
          frmMain.SafeSetScrollBarPosition(frmMain.ScrollBarVertical,
            frmMain.ScrollBarVertical.Position - 1);
          frmMain.ScrollBarVerticalScroll(frmMain, scLineUp, fScrollPos);
        finally
          FCheckListBox.Items.EndUpdate;
        end;
        //mainForm.showChecked;
      end;
    mwdDown:
      if Paging then
      begin
        Direction := SB_PAGEDOWN;
        ScrollCount := 1;
        (* mainForm.ScrollBarVertical.Position := mainForm.ScrollBarVertical.Position + 1;
        mainForm.ScrollBarVerticalScroll(mainForm, scPageDown, fScrollPos);
        mainForm.showChecked; *)
      end
      else
      begin
        Direction := SB_LINEDOWN;
        FCheckListBox.Items.BeginUpdate;
        try
          frmMain.SafeSetScrollBarPosition(frmMain.ScrollBarVertical,
            frmMain.ScrollBarVertical.Position + 1);
          frmMain.ScrollBarVerticalScroll(frmMain, scLineDown, fScrollPos);
        finally
          FCheckListBox.Items.EndUpdate;
        end;  
       // mainForm.showChecked;
      end;
    end;
    FCheckListBox.ItemIndex := idx;
    FCheckListBox.Click;
    for i := 1 to ScrollCount do
    begin
      SendMessage(frmMain.ScrollBarVertical.Handle, WM_VSCROLL, Direction, 0);
    end;
  end;
end;


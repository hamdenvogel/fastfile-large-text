  begin
    if Assigned(Parent) and (Owner is TfrmMain) then
    begin
      TfrmMain(Owner).CloseActiveTabSheet;
      Message.Result := 1;
      Exit;
    end;
    ModalResult := mrCancel;
    Message.Result := 1;
    Exit;
  end;
  inherited;
end;


  if Assigned(FToolsExtrasTail) then
    FToolsExtrasTail.Checked := False;
  if Assigned(FToolsExtrasTailPause) then
  begin
    FToolsExtrasTailPause.Enabled := False;
    FToolsExtrasTailPause.Checked := False;
  end;
  if Assigned(FMenuTailPauseItem) then
  begin
    FMenuTailPauseItem.Enabled := False;
    FMenuTailPauseItem.Checked := False;

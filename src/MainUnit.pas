function TfrmMain.TryExtractExportedFilePath(const AText: string): string;
const
  Markers: array[0..10] of string = (
    'Answer exported to:',
    'Data exported successfully to:',
    'exported successfully to:',
    'Export result saved to:',
    'Result saved to:',
    'Transcript exported to:',
    'exported to:',
    'saved to:',
    'salvo em:',
    'gravado em:',
    'Arquivo gravado:');
var
  S, U, MarkerU, Rest: string;
  I, P, Cut: Integer;
begin
  Result := '';
  S := Trim(AText);
  if S = '' then Exit;
  U := UpperCase(S);
  for I := Low(Markers) to High(Markers) do
  begin
    MarkerU := UpperCase(Markers[I]);
    P := Pos(MarkerU, U);
    if P <= 0 then Continue;
    Rest := Trim(Copy(S, P + Length(Markers[I]), MaxInt));
    if Rest = '' then Continue;
    if (Length(Rest) >= 2) and ((Rest[1] = '"') or (Rest[1] = '''')) then
    begin
      Cut := Pos(Rest[1], Copy(Rest, 2, MaxInt));
      if Cut > 0 then
        Rest := Copy(Rest, 2, Cut - 1)
      else
        Delete(Rest, 1, 1);
    end;
    Cut := Pos(#13, Rest);
    if Cut > 0 then
      Rest := Copy(Rest, 1, Cut - 1);
    Cut := Pos(#10, Rest);
    if Cut > 0 then
      Rest := Copy(Rest, 1, Cut - 1);
    Rest := Trim(Rest);
    if (Length(Rest) >= 4) and
       ((Pos(':\', Rest) > 0) or (Copy(Rest, 1, 2) = '\\')) and
       FileExists(Rest) then
    begin
      Result := Rest;
      Exit;
    end;
  end;
end;

procedure TfrmMain.MaybeNotifyChatExportFromText(AHostPanel: TWinControl; const AText: string);
var
  Path: string;
begin
  Path := TryExtractExportedFilePath(AText);
  if Path = '' then Exit;
  NotifyChatFileSaved(AHostPanel, Path, False);
end;


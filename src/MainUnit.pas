function IsDigitsOnly(const S: String): Boolean;
var
  i: Integer;
begin
  Result := S <> '';
  if not Result then Exit;
  for i := 1 to Length(S) do
    if not (S[i] in ['0'..'9']) then
    begin
      Result := False;
      Exit;
    end;
end;

function TryExtractOpeningXmlTag(const S: String; out ATag: String): Boolean;
var
  i: Integer;
begin
  Result := False;
  ATag := '';
  if S = '' then Exit;
  if S[1] <> '<' then Exit;
  if (Length(S) >= 2) and (S[2] in ['?', '/', '!']) then Exit;

  i := 2;
  while (i <= Length(S)) and (S[i] in ['A'..'Z', 'a'..'z', '0'..'9', '_', '-', ':']) do
  begin
    ATag := ATag + S[i];
    Inc(i);
  end;
  Result := ATag <> '';
end;

function TrySuggestSplitPatternFromFile(const ASourceFile: String;
  out ASuggestedPattern: String; out AIsRegex: Boolean; out AReason: String): Boolean;
var
  F: TextFile;
  LineText, TrimmedLine, Token, XmlTag, FoundTag: String;
  LineCount, SemiLines, CommaLines, SemiNumHits, CommaNumHits: Integer;
  Delim: Char;
  DelimLines, NumHits, P: Integer;
  TextBuf: array[0..65535] of Char;
begin
  Result := False;
  ASuggestedPattern := '';
  AIsRegex := False;
  AReason := '';

  if (ASourceFile = '') or (not FileExists(ASourceFile)) then
    Exit;

  LineCount := 0;
  SemiLines := 0;
  CommaLines := 0;
  SemiNumHits := 0;
  CommaNumHits := 0;
  XmlTag := '';

  AssignFile(F, ASourceFile);
  try
    Reset(F);
    SetTextBuf(F, TextBuf, SizeOf(TextBuf));
    while (not EOF(F)) and (LineCount < MAX_SCAN_LINES) do
    begin
      ReadLn(F, LineText);
      TrimmedLine := Trim(LineText);
      if TrimmedLine = '' then
        Continue;

      Inc(LineCount);

      if (XmlTag = '') and TryExtractOpeningXmlTag(TrimmedLine, FoundTag) then
        XmlTag := FoundTag;

      P := PosBMH(';', TrimmedLine);
      if P > 0 then
      begin
        Inc(SemiLines);
        Token := Trim(Copy(TrimmedLine, 1, P - 1));
        if IsDigitsOnly(Token) then
          Inc(SemiNumHits);
      end;

      P := PosBMH(',', TrimmedLine);
      if P > 0 then
      begin
        Inc(CommaLines);
        Token := Trim(Copy(TrimmedLine, 1, P - 1));
        if IsDigitsOnly(Token) then
          Inc(CommaNumHits);
      end;
    end;
  finally
    try
      CloseFile(F);
    except
    end;
  end;

  if XmlTag <> '' then
  begin
    ASuggestedPattern := '^\s*<' + XmlTag + '\b.*>';
    AIsRegex := True;
    AReason := Format(TrText('XML-like lines detected; using first tag <%s ...>.'), [XmlTag]);
    Result := True;
    Exit;
  end;

  if SemiLines >= CommaLines then
  begin
    Delim := ';';
    DelimLines := SemiLines;
    NumHits := SemiNumHits;
  end
  else
  begin
    Delim := ',';
    DelimLines := CommaLines;
    NumHits := CommaNumHits;
  end;

  if (DelimLines >= 5) and (NumHits * 100 >= DelimLines * 60) then
  begin
    ASuggestedPattern := '^[0-9]+' + Delim;
    AIsRegex := True;
    AReason := Format(TrText('Delimited text with numeric first column detected; using regex "%s".'), [ASuggestedPattern]);
    Result := True;
    Exit;
  end;
end;

function TryReadFirstLineFromFile(const ASourceFile: String; out AFirstLine: String): Boolean;
var
  F: TextFile;
  TextBuf: array[0..65535] of Char;
begin
  Result := False;
  AFirstLine := '';
  if (ASourceFile = '') or (not FileExists(ASourceFile)) then
    Exit;

  AssignFile(F, ASourceFile);
  try
    Reset(F);
    SetTextBuf(F, TextBuf, SizeOf(TextBuf));
    if not EOF(F) then
    begin
      ReadLn(F, AFirstLine);
      Result := True;
    end;
  finally
    try
      CloseFile(F);
    except
    end;
  end;
end;

{ Extracts the Global and IgnoreCase flags from a JS-style /pattern/flags
  literal.  If the pattern is not in /.../ form, defaults are returned.
  Global      defaults to False.
  IgnoreCase  defaults to True (matches VBScript.RegExp default). }
procedure ExtractJsRegexFlags(const AInputPattern: String;
  out AGlobal: Boolean; out AIgnoreCase: Boolean);
var
  S, Flags: String;
  i, SlashPos, BackslashCount, j: Integer;
begin
  AGlobal := False;
  AIgnoreCase := True; { VBScript default }
  S := Trim(AInputPattern);
  if (Length(S) < 2) or (S[1] <> '/') then Exit;

  SlashPos := 0;
  for i := Length(S) downto 2 do
    if S[i] = '/' then
    begin
      BackslashCount := 0;
      j := i - 1;
      while (j >= 1) and (S[j] = '\') do
      begin
        Inc(BackslashCount);
        Dec(j);
      end;
      if (BackslashCount mod 2) = 0 then
      begin
        SlashPos := i;
        Break;
      end;
    end;

  if SlashPos = 0 then Exit;

  Flags := LowerCase(Copy(S, SlashPos + 1, MaxInt));
  AGlobal := PosBMH('g', Flags) > 0;
  { Only override IgnoreCase when an explicit 'i' flag is present; without it
    we keep the safe default of True (case-insensitive search). }
  if Flags <> '' then
    AIgnoreCase := PosBMH('i', Flags) > 0
  else
    AIgnoreCase := True;
end;

function CountPatternMatchesInFile(const AFileName, APattern: String; const AIsRegex: Boolean;
  out AMatchCount, ALineCount: Int64; out AErrorMsg: String): Boolean;
var
  F: TextFile;
  LineText: String;
  IsMatch: Boolean;
  RegObj: Variant;
  ComReady: Boolean;
  EffectivePattern: String;
  TextBuf: array[0..65535] of Char;
begin
  Result := False;
  AMatchCount := 0;
  ALineCount := 0;
  AErrorMsg := '';
  ComReady := False;

  if AFileName = '' then
  begin
    AErrorMsg := TrText('Source file is required.');
    Exit;
  end;

  if APattern = '' then
  begin
    AErrorMsg := TrText('Pattern cannot be empty.');
    Exit;
  end;

  if AIsRegex then
  begin
    if not NormalizeRegexPatternForVBScript(APattern, EffectivePattern, AErrorMsg) then
      Exit;

    try
      CoInitialize(nil);
      ComReady := True;
      RegObj := CreateOleObject('VBScript.RegExp');
      RegObj.Pattern := EffectivePattern;
      RegObj.IgnoreCase := True;
      RegObj.Global := False;
    except
      on E: Exception do
      begin
        AErrorMsg := TrText('Invalid Regex:') + ' ' + E.Message;
        if ComReady then
          CoUninitialize;
        Exit;
      end;
    end;
  end;

  AssignFile(F, AFileName);
  try
    Reset(F);
    SetTextBuf(F, TextBuf, SizeOf(TextBuf));
    while not EOF(F) do
    begin
      ReadLn(F, LineText);
      Inc(ALineCount);

      if AIsRegex then
        IsMatch := RegObj.Test(LineText)
      else
        IsMatch := PosBMH(APattern, LineText) > 0;

      if IsMatch then
        Inc(AMatchCount);
    end;

    Result := True;
  except
    on E: Exception do
      AErrorMsg := E.Message;
  end;

  try
    CloseFile(F);
  except
  end;

  if AIsRegex and ComReady then
    CoUninitialize;
end;

function PreviewPatternMatchesInFile(const AFileName, APattern: String; const AIsRegex: Boolean;
  const AMaxLines: Integer; out AReport, AErrorMsg: String): Boolean;
var
  F: TextFile;
  LineText: String;
  IsMatch: Boolean;
  RegObj: Variant;
  ComReady: Boolean;
  EffectivePattern: String;
  TextBuf: array[0..65535] of Char;
  LineCount, MatchCount: Int64;
  Samples: TStringList;
  WasTruncated: Boolean;
begin
  Result := False;
  AErrorMsg := '';
  AReport := '';
  ComReady := False;
  Samples := TStringList.Create;
  WasTruncated := False;
  try
    if AFileName = '' then
    begin
      AErrorMsg := TrText('Source file is required.');
      Exit;
    end;

    if APattern = '' then
    begin
      AErrorMsg := TrText('Pattern cannot be empty.');
      Exit;
    end;

    if AIsRegex then
    begin
      if not NormalizeRegexPatternForVBScript(APattern, EffectivePattern, AErrorMsg) then
        Exit;

      try
        CoInitialize(nil);
        ComReady := True;
        RegObj := CreateOleObject('VBScript.RegExp');
        RegObj.Pattern := EffectivePattern;
        RegObj.IgnoreCase := True;
        RegObj.Global := False;
      except
        on E: Exception do
        begin
          AErrorMsg := TrText('Invalid Regex:') + ' ' + E.Message;
          Exit;
        end;
      end;
    end;

    LineCount := 0;
    MatchCount := 0;

    AssignFile(F, AFileName);
    try
      Reset(F);
      SetTextBuf(F, TextBuf, SizeOf(TextBuf));
      while not EOF(F) do
      begin
        ReadLn(F, LineText);
        Inc(LineCount);

        if AIsRegex then
          IsMatch := RegObj.Test(LineText)
        else
          IsMatch := PosBMH(APattern, LineText) > 0;

        if IsMatch then
        begin
          Inc(MatchCount);
          if Samples.Count < AMaxLines then
            Samples.Add(IntToStr(LineCount) + ': ' + Copy(LineText, 1, 220));
        end;

        if LineCount >= MAX_PREVIEW_SCAN_LINES then
        begin
          WasTruncated := True;
          Break;
        end;
      end;
    finally
      try
        CloseFile(F);
      except
      end;
    end;

    if WasTruncated then
      AReport :=
        Format(TrText('Preview summary (sampled): %d matching lines in first %d lines scanned.'), [MatchCount, LineCount]) + #13#10 +
        TrText('Note: file is very large, preview was truncated for responsiveness.') + #13#10 +
        Format(TrText('Estimated output files (approx., based on sample): %d'), [MatchCount + 1]) + #13#10#13#10
    else
      AReport :=
        Format(TrText('Preview summary: %d matching lines in %d total lines.'), [MatchCount, LineCount]) + #13#10 +
        Format(TrText('Estimated output files (approx.): %d'), [MatchCount + 1]) + #13#10#13#10;

    if MatchCount = 0 then
      AReport := AReport + TrText('No matching line found in preview.')
    else
    begin
      AReport := AReport + TrText('First matching lines:') + #13#10;
      AReport := AReport + Samples.Text;
    end;

    Result := True;
  except
    on E: Exception do
      AErrorMsg := E.Message;
  end;

  if AIsRegex and ComReady then
    CoUninitialize;
  Samples.Free;
end;


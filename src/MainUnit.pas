function TfrmMain.AssistantCbCollectMatchingLines(const ANeedle: string;
  AMaxLines: Integer; ACaseSensitive: Boolean): string;
var
  Needle, Line, LNeedle, LLine, DiskPath: string;
  MaxN, Got, WaitI: Integer;
  i, ScanCap: Int64;
  RealIdx: Int64;
  UseHits: Boolean;
  FilterBusy: Boolean;

  function LineMatchesNeedle(const ALine: string): Boolean;
  begin
    if ACaseSensitive then
      Result := Pos(Needle, ALine) > 0
    else
    begin
      LLine := LowerCase(ALine);
      Result := Pos(LNeedle, LLine) > 0;
    end;
  end;

  procedure AppendLine(const ALine: string);
  begin
    Inc(Got);
    if Result <> '' then
      Result := Result + #13#10;
    Result := Result + IntToStr(Got) + '. ' + ALine;
  end;

  procedure CollectFromHits;
  begin
    i := 0;
    while (Got < MaxN) and (i < FFilteredCount) do
    begin
      RealIdx := FilteredIndexToReal(i);
      if RealIdx >= 0 then
      begin
        Line := GetLineContent(Integer(RealIdx));
        if Line <> '' then
          AppendLine(Line);
      end;
      Inc(i);
    end;
  end;

begin
  Result := '';
  Got := 0;
  MaxN := AMaxLines;
  if MaxN < 1 then MaxN := 100;
  if MaxN > 500 then MaxN := 500;
  Needle := Trim(ANeedle);
  if Needle = '' then
    Needle := Trim(FFilterText);
  if Needle = '' then Exit;
  LNeedle := LowerCase(Needle);

  { Prefer filter hits. apply_filter is async — wait for first hits, never race
    a multi-million GetLineContent scan against the filter thread (UI freeze). }
  UseHits := FFilterActive and (FFilteredCount > 0) and
    SameText(Trim(FFilterText), Needle);
  FilterBusy := Assigned(FFilterThread) and FFilterActive and
    SameText(Trim(FFilterText), Needle);
  if (not UseHits) and FilterBusy then
  begin
    for WaitI := 1 to 200 do
    begin
      Application.ProcessMessages;
      Sleep(50);
      if FFilteredCount > 0 then
      begin
        UseHits := True;
        Break;
      end;
      if not Assigned(FFilterThread) then Break;
      if not FFilterActive then Break;
    end;
  end;

  if UseHits or (FFilterActive and (FFilteredCount > 0) and
     SameText(Trim(FFilterText), Needle)) then
  begin
    CollectFromHits;
    if Got > 0 then Exit;
  end;

  { Disk scan is independent of MMF/filter thread — used when the file is only
    selected in edtFileName (not yet Read) or the filter has not produced hits. }
  DiskPath := Trim(CurrentEffectiveFilePath);
  if DiskPath = SELECTTEXT then DiskPath := '';
  if DiskPath = '' then
    DiskPath := Trim(edtFileName.Text);
  if DiskPath = SELECTTEXT then DiskPath := '';
  if (DiskPath <> '') and FileExists(DiskPath) then
  begin
    Result := FastFileCollectMatchingLines(DiskPath, Needle, MaxN, ACaseSensitive);
    if Trim(Result) <> '' then Exit;
  end;

  { Still filtering: do not scan the open stream (contends with filter thread). }
  if Assigned(FFilterThread) and FFilterActive and
     SameText(Trim(FFilterText), Needle) then
    Exit;

  { Fallback: bounded sequential scan only when filter is idle. }
  if not Assigned(FSourceFileStream) then Exit;
  ScanCap := AssistantCbGetOpenFileLineCount;
  if ScanCap <= 0 then
    ScanCap := 200000;
  if ScanCap > 200000 then
    ScanCap := 200000;
  i := 0;
  while (Got < MaxN) and (i < ScanCap) do
  begin
    Line := GetLineContent(Integer(i));
    if LineMatchesNeedle(Line) then
      AppendLine(Line);
    Inc(i);
    if (i mod 5000) = 0 then
      Application.ProcessMessages;
  end;
end;


function TScriptEngineReaderThread.ProtocolLineNeedsImmediateDispatch(const ALine: AnsiString): Boolean;
begin
  Result := (Length(ALine) >= 9) and (Copy(string(ALine), 1, 9) = 'PROGRESS:');
  if Result then Exit;
  Result := (Length(ALine) >= 7) and (Copy(string(ALine), 1, 7) = 'STATUS:');
  if Result then Exit;
  Result := (Length(ALine) >= 10) and (Copy(string(ALine), 1, 10) = 'DONE_STATS:');
  if Result then Exit;
  Result := (Length(ALine) >= 15) and (Copy(string(ALine), 1, 15) = 'ENGINE_VERSION:');
  if Result then Exit;
  Result := (Length(ALine) >= 14) and (Copy(string(ALine), 1, 14) = 'COMPILE_ERROR:');
  if Result then Exit;
  Result := (ALine = 'COMPILED_OK');
  if Result then Exit;
  Result := (ALine = 'DONE_ACK');
end;

function TScriptEngineReaderThread.TryParseProgressPercent(const ALine: string; out APct: Integer): Boolean;
var
  Text, NumPart: string;
  ColonPos: Integer;
begin
  Result := False;
  APct := 0;
  if Copy(ALine, 1, 9) <> 'PROGRESS:' then Exit;
  Text := Copy(ALine, 10, MaxInt);
  ColonPos := PosBMH(':', Text);
  if ColonPos > 0 then
    NumPart := Copy(Text, 1, ColonPos - 1)
  else
    NumPart := Text;
  APct := StrToIntDef(Trim(NumPart), -1);
  Result := (APct >= 0) and (APct <= 100);
end;

function TScriptEngineReaderThread.ExtractProgressDetail(const ALine: string): string;
var
  Text: string;
  ColonPos: Integer;
begin
  Result := '';
  if Copy(ALine, 1, 9) <> 'PROGRESS:' then Exit;
  Text := Copy(ALine, 10, MaxInt);
  ColonPos := PosBMH(':', Text);
  if ColonPos > 0 then
    Result := Copy(Text, ColonPos + 1, MaxInt);
end;

procedure TScriptEngineReaderThread.Execute;
var
  Buffer: AnsiString;
  ReadBuf: array[0..16383] of AnsiChar;
  LineBuf: AnsiString;
  BytesRead: DWORD;
  BytesAvail: DWORD;
  LFPos: Integer;
  BatchCount: Integer;
  ProgressPct: Integer;
  NowTick: Cardinal;
  function DecodeUtf8PipeText(const S: AnsiString): string;
  var
    WLen: Integer;
    W: WideString;
  begin
    Result := string(S);
    if S = '' then Exit;
    WLen := MultiByteToWideChar(CP_UTF8, 0, PAnsiChar(S), Length(S), nil, 0);
    if WLen <= 0 then Exit;
    SetLength(W, WLen);
    if MultiByteToWideChar(CP_UTF8, 0, PAnsiChar(S), Length(S), PWideChar(W), WLen) <= 0 then Exit;
    Result := string(W);
  end;
  procedure FlushBatch;
  begin
    if FPendingBatchText = '' then Exit;
    Synchronize(DispatchBatch);
    FPendingBatchText := '';
    BatchCount := 0;
  end;
begin
  Buffer := '';
  FPendingBatchText := '';
  BatchCount := 0;
  FLastProgressUiTick := 0;
  while not Terminated do
  begin
    if (FReadHandle = 0) or (FReadHandle = INVALID_HANDLE_VALUE) then
      Break;
    BytesAvail := 0;
    if not PeekNamedPipe(FReadHandle, nil, 0, nil, @BytesAvail, nil) then
      Break;
    if BytesAvail = 0 then
    begin
      if (FPendingBatchText <> '') and (Buffer = '') then
        FlushBatch;
      if TfrmSmoothLoading.CancelRequested then
      begin
        Synchronize(SyncAbortOnCancel);
        Break;
      end;
      Sleep(25);
      Continue;
    end;

    if BytesAvail > SizeOf(ReadBuf) then
      BytesAvail := SizeOf(ReadBuf);
    if (not Windows.ReadFile(FReadHandle, ReadBuf, BytesAvail, BytesRead, nil)) or (BytesRead = 0) then
      Break;

    SetString(LineBuf, PAnsiChar(@ReadBuf[0]), BytesRead);
    Buffer := Buffer + LineBuf;

    while True do
    begin
      LFPos := PosBMH(#10, string(Buffer));
      if LFPos <= 0 then Break;

      LineBuf := Copy(Buffer, 1, LFPos - 1);
      Delete(Buffer, 1, LFPos);
      while (Length(LineBuf) > 0) and (LineBuf[Length(LineBuf)] = #13) do
        SetLength(LineBuf, Length(LineBuf) - 1);

      if ProtocolLineNeedsImmediateDispatch(LineBuf) then
      begin
        if FPendingBatchText <> '' then
          FlushBatch;
        FSyncLine := DecodeUtf8PipeText(LineBuf);
        if FSyncLine = 'COMPILED_OK' then
        begin
          if Assigned(FOwner) then
            FOwner.SignalScriptEngineCompileDone(True, '');
          Synchronize(SyncDispatchOneLine);
        end
        else if Copy(FSyncLine, 1, 14) = 'COMPILE_ERROR:' then
        begin
          if Assigned(FOwner) then
            FOwner.SignalScriptEngineCompileDone(False, Copy(FSyncLine, 15, MaxInt));
          Synchronize(SyncDispatchOneLine);
        end
        else if Copy(FSyncLine, 1, 15) = 'ENGINE_VERSION:' then
        begin
          if Assigned(FOwner) then
            FOwner.FScriptEngineVersion :=
              StrToIntDef(Trim(Copy(FSyncLine, 16, MaxInt)), 0);
        end
        else if TryParseProgressPercent(FSyncLine, ProgressPct) then
        begin
          { PostMessage evita SendMessage na worker + atualiza barra e detalhe juntos. }
          TfrmSmoothLoading.PostProgressWithDetailFromWorker(
            ProgressPct, ExtractProgressDetail(FSyncLine));
          NowTick := GetTickCount;
          if (FLastProgressUiTick = 0) or (NowTick - FLastProgressUiTick >= 400) then
          begin
            FLastProgressUiTick := NowTick;
            Synchronize(SyncDispatchOneLine);
          end;
        end
        else
          Synchronize(SyncDispatchOneLine);
      end
      else
      begin
        if FPendingBatchText <> '' then
          FPendingBatchText := FPendingBatchText + #10;
          FPendingBatchText := FPendingBatchText + DecodeUtf8PipeText(LineBuf);
        Inc(BatchCount);
        if (BatchCount >= 4096) or (Length(FPendingBatchText) >= 262144) then
          FlushBatch;
      end;
    end
  end;

  if (not Terminated) and (Buffer <> '') then
  begin
    while (Length(Buffer) > 0) and (Buffer[Length(Buffer)] in [#13, #10]) do
      Delete(Buffer, Length(Buffer), 1);
    if Buffer <> '' then
    begin
      if FPendingBatchText <> '' then
        FPendingBatchText := FPendingBatchText + #10;
      FPendingBatchText := FPendingBatchText + DecodeUtf8PipeText(Buffer);
    end;
  end;

  if (not Terminated) and (FPendingBatchText <> '') then
    FlushBatch;
end;

constructor TScriptEngineRunThread.Create(AOwner: TfrmMain; const AScriptB64: string;
  const ALineNumbers: array of Int64; ATotalLines: Int64;
  AUseSelected: Boolean; const ASourceFileName, AIndexFileName, ACkptFileName: string;
  AUseSparseIndex: Boolean; const ADisplayEncoding: string);
var
  I: Integer;
begin
  inherited Create(False);
  FreeOnTerminate := False;
  FOwner := AOwner;
  FScriptB64 := AScriptB64;
  FUseSelected := AUseSelected;
  FTotalLines := ATotalLines;
  FSourceFileName := ASourceFileName;
  FIndexFileName := AIndexFileName;
  FCkptFileName := ACkptFileName;
  FUseSparseIndex := AUseSparseIndex;
  FDisplayEncoding := ADisplayEncoding;
  FDoneSent := False;
  FUseRunFileMode := False;
  FRunFileWritesOutFile := False;
  SetLength(FLineNumbers, Length(ALineNumbers));
  for I := 0 to Length(ALineNumbers) - 1 do
    FLineNumbers[I] := ALineNumbers[I];
end;

function TScriptEngineRunThread.TryReadIndexOffsetByLineNumber(
  const ALineNumber1Based: Int64; out AOffset: Int64): Boolean;
var
  OffsetBuf: array[0..17] of AnsiChar;
  OffsetText: AnsiString;
  ReadCount: Integer;
  IdxPos: Int64;
begin
  Result := False;
  AOffset := 0;
  if (ALineNumber1Based < 1) or (ALineNumber1Based > (Int64(MaxInt) + 1)) then Exit;
  if not Assigned(FIndexStream) then Exit;
  try
    IdxPos := (ALineNumber1Based - 1) * INDEX_RECORD_SIZE;
    FIndexStream.Seek(IdxPos, Word(soFromBeginning));
    ReadCount := FIndexStream.Read(OffsetBuf, SizeOf(OffsetBuf));
    if ReadCount < SizeOf(OffsetBuf) then Exit;

    SetString(OffsetText, PAnsiChar(@OffsetBuf[0]), SizeOf(OffsetBuf));
    AOffset := StrToInt64Def(Trim(string(OffsetText)), -1);
    if AOffset = -1 then Exit;
    AOffset := Abs(AOffset);
    Result := True;
  except
    Result := False;
    AOffset := 0;
  end;
end;

function TScriptEngineRunThread.ReadLineContentByOffsets(
  const AStartOffset, AEndOffset: Int64): string;
var
  FullLineLen: Int64;
  LineLength: Integer;
  Buffer: AnsiString;
  BytesRead2: Integer;
begin
  Result := '';
  if (AStartOffset <= 0) or (AEndOffset <= 0) then Exit;
  if (AEndOffset <= AStartOffset) then Exit;
  if not Assigned(FSourceStream) then Exit;

  try
    FullLineLen := AEndOffset - AStartOffset;
    if FullLineLen <= 0 then Exit;

    if FullLineLen > MAX_LINE_LEN_DISPLAY then
      LineLength := MAX_LINE_LEN_DISPLAY
    else
      LineLength := FullLineLen;

    FileStreamSeek64(FSourceStream, AStartOffset - 1, Word(soFromBeginning));
    SetLength(Buffer, LineLength);
    BytesRead2 := FSourceStream.Read(Pointer(Buffer)^, LineLength);
    while (BytesRead2 > 0) and (Buffer[BytesRead2] in [#10, #13]) do
      Dec(BytesRead2);
    SetLength(Buffer, BytesRead2);
    Result := DisplayTextFromFileBytes(Buffer, FDisplayEncoding);
  except
    Result := '';
  end;
end;

function TScriptEngineRunThread.TryReadSparseLineStartOffset(
  const ALineNumber1Based: Int64; out AOffset: Int64): Boolean;
var
  CkptIdx: Int64;
  SkipCount: Integer;
  ScanBuf: array[0..65535] of Byte;
  ScanRead, ScanI: Integer;
  ScanRemaining: Integer;
  ScanPos: Int64;
  OffsetBuf: array[0..17] of AnsiChar;
  OffsetText: AnsiString;
  BytesRead: Integer;
begin
  Result := False;
  AOffset := 0;
  if (ALineNumber1Based < 1) or (not Assigned(FSourceStream)) or
     (not Assigned(FCkptStream)) then Exit;
  try
    CkptIdx := (ALineNumber1Based - 1) div CKPT_INTERVAL;
    SkipCount := (ALineNumber1Based - 1) mod CKPT_INTERVAL;
    FileStreamSeek64(FCkptStream, CkptIdx * INDEX_RECORD_SIZE, Word(soFromBeginning));
    BytesRead := FCkptStream.Read(OffsetBuf, 18);
    if BytesRead < 18 then Exit;
    SetString(OffsetText, PAnsiChar(@OffsetBuf[0]), 18);
    AOffset := StrToInt64Def(Trim(string(OffsetText)), -1);
    if AOffset <= 0 then Exit;
    AOffset := Abs(AOffset);
    if SkipCount > 0 then
    begin
      ScanRemaining := SkipCount;
      ScanPos := AOffset - 1;
      FileStreamSeek64(FSourceStream, ScanPos, Word(soFromBeginning));
      while ScanRemaining > 0 do
      begin
        ScanRead := FSourceStream.Read(ScanBuf, SizeOf(ScanBuf));
        if ScanRead = 0 then Exit;
        for ScanI := 0 to ScanRead - 1 do
        begin
          Inc(ScanPos);
          if ScanBuf[ScanI] = FSourceTermByte then
          begin
            Dec(ScanRemaining);
            if ScanRemaining = 0 then
            begin
              AOffset := ScanPos + 1;
              Break;
            end;
          end;
        end;
        if ScanRemaining > 0 then
          FileStreamSeek64(FSourceStream, ScanPos + 1, Word(soFromBeginning));
      end;
    end;
    Result := True;
  except
    Result := False;
    AOffset := 0;
  end;
end;

function TScriptEngineRunThread.ReadLineContentByNumber(
  const ALineNumber1Based: Int64): string;
var
  StartOffset, EndOffset: Int64;
begin
  Result := '';
  if (ALineNumber1Based < 1) or (ALineNumber1Based > (Int64(MaxInt) + 1)) then Exit;
  if not Assigned(FSourceStream) then Exit;

  if FUseSparseIndex then
  begin
    if not TryReadSparseLineStartOffset(ALineNumber1Based, StartOffset) then Exit;
    if not TryReadSparseLineStartOffset(ALineNumber1Based + 1, EndOffset) then
      EndOffset := FSourceStream.Size + 1;
  end
  else
  begin
    if not Assigned(FIndexStream) then Exit;
    if not TryReadIndexOffsetByLineNumber(ALineNumber1Based, StartOffset) then Exit;
    if not TryReadIndexOffsetByLineNumber(ALineNumber1Based + 1, EndOffset) then
      EndOffset := FSourceStream.Size + 1;
  end;

  Result := ReadLineContentByOffsets(StartOffset, Abs(EndOffset));
end;

procedure TScriptEngineRunThread.SyncStart;
begin
  TfrmSmoothLoading.ResetCancel;
  TfrmSmoothLoading.BeginScriptEngineProgress;
  TfrmSmoothLoading.ShowLoading(TrText('Running script over file lines...'), False);
  TfrmSmoothLoading.UpdateProgressWithDetail(1, TrText('SCRIPT_ENGINE_OVERLAY_START'));
  TfrmSmoothLoading.FlushPaint;
  if Assigned(FOwner) then
    FOwner.SetScriptEngineStatus(TrText('Sending lines...'));
end;

procedure TScriptEngineRunThread.SyncFinish;
var
  ElapsedMs: Cardinal;
  ElapsedInfo: string;
begin
  if not Assigned(FOwner) then Exit;

  if FErrorText <> '' then
  begin
    TfrmSmoothLoading.HideLoading;
    FOwner.ReleaseScriptEngineRunThread;
    if FOwner.FScriptRunStartTick <> 0 then
      ElapsedMs := GetTickCount - FOwner.FScriptRunStartTick
    else
      ElapsedMs := 0;
    ElapsedInfo := Format(TrText('Elapsed time: %s'), [FOwner.FormatScriptElapsed(ElapsedMs)]);

    FOwner.CloseScriptDirectOutput;
    FOwner.SetScriptEngineStatus(TrText('Run error'));
    FOwner.AppendScriptEngineOutput('[ERROR] ' + FErrorText);
    FOwner.AppendScriptEngineOutput('[INFO] ' + ElapsedInfo);
    if Assigned(FOwner.FScriptEngineRunButton) then FOwner.FScriptEngineRunButton.Enabled := True;
    if Assigned(FOwner.FScriptEngineSaveButton) then FOwner.FScriptEngineSaveButton.Enabled := False;
  end
  else if Terminated then
  begin
    TfrmSmoothLoading.HideLoading;
    FOwner.ReleaseScriptEngineRunThread;
    FOwner.CloseScriptDirectOutput;
    if Assigned(FOwner.FScriptEngineRunButton) then FOwner.FScriptEngineRunButton.Enabled := True;
  end
  else
    FOwner.SetScriptEngineStatus(TrText('Waiting engine output...'));
end;

procedure TScriptEngineRunThread.SyncPrepareRunFileOutput;
begin
  FRunFileWritesOutFile := False;
  if not Assigned(FOwner) then Exit;

  if FOwner.FScriptDirectOutputMode and (FOwner.FScriptDirectOutputFileName <> '') then
  begin
    { Engine v5+: Python writes OUTFILE directly. Older exe: keep Delphi stream. }
    if FOwner.FScriptEngineVersion >= 5 then
    begin
      if Assigned(FOwner.FScriptDirectOutputStream) then
        FreeAndNil(FOwner.FScriptDirectOutputStream);
      FOwner.FScriptEngineWritesDirectOutput := True;
      FRunFileWritesOutFile := True;
    end
    else
    begin
      FOwner.FScriptEngineWritesDirectOutput := False;
      FRunFileWritesOutFile := False;
    end;
  end
  else
    FOwner.FScriptEngineWritesDirectOutput := False;
end;

procedure TScriptEngineRunThread.Execute;
var
  I: Integer;
  LineNum: Int64;
  LineText: string;
  DoneCount: Int64;
  TotalCount: Int64;
  Pct: Integer;
  BatchStream: TMemoryStream;
  BatchLineCount: Integer;
  PayloadText: string;

  function FlushBatchToPipe: Boolean;
  var
    PipeHandle: THandle;
    TotalBytes: Integer;
    WrittenTotal: Integer;
    BytesWritten: DWORD;
    P: PAnsiChar;
  begin
    Result := True;
    if (not Assigned(BatchStream)) or (BatchStream.Size = 0) then Exit;
    if not Assigned(FOwner) then
    begin
      Result := False;
      Exit;
    end;

    PipeHandle := FOwner.FScriptEngineStdInWrite;
    if (not FOwner.FScriptEngineProcessRunning) or (PipeHandle = 0) or
       (PipeHandle = INVALID_HANDLE_VALUE) then
    begin
      Result := False;
      Exit;
    end;

    TotalBytes := BatchStream.Size;
    WrittenTotal := 0;
    P := BatchStream.Memory;
    while WrittenTotal < TotalBytes do
    begin
      if not Windows.WriteFile(PipeHandle, P[WrittenTotal], TotalBytes - WrittenTotal,
        BytesWritten, nil) then
      begin
        Result := False;
        Exit;
      end;
      if BytesWritten = 0 then
      begin
        Result := False;
        Exit;
      end;
      Inc(WrittenTotal, BytesWritten);
    end;

    BatchStream.Clear;
    BatchLineCount := 0;
  end;

  function QueueLineForPipe(const ACmdLine: string): Boolean;
  var
    Data: UTF8String;
  begin
    Result := True;
    Data := UTF8Encode(ACmdLine + #10);
    if Length(Data) > 0 then
      BatchStream.WriteBuffer(Pointer(Data)^, Length(Data));
    Inc(BatchLineCount);
    if (BatchStream.Size >= (256 * 1024)) or (BatchLineCount >= 512) then
      Result := FlushBatchToPipe;
  end;

  function ParseOffsetFromRecord(const ARec: array of AnsiChar; out AOffset: Int64): Boolean;
  var
    RecText: AnsiString;
  begin
    Result := False;
    AOffset := 0;
    if Length(ARec) < 18 then Exit;
    SetString(RecText, PAnsiChar(@ARec[0]), 18);
    AOffset := StrToInt64Def(Trim(string(RecText)), -1);
    if AOffset = -1 then Exit;
    AOffset := Abs(AOffset);
    Result := True;
  end;

  function EncodeUtf8Base64(const S: string): string;
  var
    SrcBytes: AnsiString;
    N, I2: Integer;
    B1, B2, B3: Byte;
  begin
    SrcBytes := UTF8Encode(S);
    N := Length(SrcBytes);
    Result := '';
    I2 := 1;
    while I2 <= N do
    begin
      B1 := Ord(SrcBytes[I2]); Inc(I2);
      if I2 <= N then begin B2 := Ord(SrcBytes[I2]); Inc(I2); end else B2 := 0;
      if I2 <= N then begin B3 := Ord(SrcBytes[I2]); Inc(I2); end else B3 := 0;
      Result := Result +
        B64Chars[((B1 shr 2) and $3F) + 1] +
        B64Chars[(((B1 and $03) shl 4) or ((B2 shr 4) and $0F)) + 1] +
        B64Chars[(((B2 and $0F) shl 2) or ((B3 shr 6) and $03)) + 1] +
        B64Chars[(B3 and $3F) + 1];
    end;
    case N mod 3 of
      1: begin Result[Length(Result) - 1] := '='; Result[Length(Result)] := '='; end;
      2: Result[Length(Result)] := '=';
    end;
  end;

begin
  inherited;
  Synchronize(SyncStart);
  BatchStream := nil;
  try
    if (not Assigned(FOwner)) or (not FOwner.FScriptEngineProcessRunning) then
    begin
      FErrorText := TrText('Script engine is not running.');
      Exit;
    end;

    if not FOwner.ScriptEngineWriteLine('SCRIPT:' + FScriptB64) then
    begin
      FErrorText := TrText('Could not send script to engine.');
      Exit;
    end;

    FOwner.PrepareScriptEngineCompileWait;
    case FOwner.FScriptEngineCompileEvent.WaitFor(120000) of
      wrSignaled:
        if not FOwner.FScriptEngineCompileOk then
        begin
          if FOwner.FScriptEngineLastCompileError <> '' then
            FErrorText := FOwner.FScriptEngineLastCompileError
          else
            FErrorText := TrText('Compile error');
          Exit;
        end;
      wrTimeout:
        begin
          FErrorText := TrText('SCRIPT_ENGINE_COMPILE_TIMEOUT');
          Exit;
        end;
    else
      begin
        FErrorText := TrText('Compile error');
        Exit;
      end;
    end;

    if FUseSelected then
      TotalCount := Length(FLineNumbers)
    else
      TotalCount := FTotalLines;

    DoneCount := 0;
    if TotalCount <= 0 then
    begin
      FDoneSent := FOwner.ScriptEngineWriteLine('DONE');
      if not FDoneSent then
        FErrorText := TrText('Could not finalize script processing.');
      Exit;
    end;

    if FUseSelected then
    begin
      FSourceTermByte := LineTermByteForFile(FSourceFileName);
      FSourceStream := TFileStream.Create(FSourceFileName, fmOpenRead or fmShareDenyNone);
      if FUseSparseIndex then
        FCkptStream := TFileStream.Create(FCkptFileName, fmOpenRead or fmShareDenyNone)
      else
        FIndexStream := TFileStream.Create(FIndexFileName, fmOpenRead or fmShareDenyNone);
      BatchStream := TMemoryStream.Create;
      BatchLineCount := 0;

      for I := 0 to Length(FLineNumbers) - 1 do
      begin
        if Terminated or TfrmSmoothLoading.CancelRequested then
        begin
          FErrorText := TrText('Script cancelled by user.');
          Exit;
        end;
        LineNum := FLineNumbers[I];
        if LineNum < 1 then
        begin
          Inc(DoneCount);
          Continue;
        end;
        LineText := ReadLineContentByNumber(LineNum);
        if not QueueLineForPipe('LINE:' + IntToStr(LineNum) + ':' + LineText) then
        begin
          FErrorText := TrText('Broken pipe while sending lines.');
          Exit;
        end;
        Inc(DoneCount);
        if ((DoneCount and $3FF) = 0) or (DoneCount = TotalCount) then
        begin
          Pct := Round((DoneCount * 100.0) / TotalCount);
          TfrmSmoothLoading.UpdateProgress(Pct);
        end;
      end;
    end
    else
    begin
      { Ultra-fast full-scan path: Python reads source + index directly. }
      FUseRunFileMode := True;
      Synchronize(SyncPrepareRunFileOutput);
      PayloadText :=
        'SOURCE=' + ExpandFileName(FSourceFileName) + #10 +
        'ENC=' + FDisplayEncoding + #10 +
        'TOTAL=' + IntToStr(FTotalLines) + #10 +
        'MAX_LINE_LEN=' + IntToStr(MAX_LINE_LEN_DISPLAY);
      if FUseSparseIndex then
      begin
        if (FCkptFileName = '') or (not FileExists(FCkptFileName)) then
        begin
          FErrorText := TrText('SCRIPT_ENGINE_CKPT_NOT_FOUND');
          Exit;
        end;
        PayloadText := PayloadText + #10 +
          'CKPT=' + ExpandFileName(FCkptFileName) + #10 +
          'CKPT_INTERVAL=' + IntToStr(CKPT_INTERVAL);
      end
      else
        PayloadText := PayloadText + #10 + 'INDEX=' + ExpandFileName(FIndexFileName);
      if FRunFileWritesOutFile then
      begin
        PayloadText := PayloadText + #10 +
          'OUTFILE=' + FOwner.FScriptDirectOutputFileName + #10 +
          'SILENT_OUT=1';
      end;
      FOwner.AppendScriptEngineOutput('[INFO] ' +
        TrText('SCRIPT_ENGINE_RUNFILE_MODE'));
      if not FOwner.ScriptEngineWriteLine('RUNFILE:' + EncodeUtf8Base64(PayloadText)) then
      begin
        FErrorText := TrText('Could not start fast file processing in script engine.');
        Exit;
      end;
      Exit;
    end;

    if not FlushBatchToPipe then
    begin
      FErrorText := TrText('Broken pipe while sending lines.');
      Exit;
    end;

    FDoneSent := FOwner.ScriptEngineWriteLine('DONE');
    if not FDoneSent then
      FErrorText := TrText('Could not finalize script processing.');
  finally
    if Assigned(BatchStream) then
      FreeAndNil(BatchStream);
    if Assigned(FIndexStream) then FreeAndNil(FIndexStream);
    if Assigned(FCkptStream) then FreeAndNil(FCkptStream);
    if Assigned(FSourceStream) then FreeAndNil(FSourceStream);
    Synchronize(SyncFinish);
  end;
end;


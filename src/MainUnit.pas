// -----------------------------------------------------------------------------
procedure TfrmMain.UpdateStatusBar(const TextMsg: string; Alignment: TIconAlignment);
begin
  if not AppUiUpdatesAllowed then Exit;
  FActivityStatusActive := False;
  if not Assigned(sStatusBar1) then Exit;
  FCurrentIconAlignment := Alignment;
  sStatusBar1.Panels[0].Text := TextMsg;
  if (sStatusBar1.Handle <> 0) and IsWindow(sStatusBar1.Handle) then
    sStatusBar1.Repaint;
end;

procedure TfrmMain.SetOperationStatus(AState: TFFStatusState; const AActivity: string);
var
  Prefix, Activity, TextMsg: string;
begin
  Activity := Trim(AActivity);
  case AState of
    fssPending:
      Prefix := Tr('status.pending_prefix', 'Pending:');
    fssLoading:
      Prefix := Tr('status.loading_prefix', 'Loading:');
    fssCancelled:
      Prefix := Tr('status.cancelled_prefix', 'Cancelled:');
    fssFailed:
      Prefix := Tr('status.failed_prefix', 'Failed:');
  else
    Prefix := '';
  end;

  if AState = fssReady then
    TextMsg := Tr('status.system_ready', 'System Ready')
  else
  begin
    if Activity = '' then
      Activity := Tr('status.operation', 'operation');
    TextMsg := Prefix + ' ' + Activity;
  end;

  UpdateStatusBar(TextMsg, iaRight);
  FActivityStatusActive := AState in [fssPending, fssLoading];
  if FActivityStatusActive then
    FActivityStatusText := Activity
  else
    FActivityStatusText := '';
end;

procedure TfrmMain.FinishOperationStatus(AState: TFFStatusState);
begin
  if not FActivityStatusActive then Exit;
  SetOperationStatus(AState, FActivityStatusText);
end;

procedure TfrmMain.sStatusBar1MouseMove(Sender: TObject;
  Shift: TShiftState; X, Y: Integer);
var
  R1, RMode, REol: TRect;
  P: TPoint;
  Seg: Integer;
begin
  P := Point(X, Y);
  sStatusBar1.Perform(SB_GETRECT, 1, Integer(@R1));
  if PtInRect(R1, P) then
  begin
    sStatusBar1.Cursor := crHandPoint;
    Application.CancelHint;
    Exit;
  end;

  if sStatusBar1.Panels.Count > 5 then
  begin
    sStatusBar1.Perform(SB_GETRECT, 5, Integer(@REol));
    if (REol.Right <= REol.Left) then
      REol := StatusBarPanelRectByWidths(5);
    if PtInRect(REol, P) then
    begin
      sStatusBar1.Cursor := crHandPoint;
      Application.CancelHint;
      Exit;
    end;
  end;

  Seg := HitTestStatusModeSegment(X, Y);
  if Seg >= 0 then
  begin
    sStatusBar1.Cursor := crHandPoint;
    Application.CancelHint;
    Exit;
  end;

  sStatusBar1.Cursor := crDefault;
  if FShowWhitespaceMarks and (FWhitespaceMarksLegendHint <> '') then
  begin
    RMode := StatusBarPanelRectByWidths(4);
    if PtInRect(RMode, P) then
    begin
      Application.Hint := FWhitespaceMarksLegendHint;
      Application.ActivateHint(sStatusBar1.ClientToScreen(Point(X, Y - 4)));
    end
    else
      Application.CancelHint;
  end
  else
    Application.CancelHint;
end;

procedure TfrmMain.sStatusBar1MouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  R1, REol: TRect;
  P: TPoint;
  Seg: Integer;
begin
  if Button <> mbLeft then Exit;
  P := Point(X, Y);

  sStatusBar1.Perform(SB_GETRECT, 1, Integer(@R1));
  if PtInRect(R1, P) then
  begin
    ExecutePanelIndexOne;
    Exit;
  end;

  if sStatusBar1.Panels.Count > 5 then
  begin
    sStatusBar1.Perform(SB_GETRECT, 5, Integer(@REol));
    if (REol.Right <= REol.Left) then
      REol := StatusBarPanelRectByWidths(5);
    if PtInRect(REol, P) then
    begin
      ShowEolFormatPopup(sStatusBar1.ClientToScreen(P));
      Exit;
    end;
  end;

  Seg := HitTestStatusModeSegment(X, Y);
  if Seg >= 0 then
    ToggleStatusModeSegment(Seg);
end;

function TfrmMain.BuildLoadedFileDetailsText: string;
var
  lastAccessTime, lastModificationTime: TDateTime;
  Sz: Int64;
  EncDisp, listModeLine: string;

  function Dt(const D: TDateTime): string;
  begin
    Result := FormatDateTime('yyyy-mm-dd hh:nn:ss', D);
  end;

  function YN(const B: Boolean): string;
  begin
    if B then
      Result := TrText('Yes')
    else
      Result := TrText('No');
  end;

  procedure AddLine(const S: string);
  begin
    Result := Result + S + #13#10;
  end;

  procedure AddKV(const Name, Value: string);
  begin
    AddLine(Name + ' ' + Value);
  end;
begin
  Result := '';
  if fileIsEmpty then Exit;

  if UnUtils.CheckFile(CurrentEffectiveFilePath) then
  begin
    DSiWin32.DSiGetFileTimes(CurrentEffectiveFilePath, creationTime, lastAccessTime, lastModificationTime);
    Sz := UnUtils.GetFileSize(CurrentEffectiveFilePath);
    AddKV(TrText('File name:'), Trim(edtFileName.Text));
    AddKV(TrText('Size on disk:'), Format('%s %s', [UnUtils.FormatNumber(Sz), TrText('bytes')]));
    AddKV(TrText('Creation Date:'), Dt(creationTime));
    AddKV(TrText('Modified:'), Dt(lastModificationTime));
    AddKV(TrText('Last accessed:'), Dt(lastAccessTime));
    AddKV(TrText('Total lines:'), UnUtils.FormatNumber(totalLines));
    AddKV(TrText('Total characters:'), UnUtils.FormatNumber(totalCharacters));
    AddKV(TrText('Max indexed offset:'), UnUtils.FormatNumber(MaxOffset));
    AddKV(TrText('Detected encoding (file):'), FDetectedEncoding);
    EncDisp := '';
    if Assigned(comboViewEncoding) and (comboViewEncoding.ItemIndex >= 0) and
      (comboViewEncoding.ItemIndex < comboViewEncoding.Items.Count) then
      EncDisp := comboViewEncoding.Items[comboViewEncoding.ItemIndex];
    AddKV(TrText('View encoding (list):'), EncDisp);
    AddKV(TrText('Read-only session:'), YN(FFileSessionReadOnly));
    AddKV(TrText('Word wrap (visual):'), YN(Assigned(chkWordWrap) and chkWordWrap.Checked));
    AddKV(TrText('Tail / follow mode:'), YN(FTailActive));
    AddKV(TrText('Line-segmented policy:'), SegmentHeavyOpsPolicyCaption);
    AddKV(TrText('Line-segmented force:'), YN(FForceSegmentHeavyOps));
    AddKV(TrText('Filter / Grep active:'), YN(FFilterActive));
    if isChecked then
      listModeLine := TrText('List mode: checkbox list')
    else
      listModeLine := TrText('List mode: list view');
    AddLine(listModeLine);
  end
  else
    AddKV(TrText('File name:'), Trim(edtFileName.Text));
end;

procedure TfrmMain.ExecutePanelIndexOne;
begin
  if fileIsEmpty then Exit;
  ShowDetailsPopup(BuildLoadedFileDetailsText);
end;

// -----------------------------------------------------------------------------

procedure TfrmMain.LayoutStatusBarPanels;
var
  W0, W1, W2, W3, W4, W5, W6, W7, W8, W9: Integer;
  Need, Avail, Excess, Pad: Integer;
  ModeTxt, EolTxt, LineTxt, LinesTxt: string;
  WidthsChanged: Boolean;

  procedure SetPanelWidth(AIndex, AWidth: Integer);
  begin
    if sStatusBar1.Panels[AIndex].Width <> AWidth then
    begin
      sStatusBar1.Panels[AIndex].Width := AWidth;
      WidthsChanged := True;
    end;
  end;

  function CompactModeText: string;
  var
    CsvModeText, TailText, FilterText, SelectText, WrapText, MarksText: string;
  begin
    if FCsvMode then CsvModeText := 'CSV' else CsvModeText := 'TEXT';
    if FTailActive then
    begin
      if FTailPaused then TailText := TrText('PAUSED') else TailText := TrText('ON');
    end
    else
      TailText := TrText('OFF');
    if FFilterActive then FilterText := TrText('ON') else FilterText := TrText('OFF');
    if isChecked then SelectText := 'CHECK' else SelectText := 'LIST';
    if FFastVisualWordWrap then WrapText := TrText('ON') else WrapText := TrText('OFF');
    if FShowWhitespaceMarks then MarksText := TrText('ON') else MarksText := TrText('OFF');
    { Still 6 double-space segments for HitTestStatusModeSegment. }
    try
      Result := Format(TrText('StatusBar.ModeCompact'),
        [CsvModeText, WrapText, TailText, FilterText, MarksText, SelectText]);
    except
      Result := Format('Mode:%s  Wrap:%s  Tail:%s  Fil:%s  Mk:%s  %s',
        [CsvModeText, WrapText, TailText, FilterText, MarksText, SelectText]);
    end;
  end;

begin
  if not Assigned(sStatusBar1) or (sStatusBar1.Panels.Count < 10) then Exit;
  if not sStatusBar1.HandleAllocated then
    sStatusBar1.HandleNeeded;

  Pad := FfPx(14);
  W1 := FfPx(27);
  W3 := FfPx(27);
  W2 := FfPx(168);
  W8 := FfPx(210);
  W9 := FfPx(96);

  ModeTxt := Trim(sStatusBar1.Panels[4].Text);
  if ModeTxt = '' then
    ModeTxt := BuildStatusModeText;
  W4 := Max(FfPx(300), StatusBarTextWidth(ModeTxt) + Pad);

  EolTxt := Trim(sStatusBar1.Panels[5].Text);
  if EolTxt = '' then
    EolTxt := EolStatusBarCaption(FDetectedEol);
  W5 := Max(FfPx(56), StatusBarTextWidth(EolTxt) + Pad);

  LineTxt := Trim(sStatusBar1.Panels[6].Text);
  if LineTxt = '' then
  begin
    if FTrLineColZero <> '' then
      LineTxt := FTrLineColZero
    else
      LineTxt := 'Line: 0  Col: 0';
  end;
  W6 := Max(FfPx(110), StatusBarTextWidth(LineTxt) + Pad);

  LinesTxt := Trim(sStatusBar1.Panels[7].Text);
  if LinesTxt = '' then
  begin
    if FTrLinesFormat <> '' then
      LinesTxt := Format(FTrLinesFormat, [totalLines])
    else
      LinesTxt := Format('Lines: %d', [totalLines]);
  end;
  W7 := Max(FfPx(90), StatusBarTextWidth(LinesTxt) + Pad);

  Need := W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9;
  Avail := sStatusBar1.ClientWidth;
  if Avail < FfPx(400) then
    Avail := FfPx(400);

  { If the full Mode string does not fit, switch to a compact label set. }
  if (Need + FfPx(90) > Avail) then
  begin
    ModeTxt := CompactModeText;
    sStatusBar1.Panels[4].Text := ModeTxt;
    W4 := Max(FfPx(260), StatusBarTextWidth(ModeTxt) + Pad);
    Need := W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9;
  end;

  W0 := Avail - Need;
  if W0 < FfPx(90) then
  begin
    Excess := FfPx(90) - W0;
    W0 := FfPx(90);
    if (Excess > 0) and (W7 > FfPx(80)) then
    begin
      Dec(W7, Min(Excess, W7 - FfPx(80)));
      Excess := FfPx(90) - (Avail - (W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9));
      if Excess < 0 then Excess := 0;
    end;
    if (Excess > 0) and (W6 > FfPx(96)) then
    begin
      Dec(W6, Min(Excess, W6 - FfPx(96)));
      Excess := FfPx(90) - (Avail - (W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9));
      if Excess < 0 then Excess := 0;
    end;
    if (Excess > 0) and (W8 > FfPx(160)) then
    begin
      Dec(W8, Min(Excess, W8 - FfPx(160)));
      Excess := FfPx(90) - (Avail - (W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9));
      if Excess < 0 then Excess := 0;
    end;
    if (Excess > 0) and (W2 > FfPx(120)) then
      Dec(W2, Min(Excess, W2 - FfPx(120)));
    W0 := Max(FfPx(70), Avail - (W1 + W2 + W3 + W4 + W5 + W6 + W7 + W8 + W9));
  end;

  WidthsChanged := False;
  SetPanelWidth(0, W0);
  SetPanelWidth(1, W1);
  SetPanelWidth(2, W2);
  SetPanelWidth(3, W3);
  SetPanelWidth(4, W4);
  SetPanelWidth(5, W5);
  SetPanelWidth(6, W6);
  SetPanelWidth(7, W7);
  SetPanelWidth(8, W8);
  SetPanelWidth(9, W9);

  { Combos are children positioned over panels 2/8/9: re-anchor when panels move. }
  if WidthsChanged then
  begin
    LayoutLanguageCombo;
    LayoutViewEncodingCombo;
    LayoutZoomCombo;
  end;
end;

procedure TfrmMain.RememberWheelZoomInCombo(const APct: Integer; const AForce: Boolean = False);
var
  S, TmpS: string;
  I, J, Idx, V1, V2: Integer;
  Keep: TStringList;
  NowTick: DWORD;

  function ZoomValue(const AText: string): Integer;
  var
    T: string;
  begin
    T := Trim(StringReplace(AText, '%', '', [rfReplaceAll]));
    Result := StrToIntDef(T, MaxInt);
  end;

begin
  if not Assigned(comboZoom) then Exit;
  if not Assigned(FZoomWheelHistory) then Exit;

  S := Format('%d%%', [APct]);

  I := FZoomWheelHistory.IndexOf(S);
  if I >= 0 then
    FZoomWheelHistory.Delete(I);
  FZoomWheelHistory.Insert(0, S);
  while FZoomWheelHistory.Count > MAX_WHEEL_ZOOM_HISTORY do
    FZoomWheelHistory.Delete(FZoomWheelHistory.Count - 1);

  NowTick := GetTickCount;
  if (not AForce) and ((NowTick - FLastZoomComboUpdateTick) < WHEEL_ZOOM_COMBO_DEBOUNCE_MS) then
  begin
    { Debounce: evita rebuild pesado a cada WM_MOUSEWHEEL, mas mantem selecao atual se existir. }
    Idx := comboZoom.Items.IndexOf(S);
    if Idx >= 0 then
    begin
      FUpdatingZoomCombo := True;
      try
        comboZoom.ItemIndex := Idx;
      finally
        FUpdatingZoomCombo := False;
      end;
    end;
    Exit;
  end;
  FLastZoomComboUpdateTick := NowTick;

  Keep := TStringList.Create;
  FUpdatingZoomCombo := True;
  try
    comboZoom.Items.BeginUpdate;
    try
      { Mantem os itens existentes (sem apagar) e injeta os ultimos 5 do scroll. }
      for I := 0 to comboZoom.Items.Count - 1 do
        if Keep.IndexOf(comboZoom.Items[I]) < 0 then
          Keep.Add(comboZoom.Items[I]);
      for I := 0 to FZoomWheelHistory.Count - 1 do
        if Keep.IndexOf(FZoomWheelHistory[I]) < 0 then
          Keep.Add(FZoomWheelHistory[I]);
      if Keep.IndexOf(S) < 0 then
        Keep.Add(S);

      { Ordenacao numerica total (todos os itens) para manter combo 100% ordenada. }
      for I := 0 to Keep.Count - 2 do
        for J := I + 1 to Keep.Count - 1 do
        begin
          V1 := ZoomValue(Keep[I]);
          V2 := ZoomValue(Keep[J]);
          if (V2 < V1) or ((V1 = V2) and (AnsiCompareText(Keep[J], Keep[I]) < 0)) then
          begin
            TmpS := Keep[I];
            Keep[I] := Keep[J];
            Keep[J] := TmpS;
          end;
        end;

      while Keep.Count > MAX_COMBO_ITEMS do
        Keep.Delete(Keep.Count - 1);

      comboZoom.Items.Assign(Keep);
      Idx := comboZoom.Items.IndexOf(S);
      if Idx >= 0 then
        comboZoom.ItemIndex := Idx;
    finally
      comboZoom.Items.EndUpdate;
    end;
  finally
    Keep.Free;
    FUpdatingZoomCombo := False;
  end;
end;

procedure TfrmMain.ApplyListViewZoomPercent(const APct: Integer);
var
  Pct, NewSize, OldPct, VI, CH, RH, OldVI: Integer;
begin
  if not Assigned(ListView1) then Exit;
  if FListViewZoomBaseFontSize <= 0 then
    FListViewZoomBaseFontSize := Max(1, ListView1.Font.Size);

  Pct := APct;
  if Pct < ZOOM_MIN_PERCENT then Pct := ZOOM_MIN_PERCENT;
  if Pct > ZOOM_MAX_PERCENT then Pct := ZOOM_MAX_PERCENT;

  OldPct := FListViewZoomPct;
  if OldPct <= 0 then
    OldPct := Round((100.0 * ListView1.Font.Size) / Max(1, FListViewZoomBaseFontSize));

  NewSize := Round((FListViewZoomBaseFontSize * Pct) / 100.0);
  if NewSize < ZOOM_MIN_SIZE then NewSize := ZOOM_MIN_SIZE;
  if NewSize > ZOOM_MAX_SIZE then NewSize := ZOOM_MAX_SIZE;
  if NewSize = ListView1.Font.Size then
  begin
    if Pct > OldPct then
      Inc(NewSize)
    else if Pct < OldPct then
      Dec(NewSize);
    if NewSize < ZOOM_MIN_SIZE then NewSize := ZOOM_MIN_SIZE;
    if NewSize > ZOOM_MAX_SIZE then NewSize := ZOOM_MAX_SIZE;
  end;
  FListViewZoomPct := Pct;
  if NewSize = ListView1.Font.Size then
  begin
    UpdateListViewZoomStatusPanel;
    Exit;
  end;

  BeginListViewZoomVisualBatch;
  try
    if isChecked and Assigned(FCheckListBox) then
    begin
      { Evitar ListView1Resize/Realign da header-strip a cada passo de zoom. }
      ListView1.OnResize := nil;
      try
        ListView1.Font.Size := NewSize;
        if FCheckListBox.Font.Size <> NewSize then
          FCheckListBox.Font.Size := NewSize;
      finally
        ListView1.OnResize := ListView1Resize;
      end;
      CalculateFontMetrics;
      CH := ReadViewportClientHeight;
      if CH < 20 then
        CH := 400;
      if FFastVisualWordWrap then
      begin
        if Assigned(FWordWrapRowImages) and (FWordWrapRowImages.Height > 0) then
          RH := FWordWrapRowImages.Height
        else
          RH := Max(48, (Abs(FLineHeight) + 2) * MinWrapRows);
      end
      else
        RH := Max(16, Abs(FLineHeight) + 2);
      if RH <= 0 then
        RH := 18;
      VI := CH div RH;
      if VI < 1 then
        VI := 1;
      OldVI := VisibleItems;
      VisibleItems := VI;
      SyncVerticalScrollBarRange;
      InvalidateLineCache;
      FCheckListBox.HandleNeeded;
      ApplyCheckListZoomRefresh(OldVI);
      if Assigned(ListView1) and (not FReadContentColumnExpanded) then
      begin
        UpdateListViewLineColumnAutoWidth;
        UpdateCheckListLinePrefixAutoWidth;
      end;
      UpdateInfoPanels;
      UpdateListViewZoomStatusPanel;
    end
    else
    begin
      ListView1.Font.Size := NewSize;
      CalculateFontMetrics;
      if FFastVisualWordWrap then
        UpdateListViewWordWrapUi
      else
      begin
        ListView1Resize(ListView1);
        InvalidateLineCache;
        if ListView1.HandleAllocated and ListView1.Visible then
        begin
          ListView1.Perform(CM_RECREATEWND, 0, 0);
          FDeferredListViewRecreateForRowHeight := False;
        end
        else
          FDeferredListViewRecreateForRowHeight := True;
      end;
      UpdateInfoPanels;
      UpdateListViewZoomStatusPanel;
    end;
  finally
    EndListViewZoomVisualBatch;
  end;
  SaveListViewZoomToIni;
end;

procedure TfrmMain.LayoutPPIPanel(Sender: TObject);
var
  Ppi, Pad, Gap, LblW, BtnW, PanelW, Chrome: Integer;
  Bmp: TBitmap;
begin
  if not Assigned(sPanel1) or not Assigned(SpeedBtnPPI) or not Assigned(sSkinSelector1) then Exit;
  Ppi := GetPPI(sSkinProvider1.SkinData);
  if Ppi < 96 then Ppi := 96;
  Pad := MulDiv(4, Ppi, 96);
  Gap := MulDiv(8, Ppi, 96);
  SpeedBtnPPI.WordWrap := False;
  Bmp := TBitmap.Create;
  try
    LblW := 0;
    if sSkinSelector1.BoundLabel.Active then
    begin
      if Assigned(sSkinSelector1.BoundLabel.FTheLabel) then
        Bmp.Canvas.Font.Assign(sSkinSelector1.BoundLabel.FTheLabel.Font)
      else
        Bmp.Canvas.Font.Assign(sSkinSelector1.Font);
      LblW := Bmp.Canvas.TextWidth(sSkinSelector1.BoundLabel.Caption) + Gap;
    end;
    Bmp.Canvas.Font.Assign(SpeedBtnPPI.Font);
    { Text + glyph + drop-down arrow + margins. }
    BtnW := Bmp.Canvas.TextWidth(SpeedBtnPPI.Caption) +
      MulDiv(CharImageList16.Width + 16 + 24, Ppi, 96);
  finally
    Bmp.Free;
  end;
  Chrome := sPanel1.Width - sPanel1.ClientWidth;
  sSkinSelector1.Left := Pad + LblW;
  SpeedBtnPPI.SetBounds(sSkinSelector1.Left + sSkinSelector1.Width + Gap, SpeedBtnPPI.Top,
    BtnW, SpeedBtnPPI.Height);
  PanelW := SpeedBtnPPI.Left + BtnW + Pad + Chrome;
  sPanel1.SetBounds(ClientWidth - PanelW - Pad, sPanel1.Top, PanelW, sPanel1.Height);
  if sSkinSelector1.BoundLabel.Active then
    sSkinSelector1.BoundLabel.AlignLabel;
end;

procedure TfrmMain.SkinScaleChanged(Sender: TObject);
begin
  LayoutPPIPanel;
  { Skin rescaling resizes the form (and its constraints) even when maximized,
    leaving the window larger than the monitor; fix it once the rescale settles. }
  if HandleAllocated and Visible then
  begin
    if not Assigned(FUIScaleBoundsTimer) then
    begin
      FUIScaleBoundsTimer := TTimer.Create(Self);
      FUIScaleBoundsTimer.Interval := 400;
      FUIScaleBoundsTimer.OnTimer := UIScaleBoundsTimerTick;
    end;
    FUIScaleBoundsTimer.Enabled := False;
    FUIScaleBoundsTimer.Enabled := True;
  end;
  if FUIScalePPI <= 0 then Exit;
  SyncListViewZoomToUIScale;
  if not FUIScaleRestoring then
    SaveUIScaleToIni;
end;

procedure TfrmMain.UIScaleBoundsTimerTick(Sender: TObject);
begin
  FUIScaleBoundsTimer.Enabled := False;
  FixWindowBoundsAfterScale;
end;

procedure TfrmMain.FixWindowBoundsAfterScale;
var
  M: TMonitor;
  MR, WR: TRect;
  Slack: Integer;
begin
  if (csDestroying in ComponentState) or not HandleAllocated or not Visible then Exit;
  FfRelaxMinConstraints(Self);
  if WindowState <> wsMaximized then
  begin
    FfFitFormToWorkArea(Self);
    Exit;
  end;
  M := Screen.MonitorFromWindow(Handle);
  if not Assigned(M) then Exit;
  MR := M.BoundsRect;
  GetWindowRect(Handle, WR);
  Slack := FfPx(24);
  if (WR.Left < MR.Left - Slack) or (WR.Top < MR.Top - Slack) or
     (WR.Right > MR.Right + Slack) or (WR.Bottom > MR.Bottom + Slack) then
  begin
    { Re-maximize so Windows snaps the window back to the monitor work area. }
    WindowState := wsNormal;
    FfFitFormToWorkArea(Self);
    WindowState := wsMaximized;
  end;
end;

procedure TfrmMain.SyncListViewZoomToUIScale;
var
  NewPPI, Pct: Integer;
begin
  { Keep the zoom % stable across skin PPI changes: rescale the 100% base font
    by the PPI ratio, then reapply the same % so content follows the UI scale. }
  NewPPI := GetPPI(sSkinProvider1.SkinData);
  if (NewPPI <= 0) or (FUIScalePPI <= 0) or (NewPPI = FUIScalePPI) then Exit;
  if Assigned(ListView1) and (FListViewZoomBaseFontSize > 0) then
  begin
    Pct := FListViewZoomPct;
    if Pct <= 0 then
      Pct := 100;
    FListViewZoomBaseFontSize := Max(1, MulDiv(FListViewZoomBaseFontSize, NewPPI, FUIScalePPI));
    FUIScalePPI := NewPPI;
    ApplyListViewZoomPercent(Pct);
    RememberWheelZoomInCombo(Pct, True);
  end
  else
    FUIScalePPI := NewPPI;
end;

procedure TfrmMain.SaveUIScaleToIni;
var
  V: Integer;
begin
  if (IniName = '') or not Assigned(DataModule1) or not Assigned(DataModule1.sSkinManager1) then Exit;
  { UIScalePPI: -1 = automatic (Windows DPI), 0 = follow the default from
    Preferences, otherwise the custom PPI. }
  if DataModule1.sSkinManager1.Options.ScaleMode = smCustomPPI then
  begin
    V := DataModule1.sSkinManager1.Options.PixelsPerInch;
    if V = DefaultUIScalePPI then
      V := 0;
  end
  else
    V := -1;
  sStoreUtils.WriteIniStr(APPLICATION_NAME, 'UIScalePPI', IntToStr(V), IniName);
end;

function TfrmMain.SystemUIScalePPI: Integer;
begin
  Result := Screen.PixelsPerInch;
  if Result >= 168 then
    Result := 192
  else if Result >= 132 then
    Result := 144
  else if Result >= 108 then
    Result := 120
  else
    Result := 96;
end;

function TfrmMain.DefaultUIScalePPI: Integer;
begin
  Result := PrefDefaultUIScalePPI;
  if Result <= 0 then
    Result := SystemUIScalePPI;
end;

function TfrmMain.DefaultUIScaleCaption: string;
begin
  if PrefDefaultUIScalePPI <= 0 then
    Result := Format('%s (%s: %d)', [TrText('Scale.RestoreDefault'),
      TrText('Scale.WindowsDPI'), DefaultUIScalePPI])
  else
    Result := Format('%s (%d PPI)', [TrText('Scale.RestoreDefault'), DefaultUIScalePPI]);
end;

procedure TfrmMain.ApplyUIScalePPI(APPI: Integer; AAnimate: Boolean);
var
  SM: TsSkinManager;
begin
  if not Assigned(DataModule1) or not Assigned(DataModule1.sSkinManager1) then Exit;
  SM := DataModule1.sSkinManager1;
  if SM.Options.ScaleMode <> smCustomPPI then
  begin
    { Assign PPI while still non-custom, then switch mode (see ApplySystemDpiScaleOnce). }
    SM.Options.PixelsPerInch := APPI;
    SM.Options.ScaleMode := smCustomPPI;
  end
  else if AAnimate and Animated then
    SetPPIAnimated(APPI)
  else
    SM.Options.PixelsPerInch := APPI;
  if Assigned(SpeedBtnPPI) then
    SpeedBtnPPI.Caption := TrText('Custom PPI: ') + IntToStr(APPI);
  SkinScaleChanged(Self);
end;

procedure TfrmMain.RestoreDefaultUIScale(Sender: TObject);
var
  P: Integer;
begin
  P := DefaultUIScalePPI;
  if (DataModule1.sSkinManager1.Options.ScaleMode = smCustomPPI) and
     (GetPPI(sSkinProvider1.SkinData) = P) then
    SkinScaleChanged(Self)
  else
    ApplyUIScalePPI(P, True);
  if IniName <> '' then
    sStoreUtils.WriteIniStr(APPLICATION_NAME, 'UIScalePPI', '0', IniName);
end;

procedure TfrmMain.RestoreUIScaleFromIni;
var
  V: Integer;
begin
  if (IniName = '') or not Assigned(DataModule1) or not Assigned(DataModule1.sSkinManager1) then Exit;
  V := sStoreUtils.ReadIniInteger(APPLICATION_NAME, 'UIScalePPI', 0, IniName);
  if V < 0 then Exit;
  if V = 0 then
    V := PrefDefaultUIScalePPI;
  if (V < MIN_UI_SCALE_PPI) or (V > MAX_UI_SCALE_PPI) then Exit;
  if V = GetPPI(sSkinProvider1.SkinData) then Exit;
  FUIScaleRestoring := True;
  try
    ApplyUIScalePPI(V, False);
  finally
    FUIScaleRestoring := False;
  end;
end;

procedure TfrmMain.ApplySystemDpiScaleOnce;
var
  SysPPI: Integer;
begin
  { Root cause: Scaled=False + PerMonitorV2 @ 125% keeps design 96px sizes (~20% small).
    SetPPIAnimated(120) was a no-op under smVCL because Options.PixelsPerInch was
    already 120 while controls were never enlarged. Enable VCL ScaleForPPI, then
    lock AlphaControls to matching custom PPI (same percent → no second shrink/grow). }
  if FSystemDpiApplied then Exit;
  FSystemDpiApplied := True;
  if csDesigning in ComponentState then Exit;

  SysPPI := SystemUIScalePPI;
  if SysPPI <= 96 then Exit;

  Scaled := True;
  if CurrentPPI <> SysPPI then
    ScaleForPPI(SysPPI);
  StartupMark('  DPI: ScaleForPPI');

  if Assigned(DataModule1) and Assigned(DataModule1.sSkinManager1) then
  begin
    if DataModule1.sSkinManager1.Options.ScaleMode = smCustomPPI then
    begin
      if DataModule1.sSkinManager1.Options.PixelsPerInch < SysPPI then
        SetPPIAnimated(SysPPI);
    end
    else
    begin
      { Assign PPI while still non-custom (no scale math), then switch mode to
        refresh skins. From smVCL@systemDPI → smCustomPPI@SysPPI percent matches. }
      DataModule1.sSkinManager1.Options.PixelsPerInch := SysPPI;
      DataModule1.sSkinManager1.Options.ScaleMode := smCustomPPI;
    end;
    if Assigned(SpeedBtnPPI) then
      SpeedBtnPPI.Caption := TrText('Custom PPI: ') + IntToStr(SysPPI);
  end;
  LayoutPPIPanel;
  StartupMark('  DPI: skin PPI');

  if Assigned(ListView1) and (ListView1.Font.Size > 0) then
  begin
    { If ScaleForPPI did not run (already CurrentPPI) but list is still design-sized. }
    if (SysPPI > 96) and (ListView1.Font.Size <= 10) then
      ListView1.Font.Size := MulDiv(10, SysPPI, 96);
    if FListViewZoomPct <= 0 then
      FListViewZoomPct := 100;
    FListViewZoomBaseFontSize := Max(1, Round((ListView1.Font.Size * 100.0) / FListViewZoomPct));
  end;
  FfRelaxMinConstraints(Self);
end;

procedure TfrmMain.LoadListViewZoomFromIni;
var
  Pct: Integer;
begin
  if IniName = '' then Exit;
  if not Assigned(ListView1) then Exit;
  Pct := sStoreUtils.ReadIniInteger(APPLICATION_NAME, 'ListViewZoomPct', 100, IniName);
  if Pct < ZOOM_MIN_PERCENT then Pct := ZOOM_MIN_PERCENT;
  if Pct > ZOOM_MAX_PERCENT then Pct := ZOOM_MAX_PERCENT;
  if Pct <> FListViewZoomPct then
    ApplyListViewZoomPercent(Pct)
  else
    RememberWheelZoomInCombo(Pct, True);
end;

procedure TfrmMain.SaveListViewZoomToIni;
begin
  if IniName = '' then Exit;
  if FListViewZoomPct <= 0 then Exit;
  sStoreUtils.WriteIniStr(APPLICATION_NAME, 'ListViewZoomPct',
    IntToStr(FListViewZoomPct), IniName);
end;

procedure TfrmMain.comboZoomChange(Sender: TObject);
var
  S: string;
  Pct: Integer;
begin
  if FUpdatingZoomCombo then Exit;
  if not Assigned(comboZoom) then Exit;
  S := Trim(StringReplace(comboZoom.Text, '%', '', [rfReplaceAll]));
  Pct := StrToIntDef(S, 100);
  ApplyListViewZoomPercent(Pct);
  SaveListViewZoomToIni;
end;


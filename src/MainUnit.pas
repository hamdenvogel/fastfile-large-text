procedure TfrmMain.LoadSmartSearchPrefs;
var
  Ini: TIniFile;
  V: Integer;
begin
  LoadFileOpenPolicyFromIni(IniName);
  LoadUserPrefs(IniName);
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    V := Ini.ReadInteger(APPLICATION_NAME, 'OpenFilePolicy', Ord(fopAuto));
    if (V >= Ord(Low(TOpenFilePolicy))) and (V <= Ord(High(TOpenFilePolicy))) then
      FOpenFilePolicy := TOpenFilePolicy(V);
    V := Ini.ReadInteger(APPLICATION_NAME, 'FindCasePolicy', Ord(fcpAuto));
    if (V >= Ord(Low(TFindCasePolicy))) and (V <= Ord(High(TFindCasePolicy))) then
      FFindCasePolicy := TFindCasePolicy(V);
    V := Ini.ReadInteger(APPLICATION_NAME, 'FilterMatchPolicy', Ord(fmpAuto));
    if (V >= Ord(Low(TFilterMatchPolicy))) and (V <= Ord(High(TFilterMatchPolicy))) then
      FFilterMatchPolicy := TFilterMatchPolicy(V);
    V := Ini.ReadInteger(APPLICATION_NAME, 'FilterCasePolicy', Ord(ffcpAuto));
    if (V >= Ord(Low(TFilterCasePolicy))) and (V <= Ord(High(TFilterCasePolicy))) then
      FFilterCasePolicy := TFilterCasePolicy(V);
    FForceZeroScan := Ini.ReadBool(APPLICATION_NAME, 'ForceZeroScan', False);
    V := Ini.ReadInteger(APPLICATION_NAME, 'SegmentHeavyOpsPolicy', Ord(shpAuto));
    if (V >= Ord(Low(TSegmentHeavyOpsPolicy))) and (V <= Ord(High(TSegmentHeavyOpsPolicy))) then
      FSegmentHeavyOpsPolicy := TSegmentHeavyOpsPolicy(V);
    { Menu so tem Forcar + Automatico; INI antigo always/never mapeia para isso. }
    if FSegmentHeavyOpsPolicy = shpAlwaysOn then
      FForceSegmentHeavyOps := True;
    FSegmentHeavyOpsPolicy := shpAuto;
  finally
    Ini.Free;
  end;
  SyncOpenFilePolicyMenu;
  SyncFindCasePolicyMenu;
  SyncFilterPolicyMenus;
  ApplySegmentHeavyOpsUiState;
  if Assigned(FMenuForceZeroScan) then
    FMenuForceZeroScan.Checked := FForceZeroScan;
end;

procedure TfrmMain.SaveSmartSearchPrefs;
var
  Ini: TIniFile;
begin
  SaveFileOpenPolicyToIni(IniName);
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteInteger(APPLICATION_NAME, 'OpenFilePolicy', Ord(FOpenFilePolicy));
    Ini.WriteInteger(APPLICATION_NAME, 'FindCasePolicy', Ord(FFindCasePolicy));
    Ini.WriteInteger(APPLICATION_NAME, 'FilterMatchPolicy', Ord(FFilterMatchPolicy));
    Ini.WriteInteger(APPLICATION_NAME, 'FilterCasePolicy', Ord(FFilterCasePolicy));
    Ini.WriteBool(APPLICATION_NAME, 'ForceZeroScan', FForceZeroScan);
    Ini.WriteInteger(APPLICATION_NAME, 'SegmentHeavyOpsPolicy', Ord(FSegmentHeavyOpsPolicy));
  finally
    Ini.Free;
  end;
  SaveFileOpenPolicyToIni(IniName);
end;


procedure TfrmMain.ShowScriptEnginePanel;
begin
  ClearFileLineHoverHint;
  { Script panel lives under pnlCenter on tabReadFile; Recent Files tab hides it. }
  if Assigned(tabReadFile) then
    ShowTab(tabReadFile);
  EnsureScriptEnginePanel;
  EnsureScriptEngineAIButton;
  FitScriptEngineHeaderButtons;
  FScriptEngineWritesDirectOutput := False;
  if not Assigned(FScriptEnginePanel) then Exit;
  if Assigned(FScriptOutputMemo) then
  begin
    FScriptOutputMemo.WordWrap := True;
    FScriptOutputMemo.ScrollBars := ssVertical;
  end;
  if Assigned(FScriptStatusLabel) then
  begin
    FScriptStatusLabel.WordWrap := True;
    FScriptStatusLabel.ShowHint := True;
    if FScriptStatusLabel.Height < 36 then
      FScriptStatusLabel.Height := 36;
  end;
  if Assigned(FScriptBottomPanel) and (FScriptBottomPanel.Height < 96) then
    FScriptBottomPanel.Height := 96;
  FScriptEnginePanel.Visible := True;
  FScriptEnginePanel.BringToFront;
  if Assigned(FScriptSuggestionsPanel) and FScriptSuggestionsPanel.Visible then
    FScriptSuggestionsPanel.BringToFront;
  FScriptEnginePanel.BringToFront;
  if Assigned(splListview) then
  begin
    splListview.Visible := True;
    splListview.BringToFront;
  end;
  { Same as Consumer AI/RAG: download ScriptEngine.exe if missing, then start process. }
  if not FScriptEngineProcessRunning then
    StartScriptEngineProcess;
end;

procedure TfrmMain.HideScriptEnginePanel;
begin
  HideScriptExportNotice;
  if Assigned(FScriptEnginePanel) then
    FScriptEnginePanel.Visible := False;
  if Assigned(FScriptSuggestionsPanel) then
    FScriptSuggestionsPanel.Visible := False;
  if Assigned(splListview) then
    splListview.Visible := False;
end;

procedure TfrmMain.ScriptEngineCloseClick(Sender: TObject);
begin
  StopScriptEngineProcess;
  HideScriptEnginePanel;
end;


procedure TfrmMain.btnMainToolsGalleryClick(Sender: TObject);
var
  P: TPoint;
  LastTag: Integer;
begin
  { Recreate every open: AlphaSkins UpdateScale(96→DPI) only runs once per
    form instance. Reusing the form left PrepareLayout at design pixels while
    scale stayed at DPI — 2nd open looked ~half height. }
  LastTag := -1;
  if Assigned(FormPopupToolGallery) then
  begin
    LastTag := FormPopupToolGallery.SelectedTag;
    FreeAndNil(FormPopupToolGallery);
  end;

  FormPopupToolGallery := TFormPopupToolGallery.Create(Self);

  FormPopupToolGallery.SyncItem(FormPopupToolGallery.btnGallerySplitPattern,  btnMainSplitByPattern);
  FormPopupToolGallery.SyncItem(FormPopupToolGallery.btnGallerySplitEqual,    btnMainSplitEqualParts);
  FormPopupToolGallery.SyncItem(FormPopupToolGallery.btnGalleryExtractParts, btnMainExtractParts);
  FormPopupToolGallery.SyncItem(FormPopupToolGallery.btnGalleryFindFiles,    btnShowTabFindFile);
  FormPopupToolGallery.SyncItem(FormPopupToolGallery.btnGallerySelectSkin,   sSpeedButton9);

  FormPopupToolGallery.btnGallerySplitPattern.OnClick  := ToolGalleryItemClick;
  FormPopupToolGallery.btnGallerySplitEqual.OnClick    := ToolGalleryItemClick;
  FormPopupToolGallery.btnGalleryExtractParts.OnClick  := ToolGalleryItemClick;
  FormPopupToolGallery.btnGalleryFindFiles.OnClick     := ToolGalleryItemClick;
  FormPopupToolGallery.btnGallerySelectSkin.OnClick    := ToolGalleryItemClick;

  FormPopupToolGallery.SetSelectedTag(LastTag);
  FormPopupToolGallery.PrepareLayout;
  { AlphaSkins UpdateScale(96→DPI) runs inside ShowPopupForm. Doing it here
    while still invisible avoids the on-screen enlarge→shrink flash; the
    second UpdateScale in ShowPopupForm becomes a no-op (same PPI). }
  FormPopupToolGallery.HandleNeeded;
  if DefaultManager <> nil then
    DefaultManager.UpdateScale(FormPopupToolGallery);
  FormPopupToolGallery.RelayoutChrome;

  P := btnMainToolsGallery.ClientToScreen(Point(0, btnMainToolsGallery.Height));
  ShowPopupForm(FormPopupToolGallery, P, False);
  FormPopupToolGallery.FocusSearch;
end;

procedure TfrmMain.ToolGalleryItemClick(Sender: TObject);
var
  Tag: Integer;
  Clicked: TsSpeedButton;
begin
  if not Assigned(FormPopupToolGallery) or not (Sender is TsSpeedButton) then Exit;
  Clicked := TsSpeedButton(Sender);
  Tag := Clicked.Tag;

  { Remember last chosen item for highlight on next open. }
  FormPopupToolGallery.SetSelectedTag(Tag);
  FormPopupToolGallery.ClosePopup;

  case Tag of
    0: miSplitByPatternClick(btnMainSplitByPattern);
    1: miSplitEqualPartsClick(btnMainSplitEqualParts);
    2: miSplitFileFractionClick(btnMainExtractParts);
    3: btnShowTabFindFileClick(btnShowTabFindFile);
    4: sSpeedButton9Click(sSpeedButton9);
  end;
end;


procedure TfrmMain.ApplySplitPatternHostedMetrics;
var
  Frm: TMergeFilesDialogForm;
  SB: TScrollBox;
  Avail, WorkH, HGuide, HHdr, HFtr, Y, AvailBar, WSuggest, WTalk: Integer;
  PBottom: TWinControl;
begin
  if not Assigned(FSplitPatternScrollBox) or not Assigned(FSplitByPatternHosted) then Exit;
  if FSplitPatternMemoGuideDefH <= 0 then
    FSplitPatternMemoGuideDefH := 136;
  SB := FSplitPatternScrollBox;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
  Avail := SB.ClientHeight;
  WorkH := GetSystemMetrics(SM_CYFULLSCREEN);
  if WorkH < 480 then
    WorkH := Screen.Height;
  if Avail < 32 then
    Avail := MulDiv(WorkH, 38, 100);
  if Avail < 160 then
    Avail := 160;
  if Avail > MulDiv(WorkH, 55, 100) then
    Avail := MulDiv(WorkH, 55, 100);

  HGuide := Min(FSplitPatternMemoGuideDefH, Max(40, MulDiv(Avail, 32, 100)));
  HHdr := Min(FSplitPatternMemoHdrDefH, Max(28, MulDiv(Avail, 9, 100)));
  HFtr := Min(FSplitPatternMemoFtrDefH, HHdr);

  { AI buttons sit on the bottom panel (parent <> scroll box); keep them inside the left strip. }
  if Assigned(Frm.BtnRegexSuggestAI) and Assigned(Frm.BtnRegexSuggestAI.Parent) and
     Assigned(FSplitPatternScrollBox) and (Frm.BtnRegexSuggestAI.Parent <> FSplitPatternScrollBox) and
     Assigned(Frm.BtnRegexAI) then
  begin
    PBottom := Frm.BtnRegexSuggestAI.Parent;
    AvailBar := PBottom.ClientWidth - 272 - 24 - 8;
    WSuggest := FFMeasureTextWidth(Frm.BtnRegexSuggestAI.Font, Frm.BtnRegexSuggestAI.Caption) + 28;
    WTalk := FFMeasureTextWidth(Frm.BtnRegexAI.Font, Frm.BtnRegexAI.Caption) + 28;
    if (AvailBar > 112) and (WSuggest + WTalk > AvailBar) then
    begin
      WSuggest := MulDiv(AvailBar, WSuggest, WSuggest + WTalk);
      WTalk := AvailBar - WSuggest;
    end;
    Frm.BtnRegexSuggestAI.Width := Max(56, WSuggest);
    Frm.BtnRegexAI.Width := Max(56, WTalk);
    Frm.BtnRegexSuggestAI.Left := 8;
    Frm.BtnRegexAI.Left := Frm.BtnRegexSuggestAI.Left + Frm.BtnRegexSuggestAI.Width + 8;
    Frm.BtnRegexSuggestAI.Top := 44;
    Frm.BtnRegexAI.Top := 44;
  end;

  Y := Frm.FSplitPatternMemoAnchorY;
  if Assigned(Frm.LblRegexAiBanner) and Frm.LblRegexAiBanner.Visible then
    Inc(Y, 38);

  if Assigned(Frm.MemoRegexGuide) then
  begin
    Frm.MemoRegexGuide.Top := Y;
    Frm.MemoRegexGuide.Height := HGuide;
    Inc(Y, HGuide + 10);
  end;

  if Assigned(Frm.LblPattern) then
  begin
    Frm.LblPattern.Top := Y;
    Inc(Y, 18);
  end;
  if Assigned(Frm.EdtPattern) then
  begin
    Frm.EdtPattern.Top := Y;
    Inc(Y, 26 + 10);
  end;

  if Assigned(Frm.LblHeader2) then
  begin
    Frm.LblHeader2.Top := Y;
    Inc(Y, 18);
  end;
  if Assigned(Frm.MemoHeader2) then
  begin
    Frm.MemoHeader2.Top := Y;
    Frm.MemoHeader2.Height := HHdr;
    Inc(Y, HHdr + 10);
  end;

  if Assigned(Frm.LblFooter2) then
  begin
    Frm.LblFooter2.Top := Y;
    Inc(Y, 18);
  end;
  if Assigned(Frm.MemoFooter2) then
  begin
    Frm.MemoFooter2.Top := Y;
    Frm.MemoFooter2.Height := HFtr;
    Inc(Y, HFtr + 10);
  end;

  if Assigned(Frm.LblHint2) then
    Frm.LblHint2.Top := Y;

  LayoutSplitPatternAiBanner(SB, Frm);
  SB.VertScrollBar.Tracking := True;
end;


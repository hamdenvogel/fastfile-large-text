  PartTo := Frm.SpnFracTo.Value;
  if PartFrom > PartTo then
    Frm.LblFracPreview.Caption := TrText('SplitFileFraction.PreviewInvalid')
  else if PartFrom = PartTo then
    Frm.LblFracPreview.Caption := Format(TrText('SplitFileFraction.PreviewSingle'),
      [PartFrom, Total, PartFrom, Total])
  else
    Frm.LblFracPreview.Caption := Format(TrText('SplitFileFraction.PreviewRange'),
      [PartFrom, PartTo, Total, PartFrom, Total, PartTo, Total]);
  Frm.ReflowStack;
end;


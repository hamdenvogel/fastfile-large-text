procedure TfrmMain.AssistantCbOpenFile(const APath: string);
var
  P: string;
begin
  try
    P := Trim(APath);
    if P = '' then Exit;
    if not FileExists(P) then
    begin
      FastFileMessageBox(PChar(TrText('Assistant.Error.FileNotFound') + #13#10 + P),
        PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
      Exit;
    end;
    EnsureReadTabVisible;
    edtFileName.Text := P;
    BeginRead;
  except
    on E: Exception do
      ReportFastFileException('AssistantCbOpenFile', E, True);
  end;
end;

function TfrmMain.AssistantCbTryDeferUntilLoaded(var AStep: TAssistantChainStep): Boolean;
var
  Src, Cur: string;
  Pending: array[0..0] of TAssistantChainStep;
  AlreadyReady: Boolean;
begin
  { Path in edtFileName is not the same as Read. Native tools that need the
    MMF/index schedule the same action after BeginRead — no "Leia o arquivo primeiro". }
  Result := False;
  Src := Trim(AStep.Path);
  if Src = SELECTTEXT then Src := '';
  Cur := Trim(CurrentEffectiveFilePath);
  if Cur = SELECTTEXT then Cur := '';
  if Src = '' then
  begin
    Src := Cur;
    if Src = '' then
      Src := Trim(edtFileName.Text);
    if Src = SELECTTEXT then Src := '';
  end;
  AStep.Path := Src;
  AlreadyReady := Assigned(FSourceFileStream) and (Src <> '') and FileExists(Src) and
    (SameFileName(Src, Cur) or SameFileName(Src, Trim(fFileName)));
  if not AlreadyReady then
    AlreadyReady := Assigned(FSourceFileStream) and (totalLines > 0);
  if AlreadyReady then Exit;
  Result := True;
  if (Src = '') or (not FileExists(Src)) then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  Pending[0] := AStep;
  AssistantHostSetChain(Pending, 1, True);
  AssistantCbOpenFile(Src);
end;


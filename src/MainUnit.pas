procedure TfrmMain.btnConsumerAIClick(Sender: TObject);
begin(*var
  DeployPath: String;
  Success: Boolean;
begin
  if ListviewIsEmpty then Exit;
  DeployPath := ExtractFilePath(Application.ExeName);
  // --- CALL THE HELPER ---
  // This line creates the modal, waits for user input, sets the hidden path, and runs the process.
  Success := TConsumerUIHelper.RequestInputAndExecute(edtFileName.Text, DeployPath);
  if Success then
    ShowAppMessage('Process finished successfully!')
  else
    ShowAppMessage('O processo foi cancelado ou ocorreu um erro.');  *)
  { Dedicated SQL chat shortcut/button retired. }
end;

procedure TfrmMain.finishFileNameRead(const timer: string; const LineCount: Int64; const CharactersCount: Int64);
var
  EffectiveLineCount: Int64;
begin
  EffectiveLineCount := LineCount;
  FFileReloadInProgress := False;
  if TfrmSmoothLoading.HeavyFileMutateHoldActive then
    Exit;
  if (Trim(fFileName) = '') and Assigned(edtFileName) then
    fFileName := CurrentEffectiveFilePath;
  edtFileName.Text := fFileName;
  ApplySessionReadOnlyFilenameDecoration;
  SyncReadFileF5Button;
  FZeroScanMode := FForceZeroScan or (EffectiveLineCount >= 2000000000);
  { Instant / Force ZS: nao abrir temp.txt/ckpt (offsets errados => coluna Conteudo vazia). }
  OpenFileStreams(fFileName, (not FForceZeroScan) and (EffectiveLineCount < 2000000000));
  if CharactersCount > 0 then
    FSourceFileSize := CharactersCount;
  { Instant Open em ficheiros pequenos: contar linhas reais e sair do ZS virtual.
    Evita ListView com "Linha 4.." inventadas e edicao silenciosa alem do EOF. }
  if (EffectiveLineCount >= ZERO_SCAN_VIRTUAL_CAP) and Assigned(FSourceFileStream) and
     (CharactersCount > 0) and (CharactersCount <= ZERO_SCAN_FULL_COUNT_MAX) and
     (not FForceZeroScan) then
  begin
    EffectiveLineCount := CountPhysicalLinesInOpenFile;
    if EffectiveLineCount < 1 then
      EffectiveLineCount := 1;
    FZeroScanMode := False;
    FZeroScanEstimatedLines := False;
    FZeroScanPhysicalLineCount := EffectiveLineCount;
    if Assigned(FIndexFileStream) then FreeAndNil(FIndexFileStream);
    if Assigned(FCkptFileStream) then FreeAndNil(FCkptFileStream);
  end;
  FDetectedEncoding := DetectFileEncoding(fFileName);
  FDetectedEol := DetectLineEndingFromFile(fFileName);
  UpdateEolStatusPanel;
  FUpdatingViewEncodingCombo := True;
  try
    if Assigned(comboViewEncoding) then
    begin
      comboViewEncoding.ItemIndex := 0;
      comboViewEncoding.Enabled := True;
      comboViewEncoding.BringToFront;
      LayoutViewEncodingCombo;
    end;
  finally
    FUpdatingViewEncodingCombo := False;
  end;
  if FFreshFileRead then
    ClearUndoRedo;
  ClearAllBookmarks;
  if FTailActive then StopTailFollowMode;
  FTailSessionFirstLine := -1;
  if FFilterActive then ClearFilter;
  AddToRecentFiles(fFileName);
  FLastFoundLine := -1;
  FLastFoundFilePos := 0;
  InvalidateLineCache;
  { Instant Open: nunca misturar indice antigo (temp.txt) com scroll proporcional. }
  if EffectiveLineCount >= 2000000000 then
  begin
    if Assigned(FIndexFileStream) then FreeAndNil(FIndexFileStream);
    if Assigned(FCkptFileStream) then FreeAndNil(FCkptFileStream);
  end;
  { Com indice (temp.txt/ckpt): scroll e linhas reais; nao marcar Zero Scan so pelo tamanho em GB. }
  if (not FZeroScanMode) and (not HasLineSearchIndex) and (EffectiveLineCount > 500000) then
  begin
    FZeroScanMode := True;
    if EffectiveLineCount > 0 then
      FZeroScanBytesPerItem := CharactersCount div EffectiveLineCount
    else
      FZeroScanBytesPerItem := 1;
    if FZeroScanBytesPerItem < 1 then FZeroScanBytesPerItem := 1;
  end;
  ApplyZeroScanVirtualLineCount(EffectiveLineCount, CharactersCount);
  totalLines := EffectiveLineCount;
  ItemCount := totalLines;
  totalCharacters := CharactersCount;
  if UsesProportionalZeroScanScroll then
    EnsureZeroScanBytesPerItemInitialized;
  { Reabertura completa (F5): sair do modo Select. Pos-edicao (undo/colar): manter modo. }
  if FFreshFileRead then
  begin
    isChecked := False;
    FCheckListDisplayOffset := -1;
    isAllChecked := False;
  end;
  SyncListViewViewportAfterFileLoad;
  SyncReadViewUiAfterFileLoad;
  { DoRead is asynchronous; rebuild the split grid after totalLines is valid. }
  if Assigned(trkFiles) then
    tableTempFiles(trkFiles.Position);
  UnUtils.ActionComponent([btnClear, btnSplitFiles, btnMergeMultipleLines, btnCheckBoxes, btnExport, btnEditFile], acEnabled);
  if Assigned(FBtnTopExport) then
    FBtnTopExport.Enabled := True;
  if Assigned(FBtnTopFileOptions) then
    FBtnTopFileOptions.Enabled := True;
  UpdateInfoPanels;
  if not FFreshFileRead then
    EndRead
  else
    ApplySessionReadOnlyUi;
  CaptureOpenFileDiskSnapshot;
  UpdateStatusBar(Tr('status.system_ready', 'System Ready'), iaRight);
  RunDeferredFindAfterIndexIfNeeded;
  RunDeferredFilterAfterIndexIfNeeded;
  if AssistantHostHasPendingChain then
    AssistantHostNotifyReadFinished(Trim(fFileName));
  AppendOperationTimerLog(timer);
end;

procedure TfrmMain.CloseFileStreams;
begin
  FDeferredFindAfterIndex := False;
  FDeferredFilterAfterIndex := False;
  FAssistantPendingExportFiltered := False;
  FAssistantPendingExportToFile := False;
  FAssistantPendingFilterCaseSensitive := False;
  FFilterUseHitsList := False;
  SetLength(FFilterHitsList, 0);
  FFindByteOnlyActive := False;
  FZeroScanMode := False;
  FZeroScanEstimatedLines := False;
  FZeroScanPhysicalLineCount := 0;
  FZeroScanEndLineStartByte := 0;
  FZeroScanEndScrollOffset := 0;
  FSourceFileSize := 0;
  if Assigned(FSourceFileStream) then FreeAndNil(FSourceFileStream);
  if Assigned(FIndexFileStream)  then FreeAndNil(FIndexFileStream);
  if Assigned(FCkptFileStream)   then FreeAndNil(FCkptFileStream);
  InvalidateOpenFileDiskSnapshot;
  InvalidateLineCache;
  if not AppUiUpdatesAllowed then Exit;
  if Assigned(ListView1) and (ListView1.Handle <> 0) and IsWindow(ListView1.Handle) then
  begin
    try ListView1.Items.Count := 0; except end;
    try ListView1.Invalidate; except end;
  end;
  if AppUiUpdatesAllowed then
    try ApplySessionReadOnlyUi; except end;
end;

procedure TfrmMain.RegisterActiveIndexReadThread(AThread: TThread);
begin
  FIndexReadThread := AThread;
end;

procedure TfrmMain.UnregisterActiveIndexReadThread(AThread: TThread);
begin
  if FIndexReadThread = AThread then
    FIndexReadThread := nil;
end;

procedure TfrmMain.WaitForActiveIndexReadThread;
var
  I: Integer;
  Thr: TThread;
begin
  { Delphi 7: TThread nao tem Finished; aguarda Unregister no Destroy da indexacao. }
  TfrmSmoothLoading.RequestCancel;
  for I := 1 to 600 do
  begin
    if not Assigned(FIndexReadThread) then Exit;
    FIndexReadThread.Terminate;
    Application.ProcessMessages;
    Sleep(50);
  end;
  if Assigned(FIndexReadThread) then
  begin
    Thr := FIndexReadThread;
    try
      Thr.Terminate;
      Thr.WaitFor;
    except
    end;
  end;
end;

procedure TfrmMain.BeginHeavyFileMutate;
begin
  TfrmSmoothLoading.SetHeavyFileMutateHold(True);
  ReleaseSourceFileHandlesBeforeMutate;
end;

procedure TfrmMain.CancelBackgroundWorkFromWatchdog;
begin
  { Called from watchdog thread — only cooperative cancel / Terminate. }
  try
    TfrmSmoothLoading.RequestCancel;
  except
  end;
  try
    if Assigned(FFindThread) then
      FFindThread.Terminate;
  except
  end;
  try
    if Assigned(FFilterThread) then
      FFilterThread.Terminate;
  except
  end;
  try
    if Assigned(FIndexReadThread) then
      FIndexReadThread.Terminate;
  except
  end;
end;

procedure FastFileMainWatchdogCancelWorkers;
begin
  try
    if Assigned(frmMain) then
      frmMain.CancelBackgroundWorkFromWatchdog;
  except
  end;
end;

procedure TfrmMain.EndHeavyFileMutate;
begin
  TfrmSmoothLoading.SetHeavyFileMutateHold(False);
end;

procedure TfrmMain.ReleaseSourceFileHandlesBeforeMutate;
var
  I: Integer;
  Thr: TThread;
begin
  { Indexacao (TReadFileThread/MMF), filtro, busca e FSourceFileStream impedem rename do original. }
  TfrmSmoothLoading.RequestCancel;
  WaitForActiveIndexReadThread;
  if Assigned(FFilterThread) then
  begin
    Thr := FFilterThread;
    FFilterThread := nil;
    Thr.Terminate;
    try
      Thr.WaitFor;
    except
    end;
    Thr.Free;
  end;
  if Assigned(FFindThread) then
  begin
    Thr := FFindThread;
    FFindThread := nil;
    Thr.Terminate;
    try
      Thr.WaitFor;
    except
    end;
    Thr.Free;
  end;
  StopScriptEngineProcess;
  StopConsumerAIProcess;
  StopConsumerRAGProcess;
  CloseFileStreams;
  Application.ProcessMessages;
  for I := 1 to 100 do
  begin
    if not Assigned(frmSmoothLoading) then Break;
    Application.ProcessMessages;
    Sleep(50);
  end;
  TfrmSmoothLoading.ResetCancel;
  Sleep(100);
end;

procedure TfrmMain.CloseSourceHandlesForRename;
var
  I: Integer;
begin
  { Rename apos Replace: streams UI; IA/RAG ja parados em BeginHeavyFileMutate. }
  CloseFileStreams;
  InvalidateOpenFileDiskSnapshot;
  Application.ProcessMessages;
  for I := 1 to 12 do
  begin
    Application.ProcessMessages;
    Sleep(25);
  end;
end;

{ Delphi 7: TFileStream.Seek(Longint) trunca >2 GB — implementacao em UnUtils. }
procedure FileStreamSeek64(const AStream: TFileStream; const AOffset: Int64; Origin: Word);
begin
  UnUtils.FileStreamSeek64(AStream, AOffset, Origin);
end;

function TfrmMain.GetLineContent(LineIndex: Integer): String;
var
  DummyTrail: AnsiString;
begin
  Result := GetLineContent(LineIndex, DummyTrail);
end;

function TfrmMain.GetLineContent(LineIndex: Integer; out ATrailingLineBreaks: AnsiString): String;
var
  StartOffset, EndOffset: Int64;
  FullLineLen: Int64;
  LineLength: Integer;
  Buffer: AnsiString;
  OffsetBuf: array[0..39] of AnsiChar; // room for 2 index records (18+2 each)
  BytesRead2: Integer;
  IdxPos: Int64;
  ReadCount: Integer;
  // Sparse path
  CkptIdx: Int64;
  SkipCount: Integer;
  ScanBuf: array[0..262143] of Byte;  // 256KB buffer (4� faster than 64KB for sparse scan)
  ScanRead, ScanI: Integer;
  ScanRemaining: Integer;
  ScanPos: Int64;
  ScanDone: Boolean;

  function ReadOffset18FromStream(AStream: TFileStream; ABytePos: Int64): Int64;
  var
    Tmp: array[0..17] of AnsiChar;
    TmpStr: AnsiString;
    N: Integer;
  begin
    Result := -1;
    FileStreamSeek64(AStream, ABytePos, Word(soFromBeginning));
    N := AStream.Read(Tmp, 18);
    if N < 18 then Exit;
    SetString(TmpStr, PAnsiChar(@Tmp[0]), 18);
    Result := StrToInt64Def(Trim(string(TmpStr)), -1);
  end;

begin
  Result := '';
  ATrailingLineBreaks := '';
  if not Assigned(FSourceFileStream) then Exit;

  try
    { Zero Scan proporcional: prioridade sobre temp.txt/ckpt (evita SubItems vazios). }
    if UsesProportionalZeroScanScroll then
    begin
      EnsureZeroScanBytesPerItemInitialized;
      if (LineIndex >= 0) and (LineIndex < 65536) and
         TryReadPhysicalLineBounds0(LineIndex, StartOffset, EndOffset) then
      begin
        Result := ReadLineTextFromSourceOffsets(StartOffset, EndOffset);
        Exit;
      end;
      if TryResolveZeroScanExactLineBoundsFromStart(LineIndex, StartOffset, EndOffset) then
      begin
        Result := ReadLineTextFromSourceOffsets(StartOffset, EndOffset);
        Exit;
      end;
      if (FZeroScanBytesPerItem > 0) and
         (Int64(LineIndex) * FZeroScanBytesPerItem >= SourceFileSize64) then
      begin
        if SourceFileSize64 <= 0 then
          Exit;
        LineIndex := (SourceFileSize64 - 1) div FZeroScanBytesPerItem;
        if LineIndex < 0 then
          LineIndex := 0;
      end;
      CkptIdx := Int64(LineIndex) * FZeroScanBytesPerItem;
      if CkptIdx >= SourceFileSize64 then
        CkptIdx := SourceFileSize64 - 1;
      if CkptIdx < 0 then
        CkptIdx := 0;

      SkipCount := 4096;
      if CkptIdx - SkipCount < 0 then SkipCount := CkptIdx;

      StartOffset := 1;
      if SkipCount > 0 then
      begin
        FileStreamSeek64(FSourceFileStream,CkptIdx - SkipCount, Word(soFromBeginning));
        ScanRead := FSourceFileStream.Read(ScanBuf, SkipCount);
        for ScanI := ScanRead - 1 downto 0 do
        begin
          if ScanBuf[ScanI] = FSourceLineTermByte then
          begin
            StartOffset := (CkptIdx - SkipCount) + ScanI + 2;
            Break;
          end;
        end;
      end;

      ScanPos := StartOffset - 1;
      FileStreamSeek64(FSourceFileStream,ScanPos, Word(soFromBeginning));
      EndOffset := SourceFileSize64 + 1;
      ScanDone := False;
      while not ScanDone do
      begin
        ScanRead := FSourceFileStream.Read(ScanBuf, SizeOf(ScanBuf));
        if ScanRead = 0 then Break;
        for ScanI := 0 to ScanRead - 1 do
        begin
          Inc(ScanPos);
          if ScanBuf[ScanI] = FSourceLineTermByte then
          begin
            EndOffset := ScanPos + 1;
            ScanDone := True;
            Break;
          end;
        end;
      end;
      Result := ReadLineTextFromSourceOffsets(StartOffset, EndOffset);
      Exit;
    end
    else if Assigned(FIndexFileStream) then
    begin
      { ---- Dense path (standard behaviour) ---- }
      IdxPos := Int64(LineIndex) * INDEX_RECORD_SIZE;
      FileStreamSeek64(FIndexFileStream,IdxPos, Word(soFromBeginning));
      ReadCount := FIndexFileStream.Read(OffsetBuf, INDEX_RECORD_SIZE * 2);
      if ReadCount < 18 then Exit;

      SetString(Buffer, PAnsiChar(@OffsetBuf[0]), 18);
      StartOffset := StrToInt64Def(Trim(string(Buffer)), -1);
      if StartOffset = -1 then Exit;
      StartOffset := Abs(StartOffset);

      if ReadCount >= (INDEX_RECORD_SIZE + 18) then
      begin
        SetString(Buffer, PAnsiChar(@OffsetBuf[INDEX_RECORD_SIZE]), 18);
        EndOffset := StrToInt64Def(Trim(string(Buffer)), SourceFileSize64 + 1);
      end
      else
        EndOffset := SourceFileSize64 + 1;
      EndOffset := Abs(EndOffset);
    end
    else if Assigned(FCkptFileStream) then
    begin
      { ---- Sparse path: resolve offset via checkpoint + forward scan ----
        FCkptFileStream holds one 20-byte entry every CKPT_INTERVAL lines.
        Entry k = 1-based byte offset of line k * CKPT_INTERVAL. }
      CkptIdx   := Int64(LineIndex) div CKPT_INTERVAL;
      SkipCount := LineIndex mod CKPT_INTERVAL;

      StartOffset := ReadOffset18FromStream(FCkptFileStream, CkptIdx * INDEX_RECORD_SIZE);
      if StartOffset <= 0 then Exit;
      StartOffset := Abs(StartOffset);

      { Scan forward SkipCount newlines to reach the target line's start. }
      if SkipCount > 0 then
      begin
        ScanRemaining := SkipCount;
        ScanPos := StartOffset - 1;  { convert to 0-based }
        FileStreamSeek64(FSourceFileStream,ScanPos, Word(soFromBeginning));
        while ScanRemaining > 0 do
        begin
          ScanRead := FSourceFileStream.Read(ScanBuf, SizeOf(ScanBuf));
          if ScanRead = 0 then Break;
          for ScanI := 0 to ScanRead - 1 do
          begin
            Inc(ScanPos);
            if ScanBuf[ScanI] = FSourceLineTermByte then
            begin
              Dec(ScanRemaining);
              if ScanRemaining = 0 then Break;
            end;
          end;
        end;
        StartOffset := ScanPos + 1;  { back to 1-based }
      end;

      { Scan one more newline to find end of the target line. }
      ScanPos  := StartOffset - 1;
      EndOffset := SourceFileSize64 + 1;
      FileStreamSeek64(FSourceFileStream,ScanPos, Word(soFromBeginning));
      ScanDone := False;
      while not ScanDone do
      begin
        ScanRead := FSourceFileStream.Read(ScanBuf, SizeOf(ScanBuf));
        if ScanRead = 0 then Break;
        for ScanI := 0 to ScanRead - 1 do
        begin
          Inc(ScanPos);
          if ScanBuf[ScanI] = FSourceLineTermByte then
          begin
            EndOffset := ScanPos + 1;
            ScanDone := True;
            Break;
          end;
        end;
      end;
    end
    else
      Exit;  { no index available }

    FullLineLen := EndOffset - StartOffset;
    if FullLineLen <= 0 then Exit;
    if FullLineLen > MAX_LINE_LEN_DISPLAY then
      LineLength := MAX_LINE_LEN_DISPLAY
    else
      LineLength := FullLineLen;

    FileStreamSeek64(FSourceFileStream,StartOffset - 1, Word(soFromBeginning));
    SetLength(Buffer, LineLength);
    BytesRead2 := FSourceFileStream.Read(Pointer(Buffer)^, LineLength);

    ATrailingLineBreaks := '';
    while (BytesRead2 > 0) and (Buffer[BytesRead2] in [#10, #13]) do
    begin
      ATrailingLineBreaks := Buffer[BytesRead2] + ATrailingLineBreaks;
      Dec(BytesRead2);
    end;

    SetLength(Buffer, BytesRead2);
    Result := DisplayTextFromFileBytes(Buffer, EffectiveDisplayEncoding);
    if FullLineLen > MAX_LINE_LEN_DISPLAY then
      Result := Result + ' ' + Format(TrText('[Line preview limited to %s bytes for performance; file line total %s bytes.]'),
        [UnUtils.FormatNumber(MAX_LINE_LEN_DISPLAY), UnUtils.FormatNumber(FullLineLen)]);
  except
    Result := '';
    ATrailingLineBreaks := '';
  end;
end;

procedure TfrmMain.ReopenFileStreamsOnly(const AFileName: String;
  const AOpenLineIndexFiles: Boolean);
var
  IndexFileName, CkptFileName: String;
begin
  if TfrmSmoothLoading.HeavyFileMutateHoldActive then
    Exit;
  if Assigned(FSourceFileStream) then FreeAndNil(FSourceFileStream);
  if Assigned(FIndexFileStream) then FreeAndNil(FIndexFileStream);
  if Assigned(FCkptFileStream) then FreeAndNil(FCkptFileStream);
  if not FileExists(AFileName) then Exit;
  IndexFileName := FastFileExeDirPath(TEMPFILE);
  CkptFileName := FastFileExeDirPath(TEMP_CKPT_FILE);
  FSourceFileSize := 0;
  try
    FSourceFileStream := TFileStream.Create(AFileName, fmOpenRead or fmShareDenyNone);
    FSourceFileSize := UnUtils.GetFileSize(AFileName);
    FSourceLineTermByte := LineTermByteForFile(AFileName);
    if AOpenLineIndexFiles then
    begin
      if FileExists(IndexFileName) then
        FIndexFileStream := TFileStream.Create(IndexFileName, fmOpenRead or fmShareDenyNone);
      if FileExists(CkptFileName) then
        FCkptFileStream := TFileStream.Create(CkptFileName, fmOpenRead or fmShareDenyNone);
    end;
  except
    CloseFileStreams;
  end;
end;

procedure TfrmMain.OpenFileStreams(const AFileName: String;
  const AOpenLineIndexFiles: Boolean);
begin
  CloseFileStreams;
  ReopenFileStreamsOnly(AFileName, AOpenLineIndexFiles);
end;

procedure TfrmMain.DeleteDenseIndexIfNeeded(AShouldDelete: Boolean);
var
  IndexFileName: String;
  RetryCount: Integer;
begin
  if not AShouldDelete then Exit;
  
  IndexFileName := FastFileExeDirPath(TEMPFILE);
  if not FileExists(IndexFileName) then Exit;
  
  { Close the dense index stream if it's open }
  if Assigned(FIndexFileStream) then
  begin
    FreeAndNil(FIndexFileStream);
    { Application will use sparse checkpoint + scan for ultra-large files }
  end;
  
  { Try to delete temp.txt; retry a few times if file is still locked }
  for RetryCount := 1 to 3 do
  begin
    if DeleteFile(IndexFileName) then Exit;
    Sleep(100);
  end;
end;

procedure TfrmMain.UpdateProgressiveLineCount(const ALineCount: Int64);
begin
  if ALineCount > totalLines then
  begin
    totalLines := ALineCount;
    ItemCount := totalLines;
    if totalLines < 10000000 then ListView1.Items.Count := totalLines;
    if ListView1.TopItem = nil then ListView1.Refresh;
  end;
end;

procedure TfrmMain.StartInstantOpen(const AFileName: string);
begin
  fFileName := AFileName;
  edtFileName.Text := fFileName;
  OpenFileStreams(fFileName);
  FDetectedEncoding := DetectFileEncoding(fFileName);
  FDetectedEol := DetectLineEndingFromFile(fFileName);
  ClearUndoRedo;
  ClearAllBookmarks;
  totalLines := 0;
  ItemCount := 0;
  ListView1.Items.Count := 0;
  ListView1.Refresh;
  UpdateInfoPanels;
end;

function TfrmMain.getLineContentsFromLineIndex(
  const iLine: int64): string;
var
  CacheIdx: Integer;
  StartOff, EndOff: Int64;
begin
  // Try page cache first (avoids repeated file seeks for same page)
  CacheIdx := Integer(iLine - FCacheOffset);
  if (FCacheCount > 0) and (CacheIdx >= 0) and (CacheIdx < FCacheCount) and (CacheIdx < Length(FCacheLines)) then
    Result := FCacheLines[CacheIdx]
  else
    Result := GetLineContent(Integer(iLine));
  if (Result = '') and UsesProportionalZeroScanScroll and Assigned(FSourceFileStream) and
     (iLine >= 0) and (iLine < 65536) and
     TryReadPhysicalLineBounds0(iLine, StartOff, EndOff) then
    Result := ReadLineTextFromSourceOffsets(StartOff, EndOff);
  if (not FFastVisualWordWrap) and (ScrollBarHorizontal.Position > 1) then
    Result := Copy(Result, ScrollBarHorizontal.Position, Length(Result));
end;

function TfrmMain.BuildLineTextForMarksDisplay(const LineIdx: Integer): string;
var
  Trail: AnsiString;
begin
  Result := GetLineContent(LineIdx, Trail);
  if Trail <> '' then
    Result := Result + string(Trail);
end;

function TfrmMain.StripTrailingLineBreaks(const S: string): string;
var
  L: Integer;
begin
  L := Length(S);
  while (L > 0) and (S[L] in [#13, #10]) do
    Dec(L);
  Result := Copy(S, 1, L);
end;

function TfrmMain.ExtractTrailingLineBreaks(const S: string): string;
var
  L, Start: Integer;
begin
  L := Length(S);
  Start := L;
  while (Start > 0) and (S[Start] in [#13, #10]) do
    Dec(Start);
  Result := Copy(S, Start + 1, MaxInt);
end;

procedure TfrmMain.ListView1Data(Sender: TObject; Item: TListItem);
var
  Index: Int64;
  RealLine: Int64;
  LineContent: string;
  S_WW: AnsiString;
  Cells: TStringList;
  I: Integer;
  LinePrefix: string;
begin
  if not Assigned(FSourceFileStream) then Exit;

  LinePrefix := FTrLinePrefix;
  if LinePrefix = '' then
    LinePrefix := TrText('Line:');

  // Pre-populate page cache on first item request for this page
  if (not FFilterActive) and (Item.Index = 0) then
    EnsureLineCacheForPage;

  if FFilterActive then
  begin
    RealLine := FilteredIndexToReal(Item.Index);
    if RealLine < 0 then Exit;
    Index := RealLine + 1;
  end
  else
  begin
    Index := Offset + (Item.Index + 1) + CsvDataStartLine;
    RealLine := Item.Index;
  end;

  { Sem Zero Scan: nao inventar legendas "Line: N" alem do total real (OwnerData
    preenche VisibleItems mesmo com ficheiro curto). }
  if (not FFilterActive) and (not UsesProportionalZeroScanScroll) and
     (totalLines > 0) and (Index > totalLines) then
  begin
    Item.Caption := '';
    if Item.SubItems.Count = 0 then
      Item.SubItems.Add('')
    else
      Item.SubItems[0] := '';
    Item.ImageIndex := -1;
    Exit;
  end;

  // Pre-build line content and caption in one go
  LineContent := getLineContentsFromLineIndex(Index - 1);
  { Marcas: texto bruto em SubItems; cores/símbolos no owner-draw (ListView1AdvancedCustomDrawSubItem). }

  if FCsvMode and (FCsvColumnCount > 0) then
  begin
    Item.Caption := LinePrefix + ' ' + FormatFloat('#,', Index);
    Cells := TStringList.Create;
    try
      ParseDelimitedLine(LineContent, FCsvDelimiter, Cells);
      while Item.SubItems.Count < FCsvColumnCount do
        Item.SubItems.Add('');
      while Item.SubItems.Count > FCsvColumnCount do
        Item.SubItems.Delete(Item.SubItems.Count - 1);
      for I := 0 to FCsvColumnCount - 1 do
      begin
        if I < Cells.Count then
          Item.SubItems[I] := Cells[I]
        else
          Item.SubItems[I] := '';
      end;
    finally
      Cells.Free;
    end;
    Item.ImageIndex := -1;
    Exit;
  end;

  if (not FFastVisualWordWrap) and FastWordWrapAtivo and Assigned(FIndexFileStream) then
  begin
    FileStreamSeek64(FIndexFileStream,Int64(Index - 1) * 20, Word(soFromBeginning));
    SetLength(S_WW, 18);
    FIndexFileStream.Read(Pointer(S_WW)^, 18);
    if StrToInt64Def(Trim(string(S_WW)), 0) < 0 then
      Item.Caption := ''
    else
      Item.Caption := LinePrefix + ' ' + FormatFloat('#,', Index);
    if Item.SubItems.Count = 0 then
      Item.SubItems.Add(LineContent)
    else
      Item.SubItems[0] := LineContent;
  end
  else
  begin
    Item.Caption := LinePrefix + ' ' + FormatFloat('#,', Index);
    if Item.SubItems.Count = 0 then
      Item.SubItems.Add(LineContent)
    else
      Item.SubItems[0] := LineContent;
  end;

  { Altura da linha no modo wrap visual: ListView usa altura do SmallImages }
  if FFastVisualWordWrap then
    Item.ImageIndex := 0
  else
    Item.ImageIndex := -1;
end;

procedure TfrmMain.ApplyMainFileListWheel(const WheelDelta: Integer);
var
  i: Integer;
  ScrollCode: TScrollCode;
  SBCode: Word;
begin
  if FIsDragging or FLineAutofillDragging
    or (GetCapture <> 0)
    or (GetKeyState(VK_LBUTTON) < 0)
    or (GetKeyState(VK_MENU) < 0) then
    Exit;
  { Select (checkbox): scroll via Offset/barra mesmo com ListView oculta / Count=0. }
  if isChecked then
  begin
    if not Assigned(FCheckListBox) then Exit;
    if FFilterActive and (FFilteredCount <= 0) then Exit;
  end
  else if (not Assigned(ListView1)) or (ListView1.Items.Count = 0) then
    Exit;

  if WheelDelta < 0 then
  begin
    ScrollCode := scLineDown;
    SBCode := SB_LINEDOWN;
  end
  else
  begin
    ScrollCode := scLineUp;
    SBCode := SB_LINEUP;
  end;
  { Filtro + ListView: Items.Count = hits; barra externa esta desligada — rolar a ListView nativa. }
  if FFilterActive and (not isChecked) then
  begin
    if not ListView1.HandleAllocated then Exit;
    for i := 1 to 3 do
      ListView1.Perform(WM_VSCROLL, SBCode, 0);
    Exit;
  end;
  { Owner-data / Select: barra externa (Offset). Com filtro+Select, Max = FFilteredCount. }
  Inc(FVerticalScrollBatchDepth);
  try
    for i := 1 to 3 do
      ScrollBarVerticalScroll(Self, ScrollCode, fScrollPos);
  finally
    Dec(FVerticalScrollBatchDepth);
    if isChecked and (FVerticalScrollBatchDepth = 0) then
      QueueCheckListScrollRefresh;
  end;
end;

procedure TfrmMain.FormMouseWheel(Sender: TObject; Shift: TShiftState; WheelDelta: Integer; MousePos: TPoint; var Handled: Boolean);
var
  P: TPoint;
begin
  { Side chats (RAG / SQL / Assistant / Script): scroll the panel under the mouse. }
  if PointInSideChatPanels(MousePos) then
  begin
    if TryScrollSideChatWheel(WindowFromPoint(MousePos), MousePos, WheelDelta) then
      Handled := True
    else
      Handled := False;
    Exit;
  end;

  { Script panels: do not hijack wheel to ListView; let focused control handle it. }
  if Assigned(FScriptSuggestionsPanel) and FScriptSuggestionsPanel.Visible then
  begin
    P := FScriptSuggestionsPanel.ScreenToClient(MousePos);
    if PtInRect(FScriptSuggestionsPanel.ClientRect, P) then
    begin
      Handled := False;
      Exit;
    end;
  end;
  if Assigned(FScriptEnginePanel) and FScriptEnginePanel.Visible then
  begin
    P := FScriptEnginePanel.ScreenToClient(MousePos);
    if PtInRect(FScriptEnginePanel.ClientRect, P) then
    begin
      Handled := False;
      Exit;
    end;
  end;

  { Ctrl + roda: zoom na fonte da lista (comportamento D7). }
  if (((ssCtrl in Shift) or (GetKeyState(VK_CONTROL) < 0)) and
      not ((ssAlt in Shift) or (GetKeyState(VK_MENU) < 0))) then
  begin
    { ListView: hook WM_MOUSEWHEEL ja trata — evitar fila duplicada / flicker. }
    if Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      P := ListView1.ScreenToClient(MousePos);
      if PtInRect(ListView1.ClientRect, P) then
      begin
        Handled := True;
        Exit;
      end;
    end;
    { Checklist Select: zoom via fila (DoMouseWheel pode nao ser chamado). }
    if isChecked and Assigned(FCheckListBox) and FCheckListBox.Visible and FCheckListBox.HandleAllocated then
    begin
      P := FCheckListBox.ScreenToClient(MousePos);
      if PtInRect(FCheckListBox.ClientRect, P) then
      begin
        ApplyListViewWheelZoom(WheelDelta);
        Handled := True;
        Exit;
      end;
    end;
    { Ctrl+wheel noutra area da tab Read: zoom (ex. margem ao lado da lista). }
    if Assigned(ListView1) then
    begin
      ApplyListViewWheelZoom(WheelDelta);
      Handled := True;
      Exit;
    end;
  end;

  { Select mode: allow wheel even when ListView Items.Count is stale/zero. }
  if isChecked and Assigned(FCheckListBox) then
  begin
    ApplyMainFileListWheel(WheelDelta);
    Handled := True;
    Exit;
  end;

  if (not Assigned(ListView1)) or (ListView1.Items.Count = 0) then
    Exit;

  ApplyMainFileListWheel(WheelDelta);
  Handled := True;
end;




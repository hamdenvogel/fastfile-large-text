procedure TfrmMain.RelayoutMainPages(AAllPages: Boolean);
var
  I: Integer;
begin
  if not Assigned(pgMain) then Exit;
  pgMain.Realign;
  if AAllPages then
  begin
    for I := 0 to pgMain.PageCount - 1 do
      pgMain.Pages[I].Realign;
  end
  else if Assigned(pgMain.ActivePage) then
    pgMain.ActivePage.Realign;
end;

procedure TfrmMain.AdaptUiToDisplay(ARelayoutAssistant: Boolean);
begin
  FfRelaxMinConstraints(Self);
  if WindowState <> wsMaximized then
    FfFitFormToWorkArea(Self);
  if Assigned(sStatusBar1) and (sStatusBar1.Panels.Count > 9) then
  begin
    if sStatusBar1.Height < FfPx(28) then
      sStatusBar1.Height := FfPx(28);
    LayoutStatusBarPanels;
  end;
  AdaptSidePanelsToClient;
  FormResize(Self);
  if ARelayoutAssistant and FastFileAssistantPanelVisible then
    RelayoutFastFileAssistantAfterDock;
end;

procedure TfrmMain.AdaptSidePanelsToClient;
var
  MinList, Used, Excess, MinP: Integer;

  procedure Acc(P: TControl);
  begin
    if Assigned(P) and P.Visible then
      Inc(Used, P.Width);
  end;

  procedure Shrink(P: TControl; AMin: Integer);
  var
    Cut: Integer;
  begin
    if Excess <= 0 then Exit;
    if not Assigned(P) or not P.Visible then Exit;
    if P.Width <= AMin then Exit;
    Cut := P.Width - AMin;
    if Cut > Excess then
      Cut := Excess;
    P.Width := P.Width - Cut;
    Dec(Excess, Cut);
  end;

begin
  MinList := FfPx(300);
  Used := 0;
  Acc(FAssistantPanel);
  Acc(FAssistantSplitter);
  Acc(FScriptEnginePanel);
  Acc(FScriptSuggestionsPanel);
  Acc(splListview);
  Acc(FConsumerAIPanel);
  Acc(FConsumerRAGPanel);
  Acc(FTailMacroPanel);
  Acc(FTailMacroSuggestionsPanel);
  if Used + MinList <= ClientWidth then Exit;
  Excess := Used + MinList - ClientWidth;
  MinP := FfPx(220);
  Shrink(FScriptSuggestionsPanel, MinP);
  Shrink(FTailMacroSuggestionsPanel, MinP);
  Shrink(FConsumerRAGPanel, MinP);
  Shrink(FConsumerAIPanel, MinP);
  Shrink(FScriptEnginePanel, MinP);
  Shrink(FTailMacroPanel, MinP);
  Shrink(FAssistantPanel, FfPx(240));
end;


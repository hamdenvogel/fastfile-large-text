  end;
  if Assigned(Frm.LblRegexAiBanner) and Assigned(Frm.BtnRegexAiBannerDismiss) then
  begin
    Frm.LblRegexAiBanner.Left := M;
    Frm.LblRegexAiBanner.Top := Frm.FSplitPatternMemoAnchorY + 2;
    Frm.LblRegexAiBanner.Width := Max(80, Frm.BtnRegexAiBannerDismiss.Left - 8 - M);
  end;

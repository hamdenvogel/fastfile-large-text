    FToolsExtrasTail.Caption := TrText('Tail / &Follow mode');
  if Assigned(FToolsExtrasTailPause) then
    FToolsExtrasTailPause.Caption := TrText('&Pause / Resume follow');
  if Assigned(FToolsExtrasTailMacroReprocess) then
    FToolsExtrasTailMacroReprocess.Caption := TrText('Tail macro - reprocess new lines');
  if Assigned(FToolsExtrasFilter) then
    FToolsExtrasFilter.Caption := TrText('Fil&ter / Grep');
  if Assigned(FToolsExtrasExportFiltered) then
    FToolsExtrasExportFiltered.Caption := TrText('E&xport tail / filtered lines');
  if Assigned(FToolsExtrasToggleBookmark) then
    FToolsExtrasToggleBookmark.Caption := TrText('&Toggle bookmark');
  if Assigned(FToolsExtrasNextBookmark) then
    FToolsExtrasNextBookmark.Caption := TrText('&Next bookmark');
  if Assigned(FToolsExtrasPrevBookmark) then
    FToolsExtrasPrevBookmark.Caption := TrText('Pr&evious bookmark');
  if Assigned(FToolsExtrasClearBookmarks) then
    FToolsExtrasClearBookmarks.Caption := TrText('Clear a&ll bookmarks');
  if Assigned(FFilterBar) then
    FFilterBar.ApplyCaptions;
  if Assigned(FFindOccBar) then
  begin
    FFindOccBar.ApplyCaptions;
    RefreshFindOccBarState;
  end;
  if Assigned(FFindOccPeek) then
    FFindOccPeek.ApplySoftChrome;
  ApplyListViewLineToolCaptions;
  if Assigned(FFilterPeek) then
    FFilterPeek.ApplySoftChrome;
  if Assigned(FAssistantFloat) then
    FAssistantFloat.Caption := TrText('Assistant.Title');
  if Assigned(FFilterFloat) then
    FFilterFloat.Caption := TrText('Filter / Grep');
  if Assigned(FFindOccFloat) then
    FFindOccFloat.Caption := TrText('FindOcc.Title');
  if Assigned(FBookmarkBar) then
  begin
    FBookmarkBar.ApplyCaptions;
    RefreshBookmarkBarList;
  end;
  if Assigned(FBookmarkPeek) then
    FBookmarkPeek.ApplySoftChrome;
  if Assigned(FBookmarkFloat) then
    FBookmarkFloat.Caption := TrText('BookmarkBar.Title');
  LocalizeFileSearchGallery;
  ApplyReadViewFloatCaptions;
  if Assigned(FFilterSplitter) then
    FFilterSplitter.Hint := TrText('FilterBar.ResizeHint');
  if Assigned(FAssistantSplitter) then
    FAssistantSplitter.Hint := TrText('Assistant.ResizeHint');
end;

function TfrmMain.MenuIconIndex(const AFileName: string; const AFallbackIndex: Integer = -1): Integer;
begin
  Result := AFallbackIndex;
  if Assigned(FMenuIconIndexByName) then
    Result := StrToIntDef(FMenuIconIndexByName.Values[LowerCase(AFileName)], AFallbackIndex);
end;


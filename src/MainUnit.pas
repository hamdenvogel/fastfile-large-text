procedure TfrmMain.SyncListViewViewportAfterFileLoad;
begin
  { Owner-data ListView: Items.Count = visible rows only; Offset maps to totalLines. }
  if Assigned(ListView1) then
  begin
    if not Assigned(ListView1.OnData) then
      ListView1.OnData := ListView1Data;
    ListView1Resize(ListView1);
  end;
  Offset := 0;
  fScrollPos := 0;
  if Assigned(ScrollBarVertical) then
  begin
    SafeSetScrollBarPosition(ScrollBarVertical, 0);
    SyncVerticalScrollBarRange;
  end;
  if Assigned(ScrollBarHorizontal) then
    ScrollBarHorizontal.Position := 0;
  InvalidateLineCache;
  if isChecked and Assigned(FCheckListBox) then
  begin
    FCheckListDisplayOffset := -1;
    SyncSelectModeListViewHeader;
    RefreshCheckListViewport(True);
  end
  else if Assigned(ListView1) then
    ListView1.Invalidate;
end;

procedure TfrmMain.SyncReadViewUiAfterFileLoad;
begin
  { F5 / Instant Open (FFreshFileRead): EndRead nao corria — ListView ficava sem linhas visiveis. }
  UnUtils.ActionComponent([ListView1, ScrollBarVertical, ScrollBarHorizontal], acVisible);
  UnUtils.ActionComponent([btnRead, btnClear, btnDeleteLines, btnSplitFiles, btnMergeMultipleLines,
    btnCheckBoxes, btnExport, btnEditFile], acEnabled);
  if Assigned(FBtnTopExport) then
    FBtnTopExport.Enabled := True;
  if Assigned(FBtnTopFileOptions) then
    FBtnTopFileOptions.Enabled := True;
  if Assigned(ListView1) then
  begin
    SyncSelectModeListViewHeader;
    if not Assigned(ListView1.OnData) then
      ListView1.OnData := ListView1Data;
    if not isChecked then
      ListView1Resize(ListView1)
    else
      ListView1.Invalidate;
  end;
  if isChecked then
    showChecked;
end;

procedure TfrmMain.EndRead;
begin
  UnUtils.ActionComponent([ListView1, ScrollBarVertical, ScrollBarHorizontal], acVisible);
  UnUtils.ActionComponent([btnRead, btnClear, btnDeleteLines, btnSplitFiles, btnMergeMultipleLines, btnCheckBoxes, btnExport, btnEditFile], acEnabled);
  if Assigned(FBtnTopExport) then
    FBtnTopExport.Enabled := True;
  if Assigned(FBtnTopFileOptions) then
    FBtnTopFileOptions.Enabled := True;
  ItemCount := totalLines;
  //ListView1.Items.Count := ItemCount;
  isChecked := False;
  FCheckListDisplayOffset := -1;
  isAllChecked := False;
  SafeSetScrollBarPosition(ScrollBarVertical, 0);
  ScrollBarVerticalChange(Self);
  fScrollPos := 0;
  ScrollBarVerticalScroll(self, scPosition, fScrollPos);
  ScrollBarHorizontal.Position := 0;
  RestoreCsvModeAfterPostEdit;
  LoadCurrentSession;
  UpdateInfoPanels;
  ApplySessionReadOnlyUi;
end;


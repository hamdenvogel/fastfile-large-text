function IdleLogoBitmapHasRealAlpha(const Bmp: TBitmap): Boolean;
var
  X, Y, W, H, MinA, MaxA, ZeroCount: Integer;
  P: PRGBQuad;
begin
  Result := False;
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  W := Bmp.Width;
  H := Bmp.Height;
  MinA := 255;
  MaxA := 0;
  ZeroCount := 0;
  for Y := 0 to H - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to W - 1 do
    begin
      if P^.rgbReserved < MinA then MinA := P^.rgbReserved;
      if P^.rgbReserved > MaxA then MaxA := P^.rgbReserved;
      if P^.rgbReserved < 8 then Inc(ZeroCount);
      Inc(P);
    end;
  end;
  Result := (MaxA - MinA > 32) and (ZeroCount > ((W * H) div 80));
end;

procedure DetectIdleLogoBorderBackground(const Bmp: TBitmap; out BgR, BgG, BgB: Integer);
var
  X, Y, W, H, N, SR, SG, SB: Integer;
  P: PRGBQuad;

  procedure SamplePixel(AP: PRGBQuad);
  begin
    Inc(SR, AP^.rgbRed);
    Inc(SG, AP^.rgbGreen);
    Inc(SB, AP^.rgbBlue);
    Inc(N);
  end;

begin
  BgR := 240;
  BgG := 240;
  BgB := 240;
  if not Assigned(Bmp) or (Bmp.Width < 2) or (Bmp.Height < 2) then Exit;
  W := Bmp.Width;
  H := Bmp.Height;
  N := 0;
  SR := 0;
  SG := 0;
  SB := 0;
  for X := 0 to W - 1 do
  begin
    P := Bmp.ScanLine[0];
    Inc(P, X);
    SamplePixel(P);
    P := Bmp.ScanLine[H - 1];
    Inc(P, X);
    SamplePixel(P);
  end;
  for Y := 1 to H - 2 do
  begin
    P := Bmp.ScanLine[Y];
    SamplePixel(P);
    Inc(P, W - 1);
    SamplePixel(P);
  end;
  if N > 0 then
  begin
    BgR := SR div N;
    BgG := SG div N;
    BgB := SB div N;
  end;
end;

function IdleLogoColorDistSq(const R, G, B, BgR, BgG, BgB: Integer): Integer;
begin
  Result := Sqr(R - BgR) + Sqr(G - BgG) + Sqr(B - BgB);
end;

function IdleLogoIsFlatBrightPixel(const R, G, B: Integer): Boolean;
var
  MaxC, MinC: Integer;
begin
  MaxC := R;
  if G > MaxC then MaxC := G;
  if B > MaxC then MaxC := B;
  MinC := R;
  if G < MinC then MinC := G;
  if B < MinC then MinC := B;
  { Apenas cinzas/brancos neutros — não confundir ciano/teal claro dos anéis com fundo. }
  Result := (MaxC > 198) and ((MaxC - MinC) < 12)
    and (Abs(R - G) < 10) and (Abs(G - B) < 10) and (Abs(R - B) < 10);
end;

function IdleLogoIsBackgroundPixel(const R, G, B, BgR, BgG, BgB: Integer): Boolean;
var
  MaxC, MinC: Integer;
begin
  if IdleLogoIsFlatBrightPixel(R, G, B) then
  begin
    Result := True;
    Exit;
  end;
  if IdleLogoColorDistSq(R, G, B, BgR, BgG, BgB) <= 70 * 70 then
  begin
    Result := True;
    Exit;
  end;
  MaxC := R;
  if G > MaxC then MaxC := G;
  if B > MaxC then MaxC := B;
  MinC := R;
  if G < MinC then MinC := G;
  if B < MinC then MinC := B;
  Result := (MaxC - MinC < 16) and (IdleLogoColorDistSq(R, G, B, BgR, BgG, BgB) <= 95 * 95);
end;

function IdleLogoContentWeight(const R, G, B, BgR, BgG, BgB: Integer): Integer;
var
  MaxC, MinC, Lum, BgLum, Sat: Integer;
begin
  MaxC := R;
  if G > MaxC then MaxC := G;
  if B > MaxC then MaxC := B;
  MinC := R;
  if G < MinC then MinC := G;
  if B < MinC then MinC := B;
  Sat := MaxC - MinC;
  Lum := (R + G + B) div 3;
  BgLum := (BgR + BgG + BgB) div 3;
  Result := Sat * 3 + Abs(Lum - BgLum);
  if Result > 255 then
    Result := 255;
end;

procedure IdleLogoClearPixel(AP: PRGBQuad);
begin
  AP^.rgbReserved := 0;
  AP^.rgbRed := 0;
  AP^.rgbGreen := 0;
  AP^.rgbBlue := 0;
end;

procedure IdleLogoClearBitmapBorder(const Bmp: TBitmap; BorderPx: Integer);
var
  X, Y, W, H, B: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (BorderPx < 1) then Exit;
  Bmp.PixelFormat := pf32bit;
  W := Bmp.Width;
  H := Bmp.Height;
  if (W < BorderPx * 2 + 2) or (H < BorderPx * 2 + 2) then Exit;
  B := BorderPx;
  for Y := 0 to H - 1 do
  begin
    P := Bmp.ScanLine[Y];
    if (Y < B) or (Y >= H - B) then
    begin
      for X := 0 to W - 1 do
      begin
        IdleLogoClearPixel(P);
        Inc(P);
      end;
    end
    else
    begin
      for X := 0 to W - 1 do
      begin
        if (X < B) or (X >= W - B) then
          IdleLogoClearPixel(P);
        Inc(P);
      end;
    end;
  end;
end;

{ Meio-termo entre rev22 (escuro) e rev23 (cores 100% = azul muito claro). }
procedure IdleLogoSetWatermarkPixel(AP: PRGBQuad; const AR, AG, AB, SrcA: Integer);
var
  Lum, A, RR, GG, BB: Integer;
begin
  Lum := (AR + AG + AB) div 3;
  if (SrcA < 10) or (Lum < 30) then
  begin
    IdleLogoClearPixel(AP);
    Exit;
  end;
  RR := (AR * 85 + 28) div 100;
  GG := (AG * 86 + 32) div 100;
  BB := (AB * 87 + 36) div 100;
  if RR < 0 then RR := 0 else if RR > 255 then RR := 255;
  if GG < 0 then GG := 0 else if GG > 255 then GG := 255;
  if BB < 0 then BB := 0 else if BB > 255 then BB := 255;
  AP^.rgbRed := Byte(RR);
  AP^.rgbGreen := Byte(GG);
  AP^.rgbBlue := Byte(BB);
  A := (IDLE_LOGO_ALPHA * SrcA) div 255;
  if A > 255 then
    A := 255;
  AP^.rgbReserved := Byte(A);
end;

procedure FinalizeIdleLogoBitmap(const Bmp: TBitmap);
var
  X, Y: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      if P^.rgbReserved < 40 then
        IdleLogoClearPixel(P);
      Inc(P);
    end;
  end;
end;

procedure FloodClearIdleLogoBackground(const Bmp: TBitmap; BgR, BgG, BgB: Integer);
type
  TPt = record X, Y: Integer; end;
var
  W, H, QHead, QTail, X, Y, NX, NY, Idx: Integer;
  Visited: array of Byte;
  Queue: array of TPt;
  P: PRGBQuad;

  function BgMatchLoose(AR, AG, AB: Integer): Boolean;
  begin
    Result := IdleLogoIsFlatBrightPixel(AR, AG, AB)
      or (IdleLogoColorDistSq(AR, AG, AB, BgR, BgG, BgB) <= 65 * 65);
  end;

  procedure TryEnqueue(AX, AY: Integer);
  begin
    if (AX < 0) or (AY < 0) or (AX >= W) or (AY >= H) then Exit;
    Idx := AY * W + AX;
    if Visited[Idx] <> 0 then Exit;
    P := Bmp.ScanLine[AY];
    Inc(P, AX);
    if not BgMatchLoose(P^.rgbRed, P^.rgbGreen, P^.rgbBlue) then Exit;
    Visited[Idx] := 1;
    Queue[QTail].X := AX;
    Queue[QTail].Y := AY;
    Inc(QTail);
  end;

  procedure ClearPixel(AP: PRGBQuad);
  begin
    AP^.rgbReserved := 0;
    AP^.rgbRed := 0;
    AP^.rgbGreen := 0;
    AP^.rgbBlue := 0;
  end;

begin
  if not Assigned(Bmp) or (Bmp.Width < 2) or (Bmp.Height < 2) then Exit;
  W := Bmp.Width;
  H := Bmp.Height;
  SetLength(Visited, W * H);
  FillChar(Visited[0], W * H, 0);
  SetLength(Queue, W * H);
  QHead := 0;
  QTail := 0;
  for X := 0 to W - 1 do
  begin
    TryEnqueue(X, 0);
    TryEnqueue(X, H - 1);
  end;
  for Y := 1 to H - 2 do
  begin
    TryEnqueue(0, Y);
    TryEnqueue(W - 1, Y);
  end;
  while QHead < QTail do
  begin
    X := Queue[QHead].X;
    Y := Queue[QHead].Y;
    Inc(QHead);
    P := Bmp.ScanLine[Y];
    Inc(P, X);
    ClearPixel(P);
    TryEnqueue(X - 1, Y);
    TryEnqueue(X + 1, Y);
    TryEnqueue(X, Y - 1);
    TryEnqueue(X, Y + 1);
  end;
end;

procedure EraseIdleLogoStrictBackground(const Bmp: TBitmap; BgR, BgG, BgB: Integer);
var
  X, Y: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      if IdleLogoIsBackgroundPixel(P^.rgbRed, P^.rgbGreen, P^.rgbBlue, BgR, BgG, BgB) then
      begin
        P^.rgbReserved := 0;
        P^.rgbRed := 0;
        P^.rgbGreen := 0;
        P^.rgbBlue := 0;
      end;
      Inc(P);
    end;
  end;
end;

procedure CullIdleLogoFaintAlpha(const Bmp: TBitmap);
var
  X, Y: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      if P^.rgbReserved < 40 then
      begin
        P^.rgbReserved := 0;
        P^.rgbRed := 0;
        P^.rgbGreen := 0;
        P^.rgbBlue := 0;
      end;
      Inc(P);
    end;
  end;
end;

procedure TfrmMain.ApplyIdleLogoPngFade;
var
  X, Y: Integer;
  P: PRGBQuad;
begin
  if not IdleLogoBitmapReady then Exit;
  FIdleLogoBitmap.PixelFormat := pf32bit;
  for Y := 0 to FIdleLogoBitmap.Height - 1 do
  begin
    P := FIdleLogoBitmap.ScanLine[Y];
    for X := 0 to FIdleLogoBitmap.Width - 1 do
    begin
      if P^.rgbReserved > 0 then
        IdleLogoSetWatermarkPixel(P, P^.rgbRed, P^.rgbGreen, P^.rgbBlue, P^.rgbReserved)
      else
        IdleLogoClearPixel(P);
      Inc(P);
    end;
  end;
  CropIdleLogoToContent;
end;

procedure IdleLogoUpscaleSourceForSmoothArcs(const Bmp: TBitmap);
var
  CurMin, HiW, HiH: Integer;
  Scale: Double;
  HiRes: TBitmap;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  CurMin := Bmp.Width;
  if Bmp.Height < CurMin then
    CurMin := Bmp.Height;
  if CurMin >= IDLE_LOGO_SOURCE_MIN_PX then
    Exit;
  Scale := IDLE_LOGO_SOURCE_MIN_PX / CurMin;
  HiW := Round(Bmp.Width * Scale);
  HiH := Round(Bmp.Height * Scale);
  if HiW > IDLE_LOGO_SOURCE_MAX_PX then
  begin
    Scale := IDLE_LOGO_SOURCE_MAX_PX / Bmp.Width;
    HiW := IDLE_LOGO_SOURCE_MAX_PX;
    HiH := Round(Bmp.Height * Scale);
  end;
  if HiH > IDLE_LOGO_SOURCE_MAX_PX then
  begin
    Scale := IDLE_LOGO_SOURCE_MAX_PX / Bmp.Height;
    HiH := IDLE_LOGO_SOURCE_MAX_PX;
    HiW := Round(Bmp.Width * Scale);
  end;
  if (HiW = Bmp.Width) and (HiH = Bmp.Height) then
    Exit;
  HiRes := CreateBmp32(HiW, HiH);
  try
    HiRes.PixelFormat := pf32bit;
    Stretch(Bmp, HiRes, HiW, HiH, ftLanczos3);
    Bmp.Assign(HiRes);
    Bmp.PixelFormat := pf32bit;
  finally
    HiRes.Free;
  end;
end;

{ Remove halo retangular nas bordas do crop sem cortar arcos (alpha alto). }
procedure IdleLogoRemoveRectangularHalo(const Bmp: TBitmap; BorderPx, MaxHaloAlpha: Integer);
var
  X, Y, W, H, Dist, Alpha: Integer;
  P: PRGBQuad;
begin
  if not Assigned(Bmp) or (BorderPx < 1) then Exit;
  Bmp.PixelFormat := pf32bit;
  W := Bmp.Width;
  H := Bmp.Height;
  if (W < BorderPx * 2 + 2) or (H < BorderPx * 2 + 2) then Exit;
  for Y := 0 to H - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to W - 1 do
    begin
      Dist := X;
      if Y < Dist then Dist := Y;
      if W - 1 - X < Dist then Dist := W - 1 - X;
      if H - 1 - Y < Dist then Dist := H - 1 - Y;
      if Dist < BorderPx then
      begin
        Alpha := P^.rgbReserved;
        if (Alpha > 0) and (Alpha <= MaxHaloAlpha) then
          IdleLogoClearPixel(P);
      end;
      Inc(P);
    end;
  end;
end;

procedure TfrmMain.FinishIdleLogoBitmapProcessing;
var
  CurMin: Integer;
begin
  if not IdleLogoBitmapReady then Exit;
  CurMin := FIdleLogoBitmap.Width;
  if FIdleLogoBitmap.Height < CurMin then
    CurMin := FIdleLogoBitmap.Height;
  if CurMin < IDLE_LOGO_SOURCE_MIN_PX then
    IdleLogoUpscaleSourceForSmoothArcs(FIdleLogoBitmap);
  { Halo/trim só em PNG pequeno — em alta resolução cortam arcos nas bordas. }
  if CurMin < IDLE_LOGO_SOURCE_LORES_PX then
  begin
    IdleLogoRemoveRectangularHalo(FIdleLogoBitmap,
      IDLE_LOGO_HALO_BORDER_PX, IDLE_LOGO_HALO_MAX_ALPHA);
    TrimIdleLogoFaintEdges;
  end;
end;

procedure IdleCropBitmapToContent(const Bmp: TBitmap);
var
  MinX, MinY, MaxX, MaxY, X, Y, Pad, CW, CH: Integer;
  P: PRGBQuad;
  Crop: TBitmap;
begin
  if not Assigned(Bmp) or (Bmp.Width < 1) or (Bmp.Height < 1) then Exit;
  MinX := Bmp.Width;
  MinY := Bmp.Height;
  MaxX := -1;
  MaxY := -1;
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      if P^.rgbReserved > 28 then
      begin
        if X < MinX then MinX := X;
        if Y < MinY then MinY := Y;
        if X > MaxX then MaxX := X;
        if Y > MaxY then MaxY := Y;
      end;
      Inc(P);
    end;
  end;
  if MaxX < MinX then Exit;
  Pad := 12;
  if MinX > Pad then Dec(MinX, Pad) else MinX := 0;
  if MinY > Pad then Dec(MinY, Pad) else MinY := 0;
  if MaxX + Pad < Bmp.Width - 1 then
    Inc(MaxX, Pad)
  else
    MaxX := Bmp.Width - 1;
  if MaxY + Pad < Bmp.Height - 1 then
    Inc(MaxY, Pad)
  else
    MaxY := Bmp.Height - 1;
  CW := MaxX - MinX + 1;
  CH := MaxY - MinY + 1;
  if (CW >= Bmp.Width) and (CH >= Bmp.Height) then Exit;
  Crop := TBitmap.Create;
  try
    Crop.PixelFormat := pf32bit;
    Crop.Width := CW;
    Crop.Height := CH;
    Crop.Canvas.CopyRect(Rect(0, 0, CW, CH), Bmp.Canvas,
      Rect(MinX, MinY, MaxX + 1, MaxY + 1));
    Bmp.Assign(Crop);
    Bmp.PixelFormat := pf32bit;
  finally
    Crop.Free;
  end;
end;

procedure TfrmMain.CropIdleLogoToContent;
begin
  if not IdleLogoBitmapReady then Exit;
  IdleCropBitmapToContent(FIdleLogoBitmap);
end;

procedure TfrmMain.TrimIdleLogoFaintEdges;
var
  W, H, Top, Left, Right, Bottom, Sum, Cnt: Integer;
  P: PRGBQuad;
  Crop: TBitmap;

  function RowMostlyTransparent(AY: Integer): Boolean;
  var
    IX: Integer;
  begin
    Sum := 0;
    Cnt := 0;
    P := FIdleLogoBitmap.ScanLine[AY];
    for IX := 0 to W - 1 do
    begin
      Inc(Sum, P^.rgbReserved);
      Inc(Cnt);
      Inc(P);
    end;
    Result := (Cnt > 0) and (Sum div Cnt < 28);
  end;

  function ColMostlyTransparent(AX: Integer): Boolean;
  var
    IY: Integer;
  begin
    Sum := 0;
    Cnt := 0;
    for IY := 0 to H - 1 do
    begin
      P := FIdleLogoBitmap.ScanLine[IY];
      Inc(P, AX);
      Inc(Sum, P^.rgbReserved);
      Inc(Cnt);
    end;
    Result := (Cnt > 0) and (Sum div Cnt < 28);
  end;

begin
  if not IdleLogoBitmapReady then Exit;
  W := FIdleLogoBitmap.Width;
  H := FIdleLogoBitmap.Height;
  Top := 0;
  while (Top < H - 1) and RowMostlyTransparent(Top) do Inc(Top);
  Bottom := H - 1;
  while (Bottom > Top) and RowMostlyTransparent(Bottom) do Dec(Bottom);
  Left := 0;
  while (Left < W - 1) and ColMostlyTransparent(Left) do Inc(Left);
  Right := W - 1;
  while (Right > Left) and ColMostlyTransparent(Right) do Dec(Right);
  if (Right <= Left) or (Bottom <= Top) then Exit;
  if (Left = 0) and (Top = 0) and (Right = W - 1) and (Bottom = H - 1) then Exit;
  Crop := TBitmap.Create;
  try
    Crop.PixelFormat := pf32bit;
    Crop.Width := Right - Left + 1;
    Crop.Height := Bottom - Top + 1;
    Crop.Canvas.CopyRect(Rect(0, 0, Crop.Width, Crop.Height), FIdleLogoBitmap.Canvas,
      Rect(Left, Top, Right + 1, Bottom + 1));
    FIdleLogoBitmap.Assign(Crop);
    FIdleLogoBitmap.PixelFormat := pf32bit;
  finally
    Crop.Free;
  end;
end;

procedure TfrmMain.ApplyIdleLogoPostProcess;
var
  X, Y, BgR, BgG, BgB, R, G, B: Integer;
  P: PRGBQuad;
begin
  if not IdleLogoBitmapReady then Exit;
  FIdleLogoBitmap.PixelFormat := pf32bit;
  DetectIdleLogoBorderBackground(FIdleLogoBitmap, BgR, BgG, BgB);
  FloodClearIdleLogoBackground(FIdleLogoBitmap, BgR, BgG, BgB);
  for Y := 0 to FIdleLogoBitmap.Height - 1 do
  begin
    P := FIdleLogoBitmap.ScanLine[Y];
    for X := 0 to FIdleLogoBitmap.Width - 1 do
    begin
      R := P^.rgbRed;
      G := P^.rgbGreen;
      B := P^.rgbBlue;
      if (R = 0) and (G = 0) and (B = 0) and (P^.rgbReserved = 0) then
        { já limpo pelo flood fill }
      else if IdleLogoIsBackgroundPixel(R, G, B, BgR, BgG, BgB) then
        IdleLogoClearPixel(P)
      else
        IdleLogoSetWatermarkPixel(P, R, G, B, 255);
      Inc(P);
    end;
  end;
  CropIdleLogoToContent;
end;

procedure TfrmMain.BuildFadedIdleLogoBitmap(const ASource: TGraphic);
var
  Temp: TBitmap;
begin
  if not Assigned(ASource) then Exit;
  if not Assigned(FIdleLogoBitmap) then
    FIdleLogoBitmap := TBitmap.Create;
  Temp := TBitmap.Create;
  try
    Temp.Assign(ASource);
    Temp.PixelFormat := pf32bit;
    FIdleLogoBitmap.Assign(Temp);
    ApplyIdleLogoPostProcess;
  finally
    Temp.Free;
  end;
end;

procedure TfrmMain.LoadIdleLogoBitmap;
var
  ExeDir, Path, TryPath, BestPngPath, SrcDir: string;
  Pic: TPicture;
  I, BestArea, Area: Integer;
  PngProbe: TPNGGraphic;

  function TryLoadFrom(const APath: string): Boolean;
  var
    Png: TPNGGraphic;
  begin
    Result := False;
    if APath = '' then Exit;
    if not FileExists(APath) then Exit;
    if SameText(ExtractFileExt(APath), '.png') then
    begin
      Png := TPNGGraphic.Create;
      try
        Png.LoadFromFile(APath);
        if (Png.Width > 0) and (Png.Height > 0) then
        begin
          if not Assigned(FIdleLogoBitmap) then
            FIdleLogoBitmap := TBitmap.Create;
          UpdateTransparency(FIdleLogoBitmap, Png);
          if IdleLogoBitmapHasRealAlpha(FIdleLogoBitmap) then
            ApplyIdleLogoPngFade
          else
            ApplyIdleLogoPostProcess;
          Result := IdleLogoBitmapReady;
        end;
      finally
        Png.Free;
      end;
      Exit;
    end;
    Pic.LoadFromFile(APath);
    if Assigned(Pic.Graphic) and (Pic.Width > 0) and (Pic.Height > 0) then
    begin
      BuildFadedIdleLogoBitmap(Pic.Graphic);
      Result := IdleLogoBitmapReady;
    end;
  end;

  function ResolveBestIdleLogoPngPath: string;
    procedure Consider(const APath: string);
    begin
      if (APath = '') or not FileExists(APath) then Exit;
      if not SameText(ExtractFileExt(APath), '.png') then Exit;
      PngProbe := TPNGGraphic.Create;
      try
        PngProbe.LoadFromFile(APath);
        if (PngProbe.Width > 0) and (PngProbe.Height > 0) then
        begin
          Area := PngProbe.Width * PngProbe.Height;
          if Area > BestArea then
          begin
            BestArea := Area;
            Result := APath;
          end;
        end;
      finally
        PngProbe.Free;
      end;
    end;

  begin
    Result := '';
    BestArea := 0;
    Consider(ExeDir + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG);
    Consider(ExeDir + IDLE_LOGO_PNG);
    SrcDir := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0)));
    Consider(SrcDir + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG);
    Consider(SrcDir + IDLE_LOGO_PNG);
    Consider(ExeDir + '..' + PathDelim + IDLE_LOGO_PNG);
    Consider(ExeDir + IDLE_LOGO_PNG_HIRES_REL);
    Consider(SrcDir + IDLE_LOGO_PNG_HIRES_REL);
    Consider(ExeDir + '..\..\Images\Logo\package_highres_mpanlryw\color1\icon\' + IDLE_LOGO_PNG);
  end;

begin
  if not Assigned(FIdleLogoBitmap) then
    FIdleLogoBitmap := TBitmap.Create
  else
    FIdleLogoBitmap.Assign(nil);
  ExeDir := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName));
  Pic := TPicture.Create;
  try
    BestPngPath := ResolveBestIdleLogoPngPath;
    if BestPngPath <> '' then
    begin
      if TryLoadFrom(BestPngPath) then
        Exit;
    end;
    { Fallback BMP / outros caminhos legados. }
    for I := 0 to 9 do
    begin
      case I of
        0: TryPath := ExeDir + IDLE_LOGO_PNG;
        1: TryPath := ExeDir + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG;
        2: TryPath := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0))) + IDLE_LOGO_PNG;
        3: TryPath := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0))) + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG;
        4: TryPath := ExeDir + '..' + PathDelim + IDLE_LOGO_PNG;
        5: TryPath := ExeDir + LOGO;
        6: TryPath := ExeDir + FASTFILE_BUILD_DIR + '\' + LOGO;
        7: TryPath := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0))) + LOGO;
        8: TryPath := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0))) + FASTFILE_BUILD_DIR + '\' + LOGO;
        9: TryPath := ExeDir + '..' + PathDelim + LOGO;
      end;
      if TryLoadFrom(TryPath) then Exit;
    end;
    Path := ExeDir + LOGO;
    if not FileExists(Path) then
    begin
      try
        UnUtils.extractResource('LOGO', Path);
      except
      end;
    end;
    TryLoadFrom(Path);
  finally
    Pic.Free;
  end;
end;

{ The processed idle logo is identical on every run, but decoding the candidate
  PNGs plus the per-pixel processing cost ~1.8 s at startup. The result is
  cached; the key changes with the processing revision or any source file. }
const
  IDLE_LOGO_CACHE_FILE = 'FastFile_IdleLogo.cache';
  IDLE_LOGO_CACHE_MAGIC: Cardinal = $4F474C46; { 'FLGO' }

function IdleLogoCacheKey: string;
var
  ExeDir, SrcDir: string;

  procedure AddFile(const APath: string);
  var
    SR: TSearchRec;
  begin
    if FindFirst(APath, faAnyFile, SR) = 0 then
    try
      Result := Result + '|' + LowerCase(ExpandFileName(APath)) + ':' +
        IntToStr(SR.Size) + ':' + IntToStr(SR.Time);
    finally
      FindClose(SR);
    end;
  end;

begin
  ExeDir := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName));
  SrcDir := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0)));
  Result := 'rev' + IntToStr(IDLE_LOGO_PROCESS_REV);
  AddFile(ExeDir + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG);
  AddFile(ExeDir + IDLE_LOGO_PNG);
  AddFile(SrcDir + FASTFILE_BUILD_DIR + '\' + IDLE_LOGO_PNG);
  AddFile(SrcDir + IDLE_LOGO_PNG);
  AddFile(ExeDir + '..' + PathDelim + IDLE_LOGO_PNG);
  AddFile(ExeDir + IDLE_LOGO_PNG_HIRES_REL);
  AddFile(SrcDir + IDLE_LOGO_PNG_HIRES_REL);
  AddFile(ExeDir + '..\..\Images\Logo\package_highres_mpanlryw\color1\icon\' + IDLE_LOGO_PNG);
  AddFile(ExeDir + LOGO);
end;

function IdleLogoCachePath: string;
begin
  Result := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName)) +
    IDLE_LOGO_CACHE_FILE;
end;

function LoadIdleLogoCache(ABmp: TBitmap; const AKey: string): Boolean;
var
  FS: TFileStream;
  Magic: Cardinal;
  KeyLen, W, H, Y: Integer;
  Key: string;
begin
  Result := False;
  if not FileExists(IdleLogoCachePath) then Exit;
  try
    FS := TFileStream.Create(IdleLogoCachePath, fmOpenRead or fmShareDenyWrite);
    try
      FS.ReadBuffer(Magic, SizeOf(Magic));
      if Magic <> IDLE_LOGO_CACHE_MAGIC then Exit;
      FS.ReadBuffer(KeyLen, SizeOf(KeyLen));
      if (KeyLen <= 0) or (KeyLen > 8192) then Exit;
      SetLength(Key, KeyLen);
      FS.ReadBuffer(Key[1], KeyLen * SizeOf(Char));
      if Key <> AKey then Exit;
      FS.ReadBuffer(W, SizeOf(W));
      FS.ReadBuffer(H, SizeOf(H));
      if (W <= 0) or (H <= 0) or (W > 8192) or (H > 8192) then Exit;
      if FS.Size - FS.Position <> Int64(W) * H * 4 then Exit;
      ABmp.PixelFormat := pf32bit;
      ABmp.SetSize(W, H);
      for Y := 0 to H - 1 do
        FS.ReadBuffer(ABmp.ScanLine[Y]^, W * 4);
      Result := True;
    finally
      FS.Free;
    end;
  except
    Result := False;
  end;
end;

procedure SaveIdleLogoCache(ABmp: TBitmap; const AKey: string);
var
  FS: TFileStream;
  KeyLen, W, H, Y: Integer;
begin
  if not Assigned(ABmp) or (ABmp.PixelFormat <> pf32bit) then Exit;
  W := ABmp.Width;
  H := ABmp.Height;
  if (W <= 0) or (H <= 0) or (AKey = '') then Exit;
  try
    FS := TFileStream.Create(IdleLogoCachePath, fmCreate);
    try
      FS.WriteBuffer(IDLE_LOGO_CACHE_MAGIC, SizeOf(IDLE_LOGO_CACHE_MAGIC));
      KeyLen := Length(AKey);
      FS.WriteBuffer(KeyLen, SizeOf(KeyLen));
      FS.WriteBuffer(AKey[1], KeyLen * SizeOf(Char));
      FS.WriteBuffer(W, SizeOf(W));
      FS.WriteBuffer(H, SizeOf(H));
      for Y := 0 to H - 1 do
        FS.WriteBuffer(ABmp.ScanLine[Y]^, W * 4);
    finally
      FS.Free;
    end;
  except
    { Read-only install folder: just keep processing on every start. }
  end;
end;

procedure TfrmMain.EnsureIdleLogoLoaded;
var
  CacheKey: string;
begin
  if (FIdleLogoProcessRev <> IDLE_LOGO_PROCESS_REV) or not IdleLogoBitmapReady then
  begin
    FreeAndNil(FIdleLogoBitmap);
    FIdleLogoProcessRev := -1;
    InvalidateIdleLogoPaintCache;
    CacheKey := IdleLogoCacheKey;
    FIdleLogoBitmap := TBitmap.Create;
    if LoadIdleLogoCache(FIdleLogoBitmap, CacheKey) then
    begin
      FIdleLogoProcessRev := IDLE_LOGO_PROCESS_REV;
      Exit;
    end;
    FreeAndNil(FIdleLogoBitmap);
    LoadIdleLogoBitmap;
    if IdleLogoBitmapReady then
    begin
      FinishIdleLogoBitmapProcessing;
      FIdleLogoProcessRev := IDLE_LOGO_PROCESS_REV;
      SaveIdleLogoCache(FIdleLogoBitmap, CacheKey);
    end;
  end;
end;

procedure TfrmMain.UpdateIdleLogoVisibility;
var
  ShowLogo: Boolean;
  Btn: TacFloatBtn;
begin
  if Assigned(sFloatSample) and (sFloatSample.Items.Count > 0) then
    sFloatSample.Items[0].Visible := False;
  if Assigned(sFloatSampleClose) and (sFloatSampleClose.Items.Count > 0) then
    sFloatSampleClose.Items[0].Visible := False;
  ShowLogo := MainWorkspaceShowsIdleLogo;
  if ShowLogo then
  begin
    EnsureIdleLogoLoaded;
    if not IdleLogoBitmapReady then Exit;
    CalcIdleLogoDrawDimensions;
    EnsureIdleLogoBgFloat;
    SyncIdleLogoBgFloatBounds;
    RefreshIdleLogoPaintCache;
    Btn := FIdleLogoBgFloat.Items[0];
    Btn.Visible := False;
    Btn.UpdatePosition;
    Btn.Repaint;
    Btn.Visible := True;
    PostMessage(Handle, WM_USER + 435, 0, 0);
  end
  else
  begin
    InvalidateIdleLogoPaintCache;
    if Assigned(FIdleLogoBgFloat) and (FIdleLogoBgFloat.Items.Count > 0) then
      FIdleLogoBgFloat.Items[0].Visible := False;
  end;
  if Assigned(FIdleLogoFloat) and (FIdleLogoFloat.Items.Count > 0) then
    FIdleLogoFloat.Items[0].Visible := False;
end;

procedure TfrmMain.RefreshListViewAfterMarksToggle;
var
  ItemCount: Integer;
begin
  if isChecked then
  begin
    showChecked;
    Exit;
  end;
  if not Assigned(ListView1) or not ListView1.HandleAllocated then Exit;
  if not ListView1.Visible then Exit;
  ItemCount := ListView1.Items.Count;
  if ItemCount > 0 then
  begin
    ListView1.Items.BeginUpdate;
    try
      ListView1.Items.Count := 0;
      ListView1.Items.Count := ItemCount;
    finally
      ListView1.Items.EndUpdate;
    end;
  end;
  ListView1.Invalidate;
  ListView1.Update;
  if FFastVisualWordWrap and (not isChecked) and ListView1.Visible then
    RecalcDynWrapRowHeight;
  UpdateInfoPanels;
end;

procedure FullScreenSaveCollapse(AControl: TControl; var AState: TFullScreenControlState);
begin
  if not Assigned(AControl) then Exit;
  AState.Visible := AControl.Visible;
  AState.Height := AControl.Height;
  AState.Align := AControl.Align;
  { Somente Visible — nao zerar bounds/Align (AlphaSkins AC_PAINTOUTER / EOutOfResources). }
  AControl.Visible := False;
end;

procedure FullScreenSaveHideOnly(AControl: TControl; var AState: TFullScreenControlState);
begin
  FullScreenSaveCollapse(AControl, AState);
end;

procedure FullScreenRestore(AControl: TControl; const AState: TFullScreenControlState);
begin
  if not Assigned(AControl) then Exit;
  AControl.Visible := AState.Visible;
end;

procedure FullScreenRestoreHideOnly(AControl: TControl; const AState: TFullScreenControlState);
begin
  FullScreenRestore(AControl, AState);
end;

procedure TfrmMain.ToggleFullScreenView;
var
  SkinUpdating: Boolean;
  FreezeRedraw: Boolean;
begin
  FFullScreenMode := not FFullScreenMode;

  SkinUpdating := Assigned(DataModule1) and Assigned(DataModule1.sSkinManager1);
  FreezeRedraw := HandleAllocated;
  if FreezeRedraw then
    SendMessage(Handle, WM_SETREDRAW, 0, 0);
  if SkinUpdating then
    DataModule1.sSkinManager1.BeginUpdate;

  DisableAlign;
  try
    if FFullScreenMode then
    begin
      if Assigned(pgMain) and Assigned(tabReadFile) then
      begin
        tabReadFile.TabVisible := True;
        pgMain.ActivePage := tabReadFile;
      end;

      FFullScreenSavedMenu := Menu;
      if HandleAllocated and Assigned(MainMenu1) then
        SetMenu(Handle, 0);

      FullScreenSaveCollapse(sPageControl1, FFullScreenSavedPageControl1);
      FullScreenSaveCollapse(sPanel2, FFullScreenSavedPanel2);
      FullScreenSaveCollapse(sPanel3, FFullScreenSavedPanel3);
      FullScreenSaveHideOnly(sPanel1, FFullScreenSavedPanel1);

      FFullScreenSavedPgTabHeight := pgMain.TabHeight;
      pgMain.TabHeight := 0;

      FullScreenSaveCollapse(pnlTop, FFullScreenSavedPnlTop);
      FullScreenSaveCollapse(sPageControl2, FFullScreenSavedPageControl2);
      FullScreenSaveCollapse(sSplitter1, FFullScreenSavedSplitter1);

      if Assigned(FMenuFullScreenItem) then
        FMenuFullScreenItem.Checked := True;
    end
    else
    begin
      FullScreenRestore(sSplitter1, FFullScreenSavedSplitter1);
      FullScreenRestore(pnlTop, FFullScreenSavedPnlTop);
      FullScreenRestore(sPageControl2, FFullScreenSavedPageControl2);

      pgMain.TabHeight := FFullScreenSavedPgTabHeight;

      FullScreenRestore(sPageControl1, FFullScreenSavedPageControl1);
      FullScreenRestore(sPanel2, FFullScreenSavedPanel2);
      FullScreenRestore(sPanel3, FFullScreenSavedPanel3);
      FullScreenRestoreHideOnly(sPanel1, FFullScreenSavedPanel1);

      if HandleAllocated and Assigned(MainMenu1) then
        SetMenu(Handle, MainMenu1.Handle);
      if Assigned(FFullScreenSavedMenu) then
        Menu := FFullScreenSavedMenu;

      if Assigned(FMenuFullScreenItem) then
        FMenuFullScreenItem.Checked := False;
    end;
  finally
    EnableAlign;
    Realign;
    if SkinUpdating then
      DataModule1.sSkinManager1.EndUpdate(False, False);
    if FreezeRedraw then
    begin
      SendMessage(Handle, WM_SETREDRAW, 1, 0);
      Invalidate;
    end;
  end;

  if HandleAllocated then
    PostMessage(Handle, WM_USER + 203, 0, 0)
  else
    RefreshReadViewLayout;
end;

procedure TfrmMain.WMFullScreenLayout(var Msg: TMessage);
begin
  RefreshReadViewLayout;
  if isChecked and HandleAllocated then
    PostMessage(Handle, WM_USER + 204, 0, 0);
end;

procedure TfrmMain.RefreshReadViewLayout;
begin
  if FFullScreenMode and Assigned(pgMain) and Assigned(tabReadFile) and
     (pgMain.ActivePage <> tabReadFile) then
  begin
    tabReadFile.TabVisible := True;
    pgMain.ActivePage := tabReadFile;
  end;
  if Assigned(ListView1) and ListView1.HandleAllocated then
    ListView1Resize(ListView1);
  if isChecked and Assigned(FCheckListBox) then
  begin
    FCheckListDisplayOffset := -1;
    SyncCheckListLayoutAfterSelectMode;
    RefreshCheckListViewport(True);
  end
  else if Assigned(ListView1) then
    ListView1.Invalidate;
end;

function TfrmMain.CheckListContentRightEdge(CLB: TCheckListBox): Integer;
var
  R: TRect;
begin
  Result := 2;
  if not Assigned(CLB) then Exit;
  Result := CLB.ClientWidth - 2;
  if Result < 2 then Result := 2;
  R := CheckListBoxWordWrapTextRect(CLB, Classes.Rect(0, 0, CLB.ClientWidth, 16));
  if R.Right > R.Left + 4 then
    Result := R.Right;
end;

function TfrmMain.ListViewContentRightEdge: Integer;
var
  Col0W: Integer;
begin
  Result := 2;
  if not Assigned(ListView1) then Exit;
  Result := ListView1.ClientWidth - 2;
  if ListView1.Columns.Count >= 2 then
  begin
    Col0W := ListView1.Columns[0].Width;
    if Col0W + 8 < Result then
      Result := Col0W + ListView1.Columns[1].Width - 2;
  end;
  if Result < 2 then Result := 2;
end;

procedure TfrmMain.ExpandColumnBlockSelectionToContentWidth;
var
  RightX, LeftX: Integer;
begin
  if not FHasSelection then Exit;
  if FFindMatchSelection then Exit;

  if isChecked and Assigned(FCheckListBox) and FCheckListBox.Visible then
  begin
    RightX := CheckListContentRightEdge(FCheckListBox);
    LeftX := GetSystemMetrics(SM_CXMENUCHECK) + 10;
    if FBlockEndPoint.X >= FBlockStartPoint.X then
      FBlockEndPoint.X := RightX
    else
      FBlockStartPoint.X := RightX;
    if FBlockStartPoint.X < LeftX then
      FBlockStartPoint.X := LeftX;
    if FBlockEndPoint.X < LeftX then
      FBlockEndPoint.X := LeftX;
    FCheckListBox.Invalidate;
    Exit;
  end;

  if Assigned(ListView1) and ListView1.Visible and ListView1.HandleAllocated then
  begin
    RightX := ListViewContentRightEdge;
    LeftX := 4;
    if ListView1.Columns.Count > 0 then
      LeftX := ListView1.Columns[0].Width + 4;
    if FBlockEndPoint.X >= FBlockStartPoint.X then
      FBlockEndPoint.X := RightX
    else
      FBlockStartPoint.X := RightX;
    if FBlockStartPoint.X < LeftX then
      FBlockStartPoint.X := LeftX;
    if FBlockEndPoint.X < LeftX then
      FBlockEndPoint.X := LeftX;
    ListView1.Repaint;
  end;
end;

function TfrmMain.RecentFilesPopupScreenPoint: TPoint;

  function ControlIsEffectivelyVisible(C: TControl): Boolean;
  var
    P: TWinControl;
    W: TWinControl;
  begin
    Result := Assigned(C) and C.Visible and (C is TWinControl);
    if not Result then Exit;
    W := TWinControl(C);
    Result := W.Handle <> 0;
    if not Result then Exit;
    P := W.Parent;
    while Assigned(P) do
    begin
      if not P.Visible then
      begin
        Result := False;
        Exit;
      end;
      P := P.Parent;
    end;
  end;

begin
  { F11: edtFileName pode estar Visible=True com pnlTop oculto — ClientToScreen fica errado na 1a vez. }
  if FFullScreenMode then
  begin
    if Assigned(pnlMain) and pnlMain.Visible and (pnlMain.Handle <> 0) then
      Result := pnlMain.ClientToScreen(Point(8, 8))
    else
      Result := ClientToScreen(Point(8, 8));
    Exit;
  end;
  if ControlIsEffectivelyVisible(edtFileName) then
    Result := edtFileName.ClientToScreen(Point(0, edtFileName.Height))
  else if ControlIsEffectivelyVisible(ListView1) then
    Result := ListView1.ClientToScreen(Point(8, 8))
  else if Assigned(sStatusBar1) and (sStatusBar1.Handle <> 0) then
    Result := sStatusBar1.ClientToScreen(Point(8, -4))
  else
    Result := ClientToScreen(Point(8, 8));
end;


function TfrmMain.AssistantEffectiveFilterMatchMode(const S: string): TFilterMatchMode;
var
  Core: string;
  L: Integer;
begin
  Core := Trim(S);
  Result := InferFilterMatchModeEnum(Core);
  if Result <> fmmRegex then Exit;
  if (Pos('(', Core) = 0) and (Pos('|', Core) = 0) and (Pos('[', Core) = 0) and
     (Pos('?', Core) = 0) and (Pos('\', Core) = 0) then
    Result := fmmContains
  else
  begin
    L := Length(Core);
    if (L > 1) and (Core[1] = '^') and (Core[L] = '$') and (L < 48) then
      Result := fmmContains;
  end;
end;


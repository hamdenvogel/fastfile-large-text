    RgMode.Width := Frm.ClientWidth - 32;
    RgMode.Height := 120;
    RgMode.Caption := TrText('Merge mode');
    RgMode.Items.Add(TrText('Insert source at beginning (first line).'));
    RgMode.Items.Add(TrText('Insert source after destination line.'));
    RgMode.Items.Add(TrText('Insert source at end of destination file.'));
    RgMode.ItemIndex := 0;

    LblLine := TLabel.Create(Frm);
    LblLine.Parent := Frm;
    LblLine.Left := 32;
    LblLine.Top := 336;
    LblLine.Caption := TrText('Line number (valid range: 1..totalLines-1):');

    SpnLine := TsSpinEdit.Create(Frm);
    SpnLine.Parent := Frm;
    SpnLine.Left := 32;
    SpnLine.Top := 352;
    SpnLine.Width := 120;
    SpnLine.MinValue := 1;
    SpnLine.MaxValue := Max(1, totalLines - 1);
    SpnLine.Value := 1;

    LblInfo := TLabel.Create(Frm);
    LblInfo.Parent := Frm;
    LblInfo.Left := 16;
    LblInfo.Top := 390;
    LblInfo.Width := Frm.ClientWidth - 32;
    LblInfo.Caption := TrText('Tip: press ESC to cancel.') + ' ' +
      TrText('You can drag and drop the source file into this window.');

    BtnOk := TButton.Create(Frm);
    BtnOk.Parent := Frm;
    BtnOk.Left := Frm.ClientWidth - 190;
    BtnOk.Top := Frm.ClientHeight - 42;
    BtnOk.Width := 80;
    BtnOk.Caption := TrText('Confirm');
    BtnOk.ModalResult := mrOk;
    BtnOk.Default := True;

    BtnCancel := TButton.Create(Frm);
    BtnCancel.Parent := Frm;
    BtnCancel.Left := Frm.ClientWidth - 100;
    BtnCancel.Top := Frm.ClientHeight - 42;
    BtnCancel.Width := 80;
    BtnCancel.Caption := TrText('Cancel');
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Cancel := True;

    if Frm.ShowModal <> mrOk then
      Exit;

    { Valida��o e extra��o dos valores }
    ASourceFile := Trim(EdtSource.Text);
    
    { Se modo de intervalo de linhas est� habilitado }
    if ChkLineRange.Checked then
    begin
      try
        { Valida se os campos n�o est�o vazios }
        if Trim(EdtFromLine.Text) = '' then
        begin
          ShowAppMessage(TrText('Error: "From line" cannot be empty.'));
          Exit;
        end;
        if Trim(EdtToLine.Text) = '' then
        begin
          ShowAppMessage(TrText('Error: "To line" cannot be empty.'));
          Exit;
        end;

        { Valida se s�o n�meros v�lidos }
        if not TryStrToInt64(Trim(EdtFromLine.Text), AFromLine) then
        begin
          ShowAppMessage(TrText('Error: "From line" must be a valid number.'));
          Exit;
        end;
        if not TryStrToInt64(Trim(EdtToLine.Text), AToLine) then
        begin
          ShowAppMessage(TrText('Error: "To line" must be a valid number.'));
          Exit;
        end;

        { Valida se os n�meros s�o positivos e no m�nimo 1 }
        if AFromLine < 1 then
        begin
          ShowAppMessage(TrText('Error: "From line" must be at least 1.'));
          Exit;
        end;
        if AToLine < 1 then
        begin
          ShowAppMessage(TrText('Error: "To line" must be at least 1.'));
          Exit;
        end;

        { Valida se FromLine <= ToLine (n�o pode ser do maior para o menor) }
        if AFromLine > AToLine then
        begin
          ShowAppMessage(Format(TrText('Error: "From line" (%d) cannot be greater than "To line" (%d).'),
            [AFromLine, AToLine]));
          Exit;
        end;

        { Valida se as linhas existem no arquivo de origem }
        if ASourceFile <> '' then
        begin
          if not FileExists(ASourceFile) then
          begin
            ShowAppMessage(Format(TrText('Error: Source file not found: %s'), [ASourceFile]));
            Exit;
          end;

          { Conta o total de linhas no arquivo de origem }
          SourceLineCount := CountLinesInFile(ASourceFile);
          if SourceLineCount < 0 then
          begin
            ShowAppMessage(TrText('Error: Could not read source file to validate line count.'));
            Exit;
          end;

          if AFromLine > SourceLineCount then
          begin
            ShowAppMessage(Format(TrText('Error: "From line" (%d) exceeds total lines in source file (%d).'),
              [AFromLine, SourceLineCount]));
            Exit;
          end;

          if AToLine > SourceLineCount then
          begin
            ShowAppMessage(Format(TrText('Error: "To line" (%d) exceeds total lines in source file (%d).'),
              [AToLine, SourceLineCount]));
            Exit;
          end;
        end;

        AMergeMode := mfmLineRange;
        Result := True;
      except
        on E: Exception do
        begin
          ShowAppMessage(TrText('Error validating line range: ') + E.Message);
          Exit;
        end;
      end;
    end
    else
    begin
      case RgMode.ItemIndex of
        1: AMergeMode := mfmAfterLine;
        2: AMergeMode := mfmEnd;
      else
        AMergeMode := mfmBeginning;
      end;
      ALineNumber := SpnLine.Value;
      Result := True;
    end;
  finally
    if Assigned(EdtSource) then
      EdtSource.Color := Frm.FSourceEditDefaultColor;
    Frm.EnableFileDrop(False);
    Frm.Free;
  end;
end;

function TfrmMain.ShowSplitEqualPartsDialog(out ASourceFile: String;

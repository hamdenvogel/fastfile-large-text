procedure TfrmMain.RestoreOneOpenTab(const ATabName: string);
var
  Id: string;
  Comp: TComponent;
  Tab: TsTabSheet;
  Path: string;
begin
  Id := Trim(ATabName);
  if Id = '' then Exit;

  if SameText(Id, 'tabRecentFiles') then
  begin
    Tab := FindRecentFilesTab;
    if not Assigned(Tab) then Exit;
    WireRecentFilesTabEvents;
    LocalizeRecentFilesTab;
    PopulateRecentFilesTab;
    ShowTab(Tab);
    Exit;
  end;

  if SameText(Id, 'tabMerge') then
  begin
    miCompareMergeHistoryClick(nil);
    Exit;
  end;

  if SameText(Id, 'tabMergeLines') then
  begin
    if not Assigned(tabMergeLines) then Exit;
    ShowTab(tabMergeLines);
    Path := Trim(CurrentEffectiveFilePath);
    if (Path <> '') and (not SameText(Path, SELECTTEXT)) and FileExists(Path) then
      EnsureMergeLinesTab;
    Exit;
  end;

  if SameText(Id, 'tabMergeFiles') then
  begin
    if not Assigned(tabMergeFiles) then Exit;
    ShowTab(tabMergeFiles);
    EnsureMergeFilesTab;
    Exit;
  end;

  if SameText(Id, 'tabSplitByPatternTab') then
  begin
    if not Assigned(tabSplitByPatternTab) then Exit;
    ShowTab(tabSplitByPatternTab);
    EnsureSplitByPatternTab;
    Exit;
  end;

  if SameText(Id, 'tabSplitEqualPartsTab') then
  begin
    if not Assigned(tabSplitEqualPartsTab) then Exit;
    ShowTab(tabSplitEqualPartsTab);
    EnsureSplitEqualPartsTab;
    Exit;
  end;

  if SameText(Id, 'tabSplitFractionTab') then
  begin
    if not Assigned(tabSplitFractionTab) then Exit;
    ShowTab(tabSplitFractionTab);
    EnsureSplitFractionTab;
    Exit;
  end;

  if SameText(Id, 'tabFindFiles') then
  begin
    if not Assigned(tabFindFiles) then Exit;
    ShowTab(tabFindFiles);
    if Assigned(pgFindFiles) then
      pgFindFiles.ActivePageIndex := TAB_FINDFILE_INDEX;
    Exit;
  end;

  Comp := FindComponent(Id);
  if not (Comp is TsTabSheet) then Exit;
  Tab := TsTabSheet(Comp);
  if Tab.PageControl <> pgMain then Exit;
  ShowTab(Tab);
end;

function TfrmMain.RestoreOpenTabsFromIni: Boolean;
var
  Ids, ActiveId, One, Rest, Seed, LastId: string;
  P: Integer;
  Comp: TComponent;
begin
  Result := False;
  if IniName = '' then Exit;
  if sStoreUtils.ReadIniInteger(APPLICATION_NAME, INI_OPEN_TABS_SAVED, 0, IniName) <> 1 then
    Exit;
  Result := True;

  { edtFileName ja vem do FormCreate; reaplicar aqui tambem cobre o menu
    "Restaurar abas da ultima sessao". Preenche o caminho mas NAO carrega o
    ficheiro (BeginRead) — o utilizador carrega com Ler/F5. }
  RestoreEdtFileNameFromIni;
  Ids := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS, IniName));
  ActiveId := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS_ACTIVE, IniName));

  if Ids = '' then Exit;

  { Only the active tab is built now; the others just get their tab header and
    are built on first activation (pgMainPageChange). Building every hosted
    screen at startup blocked the UI thread long enough to trip the watchdog. }
  FastFileWatchdogBeginHeavyOp('Restore tabs');
  FRestoringOpenTabs := True;
  try
    LastId := '';
    Rest := Ids;
    while Rest <> '' do
    begin
      P := Pos(';', Rest);
      if P = 0 then
      begin
        One := Trim(Rest);
        Rest := '';
      end
      else
      begin
        One := Trim(Copy(Rest, 1, P - 1));
        Delete(Rest, 1, P);
      end;
      if One = '' then Continue;
      LastId := One;
      if SameText(One, ActiveId) then Continue;
      FastFileWatchdogPulse;
      try
        Comp := FindComponent(One);
        if (Comp is TsTabSheet) and (TsTabSheet(Comp).PageControl = pgMain) and
           Assigned(FPendingTabBuild) then
        begin
          if FPendingTabBuild.IndexOf(One) < 0 then
            FPendingTabBuild.Add(One);
          TsTabSheet(Comp).TabVisible := True;
          pgMain.Visible := True;
        end
        else
          RestoreOneOpenTab(One);
      except
      end;
    end;

    StartupMark('  RestoreTabs: pending headers (' + Ids + ')');
    if ActiveId = '' then
      ActiveId := LastId;
    if ActiveId <> '' then
    try
      FastFileWatchdogPulse;
      if Assigned(FPendingTabBuild) and (FPendingTabBuild.IndexOf(ActiveId) >= 0) then
        FPendingTabBuild.Delete(FPendingTabBuild.IndexOf(ActiveId));
      RestoreOneOpenTab(ActiveId);
    except
    end;
    StartupMark('  RestoreTabs: build active ' + ActiveId);
  finally
    FRestoringOpenTabs := False;
    FastFileWatchdogEndHeavyOp;
  end;
  if Assigned(pgMain) and pgMain.Visible then
  begin
    pgMain.ShowCloseBtns := True;
    UpdateIdleLogoVisibility;
  end;

  Seed := Ids;
  while Seed <> '' do
  begin
    P := Pos(';', Seed);
    if P = 0 then
    begin
      One := Trim(Seed);
      Seed := '';
    end
    else
    begin
      One := Trim(Copy(Seed, 1, P - 1));
      Delete(Seed, 1, P);
    end;
    if One <> '' then
      RememberOpenTabName(One);
  end;
  if ActiveId <> '' then
    RememberOpenTabName(ActiveId);
end;

procedure TfrmMain.pgMainPageChange(Sender: TObject);
var
  Id: string;
  I: Integer;
begin
  RelayoutMainPages(False);
  if FBuildingPendingTab or FApplicationClosing then Exit;
  if Assigned(pgMain) and (pgMain.ActivePage = tabReadFile) then
    RunPendingFilterBarRestore;
  if not Assigned(FPendingTabBuild) or (FPendingTabBuild.Count = 0) then Exit;
  if not Assigned(pgMain) or not Assigned(pgMain.ActivePage) then Exit;
  Id := pgMain.ActivePage.Name;
  I := FPendingTabBuild.IndexOf(Id);
  if I < 0 then Exit;
  FPendingTabBuild.Delete(I);
  FBuildingPendingTab := True;
  FastFileWatchdogBeginHeavyOp('Restore tab ' + Id);
  try
    try
      RestoreOneOpenTab(Id);
    except
    end;
  finally
    FastFileWatchdogEndHeavyOp;
    FBuildingPendingTab := False;
  end;
end;


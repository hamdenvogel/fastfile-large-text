type
  { Worker dedicated to multi-line MMF delete so the main thread remains responsive
    while the loading modal keeps repainting and handling messages. }
  TBatchDeleteLinesThread = class(TThread)
  private
    FFileName: string;
    FLines: TInt64DynArray;
    FErrorMsg: string;
    FOk: Boolean;
    FNewLineCount: Int64;
  protected
    procedure Execute; override;
  public
    constructor Create(const AFileName: string; const ALines: TInt64DynArray);
    property Ok: Boolean read FOk;
    property ErrorMsg: string read FErrorMsg;
    property NewLineCount: Int64 read FNewLineCount;
  end;

  TLvTranslateThread = class(TThread)
  private
    FPrompt: WideString;
    FOk: Boolean;
    FAns: WideString;
    FErr: string;
    procedure SyncDone;
  protected
    procedure Execute; override;
  public
    constructor Create(const APrompt: WideString);
  end;

  { Worker for segmented delete path (temp index based). }
  TSegmentedDeleteLinesThread = class(TThread)
  private
    FFileName: string;
    FIdxPath: string;
    FLines: TInt64DynArray;
    FErrorMsg: string;
    FSegOk: Boolean;
  protected
    procedure Execute; override;
  public
    constructor Create(const AFileName, AIdxPath: string; const ALines: TInt64DynArray);
    property SegOk: Boolean read FSegOk;
    property ErrorMsg: string read FErrorMsg;
  end;

  { Async call to FastFile AI gateway for inline regex example suggestions (Split-by-Pattern tab). }
  TSplitPatternAISuggestThread = class(TThread)
  private
    FOwner: TfrmMain;
    FPrompt: WideString;
    FOk: Boolean;
    FAns: WideString;
    FErr: String;
    procedure UISync;
  protected

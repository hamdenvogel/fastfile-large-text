function StackCompareTop(Item1, Item2: Pointer): Integer;
begin
  Result := TControl(Item1).Top - TControl(Item2).Top;
end;

function IsStackWrapLabel(C: TControl): Boolean;
begin
  Result := (C is TLabel) and TLabel(C).WordWrap;
end;

procedure FitStackWrapLabel(L: TLabel; W: Integer);
var
  Bmp: TBitmap;
  R: TRect;
  Flags: Cardinal;
  H: Integer;
begin
  if W < 40 then W := 40;
  L.AutoSize := False;
  L.Width := W;
  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(L.Font);
    R := Rect(0, 0, W, 0);
    Flags := DT_CALCRECT or DT_WORDBREAK or DT_LEFT;
    if not L.ShowAccelChar then
      Flags := Flags or DT_NOPREFIX;
    if L.Caption <> '' then
      DrawText(Bmp.Canvas.Handle, PChar(L.Caption), -1, R, Flags);
    H := Max(R.Bottom - R.Top, Bmp.Canvas.TextHeight('Wg'));
  finally
    Bmp.Free;
  end;
  L.Height := H + 2;
end;

destructor TMergeFilesDialogForm.Destroy;
begin
  FreeAndNil(FStackCtrls);
  inherited Destroy;
end;

procedure TMergeFilesDialogForm.FreezeStackLayout(ASB: TScrollBox; AWrapGap: Integer);
var
  i: Integer;
  C, NextC: TControl;
begin
  FStackSB := ASB;
  if not Assigned(FStackCtrls) then
    FStackCtrls := TList.Create;
  FStackCtrls.Clear;
  if not Assigned(ASB) then Exit;
  for i := 0 to ASB.ControlCount - 1 do
    FStackCtrls.Add(ASB.Controls[i]);
  FStackCtrls.Sort(StackCompareTop);
  for i := 0 to FStackCtrls.Count - 1 do
  begin
    C := TControl(FStackCtrls[i]);
    if (i = FStackCtrls.Count - 1) or IsStackWrapLabel(C) then
      C.Tag := AWrapGap
    else
    begin
      NextC := TControl(FStackCtrls[i + 1]);
      C.Tag := Max(0, NextC.Top - (C.Top + C.Height));
    end;
  end;
  ReflowStack;
end;

procedure TMergeFilesDialogForm.ReflowStack;
var
  i, Y, W: Integer;
  C: TControl;
begin
  if FStackReflowing then Exit;
  if not Assigned(FStackSB) or not Assigned(FStackCtrls) or (FStackCtrls.Count = 0) then Exit;
  FStackReflowing := True;
  try
    Y := TControl(FStackCtrls[0]).Top;
    for i := 0 to FStackCtrls.Count - 1 do
    begin
      C := TControl(FStackCtrls[i]);
      C.Top := Y;
      if IsStackWrapLabel(C) then
      begin
        W := FStackSB.ClientWidth - 2 * C.Left;
        FitStackWrapLabel(TLabel(C), W);
      end;
      Y := C.Top + C.Height + C.Tag;
    end;
  finally
    FStackReflowing := False;
  end;
end;

procedure TMergeFilesDialogForm.Resize;
begin
  inherited Resize;
  ReflowStack;
end;


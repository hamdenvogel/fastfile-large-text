function TfrmMain.TryGetSelectedStartLine(out ALine1Based: Int64): Boolean;
var
  LineIdx: Integer;
begin
  Result := False;
  ALine1Based := 0;

  if isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0) then
  begin
    ALine1Based := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]);
    Result := ALine1Based > 0;
    Exit;
  end;

  if Assigned(ListView1) and (ListView1.ItemIndex >= 0) then
  begin
    LineIdx := FileLineIndexFromListRow(ListView1.ItemIndex);
    if LineIdx >= 0 then
    begin
      ALine1Based := Int64(LineIdx) + 1;
      Result := True;
    end;
  end;
end;

function TfrmMain.ShowInsertMultipleLinesDialog(out AStartLine: Int64; out ACount: Integer;
  ALinePrefill: Int64; AHasPrefill: Boolean; out AUseDifferentText: Boolean;
  out ATextLines: TStringList): Boolean;
var
  Frm: TForm;
  LblTarget, LblCount, LblMode, LblText, LblHint, LblSelection: TLabel;
  EdtTarget, EdtCount: TEdit;
  RbBlank, RbRepeat, RbDifferent: TRadioButton;
  MemoText: TMemo;
  BtnOk, BtnCancel: TButton;
  TmpLine: Int64;
  TmpCount: Integer;
  I: Integer;
  RawLines: TStringList;
  RequiredClientWidth: Integer;
  RequiredClientHeight: Integer;
  LblSelHeight: Integer;
  LblHintHeight: Integer;
  ExtraSelHeight: Integer;
  R: TRect;

  procedure EnsureMinWidth(AWidth: Integer);
  begin
    if AWidth > RequiredClientWidth then
      RequiredClientWidth := AWidth;
  end;
begin
  Result := False;
  ATextLines := nil;
  AStartLine := 0;
  ACount := 1;
  AUseDifferentText := False;

  Frm := TForm.CreateNew(Self);
  RawLines := nil;
  try
    Frm.Caption := TrText('Insert multiple lines');
    Frm.BorderStyle := bsDialog;
    FfPrepareDialog(Frm, 680, 470);

    LblTarget := TLabel.Create(Frm);
    LblTarget.Parent := Frm;
    LblTarget.Left := 16;
    LblTarget.Top := 16;
    LblTarget.Caption := TrText('Start at line (1-based):');

    LblCount := TLabel.Create(Frm);
    LblCount.Parent := Frm;
    LblCount.Left := 220;
    LblCount.Top := 16;
    LblCount.Caption := TrText('Number of new lines:');

    LblSelection := TLabel.Create(Frm);
    LblSelection.Parent := Frm;
    LblSelection.Left := 16;
    LblSelection.Top := 62;
    LblSelection.Width := Frm.ClientWidth - 32;
    LblSelection.WordWrap := False;
    if AHasPrefill then
      LblSelection.Caption := Format(TrText('Detected selected line: %d (you can change it).'), [ALinePrefill])
    else
      LblSelection.Caption := TrText('No selected line detected. Please enter the start line.');

    EdtTarget := TEdit.Create(Frm);
    EdtTarget.Parent := Frm;
    EdtTarget.Left := 16;
    EdtTarget.Top := 34;
    EdtTarget.Width := 180;
    if AHasPrefill then
      EdtTarget.Text := IntToStr(ALinePrefill)
    else
      EdtTarget.Text := '';

    EdtCount := TEdit.Create(Frm);
    EdtCount.Parent := Frm;
    EdtCount.Left := 220;
    EdtCount.Top := 34;
    EdtCount.Width := 160;
    EdtCount.Text := '1';

    LblMode := TLabel.Create(Frm);
    LblMode.Parent := Frm;
    LblMode.Left := 16;
    LblMode.Top := 116;
    LblMode.Caption := TrText('Content mode:');

    RbBlank := TRadioButton.Create(Frm);
    RbBlank.Parent := Frm;
    RbBlank.Left := 16;
    RbBlank.Top := 136;
    RbBlank.Width := Frm.ClientWidth - 32;
    RbBlank.Caption := TrText('Create blank lines');
    RbBlank.Checked := True;

    RbRepeat := TRadioButton.Create(Frm);
    RbRepeat.Parent := Frm;
    RbRepeat.Left := 16;
    RbRepeat.Top := 158;
    RbRepeat.Width := Frm.ClientWidth - 32;
    RbRepeat.Caption := TrText('Repeat one text in all new lines');

    RbDifferent := TRadioButton.Create(Frm);
    RbDifferent.Parent := Frm;
    RbDifferent.Left := 16;
    RbDifferent.Top := 180;
    RbDifferent.Width := Frm.ClientWidth - 32;
    RbDifferent.Caption := TrText('Use different text for each new line');

    LblText := TLabel.Create(Frm);
    LblText.Parent := Frm;
    LblText.Left := 16;
    LblText.Top := 216;
    LblText.Caption := TrText('Text content:');

    MemoText := TMemo.Create(Frm);
    MemoText.Parent := Frm;
    MemoText.Left := 16;
    MemoText.Top := 236;
    MemoText.Width := Frm.ClientWidth - 32;
    MemoText.Height := 166;
    MemoText.ScrollBars := ssBoth;
    MemoText.WordWrap := False;

    LblHint := TLabel.Create(Frm);
    LblHint.Parent := Frm;
    LblHint.Left := 16;
    LblHint.Top := 408;
    LblHint.Width := Frm.ClientWidth - 210;
    LblHint.WordWrap := True;
    LblHint.Caption := TrText('For different text mode, provide one line per new line to insert.');

    BtnOk := TButton.Create(Frm);
    BtnOk.Parent := Frm;
    BtnOk.Left := Frm.ClientWidth - 190;
    BtnOk.Top := Frm.ClientHeight - 40;
    BtnOk.Width := 80;
    BtnOk.Caption := TrText('Confirm');
    BtnOk.ModalResult := mrOk;
    BtnOk.Default := True;

    BtnCancel := TButton.Create(Frm);
    BtnCancel.Parent := Frm;
    BtnCancel.Left := Frm.ClientWidth - 100;
    BtnCancel.Top := Frm.ClientHeight - 40;
    BtnCancel.Width := 80;
    BtnCancel.Caption := TrText('Cancel');
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Cancel := True;

    { Expand modal width according to translated captions so text is not truncated. }
    Frm.Canvas.Font.Assign(Frm.Font);
    RequiredClientWidth := Frm.ClientWidth;
    EnsureMinWidth(LblSelection.Left + Frm.Canvas.TextWidth(LblSelection.Caption) + 24);
    EnsureMinWidth(RbBlank.Left + 22 + Frm.Canvas.TextWidth(RbBlank.Caption) + 24);
    EnsureMinWidth(RbRepeat.Left + 22 + Frm.Canvas.TextWidth(RbRepeat.Caption) + 24);
    EnsureMinWidth(RbDifferent.Left + 22 + Frm.Canvas.TextWidth(RbDifferent.Caption) + 24);
    EnsureMinWidth(LblHint.Left + Frm.Canvas.TextWidth(LblHint.Caption) + 210);
    if Assigned(Screen) then
      if RequiredClientWidth > (Screen.WorkAreaWidth - 80) then
        RequiredClientWidth := Screen.WorkAreaWidth - 80;
    if RequiredClientWidth < 680 then
      RequiredClientWidth := 680;

    if RequiredClientWidth <> Frm.ClientWidth then
      Frm.ClientWidth := RequiredClientWidth;
    FfFitFormToWorkArea(Frm);

    LblSelection.Width := Frm.ClientWidth - 32;
    RbBlank.Width := Frm.ClientWidth - 32;
    RbRepeat.Width := Frm.ClientWidth - 32;
    RbDifferent.Width := Frm.ClientWidth - 32;
    MemoText.Width := Frm.ClientWidth - 32;
    LblHint.Width := Frm.ClientWidth - 210;
    BtnOk.Left := Frm.ClientWidth - 190;
    BtnCancel.Left := Frm.ClientWidth - 100;

    { Auto-height: reflow controls if LblSelection or LblHint wraps to more lines. }
    Frm.Canvas.Font.Assign(Frm.Font);
    R := Rect(0, 0, LblSelection.Width, 0);
    DrawText(Frm.Canvas.Handle, PChar(LblSelection.Caption), -1, R, DT_CALCRECT or DT_WORDBREAK);
    LblSelHeight := R.Bottom - R.Top;

    R := Rect(0, 0, LblHint.Width, 0);
    DrawText(Frm.Canvas.Handle, PChar(LblHint.Caption), -1, R, DT_CALCRECT or DT_WORDBREAK);
    LblHintHeight := R.Bottom - R.Top;

    ExtraSelHeight := LblSelHeight - 17;  { 17 = nominal single-line label height }
    if ExtraSelHeight < 0 then ExtraSelHeight := 0;

    if ExtraSelHeight > 0 then
    begin
      LblMode.Top := 116 + ExtraSelHeight;
      RbBlank.Top := 136 + ExtraSelHeight;
      RbRepeat.Top := 158 + ExtraSelHeight;
      RbDifferent.Top := 180 + ExtraSelHeight;
      LblText.Top := 216 + ExtraSelHeight;
      MemoText.Top := 236 + ExtraSelHeight;
      LblHint.Top := 408 + ExtraSelHeight;
    end;

    RequiredClientHeight := LblHint.Top + LblHintHeight + 12 + 40;
    if RequiredClientHeight < 470 then RequiredClientHeight := 470;
    if Assigned(Screen) then
      if RequiredClientHeight > (Screen.WorkAreaHeight - 60) then
        RequiredClientHeight := Screen.WorkAreaHeight - 60;

    Frm.ClientHeight := RequiredClientHeight;
    BtnOk.Top := Frm.ClientHeight - 40;
    BtnCancel.Top := Frm.ClientHeight - 40;

    if Frm.ShowModal <> mrOk then Exit;

    if Trim(EdtTarget.Text) = '' then
    begin
      FastFileMessageBox(PChar(TrText('Start line is required.')), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;

    if not TryStrToInt64(Trim(EdtTarget.Text), TmpLine) then
    begin
      FastFileMessageBox(PChar(TrText('Line must be a valid integer.')), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;

    if (TmpLine < 1) or (TmpLine > totalLines) then
    begin
      FastFileMessageBox(PChar(Format(TrText('Line %d does not exist in the file. Valid range: 1..%d.'), [TmpLine, totalLines])),
        APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;

    if not TryStrToInt(Trim(EdtCount.Text), TmpCount) then
    begin
      FastFileMessageBox(PChar(TrText('Number of lines must be a valid integer.')), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;

    if (TmpCount < 1) or (TmpCount > MAX_INSERT_LINES) then
    begin
      FastFileMessageBox(PChar(Format(TrText('Number of lines must be between %d and %d.'), [1, MAX_INSERT_LINES])),
        APPLICATION_NAME, MB_OK or MB_ICONWARNING);
      Exit;
    end;

    ATextLines := TStringList.Create;
    if RbBlank.Checked then
      ATextLines.Add('')
    else if RbRepeat.Checked then
    begin
      if Trim(MemoText.Text) = '' then
      begin
        FastFileMessageBox(PChar(TrText('Text cannot be empty in repeat mode.')), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
        FreeAndNil(ATextLines);
        Exit;
      end;
      if MemoText.Lines.Count > 0 then
        ATextLines.Add(MemoText.Lines[0])
      else
        ATextLines.Add(Trim(MemoText.Text));
    end
    else
    begin
      RawLines := TStringList.Create;
      RawLines.Text := MemoText.Lines.Text;
      while (RawLines.Count > 0) and (RawLines[RawLines.Count - 1] = '') do
        RawLines.Delete(RawLines.Count - 1);
      if RawLines.Count < TmpCount then
      begin
        FastFileMessageBox(PChar(Format(TrText('Different-text mode requires at least %d lines in the text box.'), [TmpCount])),
          APPLICATION_NAME, MB_OK or MB_ICONWARNING);
        FreeAndNil(ATextLines);
        Exit;
      end;
      for I := 0 to TmpCount - 1 do
        ATextLines.Add(RawLines[I]);
    end;

    AStartLine := TmpLine;
    ACount := TmpCount;
    AUseDifferentText := RbDifferent.Checked;
    Result := True;
  finally
    if Assigned(RawLines) then
      RawLines.Free;
    if Assigned(Frm) then
      Frm.Free;
    if (not Result) and Assigned(ATextLines) then
      FreeAndNil(ATextLines);
  end;
end;


function TfrmMain.ShowSplitByPatternDialog(out ASourceFile: String; out APattern: String; out AIsRegex: Boolean; out AHeader, AFooter: String; out AUseEqualParts: Boolean; out AEqualPartsCount: Integer; out ARegexOp: TRegexOp; out AReplacement: String): Boolean;
var
  Frm: TMergeFilesDialogForm;
  LblSource, LblMode, LblPattern, LblHeader, LblFooter, LblRegexExamples: TLabel;
  LblPatternDesc, LblAutoPattern, LblHeaderDesc, LblFooterDesc: TLabel;
  LblReplacement: TLabel;
  EdtSource: TsFilenameEdit;
  cmbMode: TsComboBox;
  EdtPattern: TEdit;
  EdtReplacement: TEdit;
  ChkRegex: TCheckBox;
  SpnEqualParts: TsSpinEdit;
  MemoHeader, MemoFooter, MemoRegexExamples: TsMemo;
  BtnPreview, BtnOk, BtnCancel: TButton;
  CurFile: String;
  ButtonsTop: Integer;
  AutoHelper: TSplitPatternDialogAutoHelper;
begin
  Result := False;
  ASourceFile := '';
  APattern := '';
  AIsRegex := False;
  AUseEqualParts := False;
  AEqualPartsCount := 10;
  AHeader := '';
  AFooter := '';
  ARegexOp := roSplit;
  AReplacement := '';
  AutoHelper := nil;

  Frm := TMergeFilesDialogForm.CreateNew(Self);
  try
    Frm.Caption := TrText('Split file by Pattern/Regex');
    Frm.BorderStyle := bsDialog;
    Frm.KeyPreview := True;
    Frm.OnKeyDown := Frm.ForceEscKeyDown;
    FfPrepareDialog(Frm, 660, 620);

    LblSource := TLabel.Create(Frm);
    LblSource.Parent := Frm;
    LblSource.Left := 16;
    LblSource.Top := 16;
    LblSource.Caption := TrText('Source file to split:');

    EdtSource := TsFilenameEdit.Create(Frm);
    EdtSource.Parent := Frm;
    EdtSource.Left := 16;
    EdtSource.Top := 36;
    EdtSource.Width := 610;
    EdtSource.DialogKind := dkOpen;
    CurFile := Trim(edtFileName.Text);
    if (CurFile <> '') and (CurFile <> SELECTTEXT) then
      EdtSource.Text := CurFile;
    Frm.SetSourceEdit(EdtSource);

    LblMode := TLabel.Create(Frm);
    LblMode.Parent := Frm;
    LblMode.Left := 16;
    LblMode.Top := 80;
    LblMode.Caption := TrText('Split / process mode:');

    cmbMode := TsComboBox.Create(Frm);
    cmbMode.Parent := Frm;
    cmbMode.Left := 16;
    cmbMode.Top := 100;
    cmbMode.Width := 460;
    cmbMode.Style := csDropDownList;
    cmbMode.Items.Add(TrText('Split: start a new file when a line matches (pattern/regex)'));
    cmbMode.Items.Add(TrText('Split: equal parts (N parts, preserving complete lines)'));
    cmbMode.Items.Add(TrText('Regex match - extract all occurrences from each line  (like JS match)'));

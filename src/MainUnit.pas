procedure TfrmMain.TailMacroReprocessClick(Sender: TObject);
var
  From1, To1: Int64;
  N: Int64;
begin
  EnsureTailMacroPanel;
  TailMacroSyncEnabledFromUI;
  if not FTailMacroEnabled then
  begin
    ShowAppMessage(TrText('Enable "Use Python macros on new lines" first.'));
    Exit;
  end;
  if TailMacroScriptIsStubOnly then
  begin
    ShowAppMessage(TrText('Enter a tail macro script first.'));
    Exit;
  end;
  if not GetTailMacroSessionNewLineRange(From1, To1) then
  begin
    ShowAppMessage(TrText('No new lines in this Tail session yet. Enable Tail (Ctrl+T) and append lines to the file.'));
    Exit;
  end;
  ResetTailMacroBusyStateIfStale;
  if FTailMacroProcessing or Assigned(FTailMacroRunThread) then
  begin
    ShowAppMessage(TrText('Tail macro is already running. Wait for it to finish or close Script Engine runs.'));
    Exit;
  end;
  if Assigned(FScriptEngineRunThread) then
  begin
    ShowAppMessage(TrText('Script Engine is busy with a manual run. Wait for it to finish, then reprocess.'));
    Exit;
  end;
  FTailMacroPendingActive := False;
  N := To1 - From1 + 1;
  UpdateTailMacroStatus(Format(TrText('Tail macro: reprocessing %d line(s) from this Tail session...'), [N]));
  RunTailMacroOnNewLines(From1, To1, False);
end;


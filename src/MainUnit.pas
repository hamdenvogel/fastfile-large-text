function TfrmMain.ResolveMenuBitmapDir: string;
var
  BasePath: string;
  SearchRoot: string;
  I: Integer;
  function ResolveFromSubPath(const ARootPath, ASubPath: string): string;
  var
    Candidate: string;
  begin
    Result := '';
    Candidate := ExpandFileName(IncludeTrailingPathDelimiter(ARootPath) + ASubPath);
    if DirectoryExists(Candidate) then
      Result := IncludeTrailingPathDelimiter(Candidate);
  end;
begin
  Result := '';
  BasePath := ExtractFilePath(Application.ExeName);

  { Prefer glyphspro hot 16x16 and search from exe folder up through parent folders.
    This supports running from Src, project root, or bin folders. }
  SearchRoot := ExcludeTrailingPathDelimiter(BasePath);
  for I := 0 to 6 do
  begin
    Result := ResolveFromSubPath(SearchRoot, MENU_BITMAP_SUBPATH_HOT16);
    if Result <> '' then Exit;

    Result := ResolveFromSubPath(SearchRoot, MENU_BITMAP_SUBPATH_TRICH16);
    if Result <> '' then Exit;

    Result := ResolveFromSubPath(SearchRoot, MENU_BITMAP_SUBPATH_TRICH32);
    if Result <> '' then Exit;

    SearchRoot := ExtractFileDir(SearchRoot);
    if SearchRoot = '' then Break;
  end;
end;

procedure TfrmMain.BuildMenuBitmapImageList;
var
  IconDir: string;
  SearchRec: TSearchRec;
  Bmp: TBitmap;
  SizedBmp: TBitmap;
  ZoomSrc: TBitmap;
  ZoomSized: TBitmap;
  FileNames: TStringList;
  I: Integer;
  FilePath: string;
begin
  if not Assigned(FMenuBitmapImages) then
  begin
    FMenuBitmapImages := TImageList.Create(Self);
    FMenuBitmapImages.Width := 16;
    FMenuBitmapImages.Height := 16;
    FMenuBitmapImages.Masked := True;
  end
  else
  begin
    { Unlink first: every change of a linked image list makes the skinned
      menus re-measure all their items. Relinked at the end. }
    if MainMenu1.Images = FMenuBitmapImages then
      MainMenu1.Images := nil;
    if popupmenuListView.Images = FMenuBitmapImages then
      popupmenuListView.Images := nil;
    if Assigned(PopupMenu1) and (PopupMenu1.Images = FMenuBitmapImages) then
      PopupMenu1.Images := nil;
    if Assigned(PopupDialogs) and (PopupDialogs.Images = FMenuBitmapImages) then
      PopupDialogs.Images := nil;
    FMenuBitmapImages.Width := 16;
    FMenuBitmapImages.Height := 16;
    FMenuBitmapImages.Clear;
  end;

  if not Assigned(FMenuIconIndexByName) then
  begin
    FMenuIconIndexByName := TStringList.Create;
    FMenuIconIndexByName.CaseSensitive := False;
    FMenuIconIndexByName.Sorted := False;
    FMenuIconIndexByName.Duplicates := dupIgnore;
    FMenuIconIndexByName.NameValueSeparator := '=';
  end
  else
    FMenuIconIndexByName.Clear;

  IconDir := ResolveMenuBitmapDir;
  if IconDir = '' then
    Exit;

  FileNames := TStringList.Create;
  try
    if FindFirst(IconDir + '*.bmp', faAnyFile, SearchRec) = 0 then
    try
      repeat
        if (SearchRec.Attr and faDirectory) = 0 then
          FileNames.Add(SearchRec.Name);
      until FindNext(SearchRec) <> 0;
    finally
      FindClose(SearchRec);
    end;

    FileNames.Sort;
    for I := 0 to FileNames.Count - 1 do
    begin
      FilePath := IconDir + FileNames[I];
      Bmp := TBitmap.Create;
      SizedBmp := TBitmap.Create;
      try
        Bmp.LoadFromFile(FilePath);
        SizedBmp.PixelFormat := pf24bit;
        SizedBmp.Width := FMenuBitmapImages.Width;
        SizedBmp.Height := FMenuBitmapImages.Height;
        SizedBmp.Canvas.Brush.Color := clFuchsia;
        SizedBmp.Canvas.FillRect(Rect(0, 0, SizedBmp.Width, SizedBmp.Height));
        SetStretchBltMode(SizedBmp.Canvas.Handle, HALFTONE);
        StretchBlt(
          SizedBmp.Canvas.Handle,
          0, 0, SizedBmp.Width, SizedBmp.Height,
          Bmp.Canvas.Handle,
          0, 0, Bmp.Width, Bmp.Height,
          SRCCOPY
        );

        FMenuBitmapImages.AddMasked(SizedBmp, clFuchsia);
        { File names are unique: plain Add avoids the O(n) Values[] lookup per icon. }
        FMenuIconIndexByName.Add(LowerCase(FileNames[I]) + '=' + IntToStr(FMenuBitmapImages.Count - 1));
      finally
        SizedBmp.Free;
        Bmp.Free;
      end;
    end;
  finally
    FileNames.Free;
  end;

  { �cone de zoom da lista: copia ImageList1[IMAGELIST_IDX_ZOOM_LIST] para FMenuBitmapImages
    (o menu usa esta lista, n�o ImageList1 diretamente). }
  if Assigned(ImageList1) and (ImageList1.Count > IMAGELIST_IDX_ZOOM_LIST) then
  begin
    ZoomSrc := TBitmap.Create;
    ZoomSized := TBitmap.Create;
    try
      ZoomSrc.Width := ImageList1.Width;
      ZoomSrc.Height := ImageList1.Height;
      ZoomSrc.PixelFormat := pf24bit;
      ZoomSrc.Canvas.Brush.Color := clFuchsia;
      ZoomSrc.Canvas.FillRect(Rect(0, 0, ZoomSrc.Width, ZoomSrc.Height));
      ImageList1.Draw(ZoomSrc.Canvas, 0, 0, IMAGELIST_IDX_ZOOM_LIST);
      ZoomSized.PixelFormat := pf24bit;
      ZoomSized.Width := FMenuBitmapImages.Width;
      ZoomSized.Height := FMenuBitmapImages.Height;
      ZoomSized.Canvas.Brush.Color := clFuchsia;
      ZoomSized.Canvas.FillRect(Rect(0, 0, ZoomSized.Width, ZoomSized.Height));
      SetStretchBltMode(ZoomSized.Canvas.Handle, HALFTONE);
      StretchBlt(
        ZoomSized.Canvas.Handle,
        0, 0, ZoomSized.Width, ZoomSized.Height,
        ZoomSrc.Canvas.Handle,
        0, 0, ZoomSrc.Width, ZoomSrc.Height,
        SRCCOPY
      );
      FMenuBitmapImages.AddMasked(ZoomSized, clFuchsia);
      FMenuIconIndexByName.Values[LowerCase(FF_MENU_BMP_ZOOM_LIST)] :=
        IntToStr(FMenuBitmapImages.Count - 1);
    finally
      ZoomSized.Free;
      ZoomSrc.Free;
    end;
  end;

  MainMenu1.Images := FMenuBitmapImages;
  popupmenuListView.Images := FMenuBitmapImages;
  if Assigned(PopupMenu1) then
  begin
    if FMenuBitmapImages.Count > 0 then
      PopupMenu1.Images := FMenuBitmapImages
    else
      PopupMenu1.Images := CharImageList16;
  end;
  if Assigned(PopupDialogs) then
  begin
    if FMenuBitmapImages.Count > 0 then
      PopupDialogs.Images := FMenuBitmapImages
    else
      PopupDialogs.Images := CharImageList16;
  end;
  ApplySkinRelatedPopupMenuIcons;
end;

function TfrmMain.ResolveGlyphsHotBmp(const ABmpName: string): string;
var
  SearchRoot: string;

  function ResolveFile(const ARootPath, ASubPath, AFileName: string): string;
  var
    Candidate: string;
  begin
    Result := '';
    if Trim(AFileName) = '' then Exit;
    Candidate := ExpandFileName(IncludeTrailingPathDelimiter(ARootPath) + ASubPath + AFileName);
    if FileExists(Candidate) then
      Result := Candidate;
  end;

  function Walk(const ASubPath, AFileName: string): string;
  var
    Root: string;
    J: Integer;
  begin
    Result := '';
    Root := SearchRoot;
    for J := 0 to 6 do
    begin
      Result := ResolveFile(Root, ASubPath, AFileName);
      if Result <> '' then Exit;
      Root := ExtractFileDir(Root);
      if Root = '' then Break;
    end;
  end;

  function TryName(const AFileName: string): string;
  begin
    Result := Walk(MENU_BITMAP_SUBPATH_HOT24, AFileName);
    if Result <> '' then Exit;
    Result := Walk(MENU_BITMAP_SUBPATH_HOT16, AFileName);
  end;
begin
  Result := '';
  if Trim(ABmpName) = '' then Exit;
  SearchRoot := ExcludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName));

  Result := TryName(ABmpName);
  if Result <> '' then Exit;

  if SameText(ABmpName, MAIN_TB_ICON_SPLIT_FILES) then
    Result := TryName('Grid - Split Cells.bmp')
  else if SameText(ABmpName, MAIN_TB_ICON_MERGE_LINES) then
    Result := TryName('Grid - Merge Cells.bmp')
  else if SameText(ABmpName, MAIN_TB_ICON_HELP) or SameText(ABmpName, 'help.bmp') then
  begin
    Result := TryName('Help.bmp');
    if Result = '' then
      Result := TryName('help-2.bmp');
  end
  else if SameText(ABmpName, 'grid.bmp') then
    Result := TryName('Grid.bmp');
end;

function TfrmMain.AddImageList32Glyph(const ABmpName: string; AFallbackIndex: Integer): Integer;
var
  Path: string;
  Bmp, SizedBmp: TBitmap;
begin
  Result := AFallbackIndex;
  if not Assigned(ImageList32) then Exit;
  Path := ResolveGlyphsHotBmp(ABmpName);
  if Path = '' then Exit;

  Bmp := TBitmap.Create;
  SizedBmp := TBitmap.Create;
  try
    Bmp.LoadFromFile(Path);
    SizedBmp.PixelFormat := pf24bit;
    SizedBmp.Width := ImageList32.Width;
    SizedBmp.Height := ImageList32.Height;
    SizedBmp.Transparent := True;
    SizedBmp.TransparentColor := clFuchsia;
    SizedBmp.Canvas.Brush.Color := clFuchsia;
    SizedBmp.Canvas.FillRect(Rect(0, 0, SizedBmp.Width, SizedBmp.Height));
    SetStretchBltMode(SizedBmp.Canvas.Handle, HALFTONE);
    StretchBlt(
      SizedBmp.Canvas.Handle,
      0, 0, SizedBmp.Width, SizedBmp.Height,
      Bmp.Canvas.Handle,
      0, 0, Bmp.Width, Bmp.Height,
      SRCCOPY);
    Result := ImageList32.Add(SizedBmp, nil);
    if Result < 0 then
      Result := AFallbackIndex;
  finally
    SizedBmp.Free;
    Bmp.Free;
  end;
end;

procedure TfrmMain.CreateMainSplitMergeToolbarButtons;
const
  BTN_W = 118;
  BTN_COUNT = 7;
var
  InsertAt, Extra, I: Integer;
  Ctl: TControl;

  procedure PlaceBtn(var ABtn: TsSpeedButton; ALeft: Integer; AOnClick: TNotifyEvent);
  begin
    if not Assigned(ABtn) then
    begin
      ABtn := TsSpeedButton.Create(Self);
      ABtn.Parent := PanelToolButtons;
      ABtn.Align := alLeft;
      ABtn.Left := ALeft;
      ABtn.Top := 0;
      ABtn.Width := BTN_W;
      ABtn.Height := 71;
      ABtn.AllowAllUp := True;
      ABtn.Flat := True;
      ABtn.Spacing := 8;
      ABtn.Images := ImageList32;
      ABtn.ImageIndex := -1;
      ABtn.ShowHint := True;
      ABtn.SkinData.SkinSection := 'TOOLBUTTON';
      ABtn.Blend := 20;
      ABtn.Reflected := True;
    end;
    ABtn.OnClick := AOnClick;
  end;
begin
  if not Assigned(PanelToolButtons) or not Assigned(btnShowTabReadFile) then Exit;

  { DFM already has the 7 buttons: only wire OnClick (mi* handlers are private). }
  if Assigned(btnMainSplitFiles) then
  begin
    PlaceBtn(btnMainSplitFiles, 0, miSplitFilesClick);
    PlaceBtn(btnMainMergeLines, 0, miMergeLinesClick);
    PlaceBtn(btnMainMergeFiles, 0, miMergeFilesClick);
    PlaceBtn(btnMainCompareMerge, 0, miCompareMergeHistoryClick);
    PlaceBtn(btnMainSplitByPattern, 0, miSplitByPatternClick);
    PlaceBtn(btnMainSplitEqualParts, 0, miSplitEqualPartsClick);
    PlaceBtn(btnMainExtractParts, 0, miSplitFileFractionClick);
    Exit;
  end;

  InsertAt := btnShowTabReadFile.Left + btnShowTabReadFile.Width;
  Extra := BTN_COUNT * BTN_W;

  PanelToolButtons.DisableAlign;
  try
    for I := 0 to PanelToolButtons.ControlCount - 1 do
    begin
      Ctl := PanelToolButtons.Controls[I];
      if Ctl.Left >= InsertAt then
        Ctl.Left := Ctl.Left + Extra;
    end;

    PlaceBtn(btnMainSplitEqualParts, InsertAt, miSplitEqualPartsClick);
    PlaceBtn(btnMainMergeFiles, InsertAt + BTN_W, miMergeFilesClick);
    PlaceBtn(btnMainSplitFiles, InsertAt + BTN_W * 2, miSplitFilesClick);
    PlaceBtn(btnMainMergeLines, InsertAt + BTN_W * 3, miMergeLinesClick);
    PlaceBtn(btnMainCompareMerge, InsertAt + BTN_W * 4, miCompareMergeHistoryClick);
    PlaceBtn(btnMainSplitByPattern, InsertAt + BTN_W * 5, miSplitByPatternClick);
    PlaceBtn(btnMainExtractParts, InsertAt + BTN_W * 6, miSplitFileFractionClick);

    PanelToolButtons.Width := PanelToolButtons.Width + Extra;
  finally
    PanelToolButtons.EnableAlign;
  end;
end;

procedure TfrmMain.EnsureMainToolbarExitButtonLast;
var
  I, MaxRight: Integer;
  Ctl: TControl;
begin
  if not Assigned(PanelToolButtons) or not Assigned(btnClose) then Exit;
  MaxRight := 0;
  for I := 0 to PanelToolButtons.ControlCount - 1 do
  begin
    Ctl := PanelToolButtons.Controls[I];
    if (Ctl = nil) or (Ctl = btnClose) then Continue;
    if Assigned(sSpeedButton2) and (Ctl = sSpeedButton2) then Continue;
    if not Ctl.Visible then Continue;
    if Ctl.Align <> alLeft then Continue;
    if Ctl.Left + Ctl.Width > MaxRight then
      MaxRight := Ctl.Left + Ctl.Width;
  end;
  PanelToolButtons.DisableAlign;
  try
    if Assigned(sSpeedButton2) then
    begin
      sSpeedButton2.Left := MaxRight;
      Inc(MaxRight, sSpeedButton2.Width);
    end;
    btnClose.Left := MaxRight + 2;
    if btnClose.Left + btnClose.Width > PanelToolButtons.Width then
      PanelToolButtons.Width := btnClose.Left + btnClose.Width + 8;
  finally
    PanelToolButtons.EnableAlign;
  end;
end;


function ReadSplitPatternFileFirstPhysicalLines(const APath: String; const AMaxLines: Integer): String;
var
  F: TextFile;
  LineText: String;
  SB: TStringList;
  n: Integer;
begin
  Result := '';
  if (APath = '') or not FileExists(APath) or (AMaxLines <= 0) then Exit;
  SB := TStringList.Create;
  try
    AssignFile(F, APath);
    try
      Reset(F);
    except
      Exit;
    end;
    try
      n := 0;
      while (not Eof(F)) and (n < AMaxLines) do
      begin
        ReadLn(F, LineText);
        if (n = 0) and (Length(LineText) >= 3) and
           (Ord(LineText[1]) = $EF) and (Ord(LineText[2]) = $BB) and (Ord(LineText[3]) = $BF) then
          LineText := Copy(LineText, 4, MaxInt);
        LineText := Utf8HeuristicToDisplayString(LineText);
        if Length(LineText) > FF_SPLIT_PATTERN_MAX_LINE_CH then
          LineText := Copy(LineText, 1, FF_SPLIT_PATTERN_MAX_LINE_CH) + '...';
        SB.Add(LineText);
        Inc(n);
      end;
    finally
      CloseFile(F);
    end;
    Result := SB.Text;
  finally
    SB.Free;
  end;
end;

function BuildFixedWidthRegexExamples(RawLines: TStringList; const ASourceFile: String): String;
  procedure RegexEscToken(const S: String; var OutS: String);
  var ri: Integer;
  begin
    OutS := '';
    for ri := 1 to Length(S) do
      case S[ri] of
        '\', '.', '^', '$', '*', '+', '?', '(', ')', '[', ']', '{', '}', '|':
          OutS := OutS + '\\' + S[ri];
      else
        OutS := OutS + S[ri];
      end;
  end;

var
  SB: TStringList;
  Tokens: TStringList;
  MinLen, i, p, VarCol, lim, j: Integer;
  mismatch: Boolean;
  Alt, EscTok, TokDisp, Prefix2, TrailIsland, Trail8: String;
  Line0: String;
  SameTrail: Boolean;
  k: Integer;
  MatchIntro, MatchPat, SplitIntro, ReplaceSearch, TestPat, TrailNote: String;

  procedure AddDidactic(const Num: Integer; const Title, Intro, RegexPat, Logic: String; const ReplaceWith: String);
  begin
    SB.Add(IntToStr(Num) + '. ' + Title);
    if Trim(Intro) <> '' then
      SB.Add(Intro);
    SB.Add('Regex: ' + RegexPat);
    if Trim(ReplaceWith) <> '' then
      SB.Add(TrText('Replace with:') + ' ' + ReplaceWith);
    SB.Add(TrText('Logic:') + ' ' + Logic);
    SB.Add('');
  end;

  function LineStartsWithSixteenDigits(const S: String): Boolean;
  var z: Integer;
  begin
    Result := Length(S) >= 16;
    if not Result then Exit;
    for z := 1 to 16 do
      if not (S[z] in ['0'..'9']) then begin Result := False; Exit end;
  end;

  function MinLenAcross: Integer;
  var z: Integer;
  begin
    Result := MaxInt;
    for z := 0 to RawLines.Count - 1 do
      if Length(RawLines[z]) < Result then Result := Length(RawLines[z]);
  end;

  function FirstDiff(const a, b: String): Integer;
  var n, t: Integer;
  begin
    Result := 0;
    n := Min(Length(a), Length(b));
    for t := 1 to n do
      if a[t] <> b[t] then begin Result := t; Exit end;
  end;

  function DigitRunFrom(const S: String; StartCol: Integer): String;
  var r: Integer;
  begin
    Result := '';
    r := StartCol;
    while r <= Length(S) do
    begin
      if S[r] in ['0'..'9'] then Break;
      Inc(r);
    end;
    while (r <= Length(S)) and (S[r] in ['0'..'9']) do
    begin Result := Result + S[r]; Inc(r); end;
  end;

  function TrailingDigitIsland(const S: String): String;
  var r: Integer;
  begin
    Result := '';
    r := Length(S);
    while r >= 1 do
    begin
      if S[r] in ['0'..'9'] then Break;
      Dec(r);
    end;
    while (r >= 1) and (S[r] in ['0'..'9']) do
    begin Result := S[r] + Result; Dec(r); end;
  end;

begin
  SB := TStringList.Create;
  Tokens := TStringList.Create;
  try
    Tokens.Sorted := True;
    Tokens.Duplicates := dupIgnore;

    SB.Add(Format(TrText('Here are practical Regex examples applied to the data in file %s:'), [ExtractFileName(ASourceFile)]));
    SB.Add(Format(TrText('[Scan] Based on the first %d non-empty lines read from this file (maximum %d). Layout: fixed-width / positional (few delimiter characters on line 1).'),
      [RawLines.Count, MAX_SCAN_REF]));
    SB.Add(TrText('Each block has a short explanation, then a line starting with Regex:, then Logic:. FastFile uses VBScript.RegExp - lookbehind (?<=...) is not supported; lookahead (?=...) is supported.'));
    SB.Add('');

    Line0 := RawLines[0];
    MinLen := MinLenAcross;
    lim := Min(24, RawLines.Count);

    VarCol := 0;
    if RawLines.Count >= 2 then
    begin
      for p := 1 to MinLen do
      begin
        mismatch := False;
        for i := 1 to lim - 1 do
          if (p > Length(RawLines[i])) or (RawLines[i][p] <> RawLines[0][p]) then
          begin mismatch := True; Break end;
        if mismatch then begin VarCol := p; Break end;
      end;
      if VarCol = 0 then
        VarCol := FirstDiff(RawLines[0], RawLines[1]);
    end;

    if VarCol > 0 then
      for i := 0 to lim - 1 do
      begin
        Alt := DigitRunFrom(RawLines[i], VarCol);
        if Alt <> '' then Tokens.Add(Alt);
        if Tokens.Count >= 12 then Break;
      end;

    TrailIsland := TrailingDigitIsland(Line0);
    if Length(TrailIsland) >= 8 then
      Trail8 := Copy(TrailIsland, Length(TrailIsland) - 7, 8)
    else
      Trail8 := '';

    SameTrail := (Trail8 <> '') and (RawLines.Count >= 2);
    if SameTrail then
      for k := 1 to Min(8, RawLines.Count) - 1 do
      begin
        TrailIsland := TrailingDigitIsland(RawLines[k]);
        if Length(TrailIsland) >= 8 then
        begin
          if Copy(TrailIsland, Length(TrailIsland) - 7, 8) <> Trail8 then
            SameTrail := False;
        end
        else
          SameTrail := False;
      end;

    if LineStartsWithSixteenDigits(Line0) then
    begin
      MatchPat := '^(\d{8})(\d{8})';
      MatchIntro := TrText('Your first line begins with sixteen consecutive digits. They are grouped here as two blocks of eight (common for dates or IDs). Adjust grouping if your specification names different field widths.');
    end
    else
    begin
      MatchPat := '^(\d{10,})';
      MatchIntro := TrText('Captures the first long run of digits at the line start. Tune the minimum length {10,} after measuring columns in your layout.');
    end;

    if (Tokens.Count > 0) and (VarCol > 0) then
    begin
      TokDisp := '';
      for j := 0 to Tokens.Count - 1 do
      begin
        if j > 0 then TokDisp := TokDisp + ', ';
        TokDisp := TokDisp + Tokens[j];
      end;
      Alt := '';
      for j := 0 to Tokens.Count - 1 do
      begin
        RegexEscToken(Tokens[j], EscTok);
        if j > 0 then Alt := Alt + '|';
        Alt := Alt + EscTok;
      end;
      SplitIntro := Format(TrText('By comparing sample lines, the first column where characters differ is around position %d. Digit tokens observed there include: %s. Sorting the file by the field that should drive splitting usually gives meaningful parts.'),
        [VarCol, TokDisp]);
      if SameTrail and (Trail8 <> '') then
        SplitIntro := SplitIntro + ' ' + Format(TrText('Note: the last 8 digits of the trailing numeric island (%s) are the same on every scanned line - do not rely on ''split when the trailer changes'' until trailers differ; prefer this varying-column pattern.'),
          [Trail8]);
      AddDidactic(1, TrText('Split - start a new output file when a line matches'),
        SplitIntro, '^.{' + IntToStr(VarCol - 1) + '}(' + Alt + ')',
        TrText('In Split mode, each matching line starts a new output file (that line is the first line of the new part). Pick a pattern that matches only boundaries you want.'),
        '');
    end
    else
      AddDidactic(1, TrText('Split - record-type prefix (fallback)'),
        TrText('Not enough stable variation was detected between lines - try counting fixed positions manually, then refine this pattern.'),
        '^(\d{2})',
        TrText('Matches lines whose first two characters are digits (example: record type). Widen to ^(\d{3}) if your layout uses three type digits.'),
        '');

    AddDidactic(2, TrText('Regex Match - capture leading structured numbers'),
      MatchIntro, MatchPat,
      TrText('Match mode emits captured text per occurrence; parentheses define what is extracted.'),
      '');

    Prefix2 := '';
    if Length(Line0) >= 2 then Prefix2 := Copy(Line0, 1, 2);
    if Prefix2 <> '' then
    begin
      RegexEscToken(Prefix2, EscTok);
      TestPat := '^' + EscTok;
    end
    else
      TestPat := '^..';

    AddDidactic(3, TrText('Regex Test - line begins with expected prefix'),
      Format(TrText('Fixed layouts often encode record type in the first positions. First characters of line 1 (sample): %s.'),
        [Copy(Line0, 1, Min(12, Length(Line0)))]),
      TestPat,
      TrText('Test writes true or false per input line - ideal for quickly validating row types.'),
      '');

    ReplaceSearch := '^(.{2})(.{15})(.{15})(.+)$';
    AddDidactic(4, TrText('Regex Replace - turn fixed columns into separated fields'),
      TrText('Count character positions with a fixed font or specification sheet, then edit each (. {n} ) length. This example splits into four segments and inserts semicolons.'),
      ReplaceSearch,
      TrText('Replace runs on each line; $1..$4 refer to the captured groups from left to right.'),
      '$1;$2;$3;$4');

    if Trail8 <> '' then
    begin
      RegexEscToken(Trail8, EscTok);
      if SameTrail then
        TrailNote := ' ' + TrText('Same 8-digit trailer on all scanned lines - this pattern matches every line or none; narrow using column-specific substring tests if needed.')
      else
        TrailNote := '';
      AddDidactic(5, TrText('Regex Filter - lines whose numeric trailer ends with eight digits'),
        Format(TrText('The last eight digits of the final digit island on the first line look like %s (often a DDMMYYYY-style date).'), [Trail8]) + TrailNote,
        EscTok + '$',
        TrText('Filter keeps only lines where the regex matches - combine with positional ^.{n} if you must anchor to a column.'),
        '');
    end
    else
      AddDidactic(5, TrText('Regex Filter - eight digits before end of line'),
        TrText('No stable 8-digit trailer was inferred - generic pattern.'),
        '(\d{8})$',
        TrText('Keeps lines where eight consecutive digits appear just before the end.'),
        '');

    AddDidactic(6, TrText('Regex Match - meaningful digit runs (skip zero padding)'),
      TrText('Extracts digit sequences that do not start with zero and have length four or more - helps ignore long padding fields.'),
      '[1-9]\d{3,}',
      TrText('Useful to sample IDs and amounts embedded between runs of zeros.'),
      '');

    Result := SB.Text;
  finally
    Tokens.Free;
    SB.Free;
  end;
end;

{ ?? BuildFileBasedExamples ????????????????????????????????????????????????????
  Reads up to MAX_SCAN non-empty lines from ASourceFile, auto-detects the
  delimiter and column structure, and returns an English text block with
  concrete regex suggestions for every mode (filter/test/match/replace/split)
  tailored to the actual content. ???????????????????????????????????????????? }
function BuildFileBasedExamples(const ASourceFile: String): String;
var
  F: TextFile;
  RawLines: TStringList;
  LineText, V, DelimEsc, TitleAlt, SampleRegion, SampleSpecialty: String;
  LeadPat, PatIntro: String;
  EscRegion, EscSpec: String;
  LineCount, i, Col, ki: Integer;
  Delim: Char;
  MaxDelimCount, ThisCount: Integer;
  D: Char;
  Candidates: String;
  Parts, Headers, SB: TStringList;
  ColCount: Integer;
  TitleCol, SpecialtyCol, RegionCol: Integer;
  TeleCol, ReviewCol: Integer;
  HasDr, HasDra, HasProf: Boolean;
  ColAllInt:  array[0..MAX_COLS - 1] of Boolean;
  ColAllNum:  array[0..MAX_COLS - 1] of Boolean;
  ColHasDate: array[0..MAX_COLS - 1] of Boolean;
  ColHasUrl:  array[0..MAX_COLS - 1] of Boolean;
  ColHasEmail:array[0..MAX_COLS - 1] of Boolean;
  ColAllBool: array[0..MAX_COLS - 1] of Boolean;
  ColSample:  array[0..MAX_COLS - 1] of String;
  HasHeader:  Boolean;
  FirstData:  Integer;
  URLDomain:  String;

  { ?? nested helpers ??????????????????????????????????????????????????????? }
  function IsInt(const S: String): Boolean;
  var k: Integer;
  begin
    Result := S <> '';
    for k := 1 to Length(S) do
      if (S[k] = '-') and (k = 1) then { leading minus ok }
      else if not (S[k] in ['0'..'9']) then
      begin Result := False; Exit; end;
    if (Length(S) = 1) and (S[1] = '-') then Result := False;
  end;

  function IsNum(const S: String): Boolean;
  var k, Dots: Integer;
  begin
    Result := S <> ''; Dots := 0;
    for k := 1 to Length(S) do
    begin
      if S[k] = '.' then Inc(Dots)
      else if (S[k] = ',') then { Brazilian decimal comma - skip }
      else if (S[k] = '-') and (k = 1) then { leading minus ok }
      else if not (S[k] in ['0'..'9']) then begin Result := False; Exit; end;
    end;
    if Dots > 1 then Result := False;
    if (Length(S) = 1) and (S[1] = '-') then Result := False;
  end;

  function IsDate(const S: String): Boolean;
  begin
    Result :=
      (Length(S) >= 10) and
      (
        { ISO 8601: 2022-10-28 }
        ((S[5] = '-') and (S[8] = '-') and (S[1] in ['1','2'])) or
        { dd/mm/yyyy or dd-mm-yyyy }
        ((S[3] in ['/']) and (S[6] in ['/'])) or
        ((S[3] = '-') and (S[6] = '-') and (S[1] in ['0','1','2','3']))
      );
  end;

  function IsUrl(const S: String): Boolean;
  begin
    Result := (PosBMH('http://', S) = 1) or (PosBMH('https://', S) = 1);
  end;

  function IsEmail(const S: String): Boolean;
  var at: Integer;
  begin
    at := PosBMH('@', S);
    Result := (at > 1) and (PosBMH('.', Copy(S, at + 1, MaxInt)) > 0);
  end;

  function IsBool(const S: String): Boolean;
  begin
    Result := (S = '0') or (S = '1') or
              SameText(S, 'true') or SameText(S, 'false') or
              SameText(S, 'yes')  or SameText(S, 'no');
  end;

  function SplitByDelim(const S: String; D: Char): TStringList;
  var si, startPos: Integer; inQ: Boolean;
  begin
    Result := TStringList.Create;
    startPos := 1; inQ := False;
    for si := 1 to Length(S) do
    begin
      if S[si] = '"' then inQ := not inQ
      else if (S[si] = D) and not inQ then
      begin
        Result.Add(Copy(S, startPos, si - startPos));
        startPos := si + 1;
      end;
    end;
    Result.Add(Copy(S, startPos, MaxInt));
  end;

  function ColName(const ACol: Integer): String;
  begin
    if HasHeader and (ACol < Headers.Count) and (Trim(Headers[ACol]) <> '') then
      Result := '"' + Trim(Headers[ACol]) + '"'
    else
      Result := 'col ' + IntToStr(ACol + 1);
  end;

  function RegexEscape(const S: String): String;
  var
    ri: Integer;
  begin
    Result := '';
    for ri := 1 to Length(S) do
    begin
      case S[ri] of
        '\', '.', '^', '$', '*', '+', '?', '(', ')', '[', ']', '{', '}', '|':
          Result := Result + '\\' + S[ri];
      else
        Result := Result + S[ri];
      end;
    end;
  end;

  function FindColByHint(const Hint: String): Integer;
  var
    fi: Integer;
    H, LHint: String;
  begin
    Result := -1;
    LHint := AnsiLowerCase(Hint);
    for fi := 0 to ColCount - 1 do
    begin
      if fi >= Headers.Count then Break;
      H := AnsiLowerCase(Trim(Headers[fi]));
      if (H <> '') and (PosBMH(LHint, H) > 0) then
      begin
        Result := fi;
        Exit;
      end;
    end;
  end;

  procedure AddDidacticRow(const Num: Integer; const Title, Intro, RegexPat, Logic: String; const ReplaceWith: String);
  begin
    SB.Add(IntToStr(Num) + '. ' + Title);
    if Trim(Intro) <> '' then
      SB.Add(Intro);
    SB.Add('Regex: ' + RegexPat);
    if Trim(ReplaceWith) <> '' then
      SB.Add(TrText('Replace with:') + ' ' + ReplaceWith);
    SB.Add(TrText('Logic:') + ' ' + Logic);
    SB.Add('');
  end;

begin
  Result := '(Open a source file to see' + #13#10 + 'auto-generated suggestions.)';
  if (ASourceFile = '') or not FileExists(ASourceFile) then Exit;

  RawLines := TStringList.Create;
  try
    AssignFile(F, ASourceFile);
    try
      Reset(F);
    except
      Exit;
    end;
    try
      LineCount := 0;
      while (not Eof(F)) and (LineCount < MAX_SCAN) do
      begin
        ReadLn(F, LineText);
        if Trim(LineText) <> '' then
        begin
          { Strip UTF-8 BOM from first line if present }
          if (LineCount = 0) and (Length(LineText) >= 3) and
             (Ord(LineText[1]) = $EF) and (Ord(LineText[2]) = $BB) and (Ord(LineText[3]) = $BF) then
            LineText := Copy(LineText, 4, MaxInt);
          { CSV/texto UTF-8 sem BOM: octetos como AnsiString -> exibir acentos corretamente }
          LineText := Utf8HeuristicToDisplayString(LineText);
          RawLines.Add(LineText);
          Inc(LineCount);
        end;
      end;
    finally
      CloseFile(F);
    end;

    if RawLines.Count = 0 then Exit;

    { Detect delimiter from first line }
    Delim := ',';
    MaxDelimCount := 0;
    Candidates := ',;|' + #9;
    for ki := 1 to Length(Candidates) do
    begin
      D := Candidates[ki];
      ThisCount := 0;
      for i := 1 to Length(RawLines[0]) do
        if RawLines[0][i] = D then Inc(ThisCount);
      if ThisCount > MaxDelimCount then
      begin
        MaxDelimCount := ThisCount;
        Delim := D;
      end;
    end;

    { Escape delimiter for use inside regex character classes / patterns }
    case Delim of
      '|': DelimEsc := '\|';
      '.': DelimEsc := '\.';
      else DelimEsc := Delim; { comma, semicolon, tab are safe }
    end;

    { Few delimiter chars on first line + long rows -> positional / fixed-width (per-file dynamic guide). }
    if (MaxDelimCount <= 2) and (Length(RawLines[0]) >= 40) then
    begin
      Result := BuildFixedWidthRegexExamples(RawLines, ASourceFile);
      Exit;
    end;

    Headers := SplitByDelim(RawLines[0], Delim);
    try
      ColCount := Headers.Count;
      if ColCount > MAX_COLS then ColCount := MAX_COLS;

      { First row is a header if none of its tokens is a pure integer }
      HasHeader := True;
      for i := 0 to Headers.Count - 1 do
        if IsInt(Trim(Headers[i])) then begin HasHeader := False; Break; end;
      if HasHeader then FirstData := 1 else FirstData := 0;

      { Initialise per-column stats }
      for Col := 0 to ColCount - 1 do
      begin
        ColAllInt[Col]  := True;
        ColAllNum[Col]  := True;
        ColHasDate[Col] := False;
        ColHasUrl[Col]  := False;
        ColHasEmail[Col]:= False;
        ColAllBool[Col] := True;
        ColSample[Col]  := '';
      end;

      TitleCol := FindColByHint('title');
      SpecialtyCol := FindColByHint('special');
      if SpecialtyCol < 0 then SpecialtyCol := FindColByHint('category');
      if SpecialtyCol < 0 then SpecialtyCol := FindColByHint('expertise');
      RegionCol := FindColByHint('region');
      if RegionCol < 0 then RegionCol := FindColByHint('city');
      TeleCol := FindColByHint('telemedic');
      ReviewCol := FindColByHint('review');

      HasDr := False;
      HasDra := False;
      HasProf := False;

      { Analyse data lines }
      for i := FirstData to RawLines.Count - 1 do
      begin
        Parts := SplitByDelim(RawLines[i], Delim);
        try
          for Col := 0 to ColCount - 1 do
          begin
            if Col < Parts.Count then
              V := Trim(Parts[Col])
            else
              V := '';

            if V = '' then
            begin
              ColAllInt[Col]  := False;
              ColAllNum[Col]  := False;
              ColAllBool[Col] := False;
              Continue;
            end;

            if ColSample[Col] = '' then ColSample[Col] := V;
            if not IsInt(V)  then ColAllInt[Col]  := False;
            if not IsNum(V)  then ColAllNum[Col]  := False;
            if IsDate(V)     then ColHasDate[Col] := True;
            if IsUrl(V)      then ColHasUrl[Col]  := True;
            if IsEmail(V)    then ColHasEmail[Col]:= True;
            if not IsBool(V) then ColAllBool[Col] := False;

            if (Col = TitleCol) then
            begin
              if SameText(V, 'Dr.') then HasDr := True
              else if SameText(V, 'Dra.') then HasDra := True
              else if SameText(V, 'Prof.') then HasProf := True;
            end;
          end;
        finally
          Parts.Free;
        end;
      end;   
        
        SampleRegion := '';
        if (RegionCol >= 0) and (RegionCol < ColCount) and (Trim(ColSample[RegionCol]) <> '') then
          SampleRegion := Trim(ColSample[RegionCol]);
        SampleSpecialty := '';
        if (SpecialtyCol >= 0) and (SpecialtyCol < ColCount) and (Trim(ColSample[SpecialtyCol]) <> '') then
          SampleSpecialty := Trim(ColSample[SpecialtyCol]);

        if SampleRegion = '' then SampleRegion := 'region-slug-sample';
        EscRegion := RegexEscape(SampleRegion);
        if SampleSpecialty = '' then
          EscSpec := RegexEscape('specialty-sample')
        else
          EscSpec := RegexEscape(SampleSpecialty);

        if HasDr or HasDra then
          TitleAlt := ColName(TitleCol) + ' + name'
        else if TitleCol >= 0 then
          TitleAlt := ColName(TitleCol)
        else
          TitleAlt := 'title';

        { -- Build output ----------------------------------------------------- }
        SB := TStringList.Create;
        try
          SB.Add(Format(TrText('Here are practical Regex examples applied to the data in file %s:'), [ExtractFileName(ASourceFile)]));
          if Delim = #9 then
            V := TrText('TAB')
          else
            V := Delim;
          SB.Add(Format(TrText('[Scan] Based on the first %d non-empty lines (maximum %d). Detected delimiter [%s], fields: %d.'),
            [RawLines.Count, MAX_SCAN, V, ColCount]));
          SB.Add(TrText('Each block explains the goal, then shows Regex:, then Logic:. FastFile uses VBScript.RegExp (no (?<=...) lookbehind).'));
          SB.Add('');

          AddDidacticRow(1, TrText('Split - start a new file when a delimiter-separated token appears'),
            Format(TrText('Sample tokens inferred from your columns - primary (region-like): "%s". Alternate token useful when categories drive file boundaries: "%s". Sort by the active key before splitting so each part stays coherent.'),
              [SampleRegion, SampleSpecialty]) + ' ' +
            Format(TrText('Secondary pattern (same mode): Regex: ^.*,%s,.*$'), [EscSpec]),
            '^.*,' + EscRegion + ',.*$',
            TrText('Split mode opens a new output file at every line where Test(regex) is true - tighten the wildcards so only real boundaries match.'),
            '');

          SB.Add('2. ' + TrText('Equal-length splits without Regex'));
          SB.Add(TrText('To split into N equal parts by line count or size, use FastFile''s equal-parts workflow instead of Regex - Regex cannot count lines across the whole file in one Test call.'));
          SB.Add('');

          if ColAllInt[0] then
          begin
            LeadPat := '^\d+';
            PatIntro := TrText('Column 1 in the sampled rows appears numeric-only - pattern grabs leading digits.');
          end
          else
          begin
            LeadPat := '^(\S+)';
            PatIntro := TrText('Column 1 mixes token shapes - pattern captures the first non-whitespace field.');
          end;
          AddDidacticRow(3, TrText('Regex Match - first column / leading token'),
            PatIntro,
            LeadPat,
            Format(TrText('Match pulls captures per line - extend pattern for %s or other columns as needed.'), [ColName(0)]),
            '');

          AddDidacticRow(4, TrText('Regex Match - HTTP(S) URLs embedded in fields'),
            TrText('Useful when a column stores URLs; anchors may need quotes or extra delimiters for your file.'),
            'https?://[^,\s]+',
            TrText('Broad matcher - narrow with surrounding delimiter context if you see false positives.'),
            '');

          AddDidacticRow(5, TrText('Regex Test - delimiter / field-count sanity check'),
            TrText('Confirms the line has exactly the expected number of delimiter-separated fields for this layout.'),
            '^(?:[^' + DelimEsc + '\r\n]*' + DelimEsc + '){' +
              IntToStr(ColCount - 1) + '}[^' + DelimEsc + '\r\n]*$',
            TrText('Outputs true/false per line - ideal after CSV imports or conversions.'),
            '');

          if TeleCol >= 0 then
            AddDidacticRow(6, TrText('Regex Test - optional flag column'),
              Format(TrText('Column "%s" in the sample suggests a 1/0 style flag after an ISO-like timestamp; adjust literals if your timestamp differs.'), [Trim(Headers[TeleCol])]),
              'T\d{2}:\d{2}:\d{2}[+-]\d{2}:\d{2},\s*1\s*,',
              TrText('Combine with item 5 if you need both shape and business-rule checks.'),
              '')
          else
            AddDidacticRow(6, TrText('Regex Test - numeric flag between delimiters'),
              TrText('Example targets ",1," style markers - edit spacing and commas for your delimiter style.'),
              ',\s*1\s*,',
              TrText('Combine multiple tests if one rule is insufficient.'),
              '');

          AddDidacticRow(7, TrText('Regex Replace - anonymize professional prefix + name'),
            Format(TrText('Targets Dr./Dra. patterns together with the following name field (%s). VBScript-safe (no lookbehind).'), [TitleAlt]),
            ',(Dr\.|Dra\.),([^,]+),',
            TrText('Replace substitutes only capture group 2 while keeping the honorific in group 1.'),
            ',$1,NAME_REDACTED,');

          URLDomain := '';
          for Col := 0 to ColCount - 1 do
            if ColHasUrl[Col] then
            begin
              URLDomain := Trim(ColSample[Col]);
              if PosBMH('https://', URLDomain) = 1 then URLDomain := Copy(URLDomain, 9, MaxInt)
              else if PosBMH('http://', URLDomain) = 1 then URLDomain := Copy(URLDomain, 8, MaxInt);
              i := PosBMH('/', URLDomain);
              if i > 0 then URLDomain := Copy(URLDomain, 1, i - 1);
              if URLDomain <> '' then
                AddDidacticRow(8, TrText('Regex Replace - trim duplicate profile suffix from URL'),
                  Format(TrText('Detected host/path style domain sample from column data: %s'), [URLDomain]),
                  '(https?://' + RegexEscape(URLDomain) + '/[a-z0-9-]+)-\d+',
                  TrText('Removes trailing -2 / -3 style duplicates while keeping the canonical slug.'),
                  '$1');
              Break;
            end;

          if ReviewCol >= 0 then
            AddDidacticRow(9, TrText('Regex Filter - numeric threshold inside a column'),
              Format(TrText('Focus column "%s": keep rows where that field shows three or more digit characters starting with 1-9 (example: counts 100+).'), [Trim(Headers[ReviewCol])]),
              '^(?:[^' + DelimEsc + '\r\n]*' + DelimEsc + '){' +
                IntToStr(ReviewCol) + '}[1-9]\d{2,},',
              Format(TrText('Filter keeps matching lines only - tune digit counts for %s after profiling real values.'), [ColName(ReviewCol)]),
              '')
          else
            AddDidacticRow(9, TrText('Regex Filter - large integers embedded in the row'),
              TrText('Broad pattern that may touch multiple numeric columns - prefer anchoring with column-specific prefixes when possible.'),
              ',[1-9]\d{2,},',
              TrText('Narrow the surrounding context once you identify which column must exceed a threshold.'),
              '');

          Result := SB.Text;
      finally
        SB.Free;
      end;

    finally
      Headers.Free;
    end;
  finally
    RawLines.Free;
  end;
end;

procedure TSplitPatternDialogAutoHelper.UpdateExamples;
var
  SourcePath: String;
  ExamplesText: String;
  ModeIdx: Integer;
  Lines: TStringList;
  L, ExamplePattern: String;
  i: Integer;
  CanApplyExample: Boolean;
begin
  if not Assigned(FMemoRegexExamples) then Exit;
  if not Assigned(FSourceEdit) then Exit;
  if not Assigned(FModeCombo) then Exit;

  ModeIdx := FModeCombo.ItemIndex;
  SourcePath := Trim(FSourceEdit.Text);

  if (SourcePath = '') or not FileExists(SourcePath) then
    ExamplesText := TrText('Choose a source file to generate mode-specific examples.')
  else
    ExamplesText := BuildRegexCategoryExamples(SourcePath, ModeIdx);

  FMemoRegexExamples.Text := ExamplesText;

  if Assigned(FPatternEdit) and (ModeIdx <> 1) then
  begin
    ExamplePattern := '';
    Lines := TStringList.Create;
    try
      Lines.Text := ExamplesText;
      for i := 0 to Lines.Count - 1 do
      begin
        L := Trim(Lines[i]);
        if PosBMH('Regex:', L) = 1 then
        begin
          ExamplePattern := Trim(Copy(L, Length('Regex:') + 1, MaxInt));
          Break;
        end;
      end;
    finally
      Lines.Free;
    end;

    if ExamplePattern <> '' then
    begin
      CanApplyExample :=
        (Trim(FPatternEdit.Text) = '') or
        SameText(Trim(FPatternEdit.Text), Trim(FLastExamplePattern)) or
        (FHasAutoSuggestion and SameText(Trim(FPatternEdit.Text), Trim(FLastAutoPattern)));

      if CanApplyExample then
      begin
        FPatternEdit.Text := ExamplePattern;
        FLastExamplePattern := ExamplePattern;

        if Assigned(FRegexCheck) then
          FRegexCheck.Checked := True;
      end;
    end;
  end;

  if Assigned(FRegexExamplesLabel) then
    FRegexExamplesLabel.Caption := TrText('Mode-specific examples (auto-detected from file):');
end;

procedure TSplitPatternDialogAutoHelper.AutoSuggestNow;
begin
  FLastScannedFile := '';
  ApplySuggestion;
  UpdateModeControls;
end;

procedure TSplitPatternDialogAutoHelper.PreviewClick(Sender: TObject);
var
  PreviewText, PreviewError: String;
begin
  if not Assigned(FSourceEdit) then Exit;

  if Trim(FSourceEdit.Text) = '' then
  begin
    FastFileMsgInfo(TrText('Source file is required.'));
    Exit;
  end;

  if not FileExists(Trim(FSourceEdit.Text)) then
  begin
    FastFileMsgInfo(TrText('Source file not found.'));
    Exit;
  end;

  if Assigned(FModeCombo) and (FModeCombo.ItemIndex = 1) then
  begin
    if Assigned(FEqualPartsSpin) then
      FastFileMsgInfo(Format(TrText('Equal-parts mode preview: file will be split into %d parts, preserving complete lines.'), [Integer(FEqualPartsSpin.Value)]))
    else
      FastFileMsgInfo(TrText('Equal-parts mode preview: file will be split preserving complete lines.'));
    Exit;
  end;

  if not Assigned(FPatternEdit) or (Trim(FPatternEdit.Text) = '') then
  begin
    FastFileMsgInfo(TrText('Pattern cannot be empty.'));
    Exit;
  end;

  if not PreviewPatternMatchesInFile(Trim(FSourceEdit.Text), FPatternEdit.Text,
    Assigned(FRegexCheck) and FRegexCheck.Checked, 40, PreviewText, PreviewError) then
  begin
    if Trim(PreviewError) = '' then
      PreviewError := TrText('Unknown error.');
    FastFileMsgInfo(TrText('Could not build preview for pattern/regex:') + ' ' + PreviewError);
    Exit;
  end;

  FastFileMsgInfo(PreviewText);
end;

function TfrmMain.CurrentViewEncoding: string;
begin
  Result := EffectiveDisplayEncoding;
end;

function TfrmMain.EffectiveDisplayEncoding: string;
begin
  if Trim(FForcedViewEncoding) <> '' then
  begin
    Result := FForcedViewEncoding;
    Exit;
  end;
  if (not Assigned(comboViewEncoding)) or (comboViewEncoding.ItemIndex < 0) then
  begin
    Result := FDetectedEncoding;
    Exit;
  end;
  case comboViewEncoding.ItemIndex of
    0: Result := FDetectedEncoding; { DEFAULT = detected (BOM / heuristics) }
    1: Result := 'UTF-8';
    2: Result := 'ANSI';
    3: Result := 'UTF-16 LE';
    4: Result := 'UTF-16 BE';
    5: Result := 'UTF-32 LE';
    6: Result := 'UTF-32 BE';
  else
    Result := FDetectedEncoding;
  end;
end;

procedure TfrmMain.ApplyViewEncodingRefresh;
begin
  InvalidateLineCache;
  if Assigned(ListView1) then
    ListView1.Refresh;
  UpdateInfoPanels;
end;

procedure TfrmMain.HookedStatusBarWndProcForCombo(var Message: TMessage);
begin
  if Assigned(FOldStatusBarWndProcForCombo) then
    FOldStatusBarWndProcForCombo(Message);

  if (Message.Msg = WM_COMMAND) and Assigned(comboViewEncoding) and
     (HWND(Message.LParam) = comboViewEncoding.Handle) and (not FUpdatingViewEncodingCombo) then
  begin
    case Word(Message.WParam shr 16) of
      CBN_CLOSEUP:
        ApplyViewEncodingRefresh;
    end;
  end;
end;

procedure TfrmMain.comboViewEncodingChange(Sender: TObject);
begin
  if FUpdatingViewEncodingCombo then Exit;
  FForcedViewEncoding := '';
  ApplyViewEncodingRefresh;
end;



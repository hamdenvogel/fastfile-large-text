procedure TfrmMain.RecentTabFilesCustomDrawItem(Sender: TCustomListView;
  Item: TListItem; State: TCustomDrawState; var DefaultDraw: Boolean);
var
  FilePath: string;
  HasSession: Boolean;
begin
  DefaultDraw := True;
  if not Assigned(Item) then Exit;
  if Item.SubItems.Count < 1 then Exit;

  FilePath := IncludeTrailingPathDelimiter(Item.SubItems[0]) + Item.Caption;
  HasSession := (Item.SubItems.Count > 4) and (Trim(Item.SubItems[4]) <> '');

  Sender.Canvas.Font.Style := [];
  if cdsSelected in State then
  begin
    Sender.Canvas.Brush.Color := $00F2F2F2;
    Sender.Canvas.Font.Color := clWindowText;
    Sender.Canvas.Font.Style := [fsBold];
  end
  else if not FileExists(FilePath) then
  begin
    Sender.Canvas.Brush.Color := clInfoBk;
    Sender.Canvas.Font.Color := clGrayText
  end
  else if HasSession then
  begin
    Sender.Canvas.Brush.Color := clWindow;
    Sender.Canvas.Font.Color := clNavy;
    Sender.Canvas.Font.Style := [fsBold];
  end
  else
  begin
    Sender.Canvas.Brush.Color := clWindow;
    Sender.Canvas.Font.Color := clWindowText;
  end;
end;

procedure TfrmMain.RecentTabFilesColumnClick(Sender: TObject; Column: TListColumn);
var
  LV: TListView;
begin
  if not (Sender is TListView) then Exit;
  if Column.Index = 6 then Exit;  { delete column is not sortable }
  LV := TListView(Sender);

  if FRecentFilesSortColumn = Column.Index then
    FRecentFilesSortAsc := not FRecentFilesSortAsc
  else
  begin
    FRecentFilesSortColumn := Column.Index;
    { Size grows asc by default; date columns default to newest first. }
    if (Column.Index = 3) or (Column.Index = 4) then
      FRecentFilesSortAsc := False
    else
      FRecentFilesSortAsc := True;
  end;

  LV.AlphaSort;
  SaveRecentFilesTabPrefs;
end;

procedure TfrmMain.RecentTabFilesMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
type
  TLVSubItemHitTest = packed record
    pt: TPoint;
    flags: UINT;
    iItem: Integer;
    iSubItem: Integer;
  end;
var
  LV: TListView;
  HitInfo: TLVSubItemHitTest;
begin
  if not (Sender is TListView) then Exit;
  LV := TListView(Sender);

  FillChar(HitInfo, SizeOf(HitInfo), 0);
  HitInfo.pt.X := X;
  HitInfo.pt.Y := Y;
  SendMessage(LV.Handle, LVM_SUBITEMHITTEST, 0, LPARAM(@HitInfo));

  if (HitInfo.iItem >= 0) and (HitInfo.iSubItem = 6) then
    LV.Cursor := crHandPoint
  else
    LV.Cursor := crDefault;
end;

procedure TfrmMain.RecentTabFilesMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
type
  TLVSubItemHitTest = packed record
    pt: TPoint;
    flags: UINT;
    iItem: Integer;
    iSubItem: Integer;
  end;
var
  LV: TListView;
  HitInfo: TLVSubItemHitTest;
  Item: TListItem;
  FilePath: string;
begin
  if Button <> mbLeft then Exit;
  if not (Sender is TListView) then Exit;
  LV := TListView(Sender);

  FillChar(HitInfo, SizeOf(HitInfo), 0);
  HitInfo.pt.X := X;
  HitInfo.pt.Y := Y;
  SendMessage(LV.Handle, LVM_SUBITEMHITTEST, 0, LPARAM(@HitInfo));

  if (HitInfo.iItem < 0) or (HitInfo.iSubItem <> 6) then Exit;

  Item := LV.Items[HitInfo.iItem];
  if not Assigned(Item) then Exit;
  if Item.SubItems.Count < 1 then Exit;

  FilePath := IncludeTrailingPathDelimiter(Item.SubItems[0]) + Item.Caption;
  if FastFileMessageBox(
    PChar(TrText('Remove selected file from recent list?') + #13#10 + FilePath),
    APPLICATION_NAME, MB_ICONQUESTION or MB_YESNO) <> IDYES then
    Exit;

  RemoveRecentFileByPath(FilePath);
end;

procedure TfrmMain.RecentTabFilesCompare(Sender: TObject; Item1, Item2: TListItem;
  Data: Integer; var Compare: Integer);
var
  S1, S2: string;

  function GetColText(AItem: TListItem; ACol: Integer): string;
  begin
    if not Assigned(AItem) then
      Result := ''
    else if ACol = 0 then
      Result := AItem.Caption
    else if AItem.SubItems.Count >= ACol then
      Result := AItem.SubItems[ACol - 1]
    else
      Result := '';
  end;

  function ParseSizeToBytes(const AText: string): Int64;
  var
    N: Extended;
    T: string;
  begin
    T := UpperCase(Trim(AText));
    Result := -1;
    if T = '' then Exit;
    if T = '-' then Exit;

    T := StringReplace(T, ',', '.', [rfReplaceAll]);
    if PosBMH(' GB', T) > 0 then
      N := StrToFloatDef(StringReplace(T, ' GB', '', []), 0)
    else if PosBMH(' MB', T) > 0 then
      N := StrToFloatDef(StringReplace(T, ' MB', '', []), 0) / 1024
    else if PosBMH(' KB', T) > 0 then
      N := StrToFloatDef(StringReplace(T, ' KB', '', []), 0) / 1024 / 1024
    else if PosBMH(' B', T) > 0 then
      N := StrToFloatDef(StringReplace(T, ' B', '', []), 0) / 1024 / 1024 / 1024
    else
      N := StrToFloatDef(T, 0);

    Result := Round(N * 1024 * 1024 * 1024);
  end;

var
  I1, I2: Int64;
begin
  if not Assigned(Item1) or not Assigned(Item2) then
  begin
    Compare := 0;
    Exit;
  end;

  S1 := GetColText(Item1, FRecentFilesSortColumn);
  S2 := GetColText(Item2, FRecentFilesSortColumn);

  if FRecentFilesSortColumn = 2 then
  begin
    I1 := ParseSizeToBytes(S1);
    I2 := ParseSizeToBytes(S2);
    if I1 < I2 then Compare := -1
    else if I1 > I2 then Compare := 1
    else Compare := 0;
  end
  else
    Compare := CompareText(S1, S2);

  if not FRecentFilesSortAsc then
    Compare := -Compare;
end;


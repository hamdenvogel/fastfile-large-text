function TfrmMain.SuggestAssistantFilteredExportPath(const APattern: string): string;
var
  Dir, BaseName, SafePat: string;
  i: Integer;
  Ch: Char;
begin
  SafePat := '';
  for i := 1 to Length(APattern) do
  begin
    Ch := APattern[i];
    if Ch in ['\', '/', ':', '*', '?', '"', '<', '>', '|'] then
      SafePat := SafePat + '_'
    else
      SafePat := SafePat + Ch;
  end;
  if Length(SafePat) > 48 then
    SetLength(SafePat, 48);
  if CurrentEffectiveFilePath <> '' then
  begin
    Dir := ExtractFilePath(CurrentEffectiveFilePath);
    BaseName := ChangeFileExt(ExtractFileName(CurrentEffectiveFilePath), '');
    if BaseName = '' then
      BaseName := 'export';
    if SafePat <> '' then
      Result := Dir + 'FastFile_Export_' + BaseName + '_' + SafePat + '_' +
        FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt'
    else
      Result := Dir + 'FastFile_Export_' + BaseName + '_' +
        FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
  end
  else
    Result := GetTmpDir + 'FastFile_Export_' +
      FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
end;


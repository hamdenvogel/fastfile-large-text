constructor TLvTranslateThread.Create(const APrompt: WideString);
begin
  inherited Create(True);
  FreeOnTerminate := True;
  FPrompt := APrompt;
  Resume;
end;

procedure TLvTranslateThread.Execute;
begin
  FOk := FastFileAIInvokePrompt(FPrompt, FAns, FErr, nil);
  Synchronize(SyncDone);
end;

procedure TLvTranslateThread.SyncDone;
begin
  if not Assigned(frmMain) then Exit;
  frmMain.FLvJobOk := FOk;
  frmMain.FLvJobAns := FAns;
  frmMain.FLvJobErr := FErr;
  if frmMain.HandleAllocated then
    PostMessage(frmMain.Handle, WM_USER + 221, 0, 0);
end;


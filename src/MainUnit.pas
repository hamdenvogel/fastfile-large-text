    ACaseSensitive, AMatchMode = fmmPrefix);
end;

procedure TfrmMain.AssistantCbApplyFilter(const APattern: string; ACaseSensitive: Boolean);
var
  S, Needle: string;
  Mode: TFilterMatchMode;
  CS: Boolean;
  St: TAssistantChainStep;
begin
  EnsureReadTabVisible;
  S := Trim(NormalizeAssistantFilterNeedle('', APattern));
  if S = '' then
  begin
    DoFilterDialog;
    Exit;
  end;
  FillChar(St, SizeOf(St), 0);
  St.ActionId := 'apply_filter';
  St.FilterText := S;
  St.CaseSensitive := ACaseSensitive;
  if AssistantCbTryDeferUntilLoaded(St) then Exit;
  FFilterText := S;
  if not HasLineSearchIndex then
  begin
    FDeferredFilterAfterIndex := True;
    if TryStartAutoIndexForSearch(False) then Exit;
    FDeferredFilterAfterIndex := False;
    FAssistantPendingExportFiltered := False;
    FAssistantPendingExportToFile := False;
  end;
  Needle := S;
  Mode := AssistantEffectiveFilterMatchMode(S);
  if (FFilterMatchPolicy = fmpAuto) and (Mode = fmmPrefix) and
     (Length(Needle) > 0) and (Needle[Length(Needle)] = '*') then
    SetLength(Needle, Length(Needle) - 1);
  if not ACaseSensitive then
    CS := False
  else
    CS := EffectiveFilterCaseSensitive(Needle, Mode);
  FAssistantFilterSoftCap := True;
  if Assigned(FIndexFileStream) then
    StartFilter(Needle, CS, Mode)
  else
    StartFilterStream(Needle, CS, Mode);
  ShowFilterBar(False);
  if Assigned(FFilterBar) then
  begin
    FFilterBar.SetPattern(S);
    FFilterBar.RememberPattern(S);
  end;
  RefreshFilterBarState;
end;


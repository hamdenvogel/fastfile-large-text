  if not Assigned(ScrollBarHorizontal) then Exit;
  if ScrollBarHorizontal.Position > 1 then
    Result := ScrollBarHorizontal.Position - 1;
end;

function TfrmMain.SessionReadOnlyCaptionSuffix: string;
begin
  { Fixo em ingles em todos os idiomas (pedido UX). }
  Result := ' [READ ONLY]';
end;

function TfrmMain.StripSessionReadOnlyCaptionSuffix(const S: string): string;
var
  Tag: string;
begin
  Result := Trim(S);
  Tag := SessionReadOnlyCaptionSuffix;
  if (Tag <> '') and (Length(Result) >= Length(Tag)) and
    (AnsiCompareText(Copy(Result, Length(Result) - Length(Tag) + 1, Length(Tag)), Tag) = 0) then
    Result := Trim(Copy(Result, 1, Length(Result) - Length(Tag)));
end;

procedure TfrmMain.ApplySessionReadOnlyFilenameDecoration;
var
  Bare: string;
begin
  if not Assigned(edtFileName) then Exit;
  Bare := StripSessionReadOnlyCaptionSuffix(Trim(edtFileName.Text));
  if FFileSessionReadOnly then
  begin
    if Bare <> '' then
      edtFileName.Text := Bare + SessionReadOnlyCaptionSuffix
    else
      edtFileName.Text := '';
  end
  else
    edtFileName.Text := Bare;
end;

function TfrmMain.CurrentEffectiveFilePath: string;
begin
  Result := StripSessionReadOnlyCaptionSuffix(Trim(edtFileName.Text));
  if (Result = '') or SameText(Result, SELECTTEXT) then
  begin
    Result := StripSessionReadOnlyCaptionSuffix(Trim(fFileName));
    if SameText(Result, SELECTTEXT) then
      Result := '';
  end;
end;

function TfrmMain.ResolveConsumerSourceFilePath: string;
begin
  Result := Trim(CurrentEffectiveFilePath);
  if (Result = '') or (Result = SELECTTEXT) or (not FileExists(Result)) then
  begin
    Result := Trim(fFileName);
    if (Result = SELECTTEXT) then
      Result := '';
  end;
  if (Result <> '') and (not FileExists(Result)) then
    Result := '';
end;

procedure TfrmMain.InvalidateLineCache;
begin
  FCacheCount := 0;
end;

procedure TfrmMain.EnsureLineCacheForPage;
var
  I, Count: Integer;
  R: Int64;
begin
  Count := VisibleItems;
  if Count <= 0 then Count := 1;
  if (FCacheOffset = Offset) and (FCacheCount = Count) and (Length(FCacheLines) >= Count) then
    Exit; // cache is already valid for this page
  FCacheOffset := Offset;
  FCacheCount := Count;
  if Length(FCacheLines) < Count then
    SetLength(FCacheLines, Count);
  for I := 0 to Count - 1 do
  begin
    R := Offset + Int64(I) + Int64(CsvDataStartLine);
    if (R < 0) or (R > MaxInt) then
      FCacheLines[I] := ''
    else
    begin
      FCacheLines[I] := GetLineContent(Integer(R));
      if (FCacheLines[I] = '') and UsesProportionalZeroScanScroll and Assigned(FSourceFileStream) then
        FCacheLines[I] := getLineContentsFromLineIndex(R);
    end;
  end;
end;

procedure TfrmMain.btnUpClick(Sender: TObject);
begin
  if ListviewIsEmpty then Exit;
  Offset := 0;
  fScrollPos := 0;
  SafeSetScrollBarPosition(ScrollBarVertical, 0);
  ScrollBarHorizontal.Position := 0;
  InvalidateLineCache;
  if isChecked then
  begin
    showChecked;
    if Assigned(FCheckListBox) and (FCheckListBox.Items.Count > 0) then
    begin
      FCheckListBox.ItemIndex := 0;
      FCheckListBox.SetFocus;
    end;
    UpdateInfoPanels;
    Exit;
  end;
  ListView1.Refresh;
  SelectListViewItem(0);
  if ListView1.CanFocus then ListView1.SetFocus;
  UpdateInfoPanels;
end;

procedure TfrmMain.btnDownClick(Sender: TObject);
var
  MaxOff: Int64;
  LastVisIdx: Integer;
  ScrollExtent: Int64;
begin
  if ListviewIsEmpty then Exit;
  if UsesProportionalZeroScanScroll and (not FFilterActive) then
  begin
    GotoFileEndZeroScan;
    Exit;
  end;
  if isChecked then
  begin
    if FFilterActive then
    begin
      ScrollExtent := FFilteredCount;
      if ScrollExtent < 1 then ScrollExtent := 1;
    end
    else
    begin
      ScrollExtent := ListViewScrollExtent;
      if ScrollExtent < 1 then ScrollExtent := 1;
    end;
    MaxOff := VerticalScrollMaxOffset(ScrollExtent);
    Offset := MaxOff;
    if ScrollExtent < 1 then ScrollExtent := 1;
    fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff);
    SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
    ScrollBarHorizontal.Position := 0;
    InvalidateLineCache;
    showChecked;
    if Assigned(FCheckListBox) and (FCheckListBox.Items.Count > 0) then
    begin
      FCheckListBox.ItemIndex := FCheckListBox.Items.Count - 1;
      FCheckListBox.SetFocus;
    end;
    UpdateInfoPanels;
    Exit;
  end;
  if FFilterActive then
  begin
    Offset := 0;
    fScrollPos := 0;
    SafeSetScrollBarPosition(ScrollBarVertical, 0);
    InvalidateLineCache;
    ListView1.Refresh;
    if (ListView1.Items.Count > 0) then
      SelectListViewItem(ListView1.Items.Count - 1)
    else
      SelectListViewItem(-1);
    if ListView1.CanFocus then ListView1.SetFocus;
    UpdateInfoPanels;
    Exit;
  end;
  if ItemCount <= VisibleItems then
  begin
    // All items fit on screen - select last item
    SelectListViewItem(Integer(ItemCount) - 1);
    if ListView1.CanFocus then ListView1.SetFocus;
    UpdateInfoPanels;
    Exit;
  end;
  MaxOff := VerticalScrollMaxOffset(ListViewScrollExtent);
  if MaxOff < 0 then MaxOff := 0;
  Offset := MaxOff;
  if ListViewScrollExtent > 0 then
    fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff)
  else
    fScrollPos := 0;
  SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
  ScrollBarHorizontal.Position := 0;
  InvalidateLineCache;
  ListView1.Refresh;
  LastVisIdx := ListView1.Items.Count - 1;
  if LastVisIdx >= ListView1.Items.Count then
    LastVisIdx := ListView1.Items.Count - 1;
  if LastVisIdx < 0 then LastVisIdx := 0;
  SelectListViewItem(LastVisIdx);
  if ListView1.CanFocus then ListView1.SetFocus;
  UpdateInfoPanels;
end;
          
procedure TfrmMain.pgMainCloseBtnClick(Sender: TComponent;
  TabIndex: Integer; var CanClose: Boolean; var Action: TacCloseAction);
const
  showOtherTabs: Boolean = True;
var
  RecentTab: TsTabSheet;
begin
  ClearFileLineHoverHint;
  { Recent files tab must always be hidden individually (not pgMain entirely),
    regardless of its current PageIndex (which may be 0 when pinned first). }
  RecentTab := FindRecentFilesTab;
  if Assigned(RecentTab) and Assigned(pgMain) and
     (TabIndex >= 0) and (TabIndex < pgMain.PageCount) and
     (pgMain.Pages[TabIndex] = RecentTab) then
  begin
    HideTabs(showOtherTabs);
    Abort;
  end;
  case TabIndex of
    TAB_READ_FILE_INDEX:
      CloseReadFileTabAndAssistant;
    else {TAB_SPLIT_FILE_INDEX, TAB_EXPORTED_LINES:}
    begin
      HideTabs(showOtherTabs);
    end;
  end;
  Abort;
end;


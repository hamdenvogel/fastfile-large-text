procedure TfrmMain.gotoLineWithAnchor(const iLine: Int64; const AAnchorFromTop: Integer);
var
  TargetVisibleIdx: Integer;
  AnchorFromTop: Integer;
  MaxOff: Int64;
  FIdx: Int64;
  NavLine: Int64;
begin
  if ItemCount <= 0 then Exit;
  if FFilterActive then
  begin
    FIdx := FilteredIndexForRealLine(iLine);
    if FIdx < 0 then
    begin
      FastFileMessageBox(
        PChar(TrText('This line is not in the current filter results.')),
        PChar(TrText('Ir para linha')), MB_OK or MB_ICONINFORMATION);
      Exit;
    end;
    Offset := 0;
    fScrollPos := 0;
    SafeSetScrollBarPosition(ScrollBarVertical, 0);
    InvalidateLineCache;
    ListView1.Refresh;
    SelectListViewItem(Integer(FIdx));
    { Modo Select: reconstruir checklist e selecionar o item encontrado (FIdx = posicao filtrada). }
    if isChecked and Assigned(FCheckListBox) then
    begin
      showChecked;
      if (Integer(FIdx) >= 0) and (Integer(FIdx) < FCheckListBox.Items.Count) then
        FCheckListBox.ItemIndex := Integer(FIdx);
    end;
    frmMain.goToLineSelected := iLine + 1;
    UpdateInfoPanels;
    Exit;
  end;
  { Posicionar a linha alvo perto do topo, respeitando o numero real de linhas visiveis.
    Em word-wrap alto, VisibleItems pode ser < 5; ancora fixa em 4 causa selecao fora da pagina. }
  AnchorFromTop := AAnchorFromTop;
  if VisibleItems <= 0 then
    VisibleItems := 1;
  if AnchorFromTop > Integer(VisibleItems - 1) then
    AnchorFromTop := Integer(VisibleItems - 1);
  if AnchorFromTop < 0 then
    AnchorFromTop := 0;
  { Em CSV com cabecalho oculto, a lista comeca na linha real 2 (0-based=1).
    Converter linha real (arquivo) para indice navegavel/visivel evita erro +1 no Ctrl+G. }
  NavLine := iLine - CsvDataStartLine;
  if NavLine < 0 then
    NavLine := 0;
  { Zero Scan: saltar para bloco 64 MB antes de posicionar a lista. }
  if UsesProportionalZeroScanScroll and FileExists(ZeroScanBlockIndexPath) then
  begin
    NavLine := Line0BasedForFileByte1Based(
      ZeroScanBlockHintPos0(ZeroScanBlockIndexPath, NavLine * FZeroScanBytesPerItem) + 1) - CsvDataStartLine;
    if NavLine < 0 then
      NavLine := 0;
  end;

  if NavLine > AnchorFromTop then
    Offset := NavLine - AnchorFromTop
  else
    Offset := 0;
  // Clamp Offset
  MaxOff := VerticalScrollMaxOffset(ListViewScrollExtent);
  if Offset > MaxOff then Offset := MaxOff;
  // Update scrollbar position
  if ListViewScrollExtent > 0 then
    fScrollPos := VerticalBarPosFromOffset(Offset, MaxOff)
  else
    fScrollPos := 0;
  SafeSetScrollBarPosition(ScrollBarVertical, fScrollPos);
  InvalidateLineCache;
  ListView1.Refresh;
  // Select the target line
  TargetVisibleIdx := Integer(NavLine - Offset);
  if (TargetVisibleIdx >= 0) and (TargetVisibleIdx < ListView1.Items.Count) then
    SelectListViewItem(TargetVisibleIdx)
  else
    SelectListViewItem(-1);
  frmMain.goToLineSelected := iLine + 1;
  UpdateInfoPanels;
  { Modo Select (sem filtro): reconstruir checklist e selecionar linha navegada. }
  if isChecked and Assigned(FCheckListBox) then
  begin
    showChecked;
    if (TargetVisibleIdx >= 0) and (TargetVisibleIdx < FCheckListBox.Items.Count) then
      FCheckListBox.ItemIndex := TargetVisibleIdx;
  end;
end;

procedure TfrmMain.gotoLine(const iLine: Int64);
begin
  { Ctrl+G e outras rotas gerais mantem alvo perto do topo. }
  gotoLineWithAnchor(iLine, 4);
end;

function TfrmMain.CheckListBoxWordWrapTextRect(CLB: TCheckListBox;
  const ItemRect: TRect): TRect;
var
  L, CW, MaxR, ParentCW: Integer;
  Rc: TRect;
begin
  { Largura util: no 1o paint apos Ctrl+Shift+S o handle pode ainda nao ter a largura final. }
  CW := 0;
  if CLB.HandleAllocated and Windows.GetClientRect(CLB.Handle, Rc) then
    CW := Rc.Right - Rc.Left;
  if CW < 24 then
    CW := CLB.ClientWidth;
  if CW < 24 then
    CW := CLB.Width;
  ParentCW := 0;
  if CLB.Parent <> nil then
    ParentCW := CLB.Parent.ClientWidth;
  if (not ReadViewIsFloating) and Assigned(pnlCenter) and (pnlCenter.ClientWidth > ParentCW) then
    ParentCW := pnlCenter.ClientWidth;
  if Assigned(pnlMain) and (pnlMain.ClientWidth > ParentCW) then
    ParentCW := pnlMain.ClientWidth;
  if Assigned(ScrollBarVertical) and ScrollBarVertical.Visible then
    Dec(ParentCW, ScrollBarVertical.Width);
  if ParentCW < 24 then
    ParentCW := 0;
  if (ParentCW > CW + 16) then
    CW := ParentCW - 8;
  if CW < 24 then
    CW := 24;
  if ItemRect.Left > 0 then
    L := ItemRect.Left
  else
    L := CheckListTextStartX;
  MaxR := CW - 6;
  if MaxR <= L then
    MaxR := CW - 1;
  if MaxR <= L then
    MaxR := L + 1;
  Result.Left := L;
  Result.Right := MaxR;
  Result.Top := ItemRect.Top + 2;
  Result.Bottom := ItemRect.Bottom - 2;
  if Result.Bottom <= Result.Top + 4 then
    Result.Bottom := ItemRect.Bottom;
  InflateRect(Result, -2, -2);
end;

procedure TfrmMain.DrawCheckListItemTextWithMarks(CLB: TCheckListBox; Index, RealLineIdx: Integer;
  const Rect: TRect; Bk, Fg: TColor; AllowWrap: Boolean);
var
  PrefixStr, LinePlain, RawLine: string;
  TextR, PrefixR, ContentR: TRect;
  PrefixFlags: Longint;
  PrefixW: Integer;
  Line1Based: Integer;
begin
  if not Assigned(CLB) then Exit;
  if Index < 0 then Exit;
  if Index >= CLB.Items.Count then Exit;
  TextR := CheckListBoxWordWrapTextRect(CLB, Rect);
  PrefixStr := '';
  if RealLineIdx >= 0 then
  begin
    Line1Based := RealLineIdx + 1;
    PrefixStr := BuildCheckListLinePrefix(Line1Based);
    LinePlain := getLineContentsFromLineIndex(RealLineIdx);
    RawLine := BuildLineTextForMarksDisplay(RealLineIdx);
    if (not AllowWrap) and (ScrollBarHorizontal.Position > 1) then
      RawLine := Copy(RawLine, ScrollBarHorizontal.Position, MaxInt);
  end
  else
  begin
    PrefixStr := CLB.Items[Index];
    RawLine := '';
  end;

  PrefixW := FCheckListLinePrefixPx;
  if PrefixW < 1 then
    PrefixW := CLB.Canvas.TextWidth(PrefixStr);
  PrefixR := TextR;
  PrefixR.Left := CheckListTextStartX;
  if PrefixR.Left < TextR.Left then
    PrefixR.Left := TextR.Left;
  PrefixR.Right := PrefixR.Left + PrefixW;
  if PrefixR.Right > TextR.Right then
    PrefixR.Right := TextR.Right;
  ContentR := TextR;
  ContentR.Left := PrefixR.Right;

  CLB.Canvas.Brush.Style := bsSolid;
  CLB.Canvas.Brush.Color := Bk;
  CLB.Canvas.Font.Color := Fg;
  if PrefixR.Right > PrefixR.Left then
    CLB.Canvas.FillRect(PrefixR);
  if PrefixStr <> '' then
  begin
    if AllowWrap then
      PrefixFlags := DrawTextBiDiModeFlags(DT_LEFT or DT_TOP or DT_NOPREFIX or DT_SINGLELINE)
    else
      PrefixFlags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX or DT_LEFT);
    DrawText(CLB.Canvas.Handle, PChar(PrefixStr), Length(PrefixStr), PrefixR, PrefixFlags);
  end;

  if (RawLine <> '') and (ContentR.Right > ContentR.Left + 2) then
    DrawWhitespaceMarksOntoCanvas(CLB.Canvas, ContentR, RawLine, Bk, Fg, AllowWrap);
end;

procedure TfrmMain.CheckListBox1DrawItem(Control: TWinControl;
  Index: Integer; Rect: TRect; DrawState: TOwnerDrawState);
var
  Flags: Longint;
  pageNumber: Int64;
  RealLineIdx: Integer;
  CheckRect: TRect;
  CheckFlags: UINT;
  CheckW, CheckH: Integer;
  SelRect, ItemRect: TRect;
  SegTop, SegBottom, SegLeft, SegRight: Integer;
  S: string;
  R, RC: TRect;
  DrawFlags, CalcFlags: Cardinal;
  Bk, Fg: TColor;
  ItemH, TextH: Integer;
  CLB: TCheckListBox;
  R0: TRect;
  IsFindRow, IsItemSel: Boolean;
  LineS, FullStr, PrefixStr: string;
  PrefixLen, Rel0, Skip, MatchStart, MatchLen, PrefixPx: Integer;
  PrefixR, ContentR: TRect;
  PrefixFlags: Longint;
begin
  if not (Control is TCheckListBox) then Exit;
  CLB := TCheckListBox(Control);

  CLB.Canvas.Font.Assign(CLB.Font);
  RealLineIdx := -1;
  if Assigned(FCheckListBox) and (Index >= 0) and (Index < FCheckListBox.Items.Count) then
  begin
    pageNumber := Integer(FCheckListBox.Items.Objects[Index]);
    RealLineIdx := Integer(pageNumber) - 1;
    if foundLineExists(RealLineIdx) then
      CLB.Canvas.Font.Style := CLB.Canvas.Font.Style + [fsBold];
  end;

  IsFindRow := FFindMatchSelection and (FLastFoundMatchLen > 0) and
    (RealLineIdx = FLastFoundLine);
  if IsFindRow and FFastVisualWordWrap then
  begin
    R0 := CheckListBoxWordWrapTextRect(CLB, Rect);
    if EstimateWrapRowsForLine(GetLineContent(RealLineIdx),
      Max(50, R0.Right - R0.Left)) > 1 then
      IsFindRow := False;
  end;
  if IsFindRow then
  begin
    IsItemSel := (CLB.ItemIndex = Index);
    FullStr := CLB.Items[Index];
    LineS := getLineContentsFromLineIndex(RealLineIdx);
    PrefixStr := BuildCheckListLinePrefix(Integer(pageNumber));
    Rel0 := FLastFoundCol;
    MatchLen := FLastFoundMatchLen;
    PrefixPx := FCheckListLinePrefixPx;
    Skip := ListViewHorizTextSkipChars;
    MatchStart := Rel0 - Skip;
    if MatchStart < 0 then MatchStart := 0;
    if MatchStart + MatchLen > Length(LineS) then
      MatchLen := Length(LineS) - MatchStart;

    if (RealLineIdx >= 0) and IsBookmarked(RealLineIdx) then
    begin
      Bk := FF_BOOKMARK_ROW_BG;
      Fg := FF_BOOKMARK_ROW_FG;
    end
    else
    begin
      Bk := clWindow;
      Fg := clWindowText;
    end;

    CLB.Canvas.Brush.Style := bsSolid;
    CLB.Canvas.Brush.Color := Bk;
    CLB.Canvas.FillRect(Classes.Rect(0, Rect.Top, CLB.ClientWidth, Rect.Bottom));

    CheckW := GetSystemMetrics(SM_CXMENUCHECK);
    CheckH := GetSystemMetrics(SM_CYMENUCHECK);
    CheckW := (CheckW * CHECKBOX_SCALE_PCT) div 100;
    CheckH := (CheckH * CHECKBOX_SCALE_PCT) div 100;
    if CheckW < 9 then CheckW := 9;
    if CheckH < 9 then CheckH := 9;
    CheckRect.Left := CHECKBOX_LEFT_PAD;
    CheckRect.Top := Rect.Top + ((Rect.Bottom - Rect.Top - CheckH) div 2);
    if CheckRect.Top < Rect.Top then CheckRect.Top := Rect.Top;
    CheckRect.Right := CheckRect.Left + CheckW;
    CheckRect.Bottom := CheckRect.Top + CheckH;

    if IsItemSel then
    begin
      CLB.Canvas.Brush.Color := clHighlight;
      CLB.Canvas.FillRect(Classes.Rect(0, Rect.Top, CheckRect.Right + CHECKBOX_TEXT_GAP, Rect.Bottom));
    end;

    CheckFlags := DFCS_BUTTONCHECK;
    if CLB.Checked[Index] then
      CheckFlags := CheckFlags or DFCS_CHECKED;
    if not CLB.Enabled then
      CheckFlags := CheckFlags or DFCS_INACTIVE;
    DrawFrameControl(CLB.Canvas.Handle, CheckRect, DFC_BUTTON, CheckFlags);

    if (not IsItemSel) and (RealLineIdx >= 0) and IsBookmarked(RealLineIdx) then
    begin
      SegLeft := CheckRect.Right + 2;
      SegRight := SegLeft + 4;
      if SegRight > CLB.ClientWidth - 1 then SegRight := CLB.ClientWidth - 1;
      if SegRight > SegLeft then
      begin
        CLB.Canvas.Brush.Color := FF_BOOKMARK_STRIPE;
        CLB.Canvas.Pen.Style := psClear;
        CLB.Canvas.Rectangle(SegLeft, Rect.Top, SegRight, Rect.Bottom);
        CLB.Canvas.Pen.Style := psSolid;
      end;
    end;

    if Rect.Left < (CheckRect.Right + CHECKBOX_TEXT_GAP) then
      Rect.Left := CheckRect.Right + CHECKBOX_TEXT_GAP;
    PrefixPx := FCheckListLinePrefixPx;
    if PrefixPx < 1 then
      PrefixPx := CLB.Canvas.TextWidth(PrefixStr);
    PrefixR := Rect;
    PrefixR.Left := CheckListTextStartX;
    if PrefixR.Left < Rect.Left then
      PrefixR.Left := Rect.Left;
    PrefixR.Right := PrefixR.Left + PrefixPx;
    ContentR := Rect;
    ContentR.Left := PrefixR.Right;

    if IsItemSel then
    begin
      CLB.Canvas.Brush.Color := clHighlight;
      CLB.Canvas.FillRect(PrefixR);
      CLB.Canvas.Font.Color := clHighlightText;
    end
    else
      CLB.Canvas.Font.Color := Fg;
    PrefixFlags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX or DT_LEFT);
    DrawText(CLB.Canvas.Handle, PChar(PrefixStr), Length(PrefixStr), PrefixR, PrefixFlags);

    if (MatchLen > 0) and (ContentR.Right > ContentR.Left + 2) then
      DrawCheckListFindHighlight(CLB, ContentR, LineS, MatchStart, MatchLen)
    else if FShowWhitespaceMarks and (RealLineIdx >= 0) then
      DrawCheckListItemTextWithMarks(CLB, Index, RealLineIdx, Rect, Bk, Fg, FFastVisualWordWrap)
    else
    begin
      CLB.Canvas.Brush.Color := Bk;
      CLB.Canvas.FillRect(ContentR);
      CLB.Canvas.Font.Color := Fg;
      DrawText(CLB.Canvas.Handle, PChar(LineS), Length(LineS), ContentR, PrefixFlags);
    end;

    if FHasSelection then
    begin
      SelRect := Classes.Rect(Min(FBlockStartPoint.X, FBlockEndPoint.X),
        Min(FBlockStartPoint.Y, FBlockEndPoint.Y),
        Max(FBlockStartPoint.X, FBlockEndPoint.X),
        Max(FBlockStartPoint.Y, FBlockEndPoint.Y));
      ItemRect := Classes.Rect(0, Rect.Top, CLB.ClientWidth, Rect.Bottom);
      if (SelRect.Right > SelRect.Left) and (SelRect.Bottom > SelRect.Top) and
         (SelRect.Left < ItemRect.Right) and (SelRect.Right > ItemRect.Left) and
         (SelRect.Top < ItemRect.Bottom) and (SelRect.Bottom > ItemRect.Top) then
      begin
        SegLeft := SelRect.Left;
        if SegLeft < ItemRect.Left then SegLeft := ItemRect.Left;
        SegRight := SelRect.Right;
        if SegRight > ItemRect.Right - 1 then SegRight := ItemRect.Right - 1;
        SegTop := SelRect.Top;
        if SegTop < ItemRect.Top then SegTop := ItemRect.Top;
        SegBottom := SelRect.Bottom;
        if SegBottom > ItemRect.Bottom - 1 then SegBottom := ItemRect.Bottom - 1;
        if FFindMatchSelection then
          DrawFindMatchSelectionFrame(CLB.Canvas,
            Classes.Rect(SegLeft, SegTop, SegRight, SegBottom))
        else
        begin
          CLB.Canvas.Brush.Style := bsClear;
          CLB.Canvas.Pen.Color := clHighlight;
          CLB.Canvas.Pen.Style := psSolid;
          CLB.Canvas.Pen.Width := 1;
          CLB.Canvas.Rectangle(SegLeft, SegTop, SegRight, SegBottom);
        end;
      end;
    end;
    Exit;
  end;

  if odSelected in DrawState then
  begin
    Bk := clHighlight;
    Fg := clHighlightText;
  end
  else
  begin
    if (RealLineIdx >= 0) and IsBookmarked(RealLineIdx) then
    begin
      Bk := FF_BOOKMARK_ROW_BG;
      Fg := FF_BOOKMARK_ROW_FG;
    end
    else
    begin
      Bk := clWindow;
      Fg := clWindowText;
    end;
  end;

  CLB.Canvas.Brush.Style := bsSolid;
  CLB.Canvas.Brush.Color := Bk;
  { Preenche a faixa inteira da linha (incl. area do checkbox); o VCL redesenha o checkbox por cima. }
  CLB.Canvas.FillRect(Classes.Rect(0, Rect.Top, CLB.ClientWidth, Rect.Bottom));
  CLB.Canvas.Font.Color := Fg;

  { Em owner-draw, desenhar o checkbox explicitamente para evitar desaparecer ao pintar a linha toda. }
  CheckW := GetSystemMetrics(SM_CXMENUCHECK);
  CheckH := GetSystemMetrics(SM_CYMENUCHECK);
  CheckW := (CheckW * CHECKBOX_SCALE_PCT) div 100;
  CheckH := (CheckH * CHECKBOX_SCALE_PCT) div 100;
  if CheckW < 9 then CheckW := 9;
  if CheckH < 9 then CheckH := 9;
  CheckRect.Left := CHECKBOX_LEFT_PAD;
  CheckRect.Top := Rect.Top + ((Rect.Bottom - Rect.Top - CheckH) div 2);
  if CheckRect.Top < Rect.Top then
    CheckRect.Top := Rect.Top;
  CheckRect.Right := CheckRect.Left + CheckW;
  CheckRect.Bottom := CheckRect.Top + CheckH;

  CheckFlags := DFCS_BUTTONCHECK;
  if CLB.Checked[Index] then
    CheckFlags := CheckFlags or DFCS_CHECKED;
  if not CLB.Enabled then
    CheckFlags := CheckFlags or DFCS_INACTIVE;
  DrawFrameControl(CLB.Canvas.Handle, CheckRect, DFC_BUTTON, CheckFlags);

  if (not (odSelected in DrawState)) and (RealLineIdx >= 0) and IsBookmarked(RealLineIdx) then
  begin
    SegLeft := CheckRect.Right + 2;
    SegRight := SegLeft + 4;
    if SegRight > CLB.ClientWidth - 1 then
      SegRight := CLB.ClientWidth - 1;
    if SegRight > SegLeft then
    begin
      CLB.Canvas.Brush.Color := FF_BOOKMARK_STRIPE;
      CLB.Canvas.Pen.Style := psClear;
      CLB.Canvas.Rectangle(SegLeft, Rect.Top, SegRight, Rect.Bottom);
      CLB.Canvas.Pen.Style := psSolid;
    end;
  end;

  { Garante separacao visual entre checkbox e texto em todos os modos de desenho. }
  if Rect.Left < (CheckRect.Right + CHECKBOX_TEXT_GAP) then
    Rect.Left := CheckRect.Right + CHECKBOX_TEXT_GAP;

  if FShowWhitespaceMarks and (RealLineIdx >= 0) and (not FCheckListFastScrollPaint) then
  begin
    R := CheckListBoxWordWrapTextRect(CLB, Rect);
    if R.Right > R.Left + 2 then
      DrawCheckListItemTextWithMarks(CLB, Index, RealLineIdx, Rect, Bk, Fg, FFastVisualWordWrap);
  end
  else if FShowWhitespaceMarks and (RealLineIdx >= 0) and FCheckListFastScrollPaint then
  begin
    R := CheckListBoxWordWrapTextRect(CLB, Rect);
    if R.Right > R.Left + 2 then
    begin
      CLB.Canvas.Brush.Color := Bk;
      CLB.Canvas.Font.Color := Fg;
      GetCheckListItemPrefixAndLine(Index, PrefixStr, LineS);
      DrawCheckListPrefixAndContent(CLB, R, PrefixStr, LineS, Bk, Fg,
        DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX or DT_END_ELLIPSIS));
    end;
  end
  else if FFastVisualWordWrap then
  begin
    { Largura = area visivel do cliente (evita uma unica linha logica larga como a coluna 1200 da ListView). }
    R := CheckListBoxWordWrapTextRect(CLB, Rect);
    if R.Right <= R.Left then Exit;
    S := CLB.Items[Index];
    if Length(S) > MAX_CHECKLIST_WRAP_DRAW then
      S := Copy(S, 1, MAX_CHECKLIST_WRAP_DRAW) + '...';
    { DT_WORDBREAK no owner-draw do CheckListBox costuma nao quebrar; quebra manual por TextWidth. }
    S := WrapPlainTextToPixelWidth(CLB.Canvas, S, R.Right - R.Left);
    { Centralizar o bloco de texto na faixa (como DT_VCENTER na linha simples). }
    R0 := R;
    ItemH := R0.Bottom - R0.Top;
    { DT_WORDBREAK ajuda se ainda couber uma linha longa; CRLFs do wrap manual mantem-se. }
    DrawFlags := DT_LEFT or DT_TOP or DT_NOPREFIX or DT_EXPANDTABS or DT_WORDBREAK;
    DrawFlags := Cardinal(DrawTextBiDiModeFlags(Longint(DrawFlags)));
    RC := R0;
    CalcFlags := DrawFlags or DT_CALCRECT;
    Windows.DrawText(CLB.Canvas.Handle, PChar(S), Length(S), RC, CalcFlags);
    TextH := RC.Bottom - RC.Top;
    if TextH <= 0 then TextH := ItemH;
    R := R0;
    if TextH < ItemH then
      Inc(R.Top, (ItemH - TextH) div 2);
    if TextH > ItemH then
      R.Bottom := R0.Bottom
    else
      R.Bottom := R.Top + TextH;
    if R.Bottom > R0.Bottom then
      R.Bottom := R0.Bottom;
    Windows.DrawText(CLB.Canvas.Handle, PChar(S), Length(S), R, DrawFlags);
  end
  else
  begin
    Flags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX or DT_END_ELLIPSIS);
    R := Classes.Rect(CheckListTextStartX, Rect.Top, CLB.ClientWidth, Rect.Bottom);
    if R.Left < Rect.Left then
      R.Left := Rect.Left;
    CLB.Canvas.Brush.Style := bsSolid;
    GetCheckListItemPrefixAndLine(Index, PrefixStr, LineS);
    DrawCheckListPrefixAndContent(CLB, R, PrefixStr, LineS, Bk, Fg, Flags);
  end;

  if FHasSelection then
  begin
    SelRect := Classes.Rect(Min(FBlockStartPoint.X, FBlockEndPoint.X),
      Min(FBlockStartPoint.Y, FBlockEndPoint.Y),
      Max(FBlockStartPoint.X, FBlockEndPoint.X),
      Max(FBlockStartPoint.Y, FBlockEndPoint.Y));
    ItemRect := Classes.Rect(0, Rect.Top, CLB.ClientWidth, Rect.Bottom);
    if (SelRect.Right > SelRect.Left) and (SelRect.Bottom > SelRect.Top) and
       (SelRect.Left < ItemRect.Right) and (SelRect.Right > ItemRect.Left) and
       (SelRect.Top < ItemRect.Bottom) and (SelRect.Bottom > ItemRect.Top) then
    begin
      SegLeft := SelRect.Left;
      if SegLeft < ItemRect.Left then SegLeft := ItemRect.Left;
      SegRight := SelRect.Right;
      if SegRight > ItemRect.Right - 1 then SegRight := ItemRect.Right - 1;
      SegTop := SelRect.Top;
      if SegTop < ItemRect.Top then SegTop := ItemRect.Top;
      SegBottom := SelRect.Bottom;
      if SegBottom > ItemRect.Bottom - 1 then SegBottom := ItemRect.Bottom - 1;

      if FFindMatchSelection then
        DrawFindMatchSelectionFrame(CLB.Canvas,
          Classes.Rect(SegLeft, SegTop, SegRight, SegBottom))
      else
      begin
        CLB.Canvas.Brush.Style := bsClear;
        CLB.Canvas.Pen.Color   := clHighlight;
        CLB.Canvas.Pen.Style   := psSolid;
        CLB.Canvas.Pen.Width   := 1;
        CLB.Canvas.Rectangle(SegLeft, SegTop, SegRight, SegBottom);
      end;
    end;
  end;

  DrawCheckListLineAutofillPreview(CLB, Index,
    Classes.Rect(0, Rect.Top, CLB.ClientWidth, Rect.Bottom));
end;


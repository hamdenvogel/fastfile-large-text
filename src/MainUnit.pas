procedure TfrmMain.EnsureIdleLogoFloat;
var
  Btn: TacFloatBtn;
begin
  if Assigned(FIdleLogoFloat) then Exit;
  FIdleLogoFloat := TsFloatButtons.Create(Self);
  FIdleLogoFloat.Name := 'FIdleLogoFloat';

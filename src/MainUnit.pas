procedure TfrmMain.HandleConsumerRAGProtocolLine(const ALine: string);
var
  PrefixPos: Integer;
  Rest: string;
  SepPos: Integer;
  Kind: string;
  Payload: string;
  InferredOptions: string;

  procedure EnableConsumerRAGInput;
  var
    Host: TWinControl;
  begin
    SetConsumerRAGStatus(TrText('Awaiting input'));
    if Assigned(FConsumerRAGInputPanel) then
    begin
      FConsumerRAGInputPanel.Enabled := True;
      FConsumerRAGInputPanel.Show;
    end;
    if Assigned(FConsumerRAGInputEdit) then
    begin
      Host := FConsumerRAGInputEdit.Parent;
      if Assigned(Host) then
      begin
        Host.Enabled := True;
        Host.Show;
      end;
      FConsumerRAGInputEdit.Enabled := True;
      FConsumerRAGInputEdit.ReadOnly := False;
      FConsumerRAGInputEdit.TabStop := True;
      if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible then
      begin
        FConsumerRAGInputEdit.Show;
        FConsumerRAGInputEdit.SetFocus;
      end;
    end;
    UpdateConsumerRAGInputPanelHeight;
    if Assigned(FConsumerRAGPanel) then
      FConsumerRAGPanel.Repaint;
  end;

  procedure ApplyPromptUI(const APrompt: string; const AAppendPrompt: Boolean);
  var
    WorkPrompt: string;
  begin
    WorkPrompt := Trim(APrompt);
    if WorkPrompt = '' then
      WorkPrompt := Trim(FConsumerRAGLastPrompt);
    if WorkPrompt <> '' then
      FConsumerRAGLastPrompt := WorkPrompt;
    EnableConsumerRAGInput;
    if AAppendPrompt and (WorkPrompt <> '') then
      AppendConsumerRAGTranscriptEx('PROMPT', WorkPrompt);
  end;

begin
  PrefixPos := Pos(BRIDGE_PREFIX, ALine);
  if PrefixPos <= 0 then
    PrefixPos := PosBMH(BRIDGE_PREFIX, ALine);
  if PrefixPos > 0 then
  begin
    if PrefixPos > 1 then
      AppendConsumerRAGTranscriptEx('PY', Trim(Copy(ALine, 1, PrefixPos - 1)));

    Rest := Copy(ALine, PrefixPos + Length(BRIDGE_PREFIX), MaxInt);
    SepPos := Pos('|', Rest);
    if SepPos > 0 then
    begin
      Kind := UpperCase(Copy(Rest, 1, SepPos - 1));
      Payload := Copy(Rest, SepPos + 1, MaxInt);

      if Kind = 'OUTPUT' then
      begin
        if not ShouldSuppressConsumerAIOutput(Payload) then
          AppendConsumerRAGTranscriptEx('PY', Payload);
        MaybeNotifyChatExportFromText(FConsumerRAGPanel, Payload);
        Exit;
      end;

      if Kind = 'OPTIONS' then
      begin
        EnableConsumerRAGInput;
        RebuildConsumerRAGOptionButtons(Payload);
        Exit;
      end;

      if Kind = 'PROMPT' then
      begin
        if Trim(Payload) = '' then
          Payload := FConsumerRAGLastPrompt;
        InferredOptions := ExtractConsumerRAGOptionsFromPrompt(Payload);
        ApplyPromptUI(Payload, True);
        if (not Assigned(FConsumerRAGOptionsPanel)) or
           (not FConsumerRAGOptionsPanel.Visible) or
           (FConsumerRAGOptionsPanel.ControlCount = 0) then
        begin
          if InferredOptions <> '' then
            RebuildConsumerRAGOptionButtons(InferredOptions);
        end;
        TryFlushPendingConsumerRAGQuestion;
        Exit;
      end;

      if Kind = 'STATUS' then
      begin
        if Payload <> '' then
          SetConsumerRAGStatus(Payload);
        Exit;
      end;

      if Kind = 'ERROR' then
      begin
        AppendConsumerRAGTranscriptEx('ERROR', Payload);
        SetConsumerRAGStatus(TrText('Error'));
        Exit;
      end;
    end;
    Exit;
  end;

  InferredOptions := ExtractConsumerRAGOptionsFromPrompt(ALine);
  if InferredOptions <> '' then
  begin
    if Pos(BRIDGE_PREFIX + 'PROMPT|', ALine) = 1 then
      ApplyPromptUI(Copy(ALine, Length(BRIDGE_PREFIX + 'PROMPT|') + 1, MaxInt), True)
    else if Pos(BRIDGE_PREFIX + 'OPTIONS|', ALine) = 1 then
    begin
      RebuildConsumerRAGOptionButtons(Copy(ALine, Length(BRIDGE_PREFIX + 'OPTIONS|') + 1, MaxInt));
      EnableConsumerRAGInput;
    end
    else
      ApplyPromptUI(ALine, False);
    if (not Assigned(FConsumerRAGOptionsPanel)) or
       (not FConsumerRAGOptionsPanel.Visible) or
       (FConsumerRAGOptionsPanel.ControlCount = 0) then
      RebuildConsumerRAGOptionButtons(InferredOptions);
    TryFlushPendingConsumerRAGQuestion;
  end;

  if (ALine <> '') and (not ContainsBMH(BRIDGE_PREFIX, ALine)) then
  begin
    if not ShouldSuppressConsumerAIOutput(ALine) then
    begin
      AppendConsumerRAGTranscriptEx('PY', ALine);
      MaybeNotifyChatExportFromText(FConsumerRAGPanel, ALine);
    end;
  end;
end;

function TfrmMain.ResolveConsumerRAGScriptPath: string;
begin
  if not EnsureExecutableAvailable(CONSUMERRAG, Result) then
    Result := '';
end;

procedure TfrmMain.PurgeConsumerRAGTempData;
var
  ExePath, DataDir, WorkspaceDir: string;
begin
  { Removes LanceDB vectors / chunk index next to ConsumerRAG.exe so a reload
    after Cancel starts embedding from scratch (no stale partial cache). }
  ExePath := ResolveConsumerRAGScriptPath;
  if Trim(ExePath) = '' then
    Exit;
  DataDir := IncludeTrailingPathDelimiter(ExtractFilePath(ExePath)) + CONSUMER_DATA_DIR;
  WorkspaceDir := IncludeTrailingPathDelimiter(DataDir) + CONSUMERRAG_WORKSPACE_DIR;
  try
    if DirectoryExists(WorkspaceDir) then
      UnUtils.DeleteDirectory(WorkspaceDir);
  except
  end;
  try
    if DirectoryExists(DataDir) then
      UnUtils.DeleteDirectory(DataDir);
  except
  end;
end;

function TfrmMain.ResolveExecutableUrl(const AExeFileName: string; out AUrl: string): Boolean;
begin
  Result := True;
  if SameText(AExeFileName, CONSUMERRAG) then
    AUrl := CONSUMERRAG_DOWNLOAD_URL
  else if SameText(AExeFileName, CONSUMERAI) then
    AUrl := CONSUMERAI_DOWNLOAD_URL
  else if SameText(AExeFileName, SCRIPTENGINE) then
    AUrl := SCRIPTENGINE_DOWNLOAD_URL
  else if SameText(AExeFileName, CODECHECK) then
    AUrl := CODECHECK_DOWNLOAD_URL
  else
  begin
    AUrl := '';
    Result := False;
  end;
end;

procedure TfrmMain.DeleteInvalidDeployExe(const AExeFileName, ALocalPath: string);
begin
  if FileExists(ALocalPath) then
  begin
    try
      DeleteFile(ALocalPath);
      LogExecutableDownload('DELETE_INVALID | exe=' + AExeFileName + ' | file=' + ALocalPath);
    except
    end;
  end;
end;

function TfrmMain.EnsureExecutableAvailable(const AExeFileName: string; out ALocalPath: string): Boolean;
var
  ErrorMsg: string;
  FoundPath: string;
begin
  Result := False;
  ALocalPath := FastFileDeployExePath(AExeFileName);

  FoundPath := FindValidExternalExecutable(AExeFileName);
  if FoundPath <> '' then
  begin
    if not SameText(ExpandFileName(FoundPath), ExpandFileName(ALocalPath)) then
    begin
      try
        ForceDirectories(ExtractFilePath(ALocalPath));
        if FileExists(ALocalPath) then
          DeleteFile(ALocalPath);
        if not Windows.CopyFile(PChar(FoundPath), PChar(ALocalPath), False) then
        begin
          ALocalPath := FoundPath;
          LogExecutableDownload('USE_DEV_BUILD | exe=' + AExeFileName + ' | path=' + ALocalPath);
          Result := True;
          Exit;
        end;
        LogExecutableDownload('COPIED_DEV_BUILD | exe=' + AExeFileName + ' | from=' + FoundPath);
      except
        ALocalPath := FoundPath;
        Result := True;
        Exit;
      end;
    end;
    Result := True;
    Exit;
  end;

  if FileExists(ALocalPath) then
    DeleteInvalidDeployExe(AExeFileName, ALocalPath);

  if not DownloadExecutableDirect(AExeFileName, ALocalPath, ErrorMsg) then
  begin
    if ErrorMsg = '' then
      ErrorMsg := TrText('Unknown error.');
    ShowAppMessage(Format(TrText('Could not download Python plugin %s. Error: %s'), [AExeFileName, ErrorMsg]));
    ALocalPath := '';
    Exit;
  end;

  if not FileExists(ALocalPath) then
  begin
    ShowAppMessage(Format(TrText('The Python plugin %s was downloaded but was not found in the application folder.'), [AExeFileName]));
    ALocalPath := '';
    Exit;
  end;

  if not IsValidDownloadedCompanionExe(ALocalPath) then
  begin
    DeleteInvalidDeployExe(AExeFileName, ALocalPath);
    ShowAppMessage(Format(TrText('Downloaded Python plugin %s is invalid or incomplete (PyInstaller archive). Rebuild with data-lake-duckdb-main\build_exe_lancedb.bat, upload to FTP, then try again.'), [AExeFileName]));
    ALocalPath := '';
    Exit;
  end;

  Result := True;
end;

function URLDownloadToFileA(lpUnkcaller: Pointer; szURL, szFileName: PAnsiChar;
  dwReserved: DWORD; lpfnCB: Pointer): HRESULT; stdcall; external 'urlmon.dll' name 'URLDownloadToFileA';

function TfrmMain.TryUrlMonDownloadExecutable(const AExeFileName, ALocalPath: string;
  out AErrorMsg: string): Boolean;
var
  Url: string;
  HR: HRESULT;
begin
  Result := False;
  AErrorMsg := '';
  if not ResolveExecutableUrl(AExeFileName, Url) then
  begin
    AErrorMsg := TrText('Unsupported Python plugin for automatic download.');
    Exit;
  end;
  LogExecutableDownload('TRY | exe=' + AExeFileName + ' | strategy=URLMON | url=' + Url);
  HR := URLDownloadToFileA(nil, PAnsiChar(AnsiString(Url)), PAnsiChar(AnsiString(ALocalPath)), 0, nil);
  if HR < 0 then
  begin
    AErrorMsg := Format('URLDownloadToFile HRESULT=$%x', [HR]);
    LogExecutableDownload('FAIL_URLMON | ' + AErrorMsg);
    Exit;
  end;
  if not IsValidDownloadedCompanionExe(ALocalPath) then
  begin
    AErrorMsg := TrText('Downloaded Python plugin is not a valid PyInstaller executable.');
    LogExecutableDownload('FAIL_INVALID_AFTER_URLMON | exe=' + AExeFileName);
    Exit;
  end;
  LogExecutableDownload('SUCCESS | exe=' + AExeFileName + ' | strategy=URLMON');
  Result := True;
end;

function TfrmMain.DownloadExecutableDirect(const AExeFileName, ALocalPath: string; out AErrorMsg: string): Boolean;
var
  hInternet, hRemoteFile: Pointer;
  OutStream: TFileStream;
  Buffer: array[0..READ_BUF_SIZE - 1] of Byte;
  BytesRead: DWORD;
  TotalRead: Int64;
  TotalSize: DWORD;
  SizeLen: DWORD;
  StatusCode: DWORD;
  StatusLen: DWORD;
  QueryIndex: DWORD;
  Percent: Integer;
  LastErr: DWORD;
  RespErr: DWORD;
  RespLen: DWORD;
  RespBuf: array[0..1023] of Char;
  TimeOutVal: DWORD;
  AttemptError: string;
  ReadOk: Boolean;

  function GetInternetErrorText(hRequest: Pointer): string;
  begin
    Result := '';
    RespErr := 0;
    FillChar(RespBuf, SizeOf(RespBuf), 0);
    RespLen := SizeOf(RespBuf);
    if Assigned(hRequest) and InternetGetLastResponseInfo(RespErr, @RespBuf[0], RespLen) then
      Result := Trim(string(RespBuf));
    LastErr := GetLastError;
    if Result = '' then
    begin
      case LastErr of
        12002: Result := 'WinInet timeout (12002)';
        12007: Result := 'WinInet server name not resolved (12007)';
        12029: Result := 'WinInet cannot connect (12029)';
        12030: Result := 'WinInet connection aborted (12030)';
        12031: Result := 'WinInet connection reset (12031)';
        12150: Result := 'WinInet HTTPS required (12150)';
      else
        if LastErr <> 0 then
          Result := SysErrorMessage(LastErr) + ' (Win32=' + IntToStr(LastErr) + ')'
        else
          Result := TrText('Unknown error.');
      end;
    end
    else if LastErr <> 0 then
      Result := Result + ' (Win32=' + IntToStr(LastErr) + ')';
  end;

  function TryDownloadWithFlags(const AOpenType: DWORD; out ALocalError: string): Boolean;
  var
    OpenTypeName: string;
    DownloadUrl: string;
  begin
    Result := False;
    ALocalError := '';

    hInternet := nil;
    hRemoteFile := nil;
    OutStream := nil;
    TotalRead := 0;
    TotalSize := 0;

    if AOpenType = INTERNET_OPEN_TYPE_PRECONFIG then
      OpenTypeName := 'PRECONFIG'
    else
      OpenTypeName := 'DIRECT';

    if not ResolveExecutableUrl(AExeFileName, DownloadUrl) then
    begin
      ALocalError := TrText('Unsupported Python plugin for automatic download.');
      Exit;
    end;

    LogExecutableDownload('TRY | exe=' + AExeFileName + ' | open=' + OpenTypeName + ' | url=' + DownloadUrl);

    hInternet := InternetOpen('FastFile/1.0', AOpenType, nil, nil, 0);
    if hInternet = nil then
    begin
      ALocalError := GetInternetErrorText(nil);
      LogExecutableDownload('FAIL_INTERNET_OPEN | ' + ALocalError);
      Exit;
    end;

    try
    TimeOutVal := NET_TIMEOUT_MS;
    InternetSetOption(hInternet, INTERNET_OPTION_CONNECT_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));
    InternetSetOption(hInternet, INTERNET_OPTION_RECEIVE_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));
    InternetSetOption(hInternet, INTERNET_OPTION_SEND_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));
    InternetSetOption(hInternet, INTERNET_OPTION_DATA_RECEIVE_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));
    InternetSetOption(hInternet, INTERNET_OPTION_DATA_SEND_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));

    hRemoteFile := InternetOpenUrl(hInternet, PChar(DownloadUrl), nil, 0,
      INTERNET_FLAG_RELOAD or INTERNET_FLAG_NO_CACHE_WRITE or INTERNET_FLAG_KEEP_CONNECTION, 0);
    if hRemoteFile = nil then
    begin
      ALocalError := GetInternetErrorText(nil);
      LogExecutableDownload('FAIL_OPEN_URL | ' + ALocalError);
      Exit;
    end;

    InternetSetOption(hRemoteFile, INTERNET_OPTION_RECEIVE_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));
    InternetSetOption(hRemoteFile, INTERNET_OPTION_DATA_RECEIVE_TIMEOUT, @TimeOutVal, SizeOf(TimeOutVal));

    StatusCode := 0;
    StatusLen := SizeOf(StatusCode);
    QueryIndex := 0;
    if HttpQueryInfo(hRemoteFile, HTTP_QUERY_STATUS_CODE or HTTP_QUERY_FLAG_NUMBER,
      @StatusCode, StatusLen, QueryIndex) then
    begin
      if (StatusCode < 200) or (StatusCode >= 300) then
      begin
        ALocalError := Format(TrText('Server returned HTTP status %d.'), [StatusCode]);
        LogExecutableDownload('FAIL_HTTP_STATUS | ' + ALocalError);
        Exit;
      end;
    end;

    SizeLen := SizeOf(TotalSize);
    QueryIndex := 0;
    if not HttpQueryInfo(hRemoteFile, HTTP_QUERY_CONTENT_LENGTH or HTTP_QUERY_FLAG_NUMBER,
      @TotalSize, SizeLen, QueryIndex) then
    begin
      TotalSize := 0;
    end;

    OutStream := TFileStream.Create(ALocalPath, fmCreate);
    try
      while True do
      begin
        BytesRead := 0;
        ReadOk := InternetReadFile(hRemoteFile, @Buffer[0], SizeOf(Buffer), BytesRead);
        if (not ReadOk) and (BytesRead = 0) then
        begin
          ALocalError := GetInternetErrorText(hRemoteFile);
          LogExecutableDownload('FAIL_READ | bytes=' + IntToStr(TotalRead) + ' | ' + ALocalError);
          Exit;
        end;

        if BytesRead = 0 then
          Break;

        OutStream.WriteBuffer(Buffer[0], BytesRead);
        Inc(TotalRead, BytesRead);

        if TotalSize <> 0 then
        begin
          Percent := Integer((TotalRead * 100) div TotalSize);
          if Percent > 100 then Percent := 100;
        end
        else
          Percent := Integer((TotalRead div 65536) mod 100);

        if (TotalRead mod UI_UPDATE_CHUNK) < READ_BUF_SIZE then
        begin
          TfrmSmoothLoading.UpdateProgress(Percent);
          Application.ProcessMessages;
        end;

        if TfrmSmoothLoading.CancelRequested then
        begin
          ALocalError := TrText('Download cancelled by user.');
          Exit;
        end;
      end;
    finally
      OutStream.Free;
      OutStream := nil;
    end;

    if (TotalSize > 0) and (TotalRead <> TotalSize) then
    begin
      ALocalError := Format(TrText('Python plugin download incomplete: received %d of %d bytes.'), [TotalRead, TotalSize]);
      LogExecutableDownload('FAIL_INCOMPLETE | ' + ALocalError);
      Exit;
    end;

    if not IsValidDownloadedCompanionExe(ALocalPath) then
    begin
      ALocalError := TrText('Downloaded Python plugin is not a valid PyInstaller executable.');
      LogExecutableDownload('FAIL_INVALID_PYINSTALLER | exe=' + AExeFileName + ' | bytes=' + IntToStr(TotalRead));
      Exit;
    end;

    TfrmSmoothLoading.UpdateProgress(100);
    LogExecutableDownload('SUCCESS | exe=' + AExeFileName + ' | bytes=' + IntToStr(TotalRead));
    Result := True;
    finally
      if hRemoteFile <> nil then
      begin
        InternetCloseHandle(hRemoteFile);
        hRemoteFile := nil;
      end;
      if hInternet <> nil then
      begin
        InternetCloseHandle(hInternet);
        hInternet := nil;
      end;
    end;
  end;

begin
  Result := False;
  AErrorMsg := '';
  hInternet := nil;
  hRemoteFile := nil;
  OutStream := nil;
  TotalRead := 0;
  TotalSize := 0;

  TfrmSmoothLoading.ShowLoading(Format(TrText('Downloading Python plugin %s ... please wait.'), [AExeFileName]), False);
  TfrmSmoothLoading.UpdateProgress(0);
  TfrmSmoothLoading.FlushPaint;
  LogExecutableDownload('START | exe=' + AExeFileName + ' | target=' + ALocalPath);

  try
    { Attempt 1: IE/proxy settings }
    if TryDownloadWithFlags(INTERNET_OPEN_TYPE_PRECONFIG, AttemptError) then
    begin
      Result := True;
      LogExecutableDownload('DONE | exe=' + AExeFileName + ' | strategy=PRECONFIG');
      Exit;
    end;

    if (not Result) and FileExists(ALocalPath) then
      DeleteFile(ALocalPath);

    { Attempt 2: direct connection }
    if TryDownloadWithFlags(INTERNET_OPEN_TYPE_DIRECT, AttemptError) then
    begin
      Result := True;
      LogExecutableDownload('DONE | exe=' + AExeFileName + ' | strategy=DIRECT');
      Exit;
    end;

    if (not Result) and FileExists(ALocalPath) then
      DeleteFile(ALocalPath);

    { Attempt 3: URLMon (often more reliable for large static files) }
    if TryUrlMonDownloadExecutable(AExeFileName, ALocalPath, AttemptError) then
    begin
      Result := True;
      LogExecutableDownload('DONE | exe=' + AExeFileName + ' | strategy=URLMON');
      Exit;
    end;

    AErrorMsg := AttemptError;
    if AErrorMsg = '' then
      AErrorMsg := TrText('Unknown error.');
    TfrmSmoothLoading.UpdateProgressWithDetail(0,
      Format(TrText('Error downloading Python plugin %s: %s'), [AExeFileName, AErrorMsg]));
    TfrmSmoothLoading.FlushPaint;
    Application.ProcessMessages;
    LogExecutableDownload('FAILED_ALL_ATTEMPTS | exe=' + AExeFileName + ' | error=' + AErrorMsg);
  finally
    if hRemoteFile <> nil then InternetCloseHandle(hRemoteFile);
    if hInternet <> nil then InternetCloseHandle(hInternet);
    TfrmSmoothLoading.HideLoading;

    if (not Result) and FileExists(ALocalPath) then
    begin
      try
        DeleteFile(ALocalPath);
        LogExecutableDownload('CLEANUP_PARTIAL | exe=' + AExeFileName + ' | file=' + ALocalPath);
      except
      end;
    end;
  end;
end;

function TfrmMain.ConsumerRAGWriteLine(const AText: string): Boolean;
var
  Data: UTF8String;
  BytesWritten: DWORD;
begin
  Result := False;
  if (not FConsumerRAGProcessRunning) or (FConsumerRAGStdInWrite = 0) or
     (FConsumerRAGStdInWrite = INVALID_HANDLE_VALUE) then Exit;
  Data := UTF8Encode(AText + #10);
  Result := Windows.WriteFile(FConsumerRAGStdInWrite, Pointer(Data)^,
    Length(Data), BytesWritten, nil) and (BytesWritten = DWORD(Length(Data)));
end;

procedure TfrmMain.StartConsumerRAGProcess;
var
  Security: TSecurityAttributes;
  StdOutWrite: THandle;
  StdInRead: THandle;
  StartupInfo: TStartupInfo;
  ScriptPath: string;
  WorkingDir: string;
  FileName: string;
  CommandLine: string;
  Created: Boolean;
  LastErr: DWORD;
begin
  EnsureConsumerRAGPanel;

  FileName := ResolveConsumerSourceFilePath;
  if FileName = '' then
  begin
    SetConsumerRAGStatus(TrText('No valid source file'));
    ShowAppMessage(TrText('Select a valid input file before starting Advanced AI Chat (file).'));
    Exit;
  end;

  if FConsumerRAGProcessRunning then
    StopConsumerRAGProcess;

  ScriptPath := ResolveConsumerRAGScriptPath;
  if ScriptPath = '' then
  begin
    SetConsumerRAGStatus(TrText('Executable not found'));
    AppendConsumerRAGTranscriptEx('ERROR', TrText('Advanced AI Chat (file) Python plugin (ConsumerRAG.exe) not found.'));
    Exit;
  end;

  if Assigned(FConsumerRAGMemo) then
    FConsumerRAGMemo.Clear;

  AppendConsumerRAGTranscriptEx('STATUS', TrText('Starting Advanced AI Chat (file) session...'));
  SetConsumerRAGStatus(TrText('Starting...'));
  if Assigned(FConsumerRAGInputEdit) then
    FConsumerRAGInputEdit.Enabled := False;
  if Assigned(FConsumerRAGSendButton) then
    FConsumerRAGSendButton.Enabled := False;
  if Assigned(FConsumerRAGInputPanel) then
    FConsumerRAGInputPanel.Height := 64;

  FillChar(Security, SizeOf(Security), 0);
  Security.nLength := SizeOf(Security);
  Security.bInheritHandle := True;

  StdOutWrite := 0;
  StdInRead := 0;
  FConsumerRAGStdOutRead := 0;
  FConsumerRAGStdInWrite := 0;
  FillChar(FConsumerRAGProcessInfo, SizeOf(FConsumerRAGProcessInfo), 0);

  if not CreatePipe(FConsumerRAGStdOutRead, StdOutWrite, @Security, 0) then
  begin
    SetConsumerRAGStatus(TrText('Pipe error'));
    AppendConsumerRAGTranscriptEx('ERROR', TrText('Could not create stdout pipe.'));
    Exit;
  end;
  SetHandleInformation(FConsumerRAGStdOutRead, HANDLE_FLAG_INHERIT, 0);

  if not CreatePipe(StdInRead, FConsumerRAGStdInWrite, @Security, 0) then
  begin
    CloseHandle(FConsumerRAGStdOutRead);
    FConsumerRAGStdOutRead := 0;
    SetConsumerRAGStatus(TrText('Pipe error'));
    AppendConsumerRAGTranscriptEx('ERROR', TrText('Could not create stdin pipe.'));
    Exit;
  end;
  SetHandleInformation(FConsumerRAGStdInWrite, HANDLE_FLAG_INHERIT, 0);

  FillChar(StartupInfo, SizeOf(StartupInfo), 0);
  StartupInfo.cb := SizeOf(StartupInfo);
  StartupInfo.dwFlags := STARTF_USESHOWWINDOW or STARTF_USESTDHANDLES;
  StartupInfo.wShowWindow := SW_HIDE;
  StartupInfo.hStdInput := StdInRead;
  StartupInfo.hStdOutput := StdOutWrite;
  StartupInfo.hStdError := StdOutWrite;

  WorkingDir := ExtractFilePath(ScriptPath);
  { Fast streaming open for any file size (no full local embeddings at startup).
    Semantic index is opt-in via ConsumerRAG --semantic-index (slow on large files). }
  CommandLine := '"' + ScriptPath + '" -file "' + FileName +
    '" --bridge' +
    ' --answer-depth forensic --overview-depth thorough' +
    ' --top-k 32 --chunk-context-chars 8000 --max-context-chars 160000' +
    ' --max-answer-tokens 12000 --profile-scan-lines 2000000' +
    ' --overview-budget-seconds 45 --precision-mode aggressive';

  SetEnvironmentVariable('FF_FASTFILE_BRIDGE', '1');
  SetEnvironmentVariable('PYTHONUNBUFFERED', '1');
  try
    Created := CreateProcess(nil, PChar(CommandLine), nil, nil, True,
      CREATE_NO_WINDOW, nil, PChar(WorkingDir), StartupInfo, FConsumerRAGProcessInfo);
  finally
    SetEnvironmentVariable('FF_FASTFILE_BRIDGE', nil);
    SetEnvironmentVariable('PYTHONUNBUFFERED', nil);
  end;

  CloseHandle(StdOutWrite);
  CloseHandle(StdInRead);

  if not Created then
  begin
    LastErr := GetLastError;
    if FConsumerRAGStdOutRead <> 0 then
    begin
      CloseHandle(FConsumerRAGStdOutRead);
      FConsumerRAGStdOutRead := 0;
    end;
    if FConsumerRAGStdInWrite <> 0 then
    begin
      CloseHandle(FConsumerRAGStdInWrite);
      FConsumerRAGStdInWrite := 0;
    end;
    SetConsumerRAGStatus(TrText('Launch error'));
    AppendConsumerRAGTranscriptEx('ERROR', TrText('Could not start Advanced AI Chat (file) Python plugin (ConsumerRAG.exe).') +
      ' (Error ' + IntToStr(LastErr) + ')');
    Exit;
  end;

  FConsumerRAGProcessRunning := True;
  FConsumerRAGActiveFileName := FileName;
  FConsumerRAGLastPrompt := '';
  if Assigned(FConsumerRAGCancelButton) then
    FConsumerRAGCancelButton.Enabled := True;
  FConsumerRAGReaderThread := TConsumerRAGReaderThread.Create(Self, FConsumerRAGStdOutRead);
  SetConsumerRAGStatus(TrText('Connected'));
end;

procedure TfrmMain.StopConsumerRAGProcess;
var
  Reader: TThread;
  WaitRc: DWORD;
begin
  if not FConsumerRAGProcessRunning and (not Assigned(FConsumerRAGReaderThread)) then
    Exit;

  { Mark stopped first so UI actions (Close/Cancel) do not re-enter a hang path. }
  FConsumerRAGProcessRunning := False;

  if FConsumerRAGProcessInfo.hProcess <> 0 then
  begin
    { Do not wait for a graceful Python exit — onefile extract / torch load ignores stdin. }
    TerminateProcess(FConsumerRAGProcessInfo.hProcess, 0);
  end;

  if FConsumerRAGStdInWrite <> 0 then
  begin
    CloseHandle(FConsumerRAGStdInWrite);
    FConsumerRAGStdInWrite := 0;
  end;

  if FConsumerRAGStdOutRead <> 0 then
  begin
    { Closing the pipe unblocks the reader thread's ReadFile/PeekNamedPipe. }
    CloseHandle(FConsumerRAGStdOutRead);
    FConsumerRAGStdOutRead := 0;
  end;

  Reader := FConsumerRAGReaderThread;
  FConsumerRAGReaderThread := nil;
  if Assigned(Reader) then
  begin
    Reader.Terminate;
    WaitRc := WaitForSingleObject(Reader.Handle, 750);
    if WaitRc = WAIT_OBJECT_0 then
      Reader.Free
    else
    begin
      { Avoid freezing the UI if the reader is stuck; abandon the thread object. }
      Reader.FreeOnTerminate := True;
    end;
  end;

  if FConsumerRAGProcessInfo.hThread <> 0 then
  begin
    CloseHandle(FConsumerRAGProcessInfo.hThread);
    FConsumerRAGProcessInfo.hThread := 0;
  end;
  if FConsumerRAGProcessInfo.hProcess <> 0 then
  begin
    CloseHandle(FConsumerRAGProcessInfo.hProcess);
    FConsumerRAGProcessInfo.hProcess := 0;
  end;

  FillChar(FConsumerRAGProcessInfo, SizeOf(FConsumerRAGProcessInfo), 0);
  FConsumerRAGActiveFileName := '';
  FConsumerRAGLastPrompt := '';
  ClearConsumerRAGOptionButtons;
  if Assigned(FConsumerRAGInputEdit) then
    FConsumerRAGInputEdit.Enabled := False;
  if Assigned(FConsumerRAGSendButton) then
    FConsumerRAGSendButton.Enabled := False;
  if Assigned(FConsumerRAGCancelButton) then
    FConsumerRAGCancelButton.Enabled := False;
  UpdateConsumerRAGInputPanelHeight;
  if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible then
    SetConsumerRAGStatus(TrText('Disconnected'));
end;

procedure TfrmMain.ShowConsumerAIPanel;
begin
  { Dedicated SQL chat UI retired — Python still runs; answers go to Assistente IA. }
  EnsureConsumerAIPanel;
end;

procedure TfrmMain.HideConsumerAIPanel;
var
  TargetParent: TWinControl;
begin
  FAssistantPendingConsumerAIQuestion := '';
  FAssistantPendingResultsPdf := False;
  FAssistantCollectingConsumerAIResult := False;
  FAssistantPendingResultsPdfQuestion := '';
  FAssistantConsumerAIResultBuf := '';
  FAssistantDelegateConsumerActive := False;
  if not Assigned(FConsumerAIPanel) then Exit;

  if Assigned(FConsumerAIPanel.Parent) then
    TargetParent := FConsumerAIPanel.Parent
  else if Assigned(pnlCenter) then
    TargetParent := pnlCenter
  else
    TargetParent := pnlMain;

  TargetParent.DisableAlign;
  if Assigned(ListView1) and ListView1.HandleAllocated then
    ListView1.Perform(WM_SETREDRAW, 0, 0);
  if TargetParent.HandleAllocated then
    SendMessage(TargetParent.Handle, WM_SETREDRAW, 0, 0);
  try
    FConsumerAIPanel.Visible := False;
    if Assigned(splListview) then
      splListview.Visible := False;
  finally
    if TargetParent.HandleAllocated then
      SendMessage(TargetParent.Handle, WM_SETREDRAW, 1, 0);
    if Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      ListView1.Perform(WM_SETREDRAW, 1, 0);
      RedrawWindow(ListView1.Handle, nil, 0,
        RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW);
    end;
    TargetParent.EnableAlign;
    if TargetParent.HandleAllocated then
      RedrawWindow(TargetParent.Handle, nil, 0,
        RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW);
  end;
end;

procedure TfrmMain.ConsumerAICloseClick(Sender: TObject);
begin
  StopConsumerAIProcess;
  HideConsumerAIPanel;
end;

procedure TfrmMain.ConsumerAIClearClick(Sender: TObject);
begin
  if Assigned(FConsumerAIMemo) then
    FConsumerAIMemo.Clear;
  ClearConsumerAIOptionButtons;
  AppendConsumerAITranscriptEx('STATUS', TrText('Transcript cleared'));
end;

procedure TfrmMain.ConsumerAIExportClick(Sender: TObject);
var
  SD: TSaveDialog;
  SL: TStringList;
begin
  if (not Assigned(FConsumerAIMemo)) or (Trim(FConsumerAIMemo.Text) = '') then
  begin
    AppendConsumerAITranscriptEx('STATUS', TrText('Nothing to export'));
    Exit;
  end;

  SD := TSaveDialog.Create(nil);
  try
    SD.Filter := 'Text files (*.txt)|*.txt|All files (*.*)|*.*';
    SD.DefaultExt := 'txt';
    SD.FileName := 'consumer_ai_transcript_' + FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
    if SD.Execute then
    begin
      { TRichEdit.Lines.SaveToFile writes RTF payload; export plain text explicitly. }
      SL := TStringList.Create;
      try
        SL.Text := FConsumerAIMemo.Text;
        SL.SaveToFile(SD.FileName);
      finally
        SL.Free;
      end;
      NotifyChatFileSaved(FConsumerAIPanel, SD.FileName);
      AppendConsumerAITranscriptEx('STATUS', TrText('Transcript exported to: ') + SD.FileName);
    end;
  finally
    SD.Free;
  end;
end;

procedure TfrmMain.ConsumerAIRestartClick(Sender: TObject);
begin
  StopConsumerAIProcess;
  StartConsumerAIProcess;
end;

procedure TfrmMain.UpdateConsumerAIInputPanelHeight;
begin
  if not Assigned(FConsumerAIInputPanel) then Exit;
  if Assigned(FConsumerAIOptionsPanel) and FConsumerAIOptionsPanel.Visible and
     (FConsumerAIOptionsPanel.ControlCount > 0) then
    FConsumerAIInputPanel.Height := BASE_H + OPTIONS_EXTRA
  else
    FConsumerAIInputPanel.Height := BASE_H;
end;

procedure TfrmMain.ClearConsumerAIOptionButtons;
var
  I: Integer;
begin
  if not Assigned(FConsumerAIOptionsPanel) then Exit;
  for I := FConsumerAIOptionsPanel.ControlCount - 1 downto 0 do
    FConsumerAIOptionsPanel.Controls[I].Free;
  FConsumerAIOptionsPanel.Height := 0;
  FConsumerAIOptionsPanel.Visible := False;
  UpdateConsumerAIInputPanelHeight;
end;

procedure TfrmMain.RebuildConsumerAIOptionButtons(const ACsv: string);
var
  S, Part: string;
  P: Integer;
  X, BtnW: Integer;
  Btn: TsSpeedButton;
  Bmp: TBitmap;
  Tok: string;
begin
  EnsureConsumerAIPanel;
  ClearConsumerAIOptionButtons;
  S := Trim(ACsv);
  if S = '' then Exit;

  Bmp := TBitmap.Create;
  try
    Bmp.SetSize(1, 1);
    begin
      if Assigned(FConsumerAIInputEdit) then
        Bmp.Canvas.Font.Assign(FConsumerAIInputEdit.Font)
      else if Assigned(FConsumerAIPanel) then
        Bmp.Canvas.Font.Assign(FConsumerAIPanel.Font);
      X := 4;
      FConsumerAIOptionsPanel.Visible := True;
      FConsumerAIOptionsPanel.Height := 30;
      while S <> '' do
      begin
        P := PosBMH(',', S);
        if P > 0 then
        begin
          Part := Trim(Copy(S, 1, P - 1));
          Delete(S, 1, P);
        end
        else
        begin
          Part := Trim(S);
          S := '';
        end;
        Tok := Part;
        if Tok = '' then Continue;
        Btn := TsSpeedButton.Create(Self);
        Btn.Parent := FConsumerAIOptionsPanel;
        Btn.Flat := True;
        Btn.Caption := Tok;
        Btn.Hint := Tok;
        Btn.ShowHint := False;
        Btn.Height := 22;
        BtnW := Bmp.Canvas.TextWidth(Tok) + 16;
        if BtnW < 32 then BtnW := 32;
        if BtnW > 100 then BtnW := 100;
        Btn.Width := BtnW;
        Btn.Left := X;
        Btn.Top := 4;
        Btn.OnClick := ConsumerAIOptionButtonClick;
        Inc(X, Btn.Width + 4);
      end;
    end;
  finally
    Bmp.Free;
  end;

  if FConsumerAIOptionsPanel.ControlCount = 0 then
    ClearConsumerAIOptionButtons
  else
    UpdateConsumerAIInputPanelHeight;
end;

procedure TfrmMain.ConsumerAIOptionButtonClick(Sender: TObject);
var
  S: string;
begin
  if not (Sender is TsSpeedButton) then Exit;
  S := Trim(TsSpeedButton(Sender).Hint);
  if S = '' then
    S := Trim(TsSpeedButton(Sender).Caption);
  if not ConsumerAIWriteLine(S) then Exit;
  AppendConsumerAITranscriptEx('YOU', S);
  ClearConsumerAIOptionButtons;
  if Assigned(FConsumerAIInputEdit) then
  begin
    FConsumerAIInputEdit.Text := '';
    FConsumerAIInputEdit.Enabled := False;
  end;
  if Assigned(FConsumerAISendButton) then
    FConsumerAISendButton.Enabled := False;
  SetConsumerAIStatus(TrText('Waiting for Python...'));
end;

procedure TfrmMain.ConsumerAISendClick(Sender: TObject);
var
  TextToSend: string;
begin
  if not Assigned(FConsumerAIInputEdit) then Exit;

  TextToSend := FConsumerAIInputEdit.Text;
  if ConsumerAIWriteLine(TextToSend) then
  begin
    if TextToSend = '' then
      AppendConsumerAITranscriptEx('YOU', '[ENTER]')
    else
      AppendConsumerAITranscriptEx('YOU', TextToSend);
    ClearConsumerAIOptionButtons;
    UpdateConsumerAIInputPanelHeight;
    FConsumerAIInputEdit.Text := '';
    FConsumerAIInputEdit.Enabled := False;
    if Assigned(FConsumerAISendButton) then
      FConsumerAISendButton.Enabled := False;
    SetConsumerAIStatus(TrText('Waiting for Python...'));
  end;
end;


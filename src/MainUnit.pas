procedure TfrmMain.StopTailFollowMode;
begin
  if not FTailActive then
  begin
    if not FApplicationClosing then
      HideTailMacroPanel;
    Exit;
  end;
  FTailActive := False;
  FTailPaused := False;
  FTailPendingLines := 0;
  FTailHighlightFromLine := 0;

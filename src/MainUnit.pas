procedure TfrmMain.CalculateFontMetrics;
var
  Bmp: TBitmap;
begin
  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(ListView1.Font);
    FCharWidth := Bmp.Canvas.TextWidth('W');
    FLineHeight := Abs(Bmp.Canvas.Font.Height);
    
    // Ajuste de margem (padding) do ListView padrao do Windows
    if FLineHeight < 14 then FLineHeight := 14; 
    
    // Fallback de seguranca
    if FCharWidth <= 0 then FCharWidth := 8;
  finally
    Bmp.Free;
  end;
end;

function TfrmMain.ListViewVisualRowHeight: Integer;
var
  FH: Integer;
begin
  Result := 20;
  if not Assigned(ListView1) then Exit;
  if FFastVisualWordWrap then
  begin
    { Mesma logica que ApplyWordWrapRowHeight (SmallImages.Height na ListView). }
    if Assigned(FWordWrapRowImages) and (FWordWrapRowImages.Height > 0) then
      Result := FWordWrapRowImages.Height
    else
    begin
      CalculateFontMetrics;
      Result := Max(48, (FLineHeight + 2) * MinWrapRows);
    end;
  end
  else
  begin
    CalculateFontMetrics;
    Result := Max(18, FLineHeight + 2);
  end;
  FH := Abs(ListView1.Font.Height);
  if FH <= 0 then FH := 16;
  { Garantir espaco minimo para checkbox + texto numa linha. }
  Result := Max(Result, FH + 6);
end;

procedure TfrmMain.SetCheckListVisualRowHeight(const AHeight: Integer);
var
  H: Integer;
begin
  if not Assigned(FCheckListBox) then Exit;
  H := Max(1, AHeight);
  FCheckListVisualRowHeight := H;
  if FCheckListBox.HandleAllocated then
    SendMessage(FCheckListBox.Handle, LB_SETITEMHEIGHT, 0, Makelong(H, 0));
end;

function TfrmMain.CheckListEffectiveRowHeight: Integer;
begin
  if FCheckListVisualRowHeight > 0 then
    Result := FCheckListVisualRowHeight
  else
    Result := ListViewVisualRowHeight;
end;

function TfrmMain.ListRowIndexFromFileLine(const FileLineIdx: Integer): Integer;
var
  NavLine: Int64;
begin
  Result := -1;
  if FileLineIdx < 0 then Exit;
  if not Assigned(ListView1) then Exit;
  if ListviewIsEmpty then Exit;
  if FFilterActive then
  begin
    NavLine := FilteredIndexForRealLine(FileLineIdx);
    if (NavLine >= 0) and (NavLine < ListView1.Items.Count) then
      Result := Integer(NavLine);
    Exit;
  end;
  NavLine := Int64(FileLineIdx) - Int64(CsvDataStartLine) - Offset;
  if (NavLine >= 0) and (NavLine < ListView1.Items.Count) then
    Result := Integer(NavLine);
end;

function TfrmMain.AlignMatchColInLineText(const LineTxt, Needle: string;
  const HintByte0: Integer; const CaseSens: Boolean): Integer;
var
  sLine, sNeed, Sub: string;
  SearchFrom, P, BestP, BestDist, D, Ln, Lnd: Integer;
begin
  Result := HintByte0;
  if (LineTxt = '') or (Needle = '') then Exit;
  Ln := Length(LineTxt);
  Lnd := Length(Needle);
  if Lnd = 0 then Exit;

  if CaseSens then
  begin
    sLine := LineTxt;
    sNeed := Needle;
  end
  else
  begin
    sLine := AnsiUpperCase(LineTxt);
    sNeed := AnsiUpperCase(Needle);
  end;

  BestP := -1;
  BestDist := MaxInt;
  SearchFrom := HintByte0 - 32;
  if SearchFrom < 1 then SearchFrom := 1;
  repeat
    if SearchFrom > Ln then Break;
    Sub := Copy(sLine, SearchFrom, MaxInt);
    P := PosBMH(sNeed, Sub);
    if P = 0 then Break;
    P := SearchFrom + P - 1;
    D := Abs((P - 1) - HintByte0);
    if D < BestDist then
    begin
      BestDist := D;
      BestP := P - 1;
    end;
    SearchFrom := P + 1;
  until SearchFrom > Ln - Lnd + 1;
  if BestP >= 0 then
    Result := BestP;
end;

function TfrmMain.CheckListIndexFromFileLine(const FileLineIdx: Integer): Integer;
var
  I, Line1Based: Integer;
begin
  Result := -1;
  if FileLineIdx < 0 then Exit;
  if not Assigned(FCheckListBox) then Exit;
  Line1Based := FileLineIdx + 1;
  for I := 0 to FCheckListBox.Items.Count - 1 do
    if Integer(FCheckListBox.Items.Objects[I]) = Line1Based then
    begin
      Result := I;
      Exit;
    end;
end;

function TfrmMain.DrawCheckListFindHighlight(CLB: TCheckListBox; const R: TRect;
  const Vis: string; const MatchStart, MatchLen: Integer): Boolean;
var
  Prefix, MatchText, Suffix: string;
  X, Y, X0: Integer;
  WPrefix, WMatch, WSuffix, TH: Integer;
  BaseBk, HlBk, NormalFg: TColor;
  LineIdx: Integer;
  SavedStyle: TFontStyles;
begin
  Result := False;
  if (CLB = nil) or (Vis = '') or (MatchLen <= 0) then Exit;
  if MatchStart < 0 then Exit;
  if MatchStart + MatchLen > Length(Vis) then Exit;
  if R.Right <= R.Left + 2 then Exit;
  LineIdx := FLastFoundLine;
  GetFindMatchHighlightColors(LineIdx, BaseBk, HlBk, NormalFg);
  Prefix := Copy(Vis, 1, MatchStart);
  MatchText := Copy(Vis, MatchStart + 1, MatchLen);
  Suffix := Copy(Vis, MatchStart + 1 + MatchLen, MaxInt);
  CLB.Canvas.Font.Assign(CLB.Font);
  CLB.Canvas.Brush.Style := bsSolid;
  TH := CLB.Canvas.TextHeight('Wg');
  if TH < 1 then TH := 1;
  if TH > (R.Bottom - R.Top) then TH := Max(1, R.Bottom - R.Top - 2);
  Y := R.Top + Max(0, ((R.Bottom - R.Top) - TH) div 2);
  WPrefix := CLB.Canvas.TextWidth(Prefix);
  WMatch := CLB.Canvas.TextWidth(MatchText);
  WSuffix := CLB.Canvas.TextWidth(Suffix);
  X0 := R.Left + 2;
  CLB.Canvas.Brush.Color := BaseBk;
  CLB.Canvas.FillRect(Rect(R.Left, R.Top, R.Right, Y));
  CLB.Canvas.FillRect(Rect(R.Left, Y + TH, R.Right, R.Bottom));
  CLB.Canvas.FillRect(Rect(R.Left, Y, X0, Y + TH));
  if WPrefix > 0 then
    CLB.Canvas.FillRect(Rect(X0, Y, X0 + WPrefix, Y + TH));
  CLB.Canvas.Brush.Color := HlBk;
  CLB.Canvas.FillRect(Rect(X0 + WPrefix, Y, X0 + WPrefix + WMatch, Y + TH));
  CLB.Canvas.Brush.Color := BaseBk;
  if WSuffix > 0 then
    CLB.Canvas.FillRect(Rect(X0 + WPrefix + WMatch, Y, X0 + WPrefix + WMatch + WSuffix, Y + TH));
  CLB.Canvas.FillRect(Rect(X0 + WPrefix + WMatch + WSuffix, Y, R.Right, Y + TH));
  CLB.Canvas.Font.Color := NormalFg;
  X := X0;
  SavedStyle := CLB.Canvas.Font.Style;
  CLB.Canvas.TextOut(X, Y, Prefix);
  Inc(X, WPrefix);
  if FFindMatchSelection then
    CLB.Canvas.Font.Style := SavedStyle + [fsBold];
  CLB.Canvas.TextOut(X, Y, MatchText);
  CLB.Canvas.Font.Style := SavedStyle;
  Inc(X, WMatch);
  CLB.Canvas.TextOut(X, Y, Suffix);
  Result := True;
end;

procedure TfrmMain.ApplyFindMatchSelection;
begin
  FFindMatchSelection := False;
  if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
  if isChecked then
    ApplyFindMatchSelectionCheckList
  else
    ApplyFindMatchSelectionListView;
end;

function TfrmMain.UpdateFindMatchSelectionRectsListView: Boolean;
var
  RowIdx, Rel0, Skip, MatchStart, MatchLen: Integer;
  R: TRect;
  Vis, Prefix, MatchText: string;
  XLeft, XRight, YTop, YBot, TH: Integer;
  Col0W, Col1W: Integer;
  Bmp: TBitmap;
begin
  Result := False;
  if not Assigned(ListView1) or ListviewIsEmpty then Exit;
  if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
  if FFastVisualWordWrap and (not LineFitsSingleListWrapVisualRow(FLastFoundLine)) then Exit;

  RowIdx := ListRowIndexFromFileLine(FLastFoundLine);
  if RowIdx < 0 then Exit;

  Rel0 := FLastFoundCol;
  if Rel0 < 0 then Exit;
  MatchLen := FLastFoundMatchLen;
  Vis := getLineContentsFromLineIndex(FLastFoundLine);
  if Vis = '' then Exit;
  if Rel0 >= Length(Vis) then Exit;
  if Rel0 + MatchLen > Length(Vis) then
    MatchLen := Length(Vis) - Rel0;
  if MatchLen <= 0 then Exit;
  Skip := ListViewHorizTextSkipChars;
  MatchStart := Rel0 - Skip;
  if MatchStart < 0 then Exit;
  if MatchStart + MatchLen > Length(Vis) then
    MatchLen := Length(Vis) - MatchStart;
  if MatchLen <= 0 then Exit;

  R := Rect(0, 0, 0, 0);
  if not ListView_GetSubItemRect(ListView1.Handle, RowIdx, 1, LVIR_LABEL, @R) then
  begin
    if RowIdx >= ListView1.Items.Count then Exit;
    R := ListView1.Items[RowIdx].DisplayRect(drBounds);
    if ListView1.Columns.Count >= 2 then
    begin
      Col0W := ListView1.Columns[0].Width;
      Col1W := ListView1.Columns[1].Width;
    end
    else
    begin
      Col0W := 0;
      Col1W := R.Right - R.Left;
    end;
    R.Left := Col0W + 1;
    R.Right := R.Left + Col1W - 2;
  end;
  if R.Right <= R.Left + 2 then Exit;

  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(ListView1.Font);
    Prefix := Copy(Vis, 1, MatchStart);
    MatchText := Copy(Vis, MatchStart + 1, MatchLen);
    TH := Bmp.Canvas.TextHeight('Wg');
    if TH < 1 then TH := 1;
    if TH > (R.Bottom - R.Top) then TH := Max(1, R.Bottom - R.Top - 2);
    XLeft := R.Left + COL1_PAD + Bmp.Canvas.TextWidth(Prefix);
    XRight := XLeft + Bmp.Canvas.TextWidth(MatchText);
    YTop := R.Top + Max(0, ((R.Bottom - R.Top) - TH) div 2);
    YBot := YTop + TH;
    if XRight <= XLeft then Inc(XRight);
  finally
    Bmp.Free;
  end;

  FBlockStartPoint := Point(XLeft, YTop);
  FBlockEndPoint := Point(XRight, YBot);
  Result := True;
end;

procedure TfrmMain.ApplyFindMatchSelectionListView;
var
  RowIdx: Integer;
begin
  if not UpdateFindMatchSelectionRectsListView then Exit;
  FHasSelection := True;
  FIsDragging := False;
  FFindMatchSelection := True;
  RowIdx := ListRowIndexFromFileLine(FLastFoundLine);
  if RowIdx >= 0 then
    SelectListViewItem(RowIdx);
  ListView1.Invalidate;
end;

function TfrmMain.UpdateFindMatchSelectionRectsCheckList: Boolean;
var
  CheckIdx, Rel0, Skip, MatchStart, MatchLen, PrefixLen: Integer;
  ItemRect, TextR: TRect;
  FullStr, LineS, Vis: string;
  XLeft, XRight, YTop, YBot, TH: Integer;
  OriginXBase, PrefixPx: Integer;
  Bmp: TBitmap;
begin
  Result := False;
  if not Assigned(FCheckListBox) or (FCheckListBox.Items.Count = 0) then Exit;
  if (FLastFoundLine < 0) or (FLastFoundMatchLen <= 0) then Exit;
  if FFastVisualWordWrap then
  begin
    TextR := CheckListBoxWordWrapTextRect(FCheckListBox,
      Classes.Rect(0, 0, FCheckListBox.ClientWidth, 16));
    if EstimateWrapRowsForLine(GetLineContent(FLastFoundLine),
      Max(50, TextR.Right - TextR.Left)) > 1 then
      Exit;
  end;

  CheckIdx := CheckListIndexFromFileLine(FLastFoundLine);
  if CheckIdx < 0 then Exit;

  Rel0 := FLastFoundCol;
  if Rel0 < 0 then Exit;
  MatchLen := FLastFoundMatchLen;
  LineS := getLineContentsFromLineIndex(FLastFoundLine);
  if LineS = '' then Exit;
  if Rel0 >= Length(LineS) then Exit;
  if Rel0 + MatchLen > Length(LineS) then
    MatchLen := Length(LineS) - Rel0;
  if MatchLen <= 0 then Exit;
  Skip := ListViewHorizTextSkipChars;
  MatchStart := Rel0 - Skip;
  if MatchStart < 0 then Exit;
  if MatchStart + MatchLen > Length(LineS) then
    MatchLen := Length(LineS) - MatchStart;
  if MatchLen <= 0 then Exit;

  ItemRect := FCheckListBox.ItemRect(CheckIdx);
  FullStr := FCheckListBox.Items[CheckIdx];
  PrefixLen := Length(FullStr) - Length(LineS);
  if PrefixLen < 0 then PrefixLen := 0;

  OriginXBase := CheckListTextStartX;
  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(FCheckListBox.Font);
    PrefixPx := FCheckListLinePrefixPx;
    if PrefixPx < 1 then
      PrefixPx := Bmp.Canvas.TextWidth(Copy(FullStr, 1, PrefixLen));
    Vis := LineS;
    XLeft := OriginXBase + PrefixPx + Bmp.Canvas.TextWidth(Copy(Vis, 1, MatchStart));
    XRight := XLeft + Bmp.Canvas.TextWidth(Copy(Vis, MatchStart + 1, MatchLen));
    TH := Bmp.Canvas.TextHeight('Wg');
    if TH < 1 then TH := 1;
    if TH > (ItemRect.Bottom - ItemRect.Top) then
      TH := Max(1, ItemRect.Bottom - ItemRect.Top - 2);
    YTop := ItemRect.Top + Max(0, ((ItemRect.Bottom - ItemRect.Top) - TH) div 2);
    YBot := YTop + TH;
    if XRight <= XLeft then Inc(XRight);
  finally
    Bmp.Free;
  end;

  FBlockStartPoint := Point(XLeft, YTop);
  FBlockEndPoint := Point(XRight, YBot);
  Result := True;
end;

function TfrmMain.UpdateFindMatchSelectionRects: Boolean;
begin
  if isChecked then
    Result := UpdateFindMatchSelectionRectsCheckList
  else
    Result := UpdateFindMatchSelectionRectsListView;
  if Result then
    FHasSelection := True;
end;

procedure TfrmMain.ApplyFindMatchSelectionCheckList;
var
  CheckIdx: Integer;
  VisCount: Integer;
begin
  if not UpdateFindMatchSelectionRectsCheckList then Exit;
  FIsDragging := False;
  FFindMatchSelection := True;
  FHasSelection := True;
  CheckIdx := CheckListIndexFromFileLine(FLastFoundLine);
  if CheckIdx >= 0 then
  begin
    FCheckListBox.ItemIndex := CheckIdx;
    VisCount := FCheckListBox.ClientHeight div Max(1, CheckListEffectiveRowHeight);
    if VisCount < 1 then VisCount := 1;
    if CheckIdx < FCheckListBox.TopIndex then
      FCheckListBox.TopIndex := CheckIdx
    else if CheckIdx >= FCheckListBox.TopIndex + VisCount then
      FCheckListBox.TopIndex := CheckIdx - VisCount + 1;
  end;
  FCheckListBox.Invalidate;
end;


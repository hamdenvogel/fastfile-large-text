procedure TfrmMain.AssistantCbReplaceAll(const AFind, AReplace: string; ACaseSensitive: Boolean);
var
  EffPath: string;
begin
  EnsureReadTabVisible;
  if not AssistantCbHasOpenFile then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if Trim(AFind) = '' then Exit;
  if not EnsureWritableSession then
  begin
    FastFileMessageBox(PChar(TrText('Read-only session is enabled. Turn it off in Options to edit or save the file.')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  EffPath := CurrentEffectiveFilePath;
  if EffPath = '' then Exit;
  if FastFileMessageBox(
    PChar(TrText('Replace all occurrences of "') + AFind + '" with "' + AReplace + '"?' + #13#10 + #13#10 +
      TrText('Streaming replace writes a temp file, then swaps it over the original when possible. Free disk space is checked first. A safety limit on match count applies. This cannot be undone.') +
      iff(EffectiveUseSegmentedHeavyOps(GetFileSize(EffPath), totalLines, 0),
        #13#10 + #13#10 + TrText('Line-segmented mode is ON: Replace All runs on line-aligned parts; matches that span a part boundary may be missed.'),
        '') + #13#10 + #13#10 +
      TrText('Continue?')),
    PChar(TrText('Replace All')), MB_YESNO or MB_ICONQUESTION) <> IDYES then
    Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  BeginHeavyFileMutate;
  TReplaceAllThread.Create(EffPath,
    AFind, AReplace,
    ACaseSensitive, False,
    True, True,
    EffectiveUseSegmentedHeavyOps(GetFileSize(EffPath), totalLines, 0) and HasDenseLineIndexOnDisk,
    FastFileExeDirPath(TEMPFILE),
    250000,
    '',
    False,
    True);
  UpdateStatusBar(TrText('Assistant.Status.ReplaceAll'), iaRight);
end;


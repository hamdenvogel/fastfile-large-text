procedure TfrmMain.RestoreSkinHueTabFromIni;
var
  Id: string;
  i: Integer;
  It, Sel: TacTitleBarItem;
begin
  if (IniName = '') or not Assigned(sTitleBar1) then Exit;
  Id := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_SKIN_HUE_TAB, IniName));
  if Id = '' then Exit;
  Sel := nil;
  for i := 0 to sTitleBar1.Items.Count - 1 do
    if SameText(sTitleBar1.Items[i].Name, Id) then
    begin
      Sel := sTitleBar1.Items[i];
      Break;
    end;
  if not Assigned(Sel) then Exit;
  for i := 0 to sTitleBar1.Items.Count - 1 do
  begin
    It := sTitleBar1.Items[i];
    if (It <> Sel) and SameText(Copy(It.Name, 1, 5), 'tbTab') then
      It.Down := False;
  end;
  Sel.Down := True;
  if DataModule1.sSkinManager1.HueOffset <> Sel.Tag then
  begin
    DataModule1.sSkinManager1.BeginUpdate;
    DataModule1.sSkinManager1.HueOffset := Sel.Tag;
    DataModule1.sSkinManager1.EndUpdate(True, False);
  end;
end;

type
  TsPageControlTabAccess = class(TsPageControl);

procedure TfrmMain.pgMainTabMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  i: Integer;
begin
  EndTabDrag;
  if Button <> mbLeft then Exit;
  i := pgMain.GetTabUnderMouse(Point(X, Y));
  if (i < 0) or (i >= pgMain.PageCount) then Exit;
  FTabDragPage := pgMain.Pages[i];
  FTabDragStart := Point(X, Y);
end;

procedure TfrmMain.pgMainTabMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
var
  i, W: Integer;
  Tgt: TTabSheet;
  DragR, TgtR: TRect;
  Ok: Boolean;
begin
  if not Assigned(FTabDragPage) then Exit;
  { Sem captura do rato: se o botao foi largado fora das abas, termina aqui. }
  if GetKeyState(VK_LBUTTON) >= 0 then
  begin
    EndTabDrag;
    Exit;
  end;
  if not FTabDragging then
  begin
    if (Abs(X - FTabDragStart.X) < GetSystemMetrics(SM_CXDRAG)) and
       (Abs(Y - FTabDragStart.Y) < GetSystemMetrics(SM_CYDRAG)) then
      Exit;
    FTabDragging := True;
    FTabDragOldCursor := Screen.Cursor;
    Screen.Cursor := crDrag;
    { Sem captura do rato o botao pode ser largado fora das abas (sem MouseUp):
      o timer garante que o cursor volta ao normal. }
    if not Assigned(FTabDragTimer) then
    begin
      FTabDragTimer := TTimer.Create(Self);
      FTabDragTimer.Interval := 50;
      FTabDragTimer.OnTimer := TabDragTimerTick;
    end;
    FTabDragTimer.Enabled := True;
  end;
  i := pgMain.GetTabUnderMouse(Point(X, Y));
  if (i < 0) or (i >= pgMain.PageCount) then Exit;
  Tgt := pgMain.Pages[i];
  if (Tgt = FTabDragPage) or not Tgt.TabVisible or not FTabDragPage.TabVisible then Exit;
  { Abas de larguras diferentes: so' troca quando o cursor fica sobre a posicao que a
    aba arrastada vai ocupar, senao a troca oscila de volta no movimento seguinte. }
  DragR := TsPageControlTabAccess(pgMain).SkinTabRect(FTabDragPage.TabIndex,
    FTabDragPage = pgMain.ActivePage);
  TgtR := TsPageControlTabAccess(pgMain).SkinTabRect(Tgt.TabIndex, Tgt = pgMain.ActivePage);
  W := DragR.Right - DragR.Left;
  if Tgt.PageIndex > FTabDragPage.PageIndex then
    Ok := X >= TgtR.Right - W
  else
    Ok := X <= TgtR.Left + W;
  if not Ok then Exit;
  FTabDragPage.PageIndex := Tgt.PageIndex;
  FTabOrderCustom := True;
  SaveMainTabOrderToIni;
end;


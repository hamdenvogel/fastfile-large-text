procedure TfrmMain.EnsureTopFileQuickActions;
const
  STRIP_H = 34;
  { File-path row (~48) + tools strip under timer; extra for AlphaControls chrome. }
  TOP_HOST_H = 92;
var
  ClearW, CopyW, MoreW: Integer;
  StripHost: TWinControl;

  function LinkCaptionWidth(ABtn: TsSpeedButton; const ACaption: string;
    AMinW: Integer): Integer;
  var
    Bmp: TBitmap;
  begin
    Result := AMinW;
    if not Assigned(ABtn) then Exit;
    Bmp := TBitmap.Create;
    try
      Bmp.Canvas.Font.Assign(ABtn.Font);
      Result := Bmp.Canvas.TextWidth(StringReplace(ACaption, '&', '', [rfReplaceAll])) + 20;
    finally
      Bmp.Free;
    end;
    if Result < AMinW then
      Result := AMinW;
  end;

  procedure PrepStripBtn(ABtn: TsSpeedButton);
  begin
    if not Assigned(ABtn) then Exit;
    ABtn.Parent := FTopQuickActions;
    StyleListViewLineToolBtn(ABtn);
    ABtn.Images := nil;
    ABtn.ImageIndex := -1;
    ABtn.AlignWithMargins := True;
    ABtn.Margins.SetBounds(4, 0, 0, 0);
    ABtn.Align := alNone;
  end;
begin
  { Strip under pnlTimerLog only (like FLvTools under the list). Do NOT put it on
    pnlTop alBottom — that steals height from pnlFileButtons and clips All/Linha. }
  if not Assigned(pnlTop) or not Assigned(pnlTimerLog) then Exit;
  StripHost := pnlTimerLog;

  if not Assigned(FPopupTopFileOptions) then
  begin
    FPopupTopFileOptions := TPopupMenu.Create(Self);
    FPopupTopFileOptions.OnPopup := TopFileOptionsPopup;
  end;

  pnlTop.Height := TOP_HOST_H;
  if Assigned(pnlFileButtons) then
  begin
    pnlFileButtons.Align := alLeft;
    { Keep original content height; do not shrink with the timer strip. }
    if pnlFileButtons.Height < 48 then
      pnlFileButtons.Height := 48;
  end;

  if not Assigned(FTopQuickActions) then
  begin
    FTopQuickActions := TsPanel.Create(Self);
    FTopQuickActions.Name := 'FTopQuickActions';
  end;
  FTopQuickActions.Parent := StripHost;
  FTopQuickActions.Caption := '';
  FTopQuickActions.BevelOuter := bvNone;
  FTopQuickActions.BevelInner := bvNone;
  FTopQuickActions.BorderWidth := 0;
  FTopQuickActions.Align := alNone;
  FTopQuickActions.Width := StripHost.ClientWidth;
  FTopQuickActions.Height := STRIP_H;
  FTopQuickActions.Align := alBottom;
  FTopQuickActions.Padding.Left := 8;
  FTopQuickActions.Padding.Top := 5;
  FTopQuickActions.Padding.Right := 8;
  FTopQuickActions.Padding.Bottom := 5;
  FTopQuickActions.ShowHint := True;
  FTopQuickActions.Visible := True;
  try
    FTopQuickActions.SkinData.SkinSection := 'TRANSPARENT';
  except
    FTopQuickActions.ParentBackground := False;
    FTopQuickActions.Color := clWindow;
  end;

  if Assigned(FTopQuickSep) then
    FTopQuickSep.Visible := False;

  pnlTimerLog.Align := alClient;
  if Assigned(mmTimer) then
  begin
    mmTimer.Parent := pnlTimerLog;
    mmTimer.Align := alClient;
    mmTimer.SendToBack;
  end;

  if not Assigned(FBtnTopTimerClear) then
  begin
    FBtnTopTimerClear := TsSpeedButton.Create(Self);
    FBtnTopTimerClear.OnClick := btnTopTimerClearClick;
  end;
  PrepStripBtn(FBtnTopTimerClear);
  FBtnTopTimerClear.Caption := TrText('Assistant.ClearReply');

  if not Assigned(FBtnTopTimerCopy) then
  begin
    FBtnTopTimerCopy := TsSpeedButton.Create(Self);
    FBtnTopTimerCopy.OnClick := btnTopTimerCopyClick;
  end;
  PrepStripBtn(FBtnTopTimerCopy);
  FBtnTopTimerCopy.Caption := TrText('Assistant.CopyReply');

  if not Assigned(FBtnTopExport) then
  begin
    FBtnTopExport := TsSpeedButton.Create(Self);
    FBtnTopExport.OnClick := miExportClick;
  end;
  FBtnTopExport.Parent := FTopQuickActions;
  FBtnTopExport.Visible := False;
  FBtnTopExport.Align := alNone;

  if not Assigned(FBtnTopFileOptions) then
  begin
    FBtnTopFileOptions := TsSpeedButton.Create(Self);
    FBtnTopFileOptions.OnClick := TopFileOptionsClick;
  end;
  PrepStripBtn(FBtnTopFileOptions);
  FBtnTopFileOptions.ShowCaption := True;
  FBtnTopFileOptions.Alignment := taCenter;
  FBtnTopFileOptions.Caption := #$25BE;

  ClearW := LinkCaptionWidth(FBtnTopTimerClear, FBtnTopTimerClear.Caption, 72);
  CopyW := LinkCaptionWidth(FBtnTopTimerCopy, FBtnTopTimerCopy.Caption, 72);
  MoreW := 28;
  FBtnTopTimerClear.Width := ClearW;
  FBtnTopTimerCopy.Width := CopyW;
  FBtnTopFileOptions.Width := MoreW;
  FBtnTopFileOptions.Align := alRight;
  FBtnTopTimerCopy.Align := alRight;
  FBtnTopTimerClear.Align := alRight;

  FTopQuickActions.BringToFront;
  BuildTopFileOptionsPopup;
  RefreshTopFileQuickActionCaptions;
end;

procedure TfrmMain.LayoutTopFileOptionsButton;
const
  STRIP_H = 34;
  TOP_HOST_H = 92;
var
  ClearW, CopyW, MoreW: Integer;

  function LinkCaptionWidth(ABtn: TsSpeedButton; const ACaption: string;
    AMinW: Integer): Integer;
  var
    Bmp: TBitmap;
  begin
    Result := AMinW;
    if not Assigned(ABtn) then Exit;
    Bmp := TBitmap.Create;
    try
      Bmp.Canvas.Font.Assign(ABtn.Font);
      Result := Bmp.Canvas.TextWidth(StringReplace(ACaption, '&', '', [rfReplaceAll])) + 20;
    finally
      Bmp.Free;
    end;
    if Result < AMinW then
      Result := AMinW;
  end;
begin
  if not Assigned(FTopQuickActions) or not Assigned(pnlTimerLog) then Exit;
  if Assigned(pnlTop) then
    pnlTop.Height := TOP_HOST_H;
  if not Assigned(FTopQuickActions.Parent) or (FTopQuickActions.Parent <> pnlTimerLog) then
    FTopQuickActions.Parent := pnlTimerLog;
  FTopQuickActions.Caption := '';
  FTopQuickActions.Align := alNone;
  FTopQuickActions.Height := STRIP_H;
  FTopQuickActions.Align := alBottom;
  FTopQuickActions.Visible := True;
  if Assigned(FTopQuickSep) then
    FTopQuickSep.Visible := False;
  if Assigned(FBtnTopExport) then
  begin
    if not Assigned(FBtnTopExport.Parent) then
      FBtnTopExport.Parent := FTopQuickActions;
    FBtnTopExport.Visible := False;
    FBtnTopExport.Align := alNone;
  end;

  ClearW := 72;
  CopyW := 72;
  MoreW := 28;
  if Assigned(FBtnTopTimerClear) then
  begin
    if not Assigned(FBtnTopTimerClear.Parent) then
      FBtnTopTimerClear.Parent := FTopQuickActions;
    ClearW := LinkCaptionWidth(FBtnTopTimerClear, FBtnTopTimerClear.Caption, 72);
    FBtnTopTimerClear.Width := ClearW;
    FBtnTopTimerClear.AlignWithMargins := True;
    FBtnTopTimerClear.Margins.SetBounds(4, 0, 0, 0);
    FBtnTopTimerClear.Align := alNone;
  end;
  if Assigned(FBtnTopTimerCopy) then
  begin
    if not Assigned(FBtnTopTimerCopy.Parent) then
      FBtnTopTimerCopy.Parent := FTopQuickActions;
    CopyW := LinkCaptionWidth(FBtnTopTimerCopy, FBtnTopTimerCopy.Caption, 72);
    FBtnTopTimerCopy.Width := CopyW;
    FBtnTopTimerCopy.AlignWithMargins := True;
    FBtnTopTimerCopy.Margins.SetBounds(4, 0, 0, 0);
    FBtnTopTimerCopy.Align := alNone;
  end;
  if Assigned(FBtnTopFileOptions) then
  begin
    if not Assigned(FBtnTopFileOptions.Parent) then
      FBtnTopFileOptions.Parent := FTopQuickActions;
    FBtnTopFileOptions.Width := MoreW;
    FBtnTopFileOptions.AlignWithMargins := True;
    FBtnTopFileOptions.Margins.SetBounds(4, 0, 0, 0);
    FBtnTopFileOptions.Align := alNone;
  end;
  if Assigned(FBtnTopFileOptions) then
    FBtnTopFileOptions.Align := alRight;
  if Assigned(FBtnTopTimerCopy) then
    FBtnTopTimerCopy.Align := alRight;
  if Assigned(FBtnTopTimerClear) then
    FBtnTopTimerClear.Align := alRight;

  FTopQuickActions.BringToFront;
end;

procedure TfrmMain.BuildTopFileOptionsPopup;

procedure TfrmMain.UpdateFileLineHoverHint(AControl: TControl; const RowIdx: Integer;
  const IsCheckList: Boolean; const MouseX, MouseY: Integer);
var
  FileLineIdx: Integer;
  Content: string;
  UseAlpha: Boolean;
  Col0Right: Integer;
begin
  if not IsCheckList then
    ApplyListViewNativeTipsDisabled;

  { Hint de linha so com ListView/CheckList sozinhas na aba Read File. }
  if not CanShowFileLineHoverHint then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  if not Assigned(AControl) then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;
  if FLineAutofillDragging or FIsDragging then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;
  if RowIdx < 0 then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  { Sem hint na 1a coluna (nº da linha) — ListView e Select/CheckList. }
  if IsCheckList then
  begin
    if IsClickInCheckListLineColumn(MouseX, MouseY) then
    begin
      ClearFileLineHoverHint;
      Exit;
    end;
  end
  else if Assigned(ListView1) and (ListView1.Columns.Count > 0) then
  begin
    Col0Right := ListView1.Columns[0].Width;
    if ListView1.HandleAllocated then
      Dec(Col0Right, GetScrollPos(ListView1.Handle, SB_HORZ));
    if MouseX < Col0Right then
    begin
      ClearFileLineHoverHint;
      Exit;
    end;
  end;

  UseAlpha := Assigned(sAlphaHints1) and sAlphaHints1.Active;
  if (not UseAlpha) and (not Application.ShowHint) then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;
  if UseAlpha and ActionHintsDisable.Checked then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  if IsCheckList then
    FileLineIdx := FileLineIndexFromCheckListRow(RowIdx)
  else
    FileLineIdx := FileLineIndexFromListRow(RowIdx);
  if FileLineIdx < 0 then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  Content := getLineContentsFromLineIndex(FileLineIdx);
  if Length(Trim(Content)) < LINE_HINT_MIN_CHARS then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  { Ja visivel na mesma linha: nao reiniciar. }
  if FLineHintVisible and (FLineHintRow = RowIdx) and (FLineHintIsCheckList = IsCheckList) then
    Exit;

  { Mesmo pedido pendente: so atualiza posicao do mouse. }
  if Assigned(FLineHintDelayTimer) and FLineHintDelayTimer.Enabled and
     (FPendingLineHintRow = RowIdx) and (FPendingLineHintIsCheckList = IsCheckList) and
     (FPendingLineHintControl = AControl) then
  begin
    FPendingLineHintX := MouseX;
    FPendingLineHintY := MouseY;
    Exit;
  end;

  { Mudou de linha: esconde o atual e agenda um pequeno delay. }
  if FLineHintVisible then
  begin
    FLineHintVisible := False;
    FLineHintRow := -1;
    if Assigned(sAlphaHints1) then
      sAlphaHints1.HideHint;
    Application.CancelHint;
  end;

  FPendingLineHintControl := AControl;
  FPendingLineHintRow := RowIdx;
  FPendingLineHintIsCheckList := IsCheckList;
  FPendingLineHintX := MouseX;
  FPendingLineHintY := MouseY;
  if Assigned(FLineHintDelayTimer) then
  begin
    FLineHintDelayTimer.Enabled := False;
    FLineHintDelayTimer.Interval := PrefLineHintShowDelayMs;
    FLineHintDelayTimer.Enabled := True;
  end
  else
    ShowFileLineHoverHintNow(AControl, RowIdx, IsCheckList, MouseX, MouseY);
end;

procedure TfrmMain.ShowFileLineHoverHintNow(AControl: TControl; const RowIdx: Integer;
  const IsCheckList: Boolean; const MouseX, MouseY: Integer);
var
  FileLineIdx: Integer;
  Line1Based: Int64;
  Content, HintText: string;
  Pt: TPoint;
  UseAlpha: Boolean;
  SavedHtmlMode: Boolean;
  SavedAutoAlign: Boolean;
begin
  if not CanShowFileLineHoverHint then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;
  if not Assigned(AControl) or (RowIdx < 0) then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  UseAlpha := Assigned(sAlphaHints1) and sAlphaHints1.Active;
  if (not UseAlpha) and (not Application.ShowHint) then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  if IsCheckList then
    FileLineIdx := FileLineIndexFromCheckListRow(RowIdx)
  else
    FileLineIdx := FileLineIndexFromListRow(RowIdx);
  if FileLineIdx < 0 then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  Content := getLineContentsFromLineIndex(FileLineIdx);
  if Length(Trim(Content)) < LINE_HINT_MIN_CHARS then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  Line1Based := Int64(FileLineIdx) + 1;
  HintText := BuildLineContentHoverHint(Line1Based, Content);
  if HintText = '' then
  begin
    ClearFileLineHoverHint;
    Exit;
  end;

  FLineHintRow := RowIdx;
  FLineHintIsCheckList := IsCheckList;
  FLineHintVisible := True;
  AControl.ShowHint := True;
  AControl.Hint := HintText;
  { Prefer cursor screen pos — CheckListBox ClientToScreen + AutoAlignment can pin
    tall hints to the bottom of the monitor while the mouse is higher up.
    AlphaControls treats X=0 or Y=0 as "unset", so avoid zeros. }
  if not GetCursorPos(Pt) then
    Pt := AControl.ClientToScreen(Point(MouseX, MouseY));
  Inc(Pt.Y, 18);
  if Pt.X < 1 then Pt.X := 1;
  if Pt.Y < 1 then Pt.Y := 1;

  if UseAlpha then
  begin
    sAlphaHints1.MaxWidth := LINE_HINT_MAX_WIDTH;
    { Plain CRLF text needs HTMLMode off — HTML <font> made body text tiny. }
    SavedHtmlMode := sAlphaHints1.HTMLMode;
    SavedAutoAlign := sAlphaHints1.AutoAlignment;
    try
      sAlphaHints1.HTMLMode := False;
      sAlphaHints1.AutoAlignment := False;
      sAlphaHints1.ShowHint(Pt, HintText, 20000);
    finally
      sAlphaHints1.AutoAlignment := SavedAutoAlign;
      sAlphaHints1.HTMLMode := SavedHtmlMode;
    end;
  end
  else
  begin
    Application.CancelHint;
    Application.ActivateHint(Pt);
  end;
end;


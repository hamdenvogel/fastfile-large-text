procedure TfrmMain.ApplySplitPatternAISuggestResult(const Ok: Boolean; const Ans: WideString; const Err: String);
var
  Frm: TMergeFilesDialogForm;
  Prepared, Appendix, FullText, Mark: String;
  P: Integer;
begin
  Screen.Cursor := crDefault;
  FSplitPatternAISuggestBusy := False;
  if Assigned(FSplitByPatternHosted) then
  begin
    Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
    if Assigned(Frm.BtnRegexSuggestAI) then Frm.BtnRegexSuggestAI.Enabled := True;
    if Assigned(Frm.BtnRegexAI) then Frm.BtnRegexAI.Enabled := True;
  end;

  if not Ok then
  begin
    if Trim(Err) <> '' then
      ShowAppMessage(TrText('AI suggestions could not be retrieved:') + ' ' + Err)
    else
      ShowAppMessage(TrText('AI_SPLIT_FAILED_UNKNOWN'));
    Exit;
  end;

  Prepared := PrepareAiMemoText(Ans);
  if Trim(Prepared) = '' then
  begin
    ShowAppMessage(TrText('The AI returned an empty response. Try again or shorten the sample.'));
    Exit;
  end;

  if not Assigned(FSplitByPatternHosted) then Exit;
  Frm := TMergeFilesDialogForm(FSplitByPatternHosted);
  if not Assigned(Frm.MemoRegexGuide) then Exit;

  Appendix := BuildAiReplyRegexValidationAppendix(Prepared);
  Frm.MemoRegexGuide.Lines.BeginUpdate;
  try
    FullText := FSplitPatternMemoAutoExamples + #13#10#13#10 +
      '--- ' + TrText('AI-generated suggestions') + ' ---' + #13#10#13#10 + Prepared + Appendix;
    Frm.MemoRegexGuide.Text := FullText;
  finally
    Frm.MemoRegexGuide.Lines.EndUpdate;
  end;

  Mark := '--- ' + TrText('AI-generated suggestions') + ' ---';
  P := PosBMH(Mark, FullText);
  if P > 0 then
    Frm.MemoRegexGuide.SelStart := P - 1
  else
    Frm.MemoRegexGuide.SelStart := Length(FullText);
  Frm.MemoRegexGuide.SelLength := 0;
  Frm.MemoRegexGuide.Perform(EM_SCROLLCARET, 0, 0);
  Frm.MemoRegexGuide.SetFocus;
  SplitPatternShowAiBanner(Frm);
end;

procedure TfrmMain.LayoutSplitPatternAiBanner(SB: TScrollBox; Frm: TMergeFilesDialogForm);

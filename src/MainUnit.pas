procedure TfrmMain.EnsureMergeLinesTab;
var
  DeltaFile: String;
  AList: TStringList;
  frm: TfrmDeltaEditor;
  i, P: Integer;
  item: TListItem;
begin
  if CurrentEffectiveFilePath = '' then
  begin
    ShowAppMessage(TrText('Please select a file first.'));
    CloseActiveTabSheet;
    Exit;
  end;
  if not FileExists(CurrentEffectiveFilePath) then
  begin
    ShowAppMessage(TrText('File not found.'));
    CloseActiveTabSheet;
    Exit;
  end;
  if not EnsureWritableSession then
  begin
    CloseActiveTabSheet;
    Exit;
  end;

  if Assigned(FDeltaEditorHosted) then
    FreeAndNil(FDeltaEditorHosted);

  if Assigned(tabMergeLines) then
    tabMergeLines.Caption := TrText('Merge lines');

  frm := TfrmDeltaEditor.Create(Self);
  FDeltaEditorHosted := frm;
  ApplyTranslationsToForm(frm);
  frm.BorderStyle := Forms.bsNone;
  frm.Parent := tabMergeLines;
  frm.Align := alClient;
  frm.Color := clBtnFace;
  frm.KeyPreview := True;
  frm.OnKeyDown := HostedEmbeddedTabKeyDown;
  frm.OnEscapeEmbedded := HostedTabCancel;
  frm.Visible := True;

  frm.btnConfirm.OnClick := MergeLinesTabConfirm;
  frm.btnCancel.OnClick := MergeLinesTabCancel;
  frm.ApplyUiLanguage;

  DeltaFile := FastFileTempPath(ChangeFileExt(ExtractFileName(edtFileName.Text), FASTFILE_DELTA_EXT));
  AList := TStringList.Create;
  try
    if FileExists(DeltaFile) then
      AList.LoadFromFile(DeltaFile);
    frm.lvDelta.Items.BeginUpdate;
    try
      for i := 0 to AList.Count - 1 do
      begin
        P := PosBMH(': ', AList[i]);
        if P > 0 then
        begin
          item := frm.InsertSortedItem(StrToInt64Def(Trim(Copy(AList[i], 1, P - 1)), -1));
          if Assigned(item) then
          begin
            if item.SubItems.Count = 0 then
              item.SubItems.Add(Copy(AList[i], P + 2, Length(AList[i])))
            else
              item.SubItems[0] := Copy(AList[i], P + 2, Length(AList[i]));
          end;
        end;
      end;
    finally
      frm.lvDelta.Items.EndUpdate;
    end;
  finally
    AList.Free;
  end;

  frm.BringToFront;
  if Assigned(frm.OnResize) then
    frm.OnResize(frm);
  if frm.edtLineNum.CanFocus then
    frm.edtLineNum.SetFocus
  else if frm.CanFocus then
    frm.SetFocus;
end;

procedure TfrmMain.MergeLinesTabCancel(Sender: TObject);
begin
  CloseActiveTabSheet;
end;

procedure TfrmMain.MergeLinesTabConfirm(Sender: TObject);
var
  frm: TfrmDeltaEditor;
  DeltaFile: String;
  AList: TStringList;
  i: Integer;
begin
  if not Assigned(FDeltaEditorHosted) then Exit;
  frm := TfrmDeltaEditor(FDeltaEditorHosted);

  { Include unsaved edit fields so Merge does not drop the draft row. }
  frm.FlushDraftToList;

  AList := TStringList.Create;
  try
    for i := 0 to frm.lvDelta.Items.Count - 1 do
      if frm.lvDelta.Items[i].SubItems.Count > 0 then
        AList.Add(frm.lvDelta.Items[i].Caption + ': ' + frm.lvDelta.Items[i].SubItems[0]);

    if AList.Count = 0 then
    begin
      ShowAppMessage(TrText('No lines entered. Operation cancelled.'));
      Exit;
    end;

    DeltaFile := FastFileTempPath(ChangeFileExt(ExtractFileName(edtFileName.Text), FASTFILE_DELTA_EXT));
    AList.SaveToFile(DeltaFile);

    if not EnsureOpenFileNotStaleForMutate then Exit;

    if not ConfirmDiskSpaceForMergeLines(edtFileName.Text) then
      Exit;

    PrepareMergeDeltaUndo(AList);
    CloseFileStreams;
    TMergeDeltaThread.Create(edtFileName.Text, DeltaFile);
    CloseActiveTabSheet;
  finally
    AList.Free;
  end;
end;


procedure TfrmMain.AssistantCbGotoLine(ALineNo: Integer);
var
  N: Integer;
  St: TAssistantChainStep;
begin
  EnsureReadTabVisible;
  FillChar(St, SizeOf(St), 0);
  St.ActionId := 'goto_line';
  St.LineNo := ALineNo;
  if AssistantCbTryDeferUntilLoaded(St) then Exit;
  if not AssistantCbHasOpenFile then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  N := ALineNo;
  if N < 1 then
  begin
    DoGotoLine;
    Exit;
  end;
  if (totalLines > 0) and (N > totalLines) then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.LineOutOfRange')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if UsesProportionalZeroScanScroll then
    GotoPhysicalLine1Based(N)
  else
  begin
    gotoLine(N - 1);
    UpdateStatusBar(Format(TrText('Go to line %d'), [N]), iaRight);
  end;
end;

procedure TfrmMain.AssistantCbDeletePhysicalLine(ALineNo: Integer);
var
  LineNum, LineIdx0: Int64;
  OriginalContent: string;
begin
  EnsureReadTabVisible;
  if not AssistantCbHasOpenFile then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if ListviewIsEmpty or (totalLines < 1) then Exit;
  if not EnsureWritableSession then Exit;
  if TryStartAutoIndexForMutation then Exit;

  LineNum := ALineNo;
  if LineNum <= 0 then
    LineNum := totalLines;

  if (LineNum < 1) or (LineNum > totalLines) then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.LineOutOfRange')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;

  LineIdx0 := LineNum - 1;
  OriginalContent := GetLineContent(Integer(LineIdx0));

  { Com filtro ativo a linha pode nao estar na ListView; apagar no ficheiro sem Ctrl+G. }
  if (not FFilterActive) or (FilteredIndexForRealLine(LineIdx0) >= 0) then
    AssistantCbGotoLine(Integer(LineNum));

  if not ApplyEditWithUndo(otDelete, LineNum, OriginalContent, '', True) then
    Exit;
  UpdateStatusBar(TrText('Assistant.Status.DeleteLine'), iaRight);
end;


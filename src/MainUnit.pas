function TfrmMain.TailMacroScriptNormalizedBody: string;
var
  SL: TStringList;
  I, P: Integer;
  Line, Part: string;
begin
  Result := '';
  if not Assigned(FTailMacroEditorMemo) then Exit;
  SL := TStringList.Create;
  try
    SL.Text := FTailMacroEditorMemo.Lines.Text;
    for I := 0 to SL.Count - 1 do
    begin
      Line := Trim(SL[I]);
      if Line = '' then Continue;
      if Line[1] = '#' then Continue;
      P := PosBMH('#', Line);
      if P > 1 then
      begin
        Part := Trim(Copy(Line, 1, P - 1));
        if Part <> '' then
          Result := Result + LowerCase(Part);
      end
      else
        Result := Result + LowerCase(Line);
    end;
    Result := StringReplace(Result, ' ', '', [rfReplaceAll]);
    Result := StringReplace(Result, #9, '', [rfReplaceAll]);
  finally
    SL.Free;
  end;
end;

function TfrmMain.TailMacroScriptIsStubOnly: Boolean;
var
  N: string;
begin
  N := TailMacroScriptNormalizedBody;
  Result := (N = '') or (N = STUB_HEADER_ONLY) or (N = STUB_RETURN_LINE) or
    (N = STUB_RETURN_PASS) or (N = STUB_PASS_ONLY);
end;

function TfrmMain.TailMacroShouldProcessNewLines: Boolean;

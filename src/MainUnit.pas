procedure TfrmMain.RestoreViewAfterSplitExport;
var
  Path, CurOpen: string;
  SavedTotal, SavedPhys, SavedBPI: Int64;
  SavedZeroScan, SavedEstimated: Boolean;
begin
  Path := FSplitClosedSourcePath;
  if Path = '' then Exit;
  FSplitClosedSourcePath := '';
  SavedTotal := FSplitRestoreTotalLines;
  SavedZeroScan := FSplitRestoreZeroScan;
  SavedEstimated := FSplitRestoreZeroScanEstimated;
  SavedPhys := FSplitRestoreZeroScanPhysical;
  SavedBPI := FSplitRestoreBytesPerItem;
  CurOpen := CurrentEffectiveFilePath;
  if CurOpen = '' then Exit;
  if not SameText(Path, ExpandFileName(CurOpen)) then Exit;
  if not FileExists(Path) then Exit;
  ReopenFileStreamsOnly(Path);
  if not Assigned(FSourceFileStream) then Exit;
  FZeroScanMode := SavedZeroScan;
  FZeroScanEstimatedLines := SavedEstimated;
  FZeroScanPhysicalLineCount := SavedPhys;
  FZeroScanBytesPerItem := SavedBPI;
  totalLines := SavedTotal;
  if totalLines <= 0 then
  begin
    if Assigned(FIndexFileStream) and (FIndexFileStream.Size >= INDEX_RECORD_SIZE) then
      totalLines := FIndexFileStream.Size div INDEX_RECORD_SIZE
    else if SavedPhys > 0 then
      totalLines := SavedPhys;
  end;
  if SavedZeroScan and (totalLines > 0) and Assigned(FSourceFileStream) then
    ApplyZeroScanVirtualLineCount(totalLines, SourceFileSize64);
  if FCsvMode and FCsvHasHeader and FCsvHideHeaderRow and (not FFilterActive) then
    ItemCount := Max(0, totalLines - 1)
  else
    ItemCount := totalLines;
  totalCharacters := SourceFileSize64;
  Offset := 0;
  fScrollPos := 0;
  InvalidateLineCache;
  InvalidateOpenFileDiskSnapshot;
  SyncListViewViewportAfterFileLoad;
  if Assigned(ScrollBarVertical) then
  begin
    SafeSetScrollBarPosition(ScrollBarVertical, 0);
    ScrollBarVerticalChange(Self);
  end;
  CaptureOpenFileDiskSnapshot;
  UpdateInfoPanels;
  ApplySessionReadOnlyUi;
  if Assigned(ListView1) and ListView1.HandleAllocated then
  begin
    ListView1.ClearSelection;
    ListView1.Refresh;
    ListView1.Invalidate;
    ListView1.Update;
  end;
end;


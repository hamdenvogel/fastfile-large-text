procedure TfrmMain.HandleConsumerAIProtocolLine(const ALine: string);
var
  PrefixPos: Integer;
  Rest: string;
  SepPos: Integer;
  Kind: string;
  Payload: string;
  LocalizedLine: string;
  VersionPos: Integer;
  InferredOptions: string;

  procedure EnableConsumerAIInput;
  var
    Host: TWinControl;
  begin
    SetConsumerAIStatus(TrText('Awaiting input'));
    if Assigned(FConsumerAIInputPanel) then
    begin
      FConsumerAIInputPanel.Enabled := True;
      FConsumerAIInputPanel.Show;
    end;
    if Assigned(FConsumerAIInputEdit) then
    begin
      Host := FConsumerAIInputEdit.Parent;
      if Assigned(Host) then
      begin
        Host.Enabled := True;
        Host.Show;
      end;
      FConsumerAIInputEdit.Enabled := True;
      FConsumerAIInputEdit.ReadOnly := False;
      FConsumerAIInputEdit.TabStop := True;
      ConsumerAIInputChange(nil);
      if Assigned(FConsumerAIPanel) and FConsumerAIPanel.Visible then
      begin
        FConsumerAIInputEdit.Show;
        FConsumerAIInputEdit.SetFocus;
      end;
    end;
    UpdateConsumerAIInputPanelHeight;
    if Assigned(FConsumerAIPanel) then
      FConsumerAIPanel.Repaint;
    LogConsumerAIDebug('UI | Input enabled (awaiting user)');
  end;

  procedure ApplyPromptUI(const APrompt: string; const AAppendPrompt: Boolean);
  var
    WorkPrompt: string;
  begin
    WorkPrompt := Trim(APrompt);
    if WorkPrompt = '' then
      WorkPrompt := Trim(FConsumerAILastPrompt);

    if WorkPrompt <> '' then
      FConsumerAILastPrompt := WorkPrompt;

    EnableConsumerAIInput;
    if AAppendPrompt and (WorkPrompt <> '') then
      AppendConsumerAITranscriptEx('PROMPT', WorkPrompt);
  end;

begin
  LogConsumerAIDebug('RECV | ' + ALine);

  LocalizedLine := Trim(ALine);
  if (Length(LocalizedLine) > 0) and (Word(LocalizedLine[1]) = $FEFF) then
    Delete(LocalizedLine, 1, 1);
  LocalizedLine := Trim(LocalizedLine);
  if PosBMH('Starting Consumer AI FastFile', LocalizedLine) = 1 then
    LocalizedLine := Tr('consumer_ai.initializing', 'Initializing FastFile AI...')
  else if PosBMH('Initializing FastFile AI', LocalizedLine) = 1 then
    LocalizedLine := Tr('consumer_ai.initializing', 'Initializing FastFile AI...')
  else if PosBMH('Consumer AI FastFile', LocalizedLine) = 1 then
  begin
    VersionPos := PosBMH(' - Version ', LocalizedLine);
    if VersionPos > 0 then
      LocalizedLine := Tr('consumer_ai.program_version_prefix', 'FastFile AI - Version ') +
        Copy(LocalizedLine, VersionPos + Length(' - Version '), MaxInt);
  end;

  PrefixPos := Pos(BRIDGE_PREFIX, LocalizedLine);
  if PrefixPos <= 0 then
    PrefixPos := PosBMH(BRIDGE_PREFIX, LocalizedLine);
  if PrefixPos > 0 then
  begin
    if PrefixPos > 1 then
      AppendConsumerAITranscriptEx('PY', Trim(Copy(LocalizedLine, 1, PrefixPos - 1)));

    Rest := Copy(LocalizedLine, PrefixPos + Length(BRIDGE_PREFIX), MaxInt);
    SepPos := Pos('|', Rest);
    if SepPos > 0 then
    begin
      Kind := UpperCase(Copy(Rest, 1, SepPos - 1));
      Payload := Copy(Rest, SepPos + 1, MaxInt);
    end
    else
    begin
      Kind := 'OUTPUT';
      Payload := Rest;
    end;

    if Kind = 'OUTPUT' then
    begin
      { Nao inferir botoes a partir de OUTPUT: o Rich envia muitas linhas (tabelas/pain�is)
        com parenteses e numeros; isso disparava RebuildConsumerAIOptionButtons com listas
        erraticas ou competia com FFBRIDGE|OPTIONS| enviado logo apos por bridge_input. }
      if not ShouldSuppressConsumerAIOutput(Payload) then
      begin
        AppendConsumerAITranscriptEx('PY', Payload);
        AppendAssistantConsumerAIResultChunk(Payload);
      end;
      MaybeNotifyChatExportFromText(FConsumerAIPanel, Payload);
      Exit;
    end;

    if Kind = 'OPTIONS' then
    begin
      { Python bridge_input emite OPTIONS antes do PROMPT (lista dinamica, ex.: y,n,idk,q). }
      EnableConsumerAIInput;
      RebuildConsumerAIOptionButtons(Payload);
      LogConsumerAIDebug('KIND | OPTIONS handled');
      Exit;
    end;

    if Kind = 'PROMPT' then
    begin
      if Trim(Payload) = '' then
        Payload := FConsumerAILastPrompt;
      InferredOptions := ExtractConsumerAIOptionsFromPrompt(Payload);
      { After an answer, the next PROMPT means we can write the requested PDF. }
      TryFinalizeAssistantConsumerAIResultsPdf;
      ApplyPromptUI(Payload, True);
      LogConsumerAIDebug('KIND | PROMPT handled');
      { Se nao veio linha OPTIONS (ou veio vazia), inferir botoes a partir do texto do prompt. }
      if (not Assigned(FConsumerAIOptionsPanel)) or (not FConsumerAIOptionsPanel.Visible) or
         (FConsumerAIOptionsPanel.ControlCount = 0) then
      begin
        if InferredOptions <> '' then
          RebuildConsumerAIOptionButtons(InferredOptions);
      end;
      TryFlushPendingConsumerAIQuestion;
      { Send button enabled by OnChange when user types }
      Exit;
    end;

    if Kind = 'STATUS' then
    begin
      if Payload <> '' then
      begin
        if (PosBMH('mode enabled', LowerCase(Payload)) > 0) then
          Payload := Tr('consumer_ai.connected', 'FastFile AI connected');
        SetConsumerAIStatus(Payload);
      end;
      LogConsumerAIDebug('KIND | STATUS ' + Payload);
      Exit;
    end;

    if Kind = 'ERROR' then
    begin
      AppendConsumerAITranscriptEx('ERROR', Payload);
      AppendAssistantConsumerAIResultChunk('Error: ' + Payload);
      FAssistantPendingResultsPdf := False;
      FAssistantCollectingConsumerAIResult := False;
      FAssistantConsumerAIResultBuf := '';
      FAssistantPendingResultsPdfQuestion := '';
      SetConsumerAIStatus(TrText('Error'));
      Exit;
    end;

    Exit;
  end;

  InferredOptions := ExtractConsumerAIOptionsFromPrompt(LocalizedLine);
  if InferredOptions <> '' then
  begin
  { Fallback when FFBRIDGE prefix was not parsed: strip PROMPT payload if present. }
    if Pos(BRIDGE_PREFIX + 'PROMPT|', LocalizedLine) = 1 then
      ApplyPromptUI(Copy(LocalizedLine, Length(BRIDGE_PREFIX + 'PROMPT|') + 1, MaxInt), True)
    else if Pos(BRIDGE_PREFIX + 'OPTIONS|', LocalizedLine) = 1 then
    begin
      RebuildConsumerAIOptionButtons(Copy(LocalizedLine, Length(BRIDGE_PREFIX + 'OPTIONS|') + 1, MaxInt));
      EnableConsumerAIInput;
    end
    else
      ApplyPromptUI(LocalizedLine, False);
    if (not Assigned(FConsumerAIOptionsPanel)) or (not FConsumerAIOptionsPanel.Visible) or
       (FConsumerAIOptionsPanel.ControlCount = 0) then
      RebuildConsumerAIOptionButtons(InferredOptions);
    TryFlushPendingConsumerAIQuestion;
  end;

  if (Pos('PYI-', UpperCase(LocalizedLine)) > 0) and
     (Pos('PYINSTALLER', UpperCase(LocalizedLine)) > 0) then
  begin
    AppendConsumerAITranscriptEx('ERROR',
      TrText('AI Chat Python plugin (ConsumerAI.exe) failed to start (corrupt PyInstaller build). Delete ConsumerAI.exe beside FastFile, rebuild with data-lake-duckdb-main\build_exe_lancedb.bat, upload to FTP, or place a valid dist\ConsumerAI.exe in Build.'));
    SetConsumerAIStatus(TrText('Error'));
    Exit;
  end;

  if (LocalizedLine <> '') and (not ShouldSuppressConsumerAIOutput(LocalizedLine)) and
     (not ContainsBMH(BRIDGE_PREFIX, LocalizedLine)) then
  begin
    AppendConsumerAITranscriptEx('PY', LocalizedLine);
    AppendAssistantConsumerAIResultChunk(LocalizedLine);
    MaybeNotifyChatExportFromText(FConsumerAIPanel, LocalizedLine);
  end;
end;

function IsConsumerPythonHeaderPrompt(const APrompt: string): Boolean;
var
  L: string;
begin
  L := LowerCase(Trim(APrompt));
  Result := (L <> '') and
    ((PosBMH('has header', L) > 0) or (PosBMH('tem cabecalho', L) > 0));
end;

function IsConsumerPythonQuestionPrompt(const APrompt: string): Boolean;
var
  L: string;
begin
  Result := False;
  L := LowerCase(Trim(APrompt));
  if L = '' then Exit;
  if IsConsumerPythonHeaderPrompt(APrompt) then Exit;
  Result := (PosBMH('question', L) > 0) or (PosBMH('pergunta', L) > 0);
end;

procedure TfrmMain.TryFlushPendingConsumerAIQuestion;
var
  Q: string;
  Sent: string;
begin
  Q := Trim(FAssistantPendingConsumerAIQuestion);
  if Q = '' then Exit;
  if not FConsumerAIProcessRunning then Exit;
  if IsConsumerPythonHeaderPrompt(FConsumerAILastPrompt) then
    Sent := 'idk'
  else if IsConsumerPythonQuestionPrompt(FConsumerAILastPrompt) then
    Sent := SanitizeQuestionForConsumerPython(Q, False)
  else
    Exit;
  if not ConsumerAIWriteLine(Sent) then Exit;
  if Sent <> 'idk' then
  begin
    FAssistantPendingConsumerAIQuestion := '';
    FAssistantCollectingConsumerAIResult := True;
    if FAssistantConsumerAIResultBuf = '' then
      FAssistantConsumerAIResultBuf := '';
    if FAssistantPendingResultsPdf then
      FAssistantConsumerAIResultBuf := '';
  end;
  AppendConsumerAITranscriptEx('YOU', Sent);
  ClearConsumerAIOptionButtons;
  UpdateConsumerAIInputPanelHeight;
  if Assigned(FConsumerAIInputEdit) then
  begin
    FConsumerAIInputEdit.Text := '';
    FConsumerAIInputEdit.Enabled := False;
  end;
  if Assigned(FConsumerAISendButton) then
    FConsumerAISendButton.Enabled := False;
  SetConsumerAIStatus(TrText('Waiting for Python...'));
end;

procedure TfrmMain.AppendAssistantConsumerAIResultChunk(const AText: string);
var
  Chunk: string;
begin
  if not FAssistantCollectingConsumerAIResult then Exit;
  if ShouldSuppressConsumerAIOutput(AText) then Exit;
  Chunk := Trim(AText);
  if Chunk = '' then Exit;
  if FAssistantConsumerAIResultBuf = '' then
    FAssistantConsumerAIResultBuf := Chunk
  else
    FAssistantConsumerAIResultBuf := FAssistantConsumerAIResultBuf + #13#10 + Chunk;
  if Length(FAssistantConsumerAIResultBuf) > 120000 then
    SetLength(FAssistantConsumerAIResultBuf, 120000);
end;

procedure TfrmMain.TryFinalizeAssistantConsumerAIResultsPdf;
var
  Body, Q, LowBody: string;
begin
  if not FAssistantPendingResultsPdf then Exit;
  if not FAssistantCollectingConsumerAIResult then Exit;
  Body := Trim(FAssistantConsumerAIResultBuf);
  if Length(Body) < 20 then Exit;
  LowBody := LowerCase(Body);
  { Do not turn Lambda/translation failures into a fake success PDF. }
  if (PosBMH('error 500', LowBody) > 0) or
     (PosBMH('internal server error', LowBody) > 0) or
     (PosBMH('ai translation failed', LowBody) > 0) or
     (PosBMH('aws connection failed', LowBody) > 0) then
  begin
    FAssistantPendingResultsPdf := False;
    FAssistantCollectingConsumerAIResult := False;
    FAssistantConsumerAIResultBuf := '';
    FAssistantPendingResultsPdfQuestion := '';
    SetConsumerAIStatus(TrText('Error'));
    Exit;
  end;
  Q := Trim(FAssistantPendingResultsPdfQuestion);
  FAssistantPendingResultsPdf := False;
  FAssistantCollectingConsumerAIResult := False;
  FAssistantConsumerAIResultBuf := '';
  FAssistantPendingResultsPdfQuestion := '';
  AssistantComposeSavedDocumentFromText(Q, Body);
  SetConsumerAIStatus(TrText('Assistant.Status.ComposePipelineDone'));
end;

procedure TfrmMain.TryFlushPendingConsumerRAGQuestion;
var
  Q: string;
  Sent: string;
begin
  Q := Trim(FAssistantPendingConsumerRAGQuestion);
  if Q = '' then Exit;
  if not FConsumerRAGProcessRunning then Exit;
  if IsConsumerPythonHeaderPrompt(FConsumerRAGLastPrompt) then
    Sent := 'idk'
  else if IsConsumerPythonQuestionPrompt(FConsumerRAGLastPrompt) then
    Sent := SanitizeQuestionForConsumerPython(Q, True)
  else
    Exit;
  if not ConsumerRAGWriteLine(Sent) then Exit;
  if Sent <> 'idk' then
  begin
    FAssistantPendingConsumerRAGQuestion := '';
    FAssistantCollectingConsumerRAGResult := True;
    FAssistantConsumerRAGResultBuf := '';
  end;
  AppendConsumerRAGTranscriptEx('YOU', Sent);
  ClearConsumerRAGOptionButtons;
  UpdateConsumerRAGInputPanelHeight;
  if Assigned(FConsumerRAGInputEdit) then
  begin
    FConsumerRAGInputEdit.Text := '';
    FConsumerRAGInputEdit.Enabled := False;
  end;
  if Assigned(FConsumerRAGSendButton) then
    FConsumerRAGSendButton.Enabled := False;
  SetConsumerRAGStatus(TrText('Waiting for Python...'));
end;

function TfrmMain.ResolveConsumerAIScriptPath: string;
begin
  if not EnsureExecutableAvailable(CONSUMERAI, Result) then
    Result := '';
end;

function TfrmMain.ResolveConsumerAILogPath: string;
begin
  Result := FastFileTempPath(CONSUMERAI_SESSION_DEBUG_LOG);
end;

procedure TfrmMain.LogConsumerAIDebug(const AText: string);
var
  LogPath: string;
  FS: TFileStream;
  Data: UTF8String;
begin
  LogPath := ExpandFileName(ExtractFilePath(Application.ExeName) + CONSUMERAI_SESSION_DEBUG_LOG);
  try
    if FileExists(LogPath) then
      FS := TFileStream.Create(LogPath, fmOpenReadWrite or fmShareDenyNone)
    else
      FS := TFileStream.Create(LogPath, fmCreate);
    try
      FS.Seek(0, soFromEnd);
      Data := UTF8Encode(FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', Now) + ' | ' + AText + #13#10);
      if Length(Data) > 0 then
        FS.WriteBuffer(Pointer(Data)^, Length(Data));
    finally
      FS.Free;
    end;
  except
  end;
end;

procedure TfrmMain.LogExecutableDownload(const AText: string);
var
  LogPath: string;
  FS: TFileStream;
  Data: UTF8String;
begin
  LogPath := ExpandFileName(ExtractFilePath(Application.ExeName) + FASTFILE_DOWNLOAD_LOG);
  try
    if FileExists(LogPath) then
      FS := TFileStream.Create(LogPath, fmOpenReadWrite or fmShareDenyNone)
    else
      FS := TFileStream.Create(LogPath, fmCreate);
    try
      FS.Seek(0, soFromEnd);
      Data := UTF8Encode(FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', Now) + ' | ' + AText + #13#10);
      if Length(Data) > 0 then
        FS.WriteBuffer(Pointer(Data)^, Length(Data));
    finally
      FS.Free;
    end;
  except
    { Logging must never break the primary flow }
  end;
end;

function TfrmMain.ConsumerAIWriteLine(const AText: string): Boolean;
var
  Data: UTF8String;
  BytesWritten: DWORD;
begin
  Result := False;
  if (not FConsumerAIProcessRunning) or (FConsumerAIStdInWrite = 0) or
     (FConsumerAIStdInWrite = INVALID_HANDLE_VALUE) then Exit;

  Data := UTF8Encode(AText + #10);
  Result := Windows.WriteFile(FConsumerAIStdInWrite, Pointer(Data)^,
    Length(Data), BytesWritten, nil) and (BytesWritten = DWORD(Length(Data)));
  if Result then
    LogConsumerAIDebug('SEND | ' + AText)
  else
    LogConsumerAIDebug('SEND_ERROR | Failed to write to stdin pipe');
end;

procedure TfrmMain.StartConsumerAIProcess;
var
  Security: TSecurityAttributes;
  StdOutWrite: THandle;
  StdInRead: THandle;
  StartupInfo: TStartupInfo;
  ScriptPath: string;
  WorkingDir: string;
  FileName: string;
  CommandLine: string;
  Created: Boolean;
  LastErr: DWORD;
begin
  EnsureConsumerAIPanel;

  FileName := ResolveConsumerSourceFilePath;
  if FileName = '' then
  begin
    SetConsumerAIStatus(TrText('No valid source file'));
    ShowAppMessage(TrText('Select a valid input file before starting AI Chat (SQL).'));
    Exit;
  end;

  if FConsumerAIProcessRunning then
    StopConsumerAIProcess;

  ScriptPath := ResolveConsumerAIScriptPath;
  if ScriptPath = '' then
  begin
    SetConsumerAIStatus(TrText('Executable not found'));
    AppendConsumerAITranscriptEx('ERROR', TrText('FastFile AI engine not found.'));
    Exit;
  end;

  if Assigned(FConsumerAIMemo) then
    FConsumerAIMemo.Clear;

  AppendConsumerAITranscriptEx('STATUS', Tr('consumer_ai.starting_session', 'loading IA support ...'));
  SetConsumerAIStatus(TrText('Starting...'));
  if Assigned(FConsumerAIInputEdit) then
    FConsumerAIInputEdit.Enabled := False;
  if Assigned(FConsumerAISendButton) then
    FConsumerAISendButton.Enabled := False;
  if Assigned(FConsumerAIInputPanel) then FConsumerAIInputPanel.Height := 64;

  FillChar(Security, SizeOf(Security), 0);
  Security.nLength := SizeOf(Security);
  Security.bInheritHandle := True;

  StdOutWrite := 0;
  StdInRead := 0;
  FConsumerAIStdOutRead := 0;
  FConsumerAIStdInWrite := 0;
  FillChar(FConsumerAIProcessInfo, SizeOf(FConsumerAIProcessInfo), 0);

  if not CreatePipe(FConsumerAIStdOutRead, StdOutWrite, @Security, 0) then
  begin
    SetConsumerAIStatus(TrText('Pipe error'));
    AppendConsumerAITranscriptEx('ERROR', TrText('Could not create stdout pipe.'));
    Exit;
  end;
  SetHandleInformation(FConsumerAIStdOutRead, HANDLE_FLAG_INHERIT, 0);

  if not CreatePipe(StdInRead, FConsumerAIStdInWrite, @Security, 0) then
  begin
    CloseHandle(FConsumerAIStdOutRead);
    FConsumerAIStdOutRead := 0;
    SetConsumerAIStatus(TrText('Pipe error'));
    AppendConsumerAITranscriptEx('ERROR', TrText('Could not create stdin pipe.'));
    Exit;
  end;
  SetHandleInformation(FConsumerAIStdInWrite, HANDLE_FLAG_INHERIT, 0);

  FillChar(StartupInfo, SizeOf(StartupInfo), 0);
  StartupInfo.cb := SizeOf(StartupInfo);
  StartupInfo.dwFlags := STARTF_USESHOWWINDOW or STARTF_USESTDHANDLES;
  StartupInfo.wShowWindow := SW_HIDE;
  StartupInfo.hStdInput := StdInRead;
  StartupInfo.hStdOutput := StdOutWrite;
  StartupInfo.hStdError := StdOutWrite;

  WorkingDir := ExtractFilePath(ScriptPath);
  CommandLine := '"' + ScriptPath + '" -file "' + FileName + '" -rp -prompt --bridge';
  LogConsumerAIDebug('START | File=' + FileName);
  LogConsumerAIDebug('EXE | ' + ScriptPath);
  LogConsumerAIDebug('CMD_TRY | ' + CommandLine);

  { Garante modo bridge no Python mesmo se --bridge nao chegar em sys.argv (alguns launchers).
    ConsumerAI_LanceDB usa FF_FASTFILE_BRIDGE para ativar FFBRIDGE|OPTIONS|PROMPT e botoes no painel. }
  SetEnvironmentVariable('FF_FASTFILE_BRIDGE', '1');
  SetEnvironmentVariable('PYTHONUNBUFFERED', '1');
  try
    Created := CreateProcess(nil, PChar(CommandLine), nil, nil, True,
      CREATE_NO_WINDOW, nil, PChar(WorkingDir), StartupInfo, FConsumerAIProcessInfo);
  finally
    SetEnvironmentVariable('FF_FASTFILE_BRIDGE', nil);
    SetEnvironmentVariable('PYTHONUNBUFFERED', nil);
  end;

  if not Created then
  begin
    LastErr := GetLastError;
    LogConsumerAIDebug('CREATEPROCESS_FAIL | exe | LastError=' + IntToStr(LastErr) + ' | ' + SysErrorMessage(LastErr));
    // Legacy script mode (disabled):
    // CommandLine := 'py -3 -X utf8 "' + ScriptPath + '" -file "' + FileName + '" -rp -prompt --bridge';
  end;

  CloseHandle(StdOutWrite);
  CloseHandle(StdInRead);

  if not Created then
  begin
    if FConsumerAIStdOutRead <> 0 then
    begin
      CloseHandle(FConsumerAIStdOutRead);
      FConsumerAIStdOutRead := 0;
    end;
    if FConsumerAIStdInWrite <> 0 then
    begin
      CloseHandle(FConsumerAIStdInWrite);
      FConsumerAIStdInWrite := 0;
    end;
    SetConsumerAIStatus(TrText('Launch error'));
    AppendConsumerAITranscriptEx('ERROR', TrText('Could not start AI Chat Python plugin (ConsumerAI.exe).'));
    LastErr := GetLastError;
    LogConsumerAIDebug('CREATEPROCESS_FAIL | LastError=' + IntToStr(LastErr) + ' | ' + SysErrorMessage(LastErr));
    Exit;
  end;

  FConsumerAIProcessRunning := True;
  FConsumerAIActiveFileName := FileName;
  FConsumerAILastPrompt := '';
  FConsumerAIReaderThread := TConsumerAIReaderThread.Create(Self, FConsumerAIStdOutRead);
  LogConsumerAIDebug('PROCESS_STARTED | PID=' + IntToStr(FConsumerAIProcessInfo.dwProcessId));
  SetConsumerAIStatus(Tr('consumer_ai.waiting_python', 'Waiting for Python...'));
end;

procedure TfrmMain.StopConsumerAIProcess;
begin
  if not FConsumerAIProcessRunning and (not Assigned(FConsumerAIReaderThread)) then
    Exit;

  LogConsumerAIDebug('STOP | Requested');

  if FConsumerAIProcessRunning then
    ConsumerAIWriteLine('exit');

  if FConsumerAIProcessInfo.hProcess <> 0 then
  begin
    if WaitForSingleObject(FConsumerAIProcessInfo.hProcess, 1500) = WAIT_TIMEOUT then
      TerminateProcess(FConsumerAIProcessInfo.hProcess, 0);
  end;

  if FConsumerAIStdInWrite <> 0 then
  begin
    CloseHandle(FConsumerAIStdInWrite);
    FConsumerAIStdInWrite := 0;
  end;

  if FConsumerAIStdOutRead <> 0 then
  begin
    CloseHandle(FConsumerAIStdOutRead);
    FConsumerAIStdOutRead := 0;
  end;

  if Assigned(FConsumerAIReaderThread) then
  begin
    FConsumerAIReaderThread.Terminate;
    FConsumerAIReaderThread.WaitFor;
    FreeAndNil(FConsumerAIReaderThread);
  end;

  if FConsumerAIProcessInfo.hThread <> 0 then
  begin
    CloseHandle(FConsumerAIProcessInfo.hThread);
    FConsumerAIProcessInfo.hThread := 0;
  end;
  if FConsumerAIProcessInfo.hProcess <> 0 then
  begin
    CloseHandle(FConsumerAIProcessInfo.hProcess);
    FConsumerAIProcessInfo.hProcess := 0;
  end;

  FConsumerAIProcessRunning := False;
  FConsumerAIActiveFileName := '';
  FConsumerAILastPrompt := '';
  if AppUiUpdatesAllowed then
  begin
    ClearConsumerAIOptionButtons;
    if Assigned(FConsumerAIInputEdit) then
      FConsumerAIInputEdit.Enabled := False;
    if Assigned(FConsumerAISendButton) then
      FConsumerAISendButton.Enabled := False;
    UpdateConsumerAIInputPanelHeight;
    SetConsumerAIStatus(TrText('Disconnected'));
  end;
  LogConsumerAIDebug('STOP | Completed');
end;


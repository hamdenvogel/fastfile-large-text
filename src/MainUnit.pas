procedure TfrmMain.dbgFilesDblClick(Sender: TObject);
var
  RelName, FullPath, SrcDir, Msg: string;
begin
  if not Assigned(clFiles) or (not clFiles.Active) or clFiles.IsEmpty then Exit;
  RelName := Trim(clFiles.FieldByName('Filename').AsString);
  if RelName = '' then Exit;
  if ExtractFileDrive(RelName) = '' then
  begin
    SrcDir := ExtractFilePath(CurrentEffectiveFilePath);
    if SrcDir = '' then
      SrcDir := ExtractFilePath(edtFileName.Text);
    FullPath := IncludeTrailingPathDelimiter(SrcDir) + RelName;
  end
  else
    FullPath := RelName;

  if not FileExists(FullPath) then
  begin
    ShowAppMessage(TrText('File not found.') + #13#10 + FullPath);
    Exit;
  end;

  Msg := TrText('Open this file?') + #13#10#13#10 + FullPath;
  if FastFileMessageBox(PChar(Msg), PChar(TrText('Confirmation')),
    MB_YESNO or MB_ICONQUESTION) <> IDYES then
    Exit;

  AssistantCbOpenFile(FullPath);
end;


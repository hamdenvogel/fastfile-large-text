procedure TfrmMain.LayoutReadToolbarQuickButtons;
var
  L, I, BtnW, BtnH, BtnGap, BtnTop, ChkGap, Margin: Integer;
  Btn: TsSpeedButton;
  Buttons: array[0..7] of TsSpeedButton;
begin
  if not Assigned(pnlReadToolbarOptions) then Exit;
  LayoutReadToolbarCheckboxes;
  if not Assigned(FReadTbZoomIn) then Exit;

  BtnW := BTN_W;
  BtnH := BTN_H;
  BtnGap := BTN_GAP;
  ChkGap := 2;
  Margin := 6;

  Buttons[0] := FReadTbZoomIn;
  Buttons[1] := FReadTbZoomOut;
  Buttons[2] := FReadTbFind;
  Buttons[3] := FReadTbFindReplace;
  Buttons[4] := FReadTbMarks;
  Buttons[5] := FReadTbWordWrap;
  Buttons[6] := FReadTbCompareMerge;
  Buttons[7] := FReadTbFilter;

  if Assigned(chkWordWrap) and chkWordWrap.Visible then
    BtnTop := chkWordWrap.Top + chkWordWrap.Height + ChkGap
  else
    BtnTop := BTN_TOP;

  if BtnTop + BtnH > pnlReadToolbarOptions.ClientHeight - 2 then
    BtnTop := Max(ChkGap, pnlReadToolbarOptions.ClientHeight - BtnH - 2);

  L := Margin;
  for I := 0 to High(Buttons) do
  begin
    Btn := Buttons[I];
    if Assigned(Btn) then
    begin
      Btn.SetBounds(L, BtnTop, BtnW, BtnH);
      Btn.BringToFront;
      Inc(L, BtnW + BtnGap);
    end;
  end;
  if Assigned(chkWordWrap) then
    chkWordWrap.SendToBack;
end;


procedure TfrmMain.ActionDeleteExecute(Sender: TObject);
var
  ToDelete: TInt64List;
  SavedLineTexts: TStringList;
  FileName: string;
  i: Integer;
  Line1Based: Int64;
  DelArr: TInt64DynArray;
  IdxPath: string;
  SegOk: Boolean;
  SegErr: string;
  SelIdx: Integer;
  SelectedCount: Integer;
  LoadingShown: Boolean;
  UseSmoothProgress: Boolean;
  FileSizeBefore, FileSizeAfter: Int64;
  NewLineCount: Int64;
  UseSegmented: Boolean;
  HeavyMutateStarted: Boolean;

begin
  if ListviewIsEmpty then Exit;
  LoadingShown := False;
  UseSmoothProgress := False;
  HeavyMutateStarted := False;
  SelectedCount := 0;
  if Assigned(ListView1) and ListView1.HandleAllocated then
  begin
    SelIdx := -1;
    repeat
      SelIdx := ListView_GetNextItem(ListView1.Handle, SelIdx, LVNI_SELECTED);
      if SelIdx <> -1 then
        Inc(SelectedCount);
    until SelIdx = -1;
  end;

  if (not isChecked) and (SelectedCount = 0) then
  begin
    showInfoStatus(DELETE_LINES_TIP);
    ActionCheckBoxesListView.Execute;
    Exit;
  end;

  ToDelete := TInt64List.Create;
  try
    if Assigned(FCheckListBox) then
    begin
      for i := 0 to FCheckListBox.Items.Count - 1 do
        if FCheckListBox.Checked[i] then
          ToDelete.Add(Integer(FCheckListBox.Items.Objects[i]));
    end;
    if ToDelete.Count = 0 then
    begin
      if Assigned(FCheckedLines) and (FCheckedLines.Count > 0) then
      begin
        for i := 0 to FCheckedLines.Count - 1 do
          ToDelete.Add(FCheckedLines.Items[i]);
      end;
    end;

    if (ToDelete.Count = 0) and (SelectedCount > 0) and Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      SelIdx := -1;
      repeat
        SelIdx := ListView_GetNextItem(ListView1.Handle, SelIdx, LVNI_SELECTED);
        if SelIdx = -1 then Break;

        if FFilterActive then
          Line1Based := FilteredIndexToReal(SelIdx) + 1
        else
          Line1Based := Offset + (SelIdx + 1) + CsvDataStartLine;

        if Line1Based > 0 then
          ToDelete.Add(Line1Based);
      until False;
    end;

    if ToDelete.Count = 0 then
    begin
      ShowAppMessage('Please select or check one or more lines first.');
      Exit;
    end;

    if not EnsureWritableSession then Exit;
    if TryStartAutoIndexForMutation then Exit;

    ToDelete.SortUp;
    i := 0;
    while i < ToDelete.Count - 1 do
      if ToDelete.Items[i] = ToDelete.Items[i + 1] then
        ToDelete.Delete(i + 1)
      else
        Inc(i);

    { Defensive cleanup for virtual list selections: keep only valid 1-based lines. }
    i := ToDelete.Count - 1;
    while i >= 0 do
    begin
      if (ToDelete.Items[i] < 1) or (ToDelete.Items[i] > totalLines) then
        ToDelete.Delete(i);
      Dec(i);
    end;

    if ToDelete.Count = 0 then
    begin
      ShowAppMessage('Please select or check one or more lines first.');
      Exit;
    end;

    if FastFileMessageBox(
      PChar(Format(TrText('Delete %d selected line(s) from the file?'), [ToDelete.Count])),
      APPLICATION_NAME, MB_ICONQUESTION or MB_YESNO) <> IDYES then
      Exit;

    if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
    begin
      if TryStartAutoIndexForMutation then Exit;
    end;

    if ToDelete.IndexOf(totalLines) > -1 then
    begin
      ShowAppMessage(LASTLINE_NOT_SUPPORTED);
      Exit;
    end;

    FileName := CurrentEffectiveFilePath;
    if (FileName = '') or (not FileExists(FileName)) then Exit;
    FileSizeBefore := GetFileSize(FileName);

    SavedLineTexts := TStringList.Create;
    try
      for i := 0 to ToDelete.Count - 1 do
        SavedLineTexts.Add(GetLineContent(ToDelete.Items[i] - 1));

      if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
        for i := 0 to ToDelete.Count - 1 do
          ToDelete.Items[i] := PhysicalLine1BasedForListLine0(ToDelete.Items[i] - 1);

      UseSmoothProgress := EffectiveUseSegmentedHeavyOps(FileSizeBefore, totalLines,
        ToDelete.Count) or (ToDelete.Count >= 200) or
        (FileSizeBefore > Int64(100) * 1024 * 1024) or (totalLines > 500000);

      if UseSmoothProgress then
      begin
        BeginHeavyFileMutate;
        HeavyMutateStarted := True;
        TfrmSmoothLoading.ShowLoading(TrText('Delete selected lines from the file.'), False);
        LoadingShown := True;
        TfrmSmoothLoading.UpdateProgress(0);
        TfrmSmoothLoading.FlushPaint;
      end;

      IdxPath := FastFileExeDirPath(TEMPFILE);
      SetLength(DelArr, ToDelete.Count);
      for i := 0 to ToDelete.Count - 1 do
        DelArr[i] := ToDelete.Items[i];

      UseSegmented := EffectiveUseSegmentedHeavyOps(FileSizeBefore, totalLines,
        ToDelete.Count) and CanUseSegmentedBatchDelete(IdxPath, 250000);

      if UseSegmented then
      begin
        try CloseFileStreams; except on E: EOSError do raise Exception.Create('[ActionDelete] CloseFileStreams: ' + E.Message); end;
        RunSegmentedDeleteLinesWait(FileName, IdxPath, DelArr, SegOk, SegErr);
        if SegOk and (SegErr = '') then
        begin
          if UseSmoothProgress then
            TfrmSmoothLoading.UpdateProgress(100);
          RecordDeleteUndos(ToDelete, SavedLineTexts);
          if Assigned(FCheckedLines) then
          begin
            for i := ToDelete.Count - 1 downto 0 do
            begin
              SelIdx := FCheckedLines.IndexOf(ToDelete.Items[i]);
              if SelIdx >= 0 then
                FCheckedLines.Delete(SelIdx);
            end;
          end;
          if HeavyMutateStarted then
          begin
            EndHeavyFileMutate;
            HeavyMutateStarted := False;
          end;
          ApplyPostBatchDeleteRefresh(FileName, totalLines - ToDelete.Count, True, True);
          Exit;
        end;
        OpenFileStreams(FileName);
      end;

      { MMF delete (1..N linhas) em worker thread: nao bloquear UI com RunEditWait. }
      try CloseFileStreams; except on E: EOSError do raise Exception.Create('[ActionDelete] CloseFileStreams: ' + E.Message); end;
      SegErr := '';
      NewLineCount := 0;
      try
        if not RunBatchDeleteLinesWait(FileName, DelArr, SegErr, NewLineCount) then
          raise Exception.CreateFmt(TrText('Failed to delete lines: %s'), [SegErr]);
      except on E: EOSError do raise Exception.Create('[ActionDelete] RunBatchDeleteLinesWait: ' + E.Message); end;

      if UseSmoothProgress then
        TfrmSmoothLoading.UpdateProgress(100);

      RecordDeleteUndos(ToDelete, SavedLineTexts);
      if Assigned(FCheckedLines) then
      begin
        for i := ToDelete.Count - 1 downto 0 do
        begin
          SelIdx := FCheckedLines.IndexOf(ToDelete.Items[i]);
          if SelIdx >= 0 then
            FCheckedLines.Delete(SelIdx);
        end;
      end;
      if HeavyMutateStarted then
      begin
        EndHeavyFileMutate;
        HeavyMutateStarted := False;
      end;
      ApplyPostBatchDeleteRefresh(FileName, NewLineCount, True, True);
    finally
      SavedLineTexts.Free;
    end;
  finally
    if LoadingShown then
      TfrmSmoothLoading.HideLoading;
    if HeavyMutateStarted then
      EndHeavyFileMutate;
    ToDelete.Free;
  end;
end;

procedure TfrmMain.DeleteFromStream(DestFilename: string; Start,
  Length: Int64);
var
  Buffer: Pointer;
  BufferSize: Integer;
  BytesToRead: Int64;
  BytesRemaining: Int64;
  SourcePos, DestPos: Int64;
  stream: TFileStream;
begin
  { fmShareDenyNone allows coexistence with any concurrent reader (e.g. Windows
    Search indexer, antivirus, TMMFReader from a background scan thread).
    We still need write access so we use fmOpenReadWrite. }
  stream := TFileStream.Create(DestFilename, fmOpenReadWrite or fmShareDenyNone);
  try
    SourcePos := Start+Length;
    DestPos := Start;
    BytesRemaining := Stream.Size-SourcePos;
    if BytesRemaining < 0 then BytesRemaining := 0;
    if BytesRemaining > 0 then
    begin
      BufferSize := Min(BytesRemaining, $F000);
      GetMem(Buffer, BufferSize);
      try
        while BytesRemaining > 0 do begin
          BytesToRead := Min(BufferSize, BytesRemaining);
          Stream.Position := SourcePos;
          Stream.ReadBuffer(Buffer^, BytesToRead);
          Stream.Position := DestPos;
          Stream.WriteBuffer(Buffer^, BytesToRead);
          inc(SourcePos, BytesToRead);
          inc(DestPos, BytesToRead);
          dec(BytesRemaining, BytesToRead);
        end;
      finally
        FreeMem(Buffer);
      end;
    end;
    { Truncate: use the Win32 API directly so any failure is reported with
      the real OS error code rather than a generic EOSError(0). }
    Stream.Position := DestPos;
    if not SetEndOfFile(Stream.Handle) then
      raise EStreamError.CreateFmt('SetEndOfFile falhou (pos=%d, err=%d: %s)',
        [DestPos, GetLastError, SysErrorMessage(GetLastError)]);
  finally
    FlushFileBuffers(Stream.Handle);
    FreeAndNil(stream);
  end;
end;


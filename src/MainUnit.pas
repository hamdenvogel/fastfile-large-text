procedure TfrmMain.ShowConsumerRAGPanel;
begin
  { Dedicated RAG chat UI retired — Python still runs; answers go to Assistente IA. }
  EnsureConsumerRAGPanel;
end;

procedure TfrmMain.HideConsumerRAGPanel;
var
  TargetParent: TWinControl;
begin
  FAssistantPendingConsumerRAGQuestion := '';
  FAssistantCollectingConsumerRAGResult := False;
  FAssistantConsumerRAGResultBuf := '';
  if not Assigned(FConsumerRAGPanel) then Exit;

  if Assigned(FConsumerRAGPanel.Parent) then
    TargetParent := FConsumerRAGPanel.Parent
  else if Assigned(pnlCenter) then
    TargetParent := pnlCenter
  else
    TargetParent := pnlMain;

  TargetParent.DisableAlign;
  if Assigned(ListView1) and ListView1.HandleAllocated then
    ListView1.Perform(WM_SETREDRAW, 0, 0);
  if TargetParent.HandleAllocated then
    SendMessage(TargetParent.Handle, WM_SETREDRAW, 0, 0);
  try
    FConsumerRAGPanel.Visible := False;
    if Assigned(splListview) then
      splListview.Visible := False;
  finally
    if TargetParent.HandleAllocated then
      SendMessage(TargetParent.Handle, WM_SETREDRAW, 1, 0);
    if Assigned(ListView1) and ListView1.HandleAllocated then
    begin
      ListView1.Perform(WM_SETREDRAW, 1, 0);
      RedrawWindow(ListView1.Handle, nil, 0,
        RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW);
    end;
    TargetParent.EnableAlign;
    if TargetParent.HandleAllocated then
      RedrawWindow(TargetParent.Handle, nil, 0,
        RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW);
  end;
end;

procedure TfrmMain.ConsumerRAGCloseClick(Sender: TObject);
begin
  { Hide immediately so the UI never stays stuck if process teardown is slow. }
  HideConsumerRAGPanel;
  try
    StopConsumerRAGProcess;
  except
  end;
  try
    PurgeConsumerRAGTempData;
  except
  end;
end;

procedure TfrmMain.ConsumerRAGClearClick(Sender: TObject);
begin
  if Assigned(FConsumerRAGMemo) then
    FConsumerRAGMemo.Clear;
  ClearConsumerRAGOptionButtons;
  AppendConsumerRAGTranscriptEx('STATUS', TrText('Transcript cleared'));
end;

procedure TfrmMain.ConsumerRAGExportClick(Sender: TObject);
var
  SD: TSaveDialog;
  SL: TStringList;
begin
  if (not Assigned(FConsumerRAGMemo)) or (Trim(FConsumerRAGMemo.Text) = '') then
  begin
    AppendConsumerRAGTranscriptEx('STATUS', TrText('Nothing to export'));
    Exit;
  end;
  SD := TSaveDialog.Create(nil);
  try
    SD.Filter := 'Text files (*.txt)|*.txt|All files (*.*)|*.*';
    SD.DefaultExt := 'txt';
    SD.FileName := CONSUMERRAG_TRANSCRIPT_PREFIX + FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
    if SD.Execute then
    begin
      SL := TStringList.Create;
      try
        SL.Text := FConsumerRAGMemo.Text;
        SL.SaveToFile(SD.FileName);
      finally
        SL.Free;
      end;
      NotifyChatFileSaved(FConsumerRAGPanel, SD.FileName);
      AppendConsumerRAGTranscriptEx('STATUS', TrText('Transcript exported to: ') + SD.FileName);
    end;
  finally
    SD.Free;
  end;
end;

procedure TfrmMain.ConsumerRAGRestartClick(Sender: TObject);
begin
  StopConsumerRAGProcess;
  StartConsumerRAGProcess;
end;

procedure TfrmMain.ConsumerRAGCancelClick(Sender: TObject);
begin
  AppendConsumerRAGTranscriptEx('STATUS', TrText('Loading cancelled'));
  try
    StopConsumerRAGProcess;
  except
  end;
  { Abort may leave LanceDB/chunk temps; purge so the next load starts clean. }
  try
    PurgeConsumerRAGTempData;
  except
  end;
  AppendConsumerRAGTranscriptEx('STATUS', TrText('Temporary RAG index cleared'));
  SetConsumerRAGStatus(TrText('Cancelled'));
  if Assigned(FConsumerRAGCancelButton) then
    FConsumerRAGCancelButton.Enabled := False;
end;

procedure TfrmMain.UpdateConsumerRAGInputPanelHeight;
begin
  if not Assigned(FConsumerRAGInputPanel) then Exit;
  if Assigned(FConsumerRAGOptionsPanel) and FConsumerRAGOptionsPanel.Visible and
     (FConsumerRAGOptionsPanel.ControlCount > 0) then
    FConsumerRAGInputPanel.Height := BASE_H + OPTIONS_EXTRA
  else
    FConsumerRAGInputPanel.Height := BASE_H;
end;

procedure TfrmMain.ClearConsumerRAGOptionButtons;
var
  I: Integer;
begin
  if not Assigned(FConsumerRAGOptionsPanel) then Exit;
  for I := FConsumerRAGOptionsPanel.ControlCount - 1 downto 0 do
    FConsumerRAGOptionsPanel.Controls[I].Free;
  FConsumerRAGOptionsPanel.Height := 0;
  FConsumerRAGOptionsPanel.Visible := False;
  UpdateConsumerRAGInputPanelHeight;
end;

procedure TfrmMain.RebuildConsumerRAGOptionButtons(const ACsv: string);
var
  S, Part: string;
  P: Integer;
  X, BtnW: Integer;
  Btn: TsSpeedButton;
  Bmp: TBitmap;
  Tok: string;
begin
  EnsureConsumerRAGPanel;
  ClearConsumerRAGOptionButtons;
  S := Trim(ACsv);
  if S = '' then Exit;

  Bmp := TBitmap.Create;
  try
    Bmp.SetSize(1, 1);
    begin
      if Assigned(FConsumerRAGInputEdit) then
        Bmp.Canvas.Font.Assign(FConsumerRAGInputEdit.Font)
      else if Assigned(FConsumerRAGPanel) then
        Bmp.Canvas.Font.Assign(FConsumerRAGPanel.Font);
      X := 4;
      FConsumerRAGOptionsPanel.Visible := True;
      FConsumerRAGOptionsPanel.Height := 30;
      while S <> '' do
      begin
        P := PosBMH(',', S);
        if P > 0 then
        begin
          Part := Trim(Copy(S, 1, P - 1));
          Delete(S, 1, P);
        end
        else
        begin
          Part := Trim(S);
          S := '';
        end;
        Tok := Part;
        if Tok = '' then Continue;
        Btn := TsSpeedButton.Create(Self);
        Btn.Parent := FConsumerRAGOptionsPanel;
        Btn.Flat := True;
        Btn.Caption := Tok;
        Btn.Hint := Tok;
        Btn.ShowHint := False;
        Btn.Height := 22;
        BtnW := Bmp.Canvas.TextWidth(Tok) + 16;
        if BtnW < 32 then BtnW := 32;
        if BtnW > 100 then BtnW := 100;
        Btn.Width := BtnW;
        Btn.Left := X;
        Btn.Top := 4;
        Btn.OnClick := ConsumerRAGOptionButtonClick;
        Inc(X, Btn.Width + 4);
      end;
    end;
  finally
    Bmp.Free;
  end;
  if FConsumerRAGOptionsPanel.ControlCount = 0 then
    ClearConsumerRAGOptionButtons
  else
    UpdateConsumerRAGInputPanelHeight;
end;

procedure TfrmMain.ConsumerRAGOptionButtonClick(Sender: TObject);
var
  S: string;
begin
  if not (Sender is TsSpeedButton) then Exit;
  S := Trim(TsSpeedButton(Sender).Hint);
  if S = '' then
    S := Trim(TsSpeedButton(Sender).Caption);
  if not ConsumerRAGWriteLine(S) then Exit;
  AppendConsumerRAGTranscriptEx('YOU', S);
  ClearConsumerRAGOptionButtons;
  if Assigned(FConsumerRAGInputEdit) then
  begin
    FConsumerRAGInputEdit.Text := '';
    FConsumerRAGInputEdit.Enabled := False;
  end;
  if Assigned(FConsumerRAGSendButton) then
    FConsumerRAGSendButton.Enabled := False;
  SetConsumerRAGStatus(TrText('Waiting for Python...'));
end;

procedure TfrmMain.ConsumerRAGSendClick(Sender: TObject);
var
  TextToSend: string;
begin
  if not Assigned(FConsumerRAGInputEdit) then Exit;
  TextToSend := SanitizeQuestionForConsumerPython(FConsumerRAGInputEdit.Text, True);
  if ConsumerRAGWriteLine(TextToSend) then
  begin
    if TextToSend = '' then
      AppendConsumerRAGTranscriptEx('YOU', '[ENTER]')
    else
      AppendConsumerRAGTranscriptEx('YOU', TextToSend);
    ClearConsumerRAGOptionButtons;
    UpdateConsumerRAGInputPanelHeight;
    FConsumerRAGInputEdit.Text := '';
    FConsumerRAGInputEdit.Enabled := False;
    if Assigned(FConsumerRAGSendButton) then
      FConsumerRAGSendButton.Enabled := False;
    SetConsumerRAGStatus(TrText('Waiting for Python...'));
  end;
end;


procedure TfrmMain.RefreshDetectedFileFormat;
var
  P: string;
  KeepForced: string;
begin
  P := CurrentEffectiveFilePath;
  KeepForced := FForcedViewEncoding;
  if (P = '') or (not FileExists(P)) then
  begin
    FDetectedEncoding := 'ANSI';
    FDetectedEol := lekUnknown;
    FForcedViewEncoding := '';
  end
  else
  begin
    FDetectedEncoding := DetectFileEncoding(P);
    FDetectedEol := DetectLineEndingFromFile(P);
    { Preserve encode-in character-set override across detect refresh. }
    FForcedViewEncoding := KeepForced;
  end;
  UpdateEolStatusPanel;
  UpdateInfoPanels;
end;

procedure TfrmMain.UpdateEolStatusPanel;
begin
  if not Assigned(sStatusBar1) or (sStatusBar1.Panels.Count <= 5) then Exit;
  if (CurrentEffectiveFilePath <> '') and FileExists(CurrentEffectiveFilePath) then
    sStatusBar1.Panels[5].Text := EolStatusBarCaption(FDetectedEol)
  else
    sStatusBar1.Panels[5].Text := '';
end;

function TfrmMain.EolStatusBarCaption(AKind: TLineEndingKind): string;
begin
  { Compact label so panel 5 is not clipped to "Window". Full name stays in EOL popup. }
  case AKind of
    lekWindows:
      Result := 'CRLF';
    lekUnix:
      Result := 'LF';
    lekMac:
      Result := 'CR';
    lekMixed:
      Result := TrText('FileFormat.EOL.Mixed');
  else
    Result := TrText('FileFormat.EOL.Unknown');
  end;
end;

procedure TfrmMain.PopulateEncodingMenusInto(AParent: TMenuItem; AForPopup: Boolean);
var
  Mi, SubIn, SubTo, Grp: TMenuItem;
  CurEnc: string;
  IsAnsi, IsU8, IsU8Bom, IsU16LE, IsU16BE, IsU32LE, IsU32BE: Boolean;
  G, I: Integer;
  CapKey, EncId: string;
  CurCP: UINT;
  CurIsCp: Boolean;

  function AddLeaf(AOwner: TMenuItem; const Cap: string; ATag: Integer;
    const AHint: string; ARadio, AChecked: Boolean): TMenuItem;
  begin
    Result := TMenuItem.Create(AOwner);
    Result.Caption := Cap;
    Result.Tag := ATag;
    Result.Hint := AHint;
    Result.RadioItem := ARadio;
    Result.Checked := AChecked;
    Result.OnClick := EncodingFormatMenuClick;
    AOwner.Add(Result);
  end;

  function AddHdr(AOwner: TMenuItem; const Cap: string): TMenuItem;
  begin
    Result := TMenuItem.Create(AOwner);
    Result.Caption := Cap;
    Result.Enabled := False;
    AOwner.Add(Result);
  end;

  function AddSep(AOwner: TMenuItem): TMenuItem;
  begin
    Result := TMenuItem.Create(AOwner);
    Result.Caption := '-';
    AOwner.Add(Result);
  end;

  function EncMatches(const AId: string): Boolean;
  var
    A, B: UINT;
  begin
    Result := SameText(Trim(CurEnc), Trim(AId));
    if Result then Exit;
    if TryGetCodePageFromEncoding(CurEnc, A) and
       TryGetCodePageFromEncoding(AId, B) then
      Result := (A = B) and (A <> CP_ACP);
  end;

begin
  if not Assigned(AParent) then Exit;
  CurEnc := UpperCase(Trim(EffectiveDisplayEncoding));
  if CurEnc = '' then
    CurEnc := UpperCase(Trim(FDetectedEncoding));
  IsU8Bom := (Pos('UTF-8', CurEnc) > 0) and EncodingWantsBom(CurEnc);
  IsU8 := (Pos('UTF-8', CurEnc) > 0) and (not IsU8Bom);
  IsU16BE := IsUtf16BEEncoding(CurEnc);
  IsU16LE := (not IsU16BE) and (IsUtf16LEEncoding(CurEnc) or (Pos('UTF-16', CurEnc) > 0));
  IsU32BE := IsUtf32BEEncoding(CurEnc);
  IsU32LE := (not IsU32BE) and IsUtf32LEEncoding(CurEnc);
  CurIsCp := TryGetCodePageFromEncoding(CurEnc, CurCP) and (not IsUnicodeFileEncoding(CurEnc)) and
    (CurCP <> CP_ACP);
  IsAnsi := (not IsU8) and (not IsU8Bom) and (not IsU16LE) and (not IsU16BE) and
            (not IsU32LE) and (not IsU32BE) and (not CurIsCp);

  if AForPopup then
  begin
    AddHdr(AParent, TrText('FileFormat.Enc.EncodeIn'));
    AddLeaf(AParent, TrText('FileFormat.Enc.InAnsi'), 1, 'ANSI', True, IsAnsi);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf8'), 2, 'UTF-8', True, IsU8);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf8Bom'), 3, 'UTF-8 (BOM)', True, IsU8Bom);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf16LE'), 4, 'UTF-16 LE', True, IsU16LE);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf16BE'), 5, 'UTF-16 BE', True, IsU16BE);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf32LE'), 6, 'UTF-32 LE', True, IsU32LE);
    AddLeaf(AParent, TrText('FileFormat.Enc.InUtf32BE'), 7, 'UTF-32 BE', True, IsU32BE);
    SubIn := TMenuItem.Create(AParent);
    SubIn.Caption := TrText('FileFormat.Enc.CharacterSets');
    AParent.Add(SubIn);
  end
  else
  begin
    SubIn := TMenuItem.Create(AParent);
    SubIn.Caption := TrText('FileFormat.Enc.EncodeIn');
    AParent.Add(SubIn);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InAnsi'), 1, 'ANSI', True, IsAnsi);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf8'), 2, 'UTF-8', True, IsU8);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf8Bom'), 3, 'UTF-8 (BOM)', True, IsU8Bom);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf16LE'), 4, 'UTF-16 LE', True, IsU16LE);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf16BE'), 5, 'UTF-16 BE', True, IsU16BE);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf32LE'), 6, 'UTF-32 LE', True, IsU32LE);
    AddLeaf(SubIn, TrText('FileFormat.Enc.InUtf32BE'), 7, 'UTF-32 BE', True, IsU32BE);
    Mi := TMenuItem.Create(SubIn);
    Mi.Caption := TrText('FileFormat.Enc.CharacterSets');
    SubIn.Add(Mi);
    SubIn := Mi;
  end;

  for G := 0 to FileFormatCharsetGroupCount - 1 do
  begin
    CapKey := FileFormatCharsetGroupCaptionKey(G);
    Grp := TMenuItem.Create(SubIn);
    Grp.Caption := TrText(CapKey);
    SubIn.Add(Grp);
    for I := 0 to FileFormatCharsetCount(G) - 1 do
    begin
      EncId := FileFormatCharsetId(G, I);
      AddLeaf(Grp, FileFormatCharsetCaption(G, I), 50, EncId, True, EncMatches(EncId));
    end;
  end;

  AddSep(AParent);

  if AForPopup then
  begin
    AddHdr(AParent, TrText('FileFormat.Enc.ConvertTo'));
    AddLeaf(AParent, TrText('FileFormat.Enc.ToAnsi'), 101, 'ANSI', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf8'), 102, 'UTF-8 (no BOM)', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf8Bom'), 103, 'UTF-8 (BOM)', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf16LE'), 104, 'UTF-16 LE', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf16BE'), 105, 'UTF-16 BE', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf32LE'), 106, 'UTF-32 LE', False, False);
    AddLeaf(AParent, TrText('FileFormat.Enc.ToUtf32BE'), 107, 'UTF-32 BE', False, False);
    SubTo := TMenuItem.Create(AParent);
    SubTo.Caption := TrText('FileFormat.Enc.ConvertCharacterSets');
    AParent.Add(SubTo);
  end
  else
  begin
    SubTo := TMenuItem.Create(AParent);
    SubTo.Caption := TrText('FileFormat.Enc.ConvertTo');
    AParent.Add(SubTo);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToAnsi'), 101, 'ANSI', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf8'), 102, 'UTF-8 (no BOM)', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf8Bom'), 103, 'UTF-8 (BOM)', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf16LE'), 104, 'UTF-16 LE', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf16BE'), 105, 'UTF-16 BE', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf32LE'), 106, 'UTF-32 LE', False, False);
    AddLeaf(SubTo, TrText('FileFormat.Enc.ToUtf32BE'), 107, 'UTF-32 BE', False, False);
    Mi := TMenuItem.Create(SubTo);
    Mi.Caption := TrText('FileFormat.Enc.ConvertCharacterSets');
    SubTo.Add(Mi);
    SubTo := Mi;
  end;

  for G := 0 to FileFormatCharsetGroupCount - 1 do
  begin
    CapKey := FileFormatCharsetGroupCaptionKey(G);
    Grp := TMenuItem.Create(SubTo);
    Grp.Caption := TrText(CapKey);
    SubTo.Add(Grp);
    for I := 0 to FileFormatCharsetCount(G) - 1 do
    begin
      EncId := FileFormatCharsetId(G, I);
      AddLeaf(Grp, FileFormatCharsetCaption(G, I), 150, EncId, False, False);
    end;
  end;
end;

procedure TfrmMain.EnsureFileFormatPopupMenus;

  procedure ClearMenu(M: TPopupMenu);
  begin
    while M.Items.Count > 0 do
      M.Items[0].Free;
  end;

  function AddEolItem(M: TPopupMenu; const Cap: string; AKind: TLineEndingKind): TMenuItem;
  begin
    Result := TMenuItem.Create(M);
    Result.Caption := Cap;
    Result.Tag := Ord(AKind);
    Result.Enabled := FDetectedEol <> AKind;
    if FDetectedEol = lekMixed then
      Result.Enabled := True;
    if FDetectedEol = lekUnknown then
      Result.Enabled := True;
    Result.OnClick := EolFormatMenuClick;
    M.Items.Add(Result);
  end;

begin
  if not Assigned(FPopupEolFormat) then
    FPopupEolFormat := TPopupMenu.Create(Self);
  if not Assigned(FPopupEncodingFormat) then
    FPopupEncodingFormat := TPopupMenu.Create(Self);

  ClearMenu(FPopupEolFormat);
  AddEolItem(FPopupEolFormat, TrText('FileFormat.EOL.ConvertWindows'), lekWindows);
  AddEolItem(FPopupEolFormat, TrText('FileFormat.EOL.ConvertUnix'), lekUnix);
  AddEolItem(FPopupEolFormat, TrText('FileFormat.EOL.ConvertMac'), lekMac);

  ClearMenu(FPopupEncodingFormat);
  PopulateEncodingMenusInto(FPopupEncodingFormat.Items, True);
end;

procedure TfrmMain.ShowEolFormatPopup(const AScreenPos: TPoint);
begin
  EnsureFileFormatPopupMenus;
  if Assigned(FPopupEolFormat) then
    FPopupEolFormat.Popup(AScreenPos.X, AScreenPos.Y);
end;

procedure TfrmMain.ShowEncodingFormatPopup(const AScreenPos: TPoint);
begin
  EnsureFileFormatPopupMenus;
  if Assigned(FPopupEncodingFormat) then
    FPopupEncodingFormat.Popup(AScreenPos.X, AScreenPos.Y);
end;

procedure TfrmMain.ApplyViewEncodingById(const AEncId: string);
var
  Idx: Integer;
  U: string;
  CP: UINT;
begin
  if not Assigned(comboViewEncoding) then Exit;
  U := UpperCase(Trim(AEncId));
  Idx := 0;
  FForcedViewEncoding := '';
  if IsUtf8Encoding(U) then
  begin
    Idx := 1;
    if EncodingWantsBom(U) then
      FForcedViewEncoding := 'UTF-8 (BOM)';
  end
  else if SameText(AEncId, 'ANSI') or (U = 'ANSI') then
    Idx := 2
  else if IsUtf16BEEncoding(U) then
    Idx := 4
  else if IsUtf16LEEncoding(U) or (Pos('UTF-16', U) > 0) then
    Idx := 3
  else if IsUtf32BEEncoding(U) then
    Idx := 6
  else if IsUtf32LEEncoding(U) then
    Idx := 5
  else if TryGetCodePageFromEncoding(U, CP) then
  begin
    { Character set: keep combo on DEFAULT but force decode via CP. }
    Idx := 0;
    if CP = CP_ACP then
      Idx := 2
    else
      FForcedViewEncoding := NormalizeCodePageEncodingId(CP);
  end;

  FUpdatingViewEncodingCombo := True;
  try
    comboViewEncoding.ItemIndex := Idx;
  finally
    FUpdatingViewEncodingCombo := False;
  end;
  ApplyViewEncodingRefresh;
end;

procedure TfrmMain.EolFormatMenuClick(Sender: TObject);
var
  Kind: TLineEndingKind;
begin
  if not (Sender is TMenuItem) then Exit;
  Kind := TLineEndingKind(TMenuItem(Sender).Tag);
  if Kind in [lekWindows, lekUnix, lekMac] then
    RunFileFormatConversion(0, Kind, '');
end;

procedure TfrmMain.EncodingFormatMenuClick(Sender: TObject);
var
  Tag: Integer;
  Dst: string;
  Mi: TMenuItem;
begin
  if not (Sender is TMenuItem) then Exit;
  Mi := TMenuItem(Sender);
  Tag := Mi.Tag;
  if Tag <= 0 then Exit;
  if Tag = 50 then
  begin
    ApplyViewEncodingById(Mi.Hint);
    Exit;
  end;
  if Tag = 150 then
  begin
    RunFileFormatConversion(1, lekUnknown, Mi.Hint);
    Exit;
  end;
  if Tag < 100 then
  begin
    case Tag of
      1: ApplyViewEncodingById('ANSI');
      2: ApplyViewEncodingById('UTF-8');
      3: ApplyViewEncodingById('UTF-8 (BOM)');
      4: ApplyViewEncodingById('UTF-16 LE');
      5: ApplyViewEncodingById('UTF-16 BE');
      6: ApplyViewEncodingById('UTF-32 LE');
      7: ApplyViewEncodingById('UTF-32 BE');
    end;
    Exit;
  end;
  case Tag of
    101: Dst := 'ANSI';
    102: Dst := 'UTF-8 (no BOM)';
    103: Dst := 'UTF-8 (BOM)';
    104: Dst := 'UTF-16 LE';
    105: Dst := 'UTF-16 BE';
    106: Dst := 'UTF-32 LE';
    107: Dst := 'UTF-32 BE';
  else
    Exit;
  end;
  RunFileFormatConversion(1, lekUnknown, Dst);
end;

function TfrmMain.RunFileFormatConversion(AMode: Integer; AEol: TLineEndingKind;
  const ADstEnc: string): Boolean;
var
  SrcPath, TempPath, Err: string;
  Ok: Boolean;
  SrcEnc: string;
begin
  Result := False;
  SrcPath := CurrentEffectiveFilePath;
  if (SrcPath = '') or (not FileExists(SrcPath)) then
  begin
    FastFileMessageBox(PChar(TrText('FileFormat.Error.NoFile')),
      PChar(APPLICATION_NAME), MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  if not ConfirmDiskSpaceForPaths(TrText('FileFormat.DiskSpaceOp'), SrcPath,
    UnUtils.GetFileSize(SrcPath)) then
    Exit;

  if AMode = 0 then
  begin
    if FastFileMessageBox(
      PChar(Format(TrText('FileFormat.EOL.Confirm'), [LineEndingKindCaption(AEol)])),
      PChar(TrText('FileFormat.EOL.Title')), MB_YESNO or MB_ICONQUESTION) <> IDYES then
      Exit;
  end
  else
  begin
    if FastFileMessageBox(
      PChar(Format(TrText('FileFormat.Enc.Confirm'), [EncodingDisplayCaption(ADstEnc)])),
      PChar(TrText('FileFormat.Enc.Title')), MB_YESNO or MB_ICONQUESTION) <> IDYES then
      Exit;
  end;

  TempPath := FastFileExeDirPath('temp_file_format_convert.bin');
  UnUtils.TryDeleteFileWithRetry(TempPath, 4, 40);
  SrcEnc := EffectiveDisplayEncoding;
  if Trim(SrcEnc) = '' then
    SrcEnc := FDetectedEncoding;

  BeginHeavyFileMutate;
  TfrmSmoothLoading.ShowLoading(TrText('FileFormat.Converting'), False);
  try
    CloseFileStreams;
    if AMode = 0 then
      Ok := ConvertTextFileLineEndings(SrcPath, TempPath, AEol, SrcEnc, Err)
    else
      Ok := ConvertTextFileEncoding(SrcPath, TempPath, SrcEnc, ADstEnc, Err);

    if Ok then
    begin
      if not UnUtils.TryRenameTempOverTarget(TempPath, SrcPath, Err) then
        Ok := False;
    end;

    if not Ok then
    begin
      UnUtils.TryDeleteFileWithRetry(TempPath, 4, 40);
      FastFileMessageBox(PChar(TrText('FileFormat.Error.Failed') + #13#10 + Err),
        PChar(APPLICATION_NAME), MB_OK or MB_ICONERROR);
    end
    else
    begin
      Result := True;
      RefreshDetectedFileFormat;
      if AMode = 1 then
        ApplyViewEncodingById(ADstEnc);
      RequestPostEditRefresh;
      if AMode = 0 then
        UpdateStatusBar(Format(TrText('FileFormat.EOL.Done'),
          [LineEndingKindCaption(FDetectedEol)]), iaRight)
      else
        UpdateStatusBar(Format(TrText('FileFormat.Enc.Done'),
          [EncodingDisplayCaption(EffectiveDisplayEncoding)]), iaRight);
    end;
  finally
    TfrmSmoothLoading.HideLoading;
    EndHeavyFileMutate;
  end;
end;

procedure TfrmMain.LoadFileFormatPrefs;
var
  IniName, EolName, EncName: string;
begin
  IniName := ExtractFilePath(Application.ExeName) + ASKIN_INI;
  FDefaultEolKind := lekWindows;
  FDefaultNewEncoding := 'UTF-8 (no BOM)';
  with TIniFile.Create(IniName) do
  try
    EolName := ReadString('UIPrefs', 'DefaultEOL', 'Windows');
    EncName := ReadString('UIPrefs', 'DefaultNewEncoding', 'UTF-8 (no BOM)');
  finally
    Free;
  end;
  FDefaultEolKind := DefaultEolKindFromName(EolName);
  SetDefaultOutputEolKind(FDefaultEolKind);
  if Trim(EncName) <> '' then
    FDefaultNewEncoding := EncName;
end;

procedure TfrmMain.SaveFileFormatPrefs;
var
  IniName: string;
begin
  IniName := ExtractFilePath(Application.ExeName) + ASKIN_INI;
  with TIniFile.Create(IniName) do
  try
    WriteString('UIPrefs', 'DefaultEOL', DefaultEolKindToName(FDefaultEolKind));
    WriteString('UIPrefs', 'DefaultNewEncoding', FDefaultNewEncoding);
  finally
    Free;
  end;
end;

procedure TfrmMain.DefaultEolPrefClick(Sender: TObject);
var
  Kind: TLineEndingKind;
begin
  if not (Sender is TMenuItem) then Exit;
  Kind := TLineEndingKind(TMenuItem(Sender).Tag);
  if not (Kind in [lekWindows, lekUnix, lekMac]) then Exit;
  FDefaultEolKind := Kind;
  SetDefaultOutputEolKind(Kind);
  if Assigned(FMenuDefaultEolWindows) then
    FMenuDefaultEolWindows.Checked := Kind = lekWindows;
  if Assigned(FMenuDefaultEolUnix) then
    FMenuDefaultEolUnix.Checked := Kind = lekUnix;
  if Assigned(FMenuDefaultEolMac) then
    FMenuDefaultEolMac.Checked := Kind = lekMac;
  SaveFileFormatPrefs;
  UpdateStatusBar(Format(TrText('FileFormat.DefaultEOL.Saved'),
    [LineEndingKindCaption(Kind)]), iaRight);
end;

procedure TfrmMain.DefaultNewEncPrefClick(Sender: TObject);
var
  Enc: string;
begin
  if not (Sender is TMenuItem) then Exit;
  Enc := Trim(TMenuItem(Sender).Hint);
  if Enc = '' then Exit;
  FDefaultNewEncoding := Enc;
  if Assigned(FMenuDefaultEncUtf8) then
    FMenuDefaultEncUtf8.Checked := SameText(Enc, 'UTF-8 (no BOM)') or SameText(Enc, 'UTF-8');
  if Assigned(FMenuDefaultEncUtf8Bom) then
    FMenuDefaultEncUtf8Bom.Checked := SameText(Enc, 'UTF-8 (BOM)');
  if Assigned(FMenuDefaultEncAnsi) then
    FMenuDefaultEncAnsi.Checked := SameText(Enc, 'ANSI');
  SaveFileFormatPrefs;
  UpdateStatusBar(Format(TrText('FileFormat.DefaultEnc.Saved'),
    [EncodingDisplayCaption(Enc)]), iaRight);
end;

function TfrmMain.CreateNewTextFileOnDisk(const APath, AEnc: string;
  out AError: string): Boolean;
{ Creates an empty text file (optional BOM only). Never loads content into RAM. }
var
  F: TFileStream;
  Bom: AnsiString;
  U: string;
begin
  Result := False;
  AError := '';
  Bom := '';
  U := UpperCase(Trim(AEnc));
  if IsUtf8Encoding(U) and EncodingWantsBom(U) then
    Bom := AnsiChar($EF) + AnsiChar($BB) + AnsiChar($BF)
  else if IsUtf16BEEncoding(U) then
    Bom := AnsiChar($FE) + AnsiChar($FF)
  else if IsUtf16LEEncoding(U) or (Pos('UTF-16', U) > 0) then
    Bom := AnsiChar($FF) + AnsiChar($FE)
  else if IsUtf32BEEncoding(U) then
    Bom := AnsiChar(#0) + AnsiChar(#0) + AnsiChar($FE) + AnsiChar($FF)
  else if IsUtf32LEEncoding(U) then
    Bom := AnsiChar($FF) + AnsiChar($FE) + AnsiChar(#0) + AnsiChar(#0);
  try
    F := TFileStream.Create(APath, fmCreate);
    try
      if Bom <> '' then
        F.WriteBuffer(Pointer(Bom)^, Length(Bom));
      Result := True;
    finally
      F.Free;
    end;
  except
    on E: Exception do
      AError := E.Message;
  end;
end;

procedure TfrmMain.miNewFileClick(Sender: TObject);
var
  SD: TSaveDialog;
  Path, Err: string;
begin
  EnsureReadTabVisible;
  SD := TSaveDialog.Create(Self);
  try
    SD.Filter := 'Text files (*.txt)|*.txt|All files (*.*)|*.*';
    SD.DefaultExt := 'txt';
    SD.Options := [ofOverwritePrompt, ofPathMustExist, ofEnableSizing, ofHideReadOnly];
    if not SD.Execute then Exit;
    Path := SD.FileName;
  finally
    SD.Free;
  end;
  if not CreateNewTextFileOnDisk(Path, FDefaultNewEncoding, Err) then
  begin
    FastFileMessageBox(PChar(TrText('FileFormat.Error.Failed') + #13#10 + Err),
      PChar(APPLICATION_NAME), MB_OK or MB_ICONERROR);
    Exit;
  end;
  { Empty file: preferred EOL is stored as preference for future edits; disk stays empty. }
  edtFileName.Text := Path;
  BeginRead;
  ApplyViewEncodingById(FDefaultNewEncoding);
  FDetectedEol := FDefaultEolKind;
  UpdateEolStatusPanel;
  UpdateStatusBar(Format(TrText('FileFormat.NewFile.Created'),
    [ExtractFileName(Path), LineEndingKindCaption(FDefaultEolKind),
     EncodingDisplayCaption(FDefaultNewEncoding)]), iaRight);
end;

function TfrmMain.DetectFileEncoding(const AFileName: String): String;
var
  F: TFileStream;
  BOM: array[0..3] of Byte;
  BytesRead: Integer;
  Sample: AnsiString;
  SampleLen: Integer;
begin
  Result := 'ANSI';
  if not FileExists(AFileName) then Exit;
  try
    F := TFileStream.Create(AFileName, fmOpenRead or fmShareDenyNone);
    try
      BytesRead := F.Read(BOM, 4);
      if BytesRead >= 3 then
        if (BOM[0] = $EF) and (BOM[1] = $BB) and (BOM[2] = $BF) then begin Result := 'UTF-8 (BOM)'; Exit; end;
      if BytesRead >= 2 then begin
        if (BOM[0] = $FF) and (BOM[1] = $FE) then begin
          if (BytesRead >= 4) and (BOM[2] = $00) and (BOM[3] = $00) then Result := 'UTF-32 LE'
          else Result := 'UTF-16 LE';
          Exit;
        end;
        if (BOM[0] = $FE) and (BOM[1] = $FF) then begin Result := 'UTF-16 BE'; Exit; end;
      end;
      if BytesRead >= 4 then
        if (BOM[0] = $00) and (BOM[1] = $00) and (BOM[2] = $FE) and (BOM[3] = $FF) then begin Result := 'UTF-32 BE'; Exit; end;
      { Sem BOM: ANSI (CP1252 etc.) ou UTF-8; evitar assumir UTF-8 para todo ficheiro. }
      F.Position := 0;
      SampleLen := Min(F.Size, 16384);
      SetLength(Sample, SampleLen);
      if SampleLen > 0 then
        F.Read(Sample[1], SampleLen);
      if IsProbablyUtf8(Sample) then
        Result := 'UTF-8 (no BOM)'
      else
        Result := 'ANSI';
    finally
      F.Free;
    end;
  except
    Result := 'Unknown';
  end;
end;


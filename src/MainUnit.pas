procedure TfrmMain.FitSpeedButtonWidth(ABtn: TsSpeedButton; AMinWidth, AExtraPad: Integer);
var
  Cap: string;
  W: Integer;
  C: TControlCanvas;
begin
  if not Assigned(ABtn) then Exit;
  Cap := StringReplace(ABtn.Caption, '&', '', [rfReplaceAll]);
  C := TControlCanvas.Create;
  try
    C.Control := ABtn;
    C.Font.Assign(ABtn.Font);
    W := C.TextWidth(Cap) + AExtraPad;
  finally
    C.Free;
  end;
  if W < AMinWidth then W := AMinWidth;
  { Margem extra para skins/DPI nao cortarem a legenda (ex.: "Exemplos"). }
  Inc(W, 8);
  ABtn.Width := W;
end;


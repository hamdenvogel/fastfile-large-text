function BuildRegexCategoryExamples(const ASourceFile: String; const AModeIdx: Integer): String;
var
  F: TextFile;
  RawLines: TStringList;
  Headers, Parts, SB: TStringList;
  LineText, V, DelimEsc, URLDomain, SampleSpecialty, SampleRegion: String;
  LineCount, i, Col, ki, FirstData, ColCount: Integer;
  Delim, D: Char;
  MaxDelimCount, ThisCount: Integer;
  Candidates: String;
  HasHeader, HasMojibake: Boolean;
  SpecialtyCol, RegionCol: Integer;
  ColAllInt:  array[0..MAX_COLS - 1] of Boolean;
  ColAllNum:  array[0..MAX_COLS - 1] of Boolean;
  ColHasDate: array[0..MAX_COLS - 1] of Boolean;
  ColHasUrl:  array[0..MAX_COLS - 1] of Boolean;
  ColHasEmail:array[0..MAX_COLS - 1] of Boolean;
  ColAllBool: array[0..MAX_COLS - 1] of Boolean;
  ColSample:  array[0..MAX_COLS - 1] of String;

  function IsInt(const S: String): Boolean;
  var k: Integer;
  begin
    Result := S <> '';
    for k := 1 to Length(S) do
      if (S[k] = '-') and (k = 1) then
      else if not (S[k] in ['0'..'9']) then
      begin
        Result := False;
        Exit;
      end;
    if (Length(S) = 1) and (S[1] = '-') then Result := False;
  end;

  function IsNum(const S: String): Boolean;
  var k, Dots: Integer;
  begin
    Result := S <> '';
    Dots := 0;
    for k := 1 to Length(S) do
    begin
      if S[k] = '.' then Inc(Dots)
      else if S[k] = ',' then
      else if (S[k] = '-') and (k = 1) then
      else if not (S[k] in ['0'..'9']) then
      begin
        Result := False;
        Exit;
      end;
    end;
    if Dots > 1 then Result := False;
    if (Length(S) = 1) and (S[1] = '-') then Result := False;
  end;

  function IsDate(const S: String): Boolean;
  begin
    Result :=
      (Length(S) >= 10) and
      (
        ((S[5] = '-') and (S[8] = '-') and (S[1] in ['1', '2'])) or
        ((S[3] in ['/']) and (S[6] in ['/'])) or
        ((S[3] = '-') and (S[6] = '-') and (S[1] in ['0', '1', '2', '3']))
      );
  end;

  function IsUrl(const S: String): Boolean;
  begin
    Result := (PosBMH('http://', S) = 1) or (PosBMH('https://', S) = 1);
  end;

  function IsEmail(const S: String): Boolean;
  var at: Integer;
  begin
    at := PosBMH('@', S);
    Result := (at > 1) and (PosBMH('.', Copy(S, at + 1, MaxInt)) > 0);
  end;

  function IsBool(const S: String): Boolean;
  begin
    Result := (S = '0') or (S = '1') or
              SameText(S, 'true') or SameText(S, 'false') or
              SameText(S, 'yes') or SameText(S, 'no');
  end;

  function SplitByDelim(const S: String; DD: Char): TStringList;
  var si, startPos: Integer; inQ: Boolean;
  begin
    Result := TStringList.Create;
    startPos := 1;
    inQ := False;
    for si := 1 to Length(S) do
    begin
      if S[si] = '"' then inQ := not inQ
      else if (S[si] = DD) and not inQ then
      begin
        Result.Add(Copy(S, startPos, si - startPos));
        startPos := si + 1;
      end;
    end;
    Result.Add(Copy(S, startPos, MaxInt));
  end;

  function FindColByHint(const Hint: String): Integer;
  var fi: Integer; H, LHint: String;
  begin
    Result := -1;
    LHint := AnsiLowerCase(Hint);
    for fi := 0 to ColCount - 1 do
    begin
      if fi >= Headers.Count then Break;
      H := AnsiLowerCase(Trim(Headers[fi]));
      if (H <> '') and (PosBMH(LHint, H) > 0) then
      begin
        Result := fi;
        Exit;
      end;
    end;
  end;

  function RegexEscape(const S: String): String;
  var ri: Integer;
  begin
    Result := '';
    for ri := 1 to Length(S) do
      case S[ri] of
        '\', '.', '^', '$', '*', '+', '?', '(', ')', '[', ']', '{', '}', '|':
          Result := Result + '\\' + S[ri];
      else
        Result := Result + S[ri];
      end;
  end;

begin
  Result := TrText('Choose a source file to generate mode-specific examples.');

  if (ASourceFile = '') or (not FileExists(ASourceFile)) then Exit;

  RawLines := TStringList.Create;
  try
    AssignFile(F, ASourceFile);
    try
      Reset(F);
    except
      Exit;
    end;
    try
      LineCount := 0;
      while (not Eof(F)) and (LineCount < MAX_SCAN) do
      begin
        ReadLn(F, LineText);
        if Trim(LineText) <> '' then
        begin
          if (LineCount = 0) and (Length(LineText) >= 3) and
             (Ord(LineText[1]) = $EF) and (Ord(LineText[2]) = $BB) and (Ord(LineText[3]) = $BF) then
            LineText := Copy(LineText, 4, MaxInt);
          RawLines.Add(LineText);
          if PosBMH('�', LineText) > 0 then HasMojibake := True;
          Inc(LineCount);
        end;
      end;
    finally
      CloseFile(F);
    end;

    if RawLines.Count = 0 then Exit;

    Delim := ',';
    MaxDelimCount := 0;
    Candidates := ',;|' + #9;
    for ki := 1 to Length(Candidates) do
    begin
      D := Candidates[ki];
      ThisCount := 0;
      for i := 1 to Length(RawLines[0]) do
        if RawLines[0][i] = D then Inc(ThisCount);
      if ThisCount > MaxDelimCount then
      begin
        MaxDelimCount := ThisCount;
        Delim := D;
      end;
    end;

    case Delim of
      '|': DelimEsc := '\|';
      '.': DelimEsc := '\.';
    else
      DelimEsc := Delim;
    end;

    Headers := SplitByDelim(RawLines[0], Delim);
    try
      ColCount := Headers.Count;
      if ColCount > MAX_COLS then ColCount := MAX_COLS;

      HasHeader := True;
      for i := 0 to Headers.Count - 1 do
        if IsInt(Trim(Headers[i])) then
        begin
          HasHeader := False;
          Break;
        end;
      if HasHeader then FirstData := 1 else FirstData := 0;

      for Col := 0 to ColCount - 1 do
      begin
        ColAllInt[Col] := True;
        ColAllNum[Col] := True;
        ColHasDate[Col] := False;
        ColHasUrl[Col] := False;
        ColHasEmail[Col] := False;
        ColAllBool[Col] := True;
        ColSample[Col] := '';
      end;

      SpecialtyCol := FindColByHint('special');
      if SpecialtyCol < 0 then SpecialtyCol := FindColByHint('category');
      if SpecialtyCol < 0 then SpecialtyCol := FindColByHint('expertise');
      RegionCol := FindColByHint('region');
      if RegionCol < 0 then RegionCol := FindColByHint('city');

      SampleSpecialty := '';
      SampleRegion := '';

      for i := FirstData to RawLines.Count - 1 do
      begin
        Parts := SplitByDelim(RawLines[i], Delim);
        try
          for Col := 0 to ColCount - 1 do
          begin
            if Col < Parts.Count then
              V := Trim(Parts[Col])
            else
              V := '';

            if V = '' then
            begin
              ColAllInt[Col] := False;
              ColAllNum[Col] := False;
              ColAllBool[Col] := False;
              Continue;
            end;

            if ColSample[Col] = '' then ColSample[Col] := V;
            if not IsInt(V) then ColAllInt[Col] := False;
            if not IsNum(V) then ColAllNum[Col] := False;
            if IsDate(V) then ColHasDate[Col] := True;
            if IsUrl(V) then ColHasUrl[Col] := True;
            if IsEmail(V) then ColHasEmail[Col] := True;
            if not IsBool(V) then ColAllBool[Col] := False;
          end;
        finally
          Parts.Free;
        end;
      end;

      if (SpecialtyCol >= 0) and (Trim(ColSample[SpecialtyCol]) <> '') then
        SampleSpecialty := RegexEscape(Trim(ColSample[SpecialtyCol]));
      if (RegionCol >= 0) and (Trim(ColSample[RegionCol]) <> '') then
        SampleRegion := RegexEscape(Trim(ColSample[RegionCol]));

      SB := TStringList.Create;
      try
        case AModeIdx of
          0:
            begin
              SB.Add(TrText('Split: Start a new file when a line matches'));
              SB.Add(TrText('If you want to split the CSV file every time you find a new region value (assuming the file is sorted), or start a new file for each state.'));
              SB.Add('');
              if SampleRegion <> '' then
                SB.Add('Regex: ^.*,' + SampleRegion + ',.*$')
              else
                SB.Add('Regex: ^.*,[^,]+,.*$');
              SB.Add('');
              SB.Add(TrText('Logic: Every time the line contains the exact region value (for example, Sao Paulo), the system starts a new file.'));

              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;

          1:
            begin
              SB.Add(TrText('Split: equal parts (N parts, preserving complete lines)'));
              SB.Add(TrText('This mode does not use Regex. The file will be split into X equal parts, preserving complete lines (no cuts in the middle of a line).'));
              SB.Add('');
              SB.Add(TrText('How to use: set X in "Equal parts count" and run.'));
              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;

          2:
            begin
              SB.Add(TrText('Regex Match: Extract all occurrences'));
              SB.Add(TrText('Useful when you want to extract specific tokens from each line (for example, IDs and URLs).'));
              SB.Add('');

              if ColAllInt[0] then
                SB.Add('Regex: ^\d+|https?://[^\s' + DelimEsc + ']+')
              else
                SB.Add('Regex: https?://[^\s' + DelimEsc + ']+');

              SB.Add('');
              SB.Add(TrText('Logic: Returns every occurrence that matches the regex in each line.'));
              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;

          3:
            begin
              SB.Add(TrText('Regex Test: Write "true"/"false"'));
              SB.Add(TrText('Useful to validate each line quickly (for example, if a line keeps the expected CSV structure).'));
              SB.Add('');
              SB.Add('Regex: ^(?:[^' + DelimEsc + '\r\n]*' + DelimEsc + '){' +
                IntToStr(ColCount - 1) + '}[^' + DelimEsc + '\r\n]*$');
              SB.Add('');
              SB.Add(TrText('Logic: If the line matches, output is true; otherwise false.'));
              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;

          4:
            begin
              SB.Add(TrText('Regex Replace: Replace matches'));
              SB.Add(TrText('Useful to anonymize or normalize content in all lines (for example, removing numeric URL suffixes).'));
              SB.Add('');

              for Col := 0 to ColCount - 1 do
                if ColHasUrl[Col] then
                begin
                  URLDomain := Trim(ColSample[Col]);
                  if PosBMH('https://', URLDomain) = 1 then URLDomain := Copy(URLDomain, 9, MaxInt)
                  else if PosBMH('http://', URLDomain) = 1 then URLDomain := Copy(URLDomain, 8, MaxInt);
                  i := PosBMH('/', URLDomain);
                  if i > 0 then URLDomain := Copy(URLDomain, 1, i - 1)
                  else if URLDomain = '' then URLDomain := 'www.example.com';

                  SB.Add('Regex: (http://' + RegexEscape(URLDomain) + '/[a-z0-9-]+)-\d+');
                  SB.Add(TrText('Replace with:') + ' $1');
                  Break;
                end;

              if URLDomain = '' then
              begin
                SB.Add('Regex: (\\d{2,})');
                SB.Add(TrText('Replace with:') + ' ');
              end;

              SB.Add('');
              SB.Add(TrText('Logic: Every match is replaced, preserving the rest of the line unchanged.'));
              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;

          5:
            begin
              SB.Add(TrText('Regex Filter: Keep only lines where regex matches'));
              SB.Add(TrText('Useful to keep only rows that match a rule (for example, lines from one region).'));
              SB.Add('');

              if SampleRegion <> '' then
                SB.Add('Regex: ^.*' + DelimEsc + SampleRegion + DelimEsc + '.*$')
              else if SampleSpecialty <> '' then
                SB.Add('Regex: ^.*' + DelimEsc + SampleSpecialty + DelimEsc + '.*$')
              else
                SB.Add('Regex: [0-9]');

              SB.Add('');
              SB.Add(TrText('Logic: Only lines that match are kept in the output.'));
              SB.Add('');
              SB.Add('[' + TrText('Tip') + ']');
              SB.Add(TrText('Use Preview before running on the full file.'));
            end;
        end;

        if SB.Count = 0 then
        begin
          SB.Add('[' + TrText('Regex categories') + ']');
          SB.Add(TrText('No dynamic examples detected for this mode in sampled lines.'));
          SB.Add(TrText('Try another source file or pattern mode.'));
        end;

        Result := SB.Text;
      finally
        SB.Free;
      end;
    finally
      Headers.Free;
    end;
  finally
    RawLines.Free;
  end;
end;

procedure TSplitPatternDialogAutoHelper.UpdateRegexCategoryExamples;
begin
  UpdateExamples;
end;

procedure TSplitPatternDialogAutoHelper.UpdateModeControls;
var
  UseEqualParts: Boolean;
  IsRegexOp: Boolean;
  IsReplaceOp: Boolean;
  ShowModeExamples: Boolean;
begin
  UseEqualParts := Assigned(FModeCombo) and (FModeCombo.ItemIndex = 1);

  { Items 2-5 in FModeCombo are regex-only single-file operations }
  IsRegexOp := Assigned(FModeCombo) and (FModeCombo.ItemIndex >= 2);
  { Mode 4 = "Regex replace" (index 4 in cmbMode) }
  IsReplaceOp := Assigned(FModeCombo) and (FModeCombo.ItemIndex = 4);
  ShowModeExamples := Assigned(FModeCombo) and ((FModeCombo.ItemIndex = 0) or (FModeCombo.ItemIndex >= 2));

  if Assigned(FPatternEdit) then
    FPatternEdit.Enabled := not UseEqualParts;
  if Assigned(FRegexCheck) then
  begin
    FRegexCheck.Enabled := (not UseEqualParts) and (not IsRegexOp);
    if IsRegexOp then
      FRegexCheck.Checked := True;  { force regex for these ops }
  end;
  if Assigned(FEqualPartsSpin) then
    FEqualPartsSpin.Enabled := UseEqualParts;

  { Show replacement controls only for the "replace" regex op }
  if Assigned(FReplacementEdit) then
    FReplacementEdit.Enabled := IsReplaceOp;
  if Assigned(FReplacementLabel) then
    FReplacementLabel.Enabled := IsReplaceOp;

  if Assigned(FRegexExamplesLabel) then
  begin
    FRegexExamplesLabel.Visible := ShowModeExamples;
    FRegexExamplesLabel.Enabled := ShowModeExamples;
  end;
  if Assigned(FMemoRegexExamples) then
  begin
    FMemoRegexExamples.Visible := ShowModeExamples;
    FMemoRegexExamples.Enabled := ShowModeExamples;
  end;
  if ShowModeExamples then
    UpdateExamples;
end;

procedure TSplitPatternDialogAutoHelper.ModeChanged(Sender: TObject);
begin
  UpdateModeControls;
end;

procedure TSplitPatternDialogAutoHelper.RegexOpChanged(Sender: TObject);
begin
  UpdateModeControls;
end;

procedure TSplitPatternDialogAutoHelper.ValidatePatternAgainstFile(const AShowMessageOnError: Boolean);
var
  LocalError: String;
  MatchCount, TotalLines: Int64;
  SourcePath: String;
  Sz: Int64;
begin
  if not Assigned(FPatternEdit) or not Assigned(FRegexCheck) or not Assigned(FSourceEdit) then
    Exit;
  if Assigned(FModeCombo) and (FModeCombo.ItemIndex = 1) then
    Exit;
  if Trim(FPatternEdit.Text) = '' then
    Exit;
  SourcePath := Trim(FSourceEdit.Text);
  if SourcePath = '' then
    Exit;
  if not FileExists(SourcePath) then
    Exit;

  { IMPORTANT: do NOT auto-scan huge files here (UI freeze on dialog open).
    This validation is just a convenience hint; full scan happens later on "Confirm". }
  Sz := -1;
  try
    Sz := UnUtils.GetFileSize(SourcePath);
  except
    Sz := -1;
  end;
  if (Sz >= 0) and (Sz > Int64(256) * 1024 * 1024) then
  begin
    if Assigned(FInfoLabel) then
      FInfoLabel.Caption := TrText('Preview summary: file is too large to auto-validate. Click Preview to sample matches (fast), or Confirm to run full processing.');
    Exit;
  end;

  if not CountPatternMatchesInFile(SourcePath, Trim(FPatternEdit.Text), FRegexCheck.Checked,
    MatchCount, TotalLines, LocalError) then
  begin
    if AShowMessageOnError then
      FastFileMsgInfo(LocalError);
    Exit;
  end;

  if Assigned(FInfoLabel) then
    FInfoLabel.Caption := Format(TrText('Preview summary: %d matching lines in %d total lines.'), [MatchCount, TotalLines]);
end;

procedure TSplitPatternDialogAutoHelper.ApplySuggestion;
var
  SuggestedPattern: String;
  SuggestedIsRegex: Boolean;
  SuggestedHeader: String;
  Reason: String;
  CanReplacePattern: Boolean;
  CanReplaceHeader: Boolean;
  SourcePath: String;
begin
  if not Assigned(FSourceEdit) or not Assigned(FPatternEdit) or not Assigned(FRegexCheck) then
    Exit;

  SourcePath := Trim(FSourceEdit.Text);

  { Skip if same file was already scanned - prevents repeated disk reads on every OnChange keystroke }
  if SameText(SourcePath, FLastScannedFile) then
    Exit;
  FLastScannedFile := SourcePath;

  if TrySuggestSplitPatternFromFile(SourcePath, SuggestedPattern, SuggestedIsRegex, Reason) then
  begin
    CanReplacePattern := (Trim(FPatternEdit.Text) = '') or
      (FHasAutoSuggestion and
       SameText(Trim(FPatternEdit.Text), Trim(FLastAutoPattern)) and
       (FRegexCheck.Checked = FLastAutoIsRegex));

    if CanReplacePattern then
    begin
      FPatternEdit.Text := SuggestedPattern;
      FRegexCheck.Checked := SuggestedIsRegex;
      FLastAutoPattern := SuggestedPattern;
      FLastAutoIsRegex := SuggestedIsRegex;
      FHasAutoSuggestion := True;

      if Assigned(FInfoLabel) then
        FInfoLabel.Caption := TrText('Auto suggestion from file:') + ' ' + Reason;
    end;
  end;

  if Assigned(FHeaderMemo) and TryReadFirstLineFromFile(SourcePath, SuggestedHeader) then
  begin
    CanReplaceHeader := (Trim(FHeaderMemo.Text) = '') or
      (FHasAutoHeaderSuggestion and (FHeaderMemo.Text = FLastAutoHeader));
    if CanReplaceHeader then
    begin
      FHeaderMemo.Text := SuggestedHeader;
      FLastAutoHeader := SuggestedHeader;
      FHasAutoHeaderSuggestion := True;
    end;
  end;

  { Update the examples memo with patterns derived from the actual file content }
  UpdateExamples;
end;

procedure TSplitPatternDialogAutoHelper.SourceEditExit(Sender: TObject);
begin
  ApplySuggestion;
  ValidatePatternAgainstFile(False);
end;

procedure TSplitPatternDialogAutoHelper.PatternEditExit(Sender: TObject);
begin
  ValidatePatternAgainstFile(True);
end;

procedure TSplitPatternDialogAutoHelper.RegexCheckClick(Sender: TObject);
begin
  ValidatePatternAgainstFile(True);
end;

function ReadSplitPatternFileSampleForAI(const APath: String): String;
var
  F: TextFile;
  LineText: String;
  SB: TStringList;
  LineCount: Integer;
  TotalCh: Integer;
begin
  Result := '';
  if (APath = '') or not FileExists(APath) then Exit;
  SB := TStringList.Create;
  try
    AssignFile(F, APath);
    try
      Reset(F);
    except
      Exit;
    end;
    try
      LineCount := 0;
      TotalCh := 0;
      while (not Eof(F)) and (LineCount < FF_SPLIT_PATTERN_SAMPLE_MAX_LINES) and (TotalCh < FF_SPLIT_PATTERN_SAMPLE_MAX_CH) do
      begin
        ReadLn(F, LineText);
        if Trim(LineText) = '' then Continue;
        if (LineCount = 0) and (Length(LineText) >= 3) and
           (Ord(LineText[1]) = $EF) and (Ord(LineText[2]) = $BB) and (Ord(LineText[3]) = $BF) then
          LineText := Copy(LineText, 4, MaxInt);
        LineText := Utf8HeuristicToDisplayString(LineText);
        SB.Add(LineText);
        Inc(TotalCh, Length(LineText) + 2);
        Inc(LineCount);
      end;
    finally
      CloseFile(F);
    end;
    Result := SB.Text;
  finally
    SB.Free;
  end;
end;

function ReadPythonMacroFileSampleForAI(const APath: String): String;
var

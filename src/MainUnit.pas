  FBtnLvAskAI := TsSpeedButton.Create(Self);
  FBtnLvAskAI.Parent := FLvTools;
  FBtnLvAskAI.Width := 110;
  FBtnLvAskAI.OnClick := ListViewLineAskAIClick;
  StyleListViewLineToolBtn(FBtnLvAskAI);

  RealignLvToolBtns;

  FPopLvTranslate := TPopupMenu.Create(Self);
  FPopLvTranslate.AutoHotkeys := maManual;
  for Lang := Low(TAppLanguage) to High(TAppLanguage) do
  begin
    It := TMenuItem.Create(FPopLvTranslate);
    It.Caption := AssistantLangMenuCaption(Lang);
    It.Tag := Ord(Lang);
    It.RadioItem := True;
    It.OnClick := ListViewLineTranslateLangClick;
    FPopLvTranslate.Items.Add(It);
  end;

  if not Assigned(FLvPendingLines) then
    FLvPendingLines := TInt64List.Create;
  if not Assigned(FLvPendingOld) then
    FLvPendingOld := TStringList.Create;

  ApplyListViewLineToolCaptions;
  FLvTools.BringToFront;
  UpdateListViewLineToolsEnabled;
end;

function TfrmMain.CollectSelectedFileLines(ALines: TInt64List): Boolean;
var
  I, SelIdx: Integer;
  Line1Based: Int64;
begin
  Result := False;
  if not Assigned(ALines) then Exit;
  ALines.Clear;
  if isChecked and Assigned(FCheckListBox) then
  begin
    for I := 0 to FCheckListBox.Items.Count - 1 do
      if FCheckListBox.Checked[I] then
      begin
        Line1Based := Integer(FCheckListBox.Items.Objects[I]);
        if (Line1Based > 0) and (ALines.IndexOf(Line1Based) = -1) then
          ALines.Add(Line1Based);
      end;
    if (ALines.Count = 0) and Assigned(FCheckedLines) then
      for I := 0 to FCheckedLines.Count - 1 do
        if (FCheckedLines.Items[I] > 0) and (ALines.IndexOf(FCheckedLines.Items[I]) = -1) then
          ALines.Add(FCheckedLines.Items[I]);
    if (ALines.Count = 0) and (FCheckListBox.ItemIndex >= 0) and
       (FCheckListBox.ItemIndex < FCheckListBox.Items.Count) then
    begin
      Line1Based := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]);
      if Line1Based > 0 then
        ALines.Add(Line1Based);
    end;
  end
  else if Assigned(ListView1) and ListView1.HandleAllocated and (ListView1.SelCount > 0) then
  begin
    SelIdx := -1;
    repeat
      SelIdx := ListView_GetNextItem(ListView1.Handle, SelIdx, LVNI_SELECTED);
      if SelIdx = -1 then Break;
      if FFilterActive then
        Line1Based := FilteredIndexToReal(SelIdx) + 1
      else
        Line1Based := Offset + (SelIdx + 1) + CsvDataStartLine;
      if (Line1Based > 0) and (ALines.IndexOf(Line1Based) = -1) then
        ALines.Add(Line1Based);
    until False;
  end;
  if ALines.Count > 1 then
    ALines.SortUp;
  Result := ALines.Count > 0;
end;

function TfrmMain.LoadSelectedLineTexts(ALines: TInt64List; ATexts: TStringList): Boolean;
var
  I: Integer;
begin
  Result := False;
  if not Assigned(ALines) or not Assigned(ATexts) then Exit;
  ATexts.Clear;
  for I := 0 to ALines.Count - 1 do
    ATexts.Add(GetLineContent(Integer(ALines.Items[I] - 1)));
  Result := ATexts.Count = ALines.Count;
end;

procedure TfrmMain.UpdateListViewLineToolsEnabled;
var
  HasSel: Boolean;
  Tmp: TInt64List;
  CanUse: Boolean;
begin
  HasSel := False;
  if not ListviewIsEmpty then
  begin
    Tmp := TInt64List.Create;
    try
      HasSel := CollectSelectedFileLines(Tmp);
    finally
      Tmp.Free;
    end;
  end;
  CanUse := HasSel and (not FLvTextJobBusy);
  if Assigned(FLvTools) then
  begin
    FLvTools.Visible := True;
    FLvTools.BringToFront;
  end;
  if Assigned(FBtnLvTranslate) then
    FBtnLvTranslate.Enabled := CanUse;
  if Assigned(FBtnLvClear) then
    FBtnLvClear.Enabled := CanUse;
  if Assigned(FBtnLvExport) then
    FBtnLvExport.Enabled := CanUse;
  if Assigned(FBtnLvCopy) then
    FBtnLvCopy.Enabled := CanUse;
  if Assigned(FBtnLvAskAI) then
    FBtnLvAskAI.Enabled := CanUse;
  if Assigned(FBtnLvMerge) then
    FBtnLvMerge.Enabled := CanUse;
end;

procedure TfrmMain.ApplyListViewLineReplacements(ALines: TInt64List; ANewTexts: TStringList);
var
  I: Integer;
  Line1: Int64;
  PrevS, NewS, Path: string;
  N: Integer;
  SavedTexts: TStringList;
begin
  if not Assigned(ALines) or not Assigned(ANewTexts) then Exit;
  N := ALines.Count;
  if ANewTexts.Count < N then
    N := ANewTexts.Count;
  if N <= 0 then Exit;
  if UndoRedoBusy then
  begin
    FastFileMessageBox(PChar(TrText('Another edit or undo is still in progress. Please wait.')),
      APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  Path := CurrentEffectiveFilePath;
  if (Path = '') or (not FileExists(Path)) then Exit;
  SavedTexts := TStringList.Create;
  try
    for I := 0 to N - 1 do
      SavedTexts.Add(GetLineContent(Integer(ALines.Items[I] - 1)));
    CloseFileStreams;
    FSuppressPostEditRefresh := True;
    try
      for I := N - 1 downto 0 do
      begin
        Line1 := ALines.Items[I];
        PrevS := SavedTexts[I];
        if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
          Line1 := PhysicalLine1BasedForListLine0(Line1 - 1);
        NewS := ANewTexts[I];
        if PrevS = NewS then Continue;
        RecordForUndo(otEdit, Line1, PrevS, NewS);
        TEditFileThread.RunEditWait(Path, otEdit, Line1, NewS, False, True);
      end;
    finally
      FSuppressPostEditRefresh := False;
    end;
  finally
    SavedTexts.Free;
  end;
  RequestPostEditRefresh;
end;

procedure TfrmMain.ListViewLineCopyClick(Sender: TObject);
var
  Lines: TInt64List;
  Texts: TStringList;
  ClipWide: WideString;
  I: Integer;
begin
  EnsureListViewLineTools;
  Lines := TInt64List.Create;
  Texts := TStringList.Create;
  try
    if not CollectSelectedFileLines(Lines) then
    begin
      ShowAppMessage(TrText('ListView.NeedSelection'));
      Exit;
    end;
    if not LoadSelectedLineTexts(Lines, Texts) then Exit;
    ClipWide := '';
    for I := 0 to Texts.Count - 1 do
    begin
      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(Texts[I]);
    end;
    ClipboardSetUnicodeText(ClipWide);
    UpdateStatusBar(Format(TrText('ListView.CopiedLines'), [Texts.Count]), iaRight);
  finally
    Texts.Free;
    Lines.Free;
  end;
end;

function TfrmMain.PromptAskAiAboutSelectedLines(ALineCount: Integer;
  out AGoal: string): Boolean;
var
  Frm: TForm;
  Lbl: TLabel;
  Memo: TMemo;
  Footer: TPanel;
  BtnOk, BtnCancel: TButton;
  Cap: string;
  R: TRect;
  LabelH, MemoTop, MemoH: Integer;
begin
  Result := False;
  AGoal := '';
  Frm := TForm.CreateNew(nil);
  try
    Frm.BorderStyle := bsDialog;
    Frm.Position := poOwnerFormCenter;
    Frm.Caption := TrText('ListView.AskAI');
    Frm.Font.Name := 'Segoe UI';
    Frm.Font.Size := 9;
    Frm.Color := clBtnFace;
    FfPrepareDialog(Frm, 480, 280);

    Footer := TPanel.Create(Frm);
    Footer.Parent := Frm;
    Footer.Align := alBottom;
    Footer.Height := 48;
    Footer.BevelOuter := bvNone;
    Footer.ParentBackground := False;
    Footer.Color := clBtnFace;

    BtnCancel := TButton.Create(Frm);
    BtnCancel.Parent := Footer;
    BtnCancel.Caption := TrText('Cancel');
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Cancel := True;
    BtnCancel.SetBounds(Footer.ClientWidth - 12 - 88, 12, 88, 28);
    BtnCancel.Anchors := [akTop, akRight];

    BtnOk := TButton.Create(Frm);
    BtnOk.Parent := Footer;
    BtnOk.Caption := TrText('OK');
    BtnOk.ModalResult := mrOk;
    BtnOk.Default := True;
    BtnOk.SetBounds(BtnCancel.Left - 8 - 88, 12, 88, 28);
    BtnOk.Anchors := [akTop, akRight];

    Cap := Format(TrText('ListView.AskAI.PromptLabel: %d'), [ALineCount]);

    Lbl := TLabel.Create(Frm);
    Lbl.Parent := Frm;
    Lbl.AutoSize := False;
    Lbl.WordWrap := True;
    Lbl.Transparent := True;
    Lbl.Layout := tlTop;
    Lbl.Caption := Cap;
    Lbl.SetBounds(12, 12, Frm.ClientWidth - 24, 40);
    Frm.Canvas.Font.Assign(Lbl.Font);
    R := Rect(0, 0, Lbl.Width, 0);
    DrawText(Frm.Canvas.Handle, PChar(Cap), Length(Cap), R,
      DT_LEFT or DT_WORDBREAK or DT_CALCRECT or DT_NOPREFIX);
    LabelH := R.Bottom - R.Top + 4;
    if LabelH < 20 then LabelH := 20;
    if LabelH > 72 then LabelH := 72;
    Lbl.Height := LabelH;

    MemoTop := Lbl.Top + Lbl.Height + 8;
    MemoH := Frm.ClientHeight - Footer.Height - MemoTop - 8;
    if MemoH < 80 then MemoH := 80;
    Memo := TMemo.Create(Frm);
    Memo.Parent := Frm;
    Memo.ScrollBars := ssVertical;
    Memo.WantReturns := True;
    Memo.Text := '';
    Memo.SetBounds(12, MemoTop, Frm.ClientWidth - 24, MemoH);

    if Frm.ShowModal = mrOk then
    begin
      AGoal := Trim(Memo.Text);
      Result := AGoal <> '';
      if not Result then
        ShowAppMessage(TrText('ListView.AskAI.NeedGoal'));
    end;
  finally
    Frm.Free;
  end;
end;

procedure TfrmMain.ListViewLineAskAIClick(Sender: TObject);
var
  Lines: TInt64List;
  Texts: TStringList;
  Goal, Prompt, LineNums, Excerpt: string;
  I, MaxEx: Integer;
  Frag: string;
begin
  EnsureListViewLineTools;
  Lines := TInt64List.Create;
  Texts := TStringList.Create;
  try
    if not CollectSelectedFileLines(Lines) then
    begin
      ShowAppMessage(TrText('ListView.NeedSelection'));
      Exit;
    end;
    if not LoadSelectedLineTexts(Lines, Texts) then Exit;
    if not PromptAskAiAboutSelectedLines(Lines.Count, Goal) then Exit;

    LineNums := '';
    Excerpt := '';
    MaxEx := Min(8, Texts.Count);
    for I := 0 to Lines.Count - 1 do
    begin
      if LineNums <> '' then
        LineNums := LineNums + ',';
      LineNums := LineNums + IntToStr(Lines.Items[I]);
      if I < MaxEx then
      begin
        Frag := Texts[I];
        if Length(Frag) > 80 then
          Frag := Copy(Frag, 1, 77) + '...';
        if Excerpt <> '' then
          Excerpt := Excerpt + ' | ';
        Excerpt := Excerpt + IntToStr(Lines.Items[I]) + ':' + Frag;
      end;
    end;
    if Texts.Count > MaxEx then
      Excerpt := Excerpt + ' | ...';

    PipelineSetFact('selected_line_count', IntToStr(Lines.Count));
    PipelineSetFact('selected_lines', LineNums);
    PipelineSetFact('selected_excerpt', Excerpt);
    PipelineRememberUser(Format(TrText('ListView.AskAI.PipelineNote: %d'), [Lines.Count]) +
      ' ' + Goal);

    Prompt := Format(TrText('ListView.AskAI.QuestionTemplate'),
      [Goal, LineNums, IntToStr(Lines.Count)]);
    CreateFastFileAssistantPanel;
    EnsureReadTabVisible;
    AssistantPrefillQuestion(Prompt);
  finally
    Texts.Free;
    Lines.Free;
  end;
end;

procedure TfrmMain.ListViewLineMergeClick(Sender: TObject);
var
  Lines: TInt64List;
  Texts: TStringList;
  I: Integer;
  Frm: TfrmDeltaEditor;
  Item: TListItem;
begin
  EnsureListViewLineTools;
  Lines := TInt64List.Create;
  Texts := TStringList.Create;
  try
    if not CollectSelectedFileLines(Lines) then
    begin
      ShowAppMessage(TrText('ListView.NeedSelection'));
      Exit;
    end;
    if not LoadSelectedLineTexts(Lines, Texts) then Exit;
    if Lines.Count < 1 then Exit;

    EnsureReadTabVisible;
    ShowTab(tabMergeLines);
    EnsureMergeLinesTab;
    if not Assigned(FDeltaEditorHosted) then Exit;
    Frm := TfrmDeltaEditor(FDeltaEditorHosted);
    if not Assigned(Frm.lvDelta) then Exit;
    Frm.lvDelta.Items.BeginUpdate;
    try
      Frm.lvDelta.Items.Clear;
      for I := 0 to Lines.Count - 1 do
      begin
        Item := Frm.InsertSortedItem(Lines.Items[I]);
        if Assigned(Item) then
        begin
          if Item.SubItems.Count = 0 then
            Item.SubItems.Add(Texts[I])
          else
            Item.SubItems[0] := Texts[I];
        end;
      end;
    finally
      Frm.lvDelta.Items.EndUpdate;
    end;
    Frm.ApplyUiLanguage;
    if Assigned(Frm.OnResize) then
      Frm.OnResize(Frm);
    UpdateStatusBar(Format(TrText('ListView.MergeLines.PrefillStatus: %d'),
      [Lines.Count]), iaRight);
  finally
    Texts.Free;
    Lines.Free;
  end;
end;

procedure TfrmMain.ListViewLineExportClick(Sender: TObject);
var
  Lines: TInt64List;
  Texts: TStringList;
  OutFile: string;
  I, J: Integer;
  CleanLine: string;
begin
  { Selection-scoped export: never ask all-vs-selection (user already selected). }
  EnsureListViewLineTools;
  Lines := TInt64List.Create;
  Texts := TStringList.Create;
  try
    if not CollectSelectedFileLines(Lines) then
    begin
      ShowAppMessage(TrText('ListView.NeedSelection'));
      Exit;
    end;
    if not LoadSelectedLineTexts(Lines, Texts) then Exit;
    for I := 0 to Texts.Count - 1 do
    begin
      CleanLine := Texts[I];
      J := 1;
      while J <= Length(CleanLine) do
        if CleanLine[J] = #0 then
          Delete(CleanLine, J, 1)
        else
          Inc(J);
      Texts[I] := CleanLine;
    end;
    if not SaveDialog1.Execute then Exit;
    OutFile := SaveDialog1.FileName;
    Texts.SaveToFile(OutFile);
    UpdateStatusBar(Format(TrText('ListView.ExportedLines'), [Texts.Count]), iaRight);
    ShowAppMessage(Format(TrText('ListView.ExportedLines'), [Texts.Count]));
  finally
    Texts.Free;
    Lines.Free;
  end;
end;

procedure TfrmMain.ListViewLineClearClick(Sender: TObject);
var
  Lines: TInt64List;
  Texts: TStringList;
  I: Integer;
begin
  EnsureListViewLineTools;
  if FLvTextJobBusy then Exit;
  Lines := TInt64List.Create;
  Texts := TStringList.Create;
  try
    if not CollectSelectedFileLines(Lines) then
    begin
      ShowAppMessage(TrText('ListView.NeedSelection'));
      Exit;
    end;
    if Lines.Count > 40 then
    begin
      ShowAppMessage(Format(TrText('ListView.TooManyLines'), [40]));
      Exit;
    end;
    if FastFileMessageBox(
      PChar(Format(TrText('ListView.ClearLinesConfirm'), [Lines.Count])),
      APPLICATION_NAME, MB_ICONQUESTION or MB_YESNO) <> IDYES then
      Exit;
    if not LoadSelectedLineTexts(Lines, Texts) then Exit;
    for I := 0 to Texts.Count - 1 do
      Texts[I] := '';
    ApplyListViewLineReplacements(Lines, Texts);
  finally
    Texts.Free;
    Lines.Free;
  end;
end;

procedure TfrmMain.ListViewLineTranslateClick(Sender: TObject);
var
  P: TPoint;
begin
  EnsureListViewLineTools;
  if FLvTextJobBusy then Exit;
  if not Assigned(FPopLvTranslate) or not Assigned(FBtnLvTranslate) then Exit;
  P := FBtnLvTranslate.ClientToScreen(Point(0, FBtnLvTranslate.Height));
  FPopLvTranslate.Popup(P.X, P.Y);
end;

procedure TfrmMain.ListViewLineTranslateLangClick(Sender: TObject);
var
  Lang: TAppLanguage;
  Src: string;
  I: Integer;
begin
  if FLvTextJobBusy then Exit;
  if not (Sender is TMenuItem) then Exit;
  Lang := TAppLanguage(TMenuItem(Sender).Tag);
  TMenuItem(Sender).Checked := True;
  if not Assigned(FLvPendingLines) then
    FLvPendingLines := TInt64List.Create;
  if not Assigned(FLvPendingOld) then
    FLvPendingOld := TStringList.Create;
  if not CollectSelectedFileLines(FLvPendingLines) then
  begin
    ShowAppMessage(TrText('ListView.NeedSelection'));
    Exit;
  end;
  if FLvPendingLines.Count > 40 then
  begin
    ShowAppMessage(Format(TrText('ListView.TooManyLines'), [40]));
    Exit;
  end;
  if not LoadSelectedLineTexts(FLvPendingLines, FLvPendingOld) then Exit;
  Src := '';
  for I := 0 to FLvPendingOld.Count - 1 do
  begin
    if Src <> '' then
      Src := Src + #13#10;
    Src := Src + FLvPendingOld[I];
  end;
  if Trim(Src) = '' then
  begin
    ShowAppMessage(TrText('Assistant.Error.EmptyQuestion'));
    Exit;
  end;
  FLvTextJobBusy := True;
  UpdateListViewLineToolsEnabled;
  UpdateStatusBar(TrText('Assistant.Translating'), iaRight);
  TLvTranslateThread.Create(BuildAssistantTranslatePromptW(Src, AssistantLangPromptName(Lang), True));
end;

procedure TfrmMain.WMListViewTranslateDone(var Msg: TMessage);
var
  W, Inner: WideString;
  Body: string;
  NewTexts: TStringList;
  I: Integer;
begin
  FLvTextJobBusy := False;
  try
    if not FLvJobOk then
    begin
      if Trim(FLvJobErr) <> '' then
        UpdateStatusBar(FLvJobErr, iaRight)
      else
        UpdateStatusBar(TrText('Assistant.Error.Network'), iaRight);
      Exit;
    end;
    W := UnescapeJsonUnicodeWide(FLvJobAns);
    Inner := Trim(W);
    if (Inner <> '') and (Inner[1] = '{') then
    begin
      Inner := ExtractJsonStringFieldWide(W, 'resposta');
      if Inner = '' then
        Inner := ExtractJsonStringFieldWide(W, 'user_message');
      if Inner <> '' then
        W := UnescapeJsonUnicodeWide(Inner);
    end;
    Body := string(W);
    if Trim(Body) = '' then
    begin
      UpdateStatusBar(TrText('Assistant.Error.Network'), iaRight);
      Exit;
    end;
    NewTexts := TStringList.Create;
    try
      NewTexts.Text := Body;
      while (NewTexts.Count > 0) and (Trim(NewTexts[NewTexts.Count - 1]) = '') and
            (NewTexts.Count > FLvPendingLines.Count) do
        NewTexts.Delete(NewTexts.Count - 1);
      if Assigned(FLvPendingLines) and (FLvPendingLines.Count > 0) then
        ApplyListViewLineReplacements(FLvPendingLines, NewTexts);
      UpdateStatusBar(TrText('Assistant.Translated'), iaRight);
    finally
      NewTexts.Free;
    end;
  finally
    UpdateListViewLineToolsEnabled;
  end;
end;

procedure TfrmMain.ShowFilterBar(AFocusEdit: Boolean);
begin
  FFilterBarRestorePending := False;
  EnsureFilterBar;
  if not Assigned(FFilterBar) then Exit;
  FFilterBarChromeHidden := False;
  if Assigned(FFilterPeek) then
    FFilterPeek.Visible := False;
  if FilterBarIsFloating then
  begin
    FFilterBar.Visible := True;
    if Assigned(FFilterFloat) then
    begin
      FFilterFloat.Show;
      FFilterFloat.BringToFront;
    end;
  end
  else
  begin
    FFilterBar.Height := LoadFilterBarHeight;
    FFilterBar.Visible := True;
    SyncFilterBandVisible;
  end;
  FFilterBar.ApplySoftChrome;
  RefreshFilterBarState;
  if AFocusEdit then
  begin
    Application.ProcessMessages;
    FFilterBar.FocusPattern;
  end;
  SaveFilterBarVisiblePref;
end;

procedure TfrmMain.HideFilterBarChrome;
begin
  FFilterBarRestorePending := False;
  FFilterBarChromeHidden := True;
  SaveFilterBarHeight;
  SaveFilterFloatBounds;
  if FilterBarIsFloating and Assigned(FFilterFloat) then
    FFilterFloat.Hide
  else if Assigned(FFilterBar) then
    FFilterBar.Visible := False;
  SyncFilterSplitterVisible;
  if Assigned(FFilterPeek) then
  begin
    FFilterPeek.Visible := FFilterActive;
    if FFilterPeek.Visible then
    begin
      FFilterPeek.ApplySoftChrome;
      FFilterPeek.BringToFront;
    end;
  end;
  SaveFilterBarVisiblePref;
end;

function TfrmMain.IsFilterBarChromeVisible: Boolean;
begin
  Result := Assigned(FFilterBar) and (not FFilterBarChromeHidden);
  if not Result then Exit;
  if FilterBarIsFloating then
    Result := Assigned(FFilterFloat) and FFilterFloat.Visible
  else
    Result := FFilterBar.Visible;
end;

procedure TfrmMain.SaveFilterBarVisiblePref;
var
  Ini: TIniFile;
begin
  if IniName = '' then Exit;
  { Not restored yet: the stored preference is still the valid one. }
  if FFilterBarRestorePending then Exit;
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteBool('UIPrefs', 'FilterBarVisible', IsFilterBarChromeVisible);
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.RestoreFilterBarVisiblePref;
var
  Ini: TIniFile;
  Vis: Boolean;
begin
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    Vis := Ini.ReadBool('UIPrefs', 'FilterBarVisible', False);
  finally
    Ini.Free;
  end;
  if not Vis then Exit;
  EnsureReadTabVisible;
  StartupMark('  FilterBarPref: EnsureReadTabVisible');
  ShowFilterBar(False);
  StartupMark('  FilterBarPref: ShowFilterBar');
  RestoreFilterFloatIfNeeded;
  RestoreFindOccFloatIfNeeded;
  StartupMark('  FilterBarPref: floats');
end;

function TfrmMain.AdaptUiSignature: string;
var
  WA: TRect;
begin
  if Assigned(Monitor) then
    WA := Monitor.WorkareaRect
  else
    WA := Screen.WorkAreaRect;
  Result := Format('%d,%d,%d,%d|%d|%d,%d,%d,%d|%d', [WA.Left, WA.Top, WA.Right,
    WA.Bottom, CurrentPPI, Left, Top, Width, Height, Ord(WindowState)]);
end;

procedure TfrmMain.RunPendingFilterBarRestore;
begin
  if not FFilterBarRestorePending then Exit;
  FFilterBarRestorePending := False;
  RestoreFilterBarVisiblePref;
end;

function TfrmMain.SessionReopensOnOtherTab: Boolean;
var
  Ids, ActiveId, LastId: string;
  P: Integer;
begin
  Result := False;
  if IniName = '' then Exit;
  if sStoreUtils.ReadIniInteger(APPLICATION_NAME, INI_OPEN_TABS_SAVED, 0, IniName) <> 1 then
    Exit;
  Ids := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS, IniName));
  if Ids = '' then Exit;
  ActiveId := Trim(sStoreUtils.ReadIniString(APPLICATION_NAME, INI_OPEN_TABS_ACTIVE, IniName));
  if ActiveId = '' then
  begin
    LastId := Ids;
    while (LastId <> '') and (LastId[Length(LastId)] = ';') do
      Delete(LastId, Length(LastId), 1);
    P := LastDelimiter(';', LastId);
    ActiveId := Trim(Copy(LastId, P + 1, MaxInt));
  end;
  Result := (ActiveId <> '') and not SameText(ActiveId, 'tabReadFile');
end;

function TfrmMain.FilterBarModeHintText(const APattern: string): string;
var
  Mode: TFilterMatchMode;
  CaseOn: Boolean;
  ModeS, CaseS: string;
begin
  Mode := EffectiveFilterMatchMode(APattern);
  CaseOn := EffectiveFilterCaseSensitive(APattern, Mode);
  case Mode of
    fmmPrefix: ModeS := TrText('FilterBar.Mode.Prefix');
    fmmRegex: ModeS := TrText('FilterBar.Mode.Regex');
  else
    ModeS := TrText('FilterBar.Mode.Contains');
  end;
  if CaseOn then
    CaseS := TrText('FilterBar.Case.On')
  else
    CaseS := TrText('FilterBar.Case.Off');
  Result := ModeS + ' · ' + CaseS;
end;

procedure TfrmMain.RefreshFilterBarState;
var
  Status: string;
  Busy: Boolean;
  Pat: string;
begin
  if not Assigned(FFilterBar) then Exit;
  Busy := Assigned(FFilterThread);
  Pat := FFilterBar.GetPattern;
  if Pat = '' then
    Pat := Trim(FFilterText);
  FFilterBar.SetModeHint(FilterBarModeHintText(Pat));
  if Busy then
    Status := TrText('Filtering...')
  else if FFilterActive then
  begin
    if FFilterStreamPartial then
      Status := Format(TrText('Filter: %d hits (partial) - Continue for more'), [FFilteredCount])
    else
      Status := Format(TrText('Filter: %d/%d'), [FFilteredCount, FFilterTotalLines]);
  end
  else
    Status := '';
  FFilterBar.SetStatus(Status, FFilterActive, FFilterStreamPartial, Busy);
  FFilterBar.SetResultsActionsVisible(FFilterActive and (FFilteredCount > 0) and (not Busy));
  if Assigned(FFilterPeek) and FFilterBarChromeHidden then
    FFilterPeek.Visible := FFilterActive;
end;

procedure TfrmMain.ApplyFilterFromPattern(const ARaw: string);
var
  S, Needle: string;
  Mode: TFilterMatchMode;
  CS: Boolean;
begin
  S := Trim(ARaw);
  if S = '' then
  begin
    ShowAppMessage(TrText('FilterBar.EmptyPattern'));
    if Assigned(FFilterBar) then
      FFilterBar.FocusPattern;
    Exit;
  end;
  if ListviewIsEmpty then begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  if not Assigned(FSourceFileStream) then begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  FFilterText := S;
  if Assigned(FFilterBar) then
  begin
    FFilterBar.SetPattern(S);
    FFilterBar.RememberPattern(S);
  end;
  if not HasLineSearchIndex then
  begin
    FDeferredFilterAfterIndex := True;
    if TryStartAutoIndexForSearch(False) then
    begin
      RefreshFilterBarState;
      Exit;
    end;
    FDeferredFilterAfterIndex := False;
    FAssistantPendingExportFiltered := False;
    FAssistantPendingExportToFile := False;
    FAssistantPendingFilterCaseSensitive := False;
  end;
  Needle := S;
  Mode := EffectiveFilterMatchMode(S);
  if (FFilterMatchPolicy = fmpAuto) and (Mode = fmmPrefix) and
     (Length(Needle) > 0) and (Needle[Length(Needle)] = '*') then
    SetLength(Needle, Length(Needle) - 1);
  CS := EffectiveFilterCaseSensitive(Needle, Mode);

  if Assigned(FIndexFileStream) then
    StartFilter(Needle, CS, Mode)
  else
    StartFilterStream(Needle, CS, Mode);
  RefreshFilterBarState;
end;

procedure TfrmMain.FilterBarApply(Sender: TObject; const APattern: string);
begin
  ApplyFilterFromPattern(APattern);
end;

procedure TfrmMain.FilterBarClear(Sender: TObject);
begin
  if Assigned(FFilterThread) or FFilterActive then
  begin
    ClearFilter;
    UpdateStatusBar(TrText('Filter cleared.'), iaRight);
  end;
  if Assigned(FFilterBar) then
  begin
    { Keep pattern text so the user can tweak and re-apply. }
    RefreshFilterBarState;
    FFilterBar.FocusPattern;
  end;
  if Assigned(FFilterPeek) then
    FFilterPeek.Visible := False;
end;

procedure TfrmMain.FilterBarContinue(Sender: TObject);
begin
  ContinueFilterStream;
  RefreshFilterBarState;
end;

procedure TfrmMain.FilterBarHide(Sender: TObject);
begin
  HideFilterBarChrome;
end;

procedure TfrmMain.FilterBarExport(Sender: TObject);
begin
  ExportOrCopyFilterResults(False);
end;

procedure TfrmMain.FilterBarCopy(Sender: TObject);
begin
  ExportOrCopyFilterResults(True);
end;

procedure TfrmMain.ExportOrCopyFilterResults(AToClipboard: Boolean);
var
  SelOnly: Boolean;
  SelCount, I, RealIdx, j, OutCount: Integer;
  LineS: string;
  ClipWide: WideString;
  SL: TStringList;
  OutFile: string;
  Ans: Integer;
  Item: TListItem;
  Line1Based: Int64;
  UseChecks: Boolean;

  function CountCheckedInFilter: Integer;
  var
    K: Integer;
    L1: Int64;
  begin
    Result := 0;
    if not Assigned(FCheckedLines) then Exit;
    for K := 0 to FCheckedLines.Count - 1 do
    begin
      L1 := FCheckedLines.Items[K];
      if L1 <= 0 then Continue;
      if FilteredIndexForRealLine(L1 - 1) >= 0 then
        Inc(Result);
    end;
  end;

begin
  if (not FFilterActive) and (not (FFindOccKeepHits and (FFilteredCount > 0))) then
  begin
    ShowAppMessage(TrText('FilterBar.NoResults'));
    Exit;
  end;
  if FFilteredCount <= 0 then
  begin
    ShowAppMessage(TrText('FilterBar.NoResults'));
    Exit;
  end;
  if Assigned(FFilterThread) then
  begin
    ShowAppMessage(TrText('Filtering...'));
    Exit;
  end;

  UseChecks := isChecked and Assigned(FCheckListBox);
  SelCount := 0;
  if UseChecks then
    SelCount := CountCheckedInFilter
  else if Assigned(ListView1) and ListView1.HandleAllocated then
    SelCount := ListView1.SelCount;

  SelOnly := False;
  if SelCount > 0 then
  begin
    if UseChecks then
      Ans := MessageDlg(
        Format(TrText('FilterBar.AskCheckedOrAll'), [SelCount, FFilteredCount]),
        mtConfirmation, [mbYes, mbNo, mbCancel], 0)
    else
      Ans := MessageDlg(
        Format(TrText('FilterBar.AskSelectedOrAll'), [SelCount, FFilteredCount]),
        mtConfirmation, [mbYes, mbNo, mbCancel], 0);
    if Ans = mrCancel then Exit;
    SelOnly := (Ans = mrYes);
  end
  else
  begin
    if AToClipboard then
      Ans := MessageDlg(
        Format(TrText('FilterBar.ConfirmCopyAll'), [FFilteredCount]),
        mtConfirmation, [mbYes, mbNo], 0)
    else
      Ans := MessageDlg(
        Format(TrText('FilterBar.ConfirmExportAll'), [FFilteredCount]),
        mtConfirmation, [mbYes, mbNo], 0);
    if Ans <> mrYes then Exit;
  end;

  SL := TStringList.Create;
  try
    SL.BeginUpdate;
    try
      if SelOnly then
      begin
        if UseChecks and Assigned(FCheckedLines) then
        begin
          for I := 0 to FCheckedLines.Count - 1 do
          begin
            Line1Based := FCheckedLines.Items[I];
            if Line1Based <= 0 then Continue;
            RealIdx := Integer(Line1Based - 1);
            if FilteredIndexForRealLine(RealIdx) < 0 then Continue;
            LineS := GetLineContent(RealIdx);
            j := 1;
            while j <= Length(LineS) do
              if LineS[j] = #0 then
                Delete(LineS, j, 1)
              else
                Inc(j);
            SL.Add(LineS);
          end;
        end
        else if Assigned(ListView1) then
        begin
          Item := ListView1.Selected;
          while Item <> nil do
          begin
            RealIdx := FileLineIndexFromListRow(Item.Index);
            if RealIdx >= 0 then
            begin
              LineS := GetLineContent(RealIdx);
              j := 1;
              while j <= Length(LineS) do
                if LineS[j] = #0 then
                  Delete(LineS, j, 1)
                else
                  Inc(j);
              SL.Add(LineS);
            end;
            Item := ListView1.GetNextItem(Item, sdAll, [isSelected]);
          end;
        end;
      end
      else
      begin
        for I := 0 to Integer(FFilteredCount) - 1 do
        begin
          RealIdx := Integer(FilteredIndexToReal(I));
          if RealIdx < 0 then Continue;
          LineS := GetLineContent(RealIdx);
          j := 1;
          while j <= Length(LineS) do
            if LineS[j] = #0 then
              Delete(LineS, j, 1)
            else
              Inc(j);
          SL.Add(LineS);
        end;
      end;
    finally
      SL.EndUpdate;
    end;

    OutCount := SL.Count;
    if OutCount <= 0 then
    begin
      ShowAppMessage(TrText('FilterBar.NoResults'));
      Exit;
    end;

    if AToClipboard then
    begin
      ClipWide := '';
      for I := 0 to SL.Count - 1 do
      begin
        if ClipWide <> '' then
          ClipWide := ClipWide + WideString(#13#10);
        ClipWide := ClipWide + WideString(SL[I]);
      end;
      ClipboardSetUnicodeText(ClipWide);
      ShowAppMessage(Format(TrText('%d filtered line(s) copied to the clipboard.'), [OutCount]));
      UpdateStatusBar(Format(TrText('%d filtered line(s) copied to the clipboard.'), [OutCount]), iaRight);
    end
    else
    begin
      if not SaveDialog1.Execute then Exit;
      OutFile := SaveDialog1.FileName;
      SL.SaveToFile(OutFile);
      ShowAppMessage(Format(TrText('%d filtered line(s) exported to file.'), [OutCount]));
      UpdateStatusBar(Format(TrText('%d filtered line(s) exported to file.'), [OutCount]), iaRight);
    end;
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.FilterPeekRestore(Sender: TObject);
begin
  ShowFilterBar(True);
end;

procedure TfrmMain.StartFilterStream(const AText: String; ACaseSensitive: Boolean;
  const AMatchMode: TFilterMatchMode);
var
  MaxHits: Int64;
  Page: Int64;
begin
  if Trim(edtFileName.Text) = '' then begin ShowAppMessage(TrText('Please read a file first.')); Exit; end;
  if not Assigned(FSourceFileStream) then begin ShowAppMessage(TrText('Please read the file first.')); Exit; end;
  if Assigned(FFilterThread) then begin
    TFilterStreamThread(FFilterThread).Terminate;
    FFilterThread := nil;
  end;
  if Assigned(FFilterBits) then begin FreeMem(FFilterBits); FFilterBits := nil; end;
  FFilterUseHitsFile := False;
  if Assigned(FFilterHitsFileStream) then
  begin
    FFilterHitsFileStream.Free;
    FFilterHitsFileStream := nil;
  end;
  FFilterUseHitsList := False;
  SetLength(FFilterHitsList, 0);
  FFilterActive := False;
  FFilteredCount := 0;
  SetLength(FFilterJumpTable, 0);
  FFilterStreamPartial := False;
  FFilterStreamResumeByte := 0;
  FFilterStreamResumeLine := 0;
  FFilterText := AText;
  FFilterStreamCaseSensitive := ACaseSensitive;
  FFilterStreamMatchMode := AMatchMode;
  UpdateStatusBar(TrText('Filtering (stream)...'), iaRight);
  if FAssistantFilterSoftCap then
    Page := ASSISTANT_FILTER_SOFT_MAX_HITS
  else
    Page := FILTER_STREAM_PAGE_HITS;
  MaxHits := Page;
  if MaxHits > FILTER_STREAM_MAX_HITS then
    MaxHits := FILTER_STREAM_MAX_HITS;
  FFilterThread := TFilterStreamThread.Create(Self, CurrentEffectiveFilePath, AText,
    ACaseSensitive, AMatchMode, MaxHits, 0, 0, False);
  FAssistantFilterSoftCap := False;
end;

procedure TfrmMain.ContinueFilterStream;
var
  MaxHits: Int64;
  Page: Int64;
begin
  if (not FFilterActive) and (not FFindOccKeepHits) then
  begin
    ShowAppMessage(TrText('No active filter. Press Ctrl+L first.'));
    Exit;
  end;
  if not FFilterStreamPartial then
  begin
    ShowAppMessage(TrText('Filter already complete (no more hits to load).'));
    Exit;
  end;
  if Assigned(FFilterThread) then
  begin
    ShowAppMessage(TrText('Filter is still running...'));
    Exit;
  end;
  if Trim(FFilterText) = '' then Exit;
  if not Assigned(FSourceFileStream) then
  begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  { Keep current hits file open until the worker reopens for append. }
  if Assigned(FFilterHitsFileStream) then
  begin
    FFilterHitsFileStream.Free;
    FFilterHitsFileStream := nil;
  end;
  Page := FILTER_STREAM_PAGE_HITS;
  MaxHits := FFilteredCount + Page;
  if MaxHits > FILTER_STREAM_MAX_HITS then
    MaxHits := FILTER_STREAM_MAX_HITS;
  if MaxHits <= FFilteredCount then
  begin
    FFilterStreamPartial := False;
    if FFindOccDroveFilter or FFindOccKeepHits then
      ShowAppMessage(TrText('FindOcc.HitLimitReached'))
    else
      ShowAppMessage(TrText('Filter hit limit reached. Narrow the pattern or index the file.'));
    RefreshFindOccBarState;
    Exit;
  end;
  UpdateStatusBar(TrText('Filtering (stream)...'), iaRight);
  FFilterThread := TFilterStreamThread.Create(Self, CurrentEffectiveFilePath, FFilterText,
    FFilterStreamCaseSensitive, FFilterStreamMatchMode, MaxHits,
    FFilterStreamResumeByte, FFilterStreamResumeLine, True);
end;

procedure TfrmMain.StartFilter(const AText: String; ACaseSensitive: Boolean;
  const AMatchMode: TFilterMatchMode);
var
  IndexPath: String;
  CkptPath: String;
  FilterTotalLines: Int64;
begin
  if Trim(edtFileName.Text) = '' then begin ShowAppMessage(TrText('Please read a file first.')); Exit; end;
  if not HasLineSearchIndex then Exit;
  if Assigned(FFilterThread) then begin
    TFilterThread(FFilterThread).Terminate;
    FFilterThread := nil;
  end;
  if Assigned(FFilterBits) then begin FreeMem(FFilterBits); FFilterBits := nil; end;
  FFilterActive := False;
  FFilteredCount := 0;
  SetLength(FFilterJumpTable, 0);
  FFilterStreamPartial := False;
  IndexPath := FastFileExeDirPath(TEMPFILE);
  CkptPath := FastFileExeDirPath(TEMP_CKPT_FILE);
  if not Assigned(FIndexFileStream) then
  begin
    StartFilterStream(AText, ACaseSensitive, AMatchMode);
    Exit;
  end;
  FilterTotalLines := FIndexFileStream.Size div INDEX_RECORD_SIZE;
  if FilterTotalLines <= 0 then Exit;
  FFilterText := AText;
  UpdateStatusBar(TrText('Filtering...'), iaRight);
  FFilterThread := TFilterThread.Create(Self, edtFileName.Text, IndexPath, AText, ACaseSensitive, FilterTotalLines, AMatchMode);
  FAssistantFilterSoftCap := False;
end;

procedure TfrmMain.UpdateFilterBuildProgress(const LinesDone, TotalLines: Int64);
begin
  UpdateStatusBar(TrText('Filtering') + ' ' + UnUtils.FormatNumber(LinesDone) + ' / ' +
    UnUtils.FormatNumber(TotalLines) + ' ' + TrText('lines'), iaRight);
  RefreshFilterBarState;
end;

procedure TfrmMain.UpdateFilterStreamProgress(const BytesDone, TotalBytes: Int64);
begin
  if TotalBytes > 0 then
    UpdateStatusBar(TrText('Filtering') + ' ' + UnUtils.FormatNumber(BytesDone) + ' / ' +
      UnUtils.FormatNumber(TotalBytes) + ' B', iaRight)
  else
    UpdateStatusBar(TrText('Filtering...'), iaRight);
  RefreshFilterBarState;
end;

procedure TfrmMain.FinishFilterThreadFailed(const AMsg: string);
begin
  FFilterThread := nil;
  if Assigned(FFilterBits) then begin FreeMem(FFilterBits); FFilterBits := nil; end;
  FFilterBitsSize := 0;
  FFilterUseHitsFile := False;
  if Assigned(FFilterHitsFileStream) then
  begin
    FFilterHitsFileStream.Free;
    FFilterHitsFileStream := nil;
  end;
  FFilterUseHitsList := False;
  SetLength(FFilterHitsList, 0);
  FFilterActive := False;
  FFilterStreamPartial := False;
  FFilterStreamResumeByte := 0;
  FFilterStreamResumeLine := 0;
  FFilteredCount := 0;
  FFilterTotalLines := 0;
  SetLength(FFilterJumpTable, 0);
  ZeroScanDeleteFilterHits;
  if Assigned(ListView1) and Assigned(FIndexFileStream) then begin
    ListView1Resize(ListView1);
    ListView1.Invalidate;
  end;
  UpdateInfoPanels;
  SyncScrollBarsForFilterMode;
  if Assigned(FMenuFilterContinue) then
    FMenuFilterContinue.Enabled := False;
  if isChecked then
    showChecked;
  if AMsg <> '' then
    FastFileMessageBox(PChar(AMsg), PChar(TrText('Filter / Grep')), MB_OK or MB_ICONWARNING);
  FAssistantPendingExportFiltered := False;
  FAssistantPendingExportToFile := False;
  FAssistantPendingFilterCaseSensitive := False;
  UpdateStatusBar(TrText('Ready'), iaRight);
  RefreshFilterBarState;
  if FFindOccDroveFilter then
  begin
    FFindOccDroveFilter := False;
    RefreshFindOccBarState;
  end;
end;

procedure TfrmMain.FilterThreadDone;
begin
  FFilterThread := nil;

  { Find Occurrences: keep hits for the clickable list, do NOT remap ListView. }
  if FFindOccDroveFilter then
  begin
    FFindOccKeepHits := True;
    FFilterActive := False;
    Offset := 0;
    fScrollPos := 0;
    if Assigned(ScrollBarVertical) then
      SafeSetScrollBarPosition(ScrollBarVertical, 0);
    SyncScrollBarsForFilterMode;
    SyncVerticalScrollBarRange;
    if Assigned(ListView1) and Assigned(FIndexFileStream) then
    begin
      ListView1Resize(ListView1);
      ListView1.Invalidate;
    end;
    if isChecked then
      showChecked;
    if FFilterStreamPartial then
      UpdateStatusBar(
        Format(TrText('FindOcc.Status.Partial'), [FFilteredCount, FFindText]),
        iaRight)
    else
      UpdateStatusBar(
        Format(TrText('FindOcc.Status.Ready'), [FFilteredCount, FFindText]),
        iaRight);
    UpdateInfoPanels;
    FFindOccListPage := 0;
    ShowFindOccBar;
    FillFindOccHitPage;
    RefreshFindOccBarState;
    OfferAssistantAfterFilter;
    Exit;
  end;

  FFilterActive := True;
  Offset := 0;
  fScrollPos := 0;
  if Assigned(ScrollBarVertical) then
    SafeSetScrollBarPosition(ScrollBarVertical, 0);
  SyncScrollBarsForFilterMode;
  SyncVerticalScrollBarRange;
  if isChecked and Assigned(FCheckListBox) then
  begin
    { Select ON: viewport filtrado na checklist (Offset = indice nos hits). }
    showChecked;
  end
  else if Assigned(ListView1) then
  begin
    if ListView1.Visible then
      ListView1Resize(ListView1)
    else if FFilteredCount < 1 then
      ListView1.Items.Count := 0
    else if FFilteredCount > MaxInt then
      ListView1.Items.Count := MaxInt
    else
      ListView1.Items.Count := Integer(FFilteredCount);
    ListView1.Invalidate;
    if FFilteredCount > 0 then
    begin
      ListView1.Refresh;
      SelectListViewItem(0);
    end;
  end;
  if FFilterStreamPartial then
    UpdateStatusBar(
      Format(TrText('Filter: %d hits (partial) - Continue for more'), [FFilteredCount]),
      iaRight)
  else
    UpdateStatusBar(Format(TrText('Filter: %d/%d'), [FFilteredCount, FFilterTotalLines]), iaRight);
  UpdateInfoPanels;
  if Assigned(FMenuFilterContinue) then
    FMenuFilterContinue.Enabled := FFilterStreamPartial;
  RefreshFilterBarState;
  if FAssistantPendingExportFiltered then
  begin
    FAssistantPendingExportFiltered := False;
    if FFilteredCount <= 0 then
      ShowAppMessage(TrText('Filter has no results to export.'))
    else
      AssistantCbExportFilteredToFile(FFilterText, FAssistantPendingFilterCaseSensitive);
    FAssistantPendingExportToFile := False;
    FAssistantPendingFilterCaseSensitive := False;
  end;
  RefreshFindOccBarState;
  if not FFindOccDroveFilter then
    AssistantOfferAfterActivity('filter',
      Format(TrText('Assistant.Offer.Summary.Filter'), [FFilteredCount]));
end;

procedure TfrmMain.ClearFilter;
begin
  if Assigned(FFilterThread) then begin
    FFilterThread.Terminate;
    FFilterThread := nil;
  end;
  FFilterActive := False;
  FFindOccKeepHits := False;
  FFilterStreamPartial := False;
  FFilterStreamResumeByte := 0;
  FFilterStreamResumeLine := 0;
  FFilterUseHitsFile := False;
  if Assigned(FFilterHitsFileStream) then
  begin
    FFilterHitsFileStream.Free;
    FFilterHitsFileStream := nil;
  end;
  ZeroScanDeleteFilterHits;
  FFilterUseHitsList := False;
  SetLength(FFilterHitsList, 0);
  FFilteredCount := 0;
  FFilterTotalLines := 0;
  SetLength(FFilterJumpTable, 0);
  if Assigned(FFilterBits) then begin FreeMem(FFilterBits); FFilterBits := nil; end;
  FFilterBitsSize := 0;
  { Sempre ListView1Resize: com Select ativo nao pode ficar Items.Count = linhas totais (quebra OwnerData / linhas em branco). }
  if Assigned(ListView1) and Assigned(FIndexFileStream) then begin
    ListView1Resize(ListView1);
    ListView1.Invalidate;
  end;
  UpdateStatusBar(TrText('Ready'), iaRight);
  UpdateInfoPanels;
  SyncScrollBarsForFilterMode;
  SyncVerticalScrollBarRange;
  if Assigned(FMenuFilterContinue) then
    FMenuFilterContinue.Enabled := False;
  if isChecked then
    showChecked;
  RefreshFilterBarState;
  if Assigned(FFilterPeek) and FFilterBarChromeHidden then
    FFilterPeek.Visible := False;
  RefreshFindOccBarState;
end;

procedure TfrmMain.EnsureFindOccBar;
begin
  if not Assigned(pnlCenter) then Exit;
  if Assigned(FFindOccBar) then Exit;

  FFindOccPeek := TFastFileFindOccPeek.Create(Self);
  FFindOccPeek.Parent := pnlCenter;
  FFindOccPeek.Visible := False;
  FFindOccPeek.OnRestore := FindOccPeekRestore;

  FFindOccBar := TFastFileFindOccBar.Create(Self);
  FFindOccBar.Parent := pnlCenter;
  FFindOccBar.EnsureBuilt;
  FFindOccBar.Visible := False;
  FFindOccBar.OnCollect := FindOccCollect;
  FFindOccBar.OnSearch := FindOccSearch;
  FFindOccBar.OnPrev := FindOccPrev;
  FFindOccBar.OnNext := FindOccNext;
  FFindOccBar.OnLoadMore := FindOccContinue;
  FFindOccBar.OnExport := FindOccExport;
  FFindOccBar.OnCopy := FindOccCopy;
  FFindOccBar.OnClear := FindOccClear;
  FFindOccBar.OnHide := FindOccHide;
  FFindOccBar.OnFloat := FindOccBarFloat;
  FFindOccBar.OnTearOff := FindOccBarTearOff;
  FFindOccBar.OnHitClick := FindOccHitClick;
  FFindOccBar.OnListPagePrev := FindOccListPagePrev;
  FFindOccBar.OnListPageNext := FindOccListPageNext;
  FFindOccBar.ApplyCaptions;
  FFindOccBar.ApplySoftChrome;
end;

procedure TfrmMain.ShowFindOccBar;
begin
  EnsureFindOccBar;
  if not Assigned(FFindOccBar) then Exit;
  FFindOccChromeHidden := False;
  if Assigned(FFindOccPeek) then
    FFindOccPeek.Visible := False;
  if FindOccBarIsFloating then
  begin
    if Assigned(FFindOccFloat) then
    begin
      FFindOccFloat.Show;
      FFindOccFloat.BringToFront;
    end;
    FFindOccBar.Visible := True;
  end
  else
  begin
    FFindOccBar.Visible := True;
    if FFindOccKeepHits and (FFilteredCount > 0) then
      FFindOccBar.Height := FFindOccBar.PreferredExpandedHeight
    else
      FFindOccBar.Height := FfPx(FIND_OCC_BAR_HEIGHT);
    FFindOccBar.BringToFront;
    FFindOccBar.RelayoutAfterDock;
  end;
  RefreshFindOccBarState;
  if Trim(FFindText) = '' then
    FFindOccBar.FocusSearchEdit
  else
    FFindOccBar.SetSearchText(FFindText);
end;

procedure TfrmMain.HideFindOccBarChrome;
begin
  if not Assigned(FFindOccBar) then Exit;
  if FindOccBarIsFloating and Assigned(FFindOccFloat) then
    FFindOccFloat.Hide;
  FFindOccBar.Visible := False;
  FFindOccChromeHidden := True;
  if Assigned(FFindOccPeek) and (not FindOccBarIsFloating) then
    FFindOccPeek.Visible := FFindOccOfferShown or FFindOccDroveFilter;
end;

procedure TfrmMain.RefreshFindOccBarState;
var
  StatusS: string;
  Busy, HasHits, Partial: Boolean;
  NeedleShown: string;
begin
  if not Assigned(FFindOccBar) then Exit;
  Busy := Assigned(FFilterThread) and FFindOccDroveFilter;
  HasHits := FFindOccDroveFilter and FFindOccKeepHits and (FFilteredCount > 0);
  Partial := FFindOccDroveFilter and FFilterStreamPartial;
  NeedleShown := Trim(FFindText);
  if Length(NeedleShown) > 40 then
    NeedleShown := Copy(NeedleShown, 1, 37) + '...';

  if Busy then
    StatusS := Format(TrText('FindOcc.Status.Collecting'), [NeedleShown])
  else if HasHits then
  begin
    if Partial then
      StatusS := Format(TrText('FindOcc.Status.Partial'), [FFilteredCount, NeedleShown])
    else
      StatusS := Format(TrText('FindOcc.Status.Ready'), [FFilteredCount, NeedleShown]);
  end
  else if FLastFoundLine >= 0 then
    StatusS := Format(TrText('FindOcc.Status.Offer'), [FLastFoundLine + 1, NeedleShown])
  else if NeedleShown <> '' then
    StatusS := Format(TrText('FindOcc.Status.ReadyToCollect'), [NeedleShown])
  else
    StatusS := TrText('FindOcc.Status.Idle');

  FFindOccBar.SetStatus(StatusS, Busy, HasHits, Partial);
  FFindOccBar.SetNavEnabled(
    (Trim(FFindText) <> '') and (not Busy),
    (Trim(FFindText) <> '') and (not Busy));
  FFindOccBar.SetCollectEnabled((Trim(FFindText) <> '') and (not Busy));
  if not FFindOccBar.SearchEditFocused then
    FFindOccBar.SetSearchText(FFindText);
end;

procedure TfrmMain.OfferFindOccurrencesAfterHit;
begin
  if Trim(FFindText) = '' then Exit;
  FFindOccOfferShown := True;
  ShowFindOccBar;
end;

procedure TfrmMain.ClearFindOccurrences;
begin
  if FFindOccDroveFilter and
     (FFilterActive or FFindOccKeepHits or Assigned(FFilterThread) or (FFilteredCount > 0)) then
    ClearFilter;
  FFindOccDroveFilter := False;
  FFindOccKeepHits := False;
  FFindOccListPage := 0;
  FFindOccOfferShown := False;
  FFindMatchSelection := False;
  FHasSelection := False;
  FLastFoundLine := -1;
  FLastFoundFilePos := 0;
  FLastFoundCol := 0;
  FLastFoundMatchLen := 0;
  FFindText := '';
  if Assigned(edtSearch) then
    edtSearch.Text := '';
  if Assigned(ListView1) then ListView1.Invalidate;
  if Assigned(FCheckListBox) then FCheckListBox.Invalidate;
  if Assigned(FFindOccBar) then
  begin
    FFindOccBar.SetSearchText('');
    FFindOccBar.ClearHitList;
    FFindOccBar.Visible := False;
  end;
  if Assigned(FFindOccPeek) then
    FFindOccPeek.Visible := False;
  FFindOccChromeHidden := False;
  UpdateStatusBar(TrText('FindOcc.Cleared'), iaRight);
end;

procedure TfrmMain.ApplyFindOccurrencesToView;
var
  Needle: string;
begin
  Needle := Trim(FFindText);
  if Needle = '' then
  begin
    ShowAppMessage(TrText('Use Ctrl+F first to define the search text.'));
    Exit;
  end;
  if Trim(edtFileName.Text) = '' then
  begin
    ShowAppMessage(TrText('Please read a file first.'));
    Exit;
  end;
  if not Assigned(FSourceFileStream) then
  begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;

  FFindOccDroveFilter := True;
  FFindOccFilterOffered := False;
  FFindOccListPage := 0;
  FFindOccKeepHits := False;
  if IsFilterBarChromeVisible then
    HideFilterBarChrome;
  if Assigned(FFindOccBar) then
    FFindOccBar.ClearHitList;
  FFilterText := Needle;
  UpdateStatusBar(TrText('FindOcc.Status.CollectingShort'), iaRight);
  ShowFindOccBar;
  RefreshFindOccBarState;

  { Always stream-collect to disk (temp_filter_hits.bin), never the indexed
    full-file bitset path: soft pages of FILTER_STREAM_PAGE_HITS + Continue,
    hard cap FILTER_STREAM_MAX_HITS. UI list stays at FIND_OCC_LIST_PAGE_SIZE. }
  StartFilterStream(Needle, FFindCaseSensitive, fmmContains);
  RefreshFindOccBarState;
end;

procedure TfrmMain.FindOccSearch(Sender: TObject);
var
  S: string;
begin
  if not Assigned(FFindOccBar) then Exit;
  if CurrentEffectiveFilePath = '' then
  begin
    ShowAppMessage(TrText('Please select a file.'));
    Exit;
  end;
  if not FileExists(CurrentEffectiveFilePath) then
  begin
    ShowAppMessage(TrText('File not found.'));
    Exit;
  end;
  if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then
  begin
    ShowAppMessage(TrText('Please read the file first.'));
    Exit;
  end;
  S := Trim(FFindOccBar.GetSearchText);
  if S = '' then
  begin
    ShowAppMessage(TrText('Enter search text.'));
    FFindOccBar.FocusSearchEdit;
    Exit;
  end;

  { New panel search must drop stale hits from the previous needle so the
    occurrences list / Export / Copiar / pagination match the edit text. }
  if Assigned(FFilterThread) then
  begin
    FFilterThread.Terminate;
    FFilterThread := nil;
  end;
  if FFindOccKeepHits or FFindOccDroveFilter or FFilterActive or (FFilteredCount > 0) then
    ClearFilter;
  FFindOccDroveFilter := False;
  FFindOccKeepHits := False;
  FFindOccListPage := 0;
  FFindOccBar.ClearHitList;

  FFindText := S;
  FFindOccBar.SetSearchText(S);
  FFindOccAssistantOffered := False;
  FFindOccOfferShown := False;
  FLastFoundLine := -1;
  FLastFoundFilePos := 0;
  FLastFoundCol := 0;
  FLastFoundMatchLen := 0;
  FFindMatchSelection := False;
  FHasSelection := False;

  if not HasLineSearchIndex then
  begin
    if TryStartAutoIndexForSearch then Exit;
  end;
  FFindCaseSensitive := EffectiveFindCaseSensitive(S);

  { Always restart from the top of the file (not from the previous hit). }
  StartFindFromPos(0, +1);

  { Rebuild "Ver todas na lista" collection for this needle (async). }
  ApplyFindOccurrencesToView;
end;

procedure TfrmMain.FindOccCollect(Sender: TObject);
begin
  ApplyFindOccurrencesToView;
end;

procedure TfrmMain.FindOccPrev(Sender: TObject);
var
  StartPos: Int64;
begin
  if Trim(FFindText) = '' then Exit;
  StartPos := FLastFoundFilePos - 1;
  if StartPos < 0 then StartPos := 0;
  StartFindFromPos(StartPos, -1);
end;

procedure TfrmMain.FindOccNext(Sender: TObject);
var
  StartPos: Int64;
begin
  if Trim(FFindText) = '' then Exit;
  if FLastFoundLine < 0 then
    StartPos := 0
  else
    StartPos := FLastFoundFilePos + 1;
  if StartPos < 0 then StartPos := 0;
  StartFindFromPos(StartPos, +1);
end;

procedure TfrmMain.FindOccContinue(Sender: TObject);
begin
  if not FFindOccDroveFilter then Exit;
  ContinueFilterStream;
  RefreshFindOccBarState;
end;

procedure TfrmMain.FindOccExport(Sender: TObject);
begin
  if not (FFindOccDroveFilter and FFindOccKeepHits) then Exit;
  ExportOrCopyFilterResults(False);
end;

procedure TfrmMain.FindOccCopy(Sender: TObject);
begin
  if not (FFindOccDroveFilter and FFindOccKeepHits) then Exit;
  ExportOrCopyFilterResults(True);
end;

procedure TfrmMain.FindOccClear(Sender: TObject);
begin
  ClearFindOccurrences;
end;

procedure TfrmMain.FindOccHide(Sender: TObject);
begin
  HideFindOccBarChrome;
end;

procedure TfrmMain.FindOccPeekRestore(Sender: TObject);

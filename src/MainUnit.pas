      '  ' + TrText('Menu bar: Underlined letter = Alt+letter (example: Alt+F, E, V, T, S, O for File, Edit, View, Tools, Session, Options).'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_MENUBAR_L2,
      '  ' + TrText('Ctrl+ shortcuts are shown to the right of each menu command.'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_VIEW_ZOOM_IN,
      '  Ctrl+Num+ .......... Zoom in list font (View menu)', [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_VIEW_ZOOM_OUT,
      '  Ctrl+Num- .......... Zoom out list font (View menu)', [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_COMPARE_MERGE,
      '  Ctrl+Shift+H ....... Compare / merge + session history tab (two-file diff, journal)', [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_COMPARE_MERGE_RELOAD_1,
      '  Session history Reload: a worker thread reads the journal tail, filters lines, loads the preview file and optional color scan; the progress bar covers that work first, then filling the memo and list on the UI thread.', [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_COMPARE_MERGE_RELOAD_2,
      '  The loading overlay is not stay-on-top, and the UI yields often (including a short wait for queued input) so you can use Alt+Tab and other applications during a long reload.', [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_ZERO_SCAN,
      'ZERO SCAN / INSTANT OPEN (View: Force Zero Scan; or file >= ' +
      IntToStr(GetMaxGbFileIndexed) + ' GB)' + CRLF +
      FF_HELP_DIALOG_SEP + CRLF +
      '  Opens huge files without building temp.txt first. Scroll uses estimated line count until you index.' + CRLF +
      '  Ctrl+F / Ctrl+H: dialog YES = build line index (exact lines); NO = search by bytes (~line in status); CANCEL = abort.' + CRLF +
      '  Ctrl+G: goes to physical line by scanning the file (byte-accurate position). Ctrl+Shift+G: go to byte offset.' + CRLF +
      '  Shift+End: discovers last physical line (regressive list scan; files >256 MB count LF in background with progress).' + CRLF +
      '  Ctrl+L: docked FilterBar (MRU); stream filter without dense index, or index first for classic filter.' + CRLF +
      '  Replace All (Ctrl+H): works without index (streaming); segmented mode needs temp.txt.' + CRLF +
      '  Batch delete (Select): MMF path without index; may offer to index first for best accuracy.' + CRLF +
      '  Ctrl+Shift+Q: extract file parts (LF-safe subset) works in Zero Scan (counts lines via MMF).' + CRLF +
      '  On exit: temp.txt and temp_ckpt.txt are removed from the app folder.' + CRLF +
    '  F5 with Force Zero Scan: re-open instant; F5 without Force: full index for normal mode.' + CRLF +
    '  See DOC_ZS_ATALHOS.md for full shortcut matrix and test checklists.' + CRLF + CRLF +
    MK_HELP_EMEDITOR, [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_VERSION,
      'Version ' + APPLICATION_VERSION, [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_RECENT,
      TrText('FF_HELP.RecentFeaturesBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_READ_PANEL,
      TrText('FF_HELP.ReadPanelBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_IDLE_WORKSPACE,
      TrText('FF_HELP.IdleWorkspaceBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_WIN64_INDEX,
      TrText('FF_HELP.Win64IndexBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_AICHAT_FILE,
      TrText('FF_HELP.AIChatFileBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_EMEDITOR,
      TrText('FF_HELP.EmEditorBlock'), [rfReplaceAll]);
    HelpBody := StringReplace(HelpBody, MK_HELP_ASSISTANT,
      TrText('FF_HELP.AssistantBlock'), [rfReplaceAll]);
    Memo.Text := HelpBody;
    BtnW := 120;
    TotalW := BtnW * 3 + 16;
    StartX := (Frm.ClientWidth - TotalW) div 2;
    BtnCopy := TButton.Create(Frm);
    BtnCopy.Parent := Frm;
    BtnCopy.Caption := TrText('&Copy');
    BtnCopy.Width := BtnW;
    BtnCopy.Height := 28;
    BtnCopy.Left := StartX;
    BtnCopy.Top := Frm.ClientHeight - 40;
    BtnCopy.Anchors := [akBottom];
    BtnCopy.ModalResult := mrYes;
    BtnExport := TButton.Create(Frm);
    BtnExport.Parent := Frm;
    BtnExport.Caption := TrText('&Export...');
    BtnExport.Width := BtnW;
    BtnExport.Height := 28;
    BtnExport.Left := StartX + BtnW + 8;
    BtnExport.Top := Frm.ClientHeight - 40;
    BtnExport.Anchors := [akBottom];
    BtnExport.ModalResult := mrRetry;
    Btn := TButton.Create(Frm);
    Btn.Parent := Frm;
    Btn.Caption := TrText('Close');
    Btn.Width := BtnW;
    Btn.Height := 28;
    Btn.Left := StartX + (BtnW + 8) * 2;
    Btn.Top := Frm.ClientHeight - 40;
    Btn.Anchors := [akBottom];
    Btn.ModalResult := mrOk;
    Btn.Default := True;
    Btn.Cancel := True;
    Frm.OnKeyDown := FormHelpKeyDown;
    repeat
      MR := Frm.ShowModal;
      if MR = mrYes then begin
        Clipboard.AsText := Memo.Text;
        FastFileMessageBox(PChar(TrText('Content copied to clipboard.')), APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
      end else if MR = mrRetry then begin
        SD := TSaveDialog.Create(nil);
        try
          SD.Title := TrText('Export Help Content');
          SD.Filter := TrText(FILTER_TEXT_AND_ALL_FILES);
          SD.DefaultExt := DEFAULT_TEXT_EXT;
          SD.FileName := HELP_EXPORT_FILENAME;
          if SD.Execute then Memo.Lines.SaveToFile(SD.FileName);
        finally
          SD.Free;
        end;
      end;
    until (MR <> mrRetry) and (MR <> mrYes);
  finally
    Frm.Free;
    FocusPrimaryReadView;
  end;
end;

{ ============================================================================ }
{ ApplyReadPanelKey - atalhos do painel Read (Form KeyPreview + CheckListBox) }
{ ============================================================================ }

function TfrmMain.ReadPanelPasteFocusActive: Boolean;
begin
  Result := False;
  if Assigned(FCheckListBox) and FCheckListBox.Visible and
     (Screen.ActiveControl = FCheckListBox) then
    Result := True
  else if Assigned(ListView1) and ListView1.Visible and
     ((Screen.ActiveControl = ListView1) or ListView1.Focused) then
    Result := True;
end;

function TfrmMain.ClipboardHasPasteableText: Boolean;
begin
  Result := Clipboard.HasFormat(CF_TEXT) and (Trim(Clipboard.AsText) <> '');
end;

function TfrmMain.DoPasteClipboardLinesAtSelection: Boolean;
var
  PasteStartLine: Int64;
  ClipText: string;
  ClipLines: TStringList;
  I: Integer;
  HasNonEmptyLine: Boolean;
begin
  Result := False;
  EnsureReadTabVisible;
  if ListviewIsEmpty then Exit;
  if not ClipboardHasPasteableText then Exit;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  if TryStartAutoIndexForMutation then Exit;

  if not TryGetSelectedStartLine(PasteStartLine) then
  begin
    ShowAppMessage(TrText('Please select a line first.'));
    Exit;
  end;
  if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
    PasteStartLine := PhysicalLine1BasedForListLine0(PasteStartLine - 1);

  ClipText := Clipboard.AsText;
  ClipLines := TStringList.Create;
  try
    ClipLines.Text := StringReplace(ClipText, #13#10, #10, [rfReplaceAll]);
    TrimTrailingEmptyClipboardLines(ClipLines);
    if ClipLines.Count = 0 then Exit;
    HasNonEmptyLine := False;
    for I := 0 to ClipLines.Count - 1 do
      if Trim(ClipLines[I]) <> '' then
      begin
        HasNonEmptyLine := True;
        Break;
      end;
    if not HasNonEmptyLine then Exit;
    if not MessageBoxTrYesNo(
      Format(TrText('Insert %d line(s) from the clipboard starting at line %d?'),
        [ClipLines.Count, PasteStartLine]),
      TrText('Confirmation')) then
      Exit;
    { X = ClipLines.Count: colar, gravar, undo e redo operam sobre esse bloco inteiro. }
    if ApplyBatchInsertWithUndo(PasteStartLine, ClipLines) then
    begin
      ClipLines := nil;
      Result := True;
    end;
  finally
    if Assigned(ClipLines) then
      ClipLines.Free;
  end;
end;

procedure TfrmMain.FocusPrimaryReadView;
begin
  if isChecked then
  begin
    if Assigned(FCheckListBox) and FCheckListBox.Visible and FCheckListBox.CanFocus then
      FCheckListBox.SetFocus;
  end
  else if Assigned(ListView1) and ListView1.Visible and ListView1.CanFocus then
    ListView1.SetFocus;
end;

function TfrmMain.IsReadPanelShortcutKey(const Key: Word; const Shift: TShiftState): Boolean;
begin
  Result := False;

  case Key of
    VK_F1, VK_F2, VK_F3, VK_F5, VK_F11, VK_HOME, VK_END, VK_ESCAPE:
      begin
        Result := True;
        Exit;
      end;
    VK_NUMPAD1:
      begin
        Result := (ssCtrl in Shift);
        Exit;
      end;
    Ord('1'):
      begin
        Result := (ssCtrl in Shift);
        Exit;
      end;
    VK_INSERT:
      begin
        Result := ((ssCtrl in Shift) and not (ssShift in Shift) and not (ssAlt in Shift)) or
                  ((ssShift in Shift) and not (ssCtrl in Shift) and not (ssAlt in Shift));
        Exit;
      end;
    { Virtual-key A..Z (VK_A..VK_Z): em KeyDown nao vem ASCII a..z.
      Nao usar Ord('a')..Ord('z') aqui: colide com VK_F1..VK_F12 no mesmo valor numerico. }
    Ord('A')..Ord('Z'):
      begin
        if (Key = Ord('R')) and (Shift = [ssAlt]) then
        begin
          Result := True;
          Exit;
        end;
        { Ctrl+V so entra no painel Read com foco na ListView/checklist; nao bloquear edits/memos. }
        if (Key = Ord('V')) and (ssCtrl in Shift) and not (ssAlt in Shift) then
        begin
          Result := ReadPanelPasteFocusActive;
          Exit;
        end;
        Result := (ssCtrl in Shift);
        Exit;
      end;
  end;
end;

procedure TfrmMain.ApplyReadPanelKey(var Key: Word; Shift: TShiftState);
var
  StartPos: Int64;
  CS: Boolean;
  BmRealLine: Int64;
  Line1Based: Integer;
  SavedCheckIdx: Integer;
begin
  if FHandlingReadShortcut then
  begin
    Key := 0;
    Exit;
  end;
  FHandlingReadShortcut := True;
  try
  { ESC: cancel background Find (antes de limpar filtro / selecao) }
  if (Key = VK_ESCAPE) and (Shift = []) and Assigned(FFindThread) then
  begin
    Inc(FFindSearchId);
    FFindThread.Terminate;
    FFindThread := nil;
    UpdateStatusBar(TrText('Search cancelled.'), iaRight);
    Key := 0;
    Exit;
  end;

  { Ctrl+1 / teclado numerico: mostrar separador Read file (btnShowTabReadFile) }
  if ((Key = Ord('1')) or (Key = VK_NUMPAD1)) and (Shift = [ssCtrl]) then begin
    if Assigned(btnShowTabReadFile) then btnShowTabReadFileClick(btnShowTabReadFile);
    Key := 0;
    Exit;
  end;

  { F11: com selecao em coluna (Ctrl/Alt+arrastar), estende ate a borda direita do texto; senao tela cheia. }
  if (Key = VK_F11) and (Shift = []) then begin
    if FHasSelection and (not FFindMatchSelection) then begin
      ExpandColumnBlockSelectionToContentWidth;
      Key := 0;
      Exit;
    end;
    ToggleFullScreenView;
    Key := 0;
    Exit;
  end;

  { Ctrl+Alt+M: marcas visíveis (tab/espaço/CR/LF/NUL/controle) }
  if (Key = Ord('M')) and (Shift = [ssCtrl, ssAlt]) then begin
    ToggleShowWhitespaceMarks;
    Key := 0;
    Exit;
  end;

  { F5: aba Ler; carrega so se edtFileName ja tiver caminho (sem dialogo). }
  if (Key = VK_F5) and (Shift = []) then begin
    DoF5ReadOrShowTab;
    Key := 0;
    Exit;
  end;

  { Ctrl+P: abrir menu Options (letra O = &Options na barra; Alt+O tambem) }
  if (Key = Ord('P')) and (Shift = [ssCtrl]) then begin
    EnsureReadTabVisible;
    PostMessage(Handle, WM_SYSCOMMAND, SC_KEYMENU, Ord('O'));
    Key := 0;
    Exit;
  end;

  { Barra pnlButtons: Ctrl+Shift+letra (sem Alt) }
  CS := (ssCtrl in Shift) and (ssShift in Shift) and not (ssAlt in Shift);
  if CS then begin
    case Key of
      Ord('X'), Ord('x'):
        begin
          if Assigned(btnClear) and btnClear.Enabled then btnClearClick(btnClear);
          Key := 0; Exit;
        end;
      Ord('K'), Ord('k'):
        begin
          if Assigned(btnSplitFiles) and btnSplitFiles.Enabled then btnSplitFilesClick(btnSplitFiles);
          Key := 0; Exit;
        end;
      Ord('M'), Ord('m'):
        begin
          if Assigned(btnMergeMultipleLines) and btnMergeMultipleLines.Enabled then btnMergeMultipleLinesClick(btnMergeMultipleLines);
          Key := 0; Exit;
        end;
      Ord('J'), Ord('j'):
        begin
          EnsureReadTabVisible;
          miMergeFilesClick(Self);
          Key := 0; Exit;
        end;
      Ord('P'), Ord('p'):
        begin
          EnsureReadTabVisible;
          miSplitEqualPartsClick(Self);
          Key := 0; Exit;
        end;
      Ord('Q'), Ord('q'):
        begin
          EnsureReadTabVisible;
          miSplitFileFractionClick(Self);
          Key := 0; Exit;
        end;
      Ord('S'), Ord('s'):
        begin
          if Assigned(btnCheckBoxes) and btnCheckBoxes.Enabled then btnCheckBoxesClick(btnCheckBoxes);
          Key := 0; Exit;
        end;
      Ord('I'), Ord('i'):
        begin
          if Assigned(btnEditFile) and btnEditFile.Enabled then editFile(otInsert);
          Key := 0; Exit;
        end;
      Ord('N'), Ord('n'):
        begin
          if Assigned(btnEditFile) and btnEditFile.Enabled then miInsertMultipleLinesClick(Self);
          Key := 0; Exit;
        end;
      Ord('U'), Ord('u'):
        begin
          if Assigned(btnEditFile) and btnEditFile.Enabled then editFile(otDuplicate);
          Key := 0; Exit;
        end;
      Ord('E'), Ord('e'):
        begin
          if Assigned(btnEditFile) and btnEditFile.Enabled then editFile(otEdit);
          Key := 0; Exit;
        end;
      Ord('D'), Ord('d'):
        begin
          if Assigned(btnEditFile) and btnEditFile.Enabled then editFile(otDelete);
          Key := 0; Exit;
        end;
      Ord('O'), Ord('o'):
        begin
          if Assigned(btnExport) and btnExport.Enabled then btnExportClick(btnExport);
          Key := 0; Exit;
        end;
      Ord('W'), Ord('w'):
        begin
          if Assigned(btnReturn) and btnReturn.Enabled and btnReturn.Visible then btnReturnClick(btnReturn);
          Key := 0; Exit;
        end;
      Ord('H'), Ord('h'):
        begin
          EnsureReadTabVisible;
          miCompareMergeHistoryClick(Self);
          Key := 0; Exit;
        end;
    end;
  end;

  // Ctrl+O -> Abrir arquivo (Browse) [somente Ctrl puro, sem Shift/Alt]
  if (Key = Ord('O')) and (Shift = [ssCtrl]) then begin
    with TOpenDialog.Create(nil) do try
      Filter := 'All files (*.*)|*.*';
      Options := [ofHideReadOnly, ofPathMustExist, ofFileMustExist, ofEnableSizing];
      if Execute then
      begin
        edtFileName.Text := FileName;
        OfferReadAfterBrowsePick(FileName);
      end;
    finally Free; end;
    Key := 0;
    Exit;
  end;

  { Ctrl+Alt+R -> sessao somente leitura (Ctrl+R fica para arquivos recentes) }
  if (Key = Ord('R')) and (Shift = [ssCtrl, ssAlt]) then begin
    miToggleReadOnlyClick(Self);
    Key := 0;
    Exit;
  end;

  { Atalhos de menu (Options/View) — necessarios com Menu=nil no F11 }
  if (ssCtrl in Shift) and (ssAlt in Shift) and not (ssShift in Shift) then begin
    case Key of
      Ord('A'), Ord('a'):
        begin
          miFastFileAssistantClick(Self);
          Key := 0; Exit;
        end;
      Ord('E'), Ord('e'):
        begin
          miScriptEngineClick(Self);
          Key := 0; Exit;
        end;
      Ord('S'), Ord('s'):
        begin
          miSaveSessionClick(Self);
          Key := 0; Exit;
        end;
      Ord('L'), Ord('l'):
        begin
          miLoadSessionClick(Self);
          Key := 0; Exit;
        end;
      Ord('V'), Ord('v'):
        begin
          miToggleCsvModeClick(Self);
          Key := 0; Exit;
        end;
      Ord('P'), Ord('p'):
        begin
          EnsureReadTabVisible;
          miSplitByPatternClick(Self);
          Key := 0; Exit;
        end;
      Ord('K'), Ord('k'):
        begin
          if Assigned(ActionSelectSkin) then
            ActionSelectSkin.Execute;
          Key := 0; Exit;
        end;
    end;
  end;

  { Alt+R -> tela recentes (popup no F11; aba completa fora do F11) }
  if (Key = Ord('R')) and (Shift = [ssAlt]) then begin
    if FFullScreenMode then
      ShowRecentFilesMenu
    else
      miShowRecentFilesTabClick(Self);
    Key := 0;
    Exit;
  end;

  // Ctrl+R -> Mostrar arquivos recentes [somente Ctrl, sem Shift/Alt]
  if (Key = Ord('R')) and (Shift = [ssCtrl]) then begin
    ShowRecentFilesMenu;
    Key := 0;
    Exit;
  end;

  // Ctrl+W -> Alternar Word Wrap (visual) [somente Ctrl]
  if (Key = Ord('W')) and (Shift = [ssCtrl]) then begin
    if Assigned(chkWordWrap) then begin
      chkWordWrap.Checked := not chkWordWrap.Checked;
      chkWordWrapClick(chkWordWrap);
    end;
    Key := 0;
    Exit;
  end;

  { Ctrl+Shift+F = Find in Files (antes de Ctrl+F, senao Shift cai em Find) }
  if (Key = Ord('F')) and (ssCtrl in Shift) and (ssShift in Shift) and not (ssAlt in Shift) then begin
    EnsureReadTabVisible;
    miFindInFilesClick(Self);
    Key := 0;
    Exit;
  end;

  // Ctrl+F -> Buscar
  if (Key = Ord('F')) and (ssCtrl in Shift) and not (ssShift in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoFindDialog;
    Key := 0;
    Exit;
  end;

  // Ctrl+H -> Find & Replace
  if (Key = Ord('H')) and (ssCtrl in Shift) and not (ssShift in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoFindReplace;
    Key := 0;
    Exit;
  end;

  // Ctrl+Shift+G -> Go to byte offset
  if (Key = Ord('G')) and (ssCtrl in Shift) and (ssShift in Shift) and not (ssAlt in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoGotoByteOffset;
    Key := 0;
    Exit;
  end;

  // Ctrl+G -> Ir para linha
  if (Key = Ord('G')) and (ssCtrl in Shift) and not (ssShift in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoGotoLine;
    Key := 0;
    Exit;
  end;

  // F3 / Shift+F3 -> Proximo / Anterior
  if (Key = VK_F3) then begin
    if Trim(FFindText) = '' then begin
      FastFileMessageBox(PChar(TrText('Use Ctrl+F first to define the search text.')),
        PChar(TrText('Search')), MB_OK or MB_ICONINFORMATION);
      Key := 0;
      Exit;
    end;
    if (not Assigned(FSourceFileStream)) or ListviewIsEmpty then begin
      Key := 0;
      Exit;
    end;
    if ssShift in Shift then begin
      StartPos := FLastFoundFilePos - 1;
      if StartPos < 0 then StartPos := 0;
      StartFindFromPos(StartPos, -1);
    end else begin
      if FLastFoundLine < 0 then
        StartPos := 0
      else
      begin
        StartPos := FLastFoundFilePos + 1;
        if StartPos < 0 then StartPos := 0;
      end;
      StartFindFromPos(StartPos, +1);
    end;
    Key := 0;
    Exit;
  end;

  // Ctrl+Z -> Undo
  if (Key = Ord('Z')) and (ssCtrl in Shift) and not (ssShift in Shift) and not (ssAlt in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoUndo;
    Key := 0;
    Exit;
  end;

  // Ctrl+Y ou Ctrl+Shift+Z -> Redo
  if (((Key = Ord('Y')) and (ssCtrl in Shift) and not (ssShift in Shift)) or
      ((Key = Ord('Z')) and (ssCtrl in Shift) and (ssShift in Shift))) and not (ssAlt in Shift) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    DoRedo;
    Key := 0;
    Exit;
  end;

  // Ctrl+C / Ctrl+Insert -> copiar linha/selecao no painel de leitura (ListView e checklist)
  if (((Key = Ord('C')) and (ssCtrl in Shift)) or
      ((Key = VK_INSERT) and (Shift = [ssCtrl]))) then begin
    { Modo checklist (Select): copiar a linha focada, mantendo o mesmo comportamento base do ListView. }
    if (not (ssShift in Shift)) and Assigned(FCheckListBox) and FCheckListBox.Visible and
       (Screen.ActiveControl = FCheckListBox) then
    begin
      if FHasSelection and FFindMatchSelection then
        CopyFindMatchSelectionToClipboard
      else if FHasSelection then
        CopyChecklistVerticalSelectionToClipboard
      else if existsCheckedRows(FCheckedLines) then
        CopyCheckedChecklistLinesToClipboard
      else if (FCheckListBox.ItemIndex >= 0) and
              (FCheckListBox.ItemIndex < FCheckListBox.Items.Count) then
      begin
        Line1Based := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]);
        if Line1Based > 0 then
          CopyFileLineToClipboard(Line1Based - 1);
      end;
      Key := 0;
      Exit;
    end;
    if Assigned(ListView1) and ((Screen.ActiveControl = ListView1) or ListView1.Focused) then
    begin
      if FHasSelection and FFindMatchSelection then
        CopyFindMatchSelectionToClipboard
      else if FHasSelection then
        CopyVerticalSelectionToClipboard
      else if ListView1.SelCount > 0 then
        CopyMultiSelectionToClipboard
      else if (ListView1.ItemIndex >= 0) and (not ListviewIsEmpty) and Assigned(FSourceFileStream) then
        CopyListViewFocusedLineToClipboard;
      Key := 0;
      Exit;
    end;
  end;

  { Ctrl+V: inserir linhas do clipboard (so com foco ListView/checklist; senao nao consome a tecla). }
  if (Key = Ord('V')) and (Shift = [ssCtrl]) and not (ssAlt in Shift) then begin
    if ReadPanelPasteFocusActive and DoPasteClipboardLinesAtSelection then
      Key := 0;
    Exit;
  end;

  { Shift+Insert: colar na linha selecionada (ListView/checklist) }
  if (Key = VK_INSERT) and (Shift = [ssShift]) then begin
    EnsureReadTabVisible;
    FocusPrimaryReadView;
    if DoPasteClipboardLinesAtSelection then
      Key := 0;
    Exit;
  end;

  { Ctrl+Shift+T -> Pause/Resume Tail (antes de Ctrl+T) }
  if (Key = Ord('T')) and (ssCtrl in Shift) and (ssShift in Shift) and not (ssAlt in Shift) then begin
    ToggleTailPause;
    Key := 0;
    Exit;
  end;

  { Ctrl+T -> Toggle Tail }
  if (Key = Ord('T')) and (Shift = [ssCtrl]) then begin
    ToggleTailMode;
    Key := 0;
    Exit;
  end;

  { Ctrl+Shift+L = Export tail session ou filtrados (antes de Ctrl+L) }
  if (Key = Ord('L')) and (ssCtrl in Shift) and (ssShift in Shift) and not (ssAlt in Shift) then begin
    EnsureReadTabVisible;
    ExportFilteredResults;
    Key := 0;
    Exit;
  end;

  // Ctrl+L -> Filter / Grep
  if (Key = Ord('L')) and (Shift = [ssCtrl]) then begin
    EnsureReadTabVisible;
    DoFilterDialog;
    Key := 0;
    Exit;
  end;

  // Ctrl+B -> Toggle Bookmark (Ctrl+Shift+B -> Clear All)
  if (Key = Ord('B')) and (ssCtrl in Shift) then begin
    if ssShift in Shift then ClearAllBookmarks
    else begin
      if isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0) then begin
        SavedCheckIdx := FCheckListBox.ItemIndex;
        Line1Based := Integer(FCheckListBox.Items.Objects[SavedCheckIdx]);
        if Line1Based > 0 then
        begin
          ToggleBookmark(Line1Based - 1);
          { Atualizar o prefixo '* Line:' na checklist apos alternar o marcador. }
          showChecked;
          if (SavedCheckIdx >= 0) and (SavedCheckIdx < FCheckListBox.Items.Count) then
            FCheckListBox.ItemIndex := SavedCheckIdx;
        end;
      end
      else if Assigned(ListView1) and (ListView1.ItemIndex >= 0) then begin
        BmRealLine := FileLineIndexFromListRow(ListView1.ItemIndex);
        if BmRealLine >= 0 then
          ToggleBookmark(Integer(BmRealLine));
      end;
    end;
    Key := 0;
    Exit;
  end;

  // F2 -> Next Bookmark / Shift+F2 -> Previous Bookmark
  if (Key = VK_F2) then begin
    if ssShift in Shift then GotoPrevBookmark
    else GotoNextBookmark;
    Key := 0;
    Exit;
  end;

  { Shift+Home / Ctrl+Home -> inicio (lista, filtro ou checklist; btnUpClick define o foco) }
  if (Key = VK_HOME) and ((ssShift in Shift) or (ssCtrl in Shift)) and not (ssAlt in Shift) then begin
    btnUpClick(Self);
    Key := 0;
    Exit;
  end;

  if (Key = VK_END) and ((ssShift in Shift) or (ssCtrl in Shift)) and not (ssAlt in Shift) then begin
    btnDownClick(Self);
    Key := 0;
    Exit;
  end;

  // F1 -> Help
  if (Key = VK_F1) and (Shift = []) then begin
    ShowHelpDialog;
    Key := 0;
    Exit;
  end;

  // Esc -> Clear filter or vertical selection
  if (Key = VK_ESCAPE) and (Shift = []) then begin
    if FFilterActive then begin
      ClearFilter;
      UpdateStatusBar(TrText('Filter cleared.'), iaRight);
      Key := 0;
      Exit;
    end;
    if FHasSelection then begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
      if Assigned(ListView1) and ListView1.Visible then
        ListView1.Repaint;
      if Assigned(FCheckListBox) and FCheckListBox.Visible then
        FCheckListBox.Invalidate;
      Key := 0;
      Exit;
    end;
  end;
  finally
    FHandlingReadShortcut := False;
  end;
end;

procedure TfrmMain.CMDialogKey(var Message: TCMDialogKey);
var
  Key: Word;
  Shift: TShiftState;
begin
  Key := Message.CharCode;
  Shift := KeyDataToShiftState(Message.KeyData);
  if FastFileAssistantPanelVisible and FastFileAssistantFocusInPanel(GetFocus) then
  begin
    if FastFileAssistantHandleEnter(Key, Shift) then
    begin
      Message.Result := 1;
      Exit;
    end;
    if FastFileAssistantHandleShortcut(Key, Shift) then
    begin
      Message.Result := 1;
      Exit;
    end;
    if (ssCtrl in Shift) and not (ssShift in Shift) and not (ssAlt in Shift) and
       ((Key = Ord('X')) or (Key = Ord('x')) or (Key = Ord('V')) or (Key = Ord('v'))) then
    begin
      Message.Result := 1;
      Exit;
    end;
  end;
  { Filter/Grep: Enter in pattern box = Apply (ComboBox dialog-key path). }
  if (Key = VK_RETURN) and (Shift = []) and Assigned(FFilterBar) and
     FFilterBar.Visible and FFilterBar.PatternEditFocused then
  begin
    FilterBarApply(FFilterBar, FFilterBar.GetPattern);
    Message.Result := 1;
    Exit;
  end;
  inherited;
end;

procedure TfrmMain.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
const
  showOtherTabs: Boolean = True;
var
  FocusHwnd: HWND;
begin
  { Script panel memos: intercept Ctrl+C/V/A/T and Ctrl+Insert/Shift+Insert
    before global Read-panel shortcuts, using GetFocus for reliable detection. }
  if (((ssCtrl in Shift) and not (ssAlt in Shift) and
       ((Key = Ord('C')) or (Key = Ord('V')) or (Key = Ord('A')) or (Key = Ord('T')))) or
      ((Key = VK_INSERT) and ((Shift = [ssCtrl]) or (Shift = [ssShift])))) then
  begin
    FocusHwnd := GetFocus;
    if Assigned(FScriptSuggestionsMemo) and
       (FocusHwnd = FScriptSuggestionsMemo.Handle) then
    begin
      ScriptPanelMemoKeyDown(FScriptSuggestionsMemo, Key, Shift);
      Key := 0;
      Exit;
    end;

    if Assigned(FScriptEditorMemo) and
       (FocusHwnd = FScriptEditorMemo.Handle) then
    begin
      ScriptPanelMemoKeyDown(FScriptEditorMemo, Key, Shift);
      Key := 0;
      Exit;
    end;

    if Assigned(FScriptOutputMemo) and
       (FocusHwnd = FScriptOutputMemo.Handle) then
    begin
      ScriptPanelMemoKeyDown(FScriptOutputMemo, Key, Shift);
      Key := 0;
      Exit;
    end;
  end;

  { Assistente IA: atalhos do ficheiro (Ctrl+H replace, Ctrl+L filtro, Ctrl+V colar linhas, etc.)
    quando o foco esta no painel do assistente — antes do roteamento geral do Read. }
  if FastFileAssistantPanelVisible and FastFileAssistantFocusInPanel(GetFocus) then
  begin
    if FastFileAssistantHandleEnter(Key, Shift) then
      Exit;
    { Assistente: Ctrl+V cola no memo; Ctrl+X corta no memo (nao Sair/Fechar global). }
    if FastFileAssistantHandleShortcut(Key, Shift) then
      Exit;
    if ((Key = Ord('V')) and (Shift = [ssCtrl])) or
       ((Key = VK_INSERT) and (Shift = [ssShift])) or
       (((Key = Ord('X')) or (Key = Ord('x'))) and (Shift = [ssCtrl]) and
         not (ssShift in Shift) and not (ssAlt in Shift)) then
    begin
      Key := 0;
      Exit;
    end;
  end;

  { KeyPreview: o Form recebe antes do controle focado. Tratar atalhos do Help aqui
    tambem com foco em CheckList/ListView (antes havia Exit e Ctrl+F nao fazia nada). }
  if (Key <> 0) and IsReadPanelShortcutKey(Key, Shift) then
    ApplyReadPanelKey(Key, Shift);

  { ESC tambem fecha a aba ativa no pgMain quando nao foi consumido
    (ex.: sem filtro/sele??o no painel Read). }
  if (Key = VK_ESCAPE) and (Shift = []) and Assigned(pgMain) then
  begin
    if pgMain.Visible and (pgMain.PageCount > 0)
      and Assigned(pgMain.ActivePage) and pgMain.ActivePage.TabVisible then
    begin
      if pgMain.ActivePageIndex = TAB_READ_FILE_INDEX then
        CloseReadFileTabAndAssistant
      else
        HideTabs(showOtherTabs);
      Key := 0;
    end
    else if not pgMain.Visible then
    begin
      { Painel de abas oculto: ESC fecha a aplicacao (FormCloseQuery continua a aplicar). }
      Close;
      Key := 0;
    end;
  end;
end;


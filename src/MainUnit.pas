  if not Assigned(FScriptExportBannerPanel) then Exit;
  if Assigned(FScriptExportDismissBtn) then
  begin
    FScriptExportDismissBtn.Caption := '×';
    FScriptExportDismissBtn.Hint := TrText('Close');
  end;
  if Assigned(FScriptExportOpenFileBtn) then
  begin
    FScriptExportOpenFileBtn.Caption := TrText('Open file');
    FitSpeedButtonWidth(FScriptExportOpenFileBtn, 100, 18);
  end;
  if Assigned(FScriptExportOpenFolderBtn) then
  begin
    FScriptExportOpenFolderBtn.Caption := TrText('SCRIPT_EXPORT_OPEN_FOLDER');
    FitSpeedButtonWidth(FScriptExportOpenFolderBtn, 100, 18);
  end;
  if Assigned(FScriptExportCopyPathBtn) then
  begin
    FScriptExportCopyPathBtn.Caption := TrText('SCRIPT_EXPORT_COPY_PATH');
    FitSpeedButtonWidth(FScriptExportCopyPathBtn, 100, 18);
  end;
  if (FScriptExportNoticePath <> '') and Assigned(FScriptExportBannerPanel) and
     FScriptExportBannerPanel.Visible then
  begin
    if Assigned(FScriptExportTitleLabel) then
    begin
      if FileExists(FScriptExportNoticePath) then
        FScriptExportTitleLabel.Caption := TrText('SCRIPT_EXPORT_SAVED_TITLE')
      else
        FScriptExportTitleLabel.Caption := TrText('SCRIPT_EXPORT_WRITING_TITLE');
    end;
    if Assigned(FScriptExportFileLabel) then
      FScriptExportFileLabel.Caption := Format(TrText('SCRIPT_EXPORT_FILE_LINE'),
        [ExtractFileName(FScriptExportNoticePath)]);
    if Assigned(FScriptExportDirLabel) then
    begin
      if ExtractFileDir(FScriptExportNoticePath) <> '' then
        FScriptExportDirLabel.Caption := Format(TrText('SCRIPT_EXPORT_FOLDER_LINE'),
          [FastFileShortenPathForUi(ExtractFileDir(FScriptExportNoticePath), 48)])
      else
        FScriptExportDirLabel.Caption := '';
    end;
    FScriptExportBannerPanel.Hint := FScriptExportNoticePath;
    if Assigned(FScriptExportTitleLabel) then
      FScriptExportTitleLabel.Hint := FScriptExportNoticePath;
    if Assigned(FScriptExportFileLabel) then
      FScriptExportFileLabel.Hint := FScriptExportNoticePath;
    if Assigned(FScriptExportDirLabel) then
      FScriptExportDirLabel.Hint := FScriptExportNoticePath;
  end;
end;


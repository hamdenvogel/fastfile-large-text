procedure TfrmMain.AssistantCbExportLines(const ALineParams: string; const ASourcePath: string);
var
  Params, OutFile, OutDir, Src, Cur: string;
  St: TAssistantChainStep;
  Pending: array[0..0] of TAssistantChainStep;
  AlreadyReady: Boolean;
begin
  EnsureReadTabVisible;
  Params := Trim(ALineParams);
  Src := Trim(ASourcePath);
  if Src = SELECTTEXT then Src := '';
  Cur := Trim(CurrentEffectiveFilePath);
  if Cur = SELECTTEXT then Cur := '';
  if Src = '' then
  begin
    Src := Cur;
    if Src = '' then
      Src := Trim(edtFileName.Text);
    if Src = SELECTTEXT then Src := '';
  end;

  AlreadyReady := (totalLines > 0) and (Src <> '') and FileExists(Src) and
    (SameFileName(Src, Cur) or SameFileName(Src, Trim(fFileName)));

  if not AlreadyReady then
  begin
    if (Src = '') or (not FileExists(Src)) then
    begin
      if Src <> '' then
        FastFileMessageBox(PChar(TrText('Assistant.Error.FileNotFound') + #13#10 + Src),
          PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING)
      else
        FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
          PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
      Exit;
    end;
    if Params = '' then
    begin
      AssistantCbOpenFile(Src);
      Exit;
    end;
    FillChar(St, SizeOf(St), 0);
    St.ActionId := 'export_lines';
    St.FilterText := Params;
    St.Path := Src;
    Pending[0] := St;
    AssistantHostSetChain(Pending, 1, True);
    AssistantCbOpenFile(Src);
    Exit;
  end;

  if Params = '' then
  begin
    AssistantCbExportFile;
    Exit;
  end;
  OutFile := SuggestAssistantExportPath;
  OutDir := ExtractFilePath(OutFile);
  if (OutDir <> '') and (not DirectoryExists(OutDir)) then
    ForceDirectories(OutDir);
  AssistantHostSetLastExportPath(OutFile);
  TExportFileThread.Create(Params, True, OutFile, edtFileName.Text, totalLines);
  UpdateStatusBar(Format(TrText('Assistant.Status.ExportLinesDetail'),
    [Params, OutFile]), iaRight);
  AssistantHostNotifyGeneratedFile(OutFile);
end;


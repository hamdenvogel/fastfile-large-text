procedure TfrmMain.MergeFilesTabConfirm(Sender: TObject);
var
  Frm: TMergeFilesDialogForm;
  SourceFileName, DestFileName: String;
  MergeMode: TMergeFilesMode;
  InsertAfterLine: Int64;
  FromLine, ToLine: Int64;
  SourceLineCount: Int64;
  Dir, Stem, Ext: string;
  PartNum: Integer;
  SelfMerge: Boolean;
begin
  if not Assigned(FMergeFilesHosted) then Exit;
  Frm := TMergeFilesDialogForm(FMergeFilesHosted);
  DestFileName := '';
  if Assigned(Frm.EdtDest) then
    DestFileName := Trim(Frm.EdtDest.Text);
  SelfMerge := Assigned(Frm.ChkSelfMerge) and Frm.ChkSelfMerge.Checked;
  if SelfMerge then
    SourceFileName := DestFileName
  else
    SourceFileName := Trim(Frm.EdtSource.Text);
  MergeMode := mfmBeginning;
  InsertAfterLine := 1;
  FromLine := 1;
  ToLine := 1;

  if SelfMerge and (DestFileName = '') then
  begin
    ShowAppMessage(TrText('Please select/read the destination file first.'));
    Exit;
  end;

  if Trim(SourceFileName) = '' then
  begin
    ShowAppMessage(TrText('Source file is required.'));
    Exit;
  end;

  { Reunite equal-split parts: source = any .partNNN file -> concat all siblings. }
  if TryParseEqualSplitPartPath(SourceFileName, Dir, Stem, Ext, PartNum) then
  begin
    if DestFileName = '' then
      DestFileName := SuggestJoinPartsDestPath(Dir, Stem, Ext);
    if Assigned(Frm.EdtDest) then
      Frm.EdtDest.Text := DestFileName;
    if DoJoinEqualSplitParts(DestFileName, Dir, Stem, Ext) then
      CloseActiveTabSheet;
    Exit;
  end;

  if DestFileName = '' then
  begin
    ShowAppMessage(TrText('Please select/read the destination file first.'));
    Exit;
  end;

  if (not SelfMerge) and SameText(ExpandFileName(DestFileName), ExpandFileName(SourceFileName)) then
  begin
    ShowAppMessage(TrText('Source and destination files must be different.'));
    Exit;
  end;

  if Frm.ChkLineRange.Checked then
  begin
    if Trim(Frm.EdtFromLine.Text) = '' then begin ShowAppMessage(TrText('Error: "From line" cannot be empty.')); Exit; end;
    if Trim(Frm.EdtToLine.Text) = '' then begin ShowAppMessage(TrText('Error: "To line" cannot be empty.')); Exit; end;
    if not TryStrToInt64(Trim(Frm.EdtFromLine.Text), FromLine) then begin ShowAppMessage(TrText('Error: "From line" must be a valid number.')); Exit; end;
    if not TryStrToInt64(Trim(Frm.EdtToLine.Text), ToLine) then begin ShowAppMessage(TrText('Error: "To line" must be a valid number.')); Exit; end;
    if FromLine < 1 then begin ShowAppMessage(TrText('Error: "From line" must be at least 1.')); Exit; end;
    if ToLine < 1 then begin ShowAppMessage(TrText('Error: "To line" must be at least 1.')); Exit; end;
    if FromLine > ToLine then
    begin
      ShowAppMessage(Format(TrText('Error: "From line" (%d) cannot be greater than "To line" (%d).'),
        [FromLine, ToLine]));
      Exit;
    end;
    if not FileExists(SourceFileName) then
    begin
      ShowAppMessage(Format(TrText('Error: Source file not found: %s'), [SourceFileName]));
      Exit;
    end;
    SourceLineCount := CountLinesInFile(SourceFileName);
    if SourceLineCount < 0 then
    begin
      ShowAppMessage(TrText('Error: Could not read source file to validate line count.'));
      Exit;
    end;
    if FromLine > SourceLineCount then
    begin
      ShowAppMessage(Format(TrText('Error: "From line" (%d) exceeds total lines in source file (%d).'),
        [FromLine, SourceLineCount]));
      Exit;
    end;
    if ToLine > SourceLineCount then
    begin
      ShowAppMessage(Format(TrText('Error: "To line" (%d) exceeds total lines in source file (%d).'),
        [ToLine, SourceLineCount]));
      Exit;
    end;
    MergeMode := mfmLineRange;
  end
  else
  begin
    case Frm.RgMode.ItemIndex of
      1: MergeMode := mfmAfterLine;
      2: MergeMode := mfmEnd;
    else
      MergeMode := mfmBeginning;
    end;
    InsertAfterLine := Frm.SpnLine.Value;
  end;

  if DoMergeFilesFromDialog(DestFileName, SourceFileName, MergeMode, InsertAfterLine, FromLine, ToLine) then
    CloseActiveTabSheet;
end;

procedure TfrmMain.MergeFilesAskAIClick(Sender: TObject);
var
  Frm: TMergeFilesDialogForm;
  DestPath, SourcePath, LineRange, MergePosition, Prompt: string;
begin
  if not Assigned(FMergeFilesHosted) then Exit;
  Frm := TMergeFilesDialogForm(FMergeFilesHosted);
  DestPath := '';
  SourcePath := '';
  if Assigned(Frm.EdtDest) then
    DestPath := Trim(Frm.EdtDest.Text);
  if Assigned(Frm.EdtSource) then
    SourcePath := Trim(Frm.EdtSource.Text);
  if Assigned(Frm.ChkSelfMerge) and Frm.ChkSelfMerge.Checked then
    SourcePath := DestPath;

  if Assigned(Frm.ChkLineRange) and Frm.ChkLineRange.Checked then
    LineRange := Trim(Frm.EdtFromLine.Text) + '..' + Trim(Frm.EdtToLine.Text)
  else

constructor TBatchDeleteLinesThread.Create(const AFileName: string; const ALines: TInt64DynArray);
var
  i: Integer;
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FFileName := AFileName;
  SetLength(FLines, Length(ALines));
  for i := 0 to High(ALines) do
    FLines[i] := ALines[i];
  FErrorMsg := '';
  FOk := False;
end;

procedure TBatchDeleteLinesThread.Execute;
begin
  FOk := BatchDeleteLinesByMMF(FFileName, FLines, FErrorMsg, FNewLineCount);
end;

constructor TSegmentedDeleteLinesThread.Create(const AFileName, AIdxPath: string; const ALines: TInt64DynArray);
var
  i: Integer;
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FFileName := AFileName;
  FIdxPath := AIdxPath;
  SetLength(FLines, Length(ALines));
  for i := 0 to High(ALines) do
    FLines[i] := ALines[i];
  FErrorMsg := '';
  FSegOk := False;
end;

procedure TSegmentedDeleteLinesThread.Execute;
begin
  FSegOk := TrySegmentedBatchDelete(FFileName, FIdxPath, FLines, 250000, FErrorMsg);
end;

constructor TSplitPatternAISuggestThread.Create(AOwner: TfrmMain; const APrompt: WideString);
begin
  inherited Create(True);
  FreeOnTerminate := True;
  FOwner := AOwner;
  FPrompt := APrompt;
  FOk := False;
  FAns := '';
  FErr := '';
end;

procedure TSplitPatternAISuggestThread.Execute;
begin
  FOk := FastFileAIInvokePrompt(FPrompt, FAns, FErr);
  Synchronize(UISync);
end;

procedure TSplitPatternAISuggestThread.UISync;
begin
  if Assigned(FOwner) then
    FOwner.ApplySplitPatternAISuggestResult(FOk, FAns, FErr);
end;

function RunBatchDeleteLinesWait(const AFileName: string; const ALines: TInt64DynArray;
  out AErrorMsg: string; out ANewLineCount: Int64): Boolean;
var
  Th: TBatchDeleteLinesThread;
  H: THandle;
  Wr: DWORD;
  Handles: array[0..0] of THandle;
begin
  Result := False;
  AErrorMsg := '';
  ANewLineCount := 0;
  Th := TBatchDeleteLinesThread.Create(AFileName, ALines);
  try
    Th.Resume;
    H := 0;
    while True do
    begin
      if H = 0 then
        H := Th.Handle;
      if H <> 0 then
      begin
        Handles[0] := H;
        Wr := MsgWaitForMultipleObjects(1, Handles, False, 80, QS_ALLINPUT);
        if Wr = WAIT_OBJECT_0 then
          Break;
        if Wr = WAIT_FAILED then
        begin
          Wr := WaitForSingleObject(H, 0);
          if Wr = WAIT_OBJECT_0 then
            Break;
        end;
      end;
      Application.ProcessMessages;
      while CheckSynchronize do;
      if H = 0 then
        Sleep(2);
    end;
    Result := Th.Ok;
    AErrorMsg := Th.ErrorMsg;
    ANewLineCount := Th.NewLineCount;
  finally
    Th.Free;
  end;
end;

function RunSegmentedDeleteLinesWait(const AFileName, AIdxPath: string;
  const ALines: TInt64DynArray; out ASegOk: Boolean; out AErrorMsg: string): Boolean;
var
  Th: TSegmentedDeleteLinesThread;
  H: THandle;
  Wr: DWORD;
  Handles: array[0..0] of THandle;
begin
  Result := False;
  ASegOk := False;
  AErrorMsg := '';
  Th := TSegmentedDeleteLinesThread.Create(AFileName, AIdxPath, ALines);
  try
    Th.Resume;
    H := 0;
    while True do
    begin
      if H = 0 then
        H := Th.Handle;
      if H <> 0 then
      begin
        Handles[0] := H;
        Wr := MsgWaitForMultipleObjects(1, Handles, False, 80, QS_ALLINPUT);
        if Wr = WAIT_OBJECT_0 then
          Break;
        if Wr = WAIT_FAILED then
        begin
          Wr := WaitForSingleObject(H, 0);
          if Wr = WAIT_OBJECT_0 then
            Break;
        end;
      end;
      Application.ProcessMessages;
      while CheckSynchronize do;
      if H = 0 then
        Sleep(2);
    end;
    ASegOk := Th.SegOk;
    AErrorMsg := Th.ErrorMsg;
    Result := True;
  finally
    Th.Free;
  end;
end;

procedure ShowAppMessage(const Msg: string);
var
  Kind: TFastFileNoticeKind;
  Key, Title, Body: string;
begin
  Key := Trim(Msg);
  Body := TrText(Key);
  if (Pos('Error', Key) = 1) or (Pos('Could not', Key) = 1) or
     (Pos('Erro', Key) = 1) then
  begin
    Kind := fnkWarning;
    Title := TrText('Error');
  end
  else if (Pos('saved', LowerCase(Key)) > 0) or (Pos('copied', LowerCase(Key)) > 0) or
          (Pos('success', LowerCase(Key)) > 0) or (Pos('finished', LowerCase(Key)) > 0) or
          (Pos('salvo', LowerCase(Key)) > 0) then
  begin
    Kind := fnkSuccess;
    Title := TrText('Information');
  end
  else
  begin
    Kind := fnkInfo;
    Title := TrText('Information');
  end;
  if Assigned(frmMain) and frmMain.HandleAllocated then
    ShowFastFileAppNotice(frmMain, Kind, Title, Body)
  else
    FastFileMsgInfo(Body);
end;


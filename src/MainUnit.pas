procedure TfrmMain.LoadRecentFiles;
var
  Ini: TIniFile;
  I, Cnt: Integer;
begin
  FRecentFiles.Clear;
  if Assigned(FRecentFilesLastOpened) then
    FRecentFilesLastOpened.Clear;
  if not FileExists(FRecentFilesIni) then Exit;
  Ini := TIniFile.Create(FRecentFilesIni);
  try
    Cnt := Ini.ReadInteger('RecentFiles', 'Count', 0);
    for I := 0 to Cnt - 1 do
    begin
      FRecentFiles.Add(Ini.ReadString('RecentFiles', 'File' + IntToStr(I), ''));
      if Assigned(FRecentFilesLastOpened) then
        FRecentFilesLastOpened.Add(Ini.ReadString('RecentFiles', 'LastOpened' + IntToStr(I), ''));
    end;

    if Assigned(FRecentFilesLastOpened) then
    begin
      while FRecentFilesLastOpened.Count < FRecentFiles.Count do
        FRecentFilesLastOpened.Add('');
      while FRecentFilesLastOpened.Count > FRecentFiles.Count do
        FRecentFilesLastOpened.Delete(FRecentFilesLastOpened.Count - 1);
    end;
  finally
    Ini.Free;
  end;
  PopulateRecentFilesTab;
end;

procedure TfrmMain.SaveRecentFiles;
var
  Ini: TIniFile;
  I: Integer;
begin
  if not Assigned(FRecentFiles) then Exit;
  Ini := TIniFile.Create(FRecentFilesIni);
  try
    Ini.EraseSection('RecentFiles');
    Ini.WriteInteger('RecentFiles', 'Count', FRecentFiles.Count);
    for I := 0 to FRecentFiles.Count - 1 do
    begin
      Ini.WriteString('RecentFiles', 'File' + IntToStr(I), FRecentFiles[I]);
      if Assigned(FRecentFilesLastOpened) and (I < FRecentFilesLastOpened.Count) then
        Ini.WriteString('RecentFiles', 'LastOpened' + IntToStr(I), FRecentFilesLastOpened[I])
      else
        Ini.WriteString('RecentFiles', 'LastOpened' + IntToStr(I), '');
    end;
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.AddToRecentFiles(const AFileName: String);
var
  Idx: Integer;
  Stamp: string;
begin
  if not Assigned(FRecentFiles) then Exit;
  if Trim(AFileName) = '' then Exit;

  if not Assigned(FRecentFilesLastOpened) then
    FRecentFilesLastOpened := TStringList.Create;
  while FRecentFilesLastOpened.Count < FRecentFiles.Count do
    FRecentFilesLastOpened.Add('');

  Stamp := FormatDateTime('yyyy-mm-dd  hh:nn', Now);
  // Remove duplicate if exists
  Idx := FRecentFiles.IndexOf(AFileName);
  if Idx >= 0 then
  begin
    FRecentFiles.Delete(Idx);
    if Idx < FRecentFilesLastOpened.Count then
      FRecentFilesLastOpened.Delete(Idx);
  end;
  // Insert at top
  FRecentFiles.Insert(0, AFileName);
  FRecentFilesLastOpened.Insert(0, Stamp);
  // Limit to 25
  while FRecentFiles.Count > 25 do
  begin
    FRecentFiles.Delete(FRecentFiles.Count - 1);
    if FRecentFilesLastOpened.Count > 0 then
      FRecentFilesLastOpened.Delete(FRecentFilesLastOpened.Count - 1);
  end;
  SaveRecentFiles;
  PopulateRecentFilesTab;
end;


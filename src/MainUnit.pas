procedure TfrmMain.AssistantCbFindFirst(const AText: string; ACaseSensitive: Boolean);
var
  Txt: string;
  St: TAssistantChainStep;
begin
  EnsureReadTabVisible;
  Txt := Trim(AText);
  if Txt = '' then
  begin
    FastFileMessageBox(PChar(TrText('Enter search text.')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  FillChar(St, SizeOf(St), 0);
  St.ActionId := 'find_text';
  St.FilterText := Txt;
  St.CaseSensitive := ACaseSensitive;
  if AssistantCbTryDeferUntilLoaded(St) then Exit;
  FFindText := Txt;
  FFindCaseSensitive := ACaseSensitive;
  FFindOccAssistantOffered := False;
  FFindOccOfferShown := False;
  FLastFoundLine := -1;
  FLastFoundFilePos := 0;
  FFindMatchSelection := False;
  if Assigned(FFindOccBar) then
    FFindOccBar.SetSearchText(Txt);
  if not HasLineSearchIndex then
  begin
    if TryStartAutoIndexForSearch then Exit;
  end;
  StartFindFromPos(0, +1);
end;

procedure TfrmMain.AssistantCbEditLine(ALineNo: Integer);
var
  RowIdx: Integer;
begin
  EnsureReadTabVisible;
  if not AssistantCbHasOpenFile then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.NoFileOpen')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if ALineNo < 1 then
  begin
    miEditLineClick(Self);
    Exit;
  end;
  AssistantCbGotoLine(ALineNo);
  if isChecked and Assigned(FCheckListBox) then
    editFile(otEdit)
  else
  begin
    RowIdx := ListView1.ItemIndex;
    if RowIdx < 0 then Exit;
    editFile(otEdit, RowIdx);
  end;
end;

function TfrmMain.AssistantPromptSelectSourceFile(const ATitleKey: string): string;
var
  OD: TOpenDialog;
  TitleKey: string;
begin
  Result := '';
  TitleKey := Trim(ATitleKey);
  if TitleKey = '' then
    TitleKey := 'Assistant.Prompt.SelectFileToSplit';
  OD := TOpenDialog.Create(Self);
  try
    OD.Title := TrText(TitleKey);
    OD.Filter := TrText('All files (*.*)|*.*');
    OD.Options := OD.Options + [ofFileMustExist, ofPathMustExist, ofEnableSizing];
    if OD.Execute then
      Result := Trim(OD.FileName);
  finally
    OD.Free;
  end;
end;

procedure TfrmMain.AssistantCbSplitEqual(const ASourcePath: string; AParts: Integer);
var
  Src: string;
begin
  if AParts < 2 then
  begin
    FastFileMessageBox(PChar(TrText('Assistant.Error.PartsRange')),
      PChar(TrText('Assistant.Title')), MB_OK or MB_ICONWARNING);
    Exit;
  end;
  Src := Trim(ASourcePath);
  if Src = '' then
  begin
    Src := Trim(edtFileName.Text);
    if (Src = SELECTTEXT) or (Src = '') then
      Src := Trim(CurrentEffectiveFilePath);
  end;
  if (Src = '') or (not FileExists(Src)) then
  begin
    { Nenhum arquivo aberto / path invalido: perguntar qual arquivo dividir. }
    Src := AssistantPromptSelectSourceFile;
    if (Src = '') or (not FileExists(Src)) then
    begin

procedure TfrmMain.ApplyStoredMergeDelta(const ADeltaText: string);
var
  DeltaFile: string;
  SL: TStringList;
begin
  if Trim(ADeltaText) = '' then Exit;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  SL := TStringList.Create;
  try
    SL.Text := ADeltaText;
    DeltaFile := FastFileTempPath('mdelta_undo.dlt');
    SL.SaveToFile(DeltaFile);
    if not ConfirmDiskSpaceForMergeLines(CurrentEffectiveFilePath) then
      Exit;
  finally
    SL.Free;
  end;
  CloseFileStreams;
  TMergeDeltaThread.Create(CurrentEffectiveFilePath, DeltaFile, True, True);
end;

procedure TfrmMain.PrepareMergeDeltaUndo(const DeltaLines: TStringList);
var
  i, ColonPos: Integer;
  sLine, NewText, OldText: string;
  LineNum: Int64;
  Fwd, Inv: TStringList;
begin
  FPendingMergeDeltaForward := '';
  FPendingMergeDeltaInverse := '';
  FPendingMergeDeltaUndo := False;
  FPendingMergeDeltaLineCount := 0;
  FPendingMergeDeltaFirstLine := 0;
  if (DeltaLines = nil) or (DeltaLines.Count = 0) then Exit;
  Fwd := TStringList.Create;
  Inv := TStringList.Create;
  try
    for i := 0 to DeltaLines.Count - 1 do
    begin
      sLine := Trim(DeltaLines[i]);
      if sLine = '' then Continue;
      ColonPos := PosBMH(':', sLine);
      if ColonPos <= 0 then Continue;
      LineNum := StrToInt64Def(Trim(Copy(sLine, 1, ColonPos - 1)), -1);
      if LineNum <= 0 then Continue;
      NewText := Copy(sLine, ColonPos + 1, MaxInt);
      if (Length(NewText) > 0) and (NewText[1] = ' ') then
        NewText := Copy(NewText, 2, MaxInt);
      if FPendingMergeDeltaFirstLine = 0 then
        FPendingMergeDeltaFirstLine := LineNum;
      OldText := GetLineContent(LineNum - 1);
      Fwd.Add(IntToStr(LineNum) + ': ' + NewText);
      Inv.Add(IntToStr(LineNum) + ': ' + OldText);
    end;
    if Fwd.Count > 0 then
    begin
      FPendingMergeDeltaForward := Fwd.Text;
      FPendingMergeDeltaInverse := Inv.Text;
      FPendingMergeDeltaLineCount := Fwd.Count;
      FPendingMergeDeltaUndo := True;
    end;
  finally
    Fwd.Free;
    Inv.Free;
  end;
end;

procedure TfrmMain.CommitPendingMergeDeltaUndoIfNeeded(const ASuccess: Boolean);
var
  P: PUndoRecord;
  I: Integer;
  FirstEx, LastEx: string;
  Parts: TStringList;
begin
  if not FPendingMergeDeltaUndo then Exit;
  if not ASuccess then
  begin
    FPendingMergeDeltaForward := '';
    FPendingMergeDeltaInverse := '';
    FPendingMergeDeltaUndo := False;
    Exit;
  end;
  try
    Parts := TStringList.Create;
    try
      Parts.Text := FPendingMergeDeltaForward;
      if Parts.Count > 0 then
      begin
        FirstEx := Parts[0];
        LastEx := Parts[Parts.Count - 1];
        if PosBMH(': ', FirstEx) > 0 then
          FirstEx := Copy(FirstEx, PosBMH(': ', FirstEx) + 2, MaxInt);
        if PosBMH(': ', LastEx) > 0 then
          LastEx := Copy(LastEx, PosBMH(': ', LastEx) + 2, MaxInt);
        FFHistoryAppendMergeDelta(CurrentEffectiveFilePath,
          FPendingMergeDeltaLineCount, FPendingMergeDeltaFirstLine,
          FirstEx, LastEx);
      end;
    finally
      Parts.Free;
    end;
    if not Assigned(FUndoStack) then FUndoStack := TList.Create;
    New(P);
    P^.Op := 3;
    P^.BatchKind := 4;
    P^.Line := FPendingMergeDeltaFirstLine;
    P^.OldContent := FPendingMergeDeltaInverse;
    P^.NewContent := FPendingMergeDeltaForward;
    FUndoStack.Add(P);
    while FUndoStack.Count > 100 do
    begin
      Dispose(PUndoRecord(FUndoStack[0]));
      FUndoStack.Delete(0);
    end;
    if Assigned(FRedoStack) then
    begin
      for I := 0 to FRedoStack.Count - 1 do
        Dispose(PUndoRecord(FRedoStack[I]));
      FRedoStack.Clear;
    end;
  finally
    FPendingMergeDeltaForward := '';
    FPendingMergeDeltaInverse := '';
    FPendingMergeDeltaUndo := False;
  end;
end;

procedure TfrmMain.PrepareMergeFilesUndo(const ADest, ASource, ADetail: string);
begin
  FPendingMergeFilesUndo := True;
  FPendingMergeFilesDest := ADest;
  FPendingMergeFilesSource := ASource;
  FPendingMergeFilesDetail := ADetail;
  FPendingMergeFilesBackup := '';
end;

procedure TfrmMain.CommitPendingMergeFilesUndoIfNeeded(const ASuccess: Boolean;
  const ADest, ASource, ABackupPath: string);
var
  P: PUndoRecord;
  I: Integer;
begin
  if not FPendingMergeFilesUndo then Exit;
  if not ASuccess then
  begin
    if (ABackupPath <> '') and FileExists(ABackupPath) then
      DeleteFile(ABackupPath);
    FPendingMergeFilesUndo := False;
    Exit;
  end;
  try
    FFHistoryAppendMergeFiles(ADest, ASource, FPendingMergeFilesDetail);
    if (ABackupPath <> '') and FileExists(ABackupPath) then
    begin
      if not Assigned(FUndoStack) then FUndoStack := TList.Create;
      New(P);
      P^.Op := 3;
      P^.BatchKind := 5;
      P^.Line := 1;
      P^.OldContent := ABackupPath;
      P^.NewContent := ADest;
      FUndoStack.Add(P);
      while FUndoStack.Count > 100 do
      begin
        Dispose(PUndoRecord(FUndoStack[0]));
        FUndoStack.Delete(0);
      end;
      if Assigned(FRedoStack) then
      begin
        for I := 0 to FRedoStack.Count - 1 do
          Dispose(PUndoRecord(FRedoStack[I]));
        FRedoStack.Clear;
      end;
    end;
  finally
    FPendingMergeFilesUndo := False;
    FPendingMergeFilesBackup := '';
    FPendingMergeFilesDest := '';
    FPendingMergeFilesSource := '';
    FPendingMergeFilesDetail := '';
  end;
end;

procedure TfrmMain.RecordBatchInsertForUndo(const AStartLine: Int64; ALines: TStringList);
var
  P: PUndoRecord;
  I: Integer;
  Stored: TStringList;
begin
  if (ALines = nil) or (ALines.Count = 0) then Exit;
  if not Assigned(FUndoStack) then FUndoStack := TList.Create;
  Stored := TStringList.Create;
  try
    Stored.Assign(ALines);
    if FPendingBatchInsertKind = 0 then
      TrimTrailingEmptyClipboardLines(Stored);
    if Stored.Count = 0 then Exit;
    New(P);
    P^.Op := 3;
    P^.Line := AStartLine;
    P^.OldContent := IntToStr(Stored.Count);
    P^.NewContent := Stored.Text;
    P^.BatchKind := FPendingBatchInsertKind;
    FUndoStack.Add(P);
    while FUndoStack.Count > 100 do begin
      Dispose(PUndoRecord(FUndoStack[0]));
      FUndoStack.Delete(0);
    end;
    if Assigned(FRedoStack) then begin
      for I := 0 to FRedoStack.Count - 1 do Dispose(PUndoRecord(FRedoStack[I]));
      FRedoStack.Clear;
    end;
  finally
    Stored.Free;
  end;
end;

procedure TfrmMain.CommitPendingEditUndoIfNeeded(const ASuccess: Boolean);
var
  Total: Integer;
  StartLine: Int64;
begin
  if not FPendingEditUndo then Exit;
  FPendingEditUndo := False;
  if ASuccess then
  begin
    if Assigned(FPendingBatchInsertLines) then
    begin
      Total := FPendingBatchInsertLines.Count;
      StartLine := FPendingBatchInsertStartLine;
      RecordBatchInsertForUndo(StartLine, FPendingBatchInsertLines);
      case FPendingBatchInsertKind of
        1: UpdateStatusBar(Format(TrText('%d blank line(s) added by line autofill at line %d.'),
          [Total, StartLine]), iaRight);
        2: UpdateStatusBar(Format(TrText('%d line(s) inserted starting at line %d.'),
          [Total, StartLine]), iaRight);
      else
        UpdateStatusBar(Format(TrText('%d line(s) pasted starting at line %d.'),
          [Total, StartLine]), iaRight);
      end;
      FPendingBatchInsertKind := 0;
      FreeAndNil(FPendingBatchInsertLines);
    end
    else
      RecordForUndo(FPendingEditUndoOp, FPendingEditUndoLine,
        FPendingEditUndoOld, FPendingEditUndoNew);
  end
  else
    FreeAndNil(FPendingBatchInsertLines);
end;

procedure TfrmMain.CommitPendingUndoRedoIfNeeded(const ASuccess: Boolean);
var
  Rest: PUndoRecord;
  LineCnt: Integer;
  EffPath: string;
begin
  if FPendingUndoRedo = purNone then Exit;
  try
    if ASuccess then
    begin
      Rest := FPendingUndoRedoRestore;
      if Assigned(Rest) and (Rest^.Op = 3) then
      begin
        LineCnt := ClipboardLineCountFromUndoRecord(Rest);
        EffPath := CurrentEffectiveFilePath;
        if (EffPath <> '') and FileExists(EffPath) then
        begin
          if Rest^.BatchKind = 1 then
          begin
            if FPendingUndoRedo = purUndo then
              FFHistoryAppendSessionNote(EffPath, 'UNDO',
                Format(TrText('Undo line autofill (%d line(s) at line %d)'),
                  [LineCnt, Rest^.Line]))
            else
              FFHistoryAppendSessionNote(EffPath, 'REDO',
                Format(TrText('Redo line autofill (%d line(s) at line %d)'),
                  [LineCnt, Rest^.Line]));
          end
          else
          begin
            if FPendingUndoRedo = purUndo then
              FFHistoryAppendSessionNote(EffPath, 'UNDO',
                Format(TrText('Batch paste %d line(s) at line %d'), [LineCnt, Rest^.Line]))
            else
              FFHistoryAppendSessionNote(EffPath, 'REDO',
                Format(TrText('Batch paste %d line(s) at line %d'), [LineCnt, Rest^.Line]));
          end;
          NotifyHistoryTouched(EffPath);
        end;
      end;
      if FPendingUndoRedo = purUndo then
      begin
        if not Assigned(FRedoStack) then FRedoStack := TList.Create;
        FRedoStack.Add(FPendingUndoRedoPartner);
        FPendingUndoRedoPartner := nil;
        Dispose(FPendingUndoRedoRestore);
        FPendingUndoRedoRestore := nil;
      end
      else
      begin
        if not Assigned(FUndoStack) then FUndoStack := TList.Create;
        FUndoStack.Add(FPendingUndoRedoPartner);
        FPendingUndoRedoPartner := nil;
        Dispose(FPendingUndoRedoRestore);
        FPendingUndoRedoRestore := nil;
      end;
      if FPendingUndoRedoStatusMsg <> '' then
        UpdateStatusBar(FPendingUndoRedoStatusMsg, iaRight);
    end
    else
    begin
      if FPendingUndoRedo = purUndo then
      begin
        if not Assigned(FUndoStack) then FUndoStack := TList.Create;
        FUndoStack.Add(FPendingUndoRedoRestore);
      end
      else
      begin
        if not Assigned(FRedoStack) then FRedoStack := TList.Create;
        FRedoStack.Add(FPendingUndoRedoRestore);
      end;
      FPendingUndoRedoRestore := nil;
      Dispose(FPendingUndoRedoPartner);
      FPendingUndoRedoPartner := nil;
      if FPendingUndoRedo = purUndo then
        FastFileMessageBox(PChar(TrText('Undo failed.')), PChar(TrText('Undo')),
          MB_OK or MB_ICONWARNING)
      else
        FastFileMessageBox(PChar(TrText('Redo failed.')), PChar(TrText('Redo')),
          MB_OK or MB_ICONWARNING);
    end;
  finally
    FPendingUndoRedo := purNone;
    FPendingUndoRedoStatusMsg := '';
  end;
end;

function TfrmMain.ApplyEditWithUndo(const AOp: TOperationType; const ALine: Int64;
  const AOldContent, ANewContent: String; const AQuietFinish: Boolean = False): Boolean;
begin
  { Edicao assincrona (TEditFileThread): evita RunEditWait na UI thread, que congelava
    o formulario em ficheiros grandes. Undo e RefreshFile ficam em FinishThread. }
  Result := False;
  if UndoRedoBusy then
  begin
    FastFileMessageBox(PChar(TrText('Another edit or undo is still in progress. Please wait.')),
      APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  FPendingEditUndo := True;
  FPendingEditUndoOp := AOp;
  FPendingEditUndoLine := ALine;
  FPendingEditUndoOld := AOldContent;
  FPendingEditUndoNew := ANewContent;
  CloseFileStreams;
  TEditFileThread.Create(CurrentEffectiveFilePath, AOp, ALine, ANewContent,
    True, True, True, AQuietFinish);
  Result := True;
end;

procedure TfrmMain.RecordDeleteUndos(const ToDelete: TInt64List; const SavedTexts: TStringList);
var
  i: Integer;
begin
  if (ToDelete = nil) or (SavedTexts = nil) then Exit;
  if ToDelete.Count <> SavedTexts.Count then Exit;
  for i := ToDelete.Count - 1 downto 0 do
    RecordForUndo(otDelete, ToDelete.Items[i], SavedTexts[i], '');
end;

procedure TfrmMain.DoUndo;
var
  P, R: PUndoRecord;
  UndoOp: TOperationType;
  UndoLine: Int64;
  UndoContent: String;
  EffPath: string;
  CurLine: string;
  StatusMsg: string;
  PasteLines: TStringList;
  PasteLineCount: Integer;
begin
  if UndoRedoBusy then
  begin
    MessageBoxTrInfo(TrText('Another edit or undo is still in progress. Please wait.'),
      TrText('Undo'));
    Exit;
  end;
  if not Assigned(FUndoStack) or (FUndoStack.Count = 0) then begin
    UpdateStatusBar(TrText('Nothing to undo'), iaRight);
    MessageBoxTrInfo(TrText('Nothing to undo'), TrText('Undo'));
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  EffPath := CurrentEffectiveFilePath;
  if (EffPath = '') or (not FileExists(EffPath)) then Exit;

  P := PUndoRecord(FUndoStack[FUndoStack.Count - 1]);
  if not MessageBoxTrYesNo(FormatUndoConfirmMessage(P), TrText('Undo')) then
    Exit;

  FUndoStack.Delete(FUndoStack.Count - 1);

  if (P^.Op = 3) and (P^.BatchKind = 4) then
  begin
    New(R);
    R^.Op := 3;
    R^.BatchKind := 4;
    R^.Line := P^.Line;
    R^.OldContent := P^.NewContent;
    R^.NewContent := P^.OldContent;
    if not Assigned(FRedoStack) then FRedoStack := TList.Create;
    FRedoStack.Add(R);
    ApplyStoredMergeDelta(P^.OldContent);
    FFHistoryAppendSessionNote(EffPath, 'UNDO', TrText('Merge lines (delta)'));
    Exit;
  end;

  if (P^.Op = 3) and (P^.BatchKind = 5) then
  begin
    New(R);
    R^.Op := 3;
    R^.BatchKind := 5;
    R^.Line := P^.Line;
    R^.OldContent := P^.NewContent;
    R^.NewContent := P^.OldContent;
    if not Assigned(FRedoStack) then FRedoStack := TList.Create;
    FRedoStack.Add(R);
    CloseFileStreams;
    if (P^.OldContent <> '') and FileExists(P^.OldContent) then
    begin
      if UnUtils.TryRenameTempOverTarget(P^.OldContent, P^.NewContent, UndoContent) then
      begin
        RefreshFile;
        FFHistoryAppendSessionNote(EffPath, 'UNDO', TrText('Merge files'));
      end
      else
        ShowAppMessage(TrText('Merge Error: ') + UndoContent);
    end;
    Exit;
  end;

  New(R);
  R^.Op := P^.Op;
  R^.Line := P^.Line;
  R^.BatchKind := P^.BatchKind;
  CurLine := '';
  if UndoPartnerNeedsCurrentLine(P^.Op) and
     (P^.Line >= 1) and (P^.Line <= totalLines) then
    CurLine := GetLineContent(P^.Line - 1);
  case P^.Op of
    3: begin
         R^.Op := 3;
         R^.OldContent := P^.OldContent;
         R^.NewContent := P^.NewContent;
       end;
    0: begin
         R^.OldContent := '';
         if CurLine <> '' then
           R^.NewContent := CurLine
         else
           R^.NewContent := P^.NewContent;
       end;
    1: begin
         R^.OldContent := P^.OldContent;
         R^.NewContent := CurLine;
       end;
    2: begin
         R^.OldContent := P^.OldContent;
         R^.NewContent := '';
       end;
  else
    R^.OldContent := P^.OldContent;
    R^.NewContent := P^.NewContent;
  end;

  PasteLines := nil;
  PasteLineCount := 1;
  case P^.Op of
    3: begin
         PasteLineCount := ClipboardLineCountFromUndoRecord(P);
         UndoOp := otDelete;
         UndoLine := P^.Line;
         UndoContent := '';
         if P^.BatchKind = 1 then
           StatusMsg := Format(TrText('Undo: remove %d autofill line(s) from line %d'),
             [PasteLineCount, UndoLine])
         else
           StatusMsg := Format(TrText('Undo: remove %d pasted line(s) from line %d'),
             [PasteLineCount, UndoLine]);
       end;
    0: begin UndoOp := otDelete; UndoLine := P^.Line; UndoContent := '';
         StatusMsg := TrText('Undo: delete line ') + IntToStr(UndoLine);
       end;
    1: begin UndoOp := otEdit; UndoLine := P^.Line; UndoContent := P^.OldContent;
         StatusMsg := TrText('Undo: restore line ') + IntToStr(UndoLine);
       end;
    2: begin UndoOp := otInsert; UndoLine := P^.Line; UndoContent := P^.OldContent;
         StatusMsg := TrText('Undo: insert line ') + IntToStr(UndoLine);
       end;
  else
    Dispose(R);
    FUndoStack.Add(P);
    Exit;
  end;

  if P^.Op = 3 then
    StartAsyncUndoRedo(purUndo, UndoOp, UndoLine, UndoContent, R, P, StatusMsg,
      nil, PasteLineCount)
  else
    StartAsyncUndoRedo(purUndo, UndoOp, UndoLine, UndoContent, R, P, StatusMsg);
end;

procedure TfrmMain.DoRedo;
var
  P, U: PUndoRecord;
  RedoOp: TOperationType;
  RedoLine: Int64;
  RedoContent: String;
  EffPath: string;
  CurLine: string;
  StatusMsg: string;
  PasteLines: TStringList;
  PasteLineCount: Integer;
begin
  if UndoRedoBusy then
  begin
    MessageBoxTrInfo(TrText('Another edit or undo is still in progress. Please wait.'),
      TrText('Redo'));
    Exit;
  end;
  if not Assigned(FRedoStack) or (FRedoStack.Count = 0) then begin
    UpdateStatusBar(TrText('Nothing to redo'), iaRight);
    MessageBoxTrInfo(TrText('Nothing to redo'), TrText('Redo'));
    Exit;
  end;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  EffPath := CurrentEffectiveFilePath;
  if (EffPath = '') or (not FileExists(EffPath)) then Exit;

  P := PUndoRecord(FRedoStack[FRedoStack.Count - 1]);
  if not MessageBoxTrYesNo(FormatRedoConfirmMessage(P), TrText('Redo')) then
    Exit;

  FRedoStack.Delete(FRedoStack.Count - 1);

  if (P^.Op = 3) and (P^.BatchKind = 4) then
  begin
    New(U);
    U^.Op := 3;
    U^.BatchKind := 4;
    U^.Line := P^.Line;
    U^.OldContent := P^.NewContent;
    U^.NewContent := P^.OldContent;
    if not Assigned(FUndoStack) then FUndoStack := TList.Create;
    FUndoStack.Add(U);
    ApplyStoredMergeDelta(P^.OldContent);
    FFHistoryAppendSessionNote(EffPath, 'REDO', TrText('Merge lines (delta)'));
    Exit;
  end;

  if (P^.Op = 3) and (P^.BatchKind = 5) then
  begin
    MessageBoxTrInfo(TrText('Redo is not available for merge files yet.'), TrText('Redo'));
    FRedoStack.Add(P);
    Exit;
  end;

  New(U);
  U^.Op := P^.Op;
  U^.Line := P^.Line;
  U^.BatchKind := P^.BatchKind;
  CurLine := '';
  if UndoPartnerNeedsCurrentLine(P^.Op) and
     (P^.Line >= 1) and (P^.Line <= totalLines) then
    CurLine := GetLineContent(P^.Line - 1);
  case P^.Op of
    3: begin
         U^.Op := 3;
         U^.OldContent := P^.OldContent;
         U^.NewContent := P^.NewContent;
       end;
    0: begin
         U^.OldContent := '';
         U^.NewContent := P^.NewContent;
       end;
    1: begin
         U^.OldContent := CurLine;
         U^.NewContent := P^.NewContent;
       end;
    2: begin
         U^.OldContent := P^.OldContent;
         U^.NewContent := '';
       end;
  else
    U^.OldContent := P^.OldContent;
    U^.NewContent := P^.NewContent;
  end;

  PasteLines := nil;
  PasteLineCount := 1;
  case P^.Op of
    3: begin
         PasteLines := RestoreBatchInsertLinesFromUndo(P);
         if PasteLines.Count < 1 then
         begin
           PasteLines.Free;
           PasteLines := nil;
           Dispose(U);
           FRedoStack.Add(P);
           Exit;
         end;
         PasteLineCount := PasteLines.Count;
         RedoOp := otInsert;
         RedoLine := P^.Line;
         RedoContent := '';
         if P^.BatchKind = 1 then
           StatusMsg := Format(TrText('Redo: line autofill %d blank line(s) at line %d'),
             [PasteLineCount, RedoLine])
         else
           StatusMsg := Format(TrText('Redo: paste %d line(s) at line %d'),
             [PasteLineCount, RedoLine]);
       end;
    0: begin RedoOp := otInsert; RedoLine := P^.Line; RedoContent := P^.NewContent;
         StatusMsg := TrText('Redo: insert line ') + IntToStr(RedoLine);
       end;
    1: begin RedoOp := otEdit; RedoLine := P^.Line; RedoContent := P^.NewContent;
         StatusMsg := TrText('Redo: edit line ') + IntToStr(RedoLine);
       end;
    2: begin RedoOp := otDelete; RedoLine := P^.Line; RedoContent := '';
         StatusMsg := TrText('Redo: delete line ') + IntToStr(RedoLine);
       end;
  else
    Dispose(U);
    FRedoStack.Add(P);
    Exit;
  end;

  if P^.Op = 3 then
    StartAsyncUndoRedo(purRedo, RedoOp, RedoLine, RedoContent, U, P, StatusMsg,
      PasteLines)
  else
    StartAsyncUndoRedo(purRedo, RedoOp, RedoLine, RedoContent, U, P, StatusMsg);
end;


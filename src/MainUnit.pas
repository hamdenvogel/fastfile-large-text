end;

function TfrmMain.FindOccHitRealLine(AHitIndex: Int64): Int64;
begin
  Result := FilteredIndexToReal(AHitIndex);
end;

procedure TfrmMain.FillFindOccHitPage;
var
  SL: TStringList;
  PageSize, PageCount, I: Integer;
  Base, HitIdx, RealLine: Int64;
  Preview, LineTxt: string;
begin
  if not Assigned(FFindOccBar) then Exit;
  if (not FFindOccKeepHits) or (FFilteredCount <= 0) then
  begin
    FFindOccBar.ClearHitList;
    Exit;
  end;
  PageSize := FIND_OCC_LIST_PAGE_SIZE;
  if PageSize < 1 then PageSize := 40;
  PageCount := Integer((FFilteredCount + PageSize - 1) div PageSize);
  if PageCount < 1 then PageCount := 1;
  if FFindOccListPage < 0 then FFindOccListPage := 0;
  if FFindOccListPage >= PageCount then FFindOccListPage := PageCount - 1;
  Base := Int64(FFindOccListPage) * PageSize;
  SL := TStringList.Create;
  try
    for I := 0 to PageSize - 1 do
    begin
      HitIdx := Base + I;
      if HitIdx >= FFilteredCount then Break;
      RealLine := FindOccHitRealLine(HitIdx);
      if RealLine < 0 then Continue;
      LineTxt := GetLineContent(Integer(RealLine));
      Preview := Trim(LineTxt);
      if Length(Preview) > 120 then
        Preview := Copy(Preview, 1, 117) + '...';
      SL.Add(Format(TrText('FindOcc.HitLineFmt'), [RealLine + 1, Preview]));
    end;
    FFindOccBar.SetHitListPage(SL, Base, FFindOccListPage + 1, PageCount,
      Integer(FFilteredCount), FFindOccListPage > 0, FFindOccListPage < PageCount - 1);
  finally
    SL.Free;
  end;
end;

procedure TfrmMain.FindOccHitClick(Sender: TObject; AHitIndex: Int64);
var
  RealLine: Int64;
  LineStart: Int64;
  MatchStart: Integer;
  LineTxt: string;
begin
  RealLine := FindOccHitRealLine(AHitIndex);
  if RealLine < 0 then Exit;
  FLastFoundLine := Integer(RealLine);
  LineStart := GetLineStartOffset(Integer(RealLine));
  if LineStart > 0 then
    FLastFoundFilePos := LineStart - 1
  else
    FLastFoundFilePos := 0;
  FLastFoundMatchLen := 0;
  FLastFoundCol := 0;
  if Length(FFindText) > 0 then
  begin
    LineTxt := GetLineContent(Integer(RealLine));
    MatchStart := Pos(FFindText, LineTxt);
    if (not FFindCaseSensitive) and (MatchStart <= 0) then
      MatchStart := Pos(UpperCase(FFindText), UpperCase(LineTxt));
    if MatchStart > 0 then
    begin
      FLastFoundCol := AlignMatchColInLineText(LineTxt, FFindText, MatchStart, FFindCaseSensitive);
      FLastFoundMatchLen := Length(FFindText);
      if LineStart > 0 then
        FLastFoundFilePos := (LineStart - 1) + (MatchStart - 1);
    end;
  end;
  gotoLineWithAnchor(RealLine, 4);
  ApplyFindMatchSelection;
  if isChecked and Assigned(FCheckListBox) then
  begin
    if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
    FCheckListBox.Invalidate;
  end
  else if Assigned(ListView1) then
  begin
    if ListView1.CanFocus then ListView1.SetFocus;
    ListView1.Invalidate;
  end;
  UpdateStatusBar(Format(TrText('Found at line %d'), [RealLine + 1]), iaRight);
end;

procedure TfrmMain.FindOccListPagePrev(Sender: TObject);
begin
  if FFindOccListPage <= 0 then Exit;
  Dec(FFindOccListPage);
  FillFindOccHitPage;
end;

procedure TfrmMain.FindOccListPageNext(Sender: TObject);
var
  PageSize, PageCount: Integer;
begin
  PageSize := FIND_OCC_LIST_PAGE_SIZE;
  if PageSize < 1 then PageSize := 40;
  PageCount := Integer((FFilteredCount + PageSize - 1) div PageSize);
  if FFindOccListPage >= PageCount - 1 then Exit;
  Inc(FFindOccListPage);
  FillFindOccHitPage;
end;

procedure TfrmMain.AssistantOfferAfterActivity(const AActivityId, ASummary: string);
var
  Ini: TIniFile;
  Facts, Path, Needle: string;
  OfferUI: Boolean;
begin
  if Trim(AActivityId) = '' then Exit;
  if Trim(ASummary) = '' then Exit;
  OfferUI := True;
  if IniName <> '' then
  begin
    PipelineSetStoragePath(IniName);
    Ini := TIniFile.Create(IniName);
    try
      OfferUI := Ini.ReadBool('Assistant', 'AutoOfferNext', True);
    finally
      Ini.Free;
    end;
  end
  else
    PipelineSetStoragePath('');

  Path := Trim(CurrentEffectiveFilePath);
  if Path = '' then
    Path := Trim(edtFileName.Text);
  Needle := Trim(FFindText);
  if Needle = '' then
    Needle := Trim(FFilterText);

  Facts := '';
  if Path <> '' then
    Facts := Facts + 'file=' + Path + ';';
  if totalLines > 0 then
    Facts := Facts + 'lines=' + IntToStr(totalLines) + ';';
  if Needle <> '' then
  begin
    Facts := Facts + 'find_text=' + StringReplace(Needle, ';', ',', [rfReplaceAll]) + ';';
    Facts := Facts + 'filter_text=' + StringReplace(Needle, ';', ',', [rfReplaceAll]) + ';';
  end;
  if FFilteredCount > 0 then
    Facts := Facts + 'hits=' + IntToStr(FFilteredCount) + ';filter_hits=' + IntToStr(FFilteredCount) + ';';
  if FLastFoundLine >= 0 then
    Facts := Facts + 'last_found_line=' + IntToStr(FLastFoundLine + 1) + ';';
  if FFilterStreamPartial then
    Facts := Facts + 'filter_partial=1;';
  if FFindOccKeepHits then
    Facts := Facts + 'find_occ_list=1;';

  NotifyAssistantPostAction(AActivityId, ASummary, Facts, OfferUI);
end;

procedure TfrmMain.OfferAssistantAfterFind;
var
  Summary: string;
begin
  if Trim(FFindText) = '' then Exit;
  if FLastFoundLine < 0 then Exit;
  if FFindOccAssistantOffered then Exit;
  FFindOccAssistantOffered := True;
  Summary := Format(TrText('FindOcc.Assistant.FoundSummary'),
    [FFindText, FLastFoundLine + 1]);
  AssistantOfferAfterActivity('find_hit', Summary);
end;

procedure TfrmMain.OfferAssistantAfterFilter;
var
  Summary: string;
begin
  if not FFindOccDroveFilter then Exit;
  if FFindOccFilterOffered then Exit;
  FFindOccFilterOffered := True;
  if FFilteredCount <= 0 then
    Summary := TrText('FindOcc.Assistant.NoHits')
  else if FFilterStreamPartial then
    Summary := Format(TrText('FindOcc.Assistant.PartialSummary'), [FFilteredCount])
  else
    Summary := Format(TrText('FindOcc.Assistant.HitsSummary'), [FFilteredCount]);
  AssistantOfferAfterActivity('find_collect', Summary);
end;

procedure TfrmMain.SyncScrollBarsForFilterMode;
begin
  if not Assigned(ScrollBarVertical) then Exit;
  { Com filtro na ListView, a barra vertical externa nao esta ligada ao deslocamento (lista rola por si). }
  if FFilterActive and (not isChecked) then
    ScrollBarVertical.Enabled := False
  else
    ScrollBarVertical.Enabled := True;
end;

function TfrmMain.FilteredIndexToReal(FilteredIdx: Int64): Int64;
var
  JumpIdx: Integer;
  StartReal: Int64;
  Count: Int64;
  I: Int64;
  ByteIdx, BitIdx: Integer;
begin
  Result := -1;
  if (not FFilterActive) and (not FFindOccKeepHits) then Exit;
  if (FilteredIdx < 0) or (FilteredIdx >= FFilteredCount) then Exit;
  if FFilterUseHitsFile and Assigned(FFilterHitsFileStream) then
  begin
    Result := ZeroScanReadFilterHit(FFilterHitsFileStream, FilteredIdx);
    Exit;
  end;
  if FFilterUseHitsList then
  begin
    if (FilteredIdx >= 0) and (FilteredIdx <= High(FFilterHitsList)) then
      Result := FFilterHitsList[FilteredIdx];
    Exit;
  end;
  if not Assigned(FFilterBits) then Exit;
  JumpIdx := FilteredIdx div 1024;
  if (JumpIdx > 0) and (JumpIdx <= High(FFilterJumpTable)) then begin
    StartReal := FFilterJumpTable[JumpIdx];
    Count := Int64(JumpIdx) * 1024;
  end else begin
    StartReal := 0;
    Count := 0;
  end;
  I := StartReal;
  while I < FFilterTotalLines do begin
    ByteIdx := I div 8;
    BitIdx := I mod 8;
    if (FFilterBits^[ByteIdx] and (1 shl BitIdx)) <> 0 then begin
      if Count = FilteredIdx then begin Result := I; Exit; end;
      Inc(Count);
    end;
    Inc(I);
  end;
end;

function TfrmMain.FilteredIndexForRealLine(const RealLine: Int64): Int64;
var
  Lo, Hi, Mid: Int64;
  R: Int64;
begin
  Result := -1;
  if (not FFilterActive) and (not FFindOccKeepHits) then Exit;
  if FFilteredCount <= 0 then Exit;
  if FFilterUseHitsFile and Assigned(FFilterHitsFileStream) then
  begin
    Lo := 0;
    Hi := FFilteredCount - 1;
    while Lo <= Hi do
    begin
      Mid := (Lo + Hi) div 2;
      R := ZeroScanReadFilterHit(FFilterHitsFileStream, Mid);
      if R < 0 then Break;
      if R = RealLine then
      begin
        Result := Mid;
        Exit;
      end;
      if R < RealLine then
        Lo := Mid + 1
      else
        Hi := Mid - 1;
    end;
    Exit;
  end;
  if FFilterUseHitsList then
  begin
    Lo := 0;
    Hi := High(FFilterHitsList);
    while Lo <= Hi do
    begin
      Mid := (Lo + Hi) div 2;
      if FFilterHitsList[Mid] = RealLine then
      begin
        Result := Mid;
        Exit;
      end;
      if FFilterHitsList[Mid] < RealLine then
        Lo := Mid + 1
      else
        Hi := Mid - 1;
    end;
    Exit;
  end;
  if (RealLine < 0) or (RealLine >= FFilterTotalLines) then Exit;
  Lo := 0;
  Hi := FFilteredCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    R := FilteredIndexToReal(Mid);
    if R < 0 then Break;
    if R = RealLine then
    begin
      Result := Mid;
      Exit;
    end;
    if R < RealLine then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
end;


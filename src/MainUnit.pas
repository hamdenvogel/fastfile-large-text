    FIdleLogoBgFloat.Items[0].Visible then
    FIdleLogoBgFloat.Items[0].Repaint;
end;

procedure TfrmMain.AdjustListViewColumnsWidth;
var
  TotalW, Col0W, NewW, I, Remaining, DataCols, MinColW: Integer;
begin
  // Coluna 0 (numeracao) permanece fixa; demais colunas usam o espaco util.
  if (ListView1 = nil) or (ListView1.Columns.Count < 2) then Exit;

  TotalW := ListView1.ClientWidth;

  if FCsvMode and FReadContentColumnExpanded then
  begin
    FReadContentColumnExpanded := False;
    if ListView1.Columns[0].Width = 0 then
      ListView1.Columns[0].Width := Max(80, FReadCol0SavedWidth);
  end;

  if (not FCsvMode) and FReadContentColumnExpanded then
  begin
    ListView1.Columns[0].Width := 0;
    NewW := TotalW - COL_EDGE_MARGIN;
    if NewW < 1 then
      NewW := 1;
    ListView1.Columns[1].Width := NewW;
    Exit;
  end;

  if not FReadContentColumnExpanded then
    UpdateListViewLineColumnAutoWidth;

  Col0W := ListView1.Columns[0].Width;
  if not FCsvMode then
  begin
    NewW := TotalW - Col0W - COL_EDGE_MARGIN;
    if NewW < 1 then
      NewW := 1;
    ListView1.Columns[1].Width := NewW;
    Exit;
  end;

  DataCols := ListView1.Columns.Count - 1;
  if DataCols < 1 then Exit;
  Remaining := TotalW - Col0W - COL_EDGE_MARGIN;
  if Remaining < DataCols then
    Remaining := DataCols;
  MinColW := 80;
  NewW := Remaining div DataCols;
  if NewW < MinColW then
    NewW := MinColW;
  for I := 1 to ListView1.Columns.Count - 1 do
    ListView1.Columns[I].Width := NewW;
end;

function TfrmMain.CalcListViewLineColumnWidth: Integer;
var
  Bmp: TBitmap;
  LinePrefix, Sample, Header: string;
  MaxLine: Int64;
  WSample, WHeader: Integer;
const
  LINE_COL_PAD = 14;
  LINE_COL_MIN_W = 80;
begin
  Result := LINE_COL_MIN_W;
  if not Assigned(ListView1) or (ListView1.Columns.Count < 1) then Exit;
  LinePrefix := FTrLinePrefix;
  if LinePrefix = '' then
    LinePrefix := TrText('Line:');
  MaxLine := 1;
  if totalLines > 0 then
    MaxLine := totalLines + CsvDataStartLine
  else
    MaxLine := Int64(Offset) + Int64(VisibleItems) + CsvDataStartLine;
  if MaxLine < 1 then
    MaxLine := 1;
  Sample := LinePrefix + ' ' + FormatFloat('#,', MaxLine);
  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(ListView1.Font);
    WSample := Bmp.Canvas.TextWidth(Sample);
    Header := ListView1.Columns[0].Caption;
    if Header = '' then
      WHeader := 0
    else
      WHeader := Bmp.Canvas.TextWidth(Header);
    Result := Max(WSample, WHeader) + LINE_COL_PAD;
    if Result < LINE_COL_MIN_W then
      Result := LINE_COL_MIN_W;
  finally
    Bmp.Free;
  end;
end;

procedure TfrmMain.UpdateListViewLineColumnAutoWidth;
var
  NeedW: Integer;
begin
  if not Assigned(ListView1) or (ListView1.Columns.Count < 1) then Exit;
  if FReadContentColumnExpanded then Exit;
  NeedW := CalcListViewLineColumnWidth;
  if ListView1.Columns[0].Width <> NeedW then
    ListView1.Columns[0].Width := NeedW;
  if NeedW > FReadCol0SavedWidth then
    FReadCol0SavedWidth := NeedW;
  if isChecked and Assigned(FCheckListBox) then
    UpdateCheckListLinePrefixAutoWidth;
end;

function TfrmMain.CalcCheckListLinePrefixTextWidth(const AFont: TFont): Integer;
var
  Bmp: TBitmap;
  LinePrefix, Sample: string;
  MaxLine: Int64;
const
  PREFIX_COL_PAD = 6;
  PREFIX_COL_MIN_W = 48;
begin
  Result := PREFIX_COL_MIN_W;
  if not Assigned(AFont) then Exit;
  LinePrefix := FTrLinePrefix;
  if LinePrefix = '' then
    LinePrefix := TrText('Line:');
  MaxLine := 1;
  if totalLines > 0 then
    MaxLine := totalLines + CsvDataStartLine
  else
    MaxLine := Int64(Offset) + Int64(VisibleItems) + CsvDataStartLine;
  if MaxLine < 1 then
    MaxLine := 1;
  { Igual ao texto materializado em RefreshCheckListViewport: prefixo + numero + '  '. }
  Sample := LinePrefix + ' ' + FormatFloat('#,', MaxLine) + '  ';
  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(AFont);
    Result := Bmp.Canvas.TextWidth(Sample) + PREFIX_COL_PAD;
    if Result < PREFIX_COL_MIN_W then
      Result := PREFIX_COL_MIN_W;
  finally
    Bmp.Free;
  end;
end;

procedure TfrmMain.UpdateCheckListLinePrefixAutoWidth;
begin
  if not Assigned(FCheckListBox) then
  begin
    FCheckListLinePrefixPx := 0;
    Exit;
  end;
  FCheckListLinePrefixPx := CalcCheckListLinePrefixTextWidth(FCheckListBox.Font);
end;

function TfrmMain.CheckListTextStartX: Integer;
var
  CkW: Integer;
begin
  CkW := GetSystemMetrics(SM_CXMENUCHECK);
  CkW := (CkW * CHECKBOX_SCALE_PCT) div 100;
  if CkW < 9 then CkW := 9;
  Result := CHECKBOX_LEFT_PAD + CkW + CHECKBOX_TEXT_GAP;
end;

function TfrmMain.BuildCheckListLinePrefix(const Line1Based: Integer): string;
var
  LinePrefix: string;
begin
  if Line1Based < 1 then
  begin
    Result := '';
    Exit;
  end;
  LinePrefix := FTrLinePrefix;
  if LinePrefix = '' then
    LinePrefix := TrText('Line:');
  Result := LinePrefix + ' ' + FormatFloat('#,', Line1Based) + '  ';
end;

procedure TfrmMain.GetCheckListItemPrefixAndLine(const Index: Integer;
  out PrefixStr, LinePlain: string);
var
  Line1Based, LineIdx: Integer;
begin
  PrefixStr := '';
  LinePlain := '';
  if not Assigned(FCheckListBox) then Exit;
  if (Index < 0) or (Index >= FCheckListBox.Items.Count) then Exit;
  Line1Based := Integer(FCheckListBox.Items.Objects[Index]);
  if Line1Based <= 0 then
  begin
    PrefixStr := FCheckListBox.Items[Index];
    Exit;
  end;
  LineIdx := Line1Based - 1;
  PrefixStr := BuildCheckListLinePrefix(Line1Based);
  LinePlain := getLineContentsFromLineIndex(LineIdx);
  if (not FFastVisualWordWrap) and (ScrollBarHorizontal.Position > 1) then
    LinePlain := Copy(LinePlain, ScrollBarHorizontal.Position, MaxInt);
end;

procedure TfrmMain.DrawCheckListPrefixAndContent(CLB: TCheckListBox;
  const DrawRect: TRect; const PrefixStr, LinePlain: string; Bk, Fg: TColor;
  ContentFlags: UINT);
var
  PrefixR, ContentR: TRect;
  PrefixFlags: Longint;
  PrefixW: Integer;
begin
  if not Assigned(CLB) then Exit;
  if DrawRect.Right <= DrawRect.Left then Exit;
  PrefixW := FCheckListLinePrefixPx;
  if PrefixW < 1 then
    PrefixW := CLB.Canvas.TextWidth(PrefixStr);
  PrefixR := DrawRect;
  PrefixR.Left := CheckListTextStartX;
  if PrefixR.Left < DrawRect.Left then
    PrefixR.Left := DrawRect.Left;
  PrefixR.Right := PrefixR.Left + PrefixW;
  if PrefixR.Right > DrawRect.Right then
    PrefixR.Right := DrawRect.Right;
  ContentR := DrawRect;
  ContentR.Left := PrefixR.Right;
  CLB.Canvas.Brush.Style := bsSolid;
  CLB.Canvas.Brush.Color := Bk;
  CLB.Canvas.Font.Color := Fg;
  if PrefixR.Right > PrefixR.Left then
    CLB.Canvas.FillRect(PrefixR);
  if PrefixStr <> '' then
  begin
    PrefixFlags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX or DT_LEFT);
    DrawText(CLB.Canvas.Handle, PChar(PrefixStr), Length(PrefixStr), PrefixR, PrefixFlags);
  end;
  if (LinePlain <> '') and (ContentR.Right > ContentR.Left + 2) then
    DrawText(CLB.Canvas.Handle, PChar(LinePlain), Length(LinePlain), ContentR, ContentFlags);
end;

procedure TfrmMain.ResetCsvMode;
begin
  FCsvMode := False;
  FCsvDelimiter := #0;
  FCsvColumnCount := 0;
  FCsvHasHeader := False;
  FCsvHideHeaderRow := False;
  if Assigned(FCsvHeaders) then
    FCsvHeaders.Clear;
end;

procedure TfrmMain.ParseDelimitedLine(const S: string; const Delim: Char; Cells: TStrings);
var
  I: Integer;
  C: Char;
  InQuotes: Boolean;
  Token: string;
begin
  if not Assigned(Cells) then Exit;
  Cells.Clear;
  Token := '';
  InQuotes := False;
  I := 1;
  while I <= Length(S) do
  begin
    C := S[I];
    if C = '"' then
    begin
      if InQuotes and (I < Length(S)) and (S[I + 1] = '"') then
      begin
        Token := Token + '"';
        Inc(I);
      end
      else
        InQuotes := not InQuotes;
    end
    else if (C = Delim) and (not InQuotes) then
    begin
      Cells.Add(Token);
      Token := '';
    end
    else
      Token := Token + C;
    Inc(I);
  end;
  Cells.Add(Token);
end;

function TfrmMain.IsLikelyDelimitedFile(out ADelimiter: Char; out AColumns: Integer): Boolean;
var
  Delims: array[0..3] of Char;
  D, I, Cnt, BestScore, BestCols, Score: Integer;
  L: string;
  Cells: TStringList;
  ThisCols, ValidRows, NeededRows: Integer;
begin
  Result := False;
  ADelimiter := #0;
  AColumns := 0;
  if totalLines < 2 then Exit;

  Delims[0] := ',';
  Delims[1] := ';';
  Delims[2] := #9;
  Delims[3] := '|';

  BestScore := 0;
  BestCols := 0;
  Cells := TStringList.Create;
  try
    NeededRows := SAMPLE_MAX_LINES;
    if totalLines < NeededRows then
      NeededRows := totalLines;
    if NeededRows < 2 then
      NeededRows := 2;

    for D := Low(Delims) to High(Delims) do
    begin
      ThisCols := 0;
      ValidRows := 0;
      Score := 0;
      for I := 0 to NeededRows - 1 do
      begin
        L := GetLineContent(I);
        if L = '' then Continue;
        ParseDelimitedLine(L, Delims[D], Cells);
        Cnt := Cells.Count;
        if Cnt < 2 then Continue;
        Inc(ValidRows);
        if ThisCols = 0 then
        begin
          ThisCols := Cnt;
          Inc(Score);
        end
        else if Cnt = ThisCols then
          Inc(Score);
      end;
      if (ValidRows >= 3) and (Score > BestScore) then
      begin
        BestScore := Score;
        BestCols := ThisCols;
        ADelimiter := Delims[D];
      end;
    end;
  finally
    Cells.Free;
  end;

  if (BestScore >= 3) and (BestCols >= 2) then
  begin
    AColumns := BestCols;
    Result := True;
  end;
end;

procedure TfrmMain.ConfigureListViewColumnsForMode;
var
  I: Integer;
  Col: TListColumn;
  CaptionText: string;
begin
  if not Assigned(ListView1) then Exit;

  ListView1.Columns.BeginUpdate;
  try
    while ListView1.Columns.Count > 0 do
      ListView1.Columns.Delete(ListView1.Columns.Count - 1);

    Col := ListView1.Columns.Add;
    Col.Caption := TrText('Line #');
    Col.Width := 200;

    if not FCsvMode then
    begin
      Col := ListView1.Columns.Add;
      Col.Caption := TrText('Content');
      Col.Width := 1200;
      Exit;
    end;

    for I := 0 to FCsvColumnCount - 1 do
    begin
      Col := ListView1.Columns.Add;
      if Assigned(FCsvHeaders) and (I < FCsvHeaders.Count) then
        CaptionText := Trim(FCsvHeaders[I])
      else
        CaptionText := '';
      if CaptionText = '' then
        CaptionText := Format('Col %d', [I + 1]);
      Col.Caption := CaptionText;
      Col.Width := 140;
    end;
  finally
    ListView1.Columns.EndUpdate;
  end;

  AdjustListViewColumnsWidth;
  ListView1.Invalidate;
  if isChecked then
    SyncSelectModeListViewHeader;
end;

function TfrmMain.LineLooksDelimiterOnly(const S: string; Delim: Char): Boolean;
var
  I: Integer;
  C, D: Char;
begin
  D := Delim;
  if D = #0 then D := ',';
  for I := 1 to Length(S) do
  begin
    C := S[I];
    if (C <> D) and (C > ' ') and (C <> #9) then
    begin
      Result := False;
      Exit;
    end;
  end;
  Result := True;
end;

procedure TfrmMain.DetectAndApplyCsvMode;
var
  Delim: Char;
  Cols, I, HeaderLikeCount, NumericLikeCount: Integer;
  FirstLine: string;
  DataLine: string;
  CellsHeader, CellsData: TStringList;

  function LooksNumericLike(const S: string): Boolean;
  var
    T: string;
    V: Double;
  begin
    T := Trim(S);
    if T = '' then
    begin
      Result := False;
      Exit;
    end;
    T := StringReplace(T, ',', '.', [rfReplaceAll]);
    Result := TryStrToFloat(T, V);
  end;
begin
  ResetCsvMode;
  if not Assigned(ListView1) then Exit;

  if IsLikelyDelimitedFile(Delim, Cols) then
  begin
    FCsvMode := True;
    FCsvDelimiter := Delim;
    FCsvColumnCount := Cols;
    FirstLine := GetLineContent(0);
    if FirstLine <> '' then
    begin
      ParseDelimitedLine(FirstLine, FCsvDelimiter, FCsvHeaders);
      if FCsvHeaders.Count < FCsvColumnCount then
        for I := FCsvHeaders.Count to FCsvColumnCount - 1 do
          FCsvHeaders.Add('');
    end;

    CellsHeader := TStringList.Create;
    CellsData := TStringList.Create;
    try
      DataLine := '';
      I := 1;
      while I < totalLines do
      begin
        DataLine := GetLineContent(I);
        if (Trim(DataLine) <> '') and
           (not LineLooksDelimiterOnly(DataLine, FCsvDelimiter)) then
          Break;
        Inc(I);
      end;

      if (FirstLine <> '') and (DataLine <> '') then
      begin
        ParseDelimitedLine(FirstLine, FCsvDelimiter, CellsHeader);
        ParseDelimitedLine(DataLine, FCsvDelimiter, CellsData);
        HeaderLikeCount := 0;
        NumericLikeCount := 0;
        for I := 0 to Min(CellsHeader.Count, CellsData.Count) - 1 do
        begin
          if (Trim(CellsHeader[I]) <> '') and (not LooksNumericLike(CellsHeader[I])) then
            Inc(HeaderLikeCount);
          if LooksNumericLike(CellsData[I]) then
            Inc(NumericLikeCount);
        end;
        FCsvHasHeader := (HeaderLikeCount > 0) and (NumericLikeCount > 0);
      end;
    finally
      CellsHeader.Free;
      CellsData.Free;
    end;

    FCsvHideHeaderRow := FCsvHasHeader;
  end;

  if FCsvMode and Assigned(chkWordWrap) and chkWordWrap.Checked then
  begin
    chkWordWrap.Checked := False;
    chkWordWrapClick(chkWordWrap);
  end;

  if FCsvMode and FCsvHasHeader and FCsvHideHeaderRow then
    ItemCount := Max(0, totalLines - 1)
  else
    ItemCount := totalLines;

  ConfigureListViewColumnsForMode;
end;

procedure TfrmMain.RestoreCsvModeAfterPostEdit;
{ Apos autofill/edicao: preservar modo CSV da sessao/memoria; nao re-detectar cabecalho
  sobre linhas vazias (;;;) inseridas, senao FCsvHasHeader falha e a linha 1 mostra nomes de colunas. }
var
  SessionFile, FirstLine: string;
  Ini: TMemIniFile;
  SavedCsvMode, SavedHideHeader, SavedHasHeader: Boolean;
  I: Integer;
begin
  SessionFile := CurrentSessionFileName;
  SavedCsvMode := FCsvMode;
  SavedHideHeader := FCsvHideHeaderRow;
  SavedHasHeader := FCsvHasHeader;
  if (SessionFile <> '') and FileExists(SessionFile) then
  begin
    Ini := TMemIniFile.Create(SessionFile);
    try
      SavedCsvMode := Ini.ReadBool('Session', 'CsvMode', SavedCsvMode);
      SavedHideHeader := Ini.ReadBool('Session', 'CsvHideHeaderRow', SavedHideHeader);
      SavedHasHeader := Ini.ReadBool('Session', 'CsvHasHeader', SavedHasHeader);
    finally
      Ini.Free;
    end;
  end;

  if SavedCsvMode then
  begin
    if (not FCsvMode) or (FCsvColumnCount <= 0) or (FCsvDelimiter = #0) then
      DetectAndApplyCsvMode;
    if FCsvMode then
    begin
      FCsvHasHeader := SavedHasHeader;
      if FCsvHasHeader then
        FCsvHideHeaderRow := SavedHideHeader
      else
        FCsvHideHeaderRow := False;
      if FCsvHasHeader and (FCsvHeaders.Count = 0) and (totalLines > 0) then
      begin
        FirstLine := GetLineContent(0);
        if FirstLine <> '' then
        begin
          ParseDelimitedLine(FirstLine, FCsvDelimiter, FCsvHeaders);
          if FCsvHeaders.Count < FCsvColumnCount then
            for I := FCsvHeaders.Count to FCsvColumnCount - 1 do
              FCsvHeaders.Add('');
        end;
      end;
      if FCsvHideHeaderRow and FCsvHasHeader and (not FFilterActive) then
        ItemCount := Max(0, totalLines - 1)
      else
        ItemCount := totalLines;
      ConfigureListViewColumnsForMode;
    end;
  end
  else
  begin
    ResetCsvMode;
    ConfigureListViewColumnsForMode;
    ItemCount := totalLines;
  end;

  InvalidateLineCache;
  if Assigned(ListView1) then
  begin
    ListView1Resize(ListView1);
    ListView1.Refresh;
    ListView1.Invalidate;
  end;
  if Assigned(FPopupLVCsvModeItem) then
    FPopupLVCsvModeItem.Checked := FCsvMode;
  if Assigned(FMenuCsvModeItem) then
    FMenuCsvModeItem.Checked := FCsvMode;
  if Assigned(FPopupLVCsvHeaderRowItem) then
  begin
    FPopupLVCsvHeaderRowItem.Enabled := FCsvMode;
    FPopupLVCsvHeaderRowItem.Checked := FCsvMode and FCsvHasHeader and (not FCsvHideHeaderRow);
  end;
end;

function TfrmMain.CsvDataStartLine: Integer;
begin
  if FCsvMode and FCsvHasHeader and FCsvHideHeaderRow and (not FFilterActive) then
    Result := 1
  else
    Result := 0;
end;

function TfrmMain.BuildStatusModeText: string;
var
  CsvModeText, TailText, FilterText, SelectText, WrapText, MarksText: string;
begin
  if FCsvMode then
    CsvModeText := 'CSV'
  else
    CsvModeText := 'TEXT';

  if FTailActive then
  begin
    if FTailPaused then
      TailText := TrText('PAUSED')
    else
      TailText := TrText('ON');
  end
  else
    TailText := TrText('OFF');

  if FFilterActive then FilterText := TrText('ON') else FilterText := TrText('OFF');
  if isChecked then SelectText := 'CHECK' else SelectText := 'LIST';
  if FFastVisualWordWrap then WrapText := TrText('ON') else WrapText := TrText('OFF');
  if FShowWhitespaceMarks then MarksText := TrText('ON') else MarksText := TrText('OFF');

  Result := Format(TrText('Mode:%s  Wrap:%s  Tail:%s  Filter:%s  Marks:%s  Reading:%s'),
    [CsvModeText, WrapText, TailText, FilterText, MarksText, SelectText]);
end;

function TfrmMain.CurrentSessionFileName: string;
{ Session files are stored under fastfile_temp.
  The source file's full path is encoded into the filename by replacing every
  character that is illegal in a Windows filename with '_', so that:
    C:\Hamden\Files\202210_doctoralia_br.csv
  becomes:
    <ExeDir>\fastfile_temp\C__Hamden_Files_202210_doctoralia_br.csv.ffsession }
var
  BaseName, SafeName: string;
  I: Integer;
  C: Char;
begin
  BaseName := Trim(edtFileName.Text);
  if BaseName = '' then
    BaseName := Trim(fFileName);
  if BaseName = '' then
  begin
    Result := '';
    Exit;
  end;

  SafeName := BaseName;
  for I := 1 to Length(SafeName) do
  begin
    C := SafeName[I];
    if PosBMH(C, ILLEGAL_FILENAME_CHARS) > 0 then
      SafeName[I] := '_';
  end;

  Result := FastFileSessionPath(SafeName);
end;

procedure TfrmMain.SaveCurrentSession;
var
  SessionFile, Bkm: string;
  Ini: TMemIniFile;
  I, RealIdx, ZoomPct: Integer;
begin
  if FSessionRestoring then Exit;
  if totalLines <= 0 then Exit;
  SessionFile := CurrentSessionFileName;
  if SessionFile = '' then Exit;

  RealIdx := -1;
  if isChecked and Assigned(FCheckListBox) and (FCheckListBox.ItemIndex >= 0) then
  begin
    if FFilterActive then
      RealIdx := Integer(FilteredIndexToReal(Offset + FCheckListBox.ItemIndex))
    else
      RealIdx := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]) - 1;
  end
  else if Assigned(ListView1) and (ListView1.ItemIndex >= 0) then
    RealIdx := FileLineIndexFromListRow(ListView1.ItemIndex);

  ZoomPct := 100;
  if Assigned(ListView1) and (FListViewZoomBaseFontSize > 0) then
    ZoomPct := Round((100.0 * ListView1.Font.Size) / FListViewZoomBaseFontSize);

  Ini := TMemIniFile.Create(SessionFile);
  try
    Ini.WriteString('Session', 'FileName', CurrentEffectiveFilePath);
    Ini.WriteInteger('Session', 'LastRealLine', RealIdx);
    Ini.WriteInteger('Session', 'Offset', Offset);
    Ini.WriteBool('Session', 'SelectMode', isChecked);
    Ini.WriteBool('Session', 'WordWrap', Assigned(chkWordWrap) and chkWordWrap.Checked);
    Ini.WriteInteger('Session', 'ZoomPct', ZoomPct);
    Ini.WriteBool('Session', 'TailPaused', FTailPaused);
    Ini.WriteBool('Session', 'CsvMode', FCsvMode);
    Ini.WriteBool('Session', 'CsvHasHeader', FCsvHasHeader);
    Ini.WriteBool('Session', 'CsvHideHeaderRow', FCsvHideHeaderRow);

    Bkm := '';
    if Assigned(FBookmarks) then
      for I := 0 to FBookmarks.Count - 1 do
      begin
        if Bkm <> '' then Bkm := Bkm + ',';
        Bkm := Bkm + IntToStr(Integer(FBookmarks[I]));
      end;
    Ini.WriteString('Session', 'Bookmarks', Bkm);
    Ini.UpdateFile;
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.LoadCurrentSession;
var
  SessionFile, Bkm: string;
  Ini: TMemIniFile;
  Parts: TStringList;
  I, V, LastRealLine, ZoomPct: Integer;
  UseSelectMode, UseWrap: Boolean;
  UseCsvHideHeaderRow: Boolean;
begin
  SessionFile := CurrentSessionFileName;
  if (SessionFile = '') or (not FileExists(SessionFile)) then Exit;

  FSessionRestoring := True;
  Ini := TMemIniFile.Create(SessionFile);
  Parts := TStringList.Create;
  try
    LastRealLine := Ini.ReadInteger('Session', 'LastRealLine', -1);
    UseSelectMode := Ini.ReadBool('Session', 'SelectMode', False);
    UseWrap := Ini.ReadBool('Session', 'WordWrap', False);
    ZoomPct := Ini.ReadInteger('Session', 'ZoomPct', 100);
    UseCsvHideHeaderRow := Ini.ReadBool('Session', 'CsvHideHeaderRow', FCsvHideHeaderRow);

    if FCsvMode then
    begin
      FCsvHideHeaderRow := UseCsvHideHeaderRow;
      if FCsvHasHeader and FCsvHideHeaderRow then
        ItemCount := Max(0, totalLines - 1)
      else
        ItemCount := totalLines;
      ListView1Resize(ListView1);
    end;

    if Assigned(chkWordWrap) and (not FCsvMode) and (chkWordWrap.Checked <> UseWrap) then
    begin
      chkWordWrap.Checked := UseWrap;
      chkWordWrapClick(chkWordWrap);
    end;

    if Assigned(ListView1) then
      ApplyListViewZoomPercent(ZoomPct);

    if Assigned(FBookmarks) then
      FBookmarks.Clear;
    Bkm := Trim(Ini.ReadString('Session', 'Bookmarks', ''));
    if Bkm <> '' then
    begin
      Parts.CommaText := Bkm;
      for I := 0 to Parts.Count - 1 do
      begin
        V := StrToIntDef(Trim(Parts[I]), -1);
        if V >= 0 then
          ToggleBookmark(V);
      end;
    end;

    if (not ListviewIsEmpty) and (UseSelectMode <> isChecked) then
      showCheckBoxes
    else
      showChecked;

    if LastRealLine >= 0 then
      gotoLine(LastRealLine);
  finally
    Parts.Free;
    Ini.Free;
    FSessionRestoring := False;
  end;
end;

procedure TfrmMain.miSaveSessionClick(Sender: TObject);
begin
  if totalLines <= 0 then Exit;
  SaveCurrentSession;
  UpdateStatusBar(TrText('Session saved.'), iaRight);
end;

procedure TfrmMain.miLoadSessionClick(Sender: TObject);
begin
  if totalLines <= 0 then Exit;
  LoadCurrentSession;
  UpdateInfoPanels;
  UpdateStatusBar(TrText('Session loaded.'), iaRight);
end;

procedure TfrmMain.miToggleCsvModeClick(Sender: TObject);
begin
  if totalLines <= 0 then Exit;
  if FCsvMode then
  begin
    { Turn OFF: reset to plain text mode. }
    ResetCsvMode;
    ConfigureListViewColumnsForMode;
    ItemCount := totalLines;
    if Offset < 0 then
      Offset := 0;
    InvalidateLineCache;
    ListView1Resize(ListView1);
    if isChecked then
      showChecked
    else
    begin
      ListView1.Refresh;
      ListView1.Invalidate;
    end;
    UpdateInfoPanels;
    UpdateStatusBar(TrText('CSV mode disabled.'), iaRight);
  end
  else
  begin
    { Turn ON: auto-detect delimiter and apply. }
    DetectAndApplyCsvMode;
    if FCsvMode then
    begin
      UpdateInfoPanels;
      UpdateStatusBar(TrText('CSV mode enabled.'), iaRight);
    end
    else
      UpdateStatusBar(TrText('Could not detect CSV format in this file.'), iaRight);
  end;
  { Sync checkmark in menus. }
  if Assigned(FPopupLVCsvModeItem) then
    FPopupLVCsvModeItem.Checked := FCsvMode;
  if Assigned(FMenuCsvModeItem) then
    FMenuCsvModeItem.Checked := FCsvMode;
  if Assigned(FPopupLVCsvHeaderRowItem) then
    FPopupLVCsvHeaderRowItem.Enabled := FCsvMode;
end;

procedure TfrmMain.miCsvToggleHeaderRowClick(Sender: TObject);
begin
  if not FCsvMode then Exit;
  if not FCsvHasHeader then Exit;
  FCsvHideHeaderRow := not FCsvHideHeaderRow;
  if FCsvHideHeaderRow then
    ItemCount := Max(0, totalLines - 1)
  else
    ItemCount := totalLines;
  if Offset < 0 then
    Offset := 0;
  InvalidateLineCache;
  ListView1Resize(ListView1);
  if isChecked then
    showChecked
  else
  begin
    ListView1.Refresh;
    ListView1.Invalidate;
  end;
  UpdateInfoPanels;
end;

procedure TfrmMain.editFile(const AInitialOp: TOperationType;
  const AForceListRow: Integer; const AInsertAfter: Boolean);
var
  Op: TOperationType;
  LineNum: Int64;
  LineIdx: Integer;
  RowIdx: Integer;
  CurrentContent, OriginalContent: String;
  MaxPhys: Int64;
  AppendAfterEof: Boolean;
  MergeDeletes: TList;
  InsertAfter: Boolean;
begin
  if ListviewIsEmpty then Exit;
  if not EnsureWritableSession then Exit;
  if TryStartAutoIndexForMutation then Exit;
  AppendAfterEof := False;
  InsertAfter := AInsertAfter and (AInitialOp = otInsert);
  if isChecked and Assigned(FCheckListBox) then
  begin
    if FCheckListBox.ItemIndex < 0 then Exit;
    LineNum := Integer(FCheckListBox.Items.Objects[FCheckListBox.ItemIndex]);
    if LineNum < 1 then Exit;
    LineIdx := LineNum - 1;
    if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
      LineNum := PhysicalLine1BasedForListLine0(LineIdx);
  end
  else
  begin
    RowIdx := ListView1.ItemIndex;
    if AForceListRow >= 0 then
      RowIdx := AForceListRow;
    if RowIdx = -1 then Exit;
    LineIdx := FileLineIndexFromListRow(RowIdx);
    if LineIdx < 0 then Exit;
    LineNum := PhysicalLine1BasedForListLine0(LineIdx);
  end;

  MaxPhys := totalLines;
  if Assigned(FSourceFileStream) and (SourceFileSize64 > 0) and
     (SourceFileSize64 <= ZERO_SCAN_FULL_COUNT_MAX) then
    MaxPhys := CountPhysicalLinesInOpenFile
  else if UsesProportionalZeroScanScroll and Assigned(FSourceFileStream) and
     (SourceFileSize64 > 0) then
    MaxPhys := DiscoverZeroScanLastPhysicalLine1Based;
  if MaxPhys < 1 then MaxPhys := 1;

  { Primeira linha em branco apos o EOF na ListView -> inserir no fim. }
  if (not isChecked) and (LineNum = MaxPhys + 1) then
  begin
    AppendAfterEof := True;
    Op := otInsert;
    LineNum := MaxPhys + 1;
    OriginalContent := '';
    CurrentContent := '';
    InsertAfter := False;
  end
  else if (LineNum < 1) or (LineNum > MaxPhys) then
  begin
    FastFileMessageBox(
      PChar(Format(TrText('Line %d does not exist in the file. Valid range: 1..%d.'),
        [LineNum, MaxPhys])),
      PChar(APPLICATION_NAME), MB_OK or MB_ICONWARNING);
    Exit;
  end
  else
  begin
    OriginalContent := GetLineContent(LineIdx);
    CurrentContent := OriginalContent;
    Op := AInitialOp;
  end;

  MergeDeletes := TList.Create;
  try
    if AppendAfterEof then
    begin
      if not TfrmLineEditor.Execute(Op, LineNum, CurrentContent, True,
        LineEditorProvideLine, LineEditorProvideCount) then
        Exit;
    end
    else if not TfrmLineEditor.Execute(Op, LineNum, CurrentContent, False,
      LineEditorProvideLine, LineEditorProvideCount, MergeDeletes, InsertAfter) then
      Exit;

    if MergeDeletes.Count > 0 then
    begin
      ApplyLineEditorMerge(LineNum, CurrentContent, MergeDeletes);
      Exit;
    end;

    if Op = otEdit then
    begin
      if OriginalContent = CurrentContent then Exit;
      ApplyEditWithUndo(otEdit, LineNum, OriginalContent, CurrentContent);
    end
    else if Op = otInsert then
      ApplyEditWithUndo(otInsert, LineNum, '', CurrentContent)
    else if Op = otDelete then
      ApplyEditWithUndo(otDelete, LineNum, OriginalContent, '');
  finally
    MergeDeletes.Free;
  end;
end;

function TfrmMain.LineEditorProvideLine(ALine1Based: Int64): string;
begin
  Result := '';
  if ALine1Based < 1 then Exit;
  Result := GetLineContent(Integer(ALine1Based - 1));
end;

function TfrmMain.LineEditorProvideCount: Int64;
begin
  Result := totalLines;
  if Assigned(FSourceFileStream) and (SourceFileSize64 > 0) and
     (SourceFileSize64 <= ZERO_SCAN_FULL_COUNT_MAX) then
    Result := CountPhysicalLinesInOpenFile
  else if UsesProportionalZeroScanScroll and Assigned(FSourceFileStream) and
     (SourceFileSize64 > 0) then
    Result := DiscoverZeroScanLastPhysicalLine1Based;
  if Result < 1 then Result := 1;
end;

procedure TfrmMain.ApplyLineEditorMerge(const ATargetLine: Int64;
  const AJoinedText: string; ADeleteLines: TList);
var
  Path: string;
  I: Integer;
  OldTarget: string;
  ToDelete: TInt64List;
  SavedTexts: TStringList;
  DelArr: TInt64DynArray;
  NewLineCount: Int64;
  ErrMsg: string;
  PhysTarget: Int64;
  PhysDel: Int64;
begin
  if ATargetLine < 1 then Exit;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;
  if UndoRedoBusy then
  begin
    FastFileMessageBox(PChar(TrText('Another edit or undo is still in progress. Please wait.')),
      APPLICATION_NAME, MB_OK or MB_ICONINFORMATION);
    Exit;
  end;
  Path := CurrentEffectiveFilePath;
  if (Path = '') or (not FileExists(Path)) then Exit;
  if not ConfirmDiskSpaceForMergeLines(Path) then Exit;
  NewLineCount := 0;

  PhysTarget := ATargetLine;
  if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
    PhysTarget := PhysicalLine1BasedForListLine0(ATargetLine - 1);

  OldTarget := GetLineContent(Integer(ATargetLine - 1));

  FSuppressPostEditRefresh := True;
  try
    if OldTarget <> AJoinedText then
    begin
      CloseFileStreams;
      RecordForUndo(otEdit, PhysTarget, OldTarget, AJoinedText);
      if not TEditFileThread.RunEditWait(Path, otEdit, PhysTarget, AJoinedText, False, True) then
        Exit;
      OpenFileStreams(Path);
    end;

    if not Assigned(ADeleteLines) or (ADeleteLines.Count = 0) then
    begin
      FSuppressPostEditRefresh := False;
      RequestPostEditRefresh;
      Exit;
    end;

    ToDelete := TInt64List.Create;
    SavedTexts := TStringList.Create;
    try
      for I := 0 to ADeleteLines.Count - 1 do
      begin
        PhysDel := NativeInt(ADeleteLines[I]);
        if PhysDel < 1 then Continue;
        if UsesProportionalZeroScanScroll and (not HasLineSearchIndex) then
          PhysDel := PhysicalLine1BasedForListLine0(PhysDel - 1);
        if (PhysDel > 0) and (ToDelete.IndexOf(PhysDel) = -1) then
          ToDelete.Add(PhysDel);
      end;
      if ToDelete.Count > 1 then
        ToDelete.SortUp;
      if ToDelete.Count = 0 then
      begin
        FSuppressPostEditRefresh := False;
        RequestPostEditRefresh;
        Exit;
      end;

      for I := 0 to ToDelete.Count - 1 do
        SavedTexts.Add(GetLineContent(Integer(ToDelete.Items[I] - 1)));

      SetLength(DelArr, ToDelete.Count);
      for I := 0 to ToDelete.Count - 1 do
        DelArr[I] := ToDelete.Items[I];

      CloseFileStreams;
      if not RunBatchDeleteLinesWait(Path, DelArr, ErrMsg, NewLineCount) then
      begin
        if Trim(ErrMsg) <> '' then
          FastFileMessageBox(PChar(ErrMsg), APPLICATION_NAME, MB_OK or MB_ICONWARNING);
        OpenFileStreams(Path);
        Exit;
      end;
      RecordDeleteUndos(ToDelete, SavedTexts);
    finally
      SavedTexts.Free;
      ToDelete.Free;
    end;
  finally
    FSuppressPostEditRefresh := False;
  end;
  ApplyPostBatchDeleteRefresh(Path, NewLineCount, True, True);
end;

procedure TfrmMain.btnEditFileClick(Sender: TObject);
begin
  editFile;
end;

procedure TfrmMain.ListView1DblClick(Sender: TObject);
var
  P: TPoint;
  HitRow: Integer;
begin
  if (not isChecked) and Assigned(ListView1) and ListView1.HandleAllocated then
  begin
    GetCursorPos(P);
    P := ListView1.ScreenToClient(P);
    HitRow := GetRowIndexAt(P.X, P.Y);
    if HitRow >= 0 then
    begin
      editFile(otEdit, HitRow);
      Exit;
    end;
  end;
  editFile(otEdit);
end;

procedure TfrmMain.exportFile;
var
  Params: String;
  SaveToFile: Boolean;
  OutFile: String;
begin
  if ListviewIsEmpty then Exit;
  if (existsCheckedRows(FCheckedLines)) then
  begin
    exportToClipBoard;
    Exit;
  end;

  if TfrmExportDialog.Execute(Params, SaveToFile, totalLines) then
  begin
    OutFile := '';
    if SaveToFile then
    begin
      if not SaveDialog1.Execute then Exit;
      OutFile := SaveDialog1.FileName;
    end;
    TExportFileThread.Create(Params, SaveToFile, OutFile, edtFileName.Text, totalLines);
  end;
end;

function TfrmMain.TailSessionNewLineCount: Int64;
begin
  if FTailSessionFirstLine < 0 then
    Result := 0
  else if totalLines > FTailSessionFirstLine then
    Result := totalLines - FTailSessionFirstLine
  else
    Result := 0;
end;

function TfrmMain.SuggestTailExportPath: string;
var
  Dir, BaseName: string;
begin
  if CurrentEffectiveFilePath <> '' then
  begin
    Dir := ExtractFilePath(CurrentEffectiveFilePath);
    BaseName := ChangeFileExt(ExtractFileName(CurrentEffectiveFilePath), '');
    if BaseName = '' then
      BaseName := 'export';
    Result := Dir + 'FastFile_TailExport_' + BaseName + '_' +
      FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
  end
  else
    Result := GetTmpDir + 'FastFile_TailExport_' +
      FormatDateTime('yyyymmdd_hhnnss', Now) + '.txt';
end;

procedure TfrmMain.ExportTailSessionLines;
var
  First1, Last1, From1, To1: Int64;
  OutPath: string;
  ExportAll: Boolean;
  OutDir: string;
begin
  if FTailSessionFirstLine < 0 then
  begin
    ShowAppMessage(TrText('Enable Tail / Follow mode (Ctrl+T) and wait for new lines to be appended to the file.'));
    Exit;
  end;
  if TailSessionNewLineCount <= 0 then
  begin
    if FTailActive then
      ShowAppMessage(TrText('Tail is active but no new lines have been appended yet.'))
    else
      ShowAppMessage(TrText('No tail lines to export in this session.'));
    Exit;
  end;
  First1 := FTailSessionFirstLine + 1;
  Last1 := totalLines;
  OutPath := SuggestTailExportPath;
  ExportAll := True;
  From1 := First1;
  To1 := Last1;
  if not TfrmTailExportDialog.Execute(First1, Last1, OutPath, ExportAll, From1, To1) then
    Exit;
  if From1 < First1 then From1 := First1;
  if To1 > Last1 then To1 := Last1;
  if From1 > To1 then
  begin
    ShowAppMessage(TrText('Invalid line range for export.'));
    Exit;
  end;
  OutDir := ExtractFilePath(OutPath);
  if (OutDir <> '') and (not DirectoryExists(OutDir)) then
    ForceDirectories(OutDir);
  TTailExportThread.Create(From1, To1, totalLines, OutPath, CurrentEffectiveFilePath,
    Self, FTailMacroEnabled and FTailMacroIncludeInExport);
end;

procedure TfrmMain.ExportFilteredResults;
var
  Params: String;
  SaveToFile: Boolean;
  OutFile: String;
  I, RealIdx, j: Integer;
  LineS: string;
  ClipWide: WideString;
  SL: TStringList;
begin
  { Tail: Ctrl+Shift+L abre exportacao direta das linhas capturadas (sem Ctrl+L). }
  if (TailSessionNewLineCount > 0) or FTailActive or (FTailSessionFirstLine >= 0) then
  begin
    ExportTailSessionLines;
    Exit;
  end;

  if not FFilterActive then
  begin
    ShowAppMessage(TrText('Enable Tail (Ctrl+T) and append lines, or apply a filter (Ctrl+L).'));
    Exit;
  end;
  if FFilteredCount <= 0 then
  begin
    ShowAppMessage(TrText('Filter has no results to export.'));
    Exit;
  end;

  Params := '';
  if not TfrmExportDialog.Execute(Params, SaveToFile, FFilteredCount) then Exit;

  if Int64(FFilteredCount) > ExportLineLimitForDestination(SaveToFile) then
  begin
    ShowAppMessage(ExportLineLimitExceededMessage(SaveToFile, FFilteredCount));
    Exit;
  end;

  if SaveToFile then
  begin
    if not SaveDialog1.Execute then Exit;
    OutFile := SaveDialog1.FileName;
    SL := TStringList.Create;
    try
      SL.BeginUpdate;
      try
        for I := 0 to Integer(FFilteredCount) - 1 do
        begin
          RealIdx := Integer(FilteredIndexToReal(I));
          if RealIdx < 0 then Continue;
          LineS := GetLineContent(RealIdx);
          j := 1;
          while j <= Length(LineS) do
            if LineS[j] = #0 then
              Delete(LineS, j, 1)
            else
              Inc(j);
          SL.Add(LineS);
        end;
      finally
        SL.EndUpdate;
      end;
      SL.SaveToFile(OutFile);
    finally
      SL.Free;
    end;
    ShowAppMessage(Format(TrText('%d filtered line(s) exported to file.'), [FFilteredCount]));
    AssistantOfferAfterActivity('export',
      Format(TrText('Assistant.Offer.Summary.Export'), [FFilteredCount]));
  end
  else
  begin
    ClipWide := '';
    for I := 0 to Integer(FFilteredCount) - 1 do
    begin
      RealIdx := Integer(FilteredIndexToReal(I));
      if RealIdx < 0 then Continue;
      LineS := GetLineContent(RealIdx);
      j := 1;
      while j <= Length(LineS) do
        if LineS[j] = #0 then
          Delete(LineS, j, 1)
        else
          Inc(j);
      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(LineS);
    end;
    if ClipWide <> '' then
      ClipboardSetUnicodeText(ClipWide);
    ShowAppMessage(Format(TrText('%d filtered line(s) copied to the clipboard.'), [FFilteredCount]));
    AssistantOfferAfterActivity('export',
      Format(TrText('Assistant.Offer.Summary.Export'), [FFilteredCount]));
  end;
end;

procedure TfrmMain.CopyMultiSelectionToClipboard;
var
  Item: TListItem;
  CopiedCount: Integer;
  FirstFileLineIdx, LineIdx: Integer;
  LineS: string;
  ClipWide: WideString;
  j: Integer;
begin
  if (ListView1 = nil) or (ListView1.SelCount = 0) then Exit;

  CopiedCount := 0;
  FirstFileLineIdx := -1;
  ClipWide := '';

  Item := ListView1.Selected;
  while Item <> nil do
  begin
    LineIdx := FileLineIndexFromListRow(Item.Index);
    if LineIdx < 0 then
    begin
      Item := ListView1.GetNextItem(Item, sdAll, [isSelected]);
      Continue;
    end;

    if FirstFileLineIdx < 0 then
      FirstFileLineIdx := LineIdx;

    LineS := GetLineContent(LineIdx);
    j := 1;
    while j <= Length(LineS) do
      if LineS[j] = #0 then
        Delete(LineS, j, 1)
      else
        Inc(j);

    if ClipWide <> '' then
      ClipWide := ClipWide + WideString(#13#10);
    ClipWide := ClipWide + WideString(LineS);
    Inc(CopiedCount);

    Item := ListView1.GetNextItem(Item, sdAll, [isSelected]);
  end;

  if CopiedCount > 0 then
  begin
    ClipboardSetUnicodeText(ClipWide);
    if CopiedCount = 1 then
      { CP1252 via #$xx: acentos estaveis mesmo com fonte .pas em UTF-8 no D7 }
      ShowAppMessage(Format('A linha %d foi copiada para a '#$E1'rea de transfer'#$EA'ncia.',
        [FirstFileLineIdx + 1]))
    else
      ShowAppMessage(Format('%d linhas foram copiadas para a '#$E1'rea de transfer'#$EA'ncia.',
        [CopiedCount]));
  end;
end;

function TfrmMain.FileLineIndexFromListRow(const RowIdx: Integer): Integer;
var
  R: Int64;
begin
  Result := -1;
  if RowIdx < 0 then Exit;
  if FFilterActive then
  begin
    R := FilteredIndexToReal(RowIdx);
    if R < 0 then Exit;
    if R > MaxInt then Exit;
    Result := Integer(R);
  end
  else
  begin
    R := Offset + Int64(RowIdx) + Int64(CsvDataStartLine);
    if (R < 0) or (R > MaxInt) then Exit;
    Result := Integer(R);
  end;
end;

procedure TfrmMain.CopyFileLineToClipboard(const LineIdx: Integer);
var
  LineS: string;
  j: Integer;
begin
  if LineIdx < 0 then Exit;
  if not Assigned(FSourceFileStream) then Exit;

  LineS := GetLineContent(LineIdx);
  j := 1;
  while j <= Length(LineS) do
    if LineS[j] = #0 then
      Delete(LineS, j, 1)
    else
      Inc(j);

  ClipboardSetUnicodeText(WideString(LineS));
  ShowAppMessage(Format('A linha %d foi copiada para a '#$E1'rea de transfer'#$EA'ncia.', [LineIdx + 1]));
end;

procedure TfrmMain.CopyChecklistVerticalSelectionToClipboard;
var
  StartRowIdx, EndRowIdx: Integer;
  SelLeft, SelRight: Integer;
  I, Tmp, Line1Based, LineIdx, j: Integer;
  FullStr, LineS, BlockS: string;
  ClipWide: WideString;
  Bmp: TBitmap;
  FirstIdx, LastIdx: Integer;
  dCharWidth: Double;
  PixelTextStart, PixelTextEnd: Integer;
  CopyLen, StartCharIdx, EndCharIdx: Integer;
  FirstLineNo, LastLineNo: Integer;
  OriginXBase, OriginX, CkW, PrefixLen: Integer;
  ItemH, TopIdx: Integer;
  SelTopY, SelBottomY: Integer;

  function PrefixW(const S: string; N: Integer): Integer;
  begin
    if N <= 0 then Result := 0
    else Result := Bmp.Canvas.TextWidth(Copy(S, 1, N));
  end;

  function FirstCharFromPixel(const S: string; const SelL: Integer): Integer;
  var
    Lo, Hi, Mid, Lc: Integer;
  begin
    Lc := Length(S);
    if Lc = 0 then begin Result := 1; Exit; end;
    if OriginX + PrefixW(S, Lc) < SelL then begin Result := Lc + 1; Exit; end;
    Lo := 1; Hi := Lc;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi) div 2;
      if OriginX + PrefixW(S, Mid) < SelL then Lo := Mid + 1
      else Hi := Mid;
    end;
    Result := Lo;
  end;

  function LastCharToPixel(const S: string; const SelR: Integer): Integer;
  var
    Lo, Hi, Mid, Lc: Integer;
  begin
    Lc := Length(S); Result := 0;
    if Lc = 0 then Exit;
    if OriginX > SelR then Exit;
    Lo := 1; Hi := Lc;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi + 1) div 2;
      if OriginX + PrefixW(S, Mid - 1) <= SelR then Lo := Mid
      else Hi := Mid - 1;
    end;
    Result := Lo;
  end;

begin
  if not FHasSelection then Exit;
  if not Assigned(FCheckListBox) or (FCheckListBox.Items.Count = 0) then Exit;

  { Mapeamento estrito da faixa vertical para linhas visiveis:
    TopIndex + Y div ItemHeight (faixa [Top,Bottom) evita incluir linha de cima na borda). }
  ItemH := Max(1, CheckListEffectiveRowHeight);
  TopIdx := FCheckListBox.TopIndex;
  SelTopY := Min(FBlockStartPoint.Y, FBlockEndPoint.Y);
  SelBottomY := Max(FBlockStartPoint.Y, FBlockEndPoint.Y);
  if SelTopY < 0 then SelTopY := 0;
  if SelBottomY < 1 then SelBottomY := 1;
  if SelTopY >= FCheckListBox.ClientHeight then SelTopY := FCheckListBox.ClientHeight - 1;
  if SelBottomY > FCheckListBox.ClientHeight then SelBottomY := FCheckListBox.ClientHeight;
  StartRowIdx := TopIdx + (SelTopY div ItemH);
  EndRowIdx   := TopIdx + ((SelBottomY - 1) div ItemH);
  if StartRowIdx > EndRowIdx then
  begin
    Tmp := StartRowIdx; StartRowIdx := EndRowIdx; EndRowIdx := Tmp;
  end;
  if StartRowIdx < 0 then StartRowIdx := 0;
  if EndRowIdx >= FCheckListBox.Items.Count then EndRowIdx := FCheckListBox.Items.Count - 1;

  SelLeft  := Min(FBlockStartPoint.X, FBlockEndPoint.X);
  SelRight := Max(FBlockStartPoint.X, FBlockEndPoint.X);
  { Ajuste fino: evita capturar 1 caractere extra a esquerda na checklist. }
  Inc(SelLeft);
  if SelRight <= SelLeft then Inc(SelRight);

  { OriginXBase = pixel de inicio do texto apos checkbox - identico ao CheckListBox1DrawItem. }
  CkW := GetSystemMetrics(SM_CXMENUCHECK);
  CkW := (CkW * CHECKBOX_SCALE_PCT) div 100;
  if CkW < 9 then CkW := 9;
  OriginXBase := CHECKBOX_LEFT_PAD + CkW + CHECKBOX_TEXT_GAP + 2;

  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(FCheckListBox.Font);
    dCharWidth := Bmp.Canvas.TextWidth(StringOfChar('W', 100)) / 100.0;
    if dCharWidth < 1.0 then dCharWidth := 8.0;

    ClipWide := '';
    for I := StartRowIdx to EndRowIdx do
    begin
      Line1Based := Integer(FCheckListBox.Items.Objects[I]);
      FullStr    := FCheckListBox.Items[I];

      if Line1Based <= 0 then
      begin
        LineS    := '';
        PrefixLen := 0;
        OriginX  := OriginXBase;
      end
      else
      begin
        LineIdx := Line1Based - 1;
        { getLineContentsFromLineIndex - mesma funcao e scroll horizontal que showChecked usou. }
        LineS := getLineContentsFromLineIndex(LineIdx);
        j := 1;
        while j <= Length(LineS) do
          if LineS[j] = #0 then Delete(LineS, j, 1) else Inc(j);
        { PrefixLen derivado do item real - evita recomputar IsBookmarked ou FormatFloat. }
        PrefixLen := Length(FullStr) - Length(LineS);
        if PrefixLen < 0 then PrefixLen := 0;
        { OriginX por linha: OriginXBase + largura do prefixo em pixels.
          Identico a como CopyVerticalSelectionToClipboard usa Col0Width para separar colunas. }
        OriginX := OriginXBase + Bmp.Canvas.TextWidth(Copy(FullStr, 1, PrefixLen));
      end;

      { Busca binaria em LineS com OriginX por linha - identico a CopyVerticalSelectionToClipboard. }
      if Length(LineS) > LONG_LINE_THRESH then
      begin
        PixelTextStart := SelLeft  - OriginX;
        PixelTextEnd   := SelRight - OriginX;
        if PixelTextStart < 0 then PixelTextStart := 0;
        if PixelTextEnd   < 0 then PixelTextEnd   := 0;
        StartCharIdx := Round(PixelTextStart / dCharWidth) + 1;
        EndCharIdx   := Round(PixelTextEnd   / dCharWidth) + 1;
        if StartCharIdx < 1 then StartCharIdx := 1;
        CopyLen := EndCharIdx - StartCharIdx;
        if CopyLen <= 0 then CopyLen := 1;
        if StartCharIdx > Length(LineS) then
          BlockS := StringOfChar(' ', CopyLen)
        else
        begin
          BlockS := Copy(LineS, StartCharIdx, CopyLen);
          if Length(BlockS) < CopyLen then
            BlockS := BlockS + StringOfChar(' ', CopyLen - Length(BlockS));
        end;
      end
      else
      begin
        FirstIdx := FirstCharFromPixel(LineS, SelLeft);
        LastIdx  := LastCharToPixel(LineS, SelRight);
        if (FirstIdx > LastIdx) or (FirstIdx > Length(LineS)) or (LastIdx < 1) then
          BlockS := ''
        else
        begin
          if FirstIdx < 1 then FirstIdx := 1;
          if LastIdx > Length(LineS) then LastIdx := Length(LineS);
          BlockS := Copy(LineS, FirstIdx, LastIdx - FirstIdx + 1);
        end;
      end;

      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(BlockS);
    end;

    if ClipWide <> '' then
    begin
      ClipboardSetUnicodeText(ClipWide);
      FirstLineNo := Integer(FCheckListBox.Items.Objects[StartRowIdx]);
      LastLineNo  := Integer(FCheckListBox.Items.Objects[EndRowIdx]);
      if StartRowIdx = EndRowIdx then
        ShowAppMessage(Format(
          'A selecao vertical (linha %d) foi copiada para a '#$E1'rea de transfer'#$EA'ncia.',
          [FirstLineNo]))
      else
        ShowAppMessage(Format(
          'Selecao vertical: linhas %d-%d copiadas para a '#$E1'rea de transfer'#$EA'ncia.',
          [FirstLineNo, LastLineNo]));
    end;
  finally
    Bmp.Free;
  end;
end;

procedure TfrmMain.CopyCheckedChecklistLinesToClipboard;
var
  I, Line1Based, LineIdx, CopiedCount: Integer;
  LineS: string;
  ClipWide: WideString;
  j: Integer;
begin
  if not Assigned(FSourceFileStream) then Exit;

  ClipWide := '';
  CopiedCount := 0;

  { Preferir o estado global das linhas marcadas (inclui marcacoes fora da janela visivel). }
  if Assigned(FCheckedLines) and (FCheckedLines.Count > 0) then
  begin
    for I := 0 to FCheckedLines.Count - 1 do
    begin
      Line1Based := Integer(FCheckedLines.Items[I]);
      if Line1Based <= 0 then Continue;
      LineIdx := Line1Based - 1;
      if not LineExists(LineIdx) then Continue;

      LineS := GetLineContent(LineIdx);
      j := 1;
      while j <= Length(LineS) do
        if LineS[j] = #0 then
          Delete(LineS, j, 1)
        else
          Inc(j);

      if ClipWide <> '' then
        ClipWide := ClipWide + WideString(#13#10);
      ClipWide := ClipWide + WideString(LineS);
      Inc(CopiedCount);
    end;
  end
  else if Assigned(FCheckListBox) then
  begin
    { Fallback: somente itens marcados atualmente visiveis. }
    for I := 0 to FCheckListBox.Items.Count - 1 do
      if FCheckListBox.Checked[I] then
      begin
        Line1Based := Integer(FCheckListBox.Items.Objects[I]);
        if Line1Based <= 0 then Continue;
        LineIdx := Line1Based - 1;
        if not LineExists(LineIdx) then Continue;

        LineS := GetLineContent(LineIdx);
        j := 1;
        while j <= Length(LineS) do
          if LineS[j] = #0 then
            Delete(LineS, j, 1)
          else
            Inc(j);

        if ClipWide <> '' then
          ClipWide := ClipWide + WideString(#13#10);
        ClipWide := ClipWide + WideString(LineS);
        Inc(CopiedCount);
      end;
  end;

  if CopiedCount > 0 then
  begin
    ClipboardSetUnicodeText(ClipWide);
    if CopiedCount = 1 then
      ShowAppMessage(TrText('1 marked line was copied to the clipboard.'))
    else
      ShowAppMessage(Format(TrText('%d marked lines were copied to the clipboard.'), [CopiedCount]));
  end;
end;

procedure TfrmMain.CopyListViewFocusedLineToClipboard;
var
  RowIdx, LineIdx: Integer;
begin
  if (ListView1 = nil) or ListviewIsEmpty then Exit;
  RowIdx := ListView1.ItemIndex;
  if RowIdx < 0 then Exit;

  LineIdx := FileLineIndexFromListRow(RowIdx);
  if LineIdx < 0 then Exit;
  CopyFileLineToClipboard(LineIdx);
end;

function TfrmMain.IsClickInFirstColumn(X: Integer): Boolean;
var
  Col0Width, ScrollOffset: Integer;
  AbsX: Integer;
begin
  if (ListView1 = nil) or (ListView1.Columns.Count = 0) then
  begin
    Result := False;
    Exit;
  end;

  ScrollOffset := GetScrollPos(ListView1.Handle, SB_HORZ);
  AbsX := X + ScrollOffset;
  Col0Width := ListView1.Columns[0].Width;

  Result := AbsX <= Col0Width;
end;

function TfrmMain.FileLineIndexFromCheckListRow(const RowIdx: Integer): Integer;
var
  Line1Based: Integer;
begin
  Result := -1;
  if not Assigned(FCheckListBox) then Exit;
  if (RowIdx < 0) or (RowIdx >= FCheckListBox.Items.Count) then Exit;
  Line1Based := Integer(FCheckListBox.Items.Objects[RowIdx]);
  if Line1Based <= 0 then Exit;
  Result := Line1Based - 1;
end;

function TfrmMain.GetCheckListRowIndexAt(Y: Integer): Integer;
var
  ItemH: Integer;
begin
  Result := -1;
  if not Assigned(FCheckListBox) then Exit;
  ItemH := Max(1, CheckListEffectiveRowHeight);
  if Y < 0 then Y := 0;
  if Y >= FCheckListBox.ClientHeight then
    Y := FCheckListBox.ClientHeight - 1;
  Result := FCheckListBox.TopIndex + (Y div ItemH);
  if Result >= FCheckListBox.Items.Count then
    Result := FCheckListBox.Items.Count - 1;
end;

function TfrmMain.GetCheckListLineColumnRight(const RowIdx: Integer): Integer;
var
  PrefixStr, LineS: string;
begin
  Result := CheckListTextStartX;
  if FCheckListLinePrefixPx > 0 then
    Inc(Result, FCheckListLinePrefixPx)
  else if Assigned(FCheckListBox) and (RowIdx >= 0) and (RowIdx < FCheckListBox.Items.Count) then
  begin
    FCheckListBox.Canvas.Font.Assign(FCheckListBox.Font);
    GetCheckListItemPrefixAndLine(RowIdx, PrefixStr, LineS);
    Inc(Result, FCheckListBox.Canvas.TextWidth(PrefixStr));
  end;
end;

function TfrmMain.IsClickInCheckListLineColumn(X, Y: Integer): Boolean;
var
  RowIdx, ColRight: Integer;
begin
  Result := False;
  if not Assigned(FCheckListBox) then Exit;
  RowIdx := GetCheckListRowIndexAt(Y);
  if RowIdx < 0 then Exit;
  ColRight := GetCheckListLineColumnRight(RowIdx);
  Result := X <= ColRight;
end;

function TfrmMain.CanStartLineAutofill: Boolean;
begin
  Result := Assigned(FSourceFileStream)
    and (not FFilterActive)
    and (not SessionBlocksMutation);
  if not Result then Exit;
  if isChecked then
    Result := Assigned(FCheckListBox) and FCheckListBox.HandleAllocated
      and FCheckListBox.Visible and (FCheckListBox.Items.Count > 0)
  else
    Result := Assigned(ListView1) and ListView1.HandleAllocated
      and (not ListviewIsEmpty);
end;

function TfrmMain.BuildBlankInsertLineContent: string;
var
  I: Integer;
  D: Char;
begin
  { Modo CSV: linha com N celulas vazias (delimitadores), nao bytes zero no ficheiro. }
  if FCsvMode and (FCsvColumnCount > 1) then
  begin
    D := FCsvDelimiter;
    if D = #0 then D := ',';
    Result := StringOfChar(D, FCsvColumnCount - 1);
  end
  else
    Result := '';
end;

procedure TfrmMain.CancelLineAutofillDrag;
begin
  FLineAutofillDeferCtrl := False;
  if not FLineAutofillDragging then Exit;
  FLineAutofillDragging := False;
  FLineAutofillInsertCount := 0;
  if FLineAutofillOnCheckList then
  begin
    if Assigned(FCheckListBox) and (GetCapture = FCheckListBox.Handle) then
      ReleaseCapture;
    if Assigned(FCheckListBox) then
      FCheckListBox.Invalidate;
  end
  else
  begin
    if Assigned(ListView1) and (GetCapture = ListView1.Handle) then
      ReleaseCapture;
    if Assigned(ListView1) then
      ListView1.Invalidate;
  end;
  FLineAutofillOnCheckList := False;
end;

procedure TfrmMain.DrawCheckListLineAutofillPreview(CLB: TCheckListBox;
  const Index: Integer; const ItemRect: TRect);
var
  I, RowH, AnchorIdx, ColRight: Integer;
  R: TRect;
  LineNo: Int64;
  Prefix, NumTxt: string;
begin
  if not FLineAutofillDragging or not FLineAutofillOnCheckList then Exit;
  if FLineAutofillInsertCount <= 0 then Exit;
  if Index <> FLineAutofillStartRow then Exit;

  RowH := ListViewVisualRowHeight;
  if RowH < 1 then RowH := 18;
  ColRight := GetCheckListLineColumnRight(FLineAutofillStartRow);
  if ColRight < 8 then Exit;
  AnchorIdx := FileLineIndexFromCheckListRow(FLineAutofillStartRow);
  if AnchorIdx < 0 then Exit;

  Prefix := FTrLinePrefix;
  if Prefix = '' then Prefix := TrText('Line:');

  CLB.Canvas.Brush.Style := bsSolid;
  CLB.Canvas.Brush.Color := $00E8F4FF;
  CLB.Canvas.Font.Assign(CLB.Font);
  CLB.Canvas.Font.Color := clNavy;

  for I := 1 to FLineAutofillInsertCount do
  begin
    R := ItemRect;
    OffsetRect(R, 0, I * RowH);
    R.Right := ColRight;
    if R.Top >= CLB.ClientHeight then Break;
    CLB.Canvas.FillRect(R);
    LineNo := Int64(AnchorIdx) + Int64(I) + 1;
    NumTxt := Prefix + ' ' + FormatFloat('#,', LineNo);
    CLB.Canvas.TextOut(R.Left + 4, R.Top + 2, NumTxt);
  end;
end;

procedure TfrmMain.DrawLineAutofillPreview;
var
  I, RowH, Col0W, AnchorIdx: Integer;
  R, AnchorRect: TRect;
  LineNo: Int64;
  Prefix, NumTxt: string;
begin
  if not Assigned(ListView1) then Exit;
  if FLineAutofillInsertCount <= 0 then Exit;
  if (FLineAutofillStartRow < 0) or (FLineAutofillStartRow >= ListView1.Items.Count) then Exit;

  RowH := ListViewVisualRowHeight;
  if RowH < 1 then RowH := 18;
  Col0W := ListView1.Columns[0].Width;
  if Col0W < 8 then Exit;

  ListView_GetItemRect(ListView1.Handle, FLineAutofillStartRow, AnchorRect, LVIR_BOUNDS);
  AnchorIdx := FileLineIndexFromListRow(FLineAutofillStartRow);
  if AnchorIdx < 0 then Exit;

  Prefix := FTrLinePrefix;
  if Prefix = '' then Prefix := TrText('Line:');

  ListView1.Canvas.Brush.Style := bsSolid;
  ListView1.Canvas.Brush.Color := $00E8F4FF;
  ListView1.Canvas.Font.Assign(ListView1.Font);
  ListView1.Canvas.Font.Color := clNavy;

  for I := 1 to FLineAutofillInsertCount do
  begin
    R := AnchorRect;
    OffsetRect(R, 0, I * RowH);
    R.Right := Col0W;
    if R.Top >= ListView1.ClientHeight then Break;
    ListView1.Canvas.FillRect(R);
    LineNo := Int64(AnchorIdx) + Int64(I) + 1;
    NumTxt := Prefix + ' ' + FormatFloat('#,', LineNo);
    ListView1.Canvas.TextOut(R.Left + 4, R.Top + 2, NumTxt);
  end;
end;

procedure TfrmMain.StartLineAutofillDrag(const AHitRow, AStartY: Integer);
begin
  FLineAutofillOnCheckList := isChecked and Assigned(FCheckListBox)
    and FCheckListBox.HandleAllocated and FCheckListBox.Visible;
  if FLineAutofillOnCheckList then
  begin
    if FHasSelection then
    begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
      FCheckListBox.Invalidate;
    end;
    FLineAutofillDragging := True;
    FLineAutofillStartRow := AHitRow;
    FLineAutofillStartY := AStartY;
    FLineAutofillInsertCount := 0;
    SetCapture(FCheckListBox.Handle);
    if FCheckListBox.CanFocus then FCheckListBox.SetFocus;
  end
  else
  begin
    if not Assigned(ListView1) then Exit;
    if FHasSelection then
    begin
      FHasSelection := False;
      FFindMatchSelection := False;
      FIsDragging := False;
      ListView1.Repaint;
    end;
    FLineAutofillDragging := True;
    FLineAutofillStartRow := AHitRow;
    FLineAutofillStartY := AStartY;
    FLineAutofillInsertCount := 0;
    SetCapture(ListView1.Handle);
    if ListView1.CanFocus then ListView1.SetFocus;
  end;
end;

function TfrmMain.ConfirmLineAutofill: Boolean;
var
  StartLine1Based: Int64;
  FileIdx: Integer;
begin
  if FLineAutofillOnCheckList then
    FileIdx := FileLineIndexFromCheckListRow(FLineAutofillStartRow)
  else
    FileIdx := FileLineIndexFromListRow(FLineAutofillStartRow);
  if FileIdx < 0 then
  begin
    Result := False;
    Exit;
  end;
  StartLine1Based := Int64(FileIdx) + 2;
  Result := MessageBoxTrYesNo(
    Format(TrText('Insert %d blank line(s) starting at line %d?'),
      [FLineAutofillInsertCount, StartLine1Based]),
    TrText('Confirmation'), True);
end;

procedure TfrmMain.CommitLineAutofill;
var
  Lines: TStringList;
  I: Integer;
  StartLine1Based: Int64;
  FileIdx: Integer;
begin
  if FLineAutofillInsertCount <= 0 then Exit;
  if UndoRedoBusy then Exit;
  if not EnsureWritableSession then Exit;
  if not EnsureOpenFileNotStaleForMutate then Exit;

  if FLineAutofillOnCheckList then
    FileIdx := FileLineIndexFromCheckListRow(FLineAutofillStartRow)
  else
    FileIdx := FileLineIndexFromListRow(FLineAutofillStartRow);
  if FileIdx < 0 then Exit;
  { Inserir apos a linha de ancoragem (otInsert na linha seguinte no ficheiro). }
  StartLine1Based := Int64(FileIdx) + 2;

  Lines := TStringList.Create;
  try
    for I := 1 to FLineAutofillInsertCount do
      Lines.Add(BuildBlankInsertLineContent);
    ApplyBatchInsertWithUndo(StartLine1Based, Lines, 1);
  finally
    Lines.Free;
  end;
end;

procedure TfrmMain.RefreshFile;
begin
  { Recarga apos edicao/apagar/colar: manter pilha Undo/Redo (nao usar BeginRead). }
  BeginReadSilent;
end;

procedure TfrmMain.RequestPostEditRefresh;
begin
  if FSuppressPostEditRefresh then Exit;
  if Handle <> 0 then
    PostMessage(Handle, WM_USER + 202, 0, 0);
end;

procedure TfrmMain.WMPostEditRefresh(var Msg: TMessage);
begin
  RefreshFile;
end;

function TfrmMain.TryScheduleLightPostEditRefresh(const AOp: TOperationType;
  const ATargetLine: Int64; ASpanCount: Integer; AInsertLines: TStringList;
  ASizeBefore, ASizeAfter: Int64): Boolean;
var
  IndexPath: string;
  DeltaBytes: Int64;
  DeltaLines: Int64;
begin
  Result := False;
  if ASpanCount > 1 then Exit;
  if Assigned(AInsertLines) and (AInsertLines.Count > 1) then Exit;
  { Append apos EOF / TargetLine alem do indice: patch de 1 registo corrompe temp.txt. }
  if (AOp = otInsert) and (ATargetLine > totalLines) then Exit;
  DeltaBytes := ASizeAfter - ASizeBefore;

  case AOp of
    otInsert: DeltaLines := 1;
    otDelete: DeltaLines := -1;
    otEdit, otReplace:
      begin
        if DeltaBytes = 0 then
        begin
          ApplyMetadataOnlyPostEdit(0);
          Result := True;
        end;
        Exit;
      end;
  else
    Exit;
  end;

  IndexPath := FastFileExeDirPath(TEMPFILE);
  { Patch denso (temp.txt) nao remove o registo da linha apagada; para delete
    usar sempre refresh pos-edicao com ckpt reconstruido. }
  if (AOp <> otDelete) and FileExists(IndexPath) and (Abs(DeltaBytes) > 0) then
  begin
    FFileReloadInProgress := True;
    TfrmSmoothLoading.ShowLoading(TrText('Updating line index...'), False);
    TSingleLineIndexPatchThread.Create(CurrentEffectiveFilePath, AOp, ATargetLine, DeltaBytes);
    Result := True;
    Exit;
  end;

  if FZeroScanMode or (totalLines > 500000) or
     (ASizeAfter > Int64(2) * 1024 * 1024 * 1024) then
  begin
    { Ficheiros grandes usam temp_ckpt.txt; apos alteracao de bytes o indice esparso tem de ser reconstruido. }
    BeginPostEditReindex;
    Result := True;
  end;
end;

procedure TfrmMain.ApplyMetadataOnlyPostEdit(const ADeltaLines: Int64);
begin
  if ADeltaLines <> 0 then
  begin
    Inc(totalLines, ADeltaLines);
    if totalLines < 0 then totalLines := 0;
    ItemCount := totalLines;
    totalCharacters := GetFileSize(CurrentEffectiveFilePath);
  end;
  if (CurrentEffectiveFilePath <> '') and FileExists(CurrentEffectiveFilePath) then
  begin
    OpenFileStreams(CurrentEffectiveFilePath);
    FDetectedEncoding := DetectFileEncoding(CurrentEffectiveFilePath);
    FDetectedEol := DetectLineEndingFromFile(CurrentEffectiveFilePath);
  end;
  SyncListViewViewportAfterFileLoad;
  InvalidateOpenFileDiskSnapshot;
  CaptureOpenFileDiskSnapshot;
  UpdateInfoPanels;
  if isChecked and Assigned(FCheckListBox) then
  begin
    FCheckListDisplayOffset := -1;
    RefreshCheckListViewport(True);
  end;
  FFileReloadInProgress := False;
end;

function TfrmMain.TryScheduleBatchPostEditRefresh(const ADeletedLineCount: Integer;
  ASizeBefore, ASizeAfter: Int64): Boolean;
begin
  Result := False;
  if ADeletedLineCount <= 0 then Exit;
  if ADeletedLineCount = 1 then
  begin
    Result := TryScheduleLightPostEditRefresh(otDelete, 0, 1, nil, ASizeBefore, ASizeAfter);
    Exit;
  end;
  { Multi-line: sparse ckpt must be rebuilt; show progress, keep session (no ActionClear). }
  BeginPostEditReindex;
  Result := True;
end;

procedure TfrmMain.ApplySingleLineIndexPatchDone(const AOp: TOperationType;
  const ATargetLine, ADeltaBytes: Int64; ASuccess: Boolean; const AErrorMsg: string);
begin
  TfrmSmoothLoading.HideLoading;
  try
    if not ASuccess then
    begin
      RequestPostEditRefresh;
      Exit;
    end;
    if AOp = otInsert then
      ApplyMetadataOnlyPostEdit(1)
    else if AOp = otDelete then
      ApplyMetadataOnlyPostEdit(-1)
    else
      ApplyMetadataOnlyPostEdit(0);
  finally
    FFileReloadInProgress := False;
  end;
end;

procedure TfrmMain.EndFileReloadInProgress;
begin
  FFileReloadInProgress := False;
end;

procedure TfrmMain.SetReadCancelledStatus;
begin
  UpdateStatusBar(Tr('status.file_read_cancelled', 'File reading cancelled'), iaRight);
end;

procedure TfrmMain.UpdateFindSearchProgress(const BytesDone, TotalBytes: Int64);
begin
  if TotalBytes <= 0 then Exit;
  UpdateStatusBar(TrText('Searching') + ' ' + UnUtils.FormatNumber(BytesDone) + ' / ' +
    UnUtils.FormatNumber(TotalBytes) + ' B', iaRight);
end;

procedure TfrmMain.CaptureOpenFileDiskSnapshot;
var
  P: string;
begin
  FOpenDiskSnapValid := False;
  FOpenDiskSnapPath := '';
  FOpenDiskSnapSize := 0;
  FillChar(FOpenDiskSnapWrite, SizeOf(FOpenDiskSnapWrite), 0);
  P := CurrentEffectiveFilePath;
  if (P = '') or SameText(P, SELECTTEXT) or (not FileExists(P)) then
    Exit;
  FOpenDiskSnapPath := ExpandFileName(P);
  UnUtils.GetFileSizeAndWriteTime(FOpenDiskSnapPath, FOpenDiskSnapSize, FOpenDiskSnapWrite);
  FOpenDiskSnapValid := True;
end;

procedure TfrmMain.InvalidateOpenFileDiskSnapshot;
begin
  FOpenDiskSnapValid := False;
  FOpenDiskSnapPath := '';
  FOpenDiskSnapSize := 0;
  FillChar(FOpenDiskSnapWrite, SizeOf(FOpenDiskSnapWrite), 0);
end;

function TfrmMain.EnsureOpenFileNotStaleForMutate: Boolean;
var
  P: string;
  R: Integer;
begin
  Result := True;
  if not FOpenDiskSnapValid then Exit;
  P := CurrentEffectiveFilePath;
  if (P = '') or SameText(P, SELECTTEXT) or (not FileExists(P)) then Exit;
  if not SameText(ExpandFileName(P), FOpenDiskSnapPath) then Exit;
  if UnUtils.SameFileSizeAndWriteTime(P, FOpenDiskSnapSize, FOpenDiskSnapWrite) then Exit;

  R := FastFileMessageBox(
    PChar(TrText('File changed on disk since load')),
    PChar(TrText('File changed on disk')),
    MB_YESNOCANCEL or MB_ICONWARNING);
  case R of
    IDYES:
      begin
        BeginRead;
        Result := False;
      end;
    IDNO:
      begin
        CaptureOpenFileDiskSnapshot;
        Result := True;
      end;
  else
    Result := False;
  end;
end;

function TfrmMain.SessionBlocksMutation: Boolean;
begin
  Result := FFileSessionReadOnly;
  if (not Result) and (Trim(edtFileName.Text) <> '') then
    Result := PosBMH(SessionReadOnlyCaptionSuffix, edtFileName.Text) > 0;
end;

function TfrmMain.EnsureWritableSession: Boolean;
begin
  Result := not SessionBlocksMutation;
  if Result then Exit;
  FastFileMessageBox(
    PChar(TrText('Read-only session is enabled. Turn it off in Options to edit or save the file.')),
    PChar(TrText('Read-only')),
    MB_OK or MB_ICONINFORMATION);
end;

procedure TfrmMain.ApplySessionReadOnlyUi;
begin
  if FFileSessionReadOnly and Assigned(FSourceFileStream) then
  begin
    if Assigned(btnEditFile) then btnEditFile.Enabled := False;
    if Assigned(btnDeleteLines) then btnDeleteLines.Enabled := False;
    if Assigned(btnMergeMultipleLines) then btnMergeMultipleLines.Enabled := False;
    if Assigned(btnSplitFiles) then btnSplitFiles.Enabled := False;
    if Assigned(FBtnTopExport) then FBtnTopExport.Enabled := False;
    if Assigned(FBtnTopFileOptions) then FBtnTopFileOptions.Enabled := False;
    UpdateStatusBar(TrText('Read-only session'), iaRight);
  end
  else if Assigned(FSourceFileStream) then
  begin
    UnUtils.ActionComponent([btnRead, btnClear, btnDeleteLines, btnSplitFiles, btnMergeMultipleLines,
      btnCheckBoxes, btnExport, btnEditFile], acEnabled);
    if Assigned(FBtnTopExport) then
      FBtnTopExport.Enabled := True;
    if Assigned(FBtnTopFileOptions) then
      FBtnTopFileOptions.Enabled := True;
  end;
  ApplySessionReadOnlyFilenameDecoration;
end;

procedure TfrmMain.miToggleReadOnlyClick(Sender: TObject);
begin
  FFileSessionReadOnly := not FFileSessionReadOnly;
  if Assigned(FMenuReadOnlyItem) then
    FMenuReadOnlyItem.Checked := FFileSessionReadOnly;
  if Assigned(FPopupLVReadOnlyItem) then
    FPopupLVReadOnlyItem.Checked := FFileSessionReadOnly;
  if Assigned(FToolsExtrasReadOnly) then
    FToolsExtrasReadOnly.Checked := FFileSessionReadOnly;
  ApplySessionReadOnlyUi;
end;

procedure TfrmMain.miToggleSegmentedHeavyOpsClick(Sender: TObject);
begin
  EnsureReadTabVisible;
  FForceSegmentHeavyOps := not FForceSegmentHeavyOps;
  if not FForceSegmentHeavyOps then
    FSegmentHeavyOpsPolicy := shpAuto;
  if IniName <> '' then
    sStoreUtils.WriteIniStr(APPLICATION_NAME, 'SegmentHeavyOps',
      iff(FForceSegmentHeavyOps, '1', '0'), IniName);
  ApplySegmentHeavyOpsUiState;
  SaveSmartSearchPrefs;
end;

procedure TfrmMain.miUserPrefsClick(Sender: TObject);
var
  OldDefaultPPI: Integer;
begin
  OldDefaultPPI := DefaultUIScalePPI;
  if not TfrmUserPrefs.Execute then Exit;
  SaveUserPrefs(IniName);
  { Apply a new default scale right away when the current scale follows the default. }
  if (DefaultUIScalePPI <> OldDefaultPPI) and (IniName <> '') and
     (sStoreUtils.ReadIniInteger(APPLICATION_NAME, 'UIScalePPI', 0, IniName) = 0) then
    RestoreDefaultUIScale(Self);
  if Assigned(FLineHintDelayTimer) then
    FLineHintDelayTimer.Interval := PrefLineHintShowDelayMs;
  if Assigned(FOpenTabsMru) then
    while FOpenTabsMru.Count > PrefOpenTabsMruMax do
      FOpenTabsMru.Delete(FOpenTabsMru.Count - 1);
end;

procedure TfrmMain.SyncSegmentHeavyOpsPolicyMenu;
begin
  if Assigned(FMenuSegmentHeavyOpsAuto) then
    FMenuSegmentHeavyOpsAuto.Checked := not FForceSegmentHeavyOps;
end;

procedure TfrmMain.miSegmentHeavyOpsAutoClick(Sender: TObject);
begin
  FForceSegmentHeavyOps := False;
  FSegmentHeavyOpsPolicy := shpAuto;
  if IniName <> '' then
    sStoreUtils.WriteIniStr(APPLICATION_NAME, 'SegmentHeavyOps', '0', IniName);
  ApplySegmentHeavyOpsUiState;
  SaveSmartSearchPrefs;
end;

procedure TfrmMain.miSegmentHeavyOpsAlwaysClick(Sender: TObject);
begin
  { Compatibilidade (Assistente / INI antigo): equivale a Forcar ligado. }
  FForceSegmentHeavyOps := True;
  FSegmentHeavyOpsPolicy := shpAuto;
  if IniName <> '' then
    sStoreUtils.WriteIniStr(APPLICATION_NAME, 'SegmentHeavyOps', '1', IniName);
  ApplySegmentHeavyOpsUiState;
  SaveSmartSearchPrefs;
end;

procedure TfrmMain.miSegmentHeavyOpsNeverClick(Sender: TObject);
begin
  { Compatibilidade: "nunca" saiu do menu; volta ao automatico. }
  miSegmentHeavyOpsAutoClick(Sender);
end;


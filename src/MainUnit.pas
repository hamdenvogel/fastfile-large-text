function TfrmMain.BuildLineContentHoverHint(const Line1Based: Int64; const Content: string): string;
var
  Raw, Chunk, LinePrefix: string;
  I, SoftBreak, LineCount, BreakAt: Integer;
  Parts: TStringList;

  function IsSoftBreakChar(const C: Char): Boolean;
  begin
    Result := CharInSet(C, [' ', #9, ',', ';', '|', '/', '\', '-', '_', '.', ':', '#']);
  end;

begin
  Result := '';
  Raw := Trim(Content);
  if Raw = '' then Exit;

  { Remove quebras internas — a linha do arquivo e uma so. }
  Raw := StringReplace(Raw, #13#10, ' ', [rfReplaceAll]);
  Raw := StringReplace(Raw, #13, ' ', [rfReplaceAll]);
  Raw := StringReplace(Raw, #10, ' ', [rfReplaceAll]);

  if Length(Raw) > PrefLineHintMaxChars then
    Raw := Copy(Raw, 1, PrefLineHintMaxChars - 3) + '...';

  Parts := TStringList.Create;
  try
    I := 1;
    LineCount := 0;
    while (I <= Length(Raw)) and (LineCount < PrefLineHintMaxLines) do
    begin
      if Length(Raw) - I + 1 <= LINE_HINT_WRAP_CHARS then
      begin
        Parts.Add(Copy(Raw, I, MaxInt));
        Break;
      end;
      Chunk := Copy(Raw, I, LINE_HINT_WRAP_CHARS);
      SoftBreak := 0;
      for BreakAt := Length(Chunk) downto Max(1, Length(Chunk) div 2) do
        if IsSoftBreakChar(Chunk[BreakAt]) then
        begin
          SoftBreak := BreakAt;
          Break;
        end;
      if SoftBreak > 0 then
      begin
        Parts.Add(Copy(Raw, I, SoftBreak));
        Inc(I, SoftBreak);
        while (I <= Length(Raw)) and (Raw[I] = ' ') do
          Inc(I);
      end
      else
      begin
        Parts.Add(Chunk);
        Inc(I, LINE_HINT_WRAP_CHARS);
      end;
      Inc(LineCount);
    end;
    if (I <= Length(Raw)) and (LineCount >= PrefLineHintMaxLines) then
    begin
      if Parts.Count > 0 then
        Parts[Parts.Count - 1] := Parts[Parts.Count - 1] + '...'
      else
        Parts.Add('...');
    end;

    LinePrefix := FTrLinePrefix;
    if LinePrefix = '' then
      LinePrefix := TrText('Line:');

    { Plain text + CRLF: same font size as title (HTML <font size=N> rendered tiny). }
    Result := LinePrefix + ' ' + FormatFloat('#,', Line1Based);
    for I := 0 to Parts.Count - 1 do
      Result := Result + #13#10 + Parts[I];
  finally
    Parts.Free;
  end;
end;


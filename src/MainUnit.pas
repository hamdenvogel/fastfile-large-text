function TfrmMain.AssistantCbValidateComposedSource(const APath: string; out AReport: string): Boolean;
var
  Ext, ExeName, ExePath, CmdLine, OutText: string;
  Security: TSecurityAttributes;
  StartupInfo: TStartupInfo;
  ProcessInfo: TProcessInformation;
  StdOutRead, StdOutWrite: THandle;
  Buf: array[0..4095] of AnsiChar;
  BytesRead, Avail, WaitRc, ExitCode, Elapsed: DWORD;
  Chunk: RawByteString;
  Acc: RawByteString;
  Ok: Boolean;
  T0: Cardinal;

  procedure DrainPipe;
  begin
    while PeekNamedPipe(StdOutRead, nil, 0, nil, @Avail, nil) and (Avail > 0) do
    begin
      if not ReadFile(StdOutRead, Buf[0], SizeOf(Buf), BytesRead, nil) then
        Break;
      if BytesRead = 0 then Break;
      SetLength(Chunk, BytesRead);
      Move(Buf[0], Chunk[1], BytesRead);
      Acc := Acc + Chunk;
    end;
  end;

begin
  Result := False;
  AReport := '';
  Acc := '';
  Ext := LowerCase(ExtractFileExt(Trim(APath)));
  if (Trim(APath) = '') or (not FileExists(APath)) then
  begin
    AReport := TrText('Assistant.Validate.FileMissing');
    Exit;
  end;
  if Ext = '.py' then
    ExeName := SCRIPTENGINE
  else if IsValidatableComposeSourcePath(APath) then
    ExeName := CODECHECK
  else
  begin
    AReport := TrText('Assistant.Validate.Unsupported') + #13#10#13#10 +
      TrText('Assistant.Validate.SupportedLanguages');
    Exit;
  end;

  if not EnsureExecutableAvailable(ExeName, ExePath) then
  begin
    AReport := Format(TrText('Assistant.Validate.ExeMissing'), [ExeName]);
    Exit;
  end;

  FillChar(Security, SizeOf(Security), 0);
  Security.nLength := SizeOf(Security);
  Security.bInheritHandle := True;
  StdOutRead := 0;
  StdOutWrite := 0;
  if not CreatePipe(StdOutRead, StdOutWrite, @Security, 0) then
  begin
    AReport := TrText('Assistant.Validate.Failed');
    Exit;
  end;
  SetHandleInformation(StdOutRead, HANDLE_FLAG_INHERIT, 0);
  try
    FillChar(StartupInfo, SizeOf(StartupInfo), 0);
    StartupInfo.cb := SizeOf(StartupInfo);
    StartupInfo.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
    StartupInfo.wShowWindow := SW_HIDE;
    StartupInfo.hStdInput := 0;
    StartupInfo.hStdOutput := StdOutWrite;
    StartupInfo.hStdError := StdOutWrite;
    FillChar(ProcessInfo, SizeOf(ProcessInfo), 0);
    if SameText(ExeName, SCRIPTENGINE) then
      CmdLine := '"' + ExePath + '" --validate "' + APath + '"'
    else
      CmdLine := '"' + ExePath + '" "' + APath + '"';
    Ok := CreateProcess(nil, PChar(CmdLine), nil, nil, True,
      CREATE_NO_WINDOW, nil, PChar(ExtractFilePath(ExePath)), StartupInfo, ProcessInfo);
    CloseHandle(StdOutWrite);
    StdOutWrite := 0;
    if not Ok then
    begin
      AReport := TrText('Assistant.Validate.Failed');
      Exit;
    end;
    try
      T0 := GetTickCount;
      repeat
        DrainPipe;
        WaitRc := WaitForSingleObject(ProcessInfo.hProcess, 150);
        if WaitRc <> WAIT_TIMEOUT then
          Break;
        Elapsed := GetTickCount - T0;
        if Elapsed >= DWORD(CODECHECK_VALIDATE_TIMEOUT_MS) then
        begin
          TerminateProcess(ProcessInfo.hProcess, 1);
          DrainPipe;
          OutText := Trim(UTF8ToString(Acc));
          AReport := TrText('Assistant.Validate.Timeout');
          if OutText <> '' then
            AReport := AReport + #13#10 + OutText;
          Exit;
        end;
        if GetCurrentThreadId = MainThreadID then
          Application.ProcessMessages;
      until False;
      DrainPipe;
      { Final blocking reads until pipe closes. }
      while ReadFile(StdOutRead, Buf[0], SizeOf(Buf), BytesRead, nil) and (BytesRead > 0) do
      begin
        SetLength(Chunk, BytesRead);
        Move(Buf[0], Chunk[1], BytesRead);
        Acc := Acc + Chunk;
      end;
      ExitCode := 1;
      GetExitCodeProcess(ProcessInfo.hProcess, ExitCode);
      OutText := Trim(UTF8ToString(UTF8String(Acc)));
      AReport := OutText;
      if AReport = '' then
      begin
        if ExitCode = 0 then
          AReport := 'OK'
        else
          AReport := TrText('Assistant.Validate.Failed');
      end;
      Result := (ExitCode = 0) and (Pos('ERROR:', AReport) = 0);
    finally
      CloseHandle(ProcessInfo.hThread);
      CloseHandle(ProcessInfo.hProcess);
    end;
  finally
    if StdOutWrite <> 0 then
      CloseHandle(StdOutWrite);
    if StdOutRead <> 0 then
      CloseHandle(StdOutRead);
  end;
end;

procedure TfrmMain.ShowScriptExportBalloon(const AFileName: string);
var
  R: TRect;
  P: TPoint;
  FileName, DirPath: string;
begin
  FileName := Trim(AFileName);
  if FileName = '' then Exit;
  DirPath := ExtractFileDir(FileName);
  if DirPath = '' then
    DirPath := FileName;
  if not Assigned(FScriptExportBalloon) then
  begin
    FScriptExportBalloon := TBalloonHint.Create(Self);
    FScriptExportBalloon.HideAfter := 9000;
    FScriptExportBalloon.Delay := 0;
  end;
  FScriptExportBalloon.Title := TrText('SCRIPT_EXPORT_SAVED_TITLE');
  FScriptExportBalloon.Description := Format(TrText('SCRIPT_EXPORT_BALLOON_BODY'),
    [ExtractFileName(FileName), DirPath]);
  if Assigned(FScriptExportBannerPanel) and FScriptExportBannerPanel.HandleAllocated and
     FScriptExportBannerPanel.Visible then
  begin
    P := FScriptExportBannerPanel.ClientToScreen(
      Point(12, Max(8, FScriptExportBannerPanel.Height div 2)));
    R := Rect(P.X, P.Y, P.X + 2, P.Y + 2);
    FScriptExportBalloon.ShowHint(R);
  end;
end;


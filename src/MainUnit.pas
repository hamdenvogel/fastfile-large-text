var
  { Set only during a language switch: per-step timings of ApplyConfigs. }
  GApplyConfigsTiming: TStringList = nil;

procedure TfrmMain.ApplyConfigs;
var
  EncIdx: Integer;
  E0, E1, E2, E3, E4, E5, E6: string;
  NeedRebuildEncodingItems: Boolean;
  FreezeRedraw: Boolean;
  StepTick: Cardinal;

  procedure Step(const AName: string);
  var
    T: Cardinal;
  begin
    T := GetTickCount;
    if Assigned(GApplyConfigsTiming) then
      GApplyConfigsTiming.Add(Format('  ApplyConfigs.%-24s %6d ms', [AName, T - StepTick]));
    StepTick := T;
    if Assigned(RetranslateTickProc) then
      RetranslateTickProc;
  end;

begin
  if FApplyingLanguage then Exit;
  StepTick := GetTickCount;

  FApplyingLanguage := True;
  { Only freeze redraws after the first language apply (runtime language
    change). During FormCreate the first call skips freeze to avoid grey-flash
    and the synchronous RedrawWindow stall at startup. }
  FreezeRedraw := FLanguageAppliedOnce and HandleAllocated;
  if FreezeRedraw then
    SendMessage(Handle, WM_SETREDRAW, 0, 0);
  try
    { Icons do not depend on the language: rebuilding them on every switch cost
      seconds (each AddMasked re-measured the linked skinned menus). }
    if not Assigned(FMenuBitmapImages) or (FMenuBitmapImages.Count = 0) then
      BuildMenuBitmapImageList;
    Step('BuildMenuBitmapImageList');
    EnsureToolsPopupFastFileExtras;
    EnsureToolsPopupBookmarkExtras;
    UpdateToolsPopupFastFileExtrasCaptions;
    Step('ToolsPopupExtras');
    RefreshLanguageRuntimeCache;
    Step('RefreshLanguageRuntimeCache');
    FLastStatusLine := -1;
    FLastStatusCount := -1;

    if Assigned(comboViewEncoding) then
    begin
      EncIdx := comboViewEncoding.ItemIndex;
      E0 := TrText('View: DEFAULT (detected)');
      E1 := TrText('View: UTF-8');
      E2 := TrText('View: ANSI (raw / system)');
      E3 := TrText('View: UTF-16 LE');
      E4 := TrText('View: UTF-16 BE');
      E5 := TrText('View: UTF-32 LE');
      E6 := TrText('View: UTF-32 BE');

      NeedRebuildEncodingItems := (comboViewEncoding.Items.Count <> 7)
        or (comboViewEncoding.Items[0] <> E0)
        or (comboViewEncoding.Items[1] <> E1)
        or (comboViewEncoding.Items[2] <> E2)
        or (comboViewEncoding.Items[3] <> E3)
        or (comboViewEncoding.Items[4] <> E4)
        or (comboViewEncoding.Items[5] <> E5)
        or (comboViewEncoding.Items[6] <> E6);

      FUpdatingViewEncodingCombo := True;
      try
        if NeedRebuildEncodingItems then
        begin
          comboViewEncoding.Items.BeginUpdate;
          try
            comboViewEncoding.Items.Clear;
            comboViewEncoding.Items.Add(E0);
            comboViewEncoding.Items.Add(E1);
            comboViewEncoding.Items.Add(E2);
            comboViewEncoding.Items.Add(E3);
            comboViewEncoding.Items.Add(E4);
            comboViewEncoding.Items.Add(E5);
            comboViewEncoding.Items.Add(E6);
          finally
            comboViewEncoding.Items.EndUpdate;
          end;
        end;

        if EncIdx < 0 then EncIdx := 0;
        if EncIdx >= comboViewEncoding.Items.Count then
          EncIdx := comboViewEncoding.Items.Count - 1;
        comboViewEncoding.ItemIndex := EncIdx;
      finally
        FUpdatingViewEncodingCombo := False;
      end;
      EnsureFileFormatPopupMenus;
    end;
    Step('ViewEncodingCombo');

    SetupToolbarKeyboardHints;
    Step('SetupToolbarKeyboardHints');
    LocalizeTopToolbar;
    Step('LocalizeTopToolbar');
    BuildToolbarOverflowMenu;
    Step('BuildToolbarOverflowMenu');
    BuildMenu;
    Step('BuildMenu');
    { ListView popup: sempre reconstroi aqui. Construir dentro do OnPopup (lazy) causa
      fontes menores na primeira exibicao porque o AlphaSkins aplica metricas antes
      dos itens existirem. O custo (~18 TMenuItem) e negligivel. }
    BuildListViewPopupMenu;
    Step('BuildListViewPopupMenu');
    SyncLanguageComboWithCurrent;
    { No startup nao ha arquivo carregado; esses paineist sao atualizados em FormShow. }
    if FLanguageAppliedOnce then
    begin
      UpdateInfoPanels;
      UpdateListViewZoomStatusPanel;
    end;
    Step('InfoPanels');
    if Assigned(FFilterBar) then
      RefreshFilterBarState;
    RefreshFileReadTimerCaption;
    RetranslateOperationTimerLog;
    Step('FilterBar + timer caption');
  finally
    if FreezeRedraw then
    begin
      SendMessage(Handle, WM_SETREDRAW, 1, 0);
      { RDW_FRAME: invalida a area nao-cliente (menu bar, borda).
        RDW_ERASE: limpa o fundo antes de repintar para nao sobrepor texto antigo.
        RDW_UPDATENOW: forca pintura sincrona (sem esperar proxima mensagem WM_PAINT). }
      RedrawWindow(Handle, nil, 0,
        RDW_ERASE or RDW_FRAME or RDW_INVALIDATE or RDW_ALLCHILDREN or RDW_UPDATENOW);
      { DrawMenuBar DEPOIS de reabilitar o redraw, para o Windows realmente redesenhar o menu bar. }
      DrawMenuBar(Handle);
      Step('RedrawWindow');
    end;
    FLanguageAppliedOnce := True;
    FApplyingLanguage := False;
  end;
end;

procedure TfrmMain.InitializeLanguage;
var
  LangCode: string;
  WinLangID: Word;
  Primary: Word;
  Sub: Word;
begin
  LangCode := sStoreUtils.ReadIniString(APPLICATION_NAME, 'Language', IniName);
  if Trim(LangCode) = '' then
  begin
    WinLangID := GetUserDefaultLangID;
    { Delphi 7 compatible extraction (Windows LANGID layout):
      low 10 bits = primary language, high 6 bits = sublanguage. }
    Primary := (WinLangID and $03FF);
    Sub := (WinLangID shr 10);

    case Primary of
      LANG_PORTUGUESE:
        begin
          if Sub = SUBLANG_PORTUGUESE_BRAZILIAN then
            LangCode := 'pt-br'
          else
            LangCode := 'pt-PT';
        end;
      LANG_SPANISH:   LangCode := 'es';
      LANG_FRENCH:    LangCode := 'fr';
      LANG_GERMAN:    LangCode := 'de';
      LANG_ITALIAN:   LangCode := 'it';
      LANG_POLISH:    LangCode := 'pl';
      LANG_ROMANIAN:  LangCode := 'ro';
      LANG_HUNGARIAN: LangCode := 'hu';
      LANG_CZECH:     LangCode := 'cs';
      LANG_CHINESE:
        begin
          { SUBLANG: 0x01 Traditional, 0x02 Simplified, 0x03 HK, 0x04 Singapore }
          if (Sub = $0002) or (Sub = $0004) then
            LangCode := 'zh-CN'
          else
            LangCode := 'zh-TW';
        end;
    else
      LangCode := 'en';
    end;
  end;
  SetCurrentLanguage(AppLanguageFromCode(LangCode));
end;

procedure TfrmMain.SyncLanguageComboWithCurrent;
begin
  if not Assigned(comboLanguage) then Exit;

  FUpdatingLanguageCombo := True;
  try
    comboLanguage.Items.BeginUpdate;
    try
      comboLanguage.Items.Clear;
      comboLanguage.Items.Add(Tr('language.option.english', 'English'));
      comboLanguage.Items.Add(Tr('language.option.portuguese_brazil', 'Portuguese (Brazil)'));
      comboLanguage.Items.Add(Tr('language.option.spanish', 'Spanish'));
      comboLanguage.Items.Add(Tr('language.option.french', 'French'));
      comboLanguage.Items.Add(Tr('language.option.german', 'German'));
      comboLanguage.Items.Add(Tr('language.option.italian', 'Italian'));
      comboLanguage.Items.Add(Tr('language.option.polish', 'Polish'));
      comboLanguage.Items.Add(Tr('language.option.portuguese_portugal', 'Portuguese (Portugal)'));
      comboLanguage.Items.Add(Tr('language.option.romanian', 'Romanian'));
      comboLanguage.Items.Add(Tr('language.option.hungarian', 'Hungarian'));
      comboLanguage.Items.Add(Tr('language.option.czech', 'Czech'));
      comboLanguage.Items.Add(Tr('language.option.japanese', 'Japanese'));
      comboLanguage.Items.Add(Tr('language.option.chinese_simplified', 'Chinese (Simplified)'));
      comboLanguage.Items.Add(Tr('language.option.chinese_traditional', 'Chinese (Traditional)'));
    finally
      comboLanguage.Items.EndUpdate;
    end;

    comboLanguage.Hint := Tr('language.combo.hint', 'Application language');

    case GetCurrentLanguage of
      alPortuguese:   comboLanguage.ItemIndex := 1;
      alSpanish:      comboLanguage.ItemIndex := 2;
      alFrench:       comboLanguage.ItemIndex := 3;
      alGerman:       comboLanguage.ItemIndex := 4;
      alItalian:      comboLanguage.ItemIndex := 5;
      alPolish:       comboLanguage.ItemIndex := 6;
      alPortuguesePT: comboLanguage.ItemIndex := 7;
      alRomanian:     comboLanguage.ItemIndex := 8;
      alHungarian:    comboLanguage.ItemIndex := 9;
      alCzech:        comboLanguage.ItemIndex := 10;
      alJapanese:     comboLanguage.ItemIndex := 11;
      alChineseSimplified:  comboLanguage.ItemIndex := 12;
      alChineseTraditional: comboLanguage.ItemIndex := 13;
    else
      comboLanguage.ItemIndex := 0;
    end;
  finally
    FUpdatingLanguageCombo := False;
  end;
end;

var
  GLangSwitchCeiling: Integer = 0;

procedure LanguageSwitchTick;
begin
  FastFileWatchdogPulse;
  TfrmSmoothLoading.KeepAlive(GLangSwitchCeiling);
end;

procedure TfrmMain.comboLanguageChange(Sender: TObject);
var
  NewLang, OldLang: TAppLanguage;
  LangName, OverlayTitle: string;
  Cancelled: Boolean;
  TimingLog: TStringList;
  TimingStart, TimingLast: Cardinal;

  { Per-step durations in %TEMP%\FastFile_LanguageSwitch.log. }
  procedure Mark(const AStep: string);
  var
    T: Cardinal;
  begin
    T := GetTickCount;
    TimingLog.Add(Format('%-32s %6d ms', [AStep, T - TimingLast]));
    TimingLast := T;
  end;

  function LanguageOptionCaption(ALang: TAppLanguage): string;
  begin
    case ALang of
      alPortuguese:   Result := Tr('language.option.portuguese_brazil', 'Portuguese (Brazil)');
      alSpanish:      Result := Tr('language.option.spanish', 'Spanish');
      alFrench:       Result := Tr('language.option.french', 'French');
      alGerman:       Result := Tr('language.option.german', 'German');
      alItalian:      Result := Tr('language.option.italian', 'Italian');
      alPolish:       Result := Tr('language.option.polish', 'Polish');
      alPortuguesePT: Result := Tr('language.option.portuguese_portugal', 'Portuguese (Portugal)');
      alRomanian:     Result := Tr('language.option.romanian', 'Romanian');
      alHungarian:    Result := Tr('language.option.hungarian', 'Hungarian');
      alCzech:        Result := Tr('language.option.czech', 'Czech');
      alJapanese:     Result := Tr('language.option.japanese', 'Japanese');
      alChineseSimplified:  Result := Tr('language.option.chinese_simplified', 'Chinese (Simplified)');
      alChineseTraditional: Result := Tr('language.option.chinese_traditional', 'Chinese (Traditional)');
    else
      Result := Tr('language.option.english', 'English');
    end;
  end;

  { APercent = where the bar is now; ACeiling = how far it may creep while
    the following (blocking) step runs. }
  procedure OverlayStep(APercent, ACeiling: Integer; const ADetailKey: string);
  begin
    GLangSwitchCeiling := ACeiling;
    TfrmSmoothLoading.UpdateProgressWithDetail(APercent, TrText(ADetailKey));
    TfrmSmoothLoading.FlushPaint;
  end;

  function StepCancelled(APercent, ACeiling: Integer; const ADetailKey: string): Boolean;
  begin
    OverlayStep(APercent, ACeiling, ADetailKey);
    FastFileWatchdogPulse;
    Result := TfrmSmoothLoading.PumpCancelInput;
  end;

begin
  if FUpdatingLanguageCombo then Exit;
  if not Assigned(comboLanguage) then Exit;

  case comboLanguage.ItemIndex of
    1:  NewLang := alPortuguese;
    2:  NewLang := alSpanish;
    3:  NewLang := alFrench;
    4:  NewLang := alGerman;
    5:  NewLang := alItalian;
    6:  NewLang := alPolish;
    7:  NewLang := alPortuguesePT;
    8:  NewLang := alRomanian;
    9:  NewLang := alHungarian;
    10: NewLang := alCzech;
    11: NewLang := alJapanese;
    12: NewLang := alChineseSimplified;
    13: NewLang := alChineseTraditional;
  else
    NewLang := alEnglish;
  end;

  if NewLang = GetCurrentLanguage then Exit;
  OldLang := GetCurrentLanguage;

  { Overlay first (still in the old language): loading the new language's
    table on first use is itself slow and must not run behind a frozen UI. }
  LangName := LanguageOptionCaption(NewLang);
  OverlayTitle := Format(TrText('Language.Loading.Title'), [LangName]);
  TfrmSmoothLoading.ResetCancel;
  TfrmSmoothLoading.ShowLoading(OverlayTitle, False);
  TfrmSmoothLoading.SetCancelVisible(True);
  TfrmSmoothLoading.SnapFullyOpaque;
  FastFileWatchdogBeginHeavyOp('Language switch');
  RetranslateTickProc := LanguageSwitchTick;
  TimingLog := TStringList.Create;
  TimingStart := GetTickCount;
  TimingLast := TimingStart;
  TimingLog.Add(Format('%s -> %s  %s', [AppLanguageCode(OldLang),
    AppLanguageCode(NewLang), FormatDateTime('yyyy-mm-dd hh:nn:ss', Now)]));
  try
    Mark('ShowLoading');
    OverlayStep(3, 10, 'Language.Loading.Preparing');
    SetCurrentLanguage(NewLang);
    Mark('SetCurrentLanguage (load table)');
    sStoreUtils.WriteIniStr(APPLICATION_NAME, 'Language', AppLanguageCode(GetCurrentLanguage), IniName);
    LangName := LanguageOptionCaption(NewLang);
    OverlayTitle := Format(TrText('Language.Loading.Title'), [LangName]);
    TfrmSmoothLoading.SetWaitTexts(OverlayTitle, '');

    { Cancel is polled continuously but acted on between steps; a cancel
      rolls every step back to OldLang. }
    Cancelled := StepCancelled(10, 10, 'Language.Loading.Preparing');
    Mark('INI + overlay title');
    if not Cancelled then
    begin
      { Open tabs / hosted forms / dialogs keep the old language otherwise.
        Runs before ApplyConfigs so the main form's explicit captions win. }
      Cancelled := StepCancelled(12, 55, 'Language.Loading.Menus');
      if not Cancelled then
      begin
        RetranslateAllForms(OldLang);
        Mark('RetranslateAllForms');
        Cancelled := StepCancelled(55, 70, 'Language.Loading.Menus');
      end;
    end;
    if not Cancelled then
    begin
      GApplyConfigsTiming := TimingLog;
      try
        ApplyConfigs;
      finally
        GApplyConfigsTiming := nil;
      end;
      Mark('ApplyConfigs');
      LanguageSwitchTick;
      RelocalizeHostedToolTabs;
      Mark('RelocalizeHostedToolTabs');
      Cancelled := StepCancelled(70, 85, 'Language.Loading.Recent');
    end;
    if not Cancelled then
    begin
      LocalizeRecentFilesTab;
      PopulateRecentFilesTab;
      Mark('Recent files');
      Cancelled := StepCancelled(85, 95, 'Language.Loading.Assistant');
    end;
    if not Cancelled then
    begin
      RetranslateFastFileAssistant(OldLang);
      RefreshFastFileAssistantSurface;
      Mark('Assistant');
      Cancelled := StepCancelled(95, 95, 'Language.Loading.Finish');
    end;

    if Cancelled then
    begin
      TfrmSmoothLoading.SetCancelVisible(False);
      SetCurrentLanguage(OldLang);
      sStoreUtils.WriteIniStr(APPLICATION_NAME, 'Language', AppLanguageCode(OldLang), IniName);
      TfrmSmoothLoading.SetWaitTexts(Format(TrText('Language.Loading.Title'),
        [LanguageOptionCaption(OldLang)]), '');
      OverlayStep(20, 60, 'Language.Loading.Reverting');
      { Reverse lookup from NewLang: texts never switched are left untouched. }
      RetranslateAllForms(NewLang);
      OverlayStep(60, 80, 'Language.Loading.Reverting');
      ApplyConfigs;
      LanguageSwitchTick;
      RelocalizeHostedToolTabs;
      LocalizeRecentFilesTab;
      PopulateRecentFilesTab;
      OverlayStep(80, 95, 'Language.Loading.Reverting');
      RetranslateFastFileAssistant(NewLang);
      RefreshFastFileAssistantSurface;
      SyncLanguageComboWithCurrent;
      Mark('Cancel + revert');
    end;
    UpdateStatusBar(Tr('status.system_ready', 'System Ready'), iaRight);
    OverlayStep(100, 100, 'Language.Loading.Finish');
    Mark('Finish');
  finally
    RetranslateTickProc := nil;
    FastFileWatchdogEndHeavyOp;
    TfrmSmoothLoading.ResetCancel;
    TfrmSmoothLoading.HideLoading;
    Mark('HideLoading');
    TimingLog.Add(Format('%-32s %6d ms', ['TOTAL', GetTickCount - TimingStart]));
    try
      TimingLog.SaveToFile(IncludeTrailingPathDelimiter(GetEnvironmentVariable('TEMP')) +
        'FastFile_LanguageSwitch.log', TEncoding.UTF8);
    except
    end;
    TimingLog.Free;
  end;
end;

var
  { Startup profile: %TEMP%\FastFile_Startup.log (written once per run). }
  GStartupLog: TStringList = nil;
  GStartupLast: Cardinal = 0;
  GStartupDone: Boolean = False;

function MsSinceProcessStart: Int64;
var
  CreationFT, ExitFT, KernelFT, UserFT, NowFT: TFileTime;
begin
  Result := -1;
  if not GetProcessTimes(GetCurrentProcess, CreationFT, ExitFT, KernelFT, UserFT) then Exit;
  GetSystemTimeAsFileTime(NowFT);
  Result := (Int64(NowFT) - Int64(CreationFT)) div 10000;
end;

procedure StartupMark(const AStep: string);
var
  T: Cardinal;
begin
  if GStartupDone then Exit;
  T := GetTickCount;
  if not Assigned(GStartupLog) then
  begin
    GStartupLog := TStringList.Create;
    GStartupLog.Add(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now));
    GStartupLog.Add(Format('%-40s %6d ms', ['Process start -> first mark', MsSinceProcessStart]));
    GStartupLast := T;
  end;
  GStartupLog.Add(Format('%-40s %6d ms', [AStep, T - GStartupLast]));
  GStartupLast := T;
end;

procedure StartupFlush;
begin
  if GStartupDone or not Assigned(GStartupLog) then Exit;
  GStartupLog.Add(Format('%-40s %6d ms', ['TOTAL since process start', MsSinceProcessStart]));
  try
    GStartupLog.SaveToFile(IncludeTrailingPathDelimiter(GetEnvironmentVariable('TEMP')) +
      'FastFile_Startup.log', TEncoding.UTF8);
  except
  end;
  FreeAndNil(GStartupLog);
  GStartupDone := True;
end;


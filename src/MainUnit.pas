function TfrmMain.GetReadListViewHeaderHeight: Integer;
var
  Hdr: HWND;
  R: TRect;
begin
  Result := 22;
  if not Assigned(ListView1) then Exit;
  if not ListView1.HandleAllocated then
  begin
    ListView1.HandleNeeded;
    if not ListView1.HandleAllocated then Exit;
  end;
  Hdr := SendMessage(ListView1.Handle, LVM_GETHEADER, 0, 0);
  if Hdr <> 0 then
  begin
    if Windows.GetWindowRect(Hdr, R) then
      Result := R.Bottom - R.Top;
  end;
  if Result < 18 then
    Result := 18;
end;

procedure TfrmMain.SyncSelectModeListViewHeader;
var
  HdrH: Integer;
begin
  if not Assigned(ListView1) then Exit;
  if isChecked then
  begin
    ListView1.HandleNeeded;
    HdrH := GetReadListViewHeaderHeight;
    ListView1.Visible := True;
    if ListView1.Align <> alTop then
      ListView1.Align := alTop;
    if ListView1.Height <> HdrH then
      ListView1.Height := HdrH;
    if ListView1.Items.Count <> 0 then
      ListView1.Items.Count := 0;
    ListView1.Invalidate;
    if Assigned(pnlCenter) and (FListViewZoomBatchDepth = 0) then
      pnlCenter.Realign;
  end
  else
  begin
    if ListView1.Align <> alClient then
      ListView1.Align := alClient;
    ListView1.Visible := True;
    if Assigned(pnlCenter) and (FListViewZoomBatchDepth = 0) then
      pnlCenter.Realign;
  end;
end;

procedure TfrmMain.SyncCheckListLayoutAfterSelectMode;
begin
  if not isChecked or not Assigned(FCheckListBox) then Exit;
  FCheckListBox.HandleNeeded;
  if Assigned(FCheckListBox.Parent) and (FListViewZoomBatchDepth = 0) then
    FCheckListBox.Parent.Realign;
  if FListViewZoomBatchDepth = 0 then
    FCheckListBox.Perform(WM_SIZE, 0, 0);
  if Assigned(ListView1) and ListView1.HandleAllocated and (FListViewZoomBatchDepth = 0) then
    ListView1Resize(ListView1);
  SetCheckListVisualRowHeight(ListViewVisualRowHeight);
  if FFindMatchSelection then
  begin
    if isChecked then
      UpdateFindMatchSelectionRectsCheckList
    else
      UpdateFindMatchSelectionRectsListView;
  end;
  if FListViewZoomBatchDepth = 0 then
    FCheckListBox.Invalidate;
end;

procedure TfrmMain.WMCheckListLayout(var Msg: TMessage);

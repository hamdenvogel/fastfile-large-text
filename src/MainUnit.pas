function TfrmMain.IsRecentFilesStartupEnabled: Boolean;
var
  Ini: TIniFile;
  ShowValue: Integer;
begin
  ShowValue := 1;
  if FileExists(IniName) then
  begin
    Ini := TIniFile.Create(IniName);
    try
      ShowValue := Ini.ReadInteger(APPLICATION_NAME, 'WelcomeScreenShow', 1);
    finally
      Ini.Free;
    end;
  end;
  Result := ShowValue <> 0;
end;

procedure TfrmMain.EnsureRecentFilesTabFirstWhenEnabled;
var
  Tab: TsTabSheet;
begin
  if FTabOrderCustom then Exit;

procedure TfrmMain.ScriptPanelMemoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  H: HWND;
  WasReadOnly: Boolean;
  RE: TRichEdit;
begin
  if not (Sender is TWinControl) then Exit;
  H := TWinControl(Sender).Handle;

  { Ctrl+C / Ctrl+Insert: copy selection }
  if (((ssCtrl in Shift) and not (ssAlt in Shift) and (Key = Ord('C'))) or
      ((Key = VK_INSERT) and (Shift = [ssCtrl]))) then
  begin
    SendMessage(H, WM_COPY, 0, 0);
    Key := 0;
    Exit;
  end;

  { Ctrl+V / Shift+Insert: paste (toggle ReadOnly for read-only memos) }
  if (((ssCtrl in Shift) and not (ssAlt in Shift) and (Key = Ord('V'))) or
      ((Key = VK_INSERT) and (Shift = [ssShift]))) then
  begin
    WasReadOnly := False;
    if (Sender = FScriptSuggestionsMemo) then
      WasReadOnly := FScriptSuggestionsMemo.ReadOnly
    else if (Sender = FScriptOutputMemo) then
      WasReadOnly := FScriptOutputMemo.ReadOnly;
    if WasReadOnly then
      SendMessage(H, EM_SETREADONLY, 0, 0);
    try
      SendMessage(H, WM_PASTE, 0, 0);
    finally
      if WasReadOnly then
        SendMessage(H, EM_SETREADONLY, 1, 0);
    end;
    Key := 0;
    Exit;
  end;

  { Ctrl+A / Ctrl+T: select all }
  if (ssCtrl in Shift) and not (ssAlt in Shift) and
     ((Key = Ord('A')) or (Key = Ord('T'))) then
  begin
    SendMessage(H, EM_SETSEL, 0, LPARAM(-1));
    { For RichEdit, ensure caret is visible after select-all }
    if Sender is TRichEdit then
    begin
      RE := TRichEdit(Sender);
      RE.Perform(EM_SCROLLCARET, 0, 0);
    end;
    Key := 0;
    Exit;
  end;
end;

function TfrmMain.HwndInSideChatPanels(AHwnd: HWND): Boolean;
begin
  Result := False;
  if AHwnd = 0 then Exit;
  if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible and FConsumerRAGPanel.HandleAllocated then
    if (AHwnd = FConsumerRAGPanel.Handle) or IsChild(FConsumerRAGPanel.Handle, AHwnd) then
    begin
      Result := True;
      Exit;
    end;
  if Assigned(FConsumerAIPanel) and FConsumerAIPanel.Visible and FConsumerAIPanel.HandleAllocated then
    if (AHwnd = FConsumerAIPanel.Handle) or IsChild(FConsumerAIPanel.Handle, AHwnd) then
    begin
      Result := True;
      Exit;
    end;
  if Assigned(FScriptEnginePanel) and FScriptEnginePanel.Visible and FScriptEnginePanel.HandleAllocated then
    if (AHwnd = FScriptEnginePanel.Handle) or IsChild(FScriptEnginePanel.Handle, AHwnd) then
    begin
      Result := True;
      Exit;
    end;
  if Assigned(FScriptSuggestionsPanel) and FScriptSuggestionsPanel.Visible and
     FScriptSuggestionsPanel.HandleAllocated then
    if (AHwnd = FScriptSuggestionsPanel.Handle) or IsChild(FScriptSuggestionsPanel.Handle, AHwnd) then
    begin
      Result := True;
      Exit;
    end;
  if FastFileAssistantPanelVisible and FastFileAssistantFocusInPanel(AHwnd) then
    Result := True;
end;

function TfrmMain.PointInSideChatPanels(const AScreenPt: TPoint): Boolean;
var
  P: TPoint;
begin
  Result := False;
  if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible then
  begin
    P := FConsumerRAGPanel.ScreenToClient(AScreenPt);
    if PtInRect(FConsumerRAGPanel.ClientRect, P) then
    begin
      Result := True;
      Exit;
    end;
  end;
  if Assigned(FConsumerAIPanel) and FConsumerAIPanel.Visible then
  begin
    P := FConsumerAIPanel.ScreenToClient(AScreenPt);
    if PtInRect(FConsumerAIPanel.ClientRect, P) then
    begin
      Result := True;
      Exit;
    end;
  end;
  if Assigned(FScriptEnginePanel) and FScriptEnginePanel.Visible then
  begin
    P := FScriptEnginePanel.ScreenToClient(AScreenPt);
    if PtInRect(FScriptEnginePanel.ClientRect, P) then
    begin
      Result := True;
      Exit;
    end;
  end;
  if Assigned(FScriptSuggestionsPanel) and FScriptSuggestionsPanel.Visible then
  begin
    P := FScriptSuggestionsPanel.ScreenToClient(AScreenPt);
    if PtInRect(FScriptSuggestionsPanel.ClientRect, P) then
    begin
      Result := True;
      Exit;
    end;
  end;
  if FastFileAssistantPanelVisible and Assigned(FAssistantPanel) and FAssistantPanel.Visible then
  begin
    P := FAssistantPanel.ScreenToClient(AScreenPt);
    if PtInRect(FAssistantPanel.ClientRect, P) then
      Result := True;
  end;
end;

function TfrmMain.TryScrollSideChatWheel(AHwnd: HWND; const AScreenPt: TPoint;
  const AWheelDelta: Integer): Boolean;
var
  TargetWnd: HWND;
  Steps, DeltaLines: Integer;
  P: TPoint;

  function RichUnderPoint(AMemo: TRichEdit): Boolean;
  begin
    Result := False;
    if not Assigned(AMemo) or (not AMemo.Visible) or (not AMemo.HandleAllocated) then Exit;
    P := AMemo.ScreenToClient(AScreenPt);
    Result := PtInRect(AMemo.ClientRect, P);
  end;

  function MemoUnderPoint(AMemo: TMemo): Boolean;
  begin
    Result := False;
    if not Assigned(AMemo) or (not AMemo.Visible) or (not AMemo.HandleAllocated) then Exit;
    P := AMemo.ScreenToClient(AScreenPt);
    Result := PtInRect(AMemo.ClientRect, P);
  end;

begin
  Result := False;
  if AWheelDelta = 0 then Exit;

  TargetWnd := 0;
  if RichUnderPoint(FConsumerRAGMemo) then
    TargetWnd := FConsumerRAGMemo.Handle
  else if RichUnderPoint(FConsumerAIMemo) then
    TargetWnd := FConsumerAIMemo.Handle
  else if RichUnderPoint(FScriptOutputMemo) then
    TargetWnd := FScriptOutputMemo.Handle
  else if RichUnderPoint(FScriptSuggestionsMemo) then
    TargetWnd := FScriptSuggestionsMemo.Handle
  else if MemoUnderPoint(FScriptEditorMemo) then
    TargetWnd := FScriptEditorMemo.Handle
  else if (AHwnd <> 0) and HwndInSideChatPanels(AHwnd) then
    TargetWnd := AHwnd
  else if PointInSideChatPanels(AScreenPt) then
  begin
    if Assigned(FConsumerRAGPanel) and FConsumerRAGPanel.Visible and
       Assigned(FConsumerRAGMemo) and FConsumerRAGMemo.HandleAllocated then
    begin
      P := FConsumerRAGPanel.ScreenToClient(AScreenPt);
      if PtInRect(FConsumerRAGPanel.ClientRect, P) then
        TargetWnd := FConsumerRAGMemo.Handle;
    end;
    if (TargetWnd = 0) and Assigned(FConsumerAIPanel) and FConsumerAIPanel.Visible and
       Assigned(FConsumerAIMemo) and FConsumerAIMemo.HandleAllocated then
    begin
      P := FConsumerAIPanel.ScreenToClient(AScreenPt);
      if PtInRect(FConsumerAIPanel.ClientRect, P) then
        TargetWnd := FConsumerAIMemo.Handle;
    end;
  end;

  if TargetWnd = 0 then Exit;

  Steps := Abs(AWheelDelta) div WHEEL_DELTA;
  if Steps < 1 then Steps := 1;
  DeltaLines := Steps * 3;
  if AWheelDelta > 0 then
    DeltaLines := -DeltaLines;
  SendMessage(TargetWnd, EM_LINESCROLL, 0, DeltaLines);
  Result := True;
end;

procedure TfrmMain.ScriptMemoAppMessage(var Msg: TMsg; var Handled: Boolean);
var
  H: HWND;
  HUnder: HWND;
  IsCtrl, IsAlt, IsShift: Boolean;
  WasRO: Boolean;
  WheelDelta: SmallInt;
  ScreenPt: TPoint;
begin                                    
  if Msg.message = WM_MOUSEWHEEL then
  begin
    WheelDelta := SmallInt(LongInt(Msg.wParam) shr 16);
    { Win64: LPARAM is 8 bytes; TSmallPoint is 4 — cast via Integer. }
    ScreenPt := SmallPointToPoint(TSmallPoint(Integer(Msg.lParam)));
    H := Msg.hwnd;
    HUnder := WindowFromPoint(ScreenPt);
    IsCtrl := (GetKeyState(VK_CONTROL) and $8000) <> 0;
    IsAlt := (GetKeyState(VK_MENU) and $8000) <> 0;

    { Chat sidebars: scroll the transcript, never zoom/scroll the main ListView. }
    if (WheelDelta <> 0) and
       (HwndInSideChatPanels(H) or HwndInSideChatPanels(HUnder) or PointInSideChatPanels(ScreenPt)) then
    begin
      if TryScrollSideChatWheel(HUnder, ScreenPt, WheelDelta) or
         TryScrollSideChatWheel(H, ScreenPt, WheelDelta) then
        Handled := True
      else
        Handled := False;
      Exit;
    end;

    { Preview do historico / diff: Ctrl+roda desloca essa lista, nao faz zoom da ListView principal. }
    if Assigned(FCompareMergeHosted) and (FCompareMergeHosted is TfrmCompareMerge) and
       TfrmCompareMerge(FCompareMergeHosted).TryScrollWheelAt(ScreenPt, WheelDelta) then
    begin
      Handled := True;
      Exit;
    end;

    if IsCtrl and not IsAlt and Assigned(ListView1) then
    begin
      if WheelDelta <> 0 then
      begin
        { Checklist Select: zoom aqui (DoMouseWheel nem sempre recebe WM_MOUSEWHEEL no D10.4). }
        if isChecked and Assigned(FCheckListBox) and FCheckListBox.HandleAllocated
           and ((H = FCheckListBox.Handle) or IsChild(FCheckListBox.Handle, H)) then
        begin
          ApplyListViewWheelZoom(WheelDelta);
          Handled := True;
          Exit;
        end;
        { ListView: hook WM_MOUSEWHEEL ja trata. }
        if (not ListView1.HandleAllocated)
           or (H = ListView1.Handle) or IsChild(ListView1.Handle, H) then
          { pass through }
        else
        begin
          ApplyListViewWheelZoom(WheelDelta);
          Handled := True;
        end;
      end;
    end;
    Exit;
  end;

  if Msg.message = WM_KEYDOWN then
  begin
    H := Msg.hwnd;
    if FastFileAssistantPanelVisible and FastFileAssistantFocusInPanel(H) then
    begin
      IsCtrl  := (GetKeyState(VK_CONTROL) and $8000) <> 0;
      IsAlt   := (GetKeyState(VK_MENU)    and $8000) <> 0;
      IsShift := (GetKeyState(VK_SHIFT)   and $8000) <> 0;
      if IsCtrl and not IsAlt and not IsShift then
      begin
        case Msg.wParam of
          Ord('X'):
            begin
              if (GetWindowLong(H, GWL_STYLE) and ES_READONLY) = 0 then
                SendMessage(H, WM_CUT, 0, 0);
              Handled := True;
              Exit;
            end;
          Ord('V'):
            begin
              if (GetWindowLong(H, GWL_STYLE) and ES_READONLY) = 0 then
                SendMessage(H, WM_PASTE, 0, 0);
              Handled := True;
              Exit;
            end;
          Ord('C'):
            begin
              SendMessage(H, WM_COPY, 0, 0);
              Handled := True;
              Exit;
            end;
          Ord('A'):
            begin
              SendMessage(H, EM_SETSEL, 0, LPARAM(-1));
              Handled := True;
              Exit;
            end;
        end;
      end;
    end;
  end;

  if Assigned(FScriptMemoAppMsgSaved) then
    FScriptMemoAppMsgSaved(Msg, Handled);
  if Handled then Exit;
  if Msg.message <> WM_KEYDOWN then Exit;

  H := Msg.hwnd;

  { Only act when one of the three script-panel memos has Win32 focus }
  if not (
    (Assigned(FScriptSuggestionsMemo) and FScriptSuggestionsMemo.HandleAllocated
      and (H = FScriptSuggestionsMemo.Handle)) or
    (Assigned(FScriptEditorMemo) and FScriptEditorMemo.HandleAllocated
      and (H = FScriptEditorMemo.Handle)) or
    (Assigned(FScriptOutputMemo) and FScriptOutputMemo.HandleAllocated
      and (H = FScriptOutputMemo.Handle))
  ) then Exit;

  IsCtrl  := (GetKeyState(VK_CONTROL) and $8000) <> 0;
  IsAlt   := (GetKeyState(VK_MENU)    and $8000) <> 0;
  IsShift := (GetKeyState(VK_SHIFT)   and $8000) <> 0;

  if IsCtrl and not IsAlt then
  begin
    case Msg.wParam of
      Ord('C'):
      begin
        SendMessage(H, WM_COPY, 0, 0);
        Handled := True;
      end;
      Ord('V'):
      begin
        { Toggle ReadOnly for read-only memos before paste }
        WasRO := False;
        if Assigned(FScriptSuggestionsMemo) and FScriptSuggestionsMemo.HandleAllocated
           and (H = FScriptSuggestionsMemo.Handle) and FScriptSuggestionsMemo.ReadOnly then
          WasRO := True
        else if Assigned(FScriptOutputMemo) and FScriptOutputMemo.HandleAllocated
           and (H = FScriptOutputMemo.Handle) and FScriptOutputMemo.ReadOnly then
          WasRO := True;
        if WasRO then SendMessage(H, EM_SETREADONLY, 0, 0);
        try
          SendMessage(H, WM_PASTE, 0, 0);
        finally
          if WasRO then SendMessage(H, EM_SETREADONLY, 1, 0);
        end;
        Handled := True;
      end;
      Ord('A'), Ord('T'):
      begin
        SendMessage(H, EM_SETSEL, 0, LPARAM(-1));
        Handled := True;
      end;
      VK_INSERT:
      begin
        { Ctrl+Insert = copy }
        SendMessage(H, WM_COPY, 0, 0);
        Handled := True;
      end;
    end;
  end
  else if IsShift and not IsCtrl and not IsAlt then
  begin
    if Msg.wParam = VK_INSERT then
    begin
      { Shift+Insert = paste }
      WasRO := False;
      if Assigned(FScriptSuggestionsMemo) and FScriptSuggestionsMemo.HandleAllocated
         and (H = FScriptSuggestionsMemo.Handle) and FScriptSuggestionsMemo.ReadOnly then
        WasRO := True
      else if Assigned(FScriptOutputMemo) and FScriptOutputMemo.HandleAllocated
         and (H = FScriptOutputMemo.Handle) and FScriptOutputMemo.ReadOnly then
        WasRO := True;
      if WasRO then SendMessage(H, EM_SETREADONLY, 0, 0);
      try
        SendMessage(H, WM_PASTE, 0, 0);
      finally
        if WasRO then SendMessage(H, EM_SETREADONLY, 1, 0);
      end;
      Handled := True;
    end;
  end;
end;

procedure TfrmMain.ScriptPanelMouseWheel(Sender: TObject; Shift: TShiftState; WheelDelta: Integer; MousePos: TPoint; var Handled: Boolean);
var
  Steps: Integer;
  DeltaLines: Integer;
  TargetWnd: HWND;
begin
  Steps := Abs(WheelDelta) div WHEEL_DELTA;
  if Steps < 1 then Steps := 1;
  DeltaLines := Steps * 3;
  if WheelDelta > 0 then
    DeltaLines := -DeltaLines;

  TargetWnd := 0;
  if Sender is TRichEdit then
    TargetWnd := TRichEdit(Sender).Handle
  else if Sender is TMemo then
    TargetWnd := TMemo(Sender).Handle
  else if Assigned(ActiveControl) and (ActiveControl is TRichEdit) then
    TargetWnd := TRichEdit(ActiveControl).Handle
  else if Assigned(ActiveControl) and (ActiveControl is TMemo) then
    TargetWnd := TMemo(ActiveControl).Handle
  else if Assigned(FScriptSuggestionsMemo) and FScriptSuggestionsMemo.Visible then
    TargetWnd := FScriptSuggestionsMemo.Handle
  else if Assigned(FScriptOutputMemo) and FScriptOutputMemo.Visible then
    TargetWnd := FScriptOutputMemo.Handle
  else if Assigned(FScriptEditorMemo) and FScriptEditorMemo.Visible then
    TargetWnd := FScriptEditorMemo.Handle;

  if TargetWnd <> 0 then
  begin
    SendMessage(TargetWnd, EM_LINESCROLL, 0, DeltaLines);
    Handled := True;
  end;
end;


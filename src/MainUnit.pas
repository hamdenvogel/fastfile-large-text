procedure TfrmMain.ToggleTailMode;
begin
  if FTailActive then
    StopTailFollowMode
  else begin
    if CurrentEffectiveFilePath = '' then begin ShowAppMessage('Please select a file first.'); Exit; end;
    if not FileExists(CurrentEffectiveFilePath) then begin ShowAppMessage('File not found.'); Exit; end;
    if not Assigned(FSourceFileStream) then begin ShowAppMessage('Please read the file first.'); Exit; end;
    FTailLastFileSize := SourceFileSize64;
    FTailLastLineCount := totalLines;
    FTailHighlightFromLine := 0;
    FTailPaused := False;
    FTailPendingLines := 0;
    FTailSessionFirstLine := totalLines;
    { Macro Python e opcional: ao ligar Tail, comecar com checkbox desmarcado. }
    FTailMacroEnabled := False;
    if Assigned(FTailMacroEnabledCB) then
      FTailMacroEnabledCB.Checked := False;
    FTailActive := True;
    tmrTail.Enabled := True;
    UpdateStatusBar(TrText('Tail ON'), iaRight);
    if totalLines > 0 then
      gotoLine(totalLines - 1);
    if Assigned(FToolsExtrasTail) then
      FToolsExtrasTail.Checked := True;
    if Assigned(FToolsExtrasTailPause) then
      FToolsExtrasTailPause.Enabled := True;
    if Assigned(FMenuTailPauseItem) then
      FMenuTailPauseItem.Enabled := True;
    ShowTailMacroPanel;
  end;
  UpdateTailMacroPanelState;
end;

procedure TfrmMain.tmrTailTimer(Sender: TObject);
var
  hFile: THandle;
  SizeLow: DWORD;
  SizeHigh: DWORD;
  CurrentSize: Int64;
begin
  if FApplicationClosing then
  begin
    if Assigned(tmrTail) then
      tmrTail.Enabled := False;
    Exit;
  end;
  if not FTailActive then Exit;
  if CurrentEffectiveFilePath = '' then Exit;
  hFile := CreateFile(PChar(CurrentEffectiveFilePath), GENERIC_READ,
    FILE_SHARE_READ or FILE_SHARE_WRITE, nil, OPEN_EXISTING,
    FILE_ATTRIBUTE_NORMAL, 0);
  if hFile = INVALID_HANDLE_VALUE then Exit;
  try
    SizeLow := Windows.GetFileSize(hFile, @SizeHigh);
    if SizeLow = INVALID_FILE_SIZE then Exit;
    CurrentSize := Int64(SizeHigh) shl 32 or Int64(SizeLow);
  finally
    CloseHandle(hFile);
  end;
  if CurrentSize > FTailLastFileSize then
    TailAppendNewLines;
end;

procedure WriteTailIndexOffsetRecord(AIndexStream: TFileStream; AOffset1Based: Int64);
var
  OffsetBuf: array[0..19] of AnsiChar;
  J, Digit: Integer;
  TempVal: Int64;
begin
  for J := 0 to 17 do OffsetBuf[J] := ' ';
  TempVal := Abs(AOffset1Based);
  J := 17;
  repeat
    Digit := TempVal mod 10;
    OffsetBuf[J] := AnsiChar(Byte('0') + Digit);
    TempVal := TempVal div 10;
    Dec(J);
  until (TempVal = 0) or (J < 0);
  OffsetBuf[18] := #13;
  OffsetBuf[19] := #10;
  AIndexStream.Write(OffsetBuf, 20);
end;

procedure TfrmMain.TailAppendNewLines;
var
  EffPath: string;
  SourceFile: TFileStream;
  IndexFile: TFileStream;
  IndexPath: string;
  OldSize, NewSize: Int64;
  OldLineCount: Int64;
  DeltaSize: Int64;
  ChunkOff: Int64;
  ChunkLeft: Int64;
  ChunkThis: Integer;
  Buffer: PAnsiChar;
  BytesRead: Integer;
  I: Integer;
  NewLines: Int64;
  CurrentLineStart1: Int64;
  FirstNewLine1, LastNewLine1: Int64;
  CkptPath: string;
  CkptFile: TFileStream;
  LineNumInFile: Int64;
  AbsPos: Int64;
  TermCh: AnsiChar;
begin
  if FApplicationClosing then Exit;
  if TfrmSmoothLoading.HeavyFileMutateHoldActive then Exit;
  EffPath := CurrentEffectiveFilePath;
  tmrTail.Enabled := False;
  try
    if (EffPath = '') or (not FileExists(EffPath)) then Exit;
    TermCh := LineTermCharForFile(EffPath);
    IndexPath := FastFileExeDirPath(TEMPFILE);
    if not FileExists(IndexPath) then
    begin
      { Zero Scan / sparse: contar novas linhas no delta sem temp.txt (tail follow). }
      SourceFile := nil;
      CkptFile := nil;
      try
        SourceFile := TFileStream.Create(EffPath, fmOpenRead or fmShareDenyNone);
        NewSize := SourceFile.Size;
        OldSize := FTailLastFileSize;
        if NewSize <= OldSize then Exit;
        DeltaSize := NewSize - OldSize;
        OldLineCount := FTailLastLineCount;
        NewLines := 0;
        LineNumInFile := OldLineCount;
        CurrentLineStart1 := OldSize + 1;
        CkptPath := FastFileExeDirPath(TEMP_CKPT_FILE);
        if FileExists(CkptPath) then
        begin
          CkptFile := TFileStream.Create(CkptPath, fmOpenReadWrite or fmShareDenyNone);
          CkptFile.Seek(0, soFromEnd);
        end;
        ChunkOff := 0;
        GetMem(Buffer, 64 * 1024);
        try
          while ChunkOff < DeltaSize do
          begin
            ChunkLeft := DeltaSize - ChunkOff;
            if ChunkLeft > 64 * 1024 then ChunkThis := 64 * 1024 else ChunkThis := Integer(ChunkLeft);
            SourceFile.Seek(OldSize + ChunkOff, Word(soFromBeginning));
            BytesRead := SourceFile.Read(Buffer^, ChunkThis);
            if BytesRead <= 0 then Break;
            for I := 0 to BytesRead - 1 do
            begin
              if Buffer[I] = TermCh then
              begin
                Inc(NewLines);
                Inc(LineNumInFile);
                if Assigned(CkptFile) and ((LineNumInFile mod CKPT_INTERVAL) = 0) then
                  WriteTailIndexOffsetRecord(CkptFile, CurrentLineStart1);
                AbsPos := OldSize + ChunkOff + I;
                CurrentLineStart1 := AbsPos + 2;
              end;
            end;
            Inc(ChunkOff, BytesRead);
          end;
        finally
          FreeMem(Buffer);
          Buffer := nil;
        end;
        if Assigned(CkptFile) then
          FreeAndNil(CkptFile);
        FTailLastFileSize := NewSize;
        if NewLines > 0 then FTailHighlightFromLine := OldLineCount;
        if FTailPaused then Inc(FTailPendingLines, NewLines);
        FTailLastLineCount := OldLineCount + NewLines;
        totalLines := FTailLastLineCount;
        FZeroScanPhysicalLineCount := 0;
        FZeroScanEndLineStartByte := 0;
        FZeroScanEndScrollOffset := 0;
        ItemCount := totalLines;
        OpenFileStreams(EffPath);
        InvalidateLineCache;
        if Assigned(ListView1) then
        begin
          ListView1.Items.Count := FTailLastLineCount;
          ListView1.Invalidate;
          if (not FTailPaused) and (NewLines > 0) and (NewLines <= MAX_TAIL_GOTO_LINES) then
            gotoLine(FTailLastLineCount - 1);
        end;
      finally
        if Assigned(SourceFile) then FreeAndNil(SourceFile);
      end;
      Exit;
    end;
    CloseFileStreams;
    SourceFile := nil;
    IndexFile := nil;
    Buffer := nil;
    try
      SourceFile := TFileStream.Create(EffPath, fmOpenRead or fmShareDenyNone);
      NewSize := SourceFile.Size;
      OldSize := FTailLastFileSize;
      if NewSize <= OldSize then begin
        FreeAndNil(SourceFile);
        OpenFileStreams(EffPath);
        Exit;
      end;
      DeltaSize := NewSize - OldSize;
      OldLineCount := FTailLastLineCount;
      IndexFile := TFileStream.Create(IndexPath, fmOpenReadWrite or fmShareDenyNone);
      IndexFile.Seek(0, soFromEnd);
      NewLines := 0;
      CurrentLineStart1 := OldSize + 1;
      ChunkOff := 0;
      while ChunkOff < DeltaSize do
      begin
        ChunkLeft := DeltaSize - ChunkOff;
        if ChunkLeft > MAX_TAIL_READ_CHUNK then
          ChunkThis := MAX_TAIL_READ_CHUNK
        else
          ChunkThis := Integer(ChunkLeft);
        GetMem(Buffer, ChunkThis);
        try
          SourceFile.Seek(OldSize + ChunkOff, Word(soFromBeginning));
          BytesRead := SourceFile.Read(Buffer^, ChunkThis);
          if BytesRead <= 0 then Break;
          for I := 0 to BytesRead - 1 do
          begin
            if Buffer[I] = TermCh then
            begin
              WriteTailIndexOffsetRecord(IndexFile, CurrentLineStart1);
              Inc(NewLines);
              CurrentLineStart1 := OldSize + ChunkOff + I + 2;
            end;
          end;
          Inc(ChunkOff, BytesRead);
          if BytesRead < ChunkThis then Break;
        finally
          FreeMem(Buffer);
          Buffer := nil;
        end;
      end;
      { Ultima linha sem #10 no fim do ficheiro tambem conta e precisa de entrada no indice }
      if (DeltaSize > 0) and (CurrentLineStart1 <= NewSize) then
      begin
        WriteTailIndexOffsetRecord(IndexFile, CurrentLineStart1);
        Inc(NewLines);
      end;
      FTailLastFileSize := NewSize;
      if NewLines > 0 then
        FTailHighlightFromLine := OldLineCount;
      if FTailPaused then
        Inc(FTailPendingLines, NewLines);
      FTailLastLineCount := OldLineCount + NewLines;
      totalLines := FTailLastLineCount;
      ItemCount := totalLines;
      FZeroScanPhysicalLineCount := 0;
      FZeroScanEndLineStartByte := 0;
      FZeroScanEndScrollOffset := 0;
    finally
      if Assigned(IndexFile) then FreeAndNil(IndexFile);
      if Assigned(SourceFile) then FreeAndNil(SourceFile);
    end;
    OpenFileStreams(EffPath);
    InvalidateLineCache;
    if Assigned(ListView1) then begin
      ListView1.Items.Count := FTailLastLineCount;
      ListView1.Invalidate;
      { evita gotoLine caro quando chegam muitas linhas de uma vez }
      if (not FTailPaused) and (FTailLastLineCount > 0) and
         (NewLines > 0) and (NewLines <= MAX_TAIL_GOTO_LINES) then
        gotoLine(FTailLastLineCount - 1);
    end;
    { atualiza status com contagem pendente quando pausado }
    if FTailPaused and (FTailPendingLines > 0) then
      UpdateStatusBar(Format(TrText('Tail PAUSED +%d new lines'), [FTailPendingLines]), iaRight)
    else if not FTailPaused then
      UpdateStatusBar(TrText('Tail ON'), iaRight);
    if (NewLines > 0) and TailMacroShouldProcessNewLines then
    begin
      FirstNewLine1 := OldLineCount + 1;
      LastNewLine1 := FTailLastLineCount;
      EnsureTailMacroPanel;
      TailMacroLog(Format(TrText('Tail macro: %d new line(s) detected...'), [NewLines]));
      RunTailMacroOnNewLines(FirstNewLine1, LastNewLine1, True);
      Application.ProcessMessages;
    end;
    UpdateTailMacroPanelState;
  finally
    if FTailActive then tmrTail.Enabled := True;
  end;
end;

procedure TfrmMain.ToggleTailPause;
begin
  if not FTailActive then Exit;
  FTailPaused := not FTailPaused;
  if FTailPaused then
  begin
    FTailPendingLines := 0;
    UpdateStatusBar(TrText('Tail PAUSED'), iaRight);
    if Assigned(FToolsExtrasTailPause) then
      FToolsExtrasTailPause.Checked := True;
    if Assigned(FMenuTailPauseItem) then
      FMenuTailPauseItem.Checked := True;
  end else
  begin
    { ao retomar: scrolla para o fim e limpa o destaque anterior }
    FTailPendingLines := 0;
    UpdateStatusBar(TrText('Tail ON'), iaRight);
    if Assigned(FToolsExtrasTailPause) then
      FToolsExtrasTailPause.Checked := False;
    if Assigned(FMenuTailPauseItem) then
      FMenuTailPauseItem.Checked := False;
    if Assigned(ListView1) and (FTailLastLineCount > 0) then
    begin
      ListView1.Invalidate;
      gotoLine(FTailLastLineCount - 1);
    end;
  end;
end;

procedure TfrmMain.miToggleTailPauseClick(Sender: TObject);
begin
  ToggleTailPause;
end;


procedure TfrmMain.AbortScriptEngineRunOnCancel;
begin
  if not TfrmSmoothLoading.CancelRequested then Exit;

  AppendScriptEngineOutput('[INFO] ' + TrText('Script cancelled by user.'));
  CloseScriptDirectOutput;
  FScriptEngineWritesDirectOutput := False;

  { Matar o Python ja (RUNFILE nao para sozinho). Nao chamar StopScriptEngineProcess
    aqui: pode WaitFor o reader thread dentro do Synchronize do proprio reader = deadlock. }
  if FScriptEngineProcessInfo.hProcess <> 0 then
    TerminateProcess(FScriptEngineProcessInfo.hProcess, 1);

  if Assigned(FScriptEngineRunThread) then
    FScriptEngineRunThread.Terminate;

  TfrmSmoothLoading.HideLoading;
  SetScriptEngineStatus(TrText('Cancelled'));
  if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
  if Assigned(FScriptEngineSaveButton) then FScriptEngineSaveButton.Enabled := False;

  PostMessage(Handle, WM_USER + 438, 0, 0);
end;

procedure TfrmMain.WMScriptAbortCleanup(var Msg: TMessage);
begin
  Msg.Result := 0;
  try
    StopScriptEngineProcess;
  finally
    TfrmSmoothLoading.ResetCancel;
  end;
end;

procedure TfrmMain.ScriptSuggestionsLoadContent;
begin
  if not Assigned(FScriptSuggestionsMemo) then Exit;
  FScriptSuggestionsMemo.Lines.Text :=
    TrText('SCRIPT_ENGINE_EXAMPLES_HEADER') + CRLF +
    TrText('SCRIPT_ENGINE_EXAMPLES_DOC') + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_01') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return line.upper()' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_02') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    n = ctx[''line_number'']' + CRLF +
    '    return f"[{n:06d}] {line}"' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_03') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    if line.strip() == '''':' + CRLF +
    '        return None  # blank line -> SKIP' + CRLF +
    '    return line' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_04') + CRLF +
    'KEYWORD = ''error''' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return line if KEYWORD.lower() in line.lower() else None' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_05') + CRLF +
    'import re' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return re.sub(r'' {2,}'', '' '', line.strip())' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_06') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    parts = line.split('';'')' + CRLF +
    '    if len(parts) < 3:' + CRLF +
    '        return None  # invalid -> skip' + CRLF +
    '    name, date, value = parts[0], parts[1], parts[2]' + CRLF +
    '    return f"{name.strip()} | {date.strip()} | R$ {value.strip()}"' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_07') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    words = line.split()' + CRLF +
    '    return f"{len(words):3d} words: {line}"' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_08') + CRLF +
    'REPLACEMENTS = {''error'': ''ERROR'', ''warning'': ''WARNING'', ''info'': ''INFO''}' + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    result = line' + CRLF +
    '    for old, new in REPLACEMENTS.items():' + CRLF +
    '        result = result.replace(old, new)' + CRLF +
    '    return result' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_09') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    count = ctx.get(''count'', 0) + 1' + CRLF +
    '    ctx[''count''] = count' + CRLF +
    '    return f"#{count} {line}"' + CRLF +
    CRLF + FF_SCRIPT_SUGGESTIONS_SEP +
    TrText('PY_MACRO_EX_10_SCRIPT') + CRLF +
    'def transform(line, ctx):' + CRLF +
    '    return int(line)  # fails if line is not a number' + CRLF;
end;

function TfrmMain.FormatScriptElapsed(const AElapsedMs: Cardinal): string;
var
  Hours, Minutes, Seconds, Millis: Cardinal;
begin
  Hours := AElapsedMs div 3600000;
  Minutes := (AElapsedMs div 60000) mod 60;
  Seconds := (AElapsedMs div 1000) mod 60;
  Millis := AElapsedMs mod 1000;

  if Hours > 0 then
    Result := Format('%d:%2.2d:%2.2d.%3.3d', [Hours, Minutes, Seconds, Millis])
  else
    Result := Format('%2.2d:%2.2d.%3.3d', [Minutes, Seconds, Millis]);
end;

procedure TfrmMain.AppendScriptEngineOutput(const AText: string);
begin
  if not Assigned(FScriptOutputMemo) then Exit;
  FScriptOutputMemo.Lines.Add(AText);
  if FScriptOutputBatchDepth <= 0 then
    SendMessage(FScriptOutputMemo.Handle, WM_VSCROLL, SB_BOTTOM, 0);
end;

procedure TfrmMain.HandleScriptEngineProtocolBatch(const ABatchText: string);
var
  Lines: TStringList;
  I: Integer;
  OutLines: TStringList;
  BulkText: string;
  Colon1, Colon2: Integer;
begin
  if FApplicationClosing then Exit;
  if ABatchText = '' then Exit;

  Lines := TStringList.Create;
  OutLines := TStringList.Create;
  try
    Lines.Text := StringReplace(ABatchText, #10, #13#10, [rfReplaceAll]);
    if FTailMacroProcessing then
    begin
      for I := 0 to Lines.Count - 1 do
        if Trim(Lines[I]) <> '' then
          HandleTailMacroProtocolLine(Lines[I]);
      Exit;
    end;
    Inc(FScriptOutputBatchDepth);
    { Activate bulk-insert mode: OUT: lines are accumulated and written to the
      TRichEdit in a single EM_REPLACESEL after the loop instead of individual
      Lines.Add calls. Only active when output goes to the TRichEdit (not to
      a direct output file). }
    FScriptBulkOutBatch := not FScriptEngineWritesDirectOutput and not FScriptDirectOutputMode;
    if Assigned(FScriptOutputMemo) then
      FScriptOutputMemo.Lines.BeginUpdate;
    try
      for I := 0 to Lines.Count - 1 do
      begin
        { OUT: lines: let HandleScriptEngineProtocolLine update counters only
          (AppendScriptEngineOutput is suppressed by FScriptBulkOutBatch);
          then collect text for the bulk insert. }
        if (Copy(Lines[I], 1, 4) = 'OUT:') and FScriptBulkOutBatch then
        begin
          HandleScriptEngineProtocolLine(Lines[I]);
          Colon1 := PosBMH(':', Lines[I]);
          if Colon1 > 0 then
            Colon2 := PosEx(':', Lines[I], Colon1 + 1)
          else
            Colon2 := 0;
          if Colon2 > 0 then
            OutLines.Add(Copy(Lines[I], Colon2 + 1, MaxInt))
          else if Colon1 > 0 then
            OutLines.Add(Copy(Lines[I], Colon1 + 1, MaxInt));
        end
        else
          HandleScriptEngineProtocolLine(Lines[I]);
      end;

      { Bulk-insert all OUT: texts in one EM_REPLACESEL call.
        This is O(1) for the RTF engine regardless of existing content,
        versus O(n) for every individual Lines.Add. }
      if (OutLines.Count > 0) and Assigned(FScriptOutputMemo) then
      begin
        BulkText := OutLines.Text;  { TStringList.Text uses CR+LF separators }
        SendMessage(FScriptOutputMemo.Handle, EM_SETSEL, MaxInt, MaxInt);
        SendMessage(FScriptOutputMemo.Handle, EM_REPLACESEL, 0, LParam(PChar(BulkText)));
      end;
    finally
      FScriptBulkOutBatch := False;
      if Assigned(FScriptOutputMemo) then
        FScriptOutputMemo.Lines.EndUpdate;
      Dec(FScriptOutputBatchDepth);
    end;

    if Assigned(FScriptOutputMemo) then
      SendMessage(FScriptOutputMemo.Handle, WM_VSCROLL, SB_BOTTOM, 0);
  finally
    OutLines.Free;
    Lines.Free;
  end;
end;

procedure TfrmMain.SetScriptEngineStatus(const AText: string);
begin
  if not AppUiUpdatesAllowed then Exit;
  if Assigned(FScriptStatusLabel) then
  begin
    FScriptStatusLabel.Caption := AText;
    FScriptStatusLabel.Hint := AText;
  end;
end;

procedure TfrmMain.HandleScriptEngineProtocolLine(const ALine: string);
var
  Colon1, Colon2: Integer;
  LineNum, Text: string;
  Summary: string;
  SavedOutFile: string;
  ElapsedInfo: string;
  ElapsedMs: Cardinal;
  TotalSeen: Int64;
begin
  if FApplicationClosing then Exit;
  if FTailMacroProcessing then
  begin
    HandleTailMacroProtocolLine(ALine);
    Exit;
  end;

  if ALine = 'READY' then
  begin
    SetScriptEngineStatus(TrText('Ready'));
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    Exit;
  end;

  if Copy(ALine, 1, 15) = 'ENGINE_VERSION:' then
  begin
    FScriptEngineVersion := StrToIntDef(Trim(Copy(ALine, 16, MaxInt)), 0);
    Exit;
  end;

  if ALine = 'COMPILED_OK' then
  begin
    SignalScriptEngineCompileDone(True, '');
    SetScriptEngineStatus(TrText('Compiled OK - processing lines...'));
    if FScriptDirectOutputMode and (totalLines >= 1000000) then
      AppendScriptEngineOutput('[INFO] ' + TrText('SCRIPT_ENGINE_LARGE_RUN_HINT'));
    Exit;
  end;

  if ALine = 'DONE_ACK' then
  begin
    ReleaseScriptEngineRunThread;
    TfrmSmoothLoading.HideLoading;
    if FScriptRunStartTick <> 0 then
      ElapsedMs := GetTickCount - FScriptRunStartTick
    else
      ElapsedMs := 0;
    ElapsedInfo := Format(TrText('Elapsed time: %s'), [FormatScriptElapsed(ElapsedMs)]);

    TotalSeen := FScriptProcessedOkLines + FScriptSkippedLines + FScriptErrorLines;
    Summary := Format(TrText('Script completed: %d lines processed successfully, %d skipped, %d errors.'),
      [FScriptProcessedOkLines, FScriptSkippedLines, FScriptErrorLines]);
    if (FScriptExpectedLines > 0) and (TotalSeen <> FScriptExpectedLines) then
      Summary := Summary + ' ' + Format(TrText('(Processed %d of %d selected/visible lines.)'),
        [TotalSeen, FScriptExpectedLines]);
    SavedOutFile := FScriptDirectOutputFileName;
    if FScriptDirectOutputMode and (SavedOutFile <> '') then
      SetScriptEngineStatus(
        Format(TrText('SCRIPT_EXPORT_DONE_STATUS'),
          [FScriptProcessedOkLines, FScriptSkippedLines, FScriptErrorLines,
           ExtractFileName(SavedOutFile)]))
    else
      SetScriptEngineStatus(Summary);
    if Assigned(FScriptEngineRunButton)  then FScriptEngineRunButton.Enabled := True;
    if Assigned(FScriptEngineSaveButton) then
      FScriptEngineSaveButton.Enabled := not FScriptDirectOutputMode;
    if FScriptDirectOutputMode and (SavedOutFile <> '') then
      NotifyChatFileSaved(FScriptEnginePanel, SavedOutFile);
    AppendScriptEngineOutput('--- ' + Summary + ' ---');
    AppendScriptEngineOutput('  ' + ElapsedInfo);
    AssistantOfferAfterActivity('script', Summary);
    if SavedOutFile <> '' then
    begin
      AppendScriptEngineOutput('  ' + Format(TrText('SCRIPT_EXPORT_FILE_LINE'),
        [ExtractFileName(SavedOutFile)]));
      AppendScriptEngineOutput('  ' + Format(TrText('SCRIPT_EXPORT_FOLDER_LINE'),
        [ExtractFileDir(SavedOutFile)]));
    end;
    CloseScriptDirectOutput;
    FScriptEngineWritesDirectOutput := False;
    Exit;
  end;

  if Copy(ALine, 1, 14) = 'COMPILE_ERROR:' then
  begin
    Text := Copy(ALine, 15, MaxInt);
    SignalScriptEngineCompileDone(False, Text);
    ReleaseScriptEngineRunThread;
    TfrmSmoothLoading.HideLoading;
    if FScriptRunStartTick <> 0 then
      ElapsedMs := GetTickCount - FScriptRunStartTick
    else
      ElapsedMs := 0;
    ElapsedInfo := Format(TrText('Elapsed time: %s'), [FormatScriptElapsed(ElapsedMs)]);

    SetScriptEngineStatus(TrText('Compile error'));
    CloseScriptDirectOutput;
    AppendScriptEngineOutput('[COMPILE ERROR] ' + Text);
    if (PosBMH('missing SOURCE or INDEX', Text) > 0) or
       (PosBMH('CKPT file not found', Text) > 0) then
      AppendScriptEngineOutput('[INFO] ' + TrText('SCRIPT_ENGINE_REBUILD_HINT'));
    AppendScriptEngineOutput('[INFO] ' + ElapsedInfo);
    if Assigned(FScriptEngineRunButton) then FScriptEngineRunButton.Enabled := True;
    FScriptEngineWritesDirectOutput := False;
    Exit;
  end;

  if Copy(ALine, 1, 11) = 'DONE_STATS:' then
  begin
    { DONE_STATS:<ok>:<skip>:<errors> }
    Text := Copy(ALine, 12, MaxInt);
    Colon1 := PosBMH(':', Text);
    Colon2 := 0;
    if Colon1 > 0 then
      Colon2 := PosEx(':', Text, Colon1 + 1);
    if (Colon1 > 0) and (Colon2 > Colon1) then
    begin
      FScriptProcessedOkLines := StrToInt64Def(Copy(Text, 1, Colon1 - 1), FScriptProcessedOkLines);
      FScriptSkippedLines := StrToInt64Def(Copy(Text, Colon1 + 1, Colon2 - Colon1 - 1), FScriptSkippedLines);
      FScriptErrorLines := StrToInt64Def(Copy(Text, Colon2 + 1, MaxInt), FScriptErrorLines);
    end;
    Exit;
  end;

  if Copy(ALine, 1, 4) = 'OUT:' then
  begin
    { OUT:<linenum>:<text> }
    Colon1 := PosBMH(':', ALine);          { position of first ':' in 'OUT:' }
    Colon2 := PosEx(':', ALine, Colon1 + 1); { second ':' separates linenum from text }
    if Colon2 > 0 then
      Text := Copy(ALine, Colon2 + 1, MaxInt)
    else
      Text := Copy(ALine, Colon1 + 1, MaxInt);
    Inc(FScriptProcessedOkLines);
    if FScriptEngineWritesDirectOutput then
      Exit
    else if FScriptDirectOutputMode then
      WriteScriptDirectOutputLine(Text)
    else if not FScriptBulkOutBatch then
      { FScriptBulkOutBatch=True means HandleScriptEngineProtocolBatch will do
        a single bulk EM_REPLACESEL - skip individual Lines.Add here. }
      AppendScriptEngineOutput(Text);
    Exit;
  end;

  if Copy(ALine, 1, 5) = 'SKIP:' then
  begin
    Inc(FScriptSkippedLines);
    { Silently skip; optionally could show in a different color }
    Exit;
  end;

  if Copy(ALine, 1, 11) = 'LINE_ERROR:' then
  begin
    { LINE_ERROR:<linenum>:<msg> }
    Colon1 := PosBMH(':', ALine);
    Colon2 := PosEx(':', ALine, Colon1 + 1);
    if Colon2 > 0 then
    begin
      LineNum := Copy(ALine, Colon1 + 1, Colon2 - Colon1 - 1);
      Text := Copy(ALine, Colon2 + 1, MaxInt);
    end
    else
    begin
      LineNum := '';
      Text := Copy(ALine, Colon1 + 1, MaxInt);
    end;
    Inc(FScriptErrorLines);
    AppendScriptEngineOutput('[ERROR line ' + LineNum + '] ' + Text);
    Exit;
  end;

  if Copy(ALine, 1, 7) = 'STATUS:' then
  begin
    SetScriptEngineStatus(Copy(ALine, 8, MaxInt));
    Exit;
  end;

  if Copy(ALine, 1, 9) = 'PROGRESS:' then
  begin
    if TfrmSmoothLoading.CancelRequested then
    begin
      AbortScriptEngineRunOnCancel;
      Exit;
    end;
    Text := Copy(ALine, 10, MaxInt);
    Colon1 := PosBMH(':', Text);
    if Colon1 > 0 then
    begin
      LineNum := Copy(Text, 1, Colon1 - 1);
      SetScriptEngineStatus(Copy(Text, Colon1 + 1, MaxInt));
    end
    else
      LineNum := Text;

    TfrmSmoothLoading.UpdateProgress(StrToIntDef(Trim(LineNum), 0));
    TfrmSmoothLoading.FlushPaint;
    if Assigned(frmSmoothLoading) and Assigned(frmSmoothLoading.lblDetail) and
       (Colon1 > 0) then
    begin
      frmSmoothLoading.lblDetail.Caption := Copy(Text, Colon1 + 1, MaxInt);
      frmSmoothLoading.lblDetail.Visible := True;
      frmSmoothLoading.ApplyDetailLabelLook;
    end;
    Exit;
  end;

  { Any other line: show as-is }
  if ALine <> '' then
    AppendScriptEngineOutput(ALine);
end;

procedure TfrmMain.PrepareScriptEngineCompileWait;
begin
  if not Assigned(FScriptEngineCompileEvent) then
    FScriptEngineCompileEvent := TEvent.Create(nil, True, False, '');
  FScriptEngineCompileOk := False;
  FScriptEngineLastCompileError := '';
  FScriptEngineCompileEvent.ResetEvent;
end;

procedure TfrmMain.SignalScriptEngineCompileDone(AOk: Boolean; const AError: string);
begin
  FScriptEngineCompileOk := AOk;
  if not AOk then
    FScriptEngineLastCompileError := AError;
  if Assigned(FScriptEngineCompileEvent) then
    FScriptEngineCompileEvent.SetEvent;
end;

procedure TfrmMain.ReleaseScriptEngineRunThread;
begin
  if Assigned(FScriptEngineRunThread) then
  begin
    FScriptEngineRunThread.WaitFor;
    FScriptEngineRunThread.Free;
    FScriptEngineRunThread := nil;
  end;
end;

function TfrmMain.FindNewestScriptEngineOnDisk: string;
  function Consider(const Candidate: string; var BestPath: string; var BestAge: Integer): Boolean;
  var
    Age: Integer;
    P: string;
  begin
    Result := False;
    P := ExpandFileName(Candidate);
    if (P = '') or (not FileExists(P)) then Exit;
    Age := FileAge(P);
    if Age < 0 then Exit;
    Result := True;
    if (BestPath = '') or (Age > BestAge) then
    begin
      BestPath := P;
      BestAge := Age;
    end;
  end;
var
  BestAge: Integer;
  Rel: string;
begin
  Result := '';
  BestAge := -1;
  Consider(ExtractFilePath(Application.ExeName) + SCRIPTENGINE, Result, BestAge);
  Consider(ExtractFilePath(ParamStr(0)) + SCRIPTENGINE, Result, BestAge);
  Consider(ExtractFilePath(Application.ExeName) + SCRIPTENGINE_REL_BUILD + SCRIPTENGINE, Result, BestAge);
  Consider(ExtractFilePath(ParamStr(0)) + SCRIPTENGINE_REL_BUILD + SCRIPTENGINE, Result, BestAge);
  Consider(ExtractFilePath(Application.ExeName) + SCRIPTENGINE_REL_DIST + SCRIPTENGINE,
    Result, BestAge);
  Consider(ExtractFilePath(ParamStr(0)) + SCRIPTENGINE_REL_DIST + SCRIPTENGINE,
    Result, BestAge);
  { Layout ao compilar a partir de Src\ (IDE): data-lake-duckdb-main\dist ao lado do .dpr }
  Rel := ExtractFilePath(ParamStr(0)) + SCRIPTENGINE_REL_DIST_SIDECAR + SCRIPTENGINE;
  Consider(Rel, Result, BestAge);
end;

function TfrmMain.ResolveScriptEnginePath: string;
var
  LocalNewest, BesideFastFile: string;
begin
  { Preferir o ScriptEngine.exe mais recente (ex.: build local com suporte CKPT). }
  LocalNewest := FindNewestScriptEngineOnDisk;
  BesideFastFile := ExpandFileName(ExtractFilePath(Application.ExeName) + SCRIPTENGINE);
  if LocalNewest <> '' then
  begin
    Result := LocalNewest;
    if (BesideFastFile <> '') and FileExists(BesideFastFile) and
       (ExpandFileName(LocalNewest) <> BesideFastFile) and
       (FileAge(BesideFastFile) >= 0) and (FileAge(LocalNewest) >= 0) and
       (FileAge(BesideFastFile) < FileAge(LocalNewest)) then
    begin
      { Copia build novo para junto do FastFile.exe para o proximo arranque. }
      try
        if (not FileExists(BesideFastFile)) or DeleteFile(BesideFastFile) then
          Windows.CopyFile(PChar(LocalNewest), PChar(BesideFastFile), False);
      except
      end;
      Result := BesideFastFile;
    end;
    Exit;
  end;
  if not EnsureExecutableAvailable(SCRIPTENGINE, Result) then
    Result := '';
end;

function TfrmMain.ScriptEngineWriteLine(const AText: string): Boolean;
var
  Data: UTF8String;
  BytesWritten: DWORD;
begin
  Result := False;
  if (not FScriptEngineProcessRunning) or (FScriptEngineStdInWrite = 0) or
     (FScriptEngineStdInWrite = INVALID_HANDLE_VALUE) then Exit;
  Data := UTF8Encode(AText + #10);
  Result := Windows.WriteFile(FScriptEngineStdInWrite, Pointer(Data)^,
    Length(Data), BytesWritten, nil) and (BytesWritten = DWORD(Length(Data)));
end;

function TfrmMain.ScriptEngineFlushStdInBatch(AStream: TMemoryStream;
  var ABatchLineCount: Integer): Boolean;
var
  TotalBytes: Integer;
  WrittenTotal: Integer;
  BytesWritten: DWORD;
  P: PAnsiChar;
begin
  Result := True;
  if (not Assigned(AStream)) or (AStream.Size = 0) then Exit;
  if (not FScriptEngineProcessRunning) or (FScriptEngineStdInWrite = 0) or
     (FScriptEngineStdInWrite = INVALID_HANDLE_VALUE) then
  begin
    Result := False;
    Exit;
  end;
  TotalBytes := AStream.Size;
  WrittenTotal := 0;
  P := AStream.Memory;
  while WrittenTotal < TotalBytes do
  begin
    if not Windows.WriteFile(FScriptEngineStdInWrite, P[WrittenTotal],
      TotalBytes - WrittenTotal, BytesWritten, nil) then
    begin
      Result := False;
      Exit;
    end;
    if BytesWritten = 0 then
    begin
      Result := False;
      Exit;
    end;
    Inc(WrittenTotal, BytesWritten);
  end;
  AStream.Clear;
  ABatchLineCount := 0;
end;

function TfrmMain.ScriptEngineQueueStdInLine(const ACmdLine: string;
  AStream: TMemoryStream; var ABatchLineCount: Integer): Boolean;
var
  Data: UTF8String;
begin
  Result := True;
  if not Assigned(AStream) then
  begin
    Result := False;
    Exit;
  end;
  Data := UTF8Encode(ACmdLine + #10);
  if Length(Data) > 0 then
    AStream.WriteBuffer(Pointer(Data)^, Length(Data));
  Inc(ABatchLineCount);
  if (AStream.Size >= (256 * 1024)) or (ABatchLineCount >= 512) then
    Result := ScriptEngineFlushStdInBatch(AStream, ABatchLineCount);
end;

function TfrmMain.IsScriptEngineProcessRunning: Boolean;
begin
  Result := FScriptEngineProcessRunning;
end;

function TfrmMain.IsScriptEngineOrTailMacroBusy: Boolean;
begin
  Result := Assigned(FScriptEngineRunThread) or Assigned(FTailMacroRunThread);
end;

function TfrmMain.CanStartTailMacroBatch(AForThread: TThread): Boolean;
begin
  if FApplicationClosing then
  begin
    Result := False;
    Exit;
  end;
  if Assigned(FScriptEngineRunThread) then
  begin
    Result := False;
    Exit;
  end;
  Result := (not Assigned(FTailMacroRunThread)) or (FTailMacroRunThread = AForThread);
end;

procedure TfrmMain.StartScriptEngineProcess;
var
  Security: TSecurityAttributes;
  StdOutWrite: THandle;
  StdInRead: THandle;
  StartupInfo: TStartupInfo;
  ScriptPath: string;
  WorkingDir: string;
  CommandLine: string;
  Created: Boolean;
begin
  EnsureScriptEnginePanel;

  if FScriptEngineProcessRunning then
    StopScriptEngineProcess;

  ScriptPath := ResolveScriptEnginePath;
  if ScriptPath = '' then
  begin
    SetScriptEngineStatus(TrText('Executable not found'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Python plugin ScriptEngine.exe not found.'));
    Exit;
  end;

  SetScriptEngineStatus(TrText('Starting...'));

  FillChar(Security, SizeOf(Security), 0);
  Security.nLength := SizeOf(Security);
  Security.bInheritHandle := True;

  StdOutWrite := 0;
  StdInRead := 0;
  FScriptEngineStdOutRead := 0;
  FScriptEngineStdInWrite := 0;
  FillChar(FScriptEngineProcessInfo, SizeOf(FScriptEngineProcessInfo), 0);

  if not CreatePipe(FScriptEngineStdOutRead, StdOutWrite, @Security, 0) then
  begin
    SetScriptEngineStatus(TrText('Pipe error'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Could not create stdout pipe.'));
    Exit;
  end;
  SetHandleInformation(FScriptEngineStdOutRead, HANDLE_FLAG_INHERIT, 0);

  if not CreatePipe(StdInRead, FScriptEngineStdInWrite, @Security, 0) then
  begin
    CloseHandle(FScriptEngineStdOutRead);
    FScriptEngineStdOutRead := 0;
    SetScriptEngineStatus(TrText('Pipe error'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Could not create stdin pipe.'));
    Exit;
  end;
  SetHandleInformation(FScriptEngineStdInWrite, HANDLE_FLAG_INHERIT, 0);

  FillChar(StartupInfo, SizeOf(StartupInfo), 0);
  StartupInfo.cb := SizeOf(StartupInfo);
  StartupInfo.dwFlags := STARTF_USESHOWWINDOW or STARTF_USESTDHANDLES;
  StartupInfo.wShowWindow := SW_HIDE;
  StartupInfo.hStdInput := StdInRead;
  StartupInfo.hStdOutput := StdOutWrite;
  StartupInfo.hStdError := StdOutWrite;

  WorkingDir := ExtractFilePath(ScriptPath);
  CommandLine := '"' + ScriptPath + '"';

  Created := CreateProcess(nil, PChar(CommandLine), nil, nil, True,
    CREATE_NO_WINDOW, nil, PChar(WorkingDir), StartupInfo, FScriptEngineProcessInfo);

  CloseHandle(StdOutWrite);
  CloseHandle(StdInRead);

  if not Created then
  begin
    if FScriptEngineStdOutRead <> 0 then begin CloseHandle(FScriptEngineStdOutRead); FScriptEngineStdOutRead := 0; end;
    if FScriptEngineStdInWrite <> 0 then begin CloseHandle(FScriptEngineStdInWrite); FScriptEngineStdInWrite := 0; end;
    SetScriptEngineStatus(TrText('Launch error'));
    AppendScriptEngineOutput('[ERROR] ' + TrText('Could not start Python plugin ScriptEngine.exe.'));
    Exit;
  end;

  FScriptEngineProcessRunning := True;
  FScriptEngineVersion := 0;
  FScriptEngineReaderThread := TScriptEngineReaderThread.Create(Self, FScriptEngineStdOutRead);
  ScriptEngineWriteLine('ENGINE_VERSION?');
  SetScriptEngineStatus(TrText('Connected'));
end;

function TfrmMain.AppUiUpdatesAllowed: Boolean;
begin
  Result := (not FApplicationClosing) and (not (csDestroying in ComponentState));
end;

procedure TfrmMain.ShutdownApplicationWork;
begin
  if FAppShutdownWorkDone then Exit;
  FAppShutdownWorkDone := True;
  FApplicationClosing := True;
  if Assigned(tmrTail) then
    tmrTail.Enabled := False;
  FTailActive := False;
  FTailPaused := False;
  FTailMacroPendingActive := False;
  FTailMacroProcessing := False;
  EndTailMacroResultsStream;
  CloseFileStreams;
  CleanupFastFileLineIndexFiles;
  TfrmSmoothLoading.HideLoading;
  TfrmSmoothLoading.ResetCancel;
  StopScriptEngineProcess;
  StopConsumerAIProcess;
  StopConsumerRAGProcess;
end;

procedure TfrmMain.RemovePythonDataWorkspaceFolder;
var
  DataDir: string;
begin
  DataDir := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName)) + CONSUMER_DATA_DIR;
  if not DirectoryExists(DataDir) then
    Exit;
  try
    UnUtils.DelTree(DataDir);
  except
    { Best-effort at exit; plugins may still hold locks briefly }
  end;
end;

procedure TfrmMain.StopScriptEngineProcess;
begin
  if not FScriptEngineProcessRunning and (not Assigned(FScriptEngineReaderThread)) and
     (not Assigned(FScriptEngineRunThread)) then
    Exit;

  ReleaseScriptEngineRunThread;
  if AppUiUpdatesAllowed then
    TfrmSmoothLoading.HideLoading;

  if FScriptEngineProcessRunning and (FScriptEngineStdInWrite <> 0) and
     (FScriptEngineStdInWrite <> INVALID_HANDLE_VALUE) then
    ScriptEngineWriteLine('EXIT');

  if FScriptEngineProcessInfo.hProcess <> 0 then
  begin
    if WaitForSingleObject(FScriptEngineProcessInfo.hProcess, 5000) = WAIT_TIMEOUT then
      TerminateProcess(FScriptEngineProcessInfo.hProcess, 0);
    WaitForSingleObject(FScriptEngineProcessInfo.hProcess, 2000);
  end;

  if FScriptEngineStdInWrite <> 0 then begin CloseHandle(FScriptEngineStdInWrite); FScriptEngineStdInWrite := 0; end;
  if FScriptEngineStdOutRead <> 0 then begin CloseHandle(FScriptEngineStdOutRead); FScriptEngineStdOutRead := 0; end;

  if Assigned(FScriptEngineReaderThread) then
  begin
    FScriptEngineReaderThread.Terminate;
    FScriptEngineReaderThread.WaitFor;
    FreeAndNil(FScriptEngineReaderThread);
  end;

  if FScriptEngineProcessInfo.hThread <> 0 then begin CloseHandle(FScriptEngineProcessInfo.hThread); FScriptEngineProcessInfo.hThread := 0; end;
  if FScriptEngineProcessInfo.hProcess <> 0 then begin CloseHandle(FScriptEngineProcessInfo.hProcess); FScriptEngineProcessInfo.hProcess := 0; end;

  FScriptEngineProcessRunning := False;
  FScriptEngineWritesDirectOutput := False;
  FScriptRunStartTick := 0;
  FScriptEngineVersion := 0;
  if Assigned(FScriptEngineCompileEvent) then
    FreeAndNil(FScriptEngineCompileEvent);
  FTailMacroProcessing := False;
  FTailMacroRunThread := nil;
  CloseScriptDirectOutput;
  if AppUiUpdatesAllowed then
  begin
    if Assigned(FScriptEngineRunButton)  then FScriptEngineRunButton.Enabled  := True;
    if Assigned(FScriptEngineSaveButton) then FScriptEngineSaveButton.Enabled := False;
    SetScriptEngineStatus(TrText('Disconnected'));
  end;
end;


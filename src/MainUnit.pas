procedure TfrmMain.AppendTailMacroUiMessage(const AText: string);
begin
  if Trim(AText) = '' then Exit;
  if FTailMacroShowInPanel and Assigned(FTailMacroOutputMemo) then
  begin
    FTailMacroOutputMemo.Lines.Add(AText);
    if (FTailMacroOutputMemo.Handle <> 0) and IsWindow(FTailMacroOutputMemo.Handle) then
      SendMessage(FTailMacroOutputMemo.Handle, WM_VSCROLL, SB_BOTTOM, 0);
  end;
  UpdateTailMacroStatus(AText);
end;

function TfrmMain.WaitTailMacroCompiled(ATimeoutMs: Cardinal): Boolean;
var
  Start: DWORD;
begin
  if not FTailMacroAwaitingCompile then
  begin
    Result := True;
    Exit;
  end;
  Start := GetTickCount;
  while FTailMacroAwaitingCompile do
  begin
    Application.ProcessMessages;
    if (GetTickCount - Start) >= ATimeoutMs then Break;
  end;
  Result := not FTailMacroAwaitingCompile;
end;

procedure TfrmMain.ResetTailMacroBusyStateIfStale;
begin
  if FTailMacroProcessing and (not Assigned(FTailMacroRunThread)) and
     (not Assigned(FScriptEngineRunThread)) then
    FTailMacroProcessing := False;
end;

function TfrmMain.EnsureTailMacroScriptEngine: Boolean;
begin
  Result := IsScriptEngineProcessRunning;
  if Result then Exit;
  StartScriptEngineProcess;
  Result := IsScriptEngineProcessRunning;
  if not Result then
    UpdateTailMacroStatus(TrText('Tail macro: Python plugin ScriptEngine.exe not found or failed to start.'));
end;

procedure TfrmMain.TryRunTailMacroOnSessionNewLines;
var
  From1, To1: Int64;
begin
  if not TailMacroShouldProcessNewLines then Exit;
  ResetTailMacroBusyStateIfStale;
  if FTailMacroProcessing or Assigned(FTailMacroRunThread) or
     Assigned(FScriptEngineRunThread) then Exit;
  if not GetTailMacroSessionNewLineRange(From1, To1) then Exit;
  UpdateTailMacroStatus(Format(TrText('Tail macro: processing %d pending line(s)...'),
    [To1 - From1 + 1]));
  RunTailMacroOnNewLines(From1, To1, True);
end;


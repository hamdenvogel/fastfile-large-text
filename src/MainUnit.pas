procedure TfrmMain.WndProc(var Message: TMessage);
var
  Pt: TPoint;
  Ctrl: TWinControl;
begin
  inherited WndProc(Message);

  if Message.Msg = WM_DPICHANGED then
    PostMessage(Handle, WM_USER + 440, 0, 0);

  if Message.Msg = WM_NCHITTEST then
  begin
    if (Message.Result = HTCAPTION) or (Message.Result = HTTRANSPARENT) then
    begin
      Pt := Point(SmallInt(Message.LParamLo), SmallInt(Message.LParamHi));
      Ctrl := FindControl(WindowFromPoint(Pt));
      while Assigned(Ctrl) do
      begin
        if (Ctrl is TsPageControl) or (Ctrl is TsTabSheet) then
        begin
          Message.Result := HTCLIENT;
          Break;
        end;
        if Ctrl = Self then Break;
        Ctrl := Ctrl.Parent;
      end;
    end;
  end;
end;


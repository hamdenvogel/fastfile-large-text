procedure TfrmMain.btnExecuteSplitFileByFilesClick(Sender: TObject);
var
  Entries: TSplitEntryArray;
  Count: Integer;
  SourceLine1Based, TargetLine1Based: Int64;
begin
  if CurrentEffectiveFilePath = '' then begin ShowAppMessage('Please select a file.'); Exit; end;
  if not FileExists(CurrentEffectiveFilePath) then begin ShowAppMessage('File not found.'); Exit; end;
  if not EnsureWritableSession then Exit;

  with clFiles do
  begin
    if not Active then Exit;
    if IsEmpty then Exit;

    // Validations
    First;
    while not Eof do
    begin
      if (Trim(FieldByName('SourceLine').AsString) = '') or
         (Trim(FieldByName('TargetLine').AsString) = '') then
      begin
        ShowAppMessage(Format('Line %d: SourceLine and TargetLine must not be empty.',
          [FieldByName('ID').AsInteger]));
        Exit;
      end;

      SourceLine1Based := FieldByName('SourceLine').AsInteger;
      TargetLine1Based := FieldByName('TargetLine').AsInteger;

      if (SourceLine1Based < 1) or (TargetLine1Based < 1) then
      begin
        ShowAppMessage(Format('Line %d: SourceLine and TargetLine must be >= 1.',
          [FieldByName('ID').AsInteger]));
        Exit;
      end;

      if (totalLines > 0) and ((SourceLine1Based > totalLines) or (TargetLine1Based > totalLines)) then
      begin
        ShowAppMessage(Format('Line %d: SourceLine/TargetLine must be within 1..%d.',
          [FieldByName('ID').AsInteger, totalLines]));
        Exit;
      end;

      if SourceLine1Based > TargetLine1Based then
      begin
        ShowAppMessage(Format('Line %d: SourceLine (%s) must not be greater than TargetLine (%s).',
          [FieldByName('ID').AsInteger, FieldByName('SourceLine').AsString, FieldByName('TargetLine').AsString]));
        Exit;
      end;
      Next;
    end;

    Count := 0;
    SetLength(Entries, RecordCount);
    First;
    while not Eof do
    begin
      Entries[Count].ID := FieldByName('ID').AsInteger;
      Entries[Count].FileName := FieldByName('Filename').AsString;
      SourceLine1Based := FieldByName('SourceLine').AsInteger;
      TargetLine1Based := FieldByName('TargetLine').AsInteger;
      { TSplitFileThread reads 0-based line indices from temp.txt offsets. }
      Entries[Count].SourceLine := SourceLine1Based - 1;
      Entries[Count].TargetLine := TargetLine1Based - 1;
      Inc(Count);
      Next;
    end;
    SetLength(Entries, Count);
  end;

  if Count > 0 then
    TSplitFileThread.Create(CurrentEffectiveFilePath, ExtractFilePath(CurrentEffectiveFilePath), Entries, Count);
end;

procedure TfrmMain.btnAskAISplitFileByFilesClick(Sender: TObject);
var
  SourcePath, Prompt, Rows, RowText: string;
  RowCount, I: Integer;
begin
  SourcePath := Trim(CurrentEffectiveFilePath);
  if SourcePath = '' then
    SourcePath := Trim(edtFileName.Text);
  Rows := '';
  RowCount := 0;
  if Assigned(clFiles) and clFiles.Active then
  begin
    clFiles.DisableControls;
    try
      clFiles.First;
      while not clFiles.Eof do
      begin
        Inc(RowCount);
        if RowCount <= 12 then
        begin
          RowText := Format('%d: %s [%s..%s]', [
            clFiles.FieldByName('ID').AsInteger,
            clFiles.FieldByName('Filename').AsString,
            clFiles.FieldByName('SourceLine').AsString,
            clFiles.FieldByName('TargetLine').AsString]);
          if Rows <> '' then Rows := Rows + '; ';
          Rows := Rows + RowText;
        end;
        clFiles.Next;
      end;
    finally
      clFiles.EnableControls;
    end;
  end;
  if RowCount > 12 then
    Rows := Rows + '; ...';

  Prompt := Format(TrText('AI.Context.SplitByFiles'),
    [SourcePath, IntToStr(totalLines), IntToStr(trkFiles.Position),
      IntToStr(RowCount), Rows]);
  CreateFastFileAssistantPanel;
  AssistantPrefillQuestion(Prompt);
  AssistantSubmitQuestion;
end;

procedure TfrmMain.btnExecuteSplitFileByLinesClick(Sender: TObject);
var
  Entries: TSplitEntryArray;
  SourceLine, TargetLine: Int64;
  OutputFile, OutputDir, OutputName: string;
begin
  if CurrentEffectiveFilePath = '' then begin ShowAppMessage('Please select a file.'); Exit; end;
  if not FileExists(CurrentEffectiveFilePath) then begin ShowAppMessage('File not found.'); Exit; end;
  if not EnsureWritableSession then Exit;

  SourceLine := spnFromSplitByLine.Value;
  TargetLine := spnToSplitByLine.Value;
  OutputFile := Trim(edtOutputSplitByLineText.Text);

  if SourceLine < 1 then begin ShowAppMessage('From line must be >= 1.'); Exit; end;
  if TargetLine < SourceLine then begin ShowAppMessage('To line must be >= From line.'); Exit; end;
  if (totalLines > 0) and (TargetLine > totalLines) then
  begin
    ShowAppMessage(Format(TrText('SplitByLines.Error.ToBeyondTotal'), [totalLines]));
    Exit;
  end;
  if OutputFile = '' then begin ShowAppMessage('Please specify an output filename.'); Exit; end;

  // Determine output directory and filename
  OutputDir := ExtractFilePath(OutputFile);
  OutputName := ExtractFileName(OutputFile);
  if OutputDir = '' then
    OutputDir := ExtractFilePath(CurrentEffectiveFilePath);
  if OutputName = '' then
    OutputName := 'split_output.txt';
  if SameText(ExpandFileName(OutputDir + OutputName),
    ExpandFileName(CurrentEffectiveFilePath)) then
  begin
    ShowAppMessage(TrText('SplitByLines.Error.SameOutput')); 
    Exit;
  end;

  // Use 0-based line indices for the thread (index file is 0-based)
  SetLength(Entries, 1);
  Entries[0].ID := 1;
  Entries[0].FileName := OutputName;
  Entries[0].SourceLine := SourceLine - 1;
  Entries[0].TargetLine := TargetLine - 1;

  TSplitFileThread.Create(CurrentEffectiveFilePath, OutputDir, Entries, 1);
end;


function TfrmMain.TryParseEqualSplitPartPath(const APath: string;
  out ADir, AStem, AExt: string; out APartNum: Integer): Boolean;
var
  Fn, WithoutExt, LowName, Digits: string;
  P, i: Integer;
begin
  Result := False;
  ADir := '';
  AStem := '';
  AExt := '';
  APartNum := 0;
  if Trim(APath) = '' then Exit;
  Fn := ExtractFileName(APath);
  AExt := ExtractFileExt(Fn);
  WithoutExt := ChangeFileExt(Fn, '');
  LowName := LowerCase(WithoutExt);
  P := PosBMH('.part', LowName);
  if P = 0 then Exit;
  Digits := Copy(WithoutExt, P + 5, MaxInt);
  if Digits = '' then Exit;
  for i := 1 to Length(Digits) do
    if not (Digits[i] in ['0'..'9']) then
      Exit;
  APartNum := StrToIntDef(Digits, 0);
  if APartNum < 1 then Exit;
  AStem := Copy(WithoutExt, 1, P - 1);
  if AStem = '' then Exit;
  ADir := IncludeTrailingPathDelimiter(ExtractFilePath(ExpandFileName(APath)));
  Result := True;
end;

function TfrmMain.SuggestJoinPartsDestPath(const ADir, AStem, AExt: string): string;
begin
  Result := ADir + AStem + AExt;
  if FileExists(Result) then
    Result := ADir + AStem + '_merged' + AExt;
end;

function TfrmMain.DoJoinEqualSplitParts(const ADestPath, ADir, AStem, AExt: string): Boolean;
var
  Parts: TStringList;
  i: Integer;
  PartPath: string;
  Msg: string;
begin
  Result := False;
  if Trim(ADestPath) = '' then
  begin
    ShowAppMessage(TrText('Please select/read the destination file first.'));
    Exit;
  end;
  Parts := TStringList.Create;
  try
    i := 1;
    while i <= 9999 do
    begin
      PartPath := ADir + AStem + Format('.part%.3d', [i]) + AExt;
      if not FileExists(PartPath) then
        Break;
      Parts.Add(PartPath);
      Inc(i);
    end;
    if Parts.Count < 1 then
    begin
      ShowAppMessage(TrText('MergeFiles.Join.NoPartsFound'));
      Exit;
    end;
    if Parts.Count = 1 then
    begin
      ShowAppMessage(Format(TrText('MergeFiles.Join.OnlyOnePart'), [Parts[0]]));
      Exit;
    end;

    Msg := Format(TrText('MergeFiles.Join.Confirm'), [Parts.Count, ADestPath]);
    if FastFileMessageBox(PChar(Msg), PChar(TrText('Merge files')),
      MB_YESNO or MB_ICONQUESTION) <> IDYES then
      Exit;

    if FileExists(ADestPath) then
    begin
      Msg := Format(TrText('MergeFiles.Join.OverwriteConfirm'), [ADestPath]);
      if FastFileMessageBox(PChar(Msg), PChar(TrText('Merge files')),
        MB_YESNO or MB_ICONWARNING) <> IDYES then
        Exit;
    end;

    { Background thread + SmoothLoading (same UX as TMergeFilesThread). }
    TJoinEqualSplitPartsThread.Create(ADestPath, Parts);
    Result := True;
  finally
    Parts.Free;
  end;
end;

function TfrmMain.DoMergeFilesFromDialog(const DestFileName, SourceFileName: String;
  const MergeMode: TMergeFilesMode; const InsertAfterLine, FromLine, ToLine: Int64): Boolean;
var
  InsertOffset: Int64;
  Fs: TFileStream;
  DstSize, SrcSize, SrcRangeSize: Int64;
begin
  Result := False;
  if not FileExists(DestFileName) then
  begin
    ShowAppMessage(TrText('Destination file not found.'));
    Exit;
  end;

  if not FileExists(SourceFileName) then
  begin
    ShowAppMessage(TrText('Source file not found.'));
    Exit;
  end;

  try
    try
      Fs := TFileStream.Create(SourceFileName, fmOpenRead or fmShareDenyNone);
    finally
      FreeAndNil(Fs);
    end;
  except
    on E: Exception do
    begin
      ShowAppMessage(TrText('Could not open source file: ') + E.Message);
      Exit;
    end;
  end;

  try
    try
      Fs := TFileStream.Create(DestFileName, fmOpenReadWrite or fmShareDenyNone);
    finally
      FreeAndNil(Fs);
    end;
  except
    on E: Exception do
    begin
      ShowAppMessage(TrText('Destination file is in use by another process: ') + E.Message);
      Exit;
    end;
  end;

  case MergeMode of
    mfmBeginning:
      InsertOffset := 0;
    mfmEnd:
      InsertOffset := UnUtils.GetFileSize(DestFileName);
    mfmLineRange:
      InsertOffset := 0;
  else
    begin
      if totalLines < 2 then
      begin
        ShowAppMessage(TrText('Destination file must have at least 2 lines for insertion by line.'));
        Exit;
      end;
      if (InsertAfterLine < 1) or (InsertAfterLine > (totalLines - 1)) then
      begin
        ShowAppMessage(Format(TrText('Invalid line. Use a value from %d to %d.'),
          [1, totalLines - 1]));
        Exit;
      end;
      if not TryGetLineStartOffset(InsertAfterLine + 1, InsertOffset) then
      begin
        ShowAppMessage(TrText('Could not resolve insertion position. Read destination file again and retry.'));
        Exit;
      end;
    end;
  end;

  DstSize := GetFileSize(DestFileName);
  SrcSize := GetFileSize(SourceFileName);
  if (FromLine > 0) and (ToLine > 0) and (FromLine <= ToLine) then
    SrcRangeSize := SrcSize
  else
    SrcRangeSize := SrcSize;

  if not ConfirmDiskSpaceForMergeFiles(DestFileName, SourceFileName, DstSize, SrcRangeSize,
    InsertOffset, FromLine, ToLine) then
    Exit;

  CloseFileStreams;

  PrepareMergeFilesUndo(DestFileName, SourceFileName,
    Format('offset=%d from=%d to=%d', [InsertOffset, FromLine, ToLine]));

  if MergeMode = mfmLineRange then
    TMergeFilesThread.Create(DestFileName, SourceFileName, 0, True, True, FromLine, ToLine)
  else
    TMergeFilesThread.Create(DestFileName, SourceFileName, InsertOffset);
  Result := True;
end;


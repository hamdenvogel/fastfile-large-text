function TfrmMain.TailMacroIndexFilePath: string;
begin
  { Ficheiros >2 GB nao criam temp.txt; usar temp_ckpt.txt quando for o indice activo. }
  Result := ResolveWorkingLineIndexPath;
end;

function TfrmMain.FastFileCkptFilePath: string;
var
  PParam, PExe: string;
begin
  PParam := FastFileExeDirPath(TEMP_CKPT_FILE);
  PExe := IncludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName)) + TEMP_CKPT_FILE;
  if FileExists(PParam) then
    Result := PParam
  else if FileExists(PExe) then
    Result := PExe
  else
    Result := PParam;
end;

function TfrmMain.CurrentFileHasLineIndex(out ADenseIndexPath, ACkptPath: string;
  out AUseSparseIndex: Boolean): Boolean;
var
  SrcPath: string;
  SrcSize: Int64;
  Fs: TFileStream;
begin
  Result := False;
  AUseSparseIndex := False;
  ADenseIndexPath := TailMacroIndexFilePath;
  ACkptPath := FastFileCkptFilePath;
  SrcPath := CurrentEffectiveFilePath;
  SrcSize := 0;
  if (SrcPath <> '') and FileExists(SrcPath) then
  begin
    try
      Fs := TFileStream.Create(SrcPath, fmOpenRead or fmShareDenyNone);
      try
        SrcSize := Fs.Size;
      finally
        Fs.Free;
      end;
    except
      SrcSize := 0;
    end;
  end;
  { Ficheiros > 2 GB: indice denso (temp.txt) nao e criado; preferir sempre ckpt. }
  if FileExists(ACkptPath) then
  begin
    if (not FileExists(ADenseIndexPath)) or
       (SrcSize > Int64(2) * 1024 * 1024 * 1024) then
    begin
      AUseSparseIndex := True;
      ACkptPath := ExpandFileName(ACkptPath);
      Result := True;
      Exit;
    end;
  end;
  if FileExists(ADenseIndexPath) then
  begin
    ADenseIndexPath := ExpandFileName(ADenseIndexPath);
    Result := True;
    Exit;
  end;
  if FileExists(ACkptPath) then
  begin
    AUseSparseIndex := True;
    ACkptPath := ExpandFileName(ACkptPath);
    Result := True;
  end;
end;

function TfrmMain.GetTailMacroSessionNewLineRange(out AFrom1, ATo1: Int64): Boolean;
begin
  Result := False;
  AFrom1 := 0;
  ATo1 := FTailLastLineCount;
  if ATo1 <= 0 then
    ATo1 := totalLines;
  if ATo1 <= 0 then Exit;
  if FTailSessionFirstLine < 0 then Exit;
  if ATo1 <= FTailSessionFirstLine then Exit;
  { FTailSessionFirstLine = indice 0-based da primeira linha nova da sessao Tail }
  AFrom1 := FTailSessionFirstLine + 1;
  Result := AFrom1 <= ATo1;
end;

procedure TfrmMain.TailMacroLog(const AText: string);

procedure TfrmMain.EnsureFileSearchGalleryButton;
const
  TAG_FILE_SEARCH_GALLERY = $46475342; { 'FGSB' }
var
  ParentPnl: TWinControl;
  I: Integer;
  C: TControl;
  B: TsSpeedButton;
  M: TMethod;
  Cap: string;
begin
  if Assigned(FBtnFileSearchGallery) and Assigned(FBtnFileSearchGallery.Parent) then
  begin
    LocalizeFileSearchGallery;
    Exit;
  end;
  FBtnFileSearchGallery := nil;
  if not Assigned(btnExport) or not Assigned(btnExport.Parent) then Exit;
  ParentPnl := btnExport.Parent;

  { Remove orphaned copies / stray AlphaSkins dropdown arrows from earlier bugs. }
  for I := ParentPnl.ControlCount - 1 downto 0 do
  begin
    C := ParentPnl.Controls[I];
    if not (C is TsSpeedButton) then Continue;
    B := TsSpeedButton(C);
    if (B = btnExport) or (B = btnHelp) or (B = btnRead) or (B = btnCheckBoxes)
      or (B = btnConsumerAI) or (B = FToolbarOverflowButton) or (B = sSpeedButton38) then
      Continue;
    if B.Tag = TAG_FILE_SEARCH_GALLERY then
    begin
      B.Free;
      Continue;
    end;
    Cap := StringReplace(B.Caption, #13#10, ' ', [rfReplaceAll]);
    if (Pos('busca', AnsiLowerCase(Cap)) > 0) or (Pos('search', AnsiLowerCase(Cap)) > 0)
      or (Pos('suche', AnsiLowerCase(Cap)) > 0) then
    begin
      B.Free;
      Continue;
    end;
    if Assigned(B.OnClick) then
    begin
      M := TMethod(B.OnClick);
      if (M.Data = Pointer(Self)) and (M.Code = @TfrmMain.FileSearchGalleryClick) then
      begin
        B.Free;
        Continue;
      end;
    end;
    { Orphan arrow-only remnant (tbsDropDown face gone / width collapsed). }
    if (B.ButtonStyle = tbsDropDown) and (B.Width <= 28) then
      B.Free;
  end;

  { Keep Export as a normal toolbar button (never a detached chevron). }
  if Assigned(btnExport) then
  begin
    btnExport.ButtonStyle := tbsButton;
    if btnExport.Width < 80 then
      btnExport.Width := 120;
    btnExport.Visible := True;
  end;

  if Assigned(FPopFileSearch) then
    FreeAndNil(FPopFileSearch);
  FMiToggleFindOcc := nil;
  FMiToggleFilter := nil;
  FMiToggleBookmarks := nil;

  FPopFileSearch := TPopupMenu.Create(Self);
  if Assigned(FMenuBitmapImages) then
    FPopFileSearch.Images := FMenuBitmapImages;
  FPopFileSearch.OnPopup := FileSearchPopupPopup;

  FMiToggleFindOcc := TMenuItem.Create(FPopFileSearch);
  FMiToggleFindOcc.OnClick := FileSearchToggleFindOccClick;
  FMiToggleFindOcc.ImageIndex := MenuIconIndex(READ_TB_ICON_FIND, MenuIconIndex('search.bmp', 12));
  FPopFileSearch.Items.Add(FMiToggleFindOcc);

  FMiToggleFilter := TMenuItem.Create(FPopFileSearch);
  FMiToggleFilter.OnClick := FileSearchToggleFilterClick;
  FMiToggleFilter.ImageIndex := MenuIconIndex(READ_TB_ICON_FILTER, MenuIconIndex('filter.bmp', 4));
  FPopFileSearch.Items.Add(FMiToggleFilter);

  FMiToggleBookmarks := TMenuItem.Create(FPopFileSearch);
  FMiToggleBookmarks.OnClick := FileSearchToggleBookmarksClick;
  FMiToggleBookmarks.ImageIndex := MenuIconIndex('pushpin.bmp', 31);
  FPopFileSearch.Items.Add(FMiToggleBookmarks);

  ParentPnl.DisableAlign;
  try
    { Mirror CreateMainToolsGalleryButton (Mais ferramentas) styling. }
    FBtnFileSearchGallery := TsSpeedButton.Create(Self);
    FBtnFileSearchGallery.Tag := TAG_FILE_SEARCH_GALLERY;
    FBtnFileSearchGallery.Name := 'btnFileSearchGallery';
    FBtnFileSearchGallery.Parent := ParentPnl;
    FBtnFileSearchGallery.Align := alLeft;
    FBtnFileSearchGallery.Left := btnExport.Left + 1;
    FBtnFileSearchGallery.Top := 0;
    FBtnFileSearchGallery.Width := 128;
    FBtnFileSearchGallery.Height := 71;
    FBtnFileSearchGallery.AllowAllUp := True;
    FBtnFileSearchGallery.Flat := True;
    FBtnFileSearchGallery.Spacing := 8;
    FBtnFileSearchGallery.ButtonStyle := tbsDropDown;
    { Match Mais ferramentas: OnClick opens gallery form (no DropdownMenu). }
    FBtnFileSearchGallery.DropdownMenu := nil;
    FBtnFileSearchGallery.Images := ImageList32;
    FBtnFileSearchGallery.ImageIndex := AddImageList32Glyph(MAIN_TB_ICON_TOOLS_GALLERY, btnExport.ImageIndex);
    FBtnFileSearchGallery.ShowHint := True;
    FBtnFileSearchGallery.SkinData.SkinSection := 'TOOLBUTTON';
    FBtnFileSearchGallery.Blend := 20;
    FBtnFileSearchGallery.Reflected := True;
    FBtnFileSearchGallery.OnClick := FileSearchGalleryClick;
  finally
    ParentPnl.EnableAlign;
  end;
  LocalizeFileSearchGallery;
end;

procedure TfrmMain.LocalizeFileSearchGallery;
begin
  if Assigned(FBtnFileSearchGallery) then
  begin
    FBtnFileSearchGallery.Caption := TrText('FileSearch.MoreTools');
    FBtnFileSearchGallery.Hint := TrText('FileSearch.MoreToolsHint');
  end;
  if Assigned(FMiToggleFindOcc) then
    FMiToggleFindOcc.Caption := TrText('FileSearch.ToggleFind');
  if Assigned(FMiToggleFilter) then
    FMiToggleFilter.Caption := TrText('FileSearch.ToggleFilter');
  if Assigned(FMiToggleBookmarks) then
    FMiToggleBookmarks.Caption := TrText('FileSearch.ToggleBookmarks');
end;

procedure TfrmMain.FileSearchPopupPopup(Sender: TObject);
var
  FindVisible, FilterVisible, BookmarkVisible: Boolean;
begin
  FindVisible := Assigned(FFindOccBar) and FFindOccBar.Visible and (not FFindOccChromeHidden);
  if FindOccBarIsFloating and Assigned(FFindOccFloat) then
    FindVisible := FFindOccFloat.Visible and Assigned(FFindOccBar) and FFindOccBar.Visible;
  FilterVisible := IsFilterBarChromeVisible;
  BookmarkVisible := Assigned(FBookmarkBar) and FBookmarkBar.Visible and (not FBookmarkChromeHidden);
  if BookmarkBarIsFloating and Assigned(FBookmarkFloat) then
    BookmarkVisible := FBookmarkFloat.Visible and Assigned(FBookmarkBar) and FBookmarkBar.Visible;
  if Assigned(FMiToggleFindOcc) then
  begin
    if FindVisible then
      FMiToggleFindOcc.Caption := TrText('FileSearch.HideFind')
    else
      FMiToggleFindOcc.Caption := TrText('FileSearch.ShowFind');
  end;
  if Assigned(FMiToggleFilter) then
  begin
    if FilterVisible then
      FMiToggleFilter.Caption := TrText('FileSearch.HideFilter')
    else
      FMiToggleFilter.Caption := TrText('FileSearch.ShowFilter');
  end;
  if Assigned(FMiToggleBookmarks) then
  begin
    if BookmarkVisible then
      FMiToggleBookmarks.Caption := TrText('FileSearch.HideBookmarks')
    else
      FMiToggleBookmarks.Caption := TrText('FileSearch.ShowBookmarks');
  end;
end;

procedure TfrmMain.FileSearchGalleryClick(Sender: TObject);
var
  P: TPoint;
  FindVisible, FilterVisible, BookmarkVisible: Boolean;
  FindImg, FilterImg, BookmarkImg: Integer;
  CapFind, CapFilter, CapBookmark, HintFind, HintFilter, HintBookmark: string;
begin
  EnsureFileSearchGalleryButton;
  if not Assigned(FBtnFileSearchGallery) then Exit;

  FindVisible := Assigned(FFindOccBar) and FFindOccBar.Visible and (not FFindOccChromeHidden);
  if FindOccBarIsFloating and Assigned(FFindOccFloat) then
    FindVisible := FFindOccFloat.Visible and Assigned(FFindOccBar) and FFindOccBar.Visible;
  FilterVisible := IsFilterBarChromeVisible;
  BookmarkVisible := Assigned(FBookmarkBar) and FBookmarkBar.Visible and (not FBookmarkChromeHidden);
  if BookmarkBarIsFloating and Assigned(FBookmarkFloat) then
    BookmarkVisible := FBookmarkFloat.Visible and Assigned(FBookmarkBar) and FBookmarkBar.Visible;

  if FindVisible then
  begin
    CapFind := TrText('FileSearch.HideFind');
    HintFind := CapFind;
  end
  else
  begin
    CapFind := TrText('FileSearch.ShowFind');
    HintFind := CapFind;
  end;
  if FilterVisible then
  begin
    CapFilter := TrText('FileSearch.HideFilter');
    HintFilter := CapFilter;
  end
  else
  begin
    CapFilter := TrText('FileSearch.ShowFilter');
    HintFilter := CapFilter;
  end;
  if BookmarkVisible then
  begin
    CapBookmark := TrText('FileSearch.HideBookmarks');
    HintBookmark := CapBookmark;
  end
  else
  begin
    CapBookmark := TrText('FileSearch.ShowBookmarks');
    HintBookmark := CapBookmark;
  end;

  { Same form/chrome as Mais ferramentas — identical fonts, hosts, icons layout. }
  if Assigned(FormPopupToolGallery) then
    FreeAndNil(FormPopupToolGallery);

  FormPopupToolGallery := TFormPopupToolGallery.Create(Self);

  { Load Find / Filter / Bookmarks glyphs once into ImageList32. }
  if FFileSearchFindGlyph < 0 then
    FFileSearchFindGlyph := AddImageList32Glyph(READ_TB_ICON_FIND,
      AddImageList32Glyph('search.bmp', AddImageList32Glyph('find.bmp', 12)));
  if FFileSearchFilterGlyph < 0 then
    FFileSearchFilterGlyph := AddImageList32Glyph(READ_TB_ICON_FILTER,
      AddImageList32Glyph('filter.bmp', AddImageList32Glyph('filter-2.bmp', FFileSearchFindGlyph)));
  if FFileSearchBookmarkGlyph < 0 then
    FFileSearchBookmarkGlyph := AddImageList32Glyph('pushpin.bmp',
      AddImageList32Glyph('push pin.bmp', FFileSearchFindGlyph));
  FindImg := FFileSearchFindGlyph;
  FilterImg := FFileSearchFilterGlyph;
  BookmarkImg := FFileSearchBookmarkGlyph;

  FormPopupToolGallery.ConfigureFileSearchMode(ImageList32, FindImg, FilterImg, BookmarkImg,
    CapFind, HintFind, 'Ctrl+F',
    CapFilter, HintFilter, 'Ctrl+L',
    CapBookmark, HintBookmark, 'Ctrl+B');
  FormPopupToolGallery.btnGallerySplitPattern.OnClick := FileSearchGalleryFindPick;
  FormPopupToolGallery.btnGallerySplitEqual.OnClick := FileSearchGalleryFilterPick;
  FormPopupToolGallery.btnGalleryExtractParts.OnClick := FileSearchGalleryBookmarkPick;

  FormPopupToolGallery.PrepareLayout;
  FormPopupToolGallery.HandleNeeded;
  if DefaultManager <> nil then
    DefaultManager.UpdateScale(FormPopupToolGallery);
  FormPopupToolGallery.RelayoutChrome;

  P := FBtnFileSearchGallery.ClientToScreen(Point(0, FBtnFileSearchGallery.Height));
  ShowPopupForm(FormPopupToolGallery, P, False);
  FormPopupToolGallery.FocusSearch;
end;


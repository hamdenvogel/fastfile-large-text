procedure TfrmMain.RefreshIdleLogoWorkspaceLayout;
var
  R: TRect;
  AreaW, AreaH: Integer;
begin
  if not MainWorkspaceShowsIdleLogo then Exit;
  if IdleLogoBitmapReady then
    CalcIdleLogoDrawDimensions;
  R := GetIdleLogoWorkspaceRect;
  AreaW := R.Right - R.Left;
  AreaH := R.Bottom - R.Top;
  if (AreaW <> FIdleLogoPaintCacheW) or (AreaH <> FIdleLogoPaintCacheH) then
    InvalidateIdleLogoPaintCache;
  SyncIdleLogoBgFloatBounds;
  if Assigned(FIdleLogoBgFloat) and (FIdleLogoBgFloat.Items.Count > 0) and
    FIdleLogoBgFloat.Items[0].Visible then
  begin
    RefreshIdleLogoPaintCache;
    FIdleLogoBgFloat.Items[0].UpdatePosition;
    FIdleLogoBgFloat.Items[0].Repaint;
  end;
end;

procedure TfrmMain.WMIdleLogoLayout(var Msg: TMessage);
begin
  RefreshIdleLogoWorkspaceLayout;
end;


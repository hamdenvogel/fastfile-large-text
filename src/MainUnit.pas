procedure TfrmMain.EnsureExportTrayIcon;
begin
  if Assigned(FExportTrayIcon) then Exit;
  FExportTrayIcon := TTrayIcon.Create(Self);
  FExportTrayIcon.Visible := False;
  FExportTrayIcon.BalloonFlags := bfInfo;
  FExportTrayIcon.BalloonTimeout := 10000;
  FExportTrayIcon.OnBalloonClick := ExportTrayBalloonClick;
  FExportTrayIcon.OnClick := ExportTrayBalloonClick;
  AssignExportTrayIconImage;
end;

procedure TfrmMain.AssignExportTrayIconImage;
var
  H: HICON;
begin
  if not Assigned(FExportTrayIcon) then Exit;

  if Assigned(Application.Icon) and (not Application.Icon.Empty) then
  begin
    FExportTrayIcon.Icon.Assign(Application.Icon);
    if not FExportTrayIcon.Icon.Empty then Exit;
  end;
  if (not Icon.Empty) then
  begin
    FExportTrayIcon.Icon.Assign(Icon);
    if not FExportTrayIcon.Icon.Empty then Exit;
  end;

  H := ExtractIcon(HInstance, PChar(Application.ExeName), 0);
  if (H <> 0) and (H <> HICON(1)) then
  begin
    FExportTrayIcon.Icon.Handle := H;
    if not FExportTrayIcon.Icon.Empty then Exit;
  end;

  H := LoadIcon(0, IDI_APPLICATION);
  if H <> 0 then
    FExportTrayIcon.Icon.Handle := CopyIcon(H);
end;

function TfrmMain.ClampTrayBalloonText(const S: string; AMaxLen: Integer): string;
begin
  Result := Trim(S);
  if AMaxLen < 8 then
    AMaxLen := 8;
  if Length(Result) > AMaxLen then
    Result := Copy(Result, 1, AMaxLen - 3) + '...';
end;

procedure TfrmMain.ExportTrayBalloonClick(Sender: TObject);
begin
  if (FLastExternalizedFilePath <> '') and FileExists(FLastExternalizedFilePath) then
    ShellExecute(0, 'open', PChar(FLastExternalizedFilePath), nil, nil, SW_SHOWDEFAULT);
end;

procedure TfrmMain.CleanupExternalNotifyIcon;
begin
  if Assigned(FExportTrayIcon) then
    FExportTrayIcon.Visible := False;
end;

procedure TfrmMain.ExternalNotifyTimerTick(Sender: TObject);
begin
  if Assigned(FExternalNotifyTimer) then
    FExternalNotifyTimer.Enabled := False;
  CleanupExternalNotifyIcon;
end;

procedure TfrmMain.NotifyExternalizedData(const AFileName: string);
var
  DirPath, FileName, InfoText, TitleText, TipText: string;
begin
  if Trim(AFileName) = '' then Exit;

  FLastExternalizedFilePath := AFileName;
  FileName := ExtractFileName(AFileName);
  DirPath := ExtractFileDir(AFileName);
  if DirPath = '' then
    DirPath := AFileName;

  { Shell balloon buffers: title ~63, body ~255 — long paths break ShowBalloonHint
    and Windows then shows only the tray Hint. }
  TitleText := ClampTrayBalloonText(TrText('SCRIPT_EXPORT_SAVED_TITLE'), 60);
  InfoText := ClampTrayBalloonText(
    Format(TrText('SCRIPT_EXPORT_BALLOON_BODY'), [FileName, DirPath]), 240);
  TipText := ClampTrayBalloonText(FileName, 120);

  EnsureExportTrayIcon;
  if not Assigned(FExportTrayIcon) then Exit;

  AssignExportTrayIconImage;
  FExportTrayIcon.Visible := False;
  FExportTrayIcon.Hint := TipText;
  FExportTrayIcon.BalloonTitle := TitleText;
  FExportTrayIcon.BalloonHint := InfoText;
  FExportTrayIcon.BalloonFlags := bfInfo;
  FExportTrayIcon.BalloonTimeout := 10000;
  FExportTrayIcon.Visible := True;
  FExportTrayIcon.ShowBalloonHint;

  if not Assigned(FExternalNotifyTimer) then
  begin
    FExternalNotifyTimer := TTimer.Create(Self);
    FExternalNotifyTimer.Enabled := False;
    FExternalNotifyTimer.OnTimer := ExternalNotifyTimerTick;
  end;
  FExternalNotifyTimer.Interval := 12000;
  FExternalNotifyTimer.Enabled := True;
end;

function TfrmMain.IsControlFocusedForShortcut(AControl: TWinControl): Boolean;
var
  FocusWnd: HWND;
begin
  Result := False;
  if not Assigned(AControl) or (AControl.Handle = 0) then Exit;

  if (Screen.ActiveControl = AControl) or AControl.Focused then
  begin
    Result := True;
    Exit;
  end;

  FocusWnd := GetFocus;
  if FocusWnd <> 0 then
    Result := (FocusWnd = AControl.Handle) or IsChild(AControl.Handle, FocusWnd);
end;

procedure TfrmMain.CloseScriptDirectOutput;

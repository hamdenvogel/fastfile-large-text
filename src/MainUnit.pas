procedure TfrmMain.LoadRecentFilesTabPrefs;
var
  Ini: TIniFile;
begin
  if (IniName = '') or (not FileExists(IniName)) then Exit;
  Ini := TIniFile.Create(IniName);
  try
    FRecentFilesSortColumn := Ini.ReadInteger(APPLICATION_NAME, 'RecentFilesSortColumn', FRecentFilesSortColumn);
    FRecentFilesSortAsc := Ini.ReadBool(APPLICATION_NAME, 'RecentFilesSortAsc', FRecentFilesSortAsc);
    if (FRecentFilesSortColumn < 0) or (FRecentFilesSortColumn > 5) then
      FRecentFilesSortColumn := 4;
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.SaveRecentFilesTabPrefs;
var
  Ini: TIniFile;
begin
  if IniName = '' then Exit;
  Ini := TIniFile.Create(IniName);
  try
    Ini.WriteInteger(APPLICATION_NAME, 'RecentFilesSortColumn', FRecentFilesSortColumn);
    Ini.WriteBool(APPLICATION_NAME, 'RecentFilesSortAsc', FRecentFilesSortAsc);
  finally
    Ini.Free;
  end;
end;

procedure TfrmMain.EnsureRecentFilesTypeImages;
begin
  if Assigned(FRecentFilesTypeImages) then Exit;
  FRecentFilesTypeImages := TImageList.Create(nil);
  FRecentFilesTypeImages.Width := 16;
  FRecentFilesTypeImages.Height := 16;
  FRecentFilesTypeImages.Masked := True;
end;

function TfrmMain.RecentFilesImageIndexFor(const AFilePath: string): Integer;
var
  Ext: string;
  Idx: Integer;
  SFI: TSHFileInfo;
  Icon: TIcon;
begin
  Result := -1;
  EnsureRecentFilesTypeImages;
  Ext := LowerCase(ExtractFileExt(AFilePath));
  if Ext = '' then
    Ext := '.__noext__';

  Idx := FRecentFilesExtToImage.IndexOfName(Ext);
  if Idx >= 0 then
  begin
    Result := StrToIntDef(FRecentFilesExtToImage.ValueFromIndex[Idx], -1);
    Exit;
  end;

  FillChar(SFI, SizeOf(SFI), 0);
  if SHGetFileInfo(PChar('x' + Ext), FILE_ATTRIBUTE_NORMAL, SFI, SizeOf(SFI),
     SHGFI_ICON or SHGFI_SMALLICON or SHGFI_USEFILEATTRIBUTES) <> 0 then
  begin
    Result := -1;
    if SFI.hIcon <> 0 then
    begin
      Icon := TIcon.Create;
      try
        Icon.Handle := CopyIcon(SFI.hIcon);
        Result := FRecentFilesTypeImages.AddIcon(Icon);
      finally
        Icon.Free;
        DestroyIcon(SFI.hIcon);
      end;
    end;
  end;

  FRecentFilesExtToImage.Values[Ext] := IntToStr(Result);
end;

function TfrmMain.FindRecentFilesTab: TsTabSheet;
begin
  Result := nil;
  if Assigned(FindComponent('tabRecentFiles')) then
    Result := FindComponent('tabRecentFiles') as TsTabSheet;
end;

function TfrmMain.RecentFilesTabFind(const AName: string): TComponent;
begin
  Result := FindComponent(AName);
end;

procedure TfrmMain.LocalizeRecentFilesTab;
var
  Tab: TsTabSheet;
  Lbl: TLabel;
  Btn: TButton;
  Chk: TCheckBox;
  LV: TListView;
begin
  Tab := FindRecentFilesTab;
  if not Assigned(Tab) then Exit;

  Tab.Caption := TrText('Recent Files & Folders');

  if Assigned(RecentFilesTabFind('lblRecentFiles')) and (RecentFilesTabFind('lblRecentFiles') is TLabel) then
  begin
    Lbl := RecentFilesTabFind('lblRecentFiles') as TLabel;
    Lbl.Caption := TrText('Recent Files');
  end;
  if Assigned(RecentFilesTabFind('lblRecentFolders')) and (RecentFilesTabFind('lblRecentFolders') is TLabel) then
  begin
    Lbl := RecentFilesTabFind('lblRecentFolders') as TLabel;
    Lbl.Caption := TrText('Recent Folders');
  end;
  if Assigned(RecentFilesTabFind('lblTagline')) and (RecentFilesTabFind('lblTagline') is TLabel) then
  begin
    Lbl := RecentFilesTabFind('lblTagline') as TLabel;
    Lbl.Caption := TrText('Open and edit multi-gigabyte text files instantly - where other editors can''t keep up. ' +
      'Exclusive features like Python macros, AI to extract/analyze files, and much more.');
  end;

  if Assigned(RecentFilesTabFind('btnOpenFile')) and (RecentFilesTabFind('btnOpenFile') is TButton) then
  begin
    Btn := RecentFilesTabFind('btnOpenFile') as TButton;
    Btn.Caption := TrText('Open File...');
  end;
  if Assigned(RecentFilesTabFind('btnOpenSelected')) and (RecentFilesTabFind('btnOpenSelected') is TButton) then
  begin
    Btn := RecentFilesTabFind('btnOpenSelected') as TButton;
    Btn.Caption := TrText('Open Selected');
  end;
  if Assigned(RecentFilesTabFind('Button4')) and (RecentFilesTabFind('Button4') is TButton) then
  begin
    Btn := RecentFilesTabFind('Button4') as TButton;
    Btn.Caption := TrText('Close');
  end;

  if Assigned(RecentFilesTabFind('chkDontShow')) and (RecentFilesTabFind('chkDontShow') is TCheckBox) then
  begin
    Chk := RecentFilesTabFind('chkDontShow') as TCheckBox;
    Chk.Caption := TrText('Don''t show this screen on startup');
  end;

  if Assigned(RecentFilesTabFind('lvRecentFiles')) and (RecentFilesTabFind('lvRecentFiles') is TListView) then
  begin
    LV := RecentFilesTabFind('lvRecentFiles') as TListView;
    while LV.Columns.Count < 7 do
      LV.Columns.Add;
    if LV.Columns.Count > 0 then LV.Columns[0].Caption := TrText('File Name');
    if LV.Columns.Count > 1 then LV.Columns[1].Caption := TrText('Folder');
    if LV.Columns.Count > 2 then LV.Columns[2].Caption := TrText('Size');
    if LV.Columns.Count > 3 then LV.Columns[3].Caption := TrText('Modified');
    if LV.Columns.Count > 4 then LV.Columns[4].Caption := TrText('Last loaded');
    if LV.Columns.Count > 5 then LV.Columns[5].Caption := TrText('Session');
